<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlipPix.UI.Linux.Windows.ComfyUIFolderSetupWindow"
        Title="ComfyUI Setup" Width="600" Height="500" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="25" Spacing="15">
        <TextBlock Text="ComfyUI Folder Setup" FontSize="20" FontWeight="Bold"/>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding FolderPath}" Watermark="ComfyUI folder path..."/>
            <Button Grid.Row="0" Grid.Column="1" Content="Browse" Command="{Binding BrowseFolderCommand}" Margin="5,0,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding ServerUrl}" Watermark="Server URL..." Margin="0,10,0,0"/>
            <Button Grid.Row="1" Grid.Column="1" Content="Test" Command="{Binding TestConnectionCommand}" Margin="5,10,0,0"/>
        </Grid>
        <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="Orange"/>
        <TextBlock Text="{Binding ServerConnectionMessage}" FontSize="11" Foreground="#666"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
