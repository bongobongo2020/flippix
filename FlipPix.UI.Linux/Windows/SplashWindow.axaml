<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlipPix.UI.Linux.SplashWindow"
        Title="FlipPix"
        Width="400" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1E1E2E">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <TextBlock Text="FlipPix" FontSize="32" FontWeight="Bold" Foreground="#FF6B35" HorizontalAlignment="Center"/>
            <TextBlock Text="Loading..." FontSize="14" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
        </StackPanel>
    </Grid>
</Window>
