<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlipPix.UI.Linux.Windows.ScenePromptLibraryWindow"
        Title="Scene Library"
        Width="900" Height="620"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Search -->
        <Border DockPanel.Dock="Top" Background="#F8F9FA"
                BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="12,10">
            <TextBox x:Name="SearchBox"
                     Watermark="Search saved scenes by name or prompt text"
                     Height="34" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
        </Border>

        <!-- Actions -->
        <Border DockPanel.Dock="Bottom" Background="#F8F9FA"
                BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel>
                <Button x:Name="DeleteButton" DockPanel.Dock="Left"
                        Content="Delete" Width="90" Height="34" IsEnabled="False"
                        Click="DeleteButton_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CloseButton" Content="Close" Width="90" Height="34"
                            Click="CloseButton_Click"/>
                    <Button x:Name="UseButton" Content="Use Scene" Width="120" Height="34"
                            IsEnabled="False" IsDefault="True" Click="UseButton_Click"/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="320,4,*">

            <!-- Saved scenes -->
            <Grid Grid.Column="0">
                <ListBox x:Name="ScenesList"
                         SelectionChanged="ScenesList_SelectionChanged"
                         DoubleTapped="ScenesList_DoubleTapped"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" Margin="2,4">
                                <Border Grid.Column="0" Width="64" Height="48" Margin="0,0,10,0"
                                        Background="#E9ECEF" CornerRadius="4" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Meta}" Classes="meta"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText"
                           Margin="24" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="#6C757D"
                           IsVisible="False"/>
            </Grid>

            <GridSplitter Grid.Column="1" Background="#DEE2E6" ResizeDirection="Columns"/>

            <!-- Detail -->
            <StackPanel Grid.Column="2" Margin="14">
                <TextBlock Text="NAME" Classes="sectionLabel"/>
                <TextBox x:Name="NameBox" Height="32" IsEnabled="False"
                         VerticalContentAlignment="Center"
                         LostFocus="NameBox_LostFocus"/>

                <TextBlock Text="PROMPT" Classes="sectionLabel" Margin="0,14,0,4"/>
                <TextBox x:Name="PromptBox" Height="380" IsEnabled="False" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         FontFamily="monospace" FontSize="12"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
