<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="using:FlipPix.UI.Linux.Controls"
        xmlns:conv="using:FlipPix.UI.Linux.Converters"
        xmlns:win="using:FlipPix.UI.Linux.Windows"
        xmlns:vm="using:FlipPix.UI.ViewModels"
        xmlns:vmv="using:FlipPix.UI.ViewModels.Video"
        xmlns:m="using:FlipPix.UI.Models"
        xmlns:svc="using:FlipPix.UI.Services"
        xmlns:sys="using:System"
        mc:Ignorable="d"
        Title="Scene Library"
        Height="620"
        Width="940"
        MinHeight="460"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        x:Class="FlipPix.UI.Linux.Windows.ScenePromptLibraryWindow">
    <Window.Resources>
        <!-- The Character tab's accent, which is also the default: a caller opening this window for a
             different tab replaces this brush in the constructor (see ScenePromptLibraryChrome). -->
        <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentVioletColor}"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- ─── Header ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Name="HeadingText" Text="Saved scenes" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Name="SubtitleText"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Every prompt this tab analyzes is saved here. Pick one to drop it into the H3 prompt box — the reference line is rewritten for whichever character images are loaded."/>
        </StackPanel>
        <!-- ─── List ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox Name="SearchBox"
                     Grid.Row="0"
                     Height="30"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     FontSize="12"
                     Margin="0,0,0,8"
                     Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip.Tip="Filters on the scene name and the prompt text."/>
            <TextBlock Grid.Row="0"
                       Text="Search scenes…"
                       IsHitTestVisible="False"
                       Margin="10,0,0,8"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       Classes="s1"
                       Classes.s1_0="{ReflectionBinding Text, ElementName=SearchBox, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                <TextBlock.Styles>
                    <Style Selector="TextBlock.s1.s1_0">
                        <Setter Property="IsVisible" Value="True"/>
                    </Style>
                </TextBlock.Styles>
                <TextBlock.Theme>
                    <ControlTheme TargetType="TextBlock">
                        <Setter Property="IsVisible" Value="False"/>
                    </ControlTheme>
                </TextBlock.Theme>
            </TextBlock>
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="2">
                <Grid>
                    <TextBlock Name="EmptyText"
                               Text="No saved scenes yet.&#10;Analyze a scene image and it lands here."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontStyle="Italic"
                               Margin="16"
                               Foreground="{StaticResource TextMutedBrush}"
                               IsVisible="False"/>
                    <ListBox Name="ScenesList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ScenesList_SelectionChanged"
                             DoubleTapped="ScenesList_MouseDoubleClick">
                        <ListBox.Styles>
                            <Style Selector="ListBox &gt; ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="76"
                                            Height="50"
                                            CornerRadius="4"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,10,0">
                                        <Grid>
                                            <TextBlock Text="🎬"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <Image Source="{Binding Thumbnail, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Meta}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
        <!-- ─── Preview / edit ─────────────────────────────────────────── -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Name" FontSize="10" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBox Name="NameBox"
                     Grid.Row="1"
                     Height="30"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     FontSize="12"
                     Margin="0,0,0,10"
                     IsEnabled="False"
                     Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     LostFocus="NameBox_LostFocus"
                     ToolTip.Tip="Rename the scene. The new name is saved when the box loses focus."/>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Prompt" FontSize="10" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Name="PromptBox"
                         Grid.Row="1"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontSize="11"
                         Padding="8"
                         IsEnabled="False"
                         LostFocus="PromptBox_LostFocus"
                         Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>
                <TextBlock Grid.Row="2"
                           Name="PromptNote"
                           Text="Stored without its reference line — that line is written fresh from the character images loaded in the tab."
                           FontSize="10"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Grid>
        <!-- ─── Buttons ────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Name="DeleteButton"
                    Grid.Column="0"
                    Content="🗑 Delete"
                    Theme="{StaticResource DangerButtonStyle}"
                    Height="34"
                    Width="110"
                    IsEnabled="False"
                    Click="DeleteButton_Click"/>
            <Button Name="CloseButton"
                    Grid.Column="2"
                    Content="Close"
                    Theme="{StaticResource SecondaryButtonStyle}"
                    Height="34"
                    Width="96"
                    Margin="0,0,8,0"
                    Click="CloseButton_Click"/>
            <Button Name="UseButton"
                    Grid.Column="3"
                    Content="✓ Use This Scene"
                    Theme="{StaticResource AccentButtonStyle}"
                    Height="34"
                    Width="170"
                    IsEnabled="False"
                    Click="UseButton_Click"/>
        </Grid>
    </Grid>
</Window>
