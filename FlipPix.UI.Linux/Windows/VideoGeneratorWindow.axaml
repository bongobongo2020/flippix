<win:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:ctrl="using:FlipPix.UI.Linux.Controls"
               xmlns:conv="using:FlipPix.UI.Linux.Converters"
               xmlns:win="using:FlipPix.UI.Linux.Windows"
               xmlns:vm="using:FlipPix.UI.ViewModels"
               xmlns:vmv="using:FlipPix.UI.ViewModels.Video"
               xmlns:m="using:FlipPix.UI.Models"
               xmlns:svc="using:FlipPix.UI.Services"
               xmlns:sys="using:System"
               mc:Ignorable="d"
               Title="FlipPix - Video Generator"
               Height="750"
               Width="950"
               WindowStartupLocation="CenterScreen"
               WindowState="Normal"
               MinHeight="650"
               MinWidth="850"
               x:Class="FlipPix.UI.VideoGeneratorWindow"
               x:DataType="vm:VideoGeneratorViewModel"
               x:CompileBindings="True">
    <Window.Resources>
        <!-- A cast card's thumbnail. 92px is enough to tell which picture is loaded and not enough to
             judge a face, so clicking one hands the file to the shell and it opens at full size in
             whatever the user has set as their image viewer. Tag carries the path — SourcePath on the
             photo, SheetPath on the built sheet — and an empty Tag is an empty frame: no hand cursor,
             no tooltip, and the handler does nothing. -->
        <ControlTheme x:Key="CastThumbnailStyle" TargetType="Border" x:DataType="vm:VideoGeneratorViewModel">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip.Tip" Value="Click to open this picture at full size in your image viewer."/>
            <Style Selector="^[Tag=]">
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="ToolTip.Tip" Value="{x:Null}"/>
            </Style>
        </ControlTheme>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border Grid.Row="0" PointerPressed="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource BrandColor}"/>
            </Border.Background>
            <StackPanel Margin="20,8" Orientation="Horizontal">
                <TextBlock Text="🎬 Video Generator" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="Generate videos from images using AI — upload an image and describe the motion"
                           FontSize="11"
                           Foreground="#E6FFFFFF"
                           VerticalAlignment="Center"
                           Margin="14,2,0,0"/>
            </StackPanel>
        </Border>
        <!-- Navigation Bar -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,1"
                Padding="15,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Navigate:"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="Image Generator"
                        Theme="{StaticResource NavButtonStyle}"
                        Command="{Binding NavigateToImageGeneratorCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"/>
            </StackPanel>
        </Border>
        <!-- Main Content -->
        <TabControl Grid.Row="2" Margin="15,10,15,10" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- Tab: Scail 2 (unified Klein char-swap → SCAIL II motion transfer) -->
            <TabItem Header="🎭 Scail 2">
                <Grid x:DataType="vmv:Scail2ViewModel" DataContext="{Binding Scail2VM}" Theme="{StaticResource TabPageStyle}">
                    <Grid.Resources>
                        <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentIndigoColor}"/>
                    </Grid.Resources>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="640" HorizontalAlignment="Center">
                            <!-- ═══ 1) Base scene (video) ═══════════════════════════ -->
                            <Border Theme="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Fill="{DynamicResource TabAccentBrush}"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="BASE SCENE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding InputVideoInfo}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontStyle="Italic"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Upload video…"
                                                Command="{Binding SelectVideoCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                Height="30"
                                                Padding="12,0"
                                                FontSize="11"
                                                Theme="{StaticResource SuccessButtonStyle}"
                                                Cursor="Hand"/>
                                    </Grid>
                                    <!-- Reference video preview (Source assigned in code-behind) -->
                                    <Border Background="{StaticResource PlayerSurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Height="200">
                                        <Grid>
                                            <TextBlock Text="Upload a base scene video, then scrub to a frame showing both people"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource PlayerTextBrush}"
                                                       FontSize="12"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="320"
                                                       Classes="s1"
                                                       Classes.s1_0="{Binding HasInputVideo}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s1.s1_0" x:DataType="vmv:Scail2ViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vmv:Scail2ViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <ctrl:VideoPreview x:Name="Scail2RefVideoPlayer"
                                                               MediaOpened="Scail2RefPlayer_MediaOpened"
                                                               MediaEnded="Scail2RefPlayer_MediaEnded"
                                                               Stretch="Uniform"
                                                               IsVisible="{Binding HasInputVideo}"/>
                                        </Grid>
                                    </Border>
                                    <!-- Scrub + In/Out trim track (playhead = Klein frame; markers = SCAIL II range) -->
                                    <Grid x:Name="Scail2TrimTrack"
                                          Height="30"
                                          Margin="2,10,2,0"
                                          Background="Transparent"
                                          ClipToBounds="False"
                                          SizeChanged="Scail2TrimTrack_SizeChanged"
                                          IsVisible="{Binding HasInputVideo}">
                                        <Border Height="8" VerticalAlignment="Center" CornerRadius="4" Background="{StaticResource BorderStrongBrush}"/>
                                        <Border x:Name="Scail2TrimRegion"
                                                Height="8"
                                                Width="0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                CornerRadius="4"
                                                Background="{DynamicResource TabAccentBrush}"
                                                IsHitTestVisible="False"/>
                                        <Border x:Name="Scail2TrimPlayhead"
                                                Width="2"
                                                Height="24"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource TextMutedBrush}"
                                                IsHitTestVisible="False"/>
                                        <Thumb x:Name="Scail2InThumb"
                                               Width="14"
                                               Height="24"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Cursor="SizeWestEast"
                                               DragDelta="Scail2InThumb_DragDelta"
                                               ToolTip.Tip="Drag to set the start (in) point">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{StaticResource SuccessBrush}"
                                                            CornerRadius="3"
                                                            BorderBrush="{StaticResource SuccessBrush}"
                                                            BorderThickness="1"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                            <Thumb.Theme>
                                                <ControlTheme TargetType="Thumb"/>
                                            </Thumb.Theme>
                                        </Thumb>
                                        <Thumb x:Name="Scail2OutThumb"
                                               Width="14"
                                               Height="24"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Cursor="SizeWestEast"
                                               DragDelta="Scail2OutThumb_DragDelta"
                                               ToolTip.Tip="Drag to set the end (out) point">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{StaticResource DangerBrush}"
                                                            CornerRadius="3"
                                                            BorderBrush="{StaticResource DangerBrush}"
                                                            BorderThickness="1"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                            <Thumb.Theme>
                                                <ControlTheme TargetType="Thumb"/>
                                            </Thumb.Theme>
                                        </Thumb>
                                    </Grid>
                                    <Grid Margin="0,8,0,0" IsVisible="{Binding HasInputVideo}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="▶"
                                                    Click="Scail2Play_Click"
                                                    Width="30"
                                                    Height="26"
                                                    FontSize="11"
                                                    Margin="0,0,4,0"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Cursor="Hand"/>
                                            <Button Content="⏸"
                                                    Click="Scail2Pause_Click"
                                                    Width="30"
                                                    Height="26"
                                                    FontSize="11"
                                                    Margin="0,0,10,0"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Cursor="Hand"/>
                                            <Button Content="⟦ In"
                                                    Command="{Binding MarkInCommand}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Margin="0,0,4,0"
                                                    Theme="{StaticResource SuccessButtonStyle}"
                                                    Cursor="Hand"/>
                                            <Button Content="Out ⟧"
                                                    Command="{Binding MarkOutCommand}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Margin="0,0,4,0"
                                                    Theme="{StaticResource DangerButtonStyle}"
                                                    Cursor="Hand"/>
                                            <Button Content="Reset"
                                                    Command="{Binding ResetTrimCommand}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    FontSize="11"
                                                    Margin="0,0,10,0"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Cursor="Hand"/>
                                            <Button Content="📌 Use this frame"
                                                    Command="{Binding UsePoseFrameCommand}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Theme="{StaticResource AccentButtonStyle}"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="Pins the frame under the playhead as the pose source, like the Image Generator ▸ Advanced ▸ Control tab's 'Use This Frame'. Analyze and every Generate then work from this exact still, so re-runs keep the same pose."/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="ETA"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding EstimatedTime}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                       Foreground="{DynamicResource TabAccentBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding TrimInfo}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                               Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding HasInputVideo}"/>
                                    <!-- Pinned pose frame (the Control tab's "Use This Frame" still) -->
                                    <Grid Margin="0,8,0,0" IsVisible="{Binding HasInputVideo}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="112"
                                                Height="64"
                                                CornerRadius="4"
                                                Background="{StaticResource PlayerSurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="🕴️"
                                                           FontSize="20"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding NoPoseFrame}"/>
                                                <Image Source="{Binding PoseFrameSource, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="Uniform"/>
                                                <Border Background="{StaticResource ScrimBrush}" IsVisible="{Binding IsGrabbingPoseFrame}">
                                                    <TextBlock Text="⏳"
                                                               Foreground="White"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PoseFrameInfo}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <Button Content="Unpin"
                                                    Command="{Binding ClearPoseFrameCommand}"
                                                    HorizontalAlignment="Left"
                                                    Height="22"
                                                    Padding="8,0"
                                                    FontSize="10"
                                                    Margin="0,5,0,0"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="Drop the pinned frame and go back to using whatever frame the playhead is on"
                                                    IsVisible="{Binding HasPoseFrame}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- ═══ 2) Characters → Character image (Klein char-swap) ═══ -->
                            <Border Theme="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Fill="{DynamicResource TabAccentBrush}"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="CHARACTERS"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Replace method"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <ComboBox SelectedIndex="{Binding CharReplaceMethodIndex, Mode=TwoWay}"
                                                      Width="190"
                                                      Height="26"
                                                      FontSize="10"
                                                      VerticalContentAlignment="Center"
                                                      ToolTip.Tip="Which workflow the single-character 'Replace this one only' button runs. Klein Flux2 Control holds the subject's likeness more accurately; Character Replacer is the legacy path; Krea2 Edit (two ref) keeps the base scene composition while swapping the subject in; Qwen Image 2.1 Edit (default) edits the frame itself, putting Character 1 into the pose with the background and lighting kept. 'Replace Both' always uses the 2-character replacer.">
                                                <ComboBoxItem Content="🟢 Klein Flux2 Control"/>
                                                <ComboBoxItem Content="⚪ Character Replacer (legacy)"/>
                                                <ComboBoxItem Content="🔵 Krea2 Edit (two ref)"/>
                                                <ComboBoxItem Content="🟣 Qwen Image 2.1 Edit"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Krea2 Edit (two ref) instruction prompt — only for that method -->
                                    <StackPanel Margin="0,0,0,10" IsVisible="{Binding IsKrea2EditSelected}">
                                        <TextBlock Text="Edit instruction (Krea2 Edit)"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Krea2EditPrompt}"
                                                 FontSize="10"
                                                 MinHeight="46"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Padding="6"
                                                 ToolTip.Tip="Instruction written into the Krea2 Edit grounded-encode node. 'image a' is the base scene frame (person to replace); 'image b' is Character 1. Edit for either sex or extra guidance."/>
                                    </StackPanel>
                                    <!-- Qwen Image 2.1 Edit instruction prompt — only for that method -->
                                    <StackPanel Margin="0,0,0,10" IsVisible="{Binding IsQwen21EditSelected}">
                                        <TextBlock Text="Edit instruction (Qwen Image 2.1 Edit)"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Qwen21EditPrompt}"
                                                 FontSize="10"
                                                 MinHeight="46"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Padding="6"
                                                 ToolTip.Tip="Instruction for Qwen Image 2.1 Edit. &lt;image1&gt; is the base scene frame being edited (its pose, background and lighting are the canvas); &lt;image2&gt; is Character 1."/>
                                    </StackPanel>
                                    <!-- Step 1 of the Klein Flux2 Control flow is the upload below: Analyze reads the
                                                 outfit and likeness off Character 1, so it stays disabled until one is picked. -->
                                    <TextBlock Text="Step 1 — Pick Character 1 (its face and outfit are what gets generated)"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,6"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding IsKleinControlSelected}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Character 1 -->
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Border Height="110"
                                                    CornerRadius="6"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Cursor="Hand">
                                                <Grid>
                                                    <TextBlock Text="＋ Character 1 (LEFT)"
                                                               Foreground="{StaticResource PlayerTextBrush}"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding NoChar1Image}"/>
                                                    <Image Source="{Binding Char1ImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="UniformToFill"/>
                                                    <Button Content="✕"
                                                            Command="{Binding RemoveChar1Command}"
                                                            Width="20"
                                                            Height="20"
                                                            Margin="0,3,3,0"
                                                            Padding="0"
                                                            FontSize="11"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource ScrimBrush}"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="Remove Character 1"
                                                            IsVisible="{Binding HasChar1Image}"/>
                                                </Grid>
                                            </Border>
                                            <Button Content="Browse…"
                                                    Command="{Binding BrowseChar1Command}"
                                                    Height="26"
                                                    FontSize="10"
                                                    Margin="0,5,0,0"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Cursor="Hand"/>
                                            <Button Content="Replace this one only"
                                                    Command="{Binding SwapChar1OnlyCommand}"
                                                    Height="26"
                                                    FontSize="10"
                                                    Margin="0,4,0,0"
                                                    Theme="{StaticResource AccentButtonStyle}"
                                                    ToolTip.Tip="Replace just one person in the pose frame with Character 1 (works for a man or a woman), then use the result as the character image. In Klein Flux2 Control mode this is the same as Step 4 — Generate image."/>
                                        </StackPanel>
                                        <!-- Character 2 -->
                                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                            <Border Height="110"
                                                    CornerRadius="6"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Cursor="Hand">
                                                <Grid>
                                                    <TextBlock Text="＋ Character 2 (RIGHT)"
                                                               Foreground="{StaticResource PlayerTextBrush}"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding NoChar2Image}"/>
                                                    <Image Source="{Binding Char2ImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="UniformToFill"/>
                                                    <Button Content="✕"
                                                            Command="{Binding RemoveChar2Command}"
                                                            Width="20"
                                                            Height="20"
                                                            Margin="0,3,3,0"
                                                            Padding="0"
                                                            FontSize="11"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource ScrimBrush}"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="Remove Character 2"
                                                            IsVisible="{Binding HasChar2Image}"/>
                                                </Grid>
                                            </Border>
                                            <Button Content="Browse…"
                                                    Command="{Binding BrowseChar2Command}"
                                                    Height="26"
                                                    FontSize="10"
                                                    Margin="0,5,0,0"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Cursor="Hand"/>
                                            <Button Content="Replace Both"
                                                    Command="{Binding SwapCharactersCommand}"
                                                    Height="26"
                                                    FontSize="10"
                                                    Margin="0,4,0,0"
                                                    Theme="{StaticResource AccentButtonStyle}"
                                                    ToolTip.Tip="Replace both people in the current base frame with Character 1 (left) and Character 2 (right), then use the result as the character image"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="→"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource TabAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <!-- Character image (Klein composite) -->
                                        <StackPanel Grid.Column="3">
                                            <Border Height="110"
                                                    CornerRadius="6"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="Character image"
                                                               Foreground="{StaticResource PlayerTextBrush}"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding NoCharSwapResult}"/>
                                                    <Image Source="{Binding CharSwapResultSource, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="Uniform"/>
                                                    <Border Background="{StaticResource ScrimBrush}" IsVisible="{Binding IsCharSwapping}">
                                                        <TextBlock Text="⏳ working…"
                                                                   Foreground="White"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Button Content="Browse…"
                                                    Command="{Binding BrowseFinalImageCommand}"
                                                    Height="26"
                                                    FontSize="10"
                                                    Margin="0,5,0,0"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="Upload your own image to use as the final character image instead of running a swap"/>
                                            <TextBlock Text="Built by Replace Both / Replace this one only, or upload your own"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontStyle="Italic"
                                                       Margin="0,5,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Klein Flux2 Control — the Image Generator ▸ Advanced ▸ Control flow, one step later
                                                 than that tab's numbering because Character 1 is picked above first:
                                                 Step 2 Analyze (QwenVL outfit+likeness from Character 1, pose from the video frame)
                                                 → Step 3 edit prompt → Step 4 Generate (repeatable) -->
                                    <StackPanel Margin="0,12,0,0" IsVisible="{Binding IsKleinControlSelected}">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Step 2 — Analyze (press again to reword)"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="🔍 Analyze"
                                                    Command="{Binding AnalyzeKleinPromptCommand}"
                                                    HorizontalAlignment="Right"
                                                    Height="24"
                                                    Padding="14,0"
                                                    FontSize="10"
                                                    Theme="{StaticResource SuccessButtonStyle}"
                                                    ToolTip.Tip="Runs the Klein Flux2 Control workflow's QwenVL pass twice: Character 1 supplies the face AND the clothing, the pinned pose frame supplies only the body position. The combined text lands in the box below so you can edit it, and the generated image is adopted as the character image.&#10;&#10;Press it again for a differently worded description of the same character and pose."/>
                                        </Grid>
                                        <TextBlock Text="Step 3 — Edit prompt"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,4,0,4"/>
                                        <TextBox Text="{Binding KleinControlPrompt}"
                                                 FontSize="10"
                                                 MinHeight="80"
                                                 MaxHeight="180"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Padding="6"
                                                 ToolTip.Tip="Positive prompt for the Klein Flux2 Control generation. Leave empty to let the workflow write it from QwenVL (Character 1's appearance and outfit + the pose frame's body position); anything here is used instead."/>
                                        <TextBlock Text="Leave empty to let QwenVL write the prompt during Generate."
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,3,0,6"/>
                                        <Grid>
                                            <TextBlock Text="Step 4 — Generate (press again for another take)"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="🚀 Generate image"
                                                    Command="{Binding GenerateKleinImageCommand}"
                                                    HorizontalAlignment="Right"
                                                    Height="24"
                                                    Padding="14,0"
                                                    FontSize="10"
                                                    Theme="{StaticResource AccentButtonStyle}"
                                                    ToolTip.Tip="Sends the edited prompt to ComfyUI with Character 1 and the pinned pose frame, reseeding each run. Press it again if the first image isn't good enough — the result becomes the character image."/>
                                        </Grid>
                                        <ProgressBar Value="{Binding KleinProgress, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="4"
                                                     Margin="0,6,0,0"
                                                     Foreground="{DynamicResource TabAccentBrush}"
                                                     BorderThickness="0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CharSwapStatus}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TabAccentBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- ═══ 3) Generate progress / status ═══════════════════ -->
                            <Border Theme="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <ProgressBar Height="6"
                                                 Margin="0,0,0,8"
                                                 Value="{Binding ProcessingProgress, Mode=OneWay}"
                                                 Foreground="{DynamicResource TabAccentBrush}"
                                                 IsVisible="{Binding IsProcessingQueue}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Chunk size (VRAM)"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ComboBox SelectedValue="{Binding VideoBatchSize, Mode=TwoWay}"
                                                  SelectedValueBinding="{ReflectionBinding Tag}"
                                                  Width="150"
                                                  Height="24"
                                                  FontSize="10"
                                                  VerticalContentAlignment="Center"
                                                  ToolTip.Tip="Frames processed per internal chunk. The clip is generated in windows of this size (VRAM purged between them) then stitched into one video.&#10;&#10;Measured: lowering this does NOT prevent the crash seen at 1280 × 720 — a full-length clip died at both 40 and 17 frames, while 17 ran ~5× slower. Use the Resolution setting below to stay within memory; leave this at 40 unless you have a specific reason.">
                                            <ComboBoxItem Content="24 — lowest VRAM">
                                                <ComboBoxItem.Tag>
                                                    <x:Int32>24</x:Int32>
                                                </ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                            <ComboBoxItem Content="40 — recommended">
                                                <ComboBoxItem.Tag>
                                                    <x:Int32>40</x:Int32>
                                                </ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                            <ComboBoxItem Content="60 — balanced">
                                                <ComboBoxItem.Tag>
                                                    <x:Int32>60</x:Int32>
                                                </ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                            <ComboBoxItem Content="80 — most VRAM">
                                                <ComboBoxItem.Tag>
                                                    <x:Int32>80</x:Int32>
                                                </ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Resolution"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ComboBox SelectedValue="{Binding OutputResolution, Mode=TwoWay}"
                                                  SelectedValueBinding="{ReflectionBinding Tag}"
                                                  Width="200"
                                                  Height="24"
                                                  FontSize="10"
                                                  VerticalContentAlignment="Center"
                                                  ToolTip.Tip="Resolution the video is generated at.&#10;&#10;Auto keeps the source video's own aspect ratio at the same pixel budget as 960 × 544, so a portrait clip generates portrait and a landscape clip landscape. Leave it on Auto unless you deliberately want a different shape: a fixed preset crops the driving video to that aspect and crops the character image to match, and picking one that doesn't fit the source is what makes the output look stretched or cut off.&#10;&#10;Measured on a 24 GB card with a ~21s clip: the Auto/960 × 544 pixel budget completes in ~14 min; 1280 × 720 takes the ComfyUI server down mid-run (a hard process kill, not a recoverable error) on anything longer than a few seconds, at any chunk size. Memory use grows with clip LENGTH as well as resolution, so longer clips need a lower preset.">
                                            <ComboBoxItem Content="Auto — match source video (recommended)" Tag="auto"/>
                                            <ComboBoxItem Content="832 × 480 (landscape)" Tag="832x480"/>
                                            <ComboBoxItem Content="768 × 768 (square)" Tag="768x768"/>
                                            <ComboBoxItem Content="544 × 960 (portrait)" Tag="544x960"/>
                                            <ComboBoxItem Content="1280 × 720 (720p — crashes on long clips)" Tag="1280x720"/>
                                            <ComboBoxItem Content="720 × 1280 (720p portrait — crashes on long clips)" Tag="720x1280"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox Content="Keep original background"
                                              IsChecked="{Binding KeepOriginalBackground, Mode=TwoWay}"
                                              FontSize="10"
                                              Foreground="{StaticResource TextMutedBrush}"
                                              Margin="0,0,0,8"
                                              ToolTip.Tip="Replacement mode: composite the driving video's real background every frame and regenerate only the swapped character.&#10;&#10;Turn ON when the scene behind the person is real footage you want kept (e.g. a waterfall). Because the background is never generated, it can't colour-drift or soften across the internal chunks — the artefacts that appear ~20s into a long clip.&#10;&#10;Turn OFF (animation mode) to regenerate the whole frame, e.g. when re-lighting the character into a new environment."/>
                                    <CheckBox Content="Interpolate + RTX upscale (2× fps, 2× size)"
                                              IsChecked="{Binding InterpolateAndUpscale, Mode=TwoWay}"
                                              FontSize="10"
                                              Foreground="{StaticResource TextMutedBrush}"
                                              Margin="0,0,0,8"
                                              ToolTip.Tip="Runs the workflow's post pass after generation: RIFE frame interpolation (2× the frame rate) followed by the RTX Video Super Resolution upscale (2× the resolution).&#10;&#10;A 960 × 544 clip at 16 fps comes out 1920 × 1088 at 32 fps. It adds a noticeable amount of time to every run and needs the RIFE VFI and NVIDIA RTX (nvidia-vfx) custom nodes installed on the server, so it's off by default — with it off the raw sampler output is saved instead."/>
                                    <Grid>
                                        <TextBlock Text="{Binding ProcessingStatus}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Content="⚡ Generate video"
                                                HorizontalAlignment="Right"
                                                Click="Scail2Process_Click"
                                                Height="30"
                                                Padding="14,0"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Theme="{StaticResource SuccessButtonStyle}"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                IsEnabled="{Binding CanAddToQueue}"
                                                ToolTip.Tip="Analyzes the marked In/Out range and generates the SCAIL II video. Build the character image first."/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- ═══ 4) Result ═══════════════════════════════════════ -->
                            <Border Theme="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="🎥 RESULT"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Border Background="{StaticResource PlayerSurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            Height="200"
                                            CornerRadius="6"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="The motion-transfer video will appear here"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource PlayerTextBrush}"
                                                       FontStyle="Italic"
                                                       Classes="s2"
                                                       Classes.s2_0="{Binding HasResult}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s2.s2_0" x:DataType="vmv:Scail2ViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vmv:Scail2ViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <ctrl:VideoPreview x:Name="Scail2VideoPlayer"
                                                               Source="{Binding ResultVideoPath}"
                                                               Stretch="Uniform"
                                                               IsVisible="{Binding HasResult}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="▶ Play"
                                                Command="{Binding PlayVideoCommand}"
                                                IsEnabled="{Binding HasResult}"
                                                Height="30"
                                                Padding="14,0"
                                                FontSize="11"
                                                Theme="{StaticResource AccentButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="📁 Open folder"
                                                Command="{Binding OpenResultFolderCommand}"
                                                IsEnabled="{Binding HasResult}"
                                                Height="30"
                                                Padding="14,0"
                                                FontSize="11"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="📷 Send to Edit Camera"
                                                Command="{Binding SendToEditCameraCommand}"
                                                IsEnabled="{Binding HasResult}"
                                                Height="30"
                                                Padding="14,0"
                                                FontSize="11"
                                                Theme="{StaticResource SecondaryButtonStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ResultVideoInfo}"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- ═══ Log ═════════════════════════════════════════════ -->
                            <Expander Header="📝 Log" IsExpanded="False" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4">
                                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                    <TextBox Text="{Binding LogOutput, Mode=OneWay}"
                                             TextWrapping="Wrap"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="10"
                                             Background="{StaticResource SurfaceAltBrush}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             BorderThickness="0"
                                             Padding="10"/>
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- ═══════════════════════════════════════════════════════════════════════
                         🥽🎯 H3 VR — the H3 Eros hunt, wearing rehan-fal/minimax-h3-vr180-sbs-lora.

                         Reference photographs in, a stereoscopic VR180 side-by-side clip out. The
                         stereo is COMPOSED BY THE MODEL, not built afterwards: the LoRA makes H3
                         paint one wide frame whose left half is the left eye and whose right half
                         is the right eye of the same scene, a few pixels of parallax apart. There
                         is no depth pass and no reprojection anywhere in this tab — unlike 🥽 VR
                         180, which takes a finished flat clip and infers stereo from a depth map.

                         Everything else is H3 Eros, on the same h3-eros.json graph: the story, the
                         cast sheets and @char tags, the wardrobe lock, three drafts per clip across
                         the whole queue, the board you pick on, and the latent upscale of only what
                         was picked. The LoRA is spliced into the model chain at submit time, which
                         is why its strength is a slider and not a second copy of the workflow file.

                         The card's numbers are the defaults, and each is a way to lose the stereo:
                         21:9 at 1.3 MP (1792×768 — 768p native, two 896px eyes), 24 fps, ≤15s, and
                         the vr180sbs trigger leading every prompt (written in code, so it cannot be
                         edited out of the description box). Quality stops at native because the card
                         says outright that 2K/4K upscales were never checked for stereo consistency.

                         Files land as ..._LR_180.mp4 — DeoVR, Skybox and Pigasus read the layout
                         from that name. No spatial-media metadata box is written.
                         ═══════════════════════════════════════════════════════════════════════ -->
            <TabItem Header="🥽🎯 H3 VR">
                <!-- Named so the per-character cards, whose DataContext is a CharacterSlot, can
                             still reach the tab's own commands. -->
                <Grid x:DataType="vmv:H3VrViewModel" x:Name="H3VrRoot" DataContext="{Binding H3VrVM}" Theme="{StaticResource TabPageStyle}">
                    <Grid.Resources>
                        <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentIndigoColor}"/>
                    </Grid.Resources>
                    <!-- The rail's column is Auto, not 340, so folding the Border away really
                                 gives its width to the board rather than leaving a 340px hole. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                    <Border Grid.Column="0" Width="340" Theme="{StaticResource TabSideRailStyle}" IsVisible="{Binding IsSidePanelVisible}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <!-- Scene & story: two ways in, either one is enough.
                                             The image (never uploaded) carries setting, light and
                                             wardrobe; the story carries what happens. With no image
                                             the request goes to the llama-server as plain text. -->
                                <Border Theme="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <ctrl:SectionHeader Title="SCENE &amp; STORY"
                                                            Note="  · either one is enough — and the wardrobe comes from it"
                                                            Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="124"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Scene image -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Scene image"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Height="126"
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <TextBlock Text="Optional"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="10"
                                                                   Classes="s3"
                                                                   Classes.s3_0="{Binding SceneImagePreview, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock.s3.s3_0" x:DataType="vmv:H3VrViewModel">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                </Style>
                                                            </TextBlock.Styles>
                                                            <TextBlock.Theme>
                                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3VrViewModel">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </ControlTheme>
                                                            </TextBlock.Theme>
                                                        </TextBlock>
                                                        <Image Source="{Binding SceneImagePreview, Converter={StaticResource PathToBitmapConverter}}"
                                                               Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="Browse…"
                                                            Command="{Binding SelectSceneImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                            Height="26"
                                                            Padding="6,0"
                                                            FontSize="11"
                                                            Margin="0,0,4,0"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"/>
                                                    <Button Grid.Column="1"
                                                            Content="✕"
                                                            Command="{Binding ClearSceneImageCommand}"
                                                            IsEnabled="{Binding HasSceneImage}"
                                                            Height="26"
                                                            Width="26"
                                                            FontSize="11"
                                                            ToolTip.Tip="Drop the scene image and work from the story alone."
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"/>
                                                </Grid>
                                                <TextBlock Text="{Binding SceneImageInfo}"
                                                           FontSize="9"
                                                           Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontStyle="Italic"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <!-- Story text -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Story"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding StoryText}"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         AcceptsTab="False"
                                                         Height="126"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         Margin="0,0,0,6"
                                                         BorderBrush="{StaticResource BorderBrush}"
                                                         Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11"
                                                         Padding="6"
                                                         ToolTip.Tip="Type or paste the story the video tells. With a scene image it says what happens in it; on its own it is the whole brief — Analyze then works from the text alone and writes the setting, lighting and wardrobe out of the prose, casting &lt;Picture 1&gt; and &lt;Picture 2&gt; in the story's roles."/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="📄 Load .txt"
                                                            Command="{Binding LoadStoryCommand}"
                                                            Height="26"
                                                            Padding="6,0"
                                                            FontSize="11"
                                                            Margin="0,0,4,0"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            ToolTip.Tip="Read a story out of a .txt or .md file into the box."/>
                                                    <Button Grid.Column="1"
                                                            Content="✕"
                                                            Command="{Binding ClearStoryCommand}"
                                                            Height="26"
                                                            Width="26"
                                                            FontSize="11"
                                                            ToolTip.Tip="Empty the story box."
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding StorySourceSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <!-- Wardrobe. Decided once and written into every clip's
                                                     prompt verbatim: the clips are generated separately from
                                                     text written block by block, so an outfit left to the
                                                     prose is re-invented every few clips. -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Wardrobe — derived from the story"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Button Grid.Column="1"
                                                    Content="{Binding WardrobeLockButtonText}"
                                                    Command="{Binding ToggleWardrobeLockCommand}"
                                                    Height="24"
                                                    Padding="8,0"
                                                    FontSize="10"
                                                    Margin="0,0,4,0"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="Locked, the wardrobe is the story's: it is rewritten whenever the story, the scene image or the cast changes, and cannot be typed over.&#10;&#10;Unlock to dress the cast yourself — your text then stands, and the story stops rewriting it until you lock it again."/>
                                            <Button Grid.Column="2"
                                                    Content="🎽 Derive"
                                                    Command="{Binding DeriveWardrobeCommand}"
                                                    Height="24"
                                                    Padding="8,0"
                                                    FontSize="10"
                                                    Margin="0,0,4,0"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="Re-rolls the outfits now, without waiting for the story to change — off the scene image if there is one, otherwise out of the story.&#10;&#10;It always writes an outfit for BOTH characters, whether or not their photos have been picked yet: the wardrobe is a decision about the story, and a second character's line is simply left out of any clip they are not in. The sheets are built from whatever is in this box, so derive before you build them."/>
                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Command="{Binding ClearWardrobeCommand}"
                                                    Height="24"
                                                    Width="24"
                                                    FontSize="10"
                                                    ToolTip.Tip="Empty the wardrobe box and let the story write a fresh one."
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"/>
                                        </Grid>
                                        <TextBox Text="{Binding CastWardrobe}"
                                                 IsReadOnly="{Binding IsWardrobeLocked}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="False"
                                                 Height="64"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,4"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 Background="{StaticResource SurfaceAltBrush}"
                                                 FontSize="11"
                                                 Padding="6"
                                                 ToolTip.Tip="One line per character, naming every garment. It is written from the story a couple of seconds after you stop typing, and it is what the character sheets are generated in AND what every clip's prompt quotes — the picture and the words then agree, which is what stops the cast changing outfits between clips.&#10;&#10;Read-only while locked; press 🔒 to take it over."/>
                                        <TextBlock Text="{Binding WardrobeSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                    </StackPanel>
                                </Border>
                                <!-- Cast: photo in, sheet out -->
                                <Border Theme="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <!-- 🧹 sits on the header because it undoes the whole
                                                     section: a new story pasted into the box above never
                                                     overwrites a card that already says something, so the
                                                     previous film's parts and wardrobe otherwise stay under
                                                     the cards and are written into every clip. -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ctrl:SectionHeader Grid.Column="0"
                                                                Title="CAST"
                                                                Note="  · one photo per character, dressed from the wardrobe above"
                                                                Margin="0"
                                                                VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="🧹 Clear cast"
                                                    Command="{Binding ClearDerivedCastCommand}"
                                                    Height="24"
                                                    Padding="8,0"
                                                    FontSize="10"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="Throws away everything the story derived about the cast: both cards' Part, the sex of any card whose photo has not already answered it, and the wardrobe.&#10;&#10;Press it after pasting a DIFFERENT story. The automatic pass never overwrites a card that already says something, so without this the new film keeps the previous one's parts — and the wardrobe is then re-derived around characters who are not in it.&#10;&#10;Photos, built sheets and the prompt box are left alone. The story in the box re-casts itself a couple of seconds later; run Analyze afterwards to rewrite the clips."/>
                                        </Grid>
                                        <!-- Character 1 -->
                                        <StackPanel x:DataType="vmv:CharacterSlot" DataContext="{Binding Character1}" Margin="0,0,0,10">
                                            <!-- The sex is a real input, not a label: it goes into the
                                                         wardrobe request, into the sheet builder's instruction
                                                         and into the reference line H3 reads. -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding SexOptions}"
                                                          SelectedItem="{Binding Sex, Mode=TwoWay}"
                                                          Width="86"
                                                          Height="24"
                                                          FontSize="10"
                                                          ToolTip.Tip="Male or female. The wardrobe pass dresses this character accordingly, the character sheet is generated as that person, and the prompt names them so H3 uses the right pronouns."/>
                                            </Grid>
                                            <!-- Part — who this character is in the story. Filled by the story's
                                                         automatic cast; see H3CastViewModel.Cast.cs. -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="Part"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Role, UpdateSourceTrigger=LostFocus}"
                                                         Height="24"
                                                         FontSize="10"
                                                         Padding="5,0"
                                                         VerticalContentAlignment="Center"
                                                         BorderBrush="{StaticResource BorderBrush}"
                                                         Background="White"
                                                         ToolTip.Tip="Who this character is in the story — &quot;the detective&quot;, &quot;her younger brother&quot;. A pasted or loaded story fills this in automatically; edit it freely — the tab never overwrites a card you have made your own. It reaches the wardrobe pass and the ✨ Generate button, so the photo and the outfit match the part."/>
                                            </Grid>
                                            <TextBlock Text="&lt;Picture 1&gt; · the first reference H3 receives"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="98"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Source photo -->
                                                <Border Grid.Column="0"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Height="92"
                                                        Theme="{StaticResource CastThumbnailStyle}"
                                                        Tag="{Binding SourcePath}">
                                                    <Grid>
                                                        <TextBlock Text="Photo"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="10"
                                                                   Classes="s4"
                                                                   Classes.s4_0="{Binding SourcePreview, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock.s4.s4_0" x:DataType="vmv:CharacterSlot">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                </Style>
                                                            </TextBlock.Styles>
                                                            <TextBlock.Theme>
                                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:CharacterSlot">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </ControlTheme>
                                                            </TextBlock.Theme>
                                                        </TextBlock>
                                                        <Image Source="{Binding SourcePreview, Converter={StaticResource PathToBitmapConverter}}"
                                                               Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                                <!-- Built sheet -->
                                                <Border Grid.Column="2"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Height="92"
                                                        Theme="{StaticResource CastThumbnailStyle}"
                                                        Tag="{Binding SheetPath}">
                                                    <Grid>
                                                        <TextBlock Text="Sheet → H3"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="10"
                                                                   Classes="s5"
                                                                   Classes.s5_0="{Binding SheetPreview, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock.s5.s5_0" x:DataType="vmv:CharacterSlot">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                </Style>
                                                            </TextBlock.Styles>
                                                            <TextBlock.Theme>
                                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:CharacterSlot">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </ControlTheme>
                                                            </TextBlock.Theme>
                                                        </TextBlock>
                                                        <Image Source="{Binding SheetPreview, Converter={StaticResource PathToBitmapConverter}}"
                                                               Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <Button Content="Browse…"
                                                    Command="{Binding #H3VrRoot.((vmv:H3VrViewModel)DataContext).SelectCharacter1Command}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    FontSize="11"
                                                    Margin="0,6,0,0"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"/>
                                            <!-- ✨ Generate — this character's photo, rendered by one of the Image
                                                         Generator's base workflows instead of browsed for. -->
                                            <Button Content="✨ Generate photo ▾"
                                                    Margin="0,4,0,0"
                                                    Click="CastGenerateButton_Click"
                                                    Tag="{Binding #H3VrRoot.DataContext}"
                                                    IsEnabled="{Binding CanGeneratePhoto}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    FontSize="11"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="Generates this character's photo instead of browsing for one — their Part and the locked wardrobe become the prompt, and the result lands in this card as if it had been browsed. Z-Image, Z-Famegrid and Krea2 open into a LoRA list (the same folders the Image Generator reads); Krea2-Spicy's and Qwen 2.5.1.2's LoRAs are baked into their workflows.&#10;&#10;Needs the character to be described first: a Part on the card, or the story's automatic cast. The character sheet is not built until you press 🪪 Build Character Sheet, so you can re-generate or swap photos first.">
                                                <!-- Tag carries the tab's ViewModel across the ContextMenu boundary;
                                                             the card's DataContext is the CharacterSlot each command takes. -->
                                                <Button.ContextMenu>
                                                    <ContextMenu x:DataType="vmv:H3VrViewModel"
                                                                 DataContext="{CompiledBinding $self.(ctrl:Menus.Target).Tag}"
                                                                 Opened="CastPhotoMenu_Opened">
                                                        <MenuItem Header="Z-Image ▸ pick the LoRA" ItemsSource="{Binding CastZimageLoraMenu}">
                                                            <MenuItem.ItemContainerTheme>
                                                                <ControlTheme TargetType="MenuItem"
                                                                              x:DataType="vmv:CastPhotoWorkflows+CastLora"
                                                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                                    <Setter Property="Command"
                                                                            Value="{Binding $parent[ContextMenu].((vmv:H3VrViewModel)DataContext).GenerateCastZimageLoraCommand}"/>
                                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                </ControlTheme>
                                                            </MenuItem.ItemContainerTheme>
                                                        </MenuItem>
                                                        <MenuItem Header="Z-Famegrid ▸ pick the LoRA" ItemsSource="{Binding CastFamegridLoraMenu}">
                                                            <MenuItem.ItemContainerTheme>
                                                                <ControlTheme TargetType="MenuItem"
                                                                              x:DataType="vmv:CastPhotoWorkflows+CastLora"
                                                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                                    <Setter Property="Command"
                                                                            Value="{Binding $parent[ContextMenu].((vmv:H3VrViewModel)DataContext).GenerateCastFamegridLoraCommand}"/>
                                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                </ControlTheme>
                                                            </MenuItem.ItemContainerTheme>
                                                        </MenuItem>
                                                        <MenuItem Header="Krea2 ▸ pick the LoRA" ItemsSource="{Binding CastKrea2LoraMenu}">
                                                            <MenuItem.ItemContainerTheme>
                                                                <ControlTheme TargetType="MenuItem"
                                                                              x:DataType="vmv:CastPhotoWorkflows+CastLora"
                                                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                                    <Setter Property="Command"
                                                                            Value="{Binding $parent[ContextMenu].((vmv:H3VrViewModel)DataContext).GenerateCastKrea2LoraCommand}"/>
                                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                </ControlTheme>
                                                            </MenuItem.ItemContainerTheme>
                                                        </MenuItem>
                                                        <MenuItem Header="Krea2-Spicy — spicy mirror-selfie look"
                                                                  Command="{Binding GenerateCastKrea2SpicyCommand}"
                                                                  CommandParameter="{CompiledBinding $parent[ContextMenu].(ctrl:Menus.Target).DataContext}"/>
                                                        <MenuItem Header="Qwen 2.5.1.2 — detailed illustration"
                                                                  Command="{Binding GenerateCastQwenCommand}"
                                                                  CommandParameter="{CompiledBinding $parent[ContextMenu].(ctrl:Menus.Target).DataContext}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <TextBlock Text="{Binding PhotoPhase}"
                                                       FontSize="9"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TabAccentBrush}"
                                                       FontStyle="Italic"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <CheckBox Content="This image is already a character sheet"
                                                      IsChecked="{Binding UseSourceAsSheet}"
                                                      IsEnabled="{Binding HasSource}"
                                                      FontSize="10"
                                                      Margin="0,6,0,0"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      ToolTip.Tip="Skip the Qwen pass and send the loaded image to H3 as it is."/>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="Panels"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,6,0"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding PanelSplitOptions}"
                                                          DisplayMemberBinding="{ReflectionBinding Label}"
                                                          SelectedValueBinding="{ReflectionBinding Value}"
                                                          SelectedValue="{Binding SelectedPanelSplit, Mode=TwoWay}"
                                                          IsEnabled="{Binding HasSheet}"
                                                          Height="24"
                                                          FontSize="10"
                                                          ToolTip.Tip="H3 conditions on each reference image as ONE subject, so a three-panel sheet handed over whole is a three-panel grid it will happily render into the video — the same person standing next to themselves against a studio wall.&#10;&#10;The sheet is therefore cut back into its separate views before it is sent, one reference per view. Auto looks for the background gaps between the figures; a number splits evenly; Whole sheet is the old single-collage behaviour, kept for comparison."/>
                                            </Grid>
                                            <TextBlock Text="{Binding SheetStatus}"
                                                       FontSize="9"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontStyle="Italic"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PanelStatus}"
                                                       FontSize="9"
                                                       Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontStyle="Italic"
                                                       TextWrapping="Wrap"/>
                                            <!-- The outfit this character's sheet is (or will be) built in. -->
                                            <TextBlock Text="{Binding ExpectedWardrobe, StringFormat=👗 {0}}"
                                                       IsVisible="{Binding ExpectedWardrobe, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       FontSize="9"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TabAccentBrush}"
                                                       FontStyle="Italic"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <!-- Character 2 -->
                                        <StackPanel x:DataType="vmv:CharacterSlot" DataContext="{Binding Character2}" Margin="0,0,0,8">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding SexOptions}"
                                                          SelectedItem="{Binding Sex, Mode=TwoWay}"
                                                          Width="86"
                                                          Height="24"
                                                          FontSize="10"
                                                          ToolTip.Tip="Male or female. The wardrobe pass dresses this character accordingly, the character sheet is generated as that person, and the prompt names them so H3 uses the right pronouns."/>
                                            </Grid>
                                            <!-- Part — who this character is in the story. Filled by the story's
                                                         automatic cast; see H3CastViewModel.Cast.cs. -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="Part"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Role, UpdateSourceTrigger=LostFocus}"
                                                         Height="24"
                                                         FontSize="10"
                                                         Padding="5,0"
                                                         VerticalContentAlignment="Center"
                                                         BorderBrush="{StaticResource BorderBrush}"
                                                         Background="White"
                                                         ToolTip.Tip="Who this character is in the story — &quot;the detective&quot;, &quot;her younger brother&quot;. A pasted or loaded story fills this in automatically; edit it freely — the tab never overwrites a card you have made your own. It reaches the wardrobe pass and the ✨ Generate button, so the photo and the outfit match the part."/>
                                            </Grid>
                                            <TextBlock Text="&lt;Picture 2&gt; · optional — leave empty for a one-character video"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="98"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Height="92"
                                                        Theme="{StaticResource CastThumbnailStyle}"
                                                        Tag="{Binding SourcePath}">
                                                    <Grid>
                                                        <TextBlock Text="Photo"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="10"
                                                                   Classes="s6"
                                                                   Classes.s6_0="{Binding SourcePreview, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock.s6.s6_0" x:DataType="vmv:CharacterSlot">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                </Style>
                                                            </TextBlock.Styles>
                                                            <TextBlock.Theme>
                                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:CharacterSlot">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </ControlTheme>
                                                            </TextBlock.Theme>
                                                        </TextBlock>
                                                        <Image Source="{Binding SourcePreview, Converter={StaticResource PathToBitmapConverter}}"
                                                               Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Height="92"
                                                        Theme="{StaticResource CastThumbnailStyle}"
                                                        Tag="{Binding SheetPath}">
                                                    <Grid>
                                                        <TextBlock Text="Sheet → H3"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="10"
                                                                   Classes="s7"
                                                                   Classes.s7_0="{Binding SheetPreview, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock.s7.s7_0" x:DataType="vmv:CharacterSlot">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                </Style>
                                                            </TextBlock.Styles>
                                                            <TextBlock.Theme>
                                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:CharacterSlot">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </ControlTheme>
                                                            </TextBlock.Theme>
                                                        </TextBlock>
                                                        <Image Source="{Binding SheetPreview, Converter={StaticResource PathToBitmapConverter}}"
                                                               Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="Browse…"
                                                        Command="{Binding #H3VrRoot.((vmv:H3VrViewModel)DataContext).SelectCharacter2Command}"
                                                        Height="26"
                                                        Padding="8,0"
                                                        FontSize="11"
                                                        Margin="0,0,4,0"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"/>
                                                <Button Grid.Column="1"
                                                        Content="✕"
                                                        Command="{Binding #H3VrRoot.((vmv:H3VrViewModel)DataContext).ClearCharacter2Command}"
                                                        IsEnabled="{Binding HasSource}"
                                                        Height="26"
                                                        Width="26"
                                                        FontSize="11"
                                                        ToolTip.Tip="Clear the second character and run as a single-reference scene."
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"/>
                                            </Grid>
                                            <!-- ✨ Generate — this character's photo, rendered by one of the Image
                                                         Generator's base workflows instead of browsed for. -->
                                            <Button Content="✨ Generate photo ▾"
                                                    Margin="0,4,0,0"
                                                    Click="CastGenerateButton_Click"
                                                    Tag="{Binding #H3VrRoot.DataContext}"
                                                    IsEnabled="{Binding CanGeneratePhoto}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    FontSize="11"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="Generates this character's photo instead of browsing for one — their Part and the locked wardrobe become the prompt, and the result lands in this card as if it had been browsed. Z-Image, Z-Famegrid and Krea2 open into a LoRA list (the same folders the Image Generator reads); Krea2-Spicy's and Qwen 2.5.1.2's LoRAs are baked into their workflows.&#10;&#10;Needs the character to be described first: a Part on the card, or the story's automatic cast. The character sheet is not built until you press 🪪 Build Character Sheet, so you can re-generate or swap photos first.">
                                                <!-- Tag carries the tab's ViewModel across the ContextMenu boundary;
                                                             the card's DataContext is the CharacterSlot each command takes. -->
                                                <Button.ContextMenu>
                                                    <ContextMenu x:DataType="vmv:H3VrViewModel"
                                                                 DataContext="{CompiledBinding $self.(ctrl:Menus.Target).Tag}"
                                                                 Opened="CastPhotoMenu_Opened">
                                                        <MenuItem Header="Z-Image ▸ pick the LoRA" ItemsSource="{Binding CastZimageLoraMenu}">
                                                            <MenuItem.ItemContainerTheme>
                                                                <ControlTheme TargetType="MenuItem"
                                                                              x:DataType="vmv:CastPhotoWorkflows+CastLora"
                                                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                                    <Setter Property="Command"
                                                                            Value="{Binding $parent[ContextMenu].((vmv:H3VrViewModel)DataContext).GenerateCastZimageLoraCommand}"/>
                                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                </ControlTheme>
                                                            </MenuItem.ItemContainerTheme>
                                                        </MenuItem>
                                                        <MenuItem Header="Z-Famegrid ▸ pick the LoRA" ItemsSource="{Binding CastFamegridLoraMenu}">
                                                            <MenuItem.ItemContainerTheme>
                                                                <ControlTheme TargetType="MenuItem"
                                                                              x:DataType="vmv:CastPhotoWorkflows+CastLora"
                                                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                                    <Setter Property="Command"
                                                                            Value="{Binding $parent[ContextMenu].((vmv:H3VrViewModel)DataContext).GenerateCastFamegridLoraCommand}"/>
                                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                </ControlTheme>
                                                            </MenuItem.ItemContainerTheme>
                                                        </MenuItem>
                                                        <MenuItem Header="Krea2 ▸ pick the LoRA" ItemsSource="{Binding CastKrea2LoraMenu}">
                                                            <MenuItem.ItemContainerTheme>
                                                                <ControlTheme TargetType="MenuItem"
                                                                              x:DataType="vmv:CastPhotoWorkflows+CastLora"
                                                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                                    <Setter Property="Command"
                                                                            Value="{Binding $parent[ContextMenu].((vmv:H3VrViewModel)DataContext).GenerateCastKrea2LoraCommand}"/>
                                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                </ControlTheme>
                                                            </MenuItem.ItemContainerTheme>
                                                        </MenuItem>
                                                        <MenuItem Header="Krea2-Spicy — spicy mirror-selfie look"
                                                                  Command="{Binding GenerateCastKrea2SpicyCommand}"
                                                                  CommandParameter="{CompiledBinding $parent[ContextMenu].(ctrl:Menus.Target).DataContext}"/>
                                                        <MenuItem Header="Qwen 2.5.1.2 — detailed illustration"
                                                                  Command="{Binding GenerateCastQwenCommand}"
                                                                  CommandParameter="{CompiledBinding $parent[ContextMenu].(ctrl:Menus.Target).DataContext}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <TextBlock Text="{Binding PhotoPhase}"
                                                       FontSize="9"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TabAccentBrush}"
                                                       FontStyle="Italic"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <CheckBox Content="This image is already a character sheet"
                                                      IsChecked="{Binding UseSourceAsSheet}"
                                                      IsEnabled="{Binding HasSource}"
                                                      FontSize="10"
                                                      Margin="0,6,0,0"
                                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="Panels"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,6,0"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding PanelSplitOptions}"
                                                          DisplayMemberBinding="{ReflectionBinding Label}"
                                                          SelectedValueBinding="{ReflectionBinding Value}"
                                                          SelectedValue="{Binding SelectedPanelSplit, Mode=TwoWay}"
                                                          IsEnabled="{Binding HasSheet}"
                                                          Height="24"
                                                          FontSize="10"
                                                          ToolTip.Tip="How this character's sheet is cut into separate reference images before it is sent to H3. Auto finds the gaps between the figures."/>
                                            </Grid>
                                            <TextBlock Text="{Binding SheetStatus}"
                                                       FontSize="9"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontStyle="Italic"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PanelStatus}"
                                                       FontSize="9"
                                                       Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontStyle="Italic"
                                                       TextWrapping="Wrap"/>
                                            <!-- The outfit this character's sheet is (or will be) built in. -->
                                            <TextBlock Text="{Binding ExpectedWardrobe, StringFormat=👗 {0}}"
                                                       IsVisible="{Binding ExpectedWardrobe, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       FontSize="9"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TabAccentBrush}"
                                                       FontStyle="Italic"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Content="{Binding BuildSheetsButtonText}"
                                                Command="{Binding BuildSheetsCommand}"
                                                IsEnabled="{Binding CanBuildSheets}"
                                                Height="32"
                                                FontSize="11"
                                                Margin="0,0,0,6"
                                                Theme="{StaticResource AccentButtonStyle}"
                                                ToolTip.Tip="Runs Qwen-Image-Edit-2511 (int8 convrot, 8-step Lightning) once per character and turns each photo into a three-panel reference sheet on a plain studio background: full-body front, full-body back, face close-up. That sheet — not the photo — is what MiniMax H3 receives, which is how one image can carry silhouette, hair from behind and facial identity at once.&#10;&#10;The sheet is generated with the character wearing the locked wardrobe, so the reference photographs and every clip's prompt describe the same clothes. Change the wardrobe and the sheets must be rebuilt — the cast card says so when they no longer match.&#10;&#10;Safe to press while a video is rendering: it waits for the GPU and runs as soon as that job lets go, so the next pair of characters can be prepared without stopping the queue."/>
                                        <!-- One press: cast -> wardrobe -> photos -> sheets ->
                                                     clips -> render -> pick -> join. Every step is the
                                                     method its own button calls; what this adds is the
                                                     waiting, because the cast and wardrobe passes are
                                                     debounced and an unattended run cannot hope. -->
                                        <Button Content="{Binding LuckyButtonText}"
                                                Command="{Binding FeelLuckyCommand}"
                                                IsEnabled="{Binding CanFeelLucky}"
                                                Height="32"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Margin="0,0,0,4"
                                                Theme="{StaticResource AccentButtonStyle}"
                                                ToolTip.Tip="One press and the whole film makes itself from the story above: read the cast out of it, decide the wardrobe, photograph both characters with Krea2-Spicy, build their sheets, write the clips, queue them, render them, pick the takes and join the result.&#10;&#10;Every step is the same one its own button runs, in the order this tab already implies - there is no second pipeline here. What this adds is the waiting: the cast and wardrobe passes normally fire 2.5 seconds after you stop typing, and a run that photographs its characters cannot hope a debounce has landed, so both are forced and awaited first.&#10;&#10;It never overwrites what is already there. A card that has a photo keeps it. A character whose sheet already matches the locked wardrobe is not re-sheeted. If a step comes back empty it stops and says so rather than guessing.&#10;&#10;This holds the GPU for the length of a whole story. Press X Cancel to stop it between steps."/>
                                        <TextBlock Text="{Binding LuckyPhase}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TabAccentBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"
                                                   IsVisible="{Binding LuckyPhase, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <!-- The builder's own status line: a render underneath owns
                                                     the tab's status bar and progress bar. -->
                                        <TextBlock Text="{Binding SheetPhase}"
                                                   IsVisible="{Binding IsBuildingSheets}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"
                                                   Foreground="{DynamicResource TabAccentBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CastSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"/>
                                        <!-- Which <Picture n> maps to whom once the sheets are split. -->
                                        <TextBlock Text="{Binding PanelPlanSummary}"
                                                   FontSize="10"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TabAccentBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"/>
                                        <!-- The writer's own controls sit under the cast, which
                                                     is the order the tab is used in: story, wardrobe,
                                                     cast, sheets, then write the chain those sheets
                                                     will be rendered against.
                                                     Total video length: H3 tops out at ~15s per pass,
                                                     so anything longer is written as a chain of clips
                                                     and queued one job per clip, same sheets
                                                     throughout. -->
                                        <Grid Margin="0,14,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Video length"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10,2">
                                                <TextBlock Text="{Binding StoryDurationSeconds, StringFormat={}{0:0} s}"
                                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider Value="{Binding StoryDurationSeconds}"
                                                Minimum="5"
                                                Maximum="120"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="5"
                                                LargeChange="15"
                                                Foreground="{DynamicResource TabAccentBrush}"
                                                Margin="0,0,0,4"
                                                ToolTip.Tip="Length of the finished video, in 5-second steps up to 2 minutes. MiniMax H3 renders at most ~15s per pass, so anything longer is written as a chain of consecutive clips — Analyze writes them all in one reply, Add to Queue enqueues one job per clip against the same character sheets, and they are joined into a single file when the last one lands."/>
                                        <TextBlock Text="{Binding ClipPlanSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <!-- The medium the writer works in. Left on Auto it
                                                     picks, and it used to pick gacha anime almost every
                                                     time whatever the story was. -->
                                        <TextBlock Text="Visual style"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding VisualStyleOptions}"
                                                  DisplayMemberBinding="{ReflectionBinding Name}"
                                                  SelectedItem="{Binding VisualStyle, Mode=TwoWay}"
                                                  Height="30"
                                                  FontSize="11"
                                                  Margin="0,0,0,4"
                                                  ToolTip.Tip="The medium every clip is written in. The style words open [Shot 1], which is the only place MiniMax H3 reads the look of the video from — so the choice here is handed to the prompt writer as settled fact and copied verbatim into every clip of a chain, exactly the way the wardrobe is.&#10;&#10;Auto leaves it to the writer, which is what this tab did before: it reads the medium off the scene image where there is one and off the story where there is not."/>
                                        <TextBlock Text="{Binding VisualStyleSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <!-- The A/B switch for the prompt build. Off is the
                                                     writer as shipped, byte for byte; on is the build
                                                     written from prompts/documents/. Deliberately a
                                                     toggle and not a replacement, so the same story
                                                     can be rendered both ways and judged on the
                                                     finished clips rather than on the prose. -->
                                        <CheckBox Content="📚 Researched prompts (MiniMax-H3 guide build)"
                                                  IsChecked="{Binding ResearchPrompts}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,4"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  ToolTip.Tip="Switches the H3 prompt writer between two builds so their finished clips can be compared on the same story, the same cast and the same seeds.&#10;&#10;OFF — the build these tabs have always used (prompts/prompt2json/h3pw_clip.md): a cut roughly every 1.25 seconds, and no instruction about shot size, silence, screen sides or the audio fields.&#10;&#10;ON — a build written from the MiniMax-H3 guides in prompts/documents/ (h3pw_clip_research.md plus a per-clip rule block). It changes seven things:&#10;• Cut pace: 3-5 shots per clip on the guide's own cut times, instead of 12 (Rules 9, 13, 24, 44). Twelve cuts in fifteen seconds is what makes a clip come back as a walk through repeated adjectives.&#10;• Framing floor: medium, medium close-up or close-up in every shot, no wides, faces frontal or three-quarter (Rule 36, C2V guide §4.1). H3 destroys a face the moment the person is small in frame, which is exactly when the reference sheets stop holding.&#10;• Silence mandates: a clip with no dialogue says so out loud, and anyone visible while another speaks is written silent (Issue 1, Rule 41). Without it H3 invents mumbling over silent action.&#10;• Speaker isolation: a spoken line gets the speaker alone in frame with the other character declared out of it, and a voice tag (Issue 2, Rule 19). A line spoken in a two-shot comes out of the wrong face.&#10;• Screen positions: screen-left / screen-right assigned per clip and restated in every two-shot (Rule 26), so the cast stops swapping sides.&#10;• Lighting lock: the beat sheet's setting line is stamped into every clip as an authoritative time-of-day and light string (Rule 22), the way the wardrobe already is.&#10;• Audio split: no voices or music in overall_soundscape (Rule 8) — the documented cause of double-voice and mumbling — plus a ban on beauty and render adjectives that paint over the reference face (RefMods guide §7.4, Rule 24).&#10;&#10;It also adds two rules to the beat sheet: one physical beat per clip, one event per beat (Rules 35, 44).&#10;&#10;Not remembered between sessions: it starts off every launch, so a finished film is never credited to the wrong build."/>
                                        <TextBlock Text="{Binding ResearchPromptsSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🔍 Analyze → H3 Prompt"
                                                    Command="{Binding AnalyzeCommand}"
                                                    IsEnabled="{Binding CanAnalyze}"
                                                    Height="32"
                                                    Padding="14,0"
                                                    FontSize="11"
                                                    Theme="{StaticResource AccentButtonStyle}"
                                                    ToolTip.Tip="Sends whatever is loaded — the scene image, the story, or both — to the llama-server with texttovideoH3.md and writes a dense multi-shot H3 prompt in which the cast is named only as &lt;Picture 1&gt; / &lt;Picture 2&gt; and framed so faces stay readable. The locked wardrobe above is handed to it as settled fact, so no clip picks its own outfit."/>
                                            <TextBlock FontStyle="Italic"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       Text="{Binding AnalyzeBusyText}"
                                                       Foreground="{DynamicResource TabAccentBrush}"
                                                       Classes="s8"
                                                       Classes.s8_0="{Binding IsAnalyzing}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s8.s8_0" x:DataType="vmv:H3VrViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3VrViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Prompt -->
                                <Border Theme="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <ctrl:SectionHeader Title="H3 PROMPT" Note="  · draft idea, or the full prompt"/>
                                        <TextBox Text="{Binding Prompt}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Height="240"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 Background="{StaticResource SurfaceAltBrush}"
                                                 FontSize="11"
                                                 Padding="8"/>
                                        <!-- Prompt library: every chain the writer finishes, and
                                                     every chain that reaches the queue, is filed
                                                     automatically; this row is how they come back out —
                                                     re-cast for whoever is loaded then. -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="{Binding ChainLibraryLabel}"
                                                    Command="{Binding OpenChainLibraryCommand}"
                                                    Height="28"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    Margin="0,0,6,0"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="Browse the story chains this tab has saved and put one back in the prompt box, with the story it was written from and the clip plan it was written against.&#10;&#10;Chains are stored as clip bodies with no cast preamble, so a story written for one cast can be rendered later with another: the reference line and the wardrobe block are written fresh from the characters loaded at the time. The saved take's own cast and wardrobe are NOT restored.&#10;&#10;Entries can be renamed, edited and deleted in the picker."/>
                                            <Button Grid.Column="1"
                                                    Content="💾 Save"
                                                    Command="{Binding SaveChainCommand}"
                                                    Height="28"
                                                    Width="76"
                                                    FontSize="11"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="File the chain in the prompt box now. Analyzed and queued chains are saved automatically — this is for one you have edited here and do not intend to queue yet."/>
                                        </Grid>
                                        <!-- What Add to Queue will actually enqueue: the chain is
                                                     split on its headers, so hand-edits here are honoured. -->
                                        <TextBlock Text="{Binding PromptClipSummary}"
                                                   IsVisible="{Binding HasPromptSequence}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TabAccentBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="The sheet reference line is rewritten automatically to match how many characters are loaded, which sex each of them is, and whether their sheets were built in the locked wardrobe — when they were, it tells H3 to copy the clothing out of the references rather than ignore it. The studio background is discarded either way."
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <!-- Settings -->
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>
                                        <!-- Which H3 checkpoint the hunt and the finish sample
                                                     with. The list is whatever the connected ComfyUI
                                                     reports under diffusion_models/h3-minimax, so
                                                     dropping a model in and pressing the refresh button
                                                     is enough. The choice is saved, and it is frozen onto
                                                     every queue item, so a story queued on one model is
                                                     finished on that same model. -->
                                        <TextBlock Text="Model" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding DiffusionModelOptions}"
                                                      DisplayMemberBinding="{ReflectionBinding Label}"
                                                      SelectedValueBinding="{ReflectionBinding Value}"
                                                      SelectedValue="{Binding SelectedDiffusionModel}"
                                                      Height="30"
                                                      FontSize="11"
                                                      Margin="0,0,6,0"
                                                      ToolTip.Tip="The diffusion model both sweeps load, from diffusion_models/h3-minimax on the ComfyUI server. Change it to run the same story through a different H3 checkpoint and compare the takes side by side; the choice is remembered across restarts.&#10;&#10;It is frozen onto each clip when you press Add to Queue — the finish re-samples the picked draft's own branch, so a queue hunted on one model is always finished on that same model even if you change this afterwards.&#10;&#10;This graph drives MiniMaxH3ReferenceToVideo. A checkpoint trained only for first/last-frame work (fl2va) may render noise through it — hunt a single clip before committing a story to one."/>
                                            <Button Grid.Column="1"
                                                    Content="⟳"
                                                    Width="30"
                                                    Height="30"
                                                    FontSize="13"
                                                    Command="{Binding RefreshDiffusionModelsCommand}"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="Re-read diffusion_models/h3-minimax from ComfyUI — after dropping a new model into the folder, or after the server was restarted."/>
                                        </Grid>
                                        <TextBlock Text="{Binding DiffusionModelSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <!-- ─── The LoRA, which is what makes this tab a tab ───
                                                     rehan-fal/minimax-h3-vr180-sbs-lora, spliced into the
                                                     Eros graph's model chain at submit time rather than
                                                     baked into a copy of the file. It only touches the 104
                                                     self-attention projections, so it stacks on whichever
                                                     checkpoint the dropdown above names. -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="VR180 stereo LoRA strength"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="10,2">
                                                <TextBlock Text="{Binding VrLoraStrength, StringFormat={}{0:0.00}}"
                                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider Value="{Binding VrLoraStrength}"
                                                Minimum="0"
                                                Maximum="1.5"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="0.05"
                                                LargeChange="0.25"
                                                Foreground="{DynamicResource TabAccentBrush}"
                                                Margin="0,0,0,2"
                                                ToolTip.Tip="How hard h3-vr180-sbs-lora-v2 is applied. This is the whole difference between this tab and 🌹🎯 H3 Eros: at 0 the graph is Eros exactly, and every clip is an ordinary flat video in an ultrawide frame.&#10;&#10;1.00 is the figure the model card's own sample clips were made at, and is the default. Below about 0.6 the two halves of the frame stop being two views of the scene and converge into one — which looks fine on a monitor and is worthless in a headset.&#10;&#10;It is a dial at all because the LoRA was trained on base minimax-h3-fl2va while this graph samples an int8 convrot checkpoint, most of which are themselves LoRA merges. All 104 target modules line up, but the weights they land on have moved, so the card's number is a starting point rather than a setting.&#10;&#10;Frozen onto each clip at Add to Queue: the finish re-samples the picked draft's branch, so a queue hunted at one strength is finished at that same strength."/>
                                        <TextBlock Text="{Binding VrLoraSummary}"
                                                   FontSize="10"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"
                                                   Classes="s9"
                                                   Classes.s9_0="{Binding HasVrLoraWarning}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.s9.s9_0" x:DataType="vmv:H3VrViewModel">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </Style>
                                            </TextBlock.Styles>
                                            <TextBlock.Theme>
                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3VrViewModel">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                </ControlTheme>
                                            </TextBlock.Theme>
                                        </TextBlock>
                                        <!-- ─── One character means one character ─────────────
                                                     Attaching a single reference photograph does not stop
                                                     H3 putting a second, unreferenced body in frame — the
                                                     story writer invents a partner, the clip writer writes
                                                     them in, and the render gives them a face that changes
                                                     every clip. This says so in all three places at once. -->
                                        <CheckBox Content="One character → first-person POV"
                                                  IsChecked="{Binding SoloPov}"
                                                  IsEnabled="{Binding IsSoloCast}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,4"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  ToolTip.Tip="With one character loaded, shoot the video first-person and let nobody else into it.&#10;&#10;Without this, a solo cast comes back with a second person in it. Nothing asks for one: the story writer, given a scene with a single named person, writes a partner for them to act against; the clip writer writes that partner into the prose; and H3, having no reference photograph for them, invents a face — a different one in every clip.&#10;&#10;On, the camera becomes the missing second party. The story, every clip and the render prompt all say there is exactly one person, and that every look, move and line is directed at the camera — which is where the viewer is standing. A clip that names a second character anyway is rejected and rewritten from its beat. First-person is also what this LoRA is best at: its card says the training data skews that way.&#10;&#10;Off gives a third-person solo clip, and lets the story write whoever else it likes. Greyed out when a second character is loaded, where it means nothing."/>
                                        <TextBlock Text="{Binding SoloPovSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Aspect ratio (21:9 is the LoRA's own)"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                  SelectedItem="{Binding SelectedAspectRatio}"
                                                  Height="30"
                                                  FontSize="11"
                                                  Margin="0,0,0,4"
                                                  ToolTip.Tip="Leave this at 21:9 (Ultrawide). It is not a framing preference on this tab: the LoRA packs a left eye and a right eye into one frame, and 21:9 at 768p is the only shape it was trained to do that in.&#10;&#10;On a 16:9 or portrait canvas each eye gets half of a shape the LoRA has never seen, and what comes back is usually a single flat view — or worse, a frame split somewhere that is not the middle, which is unwatchable in a headset."/>
                                        <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Quality (canvas size)"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                  DisplayMemberBinding="{ReflectionBinding Label}"
                                                  SelectedValueBinding="{ReflectionBinding Value}"
                                                  SelectedValue="{Binding Megapixels}"
                                                  Height="30"
                                                  FontSize="11"
                                                  Margin="0,0,0,8"/>
                                        <!-- The I2V graph scales references to the DRAFT canvas under
                                                     'match' — a quarter of the area picked. This is the lever
                                                     that stands in for the Cast tab's at-finished-canvas
                                                     panels: without it there is not enough face for identity
                                                     to survive against a competing reference. -->
                                        <CheckBox Content="Max-fidelity references (2048px)"
                                                  IsChecked="{Binding MaxFidelityReferences}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,4"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  ToolTip.Tip="Encodes every cast panel at a 2048px short edge instead of scaling them to the sampled canvas.&#10;&#10;On this tab's pipeline the sampled canvas is the DRAFT — a quarter of the quality you picked — and the Cast tab's trick of holding its panels at the finished canvas does not exist in this graph. So this is on by default: holding a face is the whole point of a character sheet, and a 2048px reference is more face than even the finished canvas would carry.&#10;&#10;Reference tokens ride through every sampling step, so this is several times slower than 'match' — it buys identity fidelity, nothing else. Turn it off for speed when the cast is distinctive enough to survive."/>
                                        <!-- ─── Don't pay twice for the same sheet ─────────────
                                                     A sheet's file name records which card built it and
                                                     when, never who is in it, so the pairing lives in an
                                                     index beside the folder, keyed on the photograph each
                                                     sheet came from — back-filled out of the app's own
                                                     build log, so sheets made long before this existed are
                                                     matched too. Only on tabs whose VM is an H3CastViewModel. -->
                                        <CheckBox Content="Reuse a sheet already built from this photo"
                                                  IsChecked="{Binding ReuseSheetsFromLibrary}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,4"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  ToolTip.Tip="When a cast photo is loaded, check the sheet library first: if this app has already built a sheet from that exact picture, put it straight back on the card. No render, no GPU, no wait.&#10;&#10;The library is Pictures/cast/sheets, with an index beside it saying which photograph each sheet came from. A sheet's own file name only records which card built it and when — never who is in it — so the pairing has to be kept separately. It is back-filled from the app's build log the first time this runs, which means sheets built long before this feature existed are matched too.&#10;&#10;Matching is exact and never a guess: the same file, or the same bytes under a new name, or (for log-recovered entries) the same file name. There is no face comparison — two different photos of one person count as two characters, because the alternative is silently dressing a video in a stranger's sheet.&#10;&#10;Off files new sheets but never adopts one. 🪪 Build Sheets always rebuilds regardless."/>
                                        <TextBlock Text="{Binding SheetLibrarySummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <!-- Shut by default. These are the dials you set once for a
                                                     run and then leave alone, and the board below is what the
                                                     tab is actually for. -->
                                        <Expander Header="⚙ Hunt &amp; finish options" IsExpanded="False" FontSize="11" FontWeight="SemiBold">
                                            <StackPanel Margin="0,6,0,0">
                                                <!-- ─── The hunt ────────────────────────────────────
                                                         The draft the three samples are compared at. It is
                                                         NOT a fraction of the finished size: this graph's
                                                         upscaler takes a megapixel target, not a factor, so
                                                         the hunt can be as cheap as it likes without
                                                         deciding what the picked take is finished at. -->
                                                <TextBlock Text="Hunt quality (the 3 drafts, per eye)"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding PreviewMegapixelOptions}"
                                                          DisplayMemberBinding="{ReflectionBinding Label}"
                                                          SelectedValueBinding="{ReflectionBinding Value}"
                                                          SelectedValue="{Binding PreviewMegapixels}"
                                                          Height="30"
                                                          FontSize="11"
                                                          Margin="0,0,0,8"
                                                          ToolTip.Tip="The canvas the three drafts are sampled at, listed with the eye width — half the frame — because that is the number that decides what you can actually see in a draft.&#10;&#10;It defaults to 0.3 MP here rather than 🌹🎯 H3 Eros's 0.15, and the extra cost buys one specific thing: the LoRA was trained at 768p, and at 304px an eye the two halves are close enough, and coarse enough, that a draft can read as flat when the finish will be stereo — or the other way round. 0.3 is the cheapest canvas on which the split is a call you can make.&#10;&#10;The picked draft is upscaled to the Quality above from its own latent, so this does not decide the finished clip's size."/>
                                                <TextBlock Text="Upscale pass steps (fixed sigmas)"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding UpscaleStepOptions}"
                                                          SelectedItem="{Binding UpscaleSteps}"
                                                          Height="30"
                                                          FontSize="11"
                                                          Margin="0,0,0,8"
                                                          ToolTip.Tip="How many fixed sigmas the finishing pass runs over the upscaled latent. The graph ships one hand-written schedule per count and this picks which one is wired in.&#10;&#10;4 is what the workflow ships live. 3 is quicker and keeps more of the draft; 5 puts more detail on and drifts further from the sample you picked."/>
                                                <CheckBox Content="RIFE interpolation (24 → 48 fps)"
                                                          IsChecked="{Binding UseRife}"
                                                          FontSize="11"
                                                          FontWeight="SemiBold"
                                                          Margin="0,0,0,10"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip.Tip="Doubles the finished clip's frame rate by generating the frames in between, rather than by rendering them. On is how the authored graph runs, and it is what makes the motion read as smooth at this clip length.&#10;&#10;Off muxes the H3 frames as they are, at 24 fps. Turn it off if the interpolation is inventing artefacts on fast action, or to keep every joined clip at the sampled rate."/>
                                                <!-- Unattended mode. A twelve-clip story that has to be
                                                         watched clip by clip is not a queue; this makes it
                                                         one again, at the cost of the choosing. -->
                                                <CheckBox Content="Auto-pick (render unattended)"
                                                          IsChecked="{Binding AutoPickSample}"
                                                          FontSize="11"
                                                          FontWeight="SemiBold"
                                                          Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip.Tip="Picks a take for every clip the moment its hunt lands, so one ▶ Generate runs the whole story — hunt, finish and join — without a human.&#10;&#10;Off by default: choosing between three takes is what this tab is for, and with it off the board simply waits, holding nothing on the GPU."/>
                                                <ComboBox ItemsSource="{Binding AutoPickSlotOptions}"
                                                          SelectedItem="{Binding AutoPickSlot}"
                                                          IsEnabled="{Binding AutoPickSample}"
                                                          Height="28"
                                                          FontSize="11"
                                                          Margin="18,0,0,10"
                                                          ToolTip.Tip="Which of the three takes auto-pick chooses. If that one failed to render, the first sample that did is taken instead."/>
                                                <TextBlock Text="{Binding HuntSummary}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontStyle="Italic"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,4"/>
                                            </StackPanel>
                                        </Expander>
                                        <!-- Turns red once the frame stack reaches the size that kills the server. -->
                                        <TextBlock Text="{Binding LoadSummary}"
                                                   FontSize="10"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"
                                                   Classes="s10"
                                                   Classes.s10_0="{Binding HasLoadWarning}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.s10.s10_0" x:DataType="vmv:H3VrViewModel">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </TextBlock.Styles>
                                            <TextBlock.Theme>
                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3VrViewModel">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                </ControlTheme>
                                            </TextBlock.Theme>
                                        </TextBlock>
                                        <TextBlock Text="Clip length (seconds · 4–15)"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <Slider Value="{Binding LengthSeconds}"
                                                Minimum="4"
                                                Maximum="15"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Foreground="{DynamicResource TabAccentBrush}"
                                                Margin="0,0,0,2"
                                                ToolTip.Tip="How long a single H3 pass is — the model's own limit. The Video length slider divides by this to decide how many clips the story is split into, and it is also what decides the peak frame stack above."/>
                                        <TextBlock Text="{Binding LengthSummary}"
                                                   FontSize="10"
                                                   FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding ClipPlanSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Seed (-1 = random)"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Seed}"
                                                     Height="30"
                                                     Padding="6,0"
                                                     VerticalContentAlignment="Center"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     Background="{StaticResource SurfaceAltBrush}"
                                                     FontSize="12"
                                                     FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                     Margin="0,0,6,0"/>
                                            <Button Grid.Column="1"
                                                    Content="🎲"
                                                    Command="{Binding RandomSeedCommand}"
                                                    Height="30"
                                                    Width="36"
                                                    FontSize="14"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <!-- ═══ FOLD HANDLE ═════════════════════════════════════════════
                                 Never folds away itself — it is the only way back. -->
                    <Border Grid.Column="1"
                            Width="16"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,1,0">
                        <Button Command="{Binding ToggleSidePanelCommand}"
                                Content="{Binding SidePanelToggleGlyph}"
                                ToolTip.Tip="{Binding SidePanelToggleTip}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="9"
                                Padding="0"
                                Width="16"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Foreground="{DynamicResource TabAccentBrush}"/>
                    </Border>
                    <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════
                                 Not a scrolling column any more.

                                 The board is what this tab is: a story's worth of takes, looked at for
                                 a long time. In the old layout the player lived underneath it, so every
                                 pick cost a scroll down to watch and a scroll back up to click the next
                                 tile — and the tiles themselves were 150px letterboxes three to a row,
                                 which put one clip on a screen.

                                 So the pane is a fixed frame now: the board scrolls on the left, the
                                 player is docked on the right and never moves, and the tiles are small
                                 squares with their buttons on hover. Clicking a take shows it without
                                 anything on screen changing position.
                                 ═══════════════════════════════════════════════════════════════ -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Sheet strip — folds with the queue -->
                            <RowDefinition Height="3"/>
                            <!-- Progress bar -->
                            <RowDefinition Height="Auto"/>
                            <!-- Status row -->
                            <RowDefinition Height="Auto"/>
                            <!-- Action buttons -->
                            <RowDefinition Height="Auto"/>
                            <!-- Queue -->
                            <RowDefinition Height="*" MinHeight="150"/>
                            <!-- Board + docked player -->
                            <RowDefinition Height="Auto"/>
                            <!-- Log -->
                        </Grid.RowDefinitions>
                        <!-- ─── Sheet strip: what H3 will actually see ───────────────── -->
                        <!-- Height is on the Border, not the row, so folding this really returns
                                     its height to the board below. -->
                        <Border Grid.Row="0" Height="104" Background="{StaticResource PlayerSurfaceBrush}" IsVisible="{Binding IsTopPanelVisible}">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Classes="s11"
                                            Classes.s11_0="{Binding HasCharacter1}">
                                    <StackPanel.Styles>
                                        <Style Selector="StackPanel.s11.s11_0" x:DataType="vmv:H3VrViewModel">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </Style>
                                    </StackPanel.Styles>
                                    <StackPanel.Theme>
                                        <ControlTheme TargetType="StackPanel" x:DataType="vmv:H3VrViewModel">
                                            <Setter Property="IsVisible" Value="True"/>
                                        </ControlTheme>
                                    </StackPanel.Theme>
                                    <TextBlock Text="🥽  MiniMax H3 · VR180 — the story hunted first, then the takes you pick become side-by-side 3D"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PlayerTextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Photo per character → Build Sheets → story → Analyze → Generate → hunt → pick → finish → join → ..._LR_180.mp4"
                                               FontSize="11"
                                               Foreground="{StaticResource PlayerTextBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Grid IsVisible="{Binding HasCharacter1}" Margin="10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Row="0"
                                           Grid.Column="0"
                                           Margin="0,0,6,0"
                                           Stretch="Uniform"
                                           Source="{Binding Character1.SheetPreview, Converter={StaticResource PathToBitmapConverter}}"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="Sheet 1 · &lt;Picture 1&gt;"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource PlayerTextBrush}"/>
                                    <Image Grid.Row="0"
                                           Grid.Column="1"
                                           Margin="6,0"
                                           Stretch="Uniform"
                                           Source="{Binding Character2.SheetPreview, Converter={StaticResource PathToBitmapConverter}}"
                                           IsVisible="{Binding HasCharacter2}"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="Sheet 2 · &lt;Picture 2&gt;"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource PlayerTextBrush}"
                                               IsVisible="{Binding HasCharacter2}"/>
                                    <Image Grid.Row="0"
                                           Grid.Column="2"
                                           Margin="6,0,0,0"
                                           Stretch="Uniform"
                                           Source="{Binding SceneImagePreview, Converter={StaticResource PathToBitmapConverter}}"
                                           IsVisible="{Binding HasSceneImage}"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="2"
                                               Text="Scene · prompt only"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource PlayerTextBrush}"
                                               IsVisible="{Binding HasSceneImage}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- ─── Progress bar ──────────────────────────────────────── -->
                        <ProgressBar Grid.Row="1"
                                     Value="{Binding ProcessingProgress, Mode=OneWay}"
                                     Foreground="{DynamicResource TabAccentBrush}"
                                     BorderThickness="0"
                                     IsVisible="{Binding IsProcessing}"/>
                        <!-- ─── Status row ────────────────────────────────────────── -->
                        <Border Grid.Row="2" Theme="{StaticResource ToolStripStyle}" BorderThickness="0,1,0,0" Padding="12,5">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5"
                                             Height="5"
                                             VerticalAlignment="Center"
                                             Margin="0,0,7,0"
                                             Classes="s12"
                                             Classes.s12_0="{Binding IsProcessing}">
                                        <Ellipse.Styles>
                                            <Style Selector="Ellipse.s12.s12_0" x:DataType="vmv:H3VrViewModel">
                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                            </Style>
                                        </Ellipse.Styles>
                                        <Ellipse.Theme>
                                            <ControlTheme TargetType="Ellipse" x:DataType="vmv:H3VrViewModel">
                                                <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                            </ControlTheme>
                                        </Ellipse.Theme>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ProcessingStatus}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="{Binding ProgressPercentage, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TabAccentBrush}"
                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                           IsVisible="{Binding IsProcessing}"/>
                            </Grid>
                        </Border>
                        <!-- ─── Action Buttons ────────────────────────────────────── -->
                        <Border Grid.Row="3" Theme="{StaticResource ToolStripStyle}" BorderThickness="0,1,0,0" Padding="10,6">
                            <StackPanel>
                                <!-- Why Add to Queue is on or off, on a line of its own: the status row above
                                           belongs to whatever is rendering, so during a queue run it cannot say this —
                                           which is exactly when it needs saying. -->
                                <TextBlock Text="{Binding QueueReadiness}"
                                           Margin="2,0,2,5"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Margin="0,0,8,0"
                                            Height="34"
                                            Command="{Binding GenerateCommand}"
                                            IsEnabled="{Binding CanGenerate}"
                                            Theme="{StaticResource AccentOutlineButtonStyle}"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            ToolTip.Tip="Snapshots the sheets, the prompt and the settings into the queue. Nothing renders until ▶ Generate is pressed. The render itself is the MiniMax I2V turbo pipeline. The sheets are already built, so nothing here waits on the GPU — load the next scene image and Analyze it while this one runs.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                            <TextBlock Text="Add to Queue" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Height="34"
                                            Width="112"
                                            Margin="0,0,8,0"
                                            Command="{Binding StartQueueCommand}"
                                            Theme="{StaticResource AccentButtonStyle}"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            ToolTip.Tip="Starts rendering everything pending in the queue. Add to Queue only stages a job — nothing reaches the GPU until this is pressed, so several prompts can be queued and then rendered in one run. Greyed out while the queue is already running, and when nothing is pending.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                            <TextBlock Text="Generate" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Height="34"
                                            Width="76"
                                            Margin="0,0,8,0"
                                            Command="{Binding CancelCommand}"
                                            Theme="{StaticResource DangerButtonStyle}"
                                            FontSize="11"
                                            ToolTip.Tip="Stops whatever is on the GPU — the sheet builder or the queue. Pending items stay queued.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Folds the sheet strip and the queue list away and gives their
                                             height to the board. On this row rather than in the queue
                                             header: this row is always on screen, and a handle that
                                             vanishes with what it folds is a one-way door. -->
                                    <Button Grid.Column="3"
                                            Command="{Binding ToggleTopPanelCommand}"
                                            Content="{Binding TopPanelToggleLabel}"
                                            ToolTip.Tip="{Binding TopPanelToggleTip}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Height="34"
                                            FontSize="10"
                                            Padding="10,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- ─── Queue ─────────────────────────────────────────────── -->
                        <Border Grid.Row="4"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="12,6"
                                IsVisible="{Binding HasQueueItems}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="🥽 VR Queue"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{DynamicResource TabAccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding QueueStatus}"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2"
                                            Content="▶ Generate"
                                            Command="{Binding StartQueueCommand}"
                                            Height="24"
                                            Padding="8,0"
                                            FontSize="11"
                                            Margin="0,0,5,0"
                                            Theme="{StaticResource AccentButtonStyle}"
                                            ToolTip.Tip="Starts rendering the pending items — the same command as the ▶ Generate button above."/>
                                    <Button Grid.Column="3"
                                            Content="🔄 Retry"
                                            Command="{Binding ReprocessAllFailedCommand}"
                                            Height="24"
                                            Padding="8,0"
                                            FontSize="11"
                                            Margin="0,0,5,0"
                                            Theme="{StaticResource AccentButtonStyle}"
                                            ToolTip.Tip="Put every failed item back to Pending and run them again."/>
                                    <Button Grid.Column="4"
                                            Content="⏹ Stop"
                                            Command="{Binding StopQueueCommand}"
                                            Height="24"
                                            Padding="8,0"
                                            FontSize="11"
                                            Margin="0,0,5,0"
                                            Theme="{StaticResource AccentButtonStyle}"/>
                                    <Button Grid.Column="5"
                                            Content="🗑️ Clear"
                                            Command="{Binding ClearQueueCommand}"
                                            Height="24"
                                            Padding="8,0"
                                            FontSize="11"
                                            Theme="{StaticResource AccentButtonStyle}"/>
                                </Grid>
                                <!-- Capped and scrolled: the pane no longer scrolls as a whole, so
                                             twelve queue rows left uncapped would push the board off the
                                             bottom of the tab instead of merely being long. -->
                                <ScrollViewer MaxHeight="104"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="0,6,0,0"
                                              IsVisible="{Binding IsTopPanelVisible}">
                                    <ItemsControl ItemsSource="{Binding Queue}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:H3CastQueueItem">
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        Margin="0,0,0,3"
                                                        Background="White">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                CornerRadius="3"
                                                                Padding="6,2"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding StatusColor}">
                                                            <TextBlock Text="{Binding StatusDisplay}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <Image Grid.Column="1"
                                                               Source="{Binding QueueThumbnail, Converter={StaticResource PathToBitmapConverter}}"
                                                               Height="28"
                                                               Stretch="Uniform"
                                                               Margin="0,0,8,0"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Prompt}"
                                                                       FontSize="10"
                                                                       MaxHeight="14"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ErrorMessage}"
                                                                       FontSize="10"
                                                                       MaxHeight="14"
                                                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                       Foreground="{StaticResource DangerBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="3"
                                                                Content="✕"
                                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding $parent[ItemsControl].((vmv:H3VrViewModel)DataContext).RemoveQueueItemCommand}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center"
                                                                Width="24"
                                                                Height="24"
                                                                Padding="0"
                                                                FontSize="10"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <!-- ═══ WORKSPACE: board left, player docked right ═══════════════
                                     The split is the whole point of the redesign. Neither half ever
                                     scrolls the other: pick a take on the left, watch it on the right,
                                     pick the next one — nothing moves.
                                     ═══════════════════════════════════════════════════════════════ -->
                        <Grid Grid.Row="5" Background="White">
                            <Grid.ColumnDefinitions>
                                <!-- Proportional, not a fixed 420: on an ultrawide every extra pixel
                                             went to the board and the player stayed a postage stamp. The
                                             floors keep both halves usable when the pane is narrow, and the
                                             splitter overrides the split whenever you disagree. -->
                                <ColumnDefinition Width="7*" MinWidth="380"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>
                            <!-- ─── The hunt board ─────────────────────────────────────
                                         Every queued clip's takes, all of them, at once. The hunt
                                         sweep fills this without stopping, so a twelve-clip story
                                         arrives as thirty-six takes to choose between rather than
                                         twelve interruptions to sit through.

                                         Still frames, not players: WPF renders several simultaneous
                                         MediaElements as solid black, and here it would be dozens.
                                         The tile you click plays in the docked player. -->
                            <Grid Grid.Column="0" Margin="10,8,6,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Header: what the board is, how far through it you are, and
                                             how big the tiles should be. -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="🎯 Seed hunt board"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TabAccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <!-- The two counts the board keeps: how much of it has been
                                                 answered, and how much of it is waiting on the GPU. Side by
                                                 side in one auto column — two Borders in the same cell would
                                                 sit on top of each other. -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="9"
                                                Padding="8,2"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                IsVisible="{Binding ShowBoard}">
                                            <TextBlock Text="{Binding PickProgress}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                        <!-- Re-rolls asked for while the sweep has the GPU. They run
                                                     when it ends, and until then this is the only place a
                                                     whole board's worth of them can be seen at once — the row
                                                     one belongs to may be scrolled off. -->
                                        <Border CornerRadius="9"
                                                Padding="8,2"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource NeutralBrush}"
                                                IsVisible="{Binding HasQueuedRerolls}"
                                                ToolTip.Tip="Re-rolls waiting for the GPU. They start on their own when the sweep that is running finishes — click a queued die again to take it back out.">
                                            <TextBlock Text="{Binding RerollQueueNote}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding HuntStatus}"
                                               FontStyle="Italic"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <!-- Tile size. The board is used two ways — scanning a whole
                                                 story for the beat that went wrong, and telling three
                                                 near-identical takes apart — and they want different
                                                 sized tiles. -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="tiles"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <Button Content="−"
                                                Command="{Binding ZoomTilesOutCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Width="24"
                                                Height="22"
                                                Padding="0"
                                                FontSize="12"
                                                Margin="0,0,3,0"
                                                ToolTip.Tip="Smaller takes — more of the story on one screen."/>
                                        <Button Content="+"
                                                Command="{Binding ZoomTilesInCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Width="24"
                                                Height="22"
                                                Padding="0"
                                                FontSize="12"
                                                ToolTip.Tip="Bigger takes — for telling three near-identical ones apart."/>
                                    </StackPanel>
                                </Grid>
                                <!-- The things that can be done to the whole board at once.
                                             Finish picked is the one that spends GPU. -->
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding ShowBoard}">
                                    <Button Content="✨ Finish picked"
                                            Command="{Binding FinishPickedCommand}"
                                            Height="26"
                                            Padding="10,0"
                                            FontSize="11"
                                            Margin="0,0,5,0"
                                            Theme="{StaticResource AccentButtonStyle}"
                                            ToolTip.Tip="Upscales every picked take to the finished canvas, in queue order, and joins the story when the last clip lands.&#10;&#10;With 'Finish automatically' on this starts by itself once every clip has been picked — this button is for finishing part of a board early."/>
                                    <Button Content="✓ Take 1 everywhere → finish"
                                            Command="{Binding PickFirstEverywhereCommand}"
                                            Height="26"
                                            Padding="10,0"
                                            FontSize="11"
                                            Margin="0,0,5,0"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            ToolTip.Tip="Take 1 on every clip that has one, and then run the rest of the queue to the end without asking again: clips still to be hunted are hunted, their take 1 is picked as it lands, every pick is upscaled, and the story is joined.&#10;&#10;Pressing this ticks Auto-pick (at take 1) and Finish automatically, which is how the rest of the run stays unattended — you will see both switches go on. Untick either one afterwards to take the board back.&#10;&#10;A stale clip is skipped by both sweeps and will be missing from the join; the log says how many there are. 🎲 Re-roll those first if you want them in."/>
                                    <Button Content="✕ Clear picks"
                                            Command="{Binding ClearPicksCommand}"
                                            Height="26"
                                            Padding="10,0"
                                            FontSize="11"
                                            Margin="0,0,5,0"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            ToolTip.Tip="Un-picks every clip that has not been finished yet. The drafts stay on the board."/>
                                    <Button Content="{Binding PromptsToggleLabel}"
                                            Command="{Binding ToggleAllPromptsCommand}"
                                            Height="26"
                                            Padding="10,0"
                                            FontSize="11"
                                            Margin="0,0,5,0"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            ToolTip.Tip="Opens every clip's prompt box at once, or shuts them all. They are shut by default because a dozen open boxes are taller than the takes they belong to — each row's own ✎ button opens just that one."/>
                                    <CheckBox Content="Finish automatically"
                                              IsChecked="{Binding AutoFinishWhenPicked}"
                                              VerticalAlignment="Center"
                                              FontSize="11"
                                              Margin="4,0,0,0"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              ToolTip.Tip="Starts the finish sweep on its own the moment the last unpicked clip is chosen, so the final click on the board is what sets the upscales and the join going.&#10;&#10;It waits for all of them on purpose: finishing clip 1 the instant it is picked would put the GPU under the board while clip 2 is still being watched."/>
                                </WrapPanel>
                                <!-- Empty state: the board's own frame, so the pane does not look
                                             broken before anything is queued. -->
                                <Border Grid.Row="2"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        Classes="s13"
                                        Classes.s13_0="{Binding ShowBoard}">
                                    <Border.Styles>
                                        <Style Selector="Border.s13.s13_0" x:DataType="vmv:H3VrViewModel">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </Style>
                                    </Border.Styles>
                                    <!-- The shared BooleanToVisibilityConverter is the framework's and
                                                 does not invert, so the empty state hides itself on a trigger. -->
                                    <Border.Theme>
                                        <ControlTheme TargetType="Border" x:DataType="vmv:H3VrViewModel">
                                            <Setter Property="IsVisible" Value="True"/>
                                        </ControlTheme>
                                    </Border.Theme>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="Queue a story and the takes land here"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Three takes per clip · click one to watch it and choose it · each take is one wide frame, two eyes"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- The rows. This is the only thing in the pane that scrolls. -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowBoard}">
                                    <ItemsControl ItemsSource="{Binding HuntBoard}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:ErosHuntClip">
                                                <!-- One clip, one band. Takes on the left, what the
                                                             clip says in the middle, its buttons on the
                                                             right — so a row is as tall as a tile and a
                                                             twelve-clip story is two screens, not twelve. -->
                                                <Border Margin="0,0,4,5"
                                                        Padding="6"
                                                        CornerRadius="6"
                                                        Background="White"
                                                        BorderThickness="1"
                                                        Classes="s14"
                                                        Classes.s14_0="{Binding IsFinished}"
                                                        Classes.s14_1="{Binding IsStale}"
                                                        Classes.s14_2="{Binding IsBusy}">
                                                    <Border.Styles>
                                                        <Style Selector="Border.s14.s14_0" x:DataType="m:ErosHuntClip">
                                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                        </Style>
                                                        <Style Selector="Border.s14.s14_1" x:DataType="m:ErosHuntClip">
                                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                        </Style>
                                                        <Style Selector="Border.s14.s14_2" x:DataType="m:ErosHuntClip">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                                        </Style>
                                                    </Border.Styles>
                                                    <Border.Theme>
                                                        <ControlTheme TargetType="Border" x:DataType="m:ErosHuntClip">
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                        </ControlTheme>
                                                    </Border.Theme>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*" MinWidth="120"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- The clip's takes. Clicking a tile watches it AND picks it. -->
                                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding Drafts}" VerticalAlignment="Top">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="m:ErosSeedDraft">
                                                                        <!-- Square on purpose: the drafts are portrait in
                                                                                     one story and landscape in the next, and a box
                                                                                     shaped for one wastes half its width on the
                                                                                     other. Side comes from the board's tile dial. -->
                                                                        <Border Margin="0,0,4,0"
                                                                                CornerRadius="5"
                                                                                Width="{Binding TileSize}"
                                                                                Height="{Binding TileSize}"
                                                                                Background="{StaticResource PlayerSurfaceBrush}"
                                                                                BorderThickness="2"
                                                                                ClipToBounds="True"
                                                                                Classes="s15"
                                                                                Classes.s15_0="{Binding IsPicked}">
                                                                            <Border.Styles>
                                                                                <Style Selector="Border.s15.s15_0" x:DataType="m:ErosSeedDraft">
                                                                                    <Setter Property="BorderBrush"
                                                                                            Value="{DynamicResource TabAccentBrush}"/>
                                                                                </Style>
                                                                            </Border.Styles>
                                                                            <Border.Theme>
                                                                                <ControlTheme TargetType="Border" x:DataType="m:ErosSeedDraft">
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                                                </ControlTheme>
                                                                            </Border.Theme>
                                                                            <Grid>
                                                                                <!-- The tile itself is the pick button: the
                                                                                             click that plays a take is the click that
                                                                                             chooses it, and the ✓ is a readout. -->
                                                                                <Button Background="Transparent"
                                                                                        BorderThickness="0"
                                                                                        Padding="0"
                                                                                        Cursor="Hand"
                                                                                        Command="{Binding PickCommand}"
                                                                                        ToolTip.Tip="{Binding TileTip}">
                                                                                    <Grid>
                                                                                        <TextBlock Text="{Binding Status}"
                                                                                                   FontSize="9"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"
                                                                                                   TextWrapping="Wrap"
                                                                                                   TextAlignment="Center"
                                                                                                   Margin="4,0"
                                                                                                   Foreground="{StaticResource PlayerTextBrush}"/>
                                                                                        <Image Source="{Binding Thumbnail, Converter={StaticResource PathToBitmapConverter}}"
                                                                                               Stretch="UniformToFill"/>
                                                                                    </Grid>
                                                                                </Button>
                                                                                <!-- Slot number, always. With the seed line
                                                                                             gone this is how "re-roll take 2" stays
                                                                                             a thing you can say out loud. -->
                                                                                <Border CornerRadius="3"
                                                                                        Padding="4,0"
                                                                                        Margin="3"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Top"
                                                                                        Background="{StaticResource ScrimBrush}"
                                                                                        IsHitTestVisible="False">
                                                                                    <TextBlock Text="{Binding Slot}"
                                                                                               FontSize="9"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="White"/>
                                                                                </Border>
                                                                                <Border CornerRadius="3"
                                                                                        Padding="4,0"
                                                                                        Margin="3"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Top"
                                                                                        Background="{DynamicResource TabAccentBrush}"
                                                                                        IsHitTestVisible="False"
                                                                                        IsVisible="{Binding IsPicked}">
                                                                                    <TextBlock Text="✓"
                                                                                               FontSize="9"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="White"/>
                                                                                </Border>
                                                                                <!-- Waiting for the GPU: this take was re-rolled while a sweep was
                                                                                             running, so the click was parked rather than refused. Bottom-left,
                                                                                             the one corner the slot number, the tick and the hover buttons all
                                                                                             leave free — and not under the pointer that put it here. -->
                                                                                <Border CornerRadius="3"
                                                                                        Padding="4,0"
                                                                                        Margin="3"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Bottom"
                                                                                        Background="{StaticResource NeutralBrush}"
                                                                                        IsHitTestVisible="False"
                                                                                        IsVisible="{Binding IsRerollQueued}">
                                                                                    <TextBlock Text="🎲"
                                                                                               FontSize="9"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="White"/>
                                                                                </Border>
                                                                                <!-- 🎲 and ✕ on hover, over the tile rather
                                                                                             than under it: a row of buttons beneath
                                                                                             every take was a third of the board's
                                                                                             height spent on things clicked rarely.
                                                                                             Siblings of the pick button, not children
                                                                                             of it, so a click here does not also pick.
                                                                                             The ancestor Border is the tile.

                                                                                             Cornered rather than a band across the
                                                                                             bottom: a full-width strip put ✕ under
                                                                                             where you aim to pick, and the misclick
                                                                                             deletes a take. -->
                                                                                <Border VerticalAlignment="Bottom"
                                                                                        HorizontalAlignment="Right"
                                                                                        CornerRadius="5"
                                                                                        Margin="3"
                                                                                        Background="{StaticResource ScrimBrush}"
                                                                                        Padding="2,2"
                                                                                        Classes="s16"
                                                                                        Classes.s16_0="{Binding IsPointerOver, RelativeSource={RelativeSource AncestorType=Border}}">
                                                                                    <Border.Styles>
                                                                                        <Style Selector="Border.s16.s16_0" x:DataType="m:ErosSeedDraft">
                                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                                        </Style>
                                                                                    </Border.Styles>
                                                                                    <Border.Theme>
                                                                                        <ControlTheme TargetType="Border" x:DataType="m:ErosSeedDraft">
                                                                                            <Setter Property="IsVisible" Value="False"/>
                                                                                        </ControlTheme>
                                                                                    </Border.Theme>
                                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                                        <Button Command="{Binding RerollCommand}"
                                                                                                Width="22"
                                                                                                Height="20"
                                                                                                Padding="0"
                                                                                                FontSize="9"
                                                                                                Margin="2,0"
                                                                                                ToolTip.Tip="{Binding RerollTip}"
                                                                                                Classes="s17"
                                                                                                Classes.s17_0="{Binding IsRerollQueued}">
                                                                                            <Button.Styles>
                                                                                                <Style Selector="Button.s17.s17_0"
                                                                                                       x:DataType="m:ErosSeedDraft">
                                                                                                    <Setter Property="Content" Value="⏳"/>
                                                                                                </Style>
                                                                                            </Button.Styles>
                                                                                            <Button.Theme>
                                                                                                <ControlTheme TargetType="Button"
                                                                                                              BasedOn="{StaticResource SecondaryButtonStyle}"
                                                                                                              x:DataType="m:ErosSeedDraft">
                                                                                                    <Setter Property="Content" Value="🎲"/>
                                                                                                </ControlTheme>
                                                                                            </Button.Theme>
                                                                                        </Button>
                                                                                        <Button Content="✕"
                                                                                                Command="{Binding DeleteCommand}"
                                                                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                                                                Width="22"
                                                                                                Height="20"
                                                                                                Padding="0"
                                                                                                FontSize="9"
                                                                                                Margin="2,0"
                                                                                                ToolTip.Tip="Throws this take away, tile and file. The empty slot can be re-rolled into something better."/>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- What the clip is and what it says. -->
                                                            <StackPanel Grid.Column="1" Margin="8,2,8,0" VerticalAlignment="Top">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontWeight="Bold"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource TabAccentBrush}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,7,0"/>
                                                                    <!-- State as a pill rather than grey italics off to the
                                                                                 right: on a long board the one thing you scan for is
                                                                                 which rows still want something from you. -->
                                                                    <Border CornerRadius="8"
                                                                            Padding="7,1"
                                                                            VerticalAlignment="Center"
                                                                            Classes="s18"
                                                                            Classes.s18_0="{Binding HasPick}"
                                                                            Classes.s18_1="{Binding IsStale}"
                                                                            Classes.s18_2="{Binding IsRerollQueued}"
                                                                            Classes.s18_3="{Binding IsBusy}">
                                                                        <Border.Styles>
                                                                            <Style Selector="Border.s18.s18_0" x:DataType="m:ErosHuntClip">
                                                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                                            </Style>
                                                                            <Style Selector="Border.s18.s18_1" x:DataType="m:ErosHuntClip">
                                                                                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                            </Style>
                                                                            <Style Selector="Border.s18.s18_2" x:DataType="m:ErosHuntClip">
                                                                                <Setter Property="Background" Value="{StaticResource NeutralBrush}"/>
                                                                            </Style>
                                                                            <Style Selector="Border.s18.s18_3" x:DataType="m:ErosHuntClip">
                                                                                <Setter Property="Background" Value="{DynamicResource TabAccentBrush}"/>
                                                                            </Style>
                                                                        </Border.Styles>
                                                                        <Border.Theme>
                                                                            <ControlTheme TargetType="Border" x:DataType="m:ErosHuntClip">
                                                                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                            </ControlTheme>
                                                                        </Border.Theme>
                                                                        <TextBlock Text="{Binding Status}"
                                                                                   FontSize="9"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="260"
                                                                                   Classes="s19"
                                                                                   Classes.s19_0="{Binding HasPick}"
                                                                                   Classes.s19_1="{Binding IsStale}"
                                                                                   Classes.s19_2="{Binding IsRerollQueued}"
                                                                                   Classes.s19_3="{Binding IsBusy}">
                                                                            <TextBlock.Styles>
                                                                                <Style Selector="TextBlock.s19.s19_0" x:DataType="m:ErosHuntClip">
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </Style>
                                                                                <Style Selector="TextBlock.s19.s19_1" x:DataType="m:ErosHuntClip">
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </Style>
                                                                                <Style Selector="TextBlock.s19.s19_2" x:DataType="m:ErosHuntClip">
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </Style>
                                                                                <Style Selector="TextBlock.s19.s19_3" x:DataType="m:ErosHuntClip">
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </Style>
                                                                            </TextBlock.Styles>
                                                                            <TextBlock.Theme>
                                                                                <ControlTheme TargetType="TextBlock" x:DataType="m:ErosHuntClip">
                                                                                    <Setter Property="Foreground"
                                                                                            Value="{StaticResource TextSecondaryBrush}"/>
                                                                                </ControlTheme>
                                                                            </TextBlock.Theme>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </StackPanel>
                                                                <!-- The clip's words fill the band beside its takes rather than
                                                                             stopping at two lines: on a wide board those two lines
                                                                             ended in an ellipsis with the rest of the row left white,
                                                                             which is truncation dressed up as whitespace. The cap
                                                                             tracks the tile dial, so the row never grows past its
                                                                             own takes however long the description is. -->
                                                                <TextBlock Text="{Binding Summary}"
                                                                           FontSize="10"
                                                                           LineHeight="14"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxHeight="{Binding TileSize, Converter={StaticResource SubtractConverter}, ConverterParameter=24}"/>
                                                            </StackPanel>
                                                            <!-- The row's own buttons. ✎ opens this clip's prompt
                                                                         below the band; the board-wide toggle opens all of them. -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                                <Button Content="✎"
                                                                        Command="{Binding ToggleDescriptionCommand}"
                                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                                        Width="26"
                                                                        Height="24"
                                                                        Padding="0"
                                                                        FontSize="11"
                                                                        Margin="0,0,4,0"
                                                                        ToolTip.Tip="Show this clip's description on its own, to reword a beat that came out wrong. Editing it stales the takes above — they were rendered from the old wording — so re-roll the clip afterwards."/>
                                                                <Button Content="▶"
                                                                        Command="{Binding PlayResultCommand}"
                                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                                        Width="26"
                                                                        Height="24"
                                                                        Padding="0"
                                                                        FontSize="10"
                                                                        Margin="0,0,4,0"
                                                                        ToolTip.Tip="Play this clip's finished video in the player."/>
                                                                <Button Content="{Binding RerollGlyph}"
                                                                        Command="{Binding RerollAllCommand}"
                                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                                        Width="26"
                                                                        Height="24"
                                                                        Padding="0"
                                                                        FontSize="10"
                                                                        ToolTip.Tip="{Binding RerollTip}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <!-- The clip's own words. Commits on losing focus, and an
                                                                     edit stales the takes above — they are of the old
                                                                     wording, and the finish re-samples from the prompt.
                                                                     Reword, then 🎲.

                                                                     Shut by default, and only the description H3 renders
                                                                     motion from is here — the reference preamble and the
                                                                     wardrobe lock above it are written by the app,
                                                                     identical in every clip, and hand-editing those is how
                                                                     a cast stops being wired correctly. -->
                                                        <TextBox Text="{Binding Description}"
                                                                 IsVisible="{Binding IsDescriptionOpen}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                 MinHeight="46"
                                                                 MaxHeight="120"
                                                                 FontSize="11"
                                                                 Padding="6,4"
                                                                 Margin="0,6,0,0"
                                                                 Background="White"
                                                                 BorderBrush="{StaticResource BorderBrush}"
                                                                 ToolTip.Tip="This clip's description, on its own. Edit it and the takes above go stale — they were rendered from the old wording, and finishing one would deliver a video you have never seen — so re-roll the clip (or a single take) to render what you have just written.&#10;&#10;The reference line and the wardrobe lock are not shown here on purpose: they are written by the app, identical in every clip, and are what keeps the cast wired to the right pictures."/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                            <GridSplitter Grid.Column="1"
                                          Width="5"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ResizeDirection="Columns"
                                          Background="{StaticResource BorderBrush}"
                                          ToolTip.Tip="Drag to give the takes more room, or the player."/>
                            <!-- ─── The docked player ──────────────────────────────────
                                         Pinned, and the only video element on the tab: WPF renders
                                         several simultaneous MediaElements as solid black, which is
                                         why the tiles are still frames and this is where they play.
                                         It does not move when the board scrolls, so choosing a take
                                         never costs a round trip down the page and back. -->
                            <Grid Grid.Column="2" Margin="6,8,10,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="🎥 Now watching" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TabAccentBrush}"/>
                                    <!-- Which clip, which take, which seed. The tiles no longer
                                                 print their seeds — three per row and twelve rows deep was
                                                 a wall of digits — and the seed that matters is the one
                                                 you have just chosen, so it lives here. -->
                                    <TextBlock Text="{Binding ActivePreviewLabel}"
                                               FontSize="10"
                                               FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Row="1"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Background="{StaticResource PlayerSurfaceBrush}"
                                        MinHeight="180"
                                        CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="Click a take on the board to watch it here"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Margin="14,0"
                                                   Foreground="{StaticResource PlayerTextBrush}"
                                                   FontStyle="Italic"
                                                   Classes="s20"
                                                   Classes.s20_0="{Binding !HasActivePreview}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.s20.s20_0" x:DataType="vmv:H3VrViewModel">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                </Style>
                                            </TextBlock.Styles>
                                            <TextBlock.Theme>
                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3VrViewModel">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </ControlTheme>
                                            </TextBlock.Theme>
                                        </TextBlock>
                                        <!-- Source is set from code-behind (ApplyH3VrSource) as an
                                                     ABSOLUTE Uri, and this element is never collapsed. A string
                                                     {Binding} silently fails to open Z:\output paths — no
                                                     MediaOpened, no MediaFailed, just a black frame — and a
                                                     collapsed MediaElement will not open media at all. Both
                                                     mistakes have been made on this app's other seed-hunt
                                                     players; do not regress to either. -->
                                        <ctrl:VideoPreview x:Name="H3VrVideoPlayer"
                                                           Stretch="Uniform"
                                                           IsMuted="{Binding IsPreviewMuted}"
                                                           MediaOpened="H3VrPlayer_MediaOpened"
                                                           MediaEnded="H3VrPlayer_MediaEnded"
                                                           MediaFailed="H3VrPlayer_MediaFailed"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="▶ Replay"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding PlayVideoCommand}"
                                            IsEnabled="{Binding HasResult}"
                                            Height="26"
                                            Padding="10,0"
                                            FontSize="11"
                                            Margin="0,0,6,0"/>
                                    <Button Content="📁 Folder"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding OpenResultFolderCommand}"
                                            IsEnabled="{Binding HasResult}"
                                            Height="26"
                                            Padding="10,0"
                                            FontSize="11"
                                            Margin="0,0,6,0"/>
                                    <!-- Muted by default. The player loops the take it is showing and a
                                                 pick loads a new one every few seconds; a hunt is judged on the
                                                 picture, and the three takes share the same generated audio bed. -->
                                    <Button Content="{Binding MuteGlyph}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ToggleMuteCommand}"
                                            ToolTip.Tip="{Binding MuteTip}"
                                            Width="30"
                                            Height="26"
                                            Padding="0"
                                            FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Row="3"
                                           Text="{Binding ResultVideoInfo}"
                                           Margin="0,5,0,0"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Grid>
                        <!-- ─── Log ───────────────────────────────────────────────── -->
                        <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="110"/>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- ═══════════════════════════════════════════════════════════════════════
                         Tab: H3 Express

                         H3 Batch without the seed hunt. A folder of story .txt files in, one joined
                         film per story out; each story's clips are rendered once each, in order -
                         no three drafts, no pick, no board.

                         Deliberately small. Where Batch keeps the whole Eros rail under its folder
                         card so a run can be inspected, this page is only what an unattended run
                         needs: the folder and its stories, the handful of dials that change the
                         film, a Render button, the player and a strip of clip chips.

                         Singularity and Researched prompts both start ticked.
                         ═══════════════════════════════════════════════════════════════════════ -->
            <TabItem Header="⚡ H3 Express">
                <Grid x:DataType="vmv:H3ExpressViewModel"
                      x:Name="H3ExpressRoot"
                      DataContext="{Binding H3ExpressVM}"
                      Theme="{StaticResource TabPageStyle}">
                    <Grid.Resources>
                        <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentVioletColor}"/>
                        <!-- One CAST slot: the photo is the button; ✕ clears it; the sex is under it. -->
                        <DataTemplate x:DataType="m:ExpressCastMember" x:Key="ExpressCastMemberTemplate">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Heading}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Tag}"
                                               FontSize="9"
                                               FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                                <Grid>
                                    <Button Command="{Binding BrowseCommand}"
                                            Height="124"
                                            Cursor="Hand"
                                            ToolTip.Tip="The person who plays this part in every story of the run. Click to choose or change the photo."
                                            Classes="t21">
                                        <Button.Styles>
                                            <Style Selector="Button.t21:pointerover /template/ Border#Bd">
                                                <Setter Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                            </Style>
                                            <Style Selector="Button.t21:disabled /template/ Border#Bd">
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        CornerRadius="6"
                                                        BorderThickness="1"
                                                        ClipToBounds="True"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        Background="{StaticResource SurfaceAltBrush}">
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Classes="s22"
                                                        Classes.s22_0="{Binding !HasPhoto}">
                                                <StackPanel.Styles>
                                                    <Style Selector="StackPanel.s22.s22_0" x:DataType="m:ExpressCastMember">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </StackPanel.Styles>
                                                <StackPanel.Theme>
                                                    <ControlTheme TargetType="StackPanel" x:DataType="m:ExpressCastMember">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </StackPanel.Theme>
                                                <TextBlock Text="＋"
                                                           FontSize="22"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                                <TextBlock Text="Add photo"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="empty: cast from the story"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Image Source="{Binding Preview, Converter={StaticResource PathToBitmapConverter}}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Button>
                                    <Button Content="✕"
                                            Command="{Binding ClearCommand}"
                                            Width="22"
                                            Height="22"
                                            Margin="0,5,5,0"
                                            FontSize="10"
                                            Cursor="Hand"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding HasPhoto}"
                                            ToolTip.Tip="Remove this photo — the part is cast from each story again.">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="11" Background="{StaticResource ScrimBrush}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{StaticResource PlayerTextBrush}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                </Grid>
                                <ComboBox ItemsSource="{Binding SexOptions}"
                                          SelectedItem="{Binding Sex, Mode=TwoWay}"
                                          Height="26"
                                          FontSize="11"
                                          Margin="0,6,0,0"
                                          ToolTip.Tip="Who is in the photo. The saved clips call each character he or she, so this should match the story's character — swap the photos if it does not."/>
                            </StackPanel>
                        </DataTemplate>
                        <!-- What one photographed person wears, for the own-clothes mode. -->
                        <DataTemplate x:DataType="m:ExpressCastMember" x:Key="ExpressCastOutfitTemplate">
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="{Binding Heading, StringFormat={}{0} wears}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Button Content="👁 Read from photo"
                                            Command="{Binding ReadOutfitCommand}"
                                            HorizontalAlignment="Right"
                                            Height="22"
                                            Padding="8,0"
                                            FontSize="10"
                                            Theme="{StaticResource AccentOutlineButtonStyle}"
                                            ToolTip.Tip="Ask the vision model what this person is wearing in the photo. You can also just type it."/>
                                </Grid>
                                <TextBox Text="{Binding Outfit}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="False"
                                         MinHeight="40"
                                         FontSize="11"
                                         Padding="6,4"
                                         ToolTip.Tip="One sentence naming every garment with its colour and material. Locked into every clip and used to build this person's character sheet."/>
                                <TextBlock Text="Reading the photo…"
                                           FontSize="10"
                                           Margin="0,3,0,0"
                                           Foreground="{DynamicResource TabAccentBrush}"
                                           IsVisible="{Binding IsReadingOutfit}"/>
                            </StackPanel>
                        </DataTemplate>
                        <!-- A small square glyph button on a job row: edit, move, requeue, remove. -->
                        <ControlTheme x:Key="JobGlyphButtonStyle" TargetType="Button" x:DataType="vmv:H3ExpressViewModel">
                            <Setter Property="Margin" Value="1,0,0,0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Name="PART_ContentPresenter"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style Selector="^:pointerover">
                                <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                                <Style Selector="^ /template/ Border#Bd">
                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                </Style>
                            </Style>
                            <Style Selector="^:disabled">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Style>
                        </ControlTheme>
                        <!-- A cast face on a job row: a small round thumbnail, absent when there is none. -->
                        <ControlTheme x:Key="JobFaceStyle" TargetType="Border" x:DataType="vmv:H3ExpressViewModel">
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="20"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="ClipToBounds" Value="True"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="Margin" Value="0,0,3,0"/>
                        </ControlTheme>
                        <!-- ═══ One job on the queue ════════════════════════════════════
                                     The row is the job: its place in the pipeline, what it renders,
                                     who is in it and on what stack. A queued job can be opened (✎),
                                     moved or dropped; the one rendering can only be watched; a
                                     finished one can be sent round again (↻). -->
                        <DataTemplate x:DataType="m:ExpressJob" x:Key="ExpressJobRowTemplate">
                            <Border Margin="0,3"
                                    CornerRadius="6"
                                    Padding="8,7"
                                    BorderThickness="1"
                                    ToolTip.Tip="{Binding Tooltip}"
                                    Classes="s23"
                                    Classes.s23_0="{Binding IsRunning}"
                                    Classes.s23_1="{Binding IsFinished}">
                                <Border.Styles>
                                    <Style Selector="Border.s23.s23_0" x:DataType="m:ExpressJob">
                                        <Setter Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                    </Style>
                                    <Style Selector="Border.s23.s23_1" x:DataType="m:ExpressJob">
                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                    </Style>
                                </Border.Styles>
                                <Border.Theme>
                                    <ControlTheme TargetType="Border" x:DataType="m:ExpressJob">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                    </ControlTheme>
                                </Border.Theme>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- ①②③ — where in the pipeline this job is. -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Ordinal}"
                                               FontSize="15"
                                               VerticalAlignment="Top"
                                               Margin="0,-1,8,0"
                                               Classes="s24"
                                               Classes.s24_0="{Binding IsRunning}"
                                               Classes.s24_1="{Binding IsFinished}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.s24.s24_0" x:DataType="m:ExpressJob">
                                                <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                                            </Style>
                                            <Style Selector="TextBlock.s24.s24_1" x:DataType="m:ExpressJob">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </Style>
                                        </TextBlock.Styles>
                                        <TextBlock.Theme>
                                            <ControlTheme TargetType="TextBlock" x:DataType="m:ExpressJob">
                                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                                            </ControlTheme>
                                        </TextBlock.Theme>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,74,0"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding StateText}"
                                                       FontSize="9"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Classes="s25"
                                                       Classes.s25_0="{Binding IsRunning}"
                                                       Classes.s25_1="{Binding StateText, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=finished}"
                                                       Classes.s25_2="{Binding StateText, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=stopped}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s25.s25_0" x:DataType="m:ExpressJob">
                                                        <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                    <Style Selector="TextBlock.s25.s25_1" x:DataType="m:ExpressJob">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                    </Style>
                                                    <Style Selector="TextBlock.s25.s25_2" x:DataType="m:ExpressJob">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="m:ExpressJob">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding StoriesLine}"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <!-- The faces this job casts with, then what it renders on. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Theme="{StaticResource JobFaceStyle}"
                                                    IsVisible="{Binding Cast1Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Image Source="{Binding Cast1Preview, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <Border Theme="{StaticResource JobFaceStyle}"
                                                    Margin="0,0,6,0"
                                                    IsVisible="{Binding Cast2Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Image Source="{Binding Cast2Preview, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding RenderLine}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- What can be done to it, by state. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="✎"
                                                Width="22"
                                                Height="20"
                                                FontSize="11"
                                                Theme="{StaticResource JobGlyphButtonStyle}"
                                                Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).EditJobCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsQueued}"
                                                ToolTip.Tip="Open this job and change its folder, its cast or its settings."/>
                                        <Button Content="↑"
                                                Width="20"
                                                Height="20"
                                                FontSize="11"
                                                Theme="{StaticResource JobGlyphButtonStyle}"
                                                Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).MoveJobUpCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsQueued}"
                                                ToolTip.Tip="Run this job sooner."/>
                                        <Button Content="↓"
                                                Width="20"
                                                Height="20"
                                                FontSize="11"
                                                Theme="{StaticResource JobGlyphButtonStyle}"
                                                Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).MoveJobDownCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsQueued}"
                                                ToolTip.Tip="Run this job later."/>
                                        <Button Content="↻"
                                                Width="22"
                                                Height="20"
                                                FontSize="11"
                                                Theme="{StaticResource JobGlyphButtonStyle}"
                                                Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).RequeueJobCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsFinished}"
                                                ToolTip.Tip="Put this job back on the queue with every story waiting again."/>
                                        <Button Content="✕"
                                                Width="20"
                                                Height="20"
                                                FontSize="10"
                                                Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).RemoveJobCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Take this job off the list. Nothing on disk is touched."
                                                Classes="s26"
                                                Classes.s26_0="{Binding IsRunning}">
                                            <Button.Styles>
                                                <Style Selector="Button.s26.s26_0" x:DataType="m:ExpressJob">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </Style>
                                            </Button.Styles>
                                            <Button.Theme>
                                                <ControlTheme TargetType="Button"
                                                              BasedOn="{StaticResource JobGlyphButtonStyle}"
                                                              x:DataType="m:ExpressJob">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                </ControlTheme>
                                            </Button.Theme>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <!-- One row of the LoRA stack: the LoRA, its strength, and ✕ to drop it.
                                     The rows load in the order they are listed, each onto the one above. -->
                        <DataTemplate x:DataType="m:H3ExpressLoraSlot" x:Key="ExpressLoraRowTemplate">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).LoraOptions}"
                                              DisplayMemberBinding="{ReflectionBinding Label}"
                                              SelectedValueBinding="{ReflectionBinding Value}"
                                              SelectedValue="{Binding Name, Mode=TwoWay}"
                                              Height="28"
                                              FontSize="11"
                                              ToolTip.Tip="A LoRA from loras/H3 on the server, applied on top of the checkpoint to every clip. Rows load in the order they are listed."/>
                                    <StackPanel IsVisible="{Binding HasLora}">
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                <TextBlock Text="{Binding Strength, StringFormat={}{0:0.00}}"
                                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider Value="{Binding Strength}"
                                                Minimum="0"
                                                Maximum="2"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="0.05"
                                                LargeChange="0.25"
                                                Foreground="{DynamicResource TabAccentBrush}"
                                                ToolTip.Tip="The LoRA's strength_model. 1.00 is the default; 0 leaves this row out of the graph."/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        Width="22"
                                        Height="28"
                                        FontSize="10"
                                        Margin="4,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Top"
                                        Cursor="Hand"
                                        Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).RemoveLoraCommand}"
                                        CommandParameter="{Binding}"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        ToolTip.Tip="Drop this LoRA."/>
                            </Grid>
                        </DataTemplate>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ═══ LEFT RAIL: what to render, and how ═══════════════════════ -->
                    <Border Grid.Column="0" Theme="{StaticResource TabSideRailStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <Border Theme="{StaticResource IntroBannerStyle}">
                                    <StackPanel>
                                        <TextBlock Text="⚡ H3 Express" Theme="{StaticResource IntroTitleStyle}"/>
                                        <TextBlock Theme="{StaticResource IntroBodyStyle}"
                                                   Text="A folder of stories in, finished films out. No seed hunt: every clip is rendered once, in order, and each story is joined."/>
                                    </StackPanel>
                                </Border>
                                <!-- ─── The job queue ───────────────────────────────────────
                                             The pipeline, at the top of the rail, because everything under
                                             it is one job — the one ⚡ Render runs, and the one the page is
                                             frozen on while it does. ➕ composes another somewhere the
                                             render is not reading (ExpressJobWindow) and lines it up behind
                                             this one; it takes the tab over between two stories, bringing
                                             its own folder, cast and stack with it. -->
                                <Border Theme="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ctrl:SectionHeader Grid.Column="0" Title="JOBS" Note="  · run in order"/>
                                            <Button Grid.Column="1"
                                                    Content="Clear finished"
                                                    Height="20"
                                                    Padding="7,0"
                                                    FontSize="9"
                                                    VerticalAlignment="Top"
                                                    Theme="{StaticResource JobGlyphButtonStyle}"
                                                    Command="{Binding ClearFinishedJobsCommand}"
                                                    IsVisible="{Binding HasFinishedJobs}"
                                                    ToolTip.Tip="Take the jobs that have finished off the list."/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Jobs}"
                                                      ItemTemplate="{StaticResource ExpressJobRowTemplate}"
                                                      IsVisible="{Binding HasJobs}"
                                                      Margin="0,0,0,8"/>
                                        <!-- ▶ is here as well as in the header strip because this is
                                                     where the plan is: with a queue, ▶ starts at ① and works
                                                     down it. The page is never put in front of the queue. -->
                                        <Button Content="{Binding StartQueueText}"
                                                Command="{Binding StartBatchCommand}"
                                                Height="34"
                                                FontSize="12"
                                                Margin="0,0,0,6"
                                                Theme="{StaticResource AccentButtonStyle}"
                                                IsVisible="{Binding HasQueuedJobs}"
                                                ToolTip.Tip="Render the jobs above, in this order — each one's own folder, cast and render settings applied as its turn comes. Same as ⚡ Render at the top of the page."/>
                                        <Button Content="✕ Stop"
                                                Command="{Binding StopBatchCommand}"
                                                Height="30"
                                                FontSize="11"
                                                Margin="0,0,0,6"
                                                Theme="{StaticResource DangerButtonStyle}"
                                                IsVisible="{Binding IsBatchRunning}"
                                                ToolTip.Tip="Cut the current story short and stop. Films already made are kept, and the jobs still queued stay on the list."/>
                                        <Button Content="➕ Queue another job…"
                                                Command="{Binding NewJobCommand}"
                                                Height="34"
                                                FontSize="12"
                                                Theme="{StaticResource AccentOutlineButtonStyle}"
                                                ToolTip.Tip="Set up a whole second job — its own folder of stories, its own cast photos and its own render workflow — and line it up behind whatever is running. It does not touch the run in progress: it starts when that one's last film is joined."/>
                                        <!-- The page's own folder is not in the queue; this is how it
                                                     gets there, rather than by being slipped in ahead of it. -->
                                        <Button Content="➕ Add this page as a job"
                                                Command="{Binding QueuePageCommand}"
                                                Height="30"
                                                FontSize="11"
                                                Margin="0,6,0,0"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                IsVisible="{Binding CanQueuePage}"
                                                ToolTip.Tip="Put the folder, cast and settings on this page at the end of the queue, as a job of its own. Without this they are not part of a queued run."/>
                                        <TextBlock Text="{Binding JobQueueSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- ─── Stories ─────────────────────────────────────────── -->
                                <Border Theme="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <ctrl:SectionHeader Title="STORIES" Note="  · every .txt becomes a film" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Margin="0,0,4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="Choose folder…"
                                                        Command="{Binding PickFolderCommand}"
                                                        Height="30"
                                                        FontSize="11"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        ToolTip.Tip="The folder of story files. Every .txt, .md or .text in it becomes one film, in name order. Sub-folders are not searched."/>
                                                <!-- Saved stories: pick one in the window and press ➕ Add to stories list. -->
                                                <Button Grid.Column="2"
                                                        Content="📚 Add saved…"
                                                        Command="{Binding OpenStoryPromptsCommand}"
                                                        Height="30"
                                                        FontSize="11"
                                                        Padding="6,0"
                                                        Theme="{StaticResource AccentOutlineButtonStyle}"
                                                        ToolTip.Tip="Add stories whose clip prompts are already saved — from any folder, or imported from the other H3 tabs. Opens 📚 Story prompts: pick a story and press ➕ Add to stories list (or ➕ Add all). It renders like a story from the folder, with the CAST card."/>
                                            </Grid>
                                            <Button Grid.Column="1"
                                                    Content="⟳"
                                                    Width="30"
                                                    Height="30"
                                                    FontSize="13"
                                                    Command="{Binding RescanCommand}"
                                                    Margin="0,0,4,0"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="Re-read the folder. Stories already in the list keep their state."/>
                                            <Button Grid.Column="2"
                                                    Content="📁"
                                                    Width="30"
                                                    Height="30"
                                                    FontSize="13"
                                                    Command="{Binding OpenStoryFolderCommand}"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="Open the story folder in Explorer."/>
                                        </Grid>
                                        <TextBlock Text="{Binding FolderSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,8"/>
                                        <!-- One row per story: a state dot, the name and what happened, ▶ once
                                                     it has a film. Commands are reached through the ItemsControl's own
                                                     DataContext rather than ElementName, which does not resolve from
                                                     inside a DataTemplate. -->
                                        <Border BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                MinHeight="80"
                                                MaxHeight="280">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Stories}" Margin="6,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:BatchStory">
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Grid.Column="0"
                                                                         Width="8"
                                                                         Height="8"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,4,8,0"
                                                                         Classes="s27"
                                                                         Classes.s27_0="{Binding IsProcessing}"
                                                                         Classes.s27_1="{Binding IsDone}"
                                                                         Classes.s27_2="{Binding IsFailed}">
                                                                    <Ellipse.Styles>
                                                                        <Style Selector="Ellipse.s27.s27_0" x:DataType="m:BatchStory">
                                                                            <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                                        </Style>
                                                                        <Style Selector="Ellipse.s27.s27_1" x:DataType="m:BatchStory">
                                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                        </Style>
                                                                        <Style Selector="Ellipse.s27.s27_2" x:DataType="m:BatchStory">
                                                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                                        </Style>
                                                                    </Ellipse.Styles>
                                                                    <Ellipse.Theme>
                                                                        <ControlTheme TargetType="Ellipse" x:DataType="m:BatchStory">
                                                                            <Setter Property="Fill" Value="{StaticResource TextFaintBrush}"/>
                                                                        </ControlTheme>
                                                                    </Ellipse.Theme>
                                                                </Ellipse>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding StatusText}"
                                                                               FontSize="10"
                                                                               TextWrapping="Wrap"
                                                                               Classes="s28"
                                                                               Classes.s28_0="{Binding IsProcessing}"
                                                                               Classes.s28_1="{Binding IsDone}"
                                                                               Classes.s28_2="{Binding IsFailed}">
                                                                        <TextBlock.Styles>
                                                                            <Style Selector="TextBlock.s28.s28_0" x:DataType="m:BatchStory">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                                                                            </Style>
                                                                            <Style Selector="TextBlock.s28.s28_1" x:DataType="m:BatchStory">
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                                            </Style>
                                                                            <Style Selector="TextBlock.s28.s28_2" x:DataType="m:BatchStory">
                                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                            </Style>
                                                                        </TextBlock.Styles>
                                                                        <TextBlock.Theme>
                                                                            <ControlTheme TargetType="TextBlock" x:DataType="m:BatchStory">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                            </ControlTheme>
                                                                        </TextBlock.Theme>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <!-- 📚 n: this story's clip prompts are saved, so it skips the writer. -->
                                                                <Button Grid.Column="2"
                                                                        Height="22"
                                                                        Padding="5,0"
                                                                        FontSize="9"
                                                                        Margin="6,0,0,0"
                                                                        VerticalAlignment="Top"
                                                                        Theme="{StaticResource AccentOutlineButtonStyle}"
                                                                        Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).OpenStoryPromptsCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        IsVisible="{Binding HasSavedPrompts}"
                                                                        ToolTip.Tip="{Binding SavedPromptsTip}">
                                                                    <TextBlock Text="{Binding SavedClipCount, StringFormat={}📚 {0}}" FontSize="9"/>
                                                                </Button>
                                                                <Button Grid.Column="3"
                                                                        Content="▶"
                                                                        Width="26"
                                                                        Height="22"
                                                                        Padding="0"
                                                                        FontSize="9"
                                                                        Margin="6,0,2,0"
                                                                        VerticalAlignment="Top"
                                                                        Theme="{StaticResource AccentOutlineButtonStyle}"
                                                                        Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).PlayStoryCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        IsVisible="{Binding HasOutput}"
                                                                        ToolTip.Tip="Play this story's joined film."/>
                                                                <Button Grid.Column="4"
                                                                        Content="✕"
                                                                        Width="20"
                                                                        Height="22"
                                                                        FontSize="10"
                                                                        VerticalAlignment="Top"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Foreground="{StaticResource TextMutedBrush}"
                                                                        Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).RemoveStoryCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="Take this story out of the list. The file is not touched."/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                        <!-- The saved clip prompts, per story: read, edit, forget. -->
                                        <Button Content="{Binding StoryPromptsButtonText}"
                                                Command="{Binding OpenStoryPromptsCommand}"
                                                Height="32"
                                                Margin="0,10,0,0"
                                                FontSize="12"
                                                Theme="{StaticResource AccentOutlineButtonStyle}"
                                                ToolTip.Tip="Every story's written clip prompts, saved under the story they came from. Read them, edit any clip, or forget a story so its next render writes them again."/>
                                    </StackPanel>
                                </Border>
                                <!-- ─── Cast: the run's own people ──────────────────────── -->
                                <Border Theme="{StaticResource SectionCardStyle}">
                                    <StackPanel IsEnabled="{Binding CanEditCast}">
                                        <ctrl:SectionHeader Title="CAST" Note="  · optional · your people in every story" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Grid.Column="0"
                                                            Content="{Binding CastMember1}"
                                                            ContentTemplate="{StaticResource ExpressCastMemberTemplate}"/>
                                            <ContentControl Grid.Column="2"
                                                            Content="{Binding CastMember2}"
                                                            ContentTemplate="{StaticResource ExpressCastMemberTemplate}"/>
                                        </Grid>
                                        <TextBlock Text="What they wear"
                                                   FontSize="10"
                                                   Margin="0,0,0,4"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <RadioButton Content="👗 The story's saved wardrobe"
                                                     GroupName="ExpressCastClothes"
                                                     IsChecked="{Binding CastStoryWardrobe, Mode=TwoWay}"
                                                     FontSize="11"
                                                     Margin="0,0,0,3"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     ToolTip.Tip="Your people in each story's own outfits. The character sheets re-dress them; saved clips are used word for word. No extra LLM calls."/>
                                        <RadioButton Content="👕 Their own clothes"
                                                     GroupName="ExpressCastClothes"
                                                     IsChecked="{Binding CastOwnClothes, Mode=TwoWay}"
                                                     FontSize="11"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     ToolTip.Tip="Your people in what they wear in their photos. A saved story's clips get a clothing-only rewrite (one short LLM call per clip), kept for next time."/>
                                        <StackPanel IsVisible="{Binding CastOwnClothes}">
                                            <ContentControl Content="{Binding CastMember1}"
                                                            ContentTemplate="{StaticResource ExpressCastOutfitTemplate}"
                                                            IsVisible="{Binding CastMember1.HasPhoto}"/>
                                            <ContentControl Content="{Binding CastMember2}"
                                                            ContentTemplate="{StaticResource ExpressCastOutfitTemplate}"
                                                            IsVisible="{Binding CastMember2.HasPhoto}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExpressCastSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <!-- ─── Render settings ─────────────────────────────────── -->
                                <Border Theme="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <ctrl:SectionHeader Title="RENDER" Note="  · applies to every story" Margin="0,0,0,10"/>
                                        <TextBlock Text="Sampling stack"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <RadioButton Content="✴️ Singularity"
                                                     GroupName="ExpressStack"
                                                     IsChecked="{Binding StackIsSingularity, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanChangeWorkflow}"
                                                     FontSize="11"
                                                     Margin="0,0,0,2"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     ToolTip.Tip="Sample every clip on h3-singularity.json (the Singularity ref2va checkpoint, euler/simple at 10 steps), composed at the draft canvas and lifted to the quality one by the 3D latent upscaler. Locked while anything is rendering, so a folder cannot come out half on one stack and half on another."/>
                                        <CheckBox Content="er__sde/beta sampler (keep the sigma shift)"
                                                  IsChecked="{Binding SingularityErSde}"
                                                  IsEnabled="{Binding CanChangeWorkflow}"
                                                  IsVisible="{Binding StackIsSingularity}"
                                                  FontSize="11"
                                                  Margin="20,2,0,2"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  ToolTip.Tip="Keep the Singularity graph — checkpoint, patches and the 12/3 sigma shift — but sample it the H3 Eros way: er_sde/beta at 12 steps, and er_sde on the upscale pass. Euler/simple at 10 is the author's setting and tends to come out softer; this is untested on that checkpoint. Locked while anything is rendering."/>
                                        <RadioButton Content="🍥 TaoMate relay"
                                                     GroupName="ExpressStack"
                                                     IsChecked="{Binding StackIsTaoMate, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanChangeWorkflow}"
                                                     FontSize="11"
                                                     Margin="0,2,0,2"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     ToolTip.Tip="Sample every clip on h3-taomate.json — the author's TaoMate render. One ten-step linear/euler/beta57 schedule is split across two samplers: six steps on the fl2va checkpoint with comfy-kitchen attention and the 12/6 sigma shift, then the rest resampled on the TaoMate 3-step LoRA at 0.65. There is no draft canvas: the clip is painted at the Quality size and the finished frames are upscaled ×2 by RTX Video Super Resolution instead of the latent being lifted, so the file is twice the Quality canvas in each direction and the render costs more per clip. The cast, the sheets, the clip prompts and the join are unchanged. Locked while anything is rendering."/>
                                        <RadioButton Content="🐰 BUNNY (action)"
                                                     GroupName="ExpressStack"
                                                     IsChecked="{Binding StackIsBunny, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanChangeWorkflow}"
                                                     FontSize="11"
                                                     Margin="0,2,0,2"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     ToolTip.Tip="Sample every clip on h3-bunny.json — the author's MiniMax H3 12GB Universal render, built around the H3 Combat LoRA. One 8-step res_multistep/simple schedule is extended with three more steps between sigma 0.65 and 0.28 (where the motion is decided) and then cut at 75%: the first three quarters are sampled with the clip's own seed and the Combat LoRA at full strength — that pass is the choreography — and the last quarter is run out by a second sampler that does not re-noise, on the same LoRA at 0.65, which takes the noise, ghosting and texture smear off the tail. One seed per clip either way. Composed at the draft canvas and lifted to the Quality one by the 3D latent upscaler, like H3 Eros and Singularity. Pick it for stories that are mostly physical action: the Combat LoRA is on the wire at full strength through the pass that decides the motion. Locked while anything is rendering."/>
                                        <RadioButton Content="🦠 Parasyte (sparse)"
                                                     GroupName="ExpressStack"
                                                     IsChecked="{Binding StackIsParasyte, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanChangeWorkflow}"
                                                     FontSize="11"
                                                     Margin="0,2,0,2"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     ToolTip.Tip="Sample every clip on h3-parasyte.json — PlagueKind's sparse-attention render. The fl2va/ref2va hybrid on the H3-PK-Parasyte-Turbo LoRA at 1.00, res_multistep/simple at 13 steps, with H3SLAAttention (block-sparse attention) last on the model wire.&#10;&#10;The finish is one node rather than three: MMH3UltimateUpscale does the latent upscale AND the second pass together and hands back a single AV latent, so there is no separate upscale sampler. The fps checkbox doubles frames with FILM instead of RIFE.&#10;&#10;Sparse attention is a SPEED patch, not a memory one — expect roughly 1.4× on a full-length clip, and nothing at all on a short clip at a small draft canvas, where the kernel falls back to dense. It will not fix an out-of-memory, and if Triton is missing on the server it silently passes the model through unpatched. Locked while anything is rendering."/>
                                        <RadioButton Content="🌊 HyperFlow (8-step)"
                                                     GroupName="ExpressStack"
                                                     IsChecked="{Binding StackIsHyperFlow, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanChangeWorkflow}"
                                                     FontSize="11"
                                                     Margin="0,2,0,2"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     ToolTip.Tip="Sample every clip on h3-hyperflow.json — the action recipe: Video Rebirth's HyperFlow 8-step adapter on the Singularity ref2va pruned checkpoint (bypass, curve refit on), euler on the adapter's own trained sigma grid, H3SLAAttention at 0.90 last on the wire. The upscale pass swaps HyperFlow for the TaoMate 3-step LoRA and runs exactly two steps.&#10;&#10;The schedule IS the adapter, so neither the steps dial nor the upscale-steps dial does anything on this stack. Leave the LoRA stack empty: it only reaches the drafts, and above the adapter it would switch the curve refit off.&#10;&#10;For fights: 720p is draft 0.21 MP / Quality 0.9 MP (608×352 → 1280×720); 1080p costs ~2.75× the time. Needs the ComfyUI-HyperFlow-H3 pack and custom_node_hyperflow_8step_v1.0_comfyui_pruned.safetensors in models/hyperflow. Locked while anything is rendering."/>
                                        <RadioButton Content="🌹 H3 Eros"
                                                     GroupName="ExpressStack"
                                                     IsChecked="{Binding StackIsEros, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanChangeWorkflow}"
                                                     FontSize="11"
                                                     Margin="0,2,0,2"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     ToolTip.Tip="Sample every clip on h3-eros.json — the 10Eros hybrid checkpoint, er_sde/beta at 12 steps — composed at the draft canvas and lifted to the quality one by the 3D latent upscaler. Locked while anything is rendering."/>
                                        <TextBlock Text="{Binding StackSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="20,0,0,6"/>
                                        <!-- Chained clips: the story's clips rendered as one continuous shot, each
                                                     continuing from the last second of the one before it (H3 Motion Context). -->
                                        <CheckBox Content="🔗 Chain clips into one continuous shot"
                                                  IsChecked="{Binding ChainClips}"
                                                  IsEnabled="{Binding CanChangeWorkflow}"
                                                  FontSize="11"
                                                  Margin="0,2,0,2"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  ToolTip.Tip="Render a story's clips as ONE shot instead of separate clips glued together. Clip 2 onward is generated continuing from the last second of the clip before it — the picture and the sound both, carried across as latents by the H3 Motion Context node pack — and the pinned head is trimmed off, so five 5-second clips play as one seamless 25 seconds.&#10;&#10;Needs ComfyUI-H3-Motion-Context (github.com/NikoDemon80/ComfyUI-H3-Motion-Context) installed on the ComfyUI server; without it the run says so and renders every clip on its own.&#10;&#10;Clips have to render in order. Regenerating one clip in the middle re-does it from the clip before, but the clips after it still continue from the old take.&#10;&#10;New clip prompts are written to open on the previous clip's last moment. Prompts saved before this was on are not — untick Reuse saved prompts to have them rewritten."/>
                                        <CheckBox Content="also pin the upscale pass"
                                                  IsChecked="{Binding ChainPinFinish}"
                                                  IsEnabled="{Binding CanChangeWorkflow}"
                                                  IsVisible="{Binding ChainClips}"
                                                  FontSize="11"
                                                  Margin="20,2,0,2"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  ToolTip.Tip="The finish re-samples the draft from a high noise level, so a join that is only pinned on the draft can be undone by it. With this on, the upscale pass is pinned to the previous clip's FINISHED tail as well (a second latent is saved per clip). Untick it if the finish misbehaves — the draft pass stays chained. 🍥 TaoMate has no upscale pass; both its legs are pinned regardless."/>
                                        <TextBlock Text="{Binding ChainSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="20,0,0,10"/>
                                        <!-- Sampling steps. Per checkpoint and remembered, so each
                                                     stack keeps its own count; frozen with the stack above,
                                                     since the render reads it as each clip's graph is built. -->
                                        <!-- 🌊 HyperFlow samples its own grid: no step count to set. -->
                                        <StackPanel IsVisible="{Binding UsesStepDials}">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sampling steps"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8,1">
                                                    <TextBlock Text="{Binding FirstPassStepCount}"
                                                               FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Content="↺"
                                                        Width="22"
                                                        Height="20"
                                                        FontSize="11"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        Command="{Binding ResetStepsCommand}"
                                                        IsVisible="{Binding HasStepsOverride}"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        ToolTip.Tip="Back to the count this stack is authored at, and forget the one saved for this checkpoint."/>
                                            </Grid>
                                            <!-- Minimum and Maximum before Value on purpose: a Slider still
                                                     holding its 0-10 defaults would coerce a 12-step count down to
                                                     10 and write that back through the two-way binding. -->
                                            <Slider Minimum="{Binding MinStepsForStack}"
                                                    Maximum="30"
                                                    Value="{Binding FirstPassStepCount}"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    SmallChange="1"
                                                    LargeChange="2"
                                                    IsEnabled="{Binding CanChangeWorkflow}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    Margin="0,0,0,2"
                                                    ToolTip.Tip="Steps on the pass that paints the clip. Saved against the checkpoint in More options ▸ Model, so each one keeps its own — the Singularity build is authored at 10, the 10Eros hybrid at 12, and the TaoMate relay splits a 10-step schedule — and the setting is still there after a restart. Locked while anything is rendering: the count is read as each clip's graph is built, so a folder rendered half at one count is a folder of films that do not match."/>
                                            <TextBlock Text="{Binding StepsSummary}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="20,0,0,10"/>
                                        </StackPanel>
                                        <CheckBox Content="📚 Researched prompts"
                                                  IsChecked="{Binding ResearchPrompts}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,2"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  ToolTip.Tip="Write the clips with the build taken from the MiniMax-H3 guides: 3-5 shots per clip on explicit cut times, medium-or-closer framing, silence mandates, isolated speakers, screen sides, a lighting lock and voices kept out of the soundscape. Untick for the shipped writer."/>
                                        <TextBlock Text="{Binding PromptBuildSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="20,0,0,10"/>
                                        <CheckBox Content="📐 Singularity spec prompts"
                                                  IsChecked="{Binding SingularitySpecPrompts}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,2"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  ToolTip.Tip="Write every story's clip prompts to the MiniMax H3 Singularity prompt-writing spec (prompts/MiniMax_H3_Singularity_Prompt_Writing_Specification_Enhanced_EN.md): the six-section full-reference format — subject_definitions, summary, retention_analysis, detailed_description, overall_soundscape, non_diegetic_music — with the cast bound to the reference photographs by code and written as &lt;Subject N&gt; in the shots, continuous action and camera chains, physical feedback, concrete lighting and synced sound. Replaces the 📚 build. A story saved by another build is written again."/>
                                        <TextBlock Text="{Binding SpecPromptsSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="20,0,0,10"/>
                                        <CheckBox Content="♻️ Reuse saved prompts"
                                                  IsChecked="{Binding ReuseSavedPrompts}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,2"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  ToolTip.Tip="A story whose clip prompts were written on an earlier run renders from them — no clip writer — at the clip length they were written for, in the wardrobe they describe. Untick to write every story's clips again; the new set replaces the saved one, which is kept in history."/>
                                        <TextBlock Text="{Binding ReuseSavedPromptsSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="20,0,0,12"/>
                                        <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                  SelectedItem="{Binding SelectedAspectRatio}"
                                                  Height="30"
                                                  FontSize="11"
                                                  Margin="0,0,0,10"/>
                                        <TextBlock Text="Quality" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                  DisplayMemberBinding="{ReflectionBinding Label}"
                                                  SelectedValueBinding="{ReflectionBinding Value}"
                                                  SelectedValue="{Binding Megapixels}"
                                                  Height="30"
                                                  FontSize="11"
                                                  Margin="0,0,0,12"
                                                  ToolTip.Tip="On the Singularity and H3 Eros stacks, the finished canvas every clip is upscaled to. On 🍥 TaoMate there is no draft, so this is the canvas the model paints and the file lands at twice it in each direction — see the line under the stack."/>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Film length"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8,1">
                                                <TextBlock Text="{Binding StoryDurationSeconds, StringFormat={}{0:0} s}"
                                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider Value="{Binding StoryDurationSeconds}"
                                                Minimum="5"
                                                Maximum="{Binding MaxStoryDurationSeconds}"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="5"
                                                LargeChange="15"
                                                Foreground="{DynamicResource TabAccentBrush}"
                                                Margin="0,0,0,8"
                                                ToolTip.Tip="How long each story's finished film should be. Anything longer than one clip is written as a chain of clips and joined."/>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Clip length"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8,1">
                                                <TextBlock Text="{Binding LengthSeconds, StringFormat={}{0:0} s}"
                                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider Value="{Binding LengthSeconds}"
                                                Minimum="4"
                                                Maximum="15"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Foreground="{DynamicResource TabAccentBrush}"
                                                Margin="0,0,0,4"
                                                ToolTip.Tip="How long a single H3 render is — the model's own limit is about 15 s."/>
                                        <TextBlock Text="{Binding ClipPlanSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,10"/>
                                        <!-- The dials you set once and leave. Shut by default. -->
                                        <Expander Header="More options" IsExpanded="False" FontSize="11" Margin="0,0,0,8">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="Model" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding DiffusionModelOptions}"
                                                              DisplayMemberBinding="{ReflectionBinding Label}"
                                                              SelectedValueBinding="{ReflectionBinding Value}"
                                                              SelectedValue="{Binding SelectedDiffusionModel}"
                                                              Height="30"
                                                              FontSize="11"
                                                              Margin="0,0,6,0"
                                                              ToolTip.Tip="The H3 checkpoint, from diffusion_models/h3-minimax on the server. Picking a stack above moves this to that stack's own checkpoint; change it afterwards and the choice sticks."/>
                                                    <Button Grid.Column="1"
                                                            Content="⟳"
                                                            Width="30"
                                                            Height="30"
                                                            FontSize="13"
                                                            Command="{Binding RefreshDiffusionModelsCommand}"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            ToolTip.Tip="Re-read the model list from ComfyUI."/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="LoRA stack"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Button Grid.Column="1"
                                                            Content="＋ Add"
                                                            Height="22"
                                                            Padding="8,0"
                                                            FontSize="10"
                                                            Command="{Binding AddLoraCommand}"
                                                            Theme="{StaticResource AccentOutlineButtonStyle}"
                                                            ToolTip.Tip="Add a LoRA row. Up to five stack on the checkpoint, loading in the order they are listed. Locked while anything is rendering, so a story cannot come out half on a different stack."/>
                                                    <Button Grid.Column="2"
                                                            Content="⟳"
                                                            Width="24"
                                                            Height="22"
                                                            FontSize="11"
                                                            Margin="4,0,0,0"
                                                            Padding="0"
                                                            Command="{Binding RefreshLorasCommand}"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            ToolTip.Tip="Re-read loras/H3 from ComfyUI."/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Loras}"
                                                              ItemTemplate="{StaticResource ExpressLoraRowTemplate}"
                                                              IsEnabled="{Binding CanChangeWorkflow}"
                                                              Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding LoraSummary}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,2,0,10"/>
                                                <TextBlock Text="Cast photos"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding CastPhotoEngineOptions}"
                                                          DisplayMemberBinding="{ReflectionBinding Label}"
                                                          SelectedValueBinding="{ReflectionBinding Value}"
                                                          SelectedValue="{Binding CastPhotoEngine}"
                                                          IsEnabled="{Binding CanEditCast}"
                                                          Height="30"
                                                          FontSize="11"
                                                          Margin="0,0,0,4"
                                                          ToolTip.Tip="The text-to-image workflow that photographs each story's characters when the CAST card has no photo of yours for them. The character sheet is then built from that photo as always. Locked while anything is rendering."/>
                                                <TextBlock Text="{Binding CastPhotoEngineSummary}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,0,0,10"/>
                                                <TextBlock Text="Visual style"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding VisualStyleOptions}"
                                                          DisplayMemberBinding="{ReflectionBinding Name}"
                                                          SelectedItem="{Binding VisualStyle, Mode=TwoWay}"
                                                          Height="30"
                                                          FontSize="11"
                                                          Margin="0,0,0,10"
                                                          ToolTip.Tip="The medium every clip is written in. Auto lets the writer choose from the story."/>
                                                <!-- Both of these belong to a latent-upscale finish. 🍥 TaoMate paints at the
                                                             Quality canvas and upscales the frames, so it has neither a draft to size
                                                             nor a sigma schedule to pick — they are hidden rather than left to lie. -->
                                                <StackPanel IsVisible="{Binding UsesDraftCanvas}">
                                                    <TextBlock Text="Composition canvas"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding PreviewMegapixelOptions}"
                                                              DisplayMemberBinding="{ReflectionBinding Label}"
                                                              SelectedValueBinding="{ReflectionBinding Value}"
                                                              SelectedValue="{Binding PreviewMegapixels}"
                                                              Height="30"
                                                              FontSize="11"
                                                              Margin="0,0,0,10"
                                                              ToolTip.Tip="The small canvas each clip is first sampled at, before it is upscaled to the Quality above in the same render."/>
                                                    <StackPanel IsVisible="{Binding UsesStepDials}">
                                                        <TextBlock Text="Upscale steps"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding UpscaleStepOptions}"
                                                                  SelectedItem="{Binding UpscaleSteps}"
                                                                  Height="30"
                                                                  FontSize="11"
                                                                  Margin="0,0,0,10"
                                                                  ToolTip.Tip="Fixed sigmas on the finishing pass. 4 is the default; 3 is quicker, 5 adds detail."/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <CheckBox Content="RIFE interpolation (24 → 48 fps)"
                                                          IsChecked="{Binding UseRife}"
                                                          FontSize="11"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Text="{Binding HuntSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding LoadSummary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Classes="s29"
                                                   Classes.s29_0="{Binding HasLoadWarning}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.s29.s29_0" x:DataType="vmv:H3ExpressViewModel">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </TextBlock.Styles>
                                            <TextBlock.Theme>
                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3ExpressViewModel">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                </ControlTheme>
                                            </TextBlock.Theme>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <!-- ═══ RIGHT: the run ═══════════════════════════════════════════ -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- ─── Status and the one button ───────────────────────────── -->
                        <Border Grid.Row="0" Theme="{StaticResource ToolStripStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Classes="s30"
                                               Classes.s30_0="{Binding BatchStatus, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.s30.s30_0" x:DataType="vmv:H3ExpressViewModel">
                                                <Setter Property="Text" Value="Ready when you are"/>
                                            </Style>
                                        </TextBlock.Styles>
                                        <TextBlock.Theme>
                                            <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3ExpressViewModel">
                                                <Setter Property="Text" Value="{Binding BatchStatus}"/>
                                            </ControlTheme>
                                        </TextBlock.Theme>
                                    </TextBlock>
                                    <TextBlock FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"
                                               Classes="s31"
                                               Classes.s31_0="{Binding LuckyPhase, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.s31.s31_0" x:DataType="vmv:H3ExpressViewModel">
                                                <Setter Property="Text" Value="Choose a folder of story .txt files, then press Render."/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            </Style>
                                        </TextBlock.Styles>
                                        <TextBlock.Theme>
                                            <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3ExpressViewModel">
                                                <Setter Property="Text" Value="{Binding LuckyPhase}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                                            </ControlTheme>
                                        </TextBlock.Theme>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding RunButtonText}"
                                            Command="{Binding StartBatchCommand}"
                                            Height="38"
                                            Padding="20,0"
                                            FontSize="13"
                                            Margin="0,0,8,0"
                                            Theme="{StaticResource AccentButtonStyle}"
                                            ToolTip.Tip="Render every waiting story in the list, in order: its cast, portraits and sheets, its clips written and queued, then each clip rendered once and the film joined. One story failing does not stop the run."/>
                                    <Button Content="✕ Stop"
                                            Command="{Binding StopBatchCommand}"
                                            Height="38"
                                            Padding="14,0"
                                            FontSize="12"
                                            Margin="0,0,8,0"
                                            Theme="{StaticResource DangerButtonStyle}"
                                            ToolTip.Tip="Cut the current story short and stop. Finished films are kept."/>
                                    <Button Content="↻"
                                            Command="{Binding ResetBatchCommand}"
                                            Width="38"
                                            Height="38"
                                            Padding="0"
                                            FontSize="14"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            ToolTip.Tip="Put every story back to waiting, so the folder can be run again."/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- ─── The player, and the open clip's prompt beside it ─────── -->
                        <!-- Side by side on purpose: stacked under the player, the editor took the player's
                                     height and was drawn over it. -->
                        <Grid Grid.Row="1" Margin="16,14,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Render progress, flush to the top edge of the card. -->
                                    <ProgressBar Grid.Row="0"
                                                 Height="3"
                                                 Margin="8,0"
                                                 Value="{Binding ProcessingProgress, Mode=OneWay}"
                                                 Foreground="{DynamicResource TabAccentBrush}"
                                                 Background="Transparent"
                                                 IsVisible="{Binding IsProcessing}"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Margin="8,8,8,0"
                                            CornerRadius="6"
                                            MinHeight="200">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Classes="s32"
                                                        Classes.s32_0="{Binding !HasActivePreview}">
                                                <StackPanel.Styles>
                                                    <Style Selector="StackPanel.s32.s32_0" x:DataType="vmv:H3ExpressViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </StackPanel.Styles>
                                                <StackPanel.Theme>
                                                    <ControlTheme TargetType="StackPanel" x:DataType="vmv:H3ExpressViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </StackPanel.Theme>
                                                <TextBlock Text="⚡"
                                                           FontSize="34"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}"/>
                                                <TextBlock Text="Finished clips play here as they land"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"
                                                           Foreground="{StaticResource PlayerTextBrush}"/>
                                            </StackPanel>
                                            <!-- Source is set from code-behind (ApplyH3ExpressSource) as an ABSOLUTE
                                                     Uri, and this element is never collapsed: a string {Binding} silently
                                                     fails on Z:\ output paths, and a collapsed MediaElement opens nothing. -->
                                            <ctrl:VideoPreview x:Name="H3ExpressVideoPlayer"
                                                               Stretch="Uniform"
                                                               IsMuted="{Binding IsPreviewMuted}"
                                                               MediaOpened="H3ExpressPlayer_MediaOpened"
                                                               MediaEnded="H3ExpressPlayer_MediaEnded"
                                                               MediaFailed="H3ExpressPlayer_MediaFailed"/>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="2" Margin="14,10,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Classes="s33"
                                                       Classes.s33_0="{Binding ActivePreviewLabel, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s33.s33_0" x:DataType="vmv:H3ExpressViewModel">
                                                        <Setter Property="Text" Value="Nothing playing yet"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3ExpressViewModel">
                                                        <Setter Property="Text" Value="{Binding ActivePreviewLabel}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="📁 Output"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"
                                                    Height="30"
                                                    Padding="12,0"
                                                    FontSize="11"
                                                    Margin="0,0,6,0"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    ToolTip.Tip="Open the folder the films are written to."/>
                                            <Button Content="{Binding MuteGlyph}"
                                                    Command="{Binding ToggleMuteCommand}"
                                                    ToolTip.Tip="{Binding MuteTip}"
                                                    Width="34"
                                                    Height="30"
                                                    Padding="0"
                                                    FontSize="13"
                                                    Theme="{StaticResource SecondaryButtonStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <!-- ─── The selected clip's prompt, editable, and its regenerate ─── -->
                            <Border Grid.Column="1"
                                    Width="420"
                                    Margin="12,0,0,0"
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource TabAccentBrush}"
                                    BorderThickness="1"
                                    IsVisible="{Binding HasSelectedClip}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SelectedClipHeader}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedClipStatus}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="✕"
                                                Command="{Binding CloseClipEditorCommand}"
                                                Width="24"
                                                Height="24"
                                                FontSize="11"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                ToolTip.Tip="Close the prompt. An edit that was not regenerated or saved is dropped."/>
                                    </Grid>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding ClipPromptDraft}"
                                             IsReadOnly="{Binding SelectedClip.IsBusy}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             MinHeight="120"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="11"
                                             Padding="6,4"
                                             Background="{StaticResource SurfaceAltBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             ToolTip.Tip="The full prompt this clip was rendered from. Edit it, then Regenerate or Save to story."/>
                                    <TextBlock Grid.Row="2"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,8"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Exactly what the clip was rendered from. @char tags become &lt;Picture N&gt; references when it renders. Regenerating an edited clip also saves it to the story's prompts."/>
                                    <StackPanel Grid.Row="3">
                                        <WrapPanel Margin="0,0,0,6">
                                            <CheckBox Content="🎲 New seed"
                                                      IsChecked="{Binding RegenerateWithNewSeed}"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"
                                                      Margin="0,0,10,6"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      ToolTip.Tip="Off: the clip keeps its seed, so the new render changes only where the prompt does. On: a new seed — a different take of the same prompt."/>
                                            <Button Content="💾 Save to story"
                                                    Command="{Binding SaveClipToStoryCommand}"
                                                    Height="28"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    Margin="0,0,6,6"
                                                    Theme="{StaticResource AccentOutlineButtonStyle}"
                                                    ToolTip.Tip="{Binding SaveClipToStoryTip}"
                                                    ToolTip.ShowOnDisabled="True"/>
                                            <Button Content="↺ Revert"
                                                    Command="{Binding RevertClipPromptCommand}"
                                                    Height="28"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    Margin="0,0,6,6"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    ToolTip.Tip="Put the box back to the prompt the clip was rendered from."/>
                                            <Button Content="Unqueue"
                                                    Command="{Binding UnqueueClipCommand}"
                                                    Height="28"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    Margin="0,0,6,6"
                                                    ToolTip.Tip="Take this clip's waiting regenerate back out of the queue."
                                                    Classes="s34"
                                                    Classes.s34_0="{Binding SelectedClip.IsRerollQueued}">
                                                <Button.Styles>
                                                    <Style Selector="Button.s34.s34_0" x:DataType="vmv:H3ExpressViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </Button.Styles>
                                                <Button.Theme>
                                                    <ControlTheme TargetType="Button"
                                                                  BasedOn="{StaticResource SecondaryButtonStyle}"
                                                                  x:DataType="vmv:H3ExpressViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </Button.Theme>
                                            </Button>
                                            <!-- Stops a regenerate run on its own. During a batch the Stop at the
                                                     top is the one to use: this would cut the story, not the run. -->
                                            <Button Content="✕ Stop"
                                                    Command="{Binding CancelCommand}"
                                                    Height="28"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    Margin="0,0,6,6"
                                                    ToolTip.Tip="Stop the regenerate. The clip is left as it was."
                                                    Classes="s35"
                                                    Classes.s35_0="{Binding SelectedClip.IsBusy}"
                                                    Classes.s35_1="{Binding !IsBatchRunning}">
                                                <Button.Styles>
                                                    <Style Selector="Button.s35.s35_0.s35_1" x:DataType="vmv:H3ExpressViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </Button.Styles>
                                                <Button.Theme>
                                                    <ControlTheme TargetType="Button"
                                                                  BasedOn="{StaticResource DangerButtonStyle}"
                                                                  x:DataType="vmv:H3ExpressViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </Button.Theme>
                                            </Button>
                                        </WrapPanel>
                                        <Button Content="{Binding RegenerateButtonText}"
                                                Command="{Binding RegenerateClipCommand}"
                                                ToolTip.Tip="{Binding RegenerateTip}"
                                                ToolTip.ShowOnDisabled="True"
                                                Height="32"
                                                FontSize="12"
                                                HorizontalAlignment="Stretch"
                                                Theme="{StaticResource AccentButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <!-- ─── Clip chips for the story in flight ─────────────────── -->
                        <Border Grid.Row="2"
                                Theme="{StaticResource SectionCardStyle}"
                                Margin="16,0,16,10"
                                Padding="12,10"
                                IsVisible="{Binding HasBoard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <ctrl:SectionHeader Title="CLIPS"
                                                        Note="  · click a clip to play it · 📝 under it opens its prompt"
                                                        HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding ClipProgressText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                </Grid>
                                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding HuntBoard}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:ErosHuntClip">
                                                <!-- Reaches the tab through the ItemsControl's DataContext;
                                                             ElementName does not resolve from inside a DataTemplate. -->
                                                <StackPanel Margin="0,0,6,6">
                                                    <Button Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).PlayClipCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Summary}"
                                                            Classes="s36">
                                                        <Button.Styles>
                                                            <Style Selector="Button.s36:disabled" x:DataType="m:ErosHuntClip">
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </Style>
                                                        </Button.Styles>
                                                        <Button.Theme>
                                                            <ControlTheme TargetType="Button"
                                                                          BasedOn="{StaticResource {x:Type Button}}"
                                                                          x:DataType="m:ErosHuntClip">
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                              Name="PART_ContentPresenter"/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </ControlTheme>
                                                        </Button.Theme>
                                                        <Border Width="58"
                                                                Height="46"
                                                                CornerRadius="6"
                                                                Classes="s37"
                                                                Classes.s37_0="{Binding IsFinished}"
                                                                Classes.s37_1="{Binding Item.ItemStatus, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Failed}"
                                                                Classes.s37_2="{Binding IsBusy}">
                                                            <Border.Styles>
                                                                <Style Selector="Border.s37.s37_0" x:DataType="m:ErosHuntClip">
                                                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                                </Style>
                                                                <Style Selector="Border.s37.s37_1" x:DataType="m:ErosHuntClip">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                                </Style>
                                                                <Style Selector="Border.s37.s37_2" x:DataType="m:ErosHuntClip">
                                                                    <Setter Property="Background" Value="{DynamicResource TabAccentBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                                                </Style>
                                                            </Border.Styles>
                                                            <Border.Theme>
                                                                <ControlTheme TargetType="Border" x:DataType="m:ErosHuntClip">
                                                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </ControlTheme>
                                                            </Border.Theme>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Item.ClipIndex, StringFormat={}{0:00}}"
                                                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           Classes="s38"
                                                                           Classes.s38_0="{Binding IsFinished}"
                                                                           Classes.s38_1="{Binding Item.ItemStatus, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Failed}"
                                                                           Classes.s38_2="{Binding IsBusy}">
                                                                    <TextBlock.Styles>
                                                                        <Style Selector="TextBlock.s38.s38_0" x:DataType="m:ErosHuntClip">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                                        </Style>
                                                                        <Style Selector="TextBlock.s38.s38_1" x:DataType="m:ErosHuntClip">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        </Style>
                                                                        <Style Selector="TextBlock.s38.s38_2" x:DataType="m:ErosHuntClip">
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </Style>
                                                                    </TextBlock.Styles>
                                                                    <TextBlock.Theme>
                                                                        <ControlTheme TargetType="TextBlock" x:DataType="m:ErosHuntClip">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                        </ControlTheme>
                                                                    </TextBlock.Theme>
                                                                </TextBlock>
                                                                <TextBlock FontSize="9"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,1,0,0"
                                                                           Classes="s39"
                                                                           Classes.s39_0="{Binding IsFinished}"
                                                                           Classes.s39_1="{Binding Item.ItemStatus, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Failed}"
                                                                           Classes.s39_2="{Binding IsRerollQueued}"
                                                                           Classes.s39_3="{Binding IsBusy}">
                                                                    <TextBlock.Styles>
                                                                        <Style Selector="TextBlock.s39.s39_0" x:DataType="m:ErosHuntClip">
                                                                            <Setter Property="Text" Value="▶ play"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                                        </Style>
                                                                        <Style Selector="TextBlock.s39.s39_1" x:DataType="m:ErosHuntClip">
                                                                            <Setter Property="Text" Value="failed"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        </Style>
                                                                        <Style Selector="TextBlock.s39.s39_2" x:DataType="m:ErosHuntClip">
                                                                            <Setter Property="Text" Value="⏳ queued"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                                                                        </Style>
                                                                        <Style Selector="TextBlock.s39.s39_3" x:DataType="m:ErosHuntClip">
                                                                            <Setter Property="Text" Value="rendering"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </Style>
                                                                    </TextBlock.Styles>
                                                                    <TextBlock.Theme>
                                                                        <ControlTheme TargetType="TextBlock" x:DataType="m:ErosHuntClip">
                                                                            <Setter Property="Text" Value="waiting"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                        </ControlTheme>
                                                                    </TextBlock.Theme>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                    <!-- The prompt, beside the player. Filled while it is the one open. -->
                                                    <Button Command="{Binding $parent[ItemsControl].((vmv:H3ExpressViewModel)DataContext).SelectClipCommand}"
                                                            CommandParameter="{Binding}"
                                                            Width="58"
                                                            Height="20"
                                                            Margin="0,3,0,0"
                                                            ToolTip.Tip="Open this clip's prompt beside the player — read it, edit it, regenerate the clip."
                                                            Classes="s40"
                                                            Classes.s40_0="{Binding IsSelected}">
                                                        <Button.Styles>
                                                            <Style Selector="Button.s40.s40_0" x:DataType="m:ErosHuntClip">
                                                                <Setter Property="Background" Value="{DynamicResource TabAccentBrush}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Style>
                                                        </Button.Styles>
                                                        <Button.Theme>
                                                            <ControlTheme TargetType="Button"
                                                                          BasedOn="{StaticResource {x:Type Button}}"
                                                                          x:DataType="m:ErosHuntClip">
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    CornerRadius="4"
                                                                                    BorderBrush="{DynamicResource TabAccentBrush}"
                                                                                    BorderThickness="1">
                                                                                <TextBlock Text="📝 prompt"
                                                                                           FontSize="9"
                                                                                           FontWeight="SemiBold"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{TemplateBinding Foreground}"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </ControlTheme>
                                                        </Button.Theme>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <!-- ─── Log ───────────────────────────────────────────────── -->
                        <ctrl:ProcessingLogPanel Grid.Row="3" LogText="{Binding LogOutput}" MaxLogHeight="120"/>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- ═══════════════════════════════════════════════════════════════════════
                         Tab: Seed Upscale

                         Where the upscale that 🌀4️⃣ H3 4-Step deliberately does not do gets done.

                         The 4-Step tab stops at the pick — on a four-step checkpoint hunting is so
                         cheap that upscaling every clip would be the entire cost of a run, and most
                         clips are not ones anyone would export at full size. So it writes a
                         .seed.json recipe beside every draft and this tab does the upscaling later,
                         in one batch, to the takes that turned out to be keepers.

                         An mp4 has no latent left in it, so this is NOT an enlargement: the recorded
                         seed is sampled back through the same stack — same checkpoint, steps,
                         sampler, scheduler, prompt, references and draft canvas — which is
                         deterministic and lands on the same latent, and THAT goes through
                         MinimaxH3LatentUpscaler3D and a short fixed-sigma second pass.

                         Which is why the scan looks for recipes rather than for videos: a draft with
                         no recipe cannot be reproduced, only re-rolled.
                         ═══════════════════════════════════════════════════════════════════════ -->
            <TabItem Header="🔎⬆️ Seed Upscale">
                <Grid x:DataType="vmv:SeedUpscaleViewModel"
                      x:Name="SeedUpscaleRoot"
                      DataContext="{Binding SeedUpscaleVM}"
                      Theme="{StaticResource TabPageStyle}">
                    <Grid.Resources>
                        <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentEmeraldColor}"/>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ═══ Left rail: where to look, and what to render ═══════════════ -->
                    <Border Grid.Column="0" Theme="{StaticResource SectionCardStyle}" Margin="10,8,6,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="🔎⬆️ Seed Upscale" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TabAccentBrush}"/>
                                <TextBlock Text="Re-samples a recorded seed to get its latent back, then upscales that. Not an enlargement of the mp4."
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- ─── The folder ────────────────────────────────── -->
                                    <TextBlock Text="Folder to scan"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ScanFolder, UpdateSourceTrigger=LostFocus}"
                                             FontSize="10"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             Height="26"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,0,4"
                                             ToolTip.Tip="Any folder holding H3 4-Step drafts and their .seed.json recipes — the H34Step output folder by default, but ComfyUI's own h3_4step folder works too.&#10;&#10;The path is remembered across restarts."/>
                                    <WrapPanel Margin="0,0,0,6">
                                        <Button Content="📂 Browse"
                                                Command="{Binding BrowseFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Height="26"
                                                Padding="10,0"
                                                FontSize="11"
                                                Margin="0,0,5,0"/>
                                        <Button Content="🔄 Rescan"
                                                Command="{Binding RescanCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Height="26"
                                                Padding="10,0"
                                                FontSize="11"
                                                Margin="0,0,5,0"
                                                ToolTip.Tip="Reads the folder again. Ticks and thumbnails already earned are kept — a rescan is usually 'did that finish yet', not 'start again'."/>
                                        <Button Content="↗"
                                                Command="{Binding OpenScanFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Width="30"
                                                Height="26"
                                                Padding="0"
                                                FontSize="11"
                                                ToolTip.Tip="Open this folder in Explorer."/>
                                    </WrapPanel>
                                    <CheckBox Content="Include subfolders"
                                              IsChecked="{Binding IncludeSubfolders}"
                                              FontSize="11"
                                              Margin="0,0,0,4"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              ToolTip.Tip="On by default: a story's clips land in per-run subfolders as often as not, and a scan that stopped at the top level would show an empty board on a folder full of drafts."/>
                                    <CheckBox Content="Hide ones already upscaled"
                                              IsChecked="{Binding HideAlreadyUpscaled}"
                                              FontSize="11"
                                              Margin="0,0,0,8"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              ToolTip.Tip="Hides drafts whose upscale at the current target size is already sitting in the output folder — what makes a second pass over a big folder show only what is left to do."/>
                                    <TextBlock Text="Search"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FilterText}"
                                             FontSize="11"
                                             Height="26"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,0,10"
                                             ToolTip.Tip="Matches the clip title, the story id, the model, the seed, the filename and the prompt.&#10;&#10;Select all and Invert act on what the search leaves on screen, not on everything scanned."/>
                                    <Separator Margin="0,0,0,10"/>
                                    <!-- ─── What the upscale renders at ───────────────── -->
                                    <TextBlock Text="Finished canvas"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding TargetMegapixelOptions}"
                                              DisplayMemberBinding="{ReflectionBinding Label}"
                                              SelectedValueBinding="{ReflectionBinding Value}"
                                              SelectedValue="{Binding TargetMegapixels}"
                                              Height="30"
                                              FontSize="11"
                                              Margin="0,0,0,8"
                                              ToolTip.Tip="What MinimaxH3LatentUpscaler3D upscales the reproduced latent to. It takes a TARGET, not a factor, so this is independent of whatever canvas the drafts were hunted at.&#10;&#10;It is also part of the output filename, so the same draft can be rendered at two sizes without one overwriting the other."/>
                                    <TextBlock Text="Upscale pass steps (fixed sigmas)"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding UpscaleStepOptions}"
                                              SelectedItem="{Binding UpscaleSteps}"
                                              Height="30"
                                              FontSize="11"
                                              Margin="0,0,0,8"
                                              ToolTip.Tip="How many fixed sigmas the second pass runs over the upscaled latent. The graph ships one hand-written schedule per count and this picks which one is wired in.&#10;&#10;4 is what the workflow ships live. 3 is quicker and keeps more of the draft; 5 puts more detail on and drifts further from the take you picked."/>
                                    <CheckBox Content="RIFE interpolation (24 → 48 fps)"
                                              IsChecked="{Binding UseRife}"
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,10"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              ToolTip.Tip="Doubles the finished clip's frame rate by generating the frames in between, rather than by rendering them. On is how the authored graph runs.&#10;&#10;Off muxes the H3 frames as they are, at 24 fps."/>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding RunSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <!-- The one thing that is easy to get wrong: the second pass
                                                 uses a fresh noise seed every run, so re-running the same
                                                 draft at the same size is a variation of one composition,
                                                 not a byte-identical repeat. -->
                                    <TextBlock FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="The reproduced latent is exact; the second pass takes a fresh noise seed each run, so upscaling the same draft twice gives two variations of the same shot."/>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- ─── Run ───────────────────────────────────────────────── -->
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <Button Content="⬆️ Upscale ticked"
                                        Command="{Binding UpscaleSelectedCommand}"
                                        Theme="{StaticResource AccentButtonStyle}"
                                        Height="34"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Margin="0,0,0,5"
                                        ToolTip.Tip="Renders every ticked draft, one submission each, in board order. Each one waits its turn for the GPU like any other tab's queue."/>
                                <Button Content="⏹ Stop"
                                        Command="{Binding StopUpscaleCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Height="26"
                                        FontSize="11"
                                        ToolTip.Tip="Stops after the clip currently in flight. Everything already rendered is kept."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- ═══ Right: the board and the player ════════════════════════════ -->
                    <Grid Grid.Column="1" Margin="0,8,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- ─── Board header ─────────────────────────────────────────── -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectionSummary}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                <TextBlock Text="{Binding ScanStatus}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="☑ Select all"
                                        Command="{Binding SelectAllCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Height="26"
                                        Padding="10,0"
                                        FontSize="11"
                                        Margin="0,0,5,0"
                                        ToolTip.Tip="Ticks everything currently on screen — the search box and 'hide already upscaled' decide what that is."/>
                                <Button Content="☐ None"
                                        Command="{Binding SelectNoneCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Height="26"
                                        Padding="10,0"
                                        FontSize="11"
                                        Margin="0,0,5,0"/>
                                <Button Content="⇄ Invert"
                                        Command="{Binding InvertSelectionCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Height="26"
                                        Padding="10,0"
                                        FontSize="11"
                                        Margin="0,0,10,0"/>
                                <Button Content="➖"
                                        Command="{Binding ZoomTilesOutCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Width="28"
                                        Height="26"
                                        Padding="0"
                                        FontSize="11"
                                        Margin="0,0,4,0"
                                        ToolTip.Tip="Smaller tiles — for a long folder."/>
                                <Button Content="➕"
                                        Command="{Binding ZoomTilesInCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Width="28"
                                        Height="26"
                                        Padding="0"
                                        FontSize="11"
                                        ToolTip.Tip="Bigger tiles — for telling near-identical takes apart."/>
                            </StackPanel>
                        </Grid>
                        <!-- ─── The board ────────────────────────────────────────────── -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="340"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Margin="0,0,6,0">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="20,0"
                                               FontStyle="Italic"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Nothing here yet. Point this at a folder of H3 4-Step drafts — it looks for the .seed.json recipe written beside each one, because a draft without its recipe cannot be reproduced, only re-rolled."
                                               Classes="s41"
                                               Classes.s41_0="{Binding !HasItems}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.s41.s41_0" x:DataType="vmv:SeedUpscaleViewModel">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </Style>
                                        </TextBlock.Styles>
                                        <TextBlock.Theme>
                                            <ControlTheme TargetType="TextBlock" x:DataType="vmv:SeedUpscaleViewModel">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </ControlTheme>
                                        </TextBlock.Theme>
                                    </TextBlock>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8" IsVisible="{Binding HasItems}">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:SeedUpscaleItem">
                                                    <!-- Commands live on the item, never bound through
                                                                 ElementName: a DataTemplate has its own XAML
                                                                 namescope, so ElementName inside one silently
                                                                 resolves to nothing and makes a dead button.
                                                                 H3 Eros shipped that bug once already. -->
                                                    <Border CornerRadius="6"
                                                            BorderThickness="2"
                                                            Margin="0,0,8,8"
                                                            Padding="6"
                                                            Width="{Binding $parent[ItemsControl].((vmv:SeedUpscaleViewModel)DataContext).TileWidth}"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            Classes="s42"
                                                            Classes.s42_0="{Binding IsSelected}"
                                                            Classes.s42_1="{Binding IsBusy}">
                                                        <Border.Styles>
                                                            <Style Selector="Border.s42.s42_0" x:DataType="m:SeedUpscaleItem">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                                            </Style>
                                                            <Style Selector="Border.s42.s42_1" x:DataType="m:SeedUpscaleItem">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </Style>
                                                        </Border.Styles>
                                                        <Border.Theme>
                                                            <ControlTheme TargetType="Border" x:DataType="m:SeedUpscaleItem">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                            </ControlTheme>
                                                        </Border.Theme>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- The still. Clicking it watches the take;
                                                                         the tick is a separate target, because
                                                                         "let me see it" and "render it big" are
                                                                         different decisions. -->
                                                            <Button Grid.Column="0"
                                                                    Command="{Binding PlayCommand}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="0"
                                                                    Cursor="Hand"
                                                                    ToolTip.Tip="Watch this draft in the player.">
                                                                <Border CornerRadius="4"
                                                                        ClipToBounds="True"
                                                                        Background="{StaticResource PlayerSurfaceBrush}"
                                                                        Width="{Binding $parent[ItemsControl].((vmv:SeedUpscaleViewModel)DataContext).TileSize}"
                                                                        Height="{Binding $parent[ItemsControl].((vmv:SeedUpscaleViewModel)DataContext).TileSize}">
                                                                    <Grid>
                                                                        <Image Source="{Binding Thumbnail, Converter={StaticResource PathToBitmapConverter}}"
                                                                               Stretch="UniformToFill"/>
                                                                        <TextBlock Text="▶"
                                                                                   FontSize="18"
                                                                                   Opacity="0.55"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource PlayerTextBrush}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                                          Content="{Binding Title}"
                                                                          FontSize="11"
                                                                          FontWeight="SemiBold"
                                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                                          ToolTip.Tip="Tick to include this draft in the next upscale run."/>
                                                                <TextBlock Text="{Binding Details}"
                                                                           FontSize="10"
                                                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,3,0,0"/>
                                                                <TextBlock FontSize="9"
                                                                           Margin="0,2,0,0"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding ModelLabel, Mode=OneWay}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding WhenLabel, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Status}"
                                                                           FontSize="10"
                                                                           FontStyle="Italic"
                                                                           Margin="0,3,0,0"
                                                                           Foreground="{DynamicResource TabAccentBrush}"
                                                                           TextWrapping="Wrap"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <Button Content="▶ Upscaled"
                                                                            Command="{Binding PlayUpscaledCommand}"
                                                                            Theme="{StaticResource SecondaryButtonStyle}"
                                                                            Height="22"
                                                                            Padding="7,0"
                                                                            FontSize="10"
                                                                            Margin="0,0,4,0"
                                                                            IsVisible="{Binding HasUpscale}"
                                                                            ToolTip.Tip="Watch the upscale this draft already produced."/>
                                                                    <Button Content="📁"
                                                                            Command="{Binding RevealCommand}"
                                                                            Theme="{StaticResource SecondaryButtonStyle}"
                                                                            Width="26"
                                                                            Height="22"
                                                                            Padding="0"
                                                                            FontSize="10"
                                                                            ToolTip.Tip="Show this file in Explorer."/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <!-- ─── The one shared player ────────────────────────────
                                         One MediaElement for the whole board: WPF renders several
                                         simultaneous ones as solid black, which is why the tiles are
                                         still frames and this is where they play. -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="🎥 Now watching" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TabAccentBrush}"/>
                                    <TextBlock Text="{Binding ActivePreviewLabel}"
                                               FontSize="10"
                                               FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Row="1"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Background="{StaticResource PlayerSurfaceBrush}"
                                        MinHeight="180"
                                        CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="Click a tile to watch that draft here"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Margin="14,0"
                                                   Foreground="{StaticResource PlayerTextBrush}"
                                                   FontStyle="Italic"
                                                   Classes="s43"
                                                   Classes.s43_0="{Binding !HasActivePreview}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.s43.s43_0" x:DataType="vmv:SeedUpscaleViewModel">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                </Style>
                                            </TextBlock.Styles>
                                            <TextBlock.Theme>
                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:SeedUpscaleViewModel">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </ControlTheme>
                                            </TextBlock.Theme>
                                        </TextBlock>
                                        <!-- Source is set from code-behind (ApplySeedUpscaleSource) as
                                                     an ABSOLUTE Uri, and this element is never collapsed. A
                                                     string {Binding} silently fails to open Z:\output paths —
                                                     no MediaOpened, no MediaFailed, just a black frame — and a
                                                     collapsed MediaElement will not open media at all. -->
                                        <ctrl:VideoPreview x:Name="SeedUpscaleVideoPlayer"
                                                           Stretch="Uniform"
                                                           IsMuted="{Binding IsPreviewMuted}"
                                                           MediaOpened="SeedUpscalePlayer_MediaOpened"
                                                           MediaEnded="SeedUpscalePlayer_MediaEnded"
                                                           MediaFailed="SeedUpscalePlayer_MediaFailed"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="▶ Replay"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding PlayVideoCommand}"
                                            IsEnabled="{Binding HasResult}"
                                            Height="26"
                                            Padding="10,0"
                                            FontSize="11"
                                            Margin="0,0,6,0"/>
                                    <Button Content="📁 Folder"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding OpenResultFolderCommand}"
                                            IsEnabled="{Binding HasResult}"
                                            Height="26"
                                            Padding="10,0"
                                            FontSize="11"
                                            Margin="0,0,6,0"/>
                                    <Button Content="{Binding MuteGlyph}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ToggleMuteCommand}"
                                            ToolTip.Tip="{Binding MuteTip}"
                                            Width="30"
                                            Height="26"
                                            Padding="0"
                                            FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Row="3"
                                           Text="{Binding ResultVideoInfo}"
                                           Margin="0,5,0,0"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Grid>
                        <!-- ─── Progress + log ───────────────────────────────────────── -->
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <ProgressBar Value="{Binding ProcessingProgress}"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,0,0,4"
                                         IsVisible="{Binding IsProcessing}"/>
                            <TextBlock Text="{Binding ProcessingStatus}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ctrl:ProcessingLogPanel LogText="{Binding LogOutput}" MaxLogHeight="110"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- Tab: MiniMax I2V (H3 Ref2VA — up to 4 reference pictures,          -->
            <!--      optionally continued past the ~15s ceiling by 3 more passes)  -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <TabItem Header="🌀 MiniMax I2V">
                <Grid x:DataType="vmv:MiniMaxI2VViewModel" DataContext="{Binding MiniMaxI2VVM}" Theme="{StaticResource TabPageStyle}">
                    <Grid.Resources>
                        <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentAmberColor}"/>
                        <!-- One LoRA on the render card: what to load, how hard, and ✕ to drop the
                                     row. The strength only appears once something is chosen — an empty row
                                     has nothing to weigh. -->
                        <DataTemplate x:DataType="m:MiniMaxI2VLoraSlot" x:Key="I2VLoraRowTemplate">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding $parent[ItemsControl].((vmv:MiniMaxI2VViewModel)DataContext).LoraOptions}"
                                              DisplayMemberBinding="{ReflectionBinding Label}"
                                              SelectedValueBinding="{ReflectionBinding Value}"
                                              SelectedValue="{Binding Name, Mode=TwoWay}"
                                              Height="28"
                                              FontSize="11"
                                              ToolTip.Tip="A LoRA from loras/H3 on the server, applied on top of the checkpoint to every pass. Rows load in the order they are listed."/>
                                    <StackPanel IsVisible="{Binding HasLora}">
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                <TextBlock Text="{Binding Strength, StringFormat={}{0:0.00}}"
                                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider Value="{Binding Strength}"
                                                Minimum="0"
                                                Maximum="2"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="0.05"
                                                LargeChange="0.25"
                                                Foreground="{DynamicResource TabAccentBrush}"
                                                ToolTip.Tip="The LoRA's strength_model. 1.00 is the default; 0 leaves this row out of the graph."/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        Width="22"
                                        Height="28"
                                        FontSize="10"
                                        Margin="4,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Top"
                                        Cursor="Hand"
                                        Command="{Binding $parent[ItemsControl].((vmv:MiniMaxI2VViewModel)DataContext).RemoveLoraCommand}"
                                        CommandParameter="{Binding}"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        ToolTip.Tip="Drop this LoRA."/>
                            </Grid>
                        </DataTemplate>
                        <!-- One reference slot. Picture 1 is shown on its own; the rest share this
                             template behind "More references". -->
                        <DataTemplate x:DataType="m:MiniMaxI2VReference" x:Key="I2VReferenceTileTemplate">
                            <Border Margin="0,0,6,6"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Background="{StaticResource SurfaceAltBrush}">
                                <StackPanel>
                                    <Grid Classes="tile">
                                        <TextBlock Text="empty"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   IsVisible="{Binding !HasImage}"/>
                                        <Image Source="{Binding Preview, Converter={StaticResource PathToBitmapConverter}}"
                                               Stretch="Uniform"
                                               Margin="3"/>
                                        <Border VerticalAlignment="Top"
                                                HorizontalAlignment="Left"
                                                Margin="4"
                                                CornerRadius="3"
                                                Padding="5,1"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TabAccentBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="4,0,4,4" ColumnDefinitions="*,Auto">
                                        <Button Grid.Column="0"
                                                Content="Browse…"
                                                Height="24"
                                                FontSize="10"
                                                Padding="6,0"
                                                Background="{StaticResource SurfaceBrush}"
                                                Foreground="{DynamicResource TabAccentBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                Command="{Binding $parent[ScrollViewer].((vmv:MiniMaxI2VViewModel)DataContext).BrowseReferenceCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Grid.Column="1"
                                                Content="✕"
                                                Width="24"
                                                Height="24"
                                                FontSize="9"
                                                Padding="0"
                                                Margin="4,0,0,0"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                IsVisible="{Binding HasImage}"
                                                Command="{Binding $parent[ScrollViewer].((vmv:MiniMaxI2VViewModel)DataContext).ClearReferenceCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <!-- A full-width fold-out header: ▾ closed, ▴ open. -->
                        <ControlTheme x:Key="I2VDisclosureTheme" TargetType="ToggleButton">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ContentPresenter Name="PART_ContentPresenter"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Name="Chevron" Grid.Column="1" Text="▾" FontSize="12"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                            <Style Selector="^:pointerover /template/ Border#Bd">
                                <Setter Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                            </Style>
                            <Style Selector="^:checked /template/ TextBlock#Chevron">
                                <Setter Property="Text" Value="▴"/>
                                <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                            </Style>
                        </ControlTheme>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                    <Border Grid.Column="0" Theme="{StaticResource TabSideRailStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <StackPanel.Styles>
                                    <!-- Reference tiles: Picture 1 overrides this with a taller one. -->
                                    <Style Selector="Grid.tile">
                                        <Setter Property="Height" Value="84"/>
                                    </Style>
                                </StackPanel.Styles>
                                <!-- ─── New take ─────────────────────────────────────────────
                                     Only what a take needs: the workflow, Picture 1, an idea, the length and
                                     ✨ Analyze & Queue. Further references and every other setting are folded
                                     away below. See MiniMaxI2VViewModel.Analysis.cs. -->
                                <Border Theme="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                                            <TextBlock Text="Workflow" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding WorkflowOptions}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}"
                                                      SelectedValue="{Binding Workflow}" Height="30" FontSize="11" HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="{Binding WorkflowSummary}"/>
                                        </Grid>
                                        <ctrl:SectionHeader Title="REFERENCE PICTURES" Note="{Binding ReferenceLimitNote}" Margin="0,0,0,8"
                                                            ToolTip.Tip="These are references, not the frame at 0.00s: they tell H3 how the subjects and the set look, and the prompt says what happens. Slot order is the &lt;Picture N&gt; numbering the prompt refers to."/>
                                        <ContentControl Content="{Binding FirstReference}" ContentTemplate="{StaticResource I2VReferenceTileTemplate}" Margin="0,0,-6,0">
                                            <ContentControl.Styles>
                                                <Style Selector="Grid.tile">
                                                    <Setter Property="Height" Value="170"/>
                                                </Style>
                                            </ContentControl.Styles>
                                        </ContentControl>
                                        <ToggleButton IsChecked="{Binding ShowMoreReferences}" Theme="{StaticResource I2VDisclosureTheme}" Padding="10,6" Margin="0,2,0,6">
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextPrimaryBrush}">
                                                <Run Text="More references"/>
                                                <Run Text=" · " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                <Run Text="{Binding MoreReferencesNote, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                            </TextBlock>
                                        </ToggleButton>
                                        <StackPanel IsVisible="{Binding ShowMoreReferences}" Margin="0,0,0,6">
                                            <ItemsControl ItemsSource="{Binding MoreReferences}" ItemTemplate="{StaticResource I2VReferenceTileTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding ReferenceSummary}" Margin="0,0,0,6" FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <!-- 💎 Ultra's audio and video references. -->
                                            <StackPanel IsVisible="{Binding IsUltra}">
                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}"
                                                           Text="Up to 3 audio and 3 video clips, each 2–15 s and 15 s in total; at most 12 files across pictures, audio and video. An audio clip gives a subject's voice timbre and accent — the words are always new — and cannot be the only reference. The prompt refers to them as &lt;Audio N&gt; and &lt;Video N&gt;."/>
                                                <TextBlock Text="Reference audio" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ItemsControl ItemsSource="{Binding AudioReferences}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:MiniMaxI2VMediaReference">
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="58"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="10" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <Button Grid.Column="2" Content="Browse…" Height="24" FontSize="10" Padding="8,0" Margin="4,0,0,0"
                                                                        Background="{StaticResource SurfaceBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                        Command="{Binding $parent[ItemsControl].((vmv:MiniMaxI2VViewModel)DataContext).BrowseMediaCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Grid.Column="3" Content="✕" Width="24" Height="24" FontSize="9" Padding="0" Margin="4,0,0,0"
                                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                                        IsVisible="{Binding HasFile}"
                                                                        Command="{Binding $parent[ItemsControl].((vmv:MiniMaxI2VViewModel)DataContext).ClearMediaCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Reference video" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ItemsControl ItemsSource="{Binding VideoReferences}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:MiniMaxI2VMediaReference">
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="58"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="10" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <Button Grid.Column="2" Content="Browse…" Height="24" FontSize="10" Padding="8,0" Margin="4,0,0,0"
                                                                        Background="{StaticResource SurfaceBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                        Command="{Binding $parent[ItemsControl].((vmv:MiniMaxI2VViewModel)DataContext).BrowseMediaCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Grid.Column="3" Content="✕" Width="24" Height="24" FontSize="9" Padding="0" Margin="4,0,0,0"
                                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                                        IsVisible="{Binding HasFile}"
                                                                        Command="{Binding $parent[ItemsControl].((vmv:MiniMaxI2VViewModel)DataContext).ClearMediaCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding UltraMediaSummary}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ctrl:SectionHeader Title="IDEA" Note="  · a draft idea, or the full prompt" Margin="0,8,0,6"/>
                                        <TextBox Text="{Binding Prompt}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Height="130"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 Background="{StaticResource SurfaceAltBrush}"
                                                 FontSize="11"
                                                 Padding="8"/>
                                        <Grid Margin="0,8,0,0" IsVisible="{Binding IsRef2VA}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Length"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Slider Grid.Column="1"
                                                    Margin="8,0"
                                                    Minimum="5"
                                                    Maximum="15"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding LengthSeconds}"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Seconds in the base pass. H3's trained range is roughly 124–362 frames at 24 fps, which is where 5–15 seconds comes from."/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding LengthSeconds, StringFormat={}{0}s}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TabAccentBrush}"
                                                       MinWidth="30"
                                                       TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0" IsVisible="{Binding IsUltra}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Duration" VerticalAlignment="Center"
                                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Slider Grid.Column="1" Margin="8,0"
                                                    Minimum="5" Maximum="15" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                    Value="{Binding Ultra.DurationSeconds}" VerticalAlignment="Center"
                                                    ToolTip.Tip="Duration(Second) in the Ultra workflow — 15 as authored. Turned into frames by the graph's own expression, max(5, round(s × 24)) snapped up to H3's 17k+5 grid: 15 s is 362 frames."/>
                                            <TextBlock Grid.Column="2" Text="{Binding Ultra.DurationSeconds, StringFormat={}{0:0.#}s}"
                                                       VerticalAlignment="Center" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11"
                                                       Foreground="{DynamicResource TabAccentBrush}" MinWidth="30" TextAlignment="Right"/>
                                        </Grid>
                                        <!-- Analyze & Queue: freezes this card into its own queue row and writes that
                                             row's prompt in the background. See MiniMaxI2VViewModel.Analysis.cs. -->
                                        <Button Command="{Binding AnalyzeAndQueueCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Height="40"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Margin="0,12,0,4"
                                                Theme="{StaticResource AccentButtonStyle}"
                                                Content="✨  Analyze &amp; Queue"
                                                ToolTip.Tip="Freezes the pictures, the prompt box (as the idea) and every setting into a new queue row, writes its Ref2VA prompt in the background, and starts rendering as soon as the prompt is ready — unless something is already rendering, in which case it waits its turn.&#10;&#10;The tab is free again immediately: load the next picture and press it again. Each press is its own row."/>
                                        <TextBlock Text="Each press becomes its own queue row — load the next picture right away."
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── ⚙ Settings ───────────────────────────────────────────
                                     Everything else, folded away until wanted. Every dial keeps its value while closed. -->
                                <ToggleButton IsChecked="{Binding ShowSettings}" Theme="{StaticResource I2VDisclosureTheme}" Margin="0,0,0,10">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="⚙  Settings"/>
                                        <Run Text="  · prompt tools, model, sampling, canvas" FontSize="10" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}"/>
                                    </TextBlock>
                                </ToggleButton>
                                <StackPanel IsVisible="{Binding ShowSettings}">
                                    <!-- Prompt tools: write without queuing, the library, the location plate. -->
                                    <Border Theme="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <ctrl:SectionHeader Title="PROMPT" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="✎ Write prompt"
                                                        Command="{Binding AnalyzeCommand}"
                                                        IsEnabled="{Binding CanAnalyze}"
                                                        Height="30"
                                                        Padding="14,0"
                                                        FontSize="11"
                                                        Theme="{StaticResource AccentOutlineButtonStyle}"
                                                        ToolTip.Tip="Writes the six-field Ref2VA prompt into the prompt box (and one block per continuation into its own box) so you can read or edit it before queuing — nothing is queued. Use Add to Queue afterwards."/>
                                                <TextBlock FontStyle="Italic"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           Text="Analyzing…"
                                                           Foreground="{DynamicResource TabAccentBrush}"
                                                           Classes="s45"
                                                           Classes.s45_0="{Binding IsAnalyzing}">
                                                    <TextBlock.Styles>
                                                        <Style Selector="TextBlock.s45.s45_0" x:DataType="vmv:MiniMaxI2VViewModel">
                                                            <Setter Property="IsVisible" Value="True"/>
                                                        </Style>
                                                    </TextBlock.Styles>
                                                    <TextBlock.Theme>
                                                        <ControlTheme TargetType="TextBlock" x:DataType="vmv:MiniMaxI2VViewModel">
                                                            <Setter Property="IsVisible" Value="False"/>
                                                        </ControlTheme>
                                                    </TextBlock.Theme>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Prompt library: analyzed and rendered takes are filed
                                                         automatically; this row is how they come back out. -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="{Binding PromptLibraryLabel}"
                                                        Command="{Binding OpenPromptLibraryCommand}"
                                                        Height="28"
                                                        Padding="10,0"
                                                        FontSize="11"
                                                        Margin="0,0,6,0"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        ToolTip.Tip="Browse the takes this tab has saved and put one back in the boxes — segment 1 and its continuations, at the length and aspect it was written for. The reference pictures are not restored."/>
                                                <Button Grid.Column="1"
                                                        Content="💾 Save"
                                                        Command="{Binding SavePromptCommand}"
                                                        Height="28"
                                                        Width="76"
                                                        FontSize="11"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        ToolTip.Tip="File the current segments in the prompt library. Analyzed and rendered takes are saved automatically — this is for hand-edited ones."/>
                                            </Grid>
                                            <CheckBox Content="🏞️ Render a location plate on Analyze"
                                                      IsChecked="{Binding AutoLocationPlate}"
                                                      FontSize="11"
                                                      Margin="0,12,0,2"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      ToolTip.Tip="Before writing the prompt, Analyze asks the LLM for the place the draft idea happens in — two or three landmarks placed left, right and far, and nobody in it — renders it with the Image Generator's Qwen Image 2512 graph at the clip's aspect, and puts it in the first free reference slot as the setting. Without a picture of the place, takes tend to come out flat.&#10;&#10;The plate is reused on the next Analyze; clear its slot to render a new one. Skipped when all four slots are full or Picture 1 is a stereo pair."/>
                                            <TextBlock Text="{Binding LocationPlateSummary}"
                                                       Margin="20,0,0,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- What the chosen workflow does, and 💎 Ultra's reset. -->
                                    <Border Theme="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <ctrl:SectionHeader Title="WORKFLOW" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding WorkflowSummary}" FontSize="10" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <Grid Margin="0,8,0,0" IsVisible="{Binding IsUltra}" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding UltraAuthoredBadge}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                                <Button Grid.Column="1" Content="&#x21BA; Workflow defaults" Height="24" Padding="8,0" FontSize="10" Margin="6,0,0,0"
                                                        Command="{Binding ResetUltraCommand}"
                                                        Theme="{StaticResource AccentOutlineButtonStyle}"
                                                        ToolTip.Tip="Put every Ultra dial back on the value the workflow was tested with."/>
                                            </Grid>
                                            <TextBlock Text="{Binding UltraFrameSummary}" IsVisible="{Binding IsUltra}" Margin="0,6,0,0"
                                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ─── 💎 All-In-One Ultra ─────────────────────────────────
                                         Only shown when the workflow dropdown is on Ultra. Every dial opens on
                                         the authored workflow's value. See MiniMaxI2VViewModel.Ultra.cs. -->
                                    <Border Theme="{StaticResource SectionCardStyle}" IsVisible="{Binding IsUltra}">
                                        <StackPanel>
                                            <ctrl:SectionHeader Title="💎 ULTRA · MODEL &amp; LORAS" Note="  · as tested" Margin="0,0,0,8"/>
                                            <TextBlock Text="Model" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding DiffusionModelOptions}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}"
                                                          SelectedValue="{Binding Ultra.DiffusionModel}" Height="28" FontSize="11" Margin="0,0,6,0"
                                                          ToolTip.Tip="UNETLoader. The workflow ships the fl2va/ref2va hybrid b25-49 int8 — what it was tested on."/>
                                                <Button Grid.Column="1" Content="&#x27F3;" Width="28" Height="28" FontSize="13"
                                                        Command="{Binding RefreshDiffusionModelsCommand}"
                                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        ToolTip.Tip="Re-read diffusion_models/h3-minimax from ComfyUI."/>
                                            </Grid>
                                            <TextBlock Text="Text encoder" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding UltraTextEncoderOptions}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Ultra.TextEncoder}"
                                                      Height="28" FontSize="11" Margin="0,0,0,4"
                                                      ToolTip.Tip="CLIPLoader (type minimax). The workflow loads the nvfp4 awq build; its bypassed second loader is the uncensored heretic int8 build, which has to be downloaded into text_encoders separately."/>
                                            <TextBlock Text="LoRAs" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <CheckBox Content="MysticXXX MMH3 V4" IsChecked="{Binding Ultra.UseMystic}" FontSize="11" Margin="0,0,0,0"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      ToolTip.Tip="LoraLoaderModelOnly 186 — on at 0.50 in the workflow."/>
                                            <Grid Margin="0,2,0,0" IsEnabled="{Binding Ultra.UseMystic}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="  strength" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                    <TextBlock Text="{Binding Ultra.MysticStrength, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="2" Value="{Binding Ultra.MysticStrength}" IsEnabled="{Binding Ultra.UseMystic}"
                                                    TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    ToolTip.Tip="MysticXXX strength_model. 0.50 as authored."/>
                                            <CheckBox Content="DMAD dare-ties v4 (step 600)" IsChecked="{Binding Ultra.UseDmad}" FontSize="11" Margin="0,6,0,2"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      ToolTip.Tip="LoraLoaderModelOnly 242 — on at 0.75 in the workflow."/>
                                            <Grid Margin="0,2,0,0" IsEnabled="{Binding Ultra.UseDmad}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="  strength" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                    <TextBlock Text="{Binding Ultra.DmadStrength, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="2" Value="{Binding Ultra.DmadStrength}" IsEnabled="{Binding Ultra.UseDmad}"
                                                    TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    ToolTip.Tip="DMAD strength_model. 0.75 as authored."/>
                                            <CheckBox Content="⚔ High motion fix (fighting)" IsChecked="{Binding Ultra.HighMotionFix}" FontSize="11" Margin="0,10,0,2"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      ToolTip.Tip="The workflow's 'High motion fix lora group': Combat 0.65 → Motion Repair 0.35 → Fight Flow 0.35 → speed slider 3.00, switched in after DMAD by the 'Fighting High Motion Fix' boolean. Off as authored — turn it on for fast physical action."/>
                                            <StackPanel Margin="18,0,0,0" IsVisible="{Binding Ultra.HighMotionFix}">
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Combat V2" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.CombatStrength, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="2" Value="{Binding Ultra.CombatStrength}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="H3_Combat_V2. 0.65 as authored."/>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Motion Repair V2" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.MotionRepairStrength, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="2" Value="{Binding Ultra.MotionRepairStrength}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="Motion_Repair_V2. 0.35 as authored."/>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Fight Flow V1" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.FightFlowStrength, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="2" Value="{Binding Ultra.FightFlowStrength}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="H3_Fight_Flow_V1. 0.35 as authored."/>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Speed slider 1.1" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.SpeedSliderStrength, StringFormat={}{0:0.0}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="5" Value="{Binding Ultra.SpeedSliderStrength}"
                                                        TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.1"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="H3_speed_slider_1.1. 3.0 as authored."/>
                                            </StackPanel>
                                            <TextBlock Text="Sigma shift" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Video" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                    <TextBlock Text="{Binding Ultra.ShiftVideo, StringFormat={}{0:0.0}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <Slider Minimum="1" Maximum="20" Value="{Binding Ultra.ShiftVideo}"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="0.5"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    ToolTip.Tip="MiniMaxH3SigmaShift shift_video. 12 as authored."/>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Audio" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                    <TextBlock Text="{Binding Ultra.ShiftAudio, StringFormat={}{0:0.0}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <Slider Minimum="1" Maximum="10" Value="{Binding Ultra.ShiftAudio}"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="0.5"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    ToolTip.Tip="MiniMaxH3SigmaShift shift_audio. 3 as authored."/>
                                            <TextBlock Text="{Binding UltraLoraSummary}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Theme="{StaticResource SectionCardStyle}" IsVisible="{Binding IsUltra}">
                                        <StackPanel>
                                            <ctrl:SectionHeader Title="💎 ULTRA · CANVAS" Note="" Margin="0,0,0,8"/>
                                            <TextBlock Text="Aspect ratio" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding AspectRatioOptions}" SelectedItem="{Binding Ultra.AspectRatio}"
                                                      Height="28" FontSize="11" Margin="0,0,0,4"
                                                      ToolTip.Tip="ResolutionSelector aspect. 16:9 as authored; Auto follows picture 1."/>
                                            <TextBlock Text="Size (finished canvas)" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding UltraMegapixelOptions}" DisplayMemberBinding="{ReflectionBinding Label}" SelectedValueBinding="{ReflectionBinding Value}" SelectedValue="{Binding Ultra.Megapixels}"
                                                      Height="28" FontSize="11" Margin="0,0,0,4"
                                                      ToolTip.Tip="ResolutionSelector megapixels, multiple 32. The whole pass is built at this size — SelfLift samples its first steps smaller and lifts them. 2.0 MP (1920×1088) as authored."/>
                                            <TextBlock Text="{Binding UltraCanvasSummary}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,4"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <CheckBox Content="Max-fidelity references (ref_image_size: max)" IsChecked="{Binding Ultra.MaxFidelityReferences}" FontSize="11" Margin="0,6,0,2"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      ToolTip.Tip="On as authored: each reference picture is fed at the reference pipeline's 2048px short edge. Off scales them to the canvas ('match'), which is quicker and loses identity detail."/>
                                            <TextBlock Text="Seed (-1 = random)" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28" Padding="6,0" VerticalContentAlignment="Center"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="12" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" Margin="0,0,6,0"
                                                         ToolTip.Tip="SelfLiftH3Sampler seed. The workflow was saved on 584635394862178 (fixed) — paste that to reproduce its take."/>
                                                <Button Grid.Column="1" Content="🎲" Command="{Binding RandomSeedCommand}" Height="28" Width="36" FontSize="14"
                                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 💎 Ultra's sampler and attention dials: rarely touched, folded once more. -->
                                    <ToggleButton x:Name="UltraAdvancedToggle" IsVisible="{Binding IsUltra}" Theme="{StaticResource I2VDisclosureTheme}" Padding="10,6" Margin="0,0,0,10">
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="💎 Advanced"/>
                                            <Run Text=" · SelfLift sampling, attention &amp; memory" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </TextBlock>
                                    </ToggleButton>
                                    <StackPanel IsVisible="{Binding #UltraAdvancedToggle.IsChecked}">
                                        <Border Theme="{StaticResource SectionCardStyle}" IsVisible="{Binding IsUltra}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="💎 ULTRA · SELFLIFT SAMPLING" Note="  · full-res tiled" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Steps" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.Steps, StringFormat={}{0:0}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="4" Maximum="30" Value="{Binding Ultra.Steps}"
                                                        TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="BasicScheduler steps — 10 as authored. SelfLift keeps the step count: the first few run at the low-res scale, the rest at full size."/>
                                                <TextBlock Text="Scheduler" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding UltraSchedulerOptions}" SelectedItem="{Binding Ultra.Scheduler}"
                                                          Height="28" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip.Tip="BasicScheduler. beta as authored. The sampler is euler — SelfLift is Euler-only."/>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Low-res steps (transition_step)" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.TransitionStep, StringFormat={}{0:0}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="1" Maximum="29" Value="{Binding Ultra.TransitionStep}"
                                                        TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="How many evaluations run at the low-res scale before the latent is lifted. 6 of 10 as authored; always kept below the step count."/>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Low-res scale" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.LowresScale, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="0.25" Maximum="1" Value="{Binding Ultra.LowresScale}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="Spatial scale of the low-res prefix. 0.60 as authored (the paper uses 0.5)."/>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="CFG" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.Cfg, StringFormat={}{0:0.0}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="1" Maximum="5" Value="{Binding Ultra.Cfg}"
                                                        TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.1"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="SelfLift cfg. 1.0 as authored — this stack runs without guidance."/>
                                                <TextBlock Text="Latent upscaler" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding UltraUpscalerOptions}" SelectedItem="{Binding Ultra.UpscalerModel}"
                                                          Height="28" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip.Tip="The model that lifts the low-res latent to full size. h3_upscaler_lms_v0.1 as authored. 'none' is SelfLift-zero (pair it with rho around 0.6)."/>
                                                <CheckBox Content="Full-res tiling (highres_tiling)" IsChecked="{Binding Ultra.HighresTiling}" FontSize="11" Margin="0,6,0,2"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip.Tip="On as authored — the 'Full-Res Tiled' in the workflow's name: the full-size steps run in tiles, which is what lets a 1920×1088 take fit in VRAM."/>
                                                <CheckBox Content="Unload the upscaler after use" IsChecked="{Binding Ultra.UpscalerUnload}" FontSize="11" Margin="0,6,0,2"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip.Tip="upscaler_unload. On as authored."/>
                                                <Expander Header="Advanced" IsExpanded="False" FontSize="11" Margin="0,6,0,0">
                                                    <StackPanel Margin="0,4,0,0">
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="rho" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                                <TextBlock Text="{Binding Ultra.Rho, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                        <Slider Minimum="0" Maximum="1" Value="{Binding Ultra.Rho}"
                                                                TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                                Foreground="{DynamicResource TabAccentBrush}"
                                                                ToolTip.Tip="Fraction of highest-risk locations corrected toward a pixel-VAE anchor at the transition. 0 as authored (the external upscaler alone, no VAE round trip)."/>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="w_min" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                                <TextBlock Text="{Binding Ultra.WMin, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                        <Slider Minimum="0" Maximum="1" Value="{Binding Ultra.WMin}"
                                                                TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                                Foreground="{DynamicResource TabAccentBrush}"
                                                                ToolTip.Tip="SelfLift w_min. 0.50 as authored."/>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="w_max" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                                <TextBlock Text="{Binding Ultra.WMax, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                        <Slider Minimum="0" Maximum="1" Value="{Binding Ultra.WMax}"
                                                                TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                                Foreground="{DynamicResource TabAccentBrush}"
                                                                ToolTip.Tip="SelfLift w_max. 1.00 as authored."/>
                                                    </StackPanel>
                                                </Expander>
                                                <TextBlock Text="{Binding UltraSamplingSummary}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Theme="{StaticResource SectionCardStyle}" IsVisible="{Binding IsUltra}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="💎 ULTRA · ATTENTION &amp; MEMORY" Note="" Margin="0,0,0,8"/>
                                                <TextBlock Text="Attention backend" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding UltraAttentionOptions}" SelectedItem="{Binding Ultra.AttentionBackend}"
                                                          Height="28" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip.Tip="ModelAttentionBackend. comfy kitchen attention (quantized INT8, Nvidia/AMD) as authored."/>
                                                <CheckBox Content="Block-sparse attention (sol-attn)" IsChecked="{Binding Ultra.UseSparseAttention}" FontSize="11" Margin="0,6,0,2"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip.Tip="BlockSparseAttention, method sol-attn: a training-free adaptive threshold per head picks the key blocks that get exact attention. On as authored — tau 1.3, from 20% of the schedule to the end."/>
                                                <Grid Margin="0,4,0,0" IsEnabled="{Binding Ultra.UseSparseAttention}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="tau" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.SparseTau, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="4" Value="{Binding Ultra.SparseTau}" IsEnabled="{Binding Ultra.UseSparseAttention}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="Threshold in score-distribution sigmas. Higher is sparser: 1.0 keeps ~16% of key blocks exact, 1.5 ~7%. 1.3 as authored."/>
                                                <Grid Margin="0,4,0,0" IsEnabled="{Binding Ultra.UseSparseAttention}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Start" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.SparseStart, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="1" Value="{Binding Ultra.SparseStart}" IsEnabled="{Binding Ultra.UseSparseAttention}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="start_percent. 0.20 as authored."/>
                                                <Grid Margin="0,4,0,0" IsEnabled="{Binding Ultra.UseSparseAttention}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="End" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.SparseEnd, StringFormat={}{0:0.00}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="1" Value="{Binding Ultra.SparseEnd}" IsEnabled="{Binding Ultra.UseSparseAttention}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="end_percent. 1.00 as authored."/>
                                                <CheckBox Content="Low VRAM block swap (much slower)" IsChecked="{Binding Ultra.LowVramBlockSwap}" FontSize="11" Margin="0,10,0,2"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip.Tip="UniBlockSwap — bypassed in the workflow. The author's note: enable it to run on ~8 GB of VRAM, much slower."/>
                                                <Grid Margin="0,4,0,0" IsEnabled="{Binding Ultra.LowVramBlockSwap}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Blocks to swap (-1 = all)" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="7,0">
                                                        <TextBlock Text="{Binding Ultra.BlockSwapBlocks, StringFormat={}{0:0}}" FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="-1" Maximum="60" Value="{Binding Ultra.BlockSwapBlocks}" IsEnabled="{Binding Ultra.LowVramBlockSwap}"
                                                        TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        ToolTip.Tip="num_blocks: blocks from the end to swap to system RAM. -1 swaps all, as authored."/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Continuations -->
                                    <Border Theme="{StaticResource SectionCardStyle}" IsVisible="{Binding IsRef2VA}">
                                        <StackPanel>
                                            <ctrl:SectionHeader Title="CONTINUATIONS" Note="  · up to 3" Margin="0,0,0,4"/>
                                            <TextBlock TextWrapping="Wrap"
                                                       Margin="0,0,0,8"
                                                       FontSize="10"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="H3 renders at most one ~15s pass, so a longer take is bought with continuations: each is a further pass inside the same submission, conditioned on the tail of the pass before it and blended back over the overlap."/>
                                            <ItemsControl ItemsSource="{Binding Continuations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="m:MiniMaxI2VSegment">
                                                        <Border Margin="0,0,0,6"
                                                                Padding="8"
                                                                CornerRadius="6"
                                                                BorderThickness="1"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                Background="{StaticResource SurfaceAltBrush}">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Title}"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                                                    <Slider Grid.Column="1"
                                                                            Margin="10,0,6,0"
                                                                            Minimum="5"
                                                                            Maximum="15"
                                                                            TickFrequency="1"
                                                                            IsSnapToTickEnabled="True"
                                                                            Value="{Binding Seconds}"
                                                                            VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding Seconds, StringFormat={}{0}s}"
                                                                               VerticalAlignment="Center"
                                                                               FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                                               FontSize="11"
                                                                               MinWidth="30"
                                                                               TextAlignment="Right"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                    <Button Grid.Column="3"
                                                                            Content="✕"
                                                                            Width="22"
                                                                            Height="22"
                                                                            Padding="0"
                                                                            FontSize="9"
                                                                            Margin="6,0,0,0"
                                                                            Theme="{StaticResource SecondaryButtonStyle}"
                                                                            Command="{Binding $parent[ItemsControl].((vmv:MiniMaxI2VViewModel)DataContext).RemoveContinuationCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                </Grid>
                                                                <TextBox Text="{Binding Prompt}"
                                                                         TextWrapping="Wrap"
                                                                         AcceptsReturn="True"
                                                                         Height="90"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                         BorderBrush="{StaticResource BorderBrush}"
                                                                         Background="White"
                                                                         FontSize="11"
                                                                         Padding="6"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="＋ Add continuation"
                                                    Command="{Binding AddContinuationCommand}"
                                                    Height="28"
                                                    FontSize="11"
                                                    HorizontalAlignment="Left"
                                                    Padding="12,0"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    Foreground="{DynamicResource TabAccentBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"/>
                                            <StackPanel Margin="0,10,0,0" IsVisible="{Binding HasContinuations}">
                                                <TextBlock Text="Join overlap"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding OverlapOptions}"
                                                          DisplayMemberBinding="{ReflectionBinding Label}"
                                                          SelectedItem="{Binding Overlap}"
                                                          Height="30"
                                                          FontSize="11"
                                                          ToolTip.Tip="Frames of the previous pass a continuation re-generates and blends over. The choices are H3's own valid clip lengths (17k + 5), because the overlap is handed to the model as a reference clip — more of it costs render time and buys a less visible join."/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- ─── Render ──────────────────────────────────────────
                                                 The dials ⚡ H3 Express has, on this tab's graph. A stack here
                                                 is a patch rather than a second workflow file: every one of
                                                 them renders h3-minimax-i2v.json, and what changes is the
                                                 checkpoint, the sampler and scheduler, the sigma shift, the
                                                 LoRAs the stack is built around and — on 🍥 and 🐰 — the second
                                                 sampler. See MiniMaxI2VViewModel.Stacks.cs. -->
                                    <Border Theme="{StaticResource SectionCardStyle}" IsVisible="{Binding IsRef2VA}">
                                        <StackPanel>
                                            <ctrl:SectionHeader Title="RENDER" Note="  · applies to every pass" Margin="0,0,0,10"/>
                                            <TextBlock Text="Sampling stack"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,4"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <RadioButton Content="🌀 Shipped"
                                                         GroupName="I2VStack"
                                                         IsChecked="{Binding StackIsShipped, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanChangeRender}"
                                                         FontSize="11"
                                                         Margin="0,0,0,2"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         ToolTip.Tip="The graph as authored: the ref2va checkpoint on the lightx2v 4-step turbo LoRA, euler/simple at 8 steps with the 12/3 sigma shift. This is what the tab rendered before the other four existed, and the only stack that keeps the turbo LoRA on the wire. Locked while anything is rendering, so a queue cannot drain half on one stack and half on another."/>
                                            <RadioButton Content="🌹 H3 Eros"
                                                         GroupName="I2VStack"
                                                         IsChecked="{Binding StackIsEros, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanChangeRender}"
                                                         FontSize="11"
                                                         Margin="0,2,0,2"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         ToolTip.Tip="h3-eros.json's sampling: the 10Eros TURBO hybrid at er_sde/beta, 12 steps, with no sigma shift and the turbo LoRA taken off the wire — the three things that graph does differently. The references, the prompt and the continuation loop are this tab's, unchanged."/>
                                            <RadioButton Content="✴️ Singularity"
                                                         GroupName="I2VStack"
                                                         IsChecked="{Binding StackIsSingularity, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanChangeRender}"
                                                         FontSize="11"
                                                         Margin="0,2,0,2"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         ToolTip.Tip="The Singularity ref2va checkpoint, euler/simple at 10 steps with the 12/3 sigma shift — h3-singularity.json's sampling, which is what its author measured."/>
                                            <CheckBox Content="er_sde/beta sampler (keep the sigma shift)"
                                                      IsChecked="{Binding SingularityErSde}"
                                                      IsEnabled="{Binding CanChangeRender}"
                                                      IsVisible="{Binding StackIsSingularity}"
                                                      FontSize="11"
                                                      Margin="20,2,0,2"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      ToolTip.Tip="Keep the Singularity checkpoint and its 12/3 shift, but sample it the H3 Eros way: er_sde/beta at 12 steps. Euler/simple at 10 is the author's setting and tends to come out softer; this is untested on that checkpoint."/>
                                            <RadioButton Content="🍥 TaoMate relay"
                                                         GroupName="I2VStack"
                                                         IsChecked="{Binding StackIsTaoMate, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanChangeRender}"
                                                         FontSize="11"
                                                         Margin="0,2,0,2"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         ToolTip.Tip="h3-taomate.json's two-leg relay: one ten-step linear/euler beta57 schedule split across two ClownsharKSampler passes — six steps on the fl2va checkpoint with the 12/6 shift, then the rest resampled on the TaoMate 3-step LoRA at 0.65, which reads the checkpoint without the shift and without the attention backend, exactly as the authored graph wires it.&#10;&#10;There is no draft canvas on this stack: every pass is painted at the Quality size and the finished frames are doubled by RTX Video Super Resolution instead of the latent being lifted, so the file lands at twice Quality in each direction and the render costs more per second. The latent upscale is switched off and RTX on for you while it is chosen."/>
                                            <RadioButton Content="🐰 BUNNY (action)"
                                                         GroupName="I2VStack"
                                                         IsChecked="{Binding StackIsBunny, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanChangeRender}"
                                                         FontSize="11"
                                                         Margin="0,2,0,2"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         ToolTip.Tip="h3-bunny.json's sigma split, on the fl2va/ref2va hybrid. One res_multistep/simple schedule is extended with three more steps between sigma 0.65 and 0.28 — where the motion is decided — and then cut at 75%: the first three quarters are sampled with the pass's own seed and the H3 Combat LoRA at full strength, and the last quarter is run out by a second sampler that does not re-noise, on the same LoRA at 0.65, which takes the noise and texture smear off the tail. The latent upscale then finishes it as usual.&#10;&#10;Pick it for takes that are mostly physical action: the Combat LoRA is on the wire at full strength through the pass that decides the motion."/>
                                            <RadioButton Content="🦠 Parasyte (sparse)"
                                                         GroupName="I2VStack"
                                                         IsChecked="{Binding StackIsParasyte, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanChangeRender}"
                                                         FontSize="11"
                                                         Margin="0,2,0,2"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         ToolTip.Tip="h3-parasyte.json's sampling, on the fl2va/ref2va hybrid: the H3-PK-Parasyte-Turbo LoRA at 1.00, res_multistep/simple at 13 steps, no sigma shift and the shipped turbo LoRA off the wire.&#10;&#10;This graph already patches H3SLAAttention last on both the base pass's and the continuation loop's model wires, so the sparse-attention speed-up is whatever the SLA dial below is set to — the stack itself is the LoRA and the schedule. The references, the prompt, the canvas and the continuation loop are this tab's, unchanged."/>
                                            <RadioButton Content="🌊 HyperFlow (8-step)"
                                                         GroupName="I2VStack"
                                                         IsChecked="{Binding StackIsHyperFlow, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanChangeRender}"
                                                         FontSize="11"
                                                         Margin="0,2,0,2"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         ToolTip.Tip="The action recipe: Video Rebirth's HyperFlow 8-step adapter on the Singularity ref2va pruned checkpoint (bypass, curve refit on), euler on the adapter's own trained sigma grid in place of every scheduler, SLA forced on at 0.90. The upscale pass swaps HyperFlow for the TaoMate 3-step LoRA and runs exactly two steps. The shipped turbo LoRA, the sigma shift and the Sol-Attn toggle come off the wire, and neither steps dial does anything here. Leave the LoRA stack empty.&#10;&#10;Needs the ComfyUI-HyperFlow-H3 pack and custom_node_hyperflow_8step_v1.0_comfyui_pruned.safetensors in models/hyperflow."/>
                                            <TextBlock Text="{Binding StackSummary}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="20,2,0,10"/>
                                            <!-- Sampling steps. Per checkpoint and remembered, so each
                                                         stack keeps its own count; frozen with the stack above,
                                                         since the count is read as each pass's graph is built. -->
                                            <!-- 🌊 HyperFlow samples its own grid: no step count to set. -->
                                            <StackPanel IsVisible="{Binding UsesStepDials}">
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Sampling steps"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8,1">
                                                        <TextBlock Text="{Binding FirstPassStepCount}"
                                                                   FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Content="↺"
                                                            Width="22"
                                                            Height="20"
                                                            FontSize="11"
                                                            Margin="6,0,0,0"
                                                            Padding="0"
                                                            Command="{Binding ResetStepsCommand}"
                                                            IsVisible="{Binding HasStepsOverride}"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            ToolTip.Tip="Forget the count saved for this checkpoint and go back to the one its stack is authored at."/>
                                                </Grid>
                                                <!-- Minimum and Maximum before Value on purpose: a Slider still
                                                         holding its 0-10 defaults would coerce a 12-step count down
                                                         to 10 and write that back through the two-way binding. -->
                                                <Slider Minimum="{Binding MinStepsForStack}"
                                                        Maximum="30"
                                                        Value="{Binding FirstPassStepCount}"
                                                        TickFrequency="1"
                                                        IsSnapToTickEnabled="True"
                                                        SmallChange="1"
                                                        LargeChange="2"
                                                        IsEnabled="{Binding CanChangeRender}"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        Margin="0,0,0,2"
                                                        ToolTip.Tip="Steps on the pass that paints the clip. Saved against the checkpoint in More options ▸ Model, so each one keeps its own — the shipped build is authored at 8, the 10Eros hybrid at 12, Singularity at 10 and BUNNY at 8 before it weaves three more in. Locked while anything is rendering."/>
                                                <TextBlock Text="{Binding StepsSummary}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="20,0,0,10"/>
                                            </StackPanel>
                                            <!-- The dials you set once and leave. Shut by default. -->
                                            <Expander Header="More options" IsExpanded="False" FontSize="11">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Text="Model" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <Grid Margin="0,0,0,4" IsEnabled="{Binding CanChangeRender}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox ItemsSource="{Binding DiffusionModelOptions}"
                                                                  DisplayMemberBinding="{ReflectionBinding Label}"
                                                                  SelectedValueBinding="{ReflectionBinding Value}"
                                                                  SelectedValue="{Binding SelectedDiffusionModel}"
                                                                  Height="30"
                                                                  FontSize="11"
                                                                  Margin="0,0,6,0"
                                                                  ToolTip.Tip="The H3 checkpoint, from diffusion_models/h3-minimax on the server. Picking a stack above moves this to that stack's own checkpoint; change it afterwards and the choice sticks."/>
                                                        <Button Grid.Column="1"
                                                                Content="⟳"
                                                                Width="30"
                                                                Height="30"
                                                                FontSize="13"
                                                                Command="{Binding RefreshDiffusionModelsCommand}"
                                                                Background="{StaticResource SurfaceAltBrush}"
                                                                Foreground="{DynamicResource TabAccentBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                ToolTip.Tip="Re-read the model list from ComfyUI."/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DiffusionModelSummary}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Margin="0,0,0,10"/>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="LoRA stack"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <Button Grid.Column="1"
                                                                Content="＋ Add"
                                                                Height="22"
                                                                Padding="8,0"
                                                                FontSize="10"
                                                                Command="{Binding AddLoraCommand}"
                                                                Theme="{StaticResource AccentOutlineButtonStyle}"
                                                                ToolTip.Tip="Add a LoRA row. The graph has five seats, so up to five stack on the checkpoint in the order they are listed. Stays live while a queue is draining: the stack is frozen onto each item as you add it, so an edit here reaches the next item you queue and leaves the ones already waiting alone."/>
                                                        <Button Grid.Column="2"
                                                                Content="⟳"
                                                                Width="24"
                                                                Height="22"
                                                                FontSize="11"
                                                                Margin="4,0,0,0"
                                                                Padding="0"
                                                                Command="{Binding RefreshLorasCommand}"
                                                                Background="{StaticResource SurfaceAltBrush}"
                                                                Foreground="{DynamicResource TabAccentBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                ToolTip.Tip="Re-read loras/H3 from ComfyUI."/>
                                                    </Grid>
                                                    <!-- No IsEnabled gate, unlike the rest of the card: nothing
                                                                 reads this collection during a render. Add to Queue copies
                                                                 the active slots onto the item and the graph is built from
                                                                 that copy, so the stack can be rewritten for the next item
                                                                 while the queue drains. See CanAddLora. -->
                                                    <ItemsControl ItemsSource="{Binding Loras}"
                                                                  ItemTemplate="{StaticResource I2VLoraRowTemplate}"
                                                                  Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding LoraSummary}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Margin="0,2,0,10"/>
                                                    <!-- Belongs to the latent-upscale finish. 🍥 TaoMate paints at the
                                                                 Quality canvas and upscales the frames, so it has no finishing
                                                                 schedule to pick — hidden rather than left to lie. -->
                                                    <StackPanel IsVisible="{Binding UsesDraftCanvas}">
                                                        <StackPanel IsVisible="{Binding UsesStepDials}">
                                                            <TextBlock Text="Upscale steps"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Margin="0,0,0,4"/>
                                                            <ComboBox ItemsSource="{Binding UpscaleStepOptions}"
                                                                      SelectedItem="{Binding UpscaleSteps}"
                                                                      Height="30"
                                                                      FontSize="11"
                                                                      Margin="0,0,0,10"
                                                                      ToolTip.Tip="Fixed sigmas on the pass that finishes the upscaled latent. 3 is what this graph ships; 4 and 5 add detail and cost a little more. Only used with the latent upscale on."/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <CheckBox Content="RIFE interpolation (24 → 48 fps)"
                                                              IsChecked="{Binding UseRife}"
                                                              FontSize="11"
                                                              Foreground="{StaticResource TextPrimaryBrush}"
                                                              ToolTip.Tip="Interpolate the finished frames to 48 fps before they are written. Unlike the Express graphs this one is not authored with RIFE, so the node is added in front of whichever sink the run saves — it never touches the frames a continuation is built from."/>
                                                </StackPanel>
                                            </Expander>
                                            <TextBlock Text="{Binding RenderSummary}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Canvas -->
                                    <Border Theme="{StaticResource SectionCardStyle}" IsVisible="{Binding IsRef2VA}">
                                        <StackPanel>
                                            <ctrl:SectionHeader Title="CANVAS" Margin="0,0,0,10"/>
                                            <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                      SelectedItem="{Binding SelectedAspectRatio}"
                                                      Height="30"
                                                      FontSize="11"
                                                      Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontStyle="Italic"
                                                       Margin="0,0,0,10"/>
                                            <TextBlock Text="Quality (canvas size)"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                      DisplayMemberBinding="{ReflectionBinding Label}"
                                                      SelectedValueBinding="{ReflectionBinding Value}"
                                                      SelectedValue="{Binding Megapixels}"
                                                      Height="30"
                                                      FontSize="11"
                                                      Margin="0,0,0,10"
                                                      ToolTip.Tip="The size of the finished frames. With the latent upscale on, the draft is sampled at a quarter of this and doubled, so only the last three steps ever run at the full size."/>
                                            <TextBlock Text="Seed (-1 = random)"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding Seed}"
                                                         Height="30"
                                                         Padding="6,0"
                                                         VerticalContentAlignment="Center"
                                                         BorderBrush="{StaticResource BorderBrush}"
                                                         Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="12"
                                                         FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                         Margin="0,0,6,0"
                                                         ToolTip.Tip="The base pass uses this seed; each continuation uses it plus its own index, so a whole take reproduces from one number."/>
                                                <Button Grid.Column="1"
                                                        Content="🎲"
                                                        Command="{Binding RandomSeedCommand}"
                                                        Height="30"
                                                        Width="36"
                                                        FontSize="14"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Foreground="{DynamicResource TabAccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <!-- Finishing -->
                                    <Border Theme="{StaticResource SectionCardStyle}" IsVisible="{Binding IsRef2VA}">
                                        <StackPanel>
                                            <ctrl:SectionHeader Title="FINISHING" Margin="0,0,0,8"/>
                                            <!-- 🌊 HyperFlow forces SLA 0.90 and steps over Sol-Attn. -->
                                            <StackPanel IsVisible="{Binding UsesAttentionDials}">
                                                <CheckBox Content="SLA block-sparse attention"
                                                          IsChecked="{Binding UseSla}"
                                                          FontSize="11"
                                                          Margin="0,0,0,4"
                                                          ToolTip.Tip="Block-sparse attention for MiniMax H3: each query block is scored against every key block with one pooled matmul, and only the top slice is actually attended. Nothing is loaded and nothing is trained - the sparsity is decided at runtime from q and k.&#10;&#10;Long sequences benefit most, so the gain grows with duration and canvas size. Anything under the kernel's minimum sequence length falls back to dense on its own, which is why a short low-res clip may show no change at all."/>
                                                <ComboBox ItemsSource="{Binding SlaSparsityOptions}"
                                                          DisplayMemberBinding="{ReflectionBinding Label}"
                                                          SelectedValueBinding="{ReflectionBinding Value}"
                                                          SelectedValue="{Binding SlaSparsity}"
                                                          IsEnabled="{Binding UseSla}"
                                                          Height="28"
                                                          FontSize="11"
                                                          Margin="18,0,0,8"
                                                          ToolTip.Tip="Fraction of key blocks skipped. Break-even is around 0.60 - below that the kernel is SLOWER than dense attention, so a low value is a loss, not a safe fallback."/>
                                                <CheckBox Content="Sol-Attn (legacy sparse attention)"
                                                          IsChecked="{Binding UseSparseAttention}"
                                                          FontSize="11"
                                                          Margin="0,0,0,7"
                                                          ToolTip.Tip="H3 denoises every frame of the clip in one pass, so attention cost grows with the square of frames × canvas area — a 10s clip costs far more than twice a 5s one. Sol-Attn replaces the dense attention with a sparse approximation over the video tokens.&#10;&#10;It engages only between 20% and 90% of the steps, and only once a pass exceeds 4096 tokens — the opening steps set the layout and the closing ones set the fine detail, and neither is worth approximating. Long or large clips are where it pays; short ones may not trip the threshold at all.&#10;&#10;It is an approximation, so turn it off if you are chasing the last of the detail."/>
                                            </StackPanel>
                                            <CheckBox Content="Latent upscale (draft → 2× finish)"
                                                      IsChecked="{Binding UseLatentUpscale}"
                                                      FontSize="11"
                                                      Margin="0,0,0,7"
                                                      ToolTip.Tip="Renders each pass in three moves instead of one: four sampler steps at half the width and half the height to settle the composition, a 2× pass through the MiniMax H3 3D latent upscaler, then three fixed-sigma steps at the finished size to put the detail on.&#10;&#10;Only those last three steps ever see the full canvas, which is why this is both quicker and sharper than denoising the whole clip over eight steps. Turned off, the pass falls back to exactly that — one 8-step sampling at the full size, no upscaler involved."/>
                                            <CheckBox Content="Audio enhancement"
                                                      IsChecked="{Binding UseAudioEnhancement}"
                                                      FontSize="11"
                                                      Margin="0,0,0,7"
                                                      ToolTip.Tip="Runs the decoded soundtrack through the DSRE enhancer — harmonics, stereo width, noise reduction. With continuations it runs once on the joined audio, never per segment."/>
                                            <CheckBox Content="RTX 2× super-resolution"
                                                      IsChecked="{Binding UseRtxUpscale}"
                                                      FontSize="11"
                                                      Margin="0,0,0,7"
                                                      ToolTip.Tip="Doubles the finished frames through NVIDIA RTX Video Super Resolution. It is a driver-side upscale, not a sampling pass, so it adds no detail the model did not already draw — and it needs an RTX card with VSR available.&#10;&#10;It runs only on the final frames: applied to the base pass while continuing, it would feed the loop frames at the wrong size."/>
                                            <TextBlock Text="{Binding StereoSummary}"
                                                       Margin="0,0,0,6"
                                                       FontSize="10"
                                                       FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource AccentAmberBrush}"
                                                       FontWeight="SemiBold"
                                                       Classes="s46"
                                                       Classes.s46_0="{Binding IsPrimaryStereo}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s46.s46_0" x:DataType="vmv:MiniMaxI2VViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vmv:MiniMaxI2VViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <TextBlock Text="STEREO PROMPT ({LAYOUT} is substituted)"
                                                       Margin="0,0,0,3"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBox Text="{Binding StereoPromptTemplate, UpdateSourceTrigger=LostFocus}"
                                                     Margin="0,0,0,8"
                                                     Height="72"
                                                     FontSize="10"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ToolTip.Tip="Filled in automatically when &lt;Picture 1&gt; turns out to be a stereoscopic pair packed into one frame, so the wording does not have to be pasted in every take.&#10;&#10;{LAYOUT} becomes &quot;side-by-side split-screen&quot; or &quot;over-under stacked&quot; to match what was detected. The wording is yours to change - &quot;wide-angle fisheye&quot; is right for VR180 footage and wrong for a stereo photograph, and the tab cannot tell which it is looking at. Clear the box to switch the auto-insert off.&#10;&#10;It is only ever prepended to the idea box, never to a Ref2VA prompt Analyze has already written - and Analyze is told the same facts separately, so the layout lands inside detailed_description where it binds."/>
                                            <CheckBox Content="Max-fidelity references (slow)"
                                                      IsChecked="{Binding MaxFidelityReferences}"
                                                      FontSize="11"
                                                      Margin="0,0,0,4"
                                                      ToolTip.Tip="Feeds each reference at a 2048px short edge instead of scaling it to the generation's pixel area. Reference tokens ride through every sampling step, so this can be several times slower — it buys identity fidelity and nothing else."/>
                                            <TextBlock Text="{Binding ReferenceScaleWarning}"
                                                       Margin="18,0,0,8"
                                                       FontSize="10"
                                                       FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                       TextWrapping="Wrap"
                                                       ToolTip.Tip="Reference pictures are fed at 'match', which scales them to the SAMPLED canvas - and with the latent upscale on that is the draft, a quarter of the megapixels you picked. A 4K reference at 0.7 MP is read at 576x320.&#10;&#10;That is enough for a pose or a palette, but not for a face to hold identity against a competing reference, and not for fine structure - split-screen panels, text, patterns - to survive at all. Max-fidelity references above is the fix; raising the quality helps a little."
                                                       Classes="s47"
                                                       Classes.s47_0="{Binding HasReferenceScaleInfo}"
                                                       Classes.s47_1="{Binding IsReferenceScaleRisky}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s47.s47_0" x:DataType="vmv:MiniMaxI2VViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                    <Style Selector="TextBlock.s47.s47_1" x:DataType="vmv:MiniMaxI2VViewModel">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vmv:MiniMaxI2VViewModel">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <TextBlock Text="{Binding TotalLengthSummary}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                       Foreground="{DynamicResource TabAccentBrush}"/>
                                            <TextBlock Text="{Binding MemoryWarning}"
                                                       Margin="0,4,0,0"
                                                       FontSize="10"
                                                       FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                       TextWrapping="Wrap"
                                                       ToolTip.Tip="Rough peak tensor size for a single pass: finished canvas area x frames. The finish sampler sets it - the draft runs at a quarter of the area and is never the peak. Continuations run one after another, so the peak is the largest single pass, not the total.&#10;&#10;Measured on this 24 GB card: 0.40 Gpx completed, 0.57 Gpx ran out of memory. Length is usually the lever - H3 denoises every frame of the clip jointly, so 15s costs about 1.5x what 10s does at the same canvas."
                                                       Classes="s48"
                                                       Classes.s48_0="{Binding IsMemoryRisky}"
                                                       Classes.s48_1="{Binding IsMemoryOverLimit}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s48.s48_0" x:DataType="vmv:MiniMaxI2VViewModel">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                    <Style Selector="TextBlock.s48.s48_1" x:DataType="vmv:MiniMaxI2VViewModel">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vmv:MiniMaxI2VViewModel">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="240"/>
                                <!-- Reference strip -->
                                <RowDefinition Height="3"/>
                                <!-- Progress bar -->
                                <RowDefinition Height="Auto"/>
                                <!-- Status row -->
                                <RowDefinition Height="Auto"/>
                                <!-- Action buttons -->
                                <RowDefinition Height="Auto"/>
                                <!-- Queue -->
                                <RowDefinition Height="Auto"/>
                                <!-- Result output -->
                                <RowDefinition Height="Auto"/>
                                <!-- Log -->
                            </Grid.RowDefinitions>
                            <!-- ─── Reference strip ───────────────────────────────────── -->
                            <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Classes="s49"
                                                Classes.s49_0="{Binding HasReference}">
                                        <StackPanel.Styles>
                                            <Style Selector="StackPanel.s49.s49_0" x:DataType="vmv:MiniMaxI2VViewModel">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </Style>
                                        </StackPanel.Styles>
                                        <StackPanel.Theme>
                                            <ControlTheme TargetType="StackPanel" x:DataType="vmv:MiniMaxI2VViewModel">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </ControlTheme>
                                        </StackPanel.Theme>
                                        <Border Width="64"
                                                Height="64"
                                                CornerRadius="14"
                                                Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource TextSecondaryBrush}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,10">
                                            <TextBlock Text="🌀" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="MiniMax H3 · Reference to Video"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PlayerTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="Load 1–4 reference pictures → Analyze → Generate (video + synced audio)"
                                                   FontSize="11"
                                                   Foreground="{StaticResource PlayerTextBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding FilledReferences}"
                                                  Margin="12"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  IsVisible="{Binding HasReference}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:MiniMaxI2VReference">
                                                <StackPanel Margin="6,0">
                                                    <Border CornerRadius="6"
                                                            BorderThickness="1"
                                                            Padding="2"
                                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                                            Background="{StaticResource PlayerSurfaceRaisedBrush}">
                                                        <Image Source="{Binding Preview, Converter={StaticResource PathToBitmapConverter}}"
                                                               Height="164"
                                                               Stretch="Uniform"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,5,0,0"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PlayerTextBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border VerticalAlignment="Bottom"
                                            HorizontalAlignment="Right"
                                            Margin="10"
                                            CornerRadius="8"
                                            Padding="12,6"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            IsVisible="{Binding HasReference}">
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding ResolvedAspectRatio, Mode=OneWay}"
                                                 FontWeight="Bold"
                                                 Foreground="{DynamicResource TabAccentBrush}"
                                                 FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding TotalLengthSummary, Mode=OneWay}"
                                                 FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- ─── Progress bar ──────────────────────────────────────── -->
                            <ProgressBar Grid.Row="1"
                                         Value="{Binding ProcessingProgress, Mode=OneWay}"
                                         Foreground="{DynamicResource TabAccentBrush}"
                                         BorderThickness="0"
                                         IsVisible="{Binding IsProcessing}"/>
                            <!-- ─── Status row ────────────────────────────────────────── -->
                            <Border Grid.Row="2" Theme="{StaticResource ToolStripStyle}" BorderThickness="0,1,0,0" Padding="12,5">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5"
                                                 Height="5"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,7,0"
                                                 Classes="s50"
                                                 Classes.s50_0="{Binding IsProcessing}">
                                            <Ellipse.Styles>
                                                <Style Selector="Ellipse.s50.s50_0" x:DataType="vmv:MiniMaxI2VViewModel">
                                                    <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                </Style>
                                            </Ellipse.Styles>
                                            <Ellipse.Theme>
                                                <ControlTheme TargetType="Ellipse" x:DataType="vmv:MiniMaxI2VViewModel">
                                                    <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                </ControlTheme>
                                            </Ellipse.Theme>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ProcessingStatus}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                        <!-- Elapsed and estimated remaining: on a render this long the
                                                 percentage on its own says nothing about when to come back. -->
                                        <TextBlock Text="{Binding GenerationTimer}"
                                                   Margin="0,0,10,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TabAccentBrush}"
                                                   FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsProcessing}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- ─── Action Buttons ────────────────────────────────────── -->
                            <Border Grid.Row="3" Theme="{StaticResource ToolStripStyle}" BorderThickness="0,1,0,0" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Column="0"
                                            Grid.Row="0"
                                            Margin="0,0,8,0"
                                            Height="40"
                                            Command="{Binding GenerateCommand}"
                                            IsEnabled="{Binding CanGenerate}"
                                            Theme="{StaticResource AccentOutlineButtonStyle}"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            ToolTip.Tip="Snapshots the references, prompt, continuations and every setting into the queue, and starts rendering it if nothing is on the GPU. If a take is already rendering the job waits its turn instead. Each item is frozen at this moment — change the form afterwards and the queued job is unaffected.&#10;&#10;The tab stays free while jobs render: load the next picture and Analyze it, and add that too.&#10;&#10;Whichever half of the graph an item does not use — the continuation loop, or the base-only sink — is deleted before submitting rather than switched off, because a ComfyUI output node runs whether or not anything downstream wants it.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                            <TextBlock Text="Add to Queue" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="0"
                                               Grid.Row="1"
                                               Margin="2,4,8,0"
                                               Text="{Binding GenerateBlockedReason}"
                                               FontSize="10"
                                               FontStyle="Italic"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource DangerBrush}"
                                               IsVisible="{Binding GenerateBlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <Button Grid.Column="1"
                                            Grid.Row="0"
                                            Height="40"
                                            Width="118"
                                            Margin="0,0,8,0"
                                            Command="{Binding StartQueueCommand}"
                                            Theme="{StaticResource AccentButtonStyle}"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            ToolTip.Tip="Starts rendering everything pending in the queue. Add to Queue starts a job by itself when nothing is rendering, so this is for the two cases where it does not: a queue restored when the app opened, which deliberately waits to be told, and one that was stopped part way. Greyed out while the queue is already running, and when nothing is pending.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                            <TextBlock Text="Generate" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Grid.Row="0"
                                            Height="40"
                                            Width="82"
                                            Command="{Binding CancelCommand}"
                                            Theme="{StaticResource DangerButtonStyle}"
                                            FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <!-- ─── Queue ──────────────────────────────────────────────── -->
                            <Border Grid.Row="4"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,8"
                                    IsVisible="{Binding HasQueueItems}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="⚡ Render Queue"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TabAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding QueueStatus}"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2"
                                                Content="▶ Generate"
                                                Command="{Binding StartQueueCommand}"
                                                Height="26"
                                                Padding="8,0"
                                                FontSize="11"
                                                Margin="0,0,5,0"
                                                Theme="{StaticResource AccentButtonStyle}"
                                                ToolTip.Tip="Starts rendering the pending items — the same command as the ▶ Generate button above."/>
                                        <Button Grid.Column="3"
                                                Content="🔄 Retry"
                                                Command="{Binding ReprocessAllFailedCommand}"
                                                Height="26"
                                                Padding="8,0"
                                                FontSize="11"
                                                Margin="0,0,5,0"
                                                Theme="{StaticResource AccentButtonStyle}"
                                                ToolTip.Tip="Put every failed item back to Pending and run them again."/>
                                        <Button Grid.Column="4"
                                                Content="⏹ Stop"
                                                Command="{Binding StopQueueCommand}"
                                                Height="26"
                                                Padding="8,0"
                                                FontSize="11"
                                                Margin="0,0,5,0"
                                                Theme="{StaticResource AccentButtonStyle}"
                                                ToolTip.Tip="Stop after the current item; it goes back to Pending."/>
                                        <Button Grid.Column="5"
                                                Content="🗑️ Clear"
                                                Command="{Binding ClearQueueCommand}"
                                                Height="26"
                                                Padding="8,0"
                                                FontSize="11"
                                                Theme="{StaticResource AccentButtonStyle}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Queue}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:MiniMaxI2VQueueItem">
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,5"
                                                        Margin="0,0,0,3"
                                                        Background="White">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                CornerRadius="3"
                                                                Padding="6,2"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding StatusColor}">
                                                            <TextBlock Text="{Binding StatusDisplay}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <Image Grid.Column="1"
                                                               Source="{Binding QueueThumbnail, Converter={StaticResource PathToBitmapConverter}}"
                                                               Height="34"
                                                               Stretch="Uniform"
                                                               Margin="0,0,8,0"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <!-- PromptPreview is already collapsed to one line: a six-field
                                                                     Ref2VA prompt carries its own newlines, and TextTrimming
                                                                     would ellipsize each of them separately while still
                                                                     rendering every line. Full text is on the tooltip. -->
                                                            <TextBlock Text="{Binding PromptPreview}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <ToolTip.Tip>
                                                                    <ToolTip MaxWidth="700">
                                                                        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontSize="11"/>
                                                                    </ToolTip>
                                                                </ToolTip.Tip>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding ErrorMessage}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource DangerBrush}"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="3"
                                                                Content="✕"
                                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding $parent[ItemsControl].((vmv:MiniMaxI2VViewModel)DataContext).RemoveQueueItemCommand}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center"
                                                                Width="26"
                                                                Height="26"
                                                                Padding="0"
                                                                FontSize="10"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- ─── Result Output ──────────────────────────────────────── -->
                            <Border Grid.Row="5"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="🎥 Result Video"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TabAccentBrush}"
                                               Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="200"
                                            CornerRadius="6"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Video will appear here after generation"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource PlayerTextBrush}"
                                                       FontStyle="Italic"
                                                       Classes="s51"
                                                       Classes.s51_0="{Binding !HasResult}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s51.s51_0" x:DataType="vmv:MiniMaxI2VViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vmv:MiniMaxI2VViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <ctrl:VideoPreview x:Name="MiniMaxI2VVideoPlayer"
                                                               Source="{Binding ResultVideoPath}"
                                                               Stretch="Uniform"
                                                               IsVisible="{Binding HasResult}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="▶ Play"
                                                Theme="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding PlayVideoCommand}"
                                                IsEnabled="{Binding HasResult}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="📁 Open Folder"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding OpenResultFolderCommand}"
                                                IsEnabled="{Binding HasResult}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ResultVideoInfo}" FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <!-- ─── Log ───────────────────────────────────────────────── -->
                            <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="130"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- Tab: H3 Video Editor (timeline-based video editor)               -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <TabItem Header="🎬 H3 Video Editor">
                <Grid x:DataType="vmv:H3VideoEditorViewModel" DataContext="{Binding H3VideoEditorVM}" Theme="{StaticResource TabPageStyle}">
                    <Grid.Resources>
                        <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentTealColor}"/>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ═══ LEFT PANEL: Settings & Reference Images ═══════════════════ -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Reference Images Card -->
                                <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Fill="{DynamicResource TabAccentBrush}"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="REFERENCE IMAGES"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <UniformGrid Rows="2" Columns="2" Margin="0,0,0,8">
                                            <!-- Picture 1 -->
                                            <Border Height="80"
                                                    Margin="0,0,4,4"
                                                    CornerRadius="4"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    ctrl:Click.Command="{Binding SelectPictureCommand}"
                                                    ctrl:Click.CommandParameter="0">
                                                <Grid>
                                                    <TextBlock Text="＋ Picture 1"
                                                               Foreground="{StaticResource PlayerTextBrush}"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Picture1.PreviewImage, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="UniformToFill"/>
                                                    <Button Content="✕"
                                                            Width="18"
                                                            Height="18"
                                                            Margin="2"
                                                            Padding="0"
                                                            FontSize="9"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource ScrimBrush}"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Command="{Binding ClearPictureCommand}"
                                                            CommandParameter="0"
                                                            IsVisible="{Binding Picture1.HasImages}"/>
                                                </Grid>
                                            </Border>
                                            <!-- Picture 2 -->
                                            <Border Height="80"
                                                    Margin="4,0,0,4"
                                                    CornerRadius="4"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    ctrl:Click.Command="{Binding SelectPictureCommand}"
                                                    ctrl:Click.CommandParameter="1">
                                                <Grid>
                                                    <TextBlock Text="＋ Picture 2"
                                                               Foreground="{StaticResource PlayerTextBrush}"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Picture2.PreviewImage, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="UniformToFill"/>
                                                    <Button Content="✕"
                                                            Width="18"
                                                            Height="18"
                                                            Margin="2"
                                                            Padding="0"
                                                            FontSize="9"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource ScrimBrush}"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Command="{Binding ClearPictureCommand}"
                                                            CommandParameter="1"
                                                            IsVisible="{Binding Picture2.HasImages}"/>
                                                </Grid>
                                            </Border>
                                            <!-- Picture 3 -->
                                            <Border Height="80"
                                                    Margin="0,4,4,0"
                                                    CornerRadius="4"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    ctrl:Click.Command="{Binding SelectPictureCommand}"
                                                    ctrl:Click.CommandParameter="2">
                                                <Grid>
                                                    <TextBlock Text="＋ Picture 3"
                                                               Foreground="{StaticResource PlayerTextBrush}"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Picture3.PreviewImage, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="UniformToFill"/>
                                                    <Button Content="✕"
                                                            Width="18"
                                                            Height="18"
                                                            Margin="2"
                                                            Padding="0"
                                                            FontSize="9"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource ScrimBrush}"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Command="{Binding ClearPictureCommand}"
                                                            CommandParameter="2"
                                                            IsVisible="{Binding Picture3.HasImages}"/>
                                                </Grid>
                                            </Border>
                                            <!-- Picture 4 -->
                                            <Border Height="80"
                                                    Margin="4,4,0,0"
                                                    CornerRadius="4"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    ctrl:Click.Command="{Binding SelectPictureCommand}"
                                                    ctrl:Click.CommandParameter="3">
                                                <Grid>
                                                    <TextBlock Text="＋ Picture 4"
                                                               Foreground="{StaticResource PlayerTextBrush}"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Picture4.PreviewImage, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="UniformToFill"/>
                                                    <Button Content="✕"
                                                            Width="18"
                                                            Height="18"
                                                            Margin="2"
                                                            Padding="0"
                                                            FontSize="9"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource ScrimBrush}"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Command="{Binding ClearPictureCommand}"
                                                            CommandParameter="3"
                                                            IsVisible="{Binding Picture4.HasImages}"/>
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                        <Button Content="📷 Generate Prompt from Images"
                                                Command="{Binding GeneratePromptCommand}"
                                                Height="26"
                                                FontSize="10"
                                                Theme="{StaticResource AccentButtonStyle}"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </Border>
                                <!-- Story Mode Card -->
                                <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="#FF9C27B0" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="STORY MODE"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <CheckBox Content="Enable"
                                                      IsChecked="{Binding StoryModeEnabled}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      FontSize="10"/>
                                        </Grid>
                                        <!-- Story Mode Content (visible when enabled) -->
                                        <StackPanel IsVisible="{Binding StoryModeEnabled}">
                                            <!-- Import buttons -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="📄 Import Story"
                                                        Command="{Binding ImportStoryCommand}"
                                                        Height="24"
                                                        Padding="8,0"
                                                        FontSize="10"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Cursor="Hand"
                                                        Margin="0,0,6,0"
                                                        ToolTip.Tip="Import a .txt story file"/>
                                                <Button Content="📁 Folder"
                                                        Command="{Binding ImportStoryFolderCommand}"
                                                        Height="24"
                                                        Padding="8,0"
                                                        FontSize="10"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Cursor="Hand"
                                                        ToolTip.Tip="Import all stories from a folder"/>
                                                <Button Content="✕"
                                                        Command="{Binding ClearStoryCommand}"
                                                        Width="24"
                                                        Height="24"
                                                        Padding="0"
                                                        FontSize="10"
                                                        Theme="{StaticResource DangerButtonStyle}"
                                                        Cursor="Hand"
                                                        Margin="6,0,0,0"
                                                        ToolTip.Tip="Clear story"
                                                        IsVisible="{Binding HasStory}"/>
                                            </StackPanel>
                                            <!-- Story file info -->
                                            <TextBlock Text="{Binding StoryFileName}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,8"
                                                       IsVisible="{Binding HasStory}"/>
                                            <!-- Target Duration -->
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="Target Duration (seconds)"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,3"/>
                                                <Grid>
                                                    <Slider Value="{Binding TargetDurationSeconds}"
                                                            Minimum="10"
                                                            Maximum="300"
                                                            TickFrequency="5"
                                                            IsSnapToTickEnabled="True"/>
                                                    <Border HorizontalAlignment="Right"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2">
                                                        <TextBlock Text="{Binding TargetDurationSeconds, StringFormat={}{0:0}s}"
                                                                   FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FF9C27B0"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                            <!-- Cast Options -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <CheckBox Content="Auto-gen cast"
                                                          IsChecked="{Binding AutoGenerateCast}"
                                                          FontSize="10"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="Automatically generate cast photos if slots are empty"/>
                                                <ComboBox SelectedValue="{Binding CastPhotoEngine}"
                                                          Width="90"
                                                          Height="22"
                                                          FontSize="9"
                                                          Margin="8,0,0,0"
                                                          ToolTip.Tip="Cast photo generation engine">
                                                    <x:String>qwen21</x:String>
                                                    <x:String>krea2spicy</x:String>
                                                    <x:String>krea2</x:String>
                                                    <x:String>ideogram</x:String>
                                                    <x:String>qwen</x:String>
                                                    <x:String>klein</x:String>
                                                    <x:String>zimage</x:String>
                                                    <x:String>famegrid</x:String>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Status -->
                                            <TextBlock Text="{Binding StoryStatus}"
                                                       FontSize="9"
                                                       Foreground="#FF9C27B0"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"
                                                       IsVisible="{Binding StoryStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <!-- Action buttons -->
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="🔍 Analyze Story"
                                                        Command="{Binding AnalyzeStoryCommand}"
                                                        Height="26"
                                                        Padding="10,0"
                                                        FontSize="10"
                                                        Theme="{StaticResource AccentButtonStyle}"
                                                        Cursor="Hand"
                                                        Margin="0,0,6,0"
                                                        ToolTip.Tip="Detect characters, break the story into beats, then populate the timeline, generate every clip, upscale each clip and join them. A queued folder runs each story in turn."/>
                                                <Button Content="📋 Populate Timeline"
                                                        Command="{Binding PopulateTimelineCommand}"
                                                        Height="26"
                                                        Padding="10,0"
                                                        FontSize="10"
                                                        Theme="{StaticResource SuccessButtonStyle}"
                                                        Cursor="Hand"
                                                        ToolTip.Tip="Generate clips and add to timeline"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Prompt Card -->
                                <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7"
                                                         Height="7"
                                                         Fill="{DynamicResource TabAccentBrush}"
                                                         Margin="0,0,7,0"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="PROMPT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Apply to Selected"
                                                        Command="{Binding ApplyPromptToSelectedCommand}"
                                                        Height="22"
                                                        Padding="8,0"
                                                        FontSize="10"
                                                        Theme="{StaticResource SuccessButtonStyle}"
                                                        Cursor="Hand"
                                                        ToolTip.Tip="Apply this prompt to the selected clip"
                                                        Margin="0,0,6,0"/>
                                                <Button Content="📝 Template"
                                                        Command="{Binding InsertTemplateCommand}"
                                                        Height="22"
                                                        Padding="8,0"
                                                        FontSize="10"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Cursor="Hand"
                                                        ToolTip.Tip="Insert the spec prompt template"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBox Text="{Binding PromptText}"
                                                 Height="140"
                                                 FontSize="10"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Padding="6"
                                                 ToolTip.Tip="The prompt for video generation. Use the spec format with subject_definitions, detailed_description, etc."/>
                                    </StackPanel>
                                </Border>
                                <!-- Presets Card -->
                                <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Fill="{DynamicResource TabAccentBrush}"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="PRESET" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding Presets}"
                                                  DisplayMemberBinding="{ReflectionBinding Name}"
                                                  SelectedValueBinding="{ReflectionBinding Name}"
                                                  SelectedValue="{Binding SelectedPresetName}"
                                                  Height="28"
                                                  FontSize="11"
                                                  Margin="0,0,0,10"
                                                  ToolTip.Tip="Select a preset configuration"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Steps" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                                <Grid>
                                                    <Slider Value="{Binding Steps}"
                                                            Minimum="1"
                                                            Maximum="50"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"/>
                                                    <Border HorizontalAlignment="Right"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2">
                                                        <TextBlock Text="{Binding Steps}"
                                                                   FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Sampler"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,3"/>
                                                <ComboBox ItemsSource="{Binding SamplerOptions}"
                                                          SelectedValue="{Binding SelectedSampler}"
                                                          Height="26"
                                                          FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- Upscale Settings Card -->
                                <Border Theme="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Fill="{DynamicResource TabAccentBrush}"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="UPSCALE SETTINGS"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Upscale Factor"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,3"/>
                                                <ComboBox SelectedValue="{Binding UpscaleFactor}" Height="26" FontSize="10">
                                                    <x:Double>1.5</x:Double>
                                                    <x:Double>2.0</x:Double>
                                                    <x:Double>2.5</x:Double>
                                                    <x:Double>3.0</x:Double>
                                                    <x:Double>4.0</x:Double>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Refine Amount"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,3"/>
                                                <Grid>
                                                    <Slider Value="{Binding RefineAmount}"
                                                            Minimum="0"
                                                            Maximum="1"
                                                            TickFrequency="0.05"
                                                            IsSnapToTickEnabled="True"/>
                                                    <Border HorizontalAlignment="Right"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2">
                                                        <TextBlock Text="{Binding RefineAmount, StringFormat={}{0:0.00}}"
                                                                   FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Crossfade" IsChecked="{Binding Crossfade}" FontSize="11" Margin="0,0,12,0"/>
                                            <CheckBox Content="Level Lock" IsChecked="{Binding LevelLock}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <!-- ═══ RIGHT PANEL: Preview & Timeline (DaVinci-style) ═════════════ -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" MaxHeight="160"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Project Header - Compact -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="10,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="💾"
                                            Command="{Binding SaveProjectCommand}"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            FontSize="12"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Cursor="Hand"
                                            ToolTip.Tip="Save Project (.h3proj)"
                                            Margin="0,0,4,0"/>
                                    <Button Content="📂"
                                            Command="{Binding LoadProjectCommand}"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            FontSize="12"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Cursor="Hand"
                                            ToolTip.Tip="Load Project (.h3proj)"
                                            Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding ProjectFolder}"
                                             Width="120"
                                             Height="24"
                                             FontSize="10"
                                             VerticalContentAlignment="Center"
                                             ToolTip.Tip="Project folder name"/>
                                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,0"/>
                                    <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                              SelectedValue="{Binding SelectedAspectRatio}"
                                              Width="130"
                                              Height="24"
                                              FontSize="10"
                                              ToolTip.Tip="Aspect ratio"/>
                                    <ComboBox SelectedValue="{Binding Megapixels}"
                                              Width="60"
                                              Height="24"
                                              FontSize="10"
                                              Margin="6,0,0,0"
                                              ToolTip.Tip="Megapixels">
                                        <x:Double>0.3</x:Double>
                                        <x:Double>0.5</x:Double>
                                        <x:Double>0.7</x:Double>
                                        <x:Double>1.0</x:Double>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ProgressBar Value="{Binding Progress}"
                                                 Width="120"
                                                 Height="6"
                                                 Margin="0,0,10,0"
                                                 Foreground="{DynamicResource TabAccentBrush}"/>
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- ═══ VIDEO PREVIEW (Main Area) ═══════════════════════════════════ -->
                        <Border Grid.Row="1" Background="#1a1a1a" Margin="8,6,8,0" CornerRadius="4">
                            <Grid>
                                <!-- Placeholder text when no video -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="48" Foreground="#333" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Video Preview" Foreground="#444" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                                <!-- Actual video player -->
                                <ctrl:VideoPreview x:Name="H3EditorVideoPlayer"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding PreviewVideoPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   MediaOpened="H3EditorPlayer_MediaOpened"
                                                   MediaEnded="H3EditorPlayer_MediaEnded"
                                                   MediaFailed="H3EditorPlayer_MediaFailed"/>
                            </Grid>
                        </Border>
                        <!-- ═══ TRANSPORT & TIMELINE CONTROLS ═══════════════════════════════ -->
                        <Border Grid.Row="2" Background="#252525" Padding="8,6" Margin="8,4,8,0" CornerRadius="4,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Playback controls -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="|◀"
                                            Width="26"
                                            Height="22"
                                            FontSize="9"
                                            FontFamily="Noto Color Emoji, Noto Sans Symbols 2, DejaVu Sans"
                                            Background="#3d3d3d"
                                            Foreground="#aaa"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="Previous clip"
                                            Margin="0,0,2,0"
                                            Classes="t52">
                                        <Button.Styles>
                                            <Style Selector="Button.t52:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <Button Content="▶"
                                            Width="30"
                                            Height="22"
                                            FontSize="12"
                                            FontFamily="Noto Color Emoji, Noto Sans Symbols 2, DejaVu Sans"
                                            Background="#3d3d3d"
                                            Foreground="#ddd"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="Play/Pause"
                                            Margin="0,0,2,0"
                                            Classes="t53">
                                        <Button.Styles>
                                            <Style Selector="Button.t53:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <Button Content="■"
                                            Width="26"
                                            Height="22"
                                            FontSize="10"
                                            FontFamily="Noto Color Emoji, Noto Sans Symbols 2, DejaVu Sans"
                                            Background="#3d3d3d"
                                            Foreground="#aaa"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="Stop"
                                            Margin="0,0,2,0"
                                            Classes="t54">
                                        <Button.Styles>
                                            <Style Selector="Button.t54:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <Button Content="▶|"
                                            Width="26"
                                            Height="22"
                                            FontSize="9"
                                            FontFamily="Noto Color Emoji, Noto Sans Symbols 2, DejaVu Sans"
                                            Background="#3d3d3d"
                                            Foreground="#aaa"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="Next clip"
                                            Classes="t55">
                                        <Button.Styles>
                                            <Style Selector="Button.t55:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                </StackPanel>
                                <!-- Timeline info -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimelineDurationDisplay}"
                                               FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#eee"/>
                                    <TextBlock Text=" • " Foreground="#666"/>
                                    <TextBlock Text="{Binding TimelineClips.Count, StringFormat='{}{0} clips'}" FontSize="11" Foreground="#999"/>
                                </StackPanel>
                                <!-- Timeline actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="+ Add"
                                            Height="24"
                                            Padding="8,0"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Background="#2d6a4f"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding AddClipCommand}"
                                            ToolTip.Tip="Add new clip">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <Rectangle Width="1" Fill="#444" Margin="6,4"/>
                                    <Button Content="Cut"
                                            Height="24"
                                            Padding="8,0"
                                            FontSize="10"
                                            Background="#3d3d3d"
                                            Foreground="#ccc"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding CutClipCommand}"
                                            CommandParameter="{Binding SelectedClip}"
                                            ToolTip.Tip="Cut selected clip"
                                            Margin="0,0,3,0"
                                            Classes="t56">
                                        <Button.Styles>
                                            <Style Selector="Button.t56:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <Button Content="+ Before"
                                            Height="24"
                                            Padding="8,0"
                                            FontSize="10"
                                            Background="#3d3d3d"
                                            Foreground="#ccc"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding PrependClipCommand}"
                                            ToolTip.Tip="Insert clip before selection"
                                            Margin="0,0,3,0"
                                            Classes="t57">
                                        <Button.Styles>
                                            <Style Selector="Button.t57:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <Button Content="+ After"
                                            Height="24"
                                            Padding="8,0"
                                            FontSize="10"
                                            Background="#3d3d3d"
                                            Foreground="#ccc"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding AppendClipCommand}"
                                            ToolTip.Tip="Insert clip after selection"
                                            Margin="0,0,3,0"
                                            Classes="t58">
                                        <Button.Styles>
                                            <Style Selector="Button.t58:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <Button Content="Extend"
                                            Height="24"
                                            Padding="8,0"
                                            FontSize="10"
                                            Background="#3d3d3d"
                                            Foreground="#ccc"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding ExtendClipCommand}"
                                            CommandParameter="{Binding SelectedClip}"
                                            ToolTip.Tip="Extend clip duration"
                                            Classes="t59">
                                        <Button.Styles>
                                            <Style Selector="Button.t59:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- ═══ TIMELINE (Horizontal Strip with Clips) ══════════════════════ -->
                        <Border Grid.Row="3" Background="#1e1e1e" Margin="8,0,8,0" CornerRadius="0,0,4,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="80"/>
                                </Grid.RowDefinitions>
                                <!-- Timeline ruler -->
                                <Border Grid.Row="0" Background="#252525" BorderBrush="#333" BorderThickness="0,0,0,1">
                                    <Canvas>
                                        <!-- Time markers will be generated dynamically, showing placeholder ticks -->
                                        <TextBlock Text="0:00" FontSize="9" Foreground="#666" Canvas.Left="4" Canvas.Top="3"/>
                                        <Rectangle Width="1" Height="8" Fill="#444" Canvas.Left="60" Canvas.Top="10"/>
                                        <TextBlock Text="0:05" FontSize="9" Foreground="#666" Canvas.Left="64" Canvas.Top="3"/>
                                        <Rectangle Width="1" Height="8" Fill="#444" Canvas.Left="120" Canvas.Top="10"/>
                                        <TextBlock Text="0:10" FontSize="9" Foreground="#666" Canvas.Left="124" Canvas.Top="3"/>
                                        <Rectangle Width="1" Height="8" Fill="#444" Canvas.Left="180" Canvas.Top="10"/>
                                        <TextBlock Text="0:15" FontSize="9" Foreground="#666" Canvas.Left="184" Canvas.Top="3"/>
                                        <Rectangle Width="1" Height="8" Fill="#444" Canvas.Left="240" Canvas.Top="10"/>
                                        <TextBlock Text="0:20" FontSize="9" Foreground="#666" Canvas.Left="244" Canvas.Top="3"/>
                                        <Rectangle Width="1" Height="8" Fill="#444" Canvas.Left="300" Canvas.Top="10"/>
                                        <TextBlock Text="0:25" FontSize="9" Foreground="#666" Canvas.Left="304" Canvas.Top="3"/>
                                        <Rectangle Width="1" Height="8" Fill="#444" Canvas.Left="360" Canvas.Top="10"/>
                                        <TextBlock Text="0:30" FontSize="9" Foreground="#666" Canvas.Left="364" Canvas.Top="3"/>
                                    </Canvas>
                                </Border>
                                <!-- Clips track -->
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Background="#1a1a1a">
                                    <ItemsControl ItemsSource="{Binding TimelineClips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:H3TimelineClip">
                                                <!-- Clip block - width based on duration (12px per second) -->
                                                <Border Height="72"
                                                        Margin="1,2"
                                                        CornerRadius="3"
                                                        Cursor="Hand"
                                                        BorderThickness="1"
                                                        ToolTip.Tip="{Binding ClipSummary}"
                                                        Classes="s60"
                                                        Classes.s60_0="{Binding IsSelected}"
                                                        Classes.s60_1="{Binding IsRendered}"
                                                        Classes.s60_2="{Binding IsRendering}"
                                                        Classes.s60_3="{Binding IsFailed}"
                                                        ctrl:Click.Command="{Binding $parent[ItemsControl].((vmv:H3VideoEditorViewModel)DataContext).SelectClipCommand}"
                                                        ctrl:Click.CommandParameter="{Binding}"
                                                        ctrl:Click.DoubleCommand="{Binding $parent[ItemsControl].((vmv:H3VideoEditorViewModel)DataContext).EditClipPromptCommand}"
                                                        ctrl:Click.DoubleCommandParameter="{Binding}">
                                                    <Border.Styles>
                                                        <Style Selector="Border.s60.s60_0" x:DataType="m:H3TimelineClip">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentTealBrush}"/>
                                                            <Setter Property="Background" Value="#353535"/>
                                                        </Style>
                                                        <Style Selector="Border.s60.s60_1" x:DataType="m:H3TimelineClip">
                                                            <Setter Property="Background" Value="#1a3d1a"/>
                                                            <Setter Property="BorderBrush" Value="#2a5a2a"/>
                                                        </Style>
                                                        <Style Selector="Border.s60.s60_2" x:DataType="m:H3TimelineClip">
                                                            <Setter Property="BorderBrush" Value="#e0a030"/>
                                                        </Style>
                                                        <Style Selector="Border.s60.s60_3" x:DataType="m:H3TimelineClip">
                                                            <Setter Property="BorderBrush" Value="#c04040"/>
                                                        </Style>
                                                    </Border.Styles>
                                                    <Border.Width>
                                                        <Binding Path="DurationSeconds">
                                                            <Binding.Converter>
                                                                <conv:DurationToWidthConverter MinWidth="60"/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Border.Width>
                                                    <Border.Theme>
                                                        <ControlTheme TargetType="Border" x:DataType="m:H3TimelineClip">
                                                            <Setter Property="Background" Value="#2d2d2d"/>
                                                            <Setter Property="BorderBrush" Value="#3d3d3d"/>
                                                        </ControlTheme>
                                                    </Border.Theme>
                                                    <Grid Margin="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- Thumbnail/Preview area -->
                                                        <Grid Grid.Row="0" Background="#222">
                                                            <!-- Video preview loop -->
                                                            <ctrl:VideoPreview Source="{Binding PreviewVideoPath}"
                                                                               Stretch="UniformToFill"
                                                                               IsMuted="True"
                                                                               MediaEnded="TimelineClipVideo_MediaEnded"
                                                                               MediaFailed="TimelineClipVideo_MediaFailed"
                                                                               Classes="s61"
                                                                               Classes.s61_0="{Binding HasVideoPreview}">
                                                                <ctrl:VideoPreview.Styles>
                                                                    <Style Selector="ctrl|VideoPreview.s61.s61_0" x:DataType="m:H3TimelineClip">
                                                                        <Setter Property="IsVisible" Value="True"/>
                                                                    </Style>
                                                                </ctrl:VideoPreview.Styles>
                                                                <ctrl:VideoPreview.Theme>
                                                                    <ControlTheme TargetType="ctrl:VideoPreview" x:DataType="m:H3TimelineClip">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </ControlTheme>
                                                                </ctrl:VideoPreview.Theme>
                                                            </ctrl:VideoPreview>
                                                            <!-- Thumbnail image fallback -->
                                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToBitmapConverter}}"
                                                                   Stretch="UniformToFill"
                                                                   Classes="s62"
                                                                   Classes.s62_0="{Binding HasVideoPreview}"
                                                                   Classes.s62_1="{Binding ThumbnailPath, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                                <Image.Styles>
                                                                    <Style Selector="Image.s62.s62_0" x:DataType="m:H3TimelineClip">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </Style>
                                                                    <Style Selector="Image.s62.s62_1" x:DataType="m:H3TimelineClip">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </Style>
                                                                </Image.Styles>
                                                                <Image.Theme>
                                                                    <ControlTheme TargetType="Image" x:DataType="m:H3TimelineClip">
                                                                        <Setter Property="IsVisible" Value="True"/>
                                                                    </ControlTheme>
                                                                </Image.Theme>
                                                            </Image>
                                                            <!-- Clip number placeholder -->
                                                            <TextBlock Text="{Binding DisplayIndex}"
                                                                       FontSize="18"
                                                                       FontWeight="Bold"
                                                                       Foreground="#444"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Classes="s63"
                                                                       Classes.s63_0="{Binding !HasVideoPreview}"
                                                                       Classes.s63_1="{Binding ThumbnailPath, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                                <TextBlock.Styles>
                                                                    <Style Selector="TextBlock.s63.s63_0.s63_1" x:DataType="m:H3TimelineClip">
                                                                        <Setter Property="IsVisible" Value="True"/>
                                                                    </Style>
                                                                </TextBlock.Styles>
                                                                <TextBlock.Theme>
                                                                    <ControlTheme TargetType="TextBlock" x:DataType="m:H3TimelineClip">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </ControlTheme>
                                                                </TextBlock.Theme>
                                                            </TextBlock>
                                                            <!-- State badge: queued / rendering / failed -->
                                                            <Border Background="#CC000000"
                                                                    CornerRadius="2"
                                                                    Padding="4,1"
                                                                    Margin="2"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    IsVisible="{Binding IsRendering}">
                                                                <TextBlock Text="⏳ rendering..." FontSize="9" FontWeight="SemiBold" Foreground="#e0a030"/>
                                                            </Border>
                                                            <Border Background="#CC000000"
                                                                    CornerRadius="2"
                                                                    Padding="4,1"
                                                                    Margin="2"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    IsVisible="{Binding IsQueued}">
                                                                <TextBlock Text="queued" FontSize="9" Foreground="#aaa"/>
                                                            </Border>
                                                            <Border Background="#CC000000"
                                                                    CornerRadius="2"
                                                                    Padding="4,1"
                                                                    Margin="2"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    IsVisible="{Binding IsFailed}">
                                                                <TextBlock Text="✕ failed" FontSize="9" FontWeight="SemiBold" Foreground="#e06060"/>
                                                            </Border>
                                                        </Grid>
                                                        <!-- Bottom info bar -->
                                                        <Border Grid.Row="1" Background="#252525" Padding="2,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding DurationDisplay}"
                                                                           FontSize="8"
                                                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                                           Foreground="#888"
                                                                           VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                    <Button Content="↻"
                                                                            Width="14"
                                                                            Height="14"
                                                                            Padding="0"
                                                                            FontSize="9"
                                                                            FontFamily="Noto Color Emoji, Noto Sans Symbols 2, DejaVu Sans"
                                                                            Theme="{StaticResource SecondaryButtonStyle}"
                                                                            Cursor="Hand"
                                                                            Command="{Binding $parent[ItemsControl].((vmv:H3VideoEditorViewModel)DataContext).RegenerateClipCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="Regenerate"
                                                                            Margin="0,0,1,0"/>
                                                                    <Button Content="×"
                                                                            Width="14"
                                                                            Height="14"
                                                                            Padding="0"
                                                                            FontSize="10"
                                                                            Theme="{StaticResource DangerButtonStyle}"
                                                                            Cursor="Hand"
                                                                            Command="{Binding $parent[ItemsControl].((vmv:H3VideoEditorViewModel)DataContext).RemoveClipCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="Remove"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <!-- ═══ CLIP ACTIONS EDITOR (Editable text for selected clip) ═══════ -->
                        <Border Grid.Row="4"
                                Background="#1e1e1e"
                                Margin="8,4,8,0"
                                CornerRadius="4"
                                Padding="8"
                                IsVisible="{Binding SelectedClip, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Clip " FontSize="10" FontWeight="Bold" Foreground="#888"/>
                                    <TextBlock Text="{Binding SelectedClip.DisplayIndex}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                    <TextBlock Text=" Actions" FontSize="10" FontWeight="Bold" Foreground="#888"/>
                                    <TextBlock Text=" — " FontSize="10" Foreground="#555"/>
                                    <TextBlock Text="{Binding SelectedClip.DurationDisplay}"
                                               FontSize="10"
                                               FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                               Foreground="#666"/>
                                </StackPanel>
                                <TextBox Grid.Row="1"
                                         Text="{Binding SelectedClip.ClipActions, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Height="80"
                                         MaxHeight="120"
                                         FontSize="11"
                                         FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                         Background="#252525"
                                         Foreground="#ccc"
                                         BorderBrush="#3d3d3d"
                                         BorderThickness="1"
                                         Padding="6"
                                         ToolTip.Tip="Edit the shot-by-shot actions for this clip. Changes are saved automatically."/>
                            </Grid>
                        </Border>
                        <!-- ═══ ACTION BAR (Compact) ════════════════════════════════════════ -->
                        <Border Grid.Row="5" Background="#252525" Padding="8,6" Margin="8,4,8,8" CornerRadius="4">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Generate - primary action with subtle green -->
                                    <Button Content="{Binding GenerateButtonText}"
                                            Command="{Binding GenerateClipsCommand}"
                                            Height="28"
                                            Padding="14,0"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Background="#2d6a4f"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,6,0"
                                            ToolTip.Tip="Generate all pending clips"
                                            Classes="t64">
                                        <Button.Styles>
                                            <Style Selector="Button.t64:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#3d8060"/>
                                            </Style>
                                            <Style Selector="Button.t64:disabled">
                                                <Setter Property="Foreground" Value="#666"/>
                                                <Style Selector="^ /template/ Border#Bd">
                                                    <Setter Property="Background" Value="#3d3d3d"/>
                                                </Style>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <!-- Join - secondary with neutral dark -->
                                    <Button Content="Join Clips"
                                            Command="{Binding JoinClipsCommand}"
                                            Height="28"
                                            Padding="14,0"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Background="#3d3d3d"
                                            Foreground="#ddd"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,6,0"
                                            ToolTip.Tip="Join all rendered clips into one video"
                                            Classes="t65">
                                        <Button.Styles>
                                            <Style Selector="Button.t65:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                            <Style Selector="Button.t65:disabled">
                                                <Setter Property="Foreground" Value="#555"/>
                                                <Style Selector="^ /template/ Border#Bd">
                                                    <Setter Property="Background" Value="#2d2d2d"/>
                                                </Style>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <!-- Upscale - tertiary action -->
                                    <Button Content="Upscale"
                                            Command="{Binding UpscaleCommand}"
                                            Height="28"
                                            Padding="14,0"
                                            FontSize="11"
                                            Background="#3d3d3d"
                                            Foreground="#bbb"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="Upscale joined video"
                                            Classes="t66">
                                        <Button.Styles>
                                            <Style Selector="Button.t66:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                            <Style Selector="Button.t66:disabled">
                                                <Setter Property="Foreground" Value="#555"/>
                                                <Style Selector="^ /template/ Border#Bd">
                                                    <Setter Property="Background" Value="#2d2d2d"/>
                                                </Style>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Progress indicator -->
                                    <ProgressBar Value="{Binding Progress}"
                                                 Width="100"
                                                 Height="4"
                                                 Margin="0,0,12,0"
                                                 Background="#333"
                                                 Foreground="#2d6a4f"/>
                                    <!-- Log toggle -->
                                    <ToggleButton x:Name="LogToggle"
                                                  IsChecked="{Binding IsLogOpen, Mode=TwoWay}"
                                                  Content="Log"
                                                  Height="24"
                                                  Padding="10,0"
                                                  FontSize="10"
                                                  Background="#3d3d3d"
                                                  Foreground="#aaa"
                                                  BorderThickness="0"
                                                  Cursor="Hand"
                                                  ToolTip.Tip="Toggle log panel"
                                                  Classes="t67">
                                        <ToggleButton.Styles>
                                            <Style Selector="ToggleButton.t67:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#4d4d4d"/>
                                            </Style>
                                            <Style Selector="ToggleButton.t67:checked">
                                                <Setter Property="Foreground" Value="#fff"/>
                                                <Style Selector="^ /template/ Border#Bd">
                                                    <Setter Property="Background" Value="#4a4a4a"/>
                                                </Style>
                                            </Style>
                                        </ToggleButton.Styles>
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <ToggleButton.Theme>
                                            <ControlTheme TargetType="ToggleButton"/>
                                        </ToggleButton.Theme>
                                    </ToggleButton>
                                    <!-- Cancel -->
                                    <Button Content="Cancel"
                                            Command="{Binding CancelCommand}"
                                            Height="24"
                                            Padding="10,0"
                                            FontSize="10"
                                            Background="#5c3030"
                                            Foreground="#eaa"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="6,0,0,0"
                                            ToolTip.Tip="Cancel current operation"
                                            Classes="t68">
                                        <Button.Styles>
                                            <Style Selector="Button.t68:pointerover /template/ Border#Bd">
                                                <Setter Property="Background" Value="#7c4040"/>
                                            </Style>
                                            <Style Selector="Button.t68:disabled">
                                                <Setter Property="Foreground" Value="#666"/>
                                                <Style Selector="^ /template/ Border#Bd">
                                                    <Setter Property="Background" Value="#3d3d3d"/>
                                                </Style>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <!-- Status (visible next to the buttons, not just in the top bar) -->
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#8fd3b0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="360"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <!-- ═══ COLLAPSIBLE LOG PANEL (Overlay) ═════════════════════════════ -->
                    <Border Grid.Column="1"
                            Background="{StaticResource SurfaceBrush}"
                            CornerRadius="4"
                            Margin="8,0,8,54"
                            Padding="8"
                            VerticalAlignment="Bottom"
                            MaxHeight="150"
                            IsVisible="{Binding IsChecked, ElementName=LogToggle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="LOG"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Copy"
                                            Command="{Binding CopyLogCommand}"
                                            Height="18"
                                            Padding="6,0"
                                            FontSize="8"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Cursor="Hand"
                                            Margin="0,0,4,0"/>
                                    <Button Content="Clear"
                                            Command="{Binding ClearLogCommand}"
                                            Height="18"
                                            Padding="6,0"
                                            FontSize="8"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Background="#1a1a1a" CornerRadius="2" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                                    <ItemsControl ItemsSource="{Binding LogMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                           FontSize="9"
                                                           Foreground="#888"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- Tab: H3 Batch Upscale (batch upscale preview videos)             -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <TabItem Header="⬆️ H3 Batch Upscale">
                <Grid x:DataType="vmv:H3BatchUpscaleViewModel"
                      x:Name="H3BatchUpscaleRoot"
                      DataContext="{Binding H3BatchUpscaleVM}"
                      Theme="{StaticResource TabPageStyle}">
                    <Grid.Resources>
                        <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentCyanColor}"/>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ═══ Left Panel: Settings ════════════════════════════════════ -->
                    <Border Grid.Column="0" Theme="{StaticResource SectionCardStyle}" Margin="10,8,6,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="⬆️ H3 Batch Upscale" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TabAccentBrush}"/>
                                <TextBlock Text="Batch upscale H3 preview videos using H3 Latent Upscaler. Select videos from the browser and upscale them all at once."
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- ─── Folder Selection ────────────────────────── -->
                                    <TextBlock Text="Folder to scan"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ScanFolder, UpdateSourceTrigger=LostFocus}"
                                             FontSize="10"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             Height="26"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,0,4"
                                             ToolTip.Tip="Folder containing H3 preview videos (MP4 files). Typically the output folder from H3 Video Editor."/>
                                    <WrapPanel Margin="0,0,0,6">
                                        <Button Content="📂 Browse"
                                                Command="{Binding BrowseFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Height="26"
                                                Padding="10,0"
                                                FontSize="11"
                                                Margin="0,0,5,0"/>
                                        <Button Content="🔄 Rescan"
                                                Command="{Binding RescanCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Height="26"
                                                Padding="10,0"
                                                FontSize="11"
                                                Margin="0,0,5,0"/>
                                        <Button Content="↗"
                                                Command="{Binding OpenScanFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Width="30"
                                                Height="26"
                                                Padding="0"
                                                FontSize="11"
                                                ToolTip.Tip="Open this folder in Explorer."/>
                                    </WrapPanel>
                                    <CheckBox Content="Include subfolders"
                                              IsChecked="{Binding IncludeSubfolders}"
                                              FontSize="11"
                                              Margin="0,0,0,4"
                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <CheckBox Content="Hide already upscaled"
                                              IsChecked="{Binding HideAlreadyUpscaled}"
                                              FontSize="11"
                                              Margin="0,0,0,8"
                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Search"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FilterText}"
                                             FontSize="11"
                                             Height="26"
                                             Padding="6,0"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,0,10"/>
                                    <Separator Margin="0,0,0,10"/>
                                    <!-- ─── Upscale Settings ────────────────────────── -->
                                    <TextBlock Text="UPSCALE SETTINGS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TabAccentBrush}"
                                               Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Upscale Factor"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding UpscaleFactor, StringFormat={}{0:F1}}"
                                                 FontSize="11"
                                                 Height="26"
                                                 Padding="6,0"
                                                 HorizontalContentAlignment="Center"
                                                 ToolTip.Tip="Scale multiplier (e.g. 2.0 = 2x resolution)"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Refine Amount"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding RefineAmount, StringFormat={}{0:F2}}"
                                                 FontSize="11"
                                                 Height="26"
                                                 Padding="6,0"
                                                 HorizontalContentAlignment="Center"
                                                 ToolTip.Tip="Denoise amount for the refine pass (0-1). Lower keeps closer to original."/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Shift Video"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ShiftVideo}"
                                                 FontSize="11"
                                                 Height="26"
                                                 Padding="6,0"
                                                 HorizontalContentAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Shift Audio"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ShiftAudio}"
                                                 FontSize="11"
                                                 Height="26"
                                                 Padding="6,0"
                                                 HorizontalContentAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="CRF (Quality)"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Crf}"
                                                 FontSize="11"
                                                 Height="26"
                                                 Padding="6,0"
                                                 HorizontalContentAlignment="Center"
                                                 ToolTip.Tip="Video quality (lower = higher quality). Default: 19"/>
                                    </Grid>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding SelectionSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- ─── Actions ─────────────────────────────────────────── -->
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <ProgressBar Value="{Binding Progress}" Height="4" Margin="0,0,0,8" IsVisible="{Binding IsUpscaling}"/>
                                <Button Content="⬆️ Upscale Selected"
                                        Command="{Binding UpscaleSelectedCommand}"
                                        Theme="{StaticResource AccentButtonStyle}"
                                        Height="34"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Margin="0,0,0,5"/>
                                <Button Content="⏹ Stop"
                                        Command="{Binding StopUpscaleCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Height="26"
                                        FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- ═══ Right Panel: Video Browser ══════════════════════════════ -->
                    <Grid Grid.Column="1" Margin="0,8,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- ─── Browser Header ──────────────────────────────────────── -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VIDEO BROWSER" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}"/>
                                <TextBlock Text="{Binding ScanStatus}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="☑ All"
                                        Command="{Binding SelectAllCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Height="26"
                                        Padding="10,0"
                                        FontSize="11"
                                        Margin="0,0,5,0"/>
                                <Button Content="☐ None"
                                        Command="{Binding SelectNoneCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Height="26"
                                        Padding="10,0"
                                        FontSize="11"
                                        Margin="0,0,5,0"/>
                                <Button Content="⇄ Invert"
                                        Command="{Binding InvertSelectionCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Height="26"
                                        Padding="10,0"
                                        FontSize="11"
                                        Margin="0,0,10,0"/>
                                <Button Content="➖"
                                        Command="{Binding ZoomTilesOutCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Width="28"
                                        Height="26"
                                        Padding="0"
                                        FontSize="11"
                                        Margin="0,0,4,0"/>
                                <Button Content="➕"
                                        Command="{Binding ZoomTilesInCommand}"
                                        Theme="{StaticResource SecondaryButtonStyle}"
                                        Width="28"
                                        Height="26"
                                        Padding="0"
                                        FontSize="11"/>
                            </StackPanel>
                        </Grid>
                        <!-- ─── Video Grid ──────────────────────────────────────────── -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="340"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Margin="0,0,6,0">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="20,0"
                                               FontStyle="Italic"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="No videos found. Browse to a folder containing H3 preview videos (MP4 files)."
                                               Classes="s69"
                                               Classes.s69_0="{Binding !HasItems}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.s69.s69_0" x:DataType="vmv:H3BatchUpscaleViewModel">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </Style>
                                        </TextBlock.Styles>
                                        <TextBlock.Theme>
                                            <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3BatchUpscaleViewModel">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </ControlTheme>
                                        </TextBlock.Theme>
                                    </TextBlock>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8" IsVisible="{Binding HasItems}">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:H3BatchUpscaleItem">
                                                    <Border Width="{Binding #H3BatchUpscaleRoot.((vmv:H3BatchUpscaleViewModel)DataContext).TileSize}"
                                                            Margin="4"
                                                            CornerRadius="4"
                                                            Cursor="Hand"
                                                            BorderThickness="2"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            Classes="s70"
                                                            Classes.s70_0="{Binding IsSelected}"
                                                            Classes.s70_1="{Binding HasUpscale}"
                                                            ctrl:Click.Command="{Binding ToggleCommand}"
                                                            ctrl:Click.DoubleCommand="{Binding PlayCommand}"
                                                            ctrl:Click.RightCommand="{Binding RevealCommand}">
                                                        <Border.Styles>
                                                            <Style Selector="Border.s70.s70_0" x:DataType="m:H3BatchUpscaleItem">
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                            </Style>
                                                            <Style Selector="Border.s70.s70_1" x:DataType="m:H3BatchUpscaleItem">
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}"/>
                                                            </Style>
                                                        </Border.Styles>
                                                        <Border.Theme>
                                                            <ControlTheme TargetType="Border" x:DataType="m:H3BatchUpscaleItem">
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                            </ControlTheme>
                                                        </Border.Theme>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <!-- Thumbnail -->
                                                            <Border Grid.Row="0"
                                                                    Height="{Binding #H3BatchUpscaleRoot.((vmv:H3BatchUpscaleViewModel)DataContext).TileSize}"
                                                                    CornerRadius="4,4,0,0"
                                                                    Background="#1a1a1a">
                                                                <Grid>
                                                                    <Image Source="{Binding Thumbnail, Converter={StaticResource PathToBitmapConverter}}"
                                                                           Stretch="UniformToFill"/>
                                                                    <TextBlock Text="🎬"
                                                                               FontSize="20"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="#444"
                                                                               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                                    <Border Background="#80000000"
                                                                            CornerRadius="2"
                                                                            Padding="4,2"
                                                                            Margin="4"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            IsVisible="{Binding IsSelected}">
                                                                        <TextBlock Text="✓" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                    </Border>
                                                                    <Border Background="#80000000"
                                                                            CornerRadius="2"
                                                                            Padding="4,2"
                                                                            Margin="4"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            IsVisible="{Binding HasUpscale}">
                                                                        <TextBlock Text="⬆️" FontSize="8"/>
                                                                    </Border>
                                                                    <Border Background="#80000000"
                                                                            CornerRadius="2"
                                                                            Padding="4,2"
                                                                            Margin="4"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding IsBusy}">
                                                                        <TextBlock Text="{Binding Status}" FontSize="9" Foreground="White"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <!-- Info -->
                                                            <StackPanel Grid.Row="1" Margin="6,4,6,6">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Details}"
                                                                           FontSize="9"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <!-- ─── Preview Player ──────────────────────────────────── -->
                            <Border Grid.Column="1" CornerRadius="6" Background="{StaticResource PlayerSurfaceBrush}">
                                <Grid>
                                    <TextBlock Text="Click a video to preview"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding ActivePreviewUri, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <Grid IsVisible="{Binding ActivePreviewUri, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ctrl:VideoPreview Grid.Row="0"
                                                           x:Name="H3BatchUpscalePlayer"
                                                           Source="{Binding ActivePreviewUri}"
                                                           IsMuted="{Binding IsPreviewMuted}"
                                                           Stretch="Uniform"/>
                                        <Border Grid.Row="1" Background="#80000000" Padding="8,4">
                                            <Grid>
                                                <TextBlock Text="{Binding ActivePreviewLabel}"
                                                           FontSize="10"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Command="{Binding ToggleMuteCommand}"
                                                        HorizontalAlignment="Right"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Width="28"
                                                        Height="24"
                                                        Padding="0"
                                                        FontSize="12">
                                                    <Button.Content>
                                                        <TextBlock Text="🔇" Classes="s71" Classes.s71_0="{Binding IsPreviewMuted}">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock.s71.s71_0" x:DataType="vmv:H3BatchUpscaleViewModel">
                                                                    <Setter Property="Text" Value="🔇"/>
                                                                </Style>
                                                            </TextBlock.Styles>
                                                            <TextBlock.Theme>
                                                                <ControlTheme TargetType="TextBlock" x:DataType="vmv:H3BatchUpscaleViewModel">
                                                                    <Setter Property="Text" Value="🔊"/>
                                                                </ControlTheme>
                                                            </TextBlock.Theme>
                                                        </TextBlock>
                                                    </Button.Content>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <!-- ─── Log Panel ───────────────────────────────────────────── -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Margin="0,6,0,0" Padding="8" MaxHeight="120">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="LOG"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Copy"
                                                Command="{Binding CopyLogCommand}"
                                                Height="18"
                                                Padding="6,0"
                                                FontSize="8"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,4,0"/>
                                        <Button Content="Clear"
                                                Command="{Binding ClearLogCommand}"
                                                Height="18"
                                                Padding="6,0"
                                                FontSize="8"
                                                Theme="{StaticResource SecondaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="#1a1a1a" CornerRadius="2" Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="80">
                                        <ItemsControl ItemsSource="{Binding LogMessages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <TextBlock Text="{Binding}"
                                                               FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                               FontSize="9"
                                                               Foreground="#888"
                                                               TextWrapping="NoWrap"
                                                               Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Height="28">
            <DockPanel LastChildFill="False">
                <ContentControl>
                    <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
                </ContentControl>
                <ContentControl HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text=":" FontSize="11"/>
                        <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </ContentControl>
            </DockPanel>
        </Border>
    </Grid>
</win:AppWindow>
