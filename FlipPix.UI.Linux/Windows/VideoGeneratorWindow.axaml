<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlipPix.UI.Linux.Windows.VideoGeneratorWindow"
        Title="FlipPix - Video Generator" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="650" MinWidth="900">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" PointerPressed="Header_PointerPressed" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#FF6B35" Offset="0"/>
                    <GradientStop Color="#F7931E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="25,20">
                <TextBlock Text="Video Generator" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Generate videos from images using AI - Upload an image and describe the motion"
                           FontSize="13" Foreground="#FFFAF0" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="#E9ECEF" BorderBrush="#DEE2E6" BorderThickness="0,1,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="Navigate:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="#495057"/>
                <Button Content="Image Generator" Classes="nav" Command="{Binding NavigateToImageGeneratorCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Margin="20,15,20,15">
                <TabControl>

                    <!-- ── Tab 1: FFLF (First Frame / Last Frame) ── -->
                    <TabItem Header="FFLF">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="15">

                                <!-- Workflow Selection -->
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Workflow Selection" FontSize="14" FontWeight="Bold" Foreground="#FF6B35"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="LTX2V" Classes="secondary"
                                                    Command="{Binding ToggleSingleWorkflowCommand}"
                                                    Background="{Binding UseLTX2V, Converter={StaticResource BooleanToVisibilityConverter}, TargetNullValue=#DEE2E6}"/>
                                            <Button Content="Wan 2.2" Classes="secondary"
                                                    Command="{Binding ToggleSingleWorkflowCommand}"
                                                    Background="{Binding UseWan22, Converter={StaticResource BooleanToVisibilityConverter}, TargetNullValue=#DEE2E6}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Dual Frame Input and Analysis -->
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <Grid ColumnDefinitions="*,*,*">

                                        <!-- First Frame -->
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="8">
                                            <TextBlock Text="First Frame" FontSize="13" FontWeight="Bold" Foreground="#FF6B35"/>
                                            <Border BorderBrush="#DEE2E6" BorderThickness="2" Background="White" Height="160" CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="No first frame" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#999" FontStyle="Italic"
                                                               IsVisible="{Binding !HasFirstFrameImage}"/>
                                                    <Image Source="{Binding FirstFrameImagePreview, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="Uniform" IsVisible="{Binding HasFirstFrameImage}"/>
                                                </Grid>
                                            </Border>
                                            <Button Content="Browse First Frame" Classes="secondary"
                                                    Command="{Binding SelectFirstFrameImageCommand}" Height="32" FontSize="11"/>
                                            <Button Content="Analyze First Frame" Classes="primary"
                                                    Command="{Binding AnalyzeFirstFrameImageCommand}"
                                                    IsEnabled="{Binding HasFirstFrameImage}"
                                                    Height="36" FontSize="11"/>
                                            <TextBlock Text="{Binding FirstFrameImageInfo}" FontStyle="Italic"
                                                       Foreground="#666" FontSize="9" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Last Frame -->
                                        <StackPanel Grid.Column="1" Margin="8,0" Spacing="8">
                                            <TextBlock Text="Last Frame" FontSize="13" FontWeight="Bold" Foreground="#FF6B35"/>
                                            <Border BorderBrush="#DEE2E6" BorderThickness="2" Background="White" Height="160" CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="No last frame" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#999" FontStyle="Italic"
                                                               IsVisible="{Binding !HasLastFrameImage}"/>
                                                    <Image Source="{Binding LastFrameImagePreview, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="Uniform" IsVisible="{Binding HasLastFrameImage}"/>
                                                </Grid>
                                            </Border>
                                            <Button Content="Browse Last Frame" Classes="secondary"
                                                    Command="{Binding SelectLastFrameImageCommand}" Height="32" FontSize="11"/>
                                            <TextBlock Text="{Binding LastFrameImageInfo}" FontStyle="Italic"
                                                       Foreground="#666" FontSize="9" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Analysis Result -->
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0" Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Image Analysis" FontSize="14" FontWeight="Bold" Foreground="#FF6B35" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                                                    <Button Content="Copy" Classes="nav"
                                                            Command="{Binding CopyAnalysisCommand}"
                                                            ToolTip.Tip="Copy to Clipboard"
                                                            Width="50" Height="28" Padding="0"
                                                            IsEnabled="{Binding HasAnalysis}"/>
                                                    <Button Content="Settings" Classes="nav"
                                                            Command="{Binding OpenLMStudioSettingsCommand}"
                                                            ToolTip.Tip="LM Studio Settings"
                                                            Width="60" Height="28" Padding="0"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBox Text="{Binding ImageAnalysis, Mode=TwoWay}"
                                                     TextWrapping="Wrap" AcceptsReturn="True" Height="180"
                                                     Padding="10" FontSize="11" IsReadOnly="{Binding IsAnalyzing}"/>
                                            <Border Background="#FFF9F0" BorderBrush="#FFE0B0" BorderThickness="1"
                                                    CornerRadius="5" Padding="8"
                                                    IsVisible="{Binding IsAnalyzing}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding AnalysisStatus}" FontWeight="SemiBold"
                                                               FontSize="10" TextAlignment="Center"/>
                                                    <ProgressBar Value="{Binding AnalysisProgress}" Height="12"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Content="Send to Queue" Classes="primary"
                                                    Command="{Binding SendAnalysisToQueueCommand}"
                                                    IsEnabled="{Binding HasAnalysis}"
                                                    Height="38" HorizontalAlignment="Stretch"/>

                                            <!-- Video Settings Expander -->
                                            <Expander Header="Video Settings" IsExpanded="False">
                                                <StackPanel Margin="0,10,0,0" Spacing="8">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Video Length (frames)" FontWeight="SemiBold" FontSize="11"/>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Slider Grid.Column="0" Value="{Binding VideoLength, Mode=TwoWay}"
                                                                    Minimum="21" Maximum="240" TickFrequency="20"
                                                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding VideoLength}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="35" FontWeight="Bold"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding VideoLengthSeconds}" FontSize="10" Foreground="#999"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="FPS" FontWeight="SemiBold" FontSize="11"/>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Slider Grid.Column="0" Value="{Binding Fps, Mode=TwoWay}"
                                                                    Minimum="8" Maximum="30" TickFrequency="2"
                                                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Fps}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="25" FontWeight="Bold"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>

                                            <Button Content="Generate Video" Classes="primary"
                                                    Command="{Binding GenerateVideoCommand}"
                                                    HorizontalAlignment="Stretch" Height="45" FontSize="13"/>

                                            <Border Background="#FFF9F0" BorderBrush="#FFE0B0" BorderThickness="1"
                                                    CornerRadius="5" Padding="8"
                                                    IsVisible="{Binding IsProcessing}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding ProcessingStatus}" FontWeight="SemiBold"
                                                               FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    <ProgressBar Value="{Binding ProcessingProgress}" Height="14"/>
                                                    <TextBlock Text="{Binding ProgressPercentage}" HorizontalAlignment="Center"
                                                               FontSize="10" FontWeight="Bold" Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Prompt Queue Section -->
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Prompt Queue" FontSize="14" FontWeight="Bold" Foreground="#FF6B35"/>

                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding NewQueuePrompt, Mode=TwoWay}"
                                                     Padding="10" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Add to Queue" Classes="secondary"
                                                    Command="{Binding AddToQueueCommand}"
                                                    Height="35" Width="110" Margin="0,0,5,0"/>
                                            <Button Grid.Column="2" Content="Process Queue" Classes="primary"
                                                    Command="{Binding ProcessQueueCommand}"
                                                    IsEnabled="{Binding CanProcessQueue}"
                                                    Height="35" Width="120" Margin="0,0,5,0"/>
                                            <Button Grid.Column="3" Content="Retry Failed"
                                                    Command="{Binding ReprocessAllFailedCommand}"
                                                    IsEnabled="{Binding HasFailedItems}"
                                                    Height="35" Width="110" Margin="0,0,5,0"
                                                    Background="#FFA500" Foreground="White" BorderThickness="0"/>
                                            <Button Grid.Column="4" Content="Stop"
                                                    Command="{Binding StopQueueCommand}"
                                                    IsEnabled="{Binding IsProcessingQueue}"
                                                    Height="35" Width="70" Margin="0,0,5,0"
                                                    Background="#F59E0B" Foreground="White" BorderThickness="0"/>
                                            <Button Grid.Column="5" Content="Clear"
                                                    Command="{Binding ClearQueueCommand}"
                                                    Height="35" Width="70"
                                                    Background="#DC3545" Foreground="White" BorderThickness="0"/>
                                        </Grid>

                                        <!-- Pause/Resume (visible when processing) -->
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding IsProcessingQueue}">
                                            <Button Content="Pause" Width="100" Height="32"
                                                    Command="{Binding PauseQueueCommand}"
                                                    Background="#F59E0B" Foreground="White" BorderThickness="0"/>
                                            <Button Content="Resume" Width="100" Height="32"
                                                    Command="{Binding ResumeQueueCommand}"
                                                    Background="#10B981" Foreground="White" BorderThickness="0"/>
                                        </StackPanel>

                                        <TextBlock Text="Queue Items:" FontWeight="SemiBold" FontSize="12"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" MaxHeight="200">
                                            <ScrollViewer Padding="5">
                                                <ItemsControl ItemsSource="{Binding PromptQueue}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="3"
                                                                    Padding="8" Margin="0,0,0,5">
                                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayText}"
                                                                               TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}"
                                                                               FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{Binding StatusColor}"
                                                                               VerticalAlignment="Center" Margin="10,0"/>
                                                                    <Button Grid.Column="2" Content="Retry" Width="30" Padding="5,2" FontSize="11"
                                                                            ToolTip.Tip="Reprocess this item" Margin="0,0,5,0"
                                                                            Command="{Binding DataContext.ReprocessItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Background="#FFA500" Foreground="White" BorderThickness="0"
                                                                            IsVisible="{Binding IsFailed}"/>
                                                                    <Button Grid.Column="3" Content="X" Classes="nav"
                                                                            Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="5,2" FontSize="10"
                                                                            ToolTip.Tip="Remove from queue" Width="30"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>

                                        <TextBlock Text="{Binding QueueStatus}" FontSize="11" Foreground="#666" FontStyle="Italic"/>
                                    </StackPanel>
                                </Border>

                                <!-- Result Video -->
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Result Video" FontSize="14" FontWeight="Bold" Foreground="#FF6B35"/>
                                        <TextBlock Text="Video will appear here after generation" Foreground="#999"
                                                   FontStyle="Italic" IsVisible="{Binding !HasResultVideo}"/>
                                        <TextBlock Text="{Binding ResultVideoPath}" FontSize="11" Foreground="#666"
                                                   IsVisible="{Binding HasResultVideo}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Play" Classes="secondary" Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResultVideo}"/>
                                            <Button Content="Open Folder" Classes="secondary" Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResultVideo}"/>
                                            <Button Content="Send to Edit Camera" Classes="secondary" Command="{Binding SendToEditCameraCommand}"
                                                    IsEnabled="{Binding HasResultVideo}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding VideoInfo}" FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- Advanced Settings (Collapsible) -->
                                <Expander Header="Advanced Settings" IsExpanded="False">
                                    <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5"
                                            Padding="15" Margin="0,8,0,0">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,*,*">
                                                <StackPanel Grid.Column="0" Margin="0,0,15,0" Spacing="5">
                                                    <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="11"/>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Slider Grid.Column="0" Value="{Binding Steps, Mode=TwoWay}"
                                                                Minimum="1" Maximum="10" TickFrequency="1"
                                                                IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Steps}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="25" FontWeight="Bold"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,15,0" Spacing="5">
                                                    <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="11"/>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Slider Grid.Column="0" Value="{Binding Cfg, Mode=TwoWay}"
                                                                Minimum="1" Maximum="5" TickFrequency="0.5"
                                                                IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Cfg, StringFormat='{}{0:F1}'}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="25" FontWeight="Bold"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="5">
                                                    <TextBlock Text="Seed (0 = Random)" FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBox Text="{Binding Seed, Mode=TwoWay}" Padding="8" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Negative Prompt" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBox Text="{Binding NegativePrompt, Mode=TwoWay}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" Height="60" Padding="8" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!-- Log (Collapsible) -->
                                <Expander Header="Processing Log" IsExpanded="True">
                                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150">
                                            <TextBox Text="{Binding LogOutput, Mode=OneWay}" TextWrapping="Wrap"
                                                     IsReadOnly="True" FontFamily="Monospace" FontSize="10"
                                                     Background="Transparent" BorderThickness="0" Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── Tab 2: Story Video Generator ── -->
                    <TabItem Header="Story Video">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="15">

                                <!-- Story Queue Controls -->
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Story Video Queue" FontSize="14" FontWeight="Bold" Foreground="#FF6B35"/>

                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding StoryNewQueuePrompt, Mode=TwoWay}"
                                                     Padding="10" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                                     Watermark="Enter story prompt..."/>
                                            <Button Grid.Column="1" Content="Add" Classes="secondary"
                                                    Command="{Binding StoryAddToQueueCommand}"
                                                    Height="35" Margin="0,0,5,0"/>
                                            <Button Grid.Column="2" Content="Process" Classes="primary"
                                                    Command="{Binding StoryProcessQueueCommand}"
                                                    IsEnabled="{Binding StoryCanProcessQueue}"
                                                    Height="35" Margin="0,0,5,0"/>
                                            <Button Grid.Column="3" Content="Clear"
                                                    Command="{Binding StoryClearQueueCommand}"
                                                    Height="35" Background="#DC3545" Foreground="White" BorderThickness="0"/>
                                        </Grid>

                                        <!-- Story Queue Items -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" MaxHeight="300">
                                            <ScrollViewer Padding="5">
                                                <ItemsControl ItemsSource="{Binding StoryQueue}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="3"
                                                                    Padding="8" Margin="0,0,0,5">
                                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="11"/>
                                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                                   Foreground="{Binding StatusColor}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <ProgressBar Grid.Column="1" Value="{Binding Progress}"
                                                                                 Width="60" Height="8" Margin="5,0" VerticalAlignment="Center"
                                                                                 IsVisible="{Binding IsProcessing}"/>
                                                                    <Button Grid.Column="2" Content="Regen" Width="45" FontSize="10"
                                                                            ToolTip.Tip="Regenerate this clip"
                                                                            Command="{Binding DataContext.StoryReprocessItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Background="#FFA500" Foreground="White" BorderThickness="0" Margin="2,0"/>
                                                                    <Button Grid.Column="3" Content="X" Classes="nav" Width="28" FontSize="10"
                                                                            Command="{Binding DataContext.StoryRemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Join Clips -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Join Clips" Classes="primary"
                                                    Command="{Binding StoryJoinClipsCommand}"
                                                    Height="35"/>
                                            <Button Content="Open Output" Classes="secondary"
                                                    Command="{Binding StoryOpenResultFolderCommand}"
                                                    Height="35"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Story Log -->
                                <Expander Header="Story Log" IsExpanded="False">
                                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150">
                                            <TextBox Text="{Binding StoryLogOutput, Mode=OneWay}" TextWrapping="Wrap"
                                                     IsReadOnly="True" FontFamily="Monospace" FontSize="10"
                                                     Background="Transparent" BorderThickness="0" Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── Tab 3: VACE Video Generator ── -->
                    <TabItem Header="VACE">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="15">
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="VACE Video Generator" FontSize="14" FontWeight="Bold" Foreground="#6366F1"/>

                                        <!-- Image inputs -->
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="5">
                                                <TextBlock Text="Reference Image" FontWeight="SemiBold" FontSize="11"/>
                                                <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" Height="150" CornerRadius="5">
                                                    <Grid>
                                                        <TextBlock Text="No image" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="#999" IsVisible="{Binding !VaceVM.HasReferenceImage}"/>
                                                        <Image Source="{Binding VaceVM.ReferenceImagePath, Converter={StaticResource PathToBitmapConverter}}"
                                                               Stretch="Uniform" IsVisible="{Binding VaceVM.HasReferenceImage}"/>
                                                    </Grid>
                                                </Border>
                                                <Button Content="Browse" Classes="secondary"
                                                        Command="{Binding VaceVM.SelectReferenceImageCommand}" Height="30"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="5">
                                                <TextBlock Text="Input Video" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBox Text="{Binding VaceVM.InputVideoPath}" IsReadOnly="True" Height="30"/>
                                                <Button Content="Browse" Classes="secondary"
                                                        Command="{Binding VaceVM.SelectInputVideoCommand}" Height="30"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Prompt -->
                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBox Text="{Binding VaceVM.VideoPrompt, Mode=TwoWay}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="80" Padding="8" FontSize="11"/>

                                        <!-- Generate -->
                                        <Grid ColumnDefinitions="*,*">
                                            <Button Grid.Column="0" Content="Generate Video" Classes="primary"
                                                    Command="{Binding VaceVM.GenerateVideoCommand}" Margin="0,0,5,0" Height="38"/>
                                            <Button Grid.Column="1" Content="Cancel" Classes="danger"
                                                    Command="{Binding VaceVM.CancelGenerationCommand}" Margin="5,0,0,0" Height="38"/>
                                        </Grid>

                                        <ProgressBar Value="{Binding VaceVM.ProcessingProgress}" Maximum="100" Height="16"
                                                     IsVisible="{Binding VaceVM.IsProcessing}"/>
                                        <TextBlock Text="{Binding VaceVM.ProcessingStatus}" FontSize="11"
                                                   IsVisible="{Binding VaceVM.IsProcessing}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── Tab 4: Single Video ── -->
                    <TabItem Header="Single Video">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="15">
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Single Video Generation" FontSize="14" FontWeight="Bold" Foreground="#FF6B35"/>
                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBox Text="{Binding LTX23BasicVM.VideoPrompt, Mode=TwoWay}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="100" Padding="10" FontSize="12"/>
                                        <Grid ColumnDefinitions="*,*">
                                            <Button Grid.Column="0" Content="Generate Video" Classes="primary"
                                                    Command="{Binding LTX23BasicVM.GenerateVideoCommand}" Margin="0,0,5,0" Height="40"/>
                                            <Button Grid.Column="1" Content="Cancel" Classes="danger"
                                                    Command="{Binding LTX23BasicVM.CancelGenerationCommand}" Margin="5,0,0,0" Height="40"/>
                                        </Grid>
                                        <Border Background="#FFF9F0" BorderBrush="#FFE0B0" BorderThickness="1" CornerRadius="5" Padding="10"
                                                IsVisible="{Binding LTX23BasicVM.IsProcessing}">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding LTX23BasicVM.ProcessingStatus}" FontSize="11"/>
                                                <ProgressBar Value="{Binding LTX23BasicVM.ProcessingProgress}" Maximum="100" Height="14"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Expander Header="Processing Log" IsExpanded="True">
                                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150">
                                            <TextBox Text="{Binding LTX23BasicVM.LogOutput, Mode=OneWay}" IsReadOnly="True"
                                                     FontFamily="Monospace" FontSize="10" Background="Transparent"
                                                     BorderThickness="0" Padding="10" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── Tab 5: Infinite Talk ── -->
                    <TabItem Header="Infinite Talk">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="15">
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Infinite Talk Video" FontSize="14" FontWeight="Bold" Foreground="#9C27B0"/>
                                        <!-- Speaker image -->
                                        <TextBlock Text="Speaker Image" FontWeight="SemiBold" FontSize="11"/>
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" Height="150" CornerRadius="5">
                                            <Grid>
                                                <TextBlock Text="No speaker image" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#999" IsVisible="{Binding !InfiniteTalkVM.HasSpeakerImage}"/>
                                                <Image Source="{Binding InfiniteTalkVM.SpeakerImagePath, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="Uniform" IsVisible="{Binding InfiniteTalkVM.HasSpeakerImage}"/>
                                            </Grid>
                                        </Border>
                                        <Button Content="Select Speaker Image" Classes="primary"
                                                Command="{Binding InfiniteTalkVM.SelectSpeakerImageCommand}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Audio Prompt" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBox Text="{Binding InfiniteTalkVM.AudioPrompt, Mode=TwoWay}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="80" Padding="8" FontSize="11"/>
                                        <Grid ColumnDefinitions="*,*">
                                            <Button Grid.Column="0" Content="Generate" Classes="primary"
                                                    Command="{Binding InfiniteTalkVM.GenerateVideoCommand}" Margin="0,0,5,0" Height="38"/>
                                            <Button Grid.Column="1" Content="Cancel" Classes="danger"
                                                    Command="{Binding InfiniteTalkVM.CancelGenerationCommand}" Margin="5,0,0,0" Height="38"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding InfiniteTalkVM.ProcessingProgress}" Maximum="100" Height="14"
                                                     IsVisible="{Binding InfiniteTalkVM.IsProcessing}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── Tab 6: Text to Video ── -->
                    <TabItem Header="Text to Video">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="15">
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Text to Video (LTX23)" FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBox Text="{Binding LTX23T2VVM.VideoPrompt, Mode=TwoWay}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="120" Padding="10" FontSize="12"
                                                 Watermark="Describe the video you want to generate..."/>
                                        <TextBlock Text="Negative Prompt" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBox Text="{Binding LTX23T2VVM.NegativePrompt, Mode=TwoWay}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="60" Padding="8" FontSize="11"/>
                                        <Grid ColumnDefinitions="*,*">
                                            <Button Grid.Column="0" Content="Generate Video" Classes="primary"
                                                    Command="{Binding LTX23T2VVM.GenerateVideoCommand}" Margin="0,0,5,0" Height="40"/>
                                            <Button Grid.Column="1" Content="Cancel" Classes="danger"
                                                    Command="{Binding LTX23T2VVM.CancelGenerationCommand}" Margin="5,0,0,0" Height="40"/>
                                        </Grid>
                                        <Border Background="#FFF9F0" BorderBrush="#FFE0B0" BorderThickness="1" CornerRadius="5" Padding="10"
                                                IsVisible="{Binding LTX23T2VVM.IsProcessing}">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding LTX23T2VVM.ProcessingStatus}" FontSize="11"/>
                                                <ProgressBar Value="{Binding LTX23T2VVM.ProcessingProgress}" Maximum="100" Height="14"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── Tab 7: Long Video ── -->
                    <TabItem Header="Long Video">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="15">
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Long Video Generator" FontSize="14" FontWeight="Bold" Foreground="#E91E63"/>
                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBox Text="{Binding LongVideoVM.VideoPrompt, Mode=TwoWay}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="100" Padding="10" FontSize="12"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Number of Clips:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding LongVideoVM.NumberOfClips, Mode=TwoWay}"
                                                     Width="80" Padding="8" FontSize="11"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*">
                                            <Button Grid.Column="0" Content="Generate" Classes="primary"
                                                    Command="{Binding LongVideoVM.GenerateVideoCommand}" Margin="0,0,5,0" Height="40"/>
                                            <Button Grid.Column="1" Content="Cancel" Classes="danger"
                                                    Command="{Binding LongVideoVM.CancelGenerationCommand}" Margin="5,0,0,0" Height="40"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding LongVideoVM.ProcessingProgress}" Maximum="100" Height="14"
                                                     IsVisible="{Binding LongVideoVM.IsProcessing}"/>
                                        <TextBlock Text="{Binding LongVideoVM.ProcessingStatus}" FontSize="11"
                                                   IsVisible="{Binding LongVideoVM.IsProcessing}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── Tab 8: WanAnimate ── -->
                    <TabItem Header="WanAnimate">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="15">
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="WanAnimate" FontSize="14" FontWeight="Bold" Foreground="#FF6B35"/>
                                        <TextBlock Text="Reference Image" FontWeight="SemiBold" FontSize="11"/>
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" Height="150" CornerRadius="5">
                                            <Grid>
                                                <TextBlock Text="No image" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#999" IsVisible="{Binding !WanAnimateVM.HasReferenceImage}"/>
                                                <Image Source="{Binding WanAnimateVM.ReferenceImagePath, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="Uniform" IsVisible="{Binding WanAnimateVM.HasReferenceImage}"/>
                                            </Grid>
                                        </Border>
                                        <Button Content="Browse" Classes="secondary"
                                                Command="{Binding WanAnimateVM.SelectReferenceImageCommand}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBox Text="{Binding WanAnimateVM.VideoPrompt, Mode=TwoWay}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="100" Padding="10" FontSize="12"/>
                                        <Grid ColumnDefinitions="*,*">
                                            <Button Grid.Column="0" Content="Generate" Classes="primary"
                                                    Command="{Binding WanAnimateVM.GenerateVideoCommand}" Margin="0,0,5,0" Height="40"/>
                                            <Button Grid.Column="1" Content="Cancel" Classes="danger"
                                                    Command="{Binding WanAnimateVM.CancelGenerationCommand}" Margin="5,0,0,0" Height="40"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding WanAnimateVM.ProcessingProgress}" Maximum="100" Height="14"
                                                     IsVisible="{Binding WanAnimateVM.IsProcessing}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── Tab 9: WAN SCAIL ── -->
                    <TabItem Header="WAN SCAIL" FontWeight="Bold" FontSize="13">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="15">
                                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="WAN SCAIL" FontSize="14" FontWeight="Bold" Foreground="#FF6B35"/>
                                        <!-- Input video -->
                                        <TextBlock Text="Input Video" FontWeight="SemiBold" FontSize="11"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding WanScailVM.InputVideoPath}" IsReadOnly="True" Padding="8"/>
                                            <Button Grid.Column="1" Content="Browse" Classes="secondary"
                                                    Command="{Binding WanScailVM.SelectInputVideoCommand}" Margin="8,0,0,0"/>
                                        </Grid>
                                        <!-- Reference image -->
                                        <TextBlock Text="Reference Frame Image" FontWeight="SemiBold" FontSize="11"/>
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" Height="150" CornerRadius="5">
                                            <Grid>
                                                <TextBlock Text="No image" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#999" IsVisible="{Binding !WanScailVM.HasReferenceImage}"/>
                                                <Image Source="{Binding WanScailVM.ReferenceImagePath, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="Uniform" IsVisible="{Binding WanScailVM.HasReferenceImage}"/>
                                            </Grid>
                                        </Border>
                                        <Button Content="Browse Reference Image" Classes="secondary"
                                                Command="{Binding WanScailVM.SelectReferenceImageCommand}" HorizontalAlignment="Left"/>
                                        <!-- Prompt -->
                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBox Text="{Binding WanScailVM.VideoPrompt, Mode=TwoWay}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="80" Padding="8" FontSize="11"/>
                                        <Grid ColumnDefinitions="*,*">
                                            <Button Grid.Column="0" Content="Generate" Classes="primary"
                                                    Command="{Binding WanScailVM.GenerateVideoCommand}" Margin="0,0,5,0" Height="40"/>
                                            <Button Grid.Column="1" Content="Cancel" Classes="danger"
                                                    Command="{Binding WanScailVM.CancelGenerationCommand}" Margin="5,0,0,0" Height="40"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding WanScailVM.ProcessingProgress}" Maximum="100" Height="14"
                                                     IsVisible="{Binding WanScailVM.IsProcessing}"/>
                                        <TextBlock Text="{Binding WanScailVM.ProcessingStatus}" FontSize="11"
                                                   IsVisible="{Binding WanScailVM.IsProcessing}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab: LTX Control -->
                    <TabItem Header="LTX Control" FontWeight="Bold" FontSize="13">
                        <ScrollViewer>
                            <StackPanel Margin="10" Spacing="15">
                                <Border Background="#F8F9FA" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="LTX IC-LoRA Control" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>

                                        <!-- Reference Image -->
                                        <TextBlock Text="Reference Image (subject &amp; aesthetics)" FontWeight="SemiBold" FontSize="11"/>
                                        <Border BorderBrush="#BFDBFE" BorderThickness="1" Background="White" Height="120" CornerRadius="5">
                                            <Grid>
                                                <TextBlock Text="No image" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#999" IsVisible="{Binding LtxControlVM.!HasRefImage}"/>
                                                <Image Source="{Binding LtxControlVM.RefImagePreview}"
                                                       Stretch="Uniform" IsVisible="{Binding LtxControlVM.HasRefImage}"/>
                                            </Grid>
                                        </Border>
                                        <Button Content="Browse Reference Image" Classes="secondary"
                                                Command="{Binding LtxControlVM.SelectRefImageCommand}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding LtxControlVM.RefImageInfo}" FontSize="10" Foreground="#666"/>

                                        <!-- Reference Video -->
                                        <TextBlock Text="Reference Video (motion &amp; structure)" FontWeight="SemiBold" FontSize="11"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding LtxControlVM.RefVideoPath}" IsReadOnly="True" Padding="8"/>
                                            <Button Grid.Column="1" Content="Browse" Classes="secondary"
                                                    Command="{Binding LtxControlVM.SelectRefVideoCommand}" Margin="8,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding LtxControlVM.RefVideoInfo}" FontSize="10" Foreground="#666"/>

                                        <!-- Analyze -->
                                        <Button Content="🔍 Analyze Image" Classes="primary"
                                                Command="{Binding LtxControlVM.AnalyzeCommand}"
                                                IsEnabled="{Binding LtxControlVM.CanAnalyze}"
                                                HorizontalAlignment="Left" Height="36"
                                                ToolTip.Tip="Analyzes the reference image to generate an IC-LoRA aesthetic prompt."/>

                                        <!-- Prompt -->
                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBox Text="{Binding LtxControlVM.Prompt, Mode=TwoWay}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="80" Padding="8" FontSize="11"/>

                                        <!-- Actions -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Content="⚡ Generate Video" Classes="primary"
                                                    Command="{Binding LtxControlVM.GenerateVideoCommand}"
                                                    IsEnabled="{Binding LtxControlVM.CanAddToQueue}" Margin="0,0,5,0" Height="40"/>
                                            <Button Grid.Column="1" Content="Cancel" Classes="danger"
                                                    Command="{Binding LtxControlVM.StopQueueCommand}"
                                                    IsEnabled="{Binding LtxControlVM.IsProcessingQueue}" Margin="5,0,0,0" Height="40"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding LtxControlVM.ProcessingProgress}" Maximum="100" Height="14"
                                                     IsVisible="{Binding LtxControlVM.IsProcessing}"/>
                                        <TextBlock Text="{Binding LtxControlVM.ProcessingStatus}" FontSize="11"
                                                   IsVisible="{Binding LtxControlVM.IsProcessing}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="28">
            <DockPanel>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"
                           VerticalAlignment="Center" Margin="5,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="5,0" Spacing="3">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
