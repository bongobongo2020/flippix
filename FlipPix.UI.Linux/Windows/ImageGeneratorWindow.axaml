<win:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:ctrl="using:FlipPix.UI.Linux.Controls"
               xmlns:conv="using:FlipPix.UI.Linux.Converters"
               xmlns:win="using:FlipPix.UI.Linux.Windows"
               xmlns:vm="using:FlipPix.UI.ViewModels"
               xmlns:vmv="using:FlipPix.UI.ViewModels.Video"
               xmlns:m="using:FlipPix.UI.Models"
               xmlns:svc="using:FlipPix.UI.Services"
               xmlns:sys="using:System"
               mc:Ignorable="d"
               Title="FlipPix - Image Generator"
               Height="950"
               Width="950"
               WindowStartupLocation="CenterScreen"
               WindowState="Normal"
               MinHeight="650"
               MinWidth="850"
               x:Class="FlipPix.UI.ImageGeneratorWindow"
               x:DataType="vm:ImageGeneratorViewModel"
               x:CompileBindings="True">
    <Window.Resources>
        <ControlTheme x:Key="AnalyzeButtonStyle" TargetType="Button" x:DataType="vm:ImageGeneratorViewModel">
            <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Name="PART_ContentPresenter"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="#CBD5E1"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Style>
        </ControlTheme>
        <!-- Toggle Radio Button Style for Input Mode -->
        <ControlTheme x:Key="ToggleRadioStyle" TargetType="RadioButton" x:DataType="vm:ImageGeneratorViewModel">
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Name="PART_ContentPresenter"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#DEE2E6"/>
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{StaticResource AccentIndigoBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentIndigoBrush}"/>
            </Style>
        </ControlTheme>
        <!-- Queue Flash Animation -->
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border Grid.Row="0" PointerPressed="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource BrandColor}"/>
            </Border.Background>
            <Grid Margin="25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Title Section -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Image Generator" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Generate images from text descriptions using AI" FontSize="13" Foreground="#E6FFFFFF" Margin="0,5,0,0"/>
                </StackPanel>
                <!-- Phone remote -->
                <Button Grid.Column="1"
                        Name="PhoneRemoteButton"
                        Click="PhoneRemoteButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10"
                        Cursor="Hand"
                        ToolTip.Tip="Phone remote: use FlipPix from your phone"
                        Margin="20,0,0,0"
                        Classes="t1">
                    <Button.Styles>
                        <Style Selector="Button.t1:pointerover">
                            <Setter Property="Background" Value="#33FFFFFF"/>
                        </Style>
                        <Style Selector="Button.t1:pressed">
                            <Setter Property="Background" Value="#22FFFFFF"/>
                        </Style>
                    </Button.Styles>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowDirectionEffect BlurRadius="0" ShadowDepth="0"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Name="PART_ContentPresenter"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Theme>
                        <ControlTheme TargetType="Button"/>
                    </Button.Theme>
                    <TextBlock Text="📱" FontSize="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <!-- Settings Button -->
                <Button Grid.Column="2"
                        Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10"
                        Cursor="Hand"
                        ToolTip.Tip="Open Settings"
                        Margin="8,0,0,0"
                        Classes="t2">
                    <Button.Styles>
                        <Style Selector="Button.t2:pointerover">
                            <Setter Property="Background" Value="#33FFFFFF"/>
                        </Style>
                        <Style Selector="Button.t2:pressed">
                            <Setter Property="Background" Value="#22FFFFFF"/>
                        </Style>
                    </Button.Styles>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowDirectionEffect BlurRadius="0" ShadowDepth="0"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Name="PART_ContentPresenter"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Theme>
                        <ControlTheme TargetType="Button"/>
                    </Button.Theme>
                    <TextBlock Text="⚙️" FontSize="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
        <!-- Navigation Bar -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,1"
                Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Navigate:"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="🎬 Video Generator"
                        Theme="{StaticResource NavButtonStyle}"
                        Command="{Binding NavigateToVideoGeneratorCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"/>
                <Button Content="✨ Enhance Video"
                        Theme="{StaticResource NavButtonStyle}"
                        Command="{Binding NavigateToEnhanceVideoCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"/>
            </StackPanel>
        </Border>
        <!-- Group selector: 3 pills that switch which set of tabs is visible -->
        <Border Grid.Row="2" Background="{StaticResource AppBackgroundBrush}" Padding="15,10,15,2">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="🎨 Create"
                             GroupName="NavGroup"
                             Theme="{StaticResource GroupPillStyle}"
                             IsChecked="{Binding IsCreateGroup, Mode=OneWay}"
                             Command="{Binding SelectNavGroupCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                             CommandParameter="0"/>
                <RadioButton Content="✏️ Edit"
                             GroupName="NavGroup"
                             Theme="{StaticResource GroupPillStyle}"
                             IsChecked="{Binding IsEditGroup, Mode=OneWay}"
                             Command="{Binding SelectNavGroupCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                             CommandParameter="1"/>
                <RadioButton Content="🎛️ Advanced"
                             GroupName="NavGroup"
                             Theme="{StaticResource GroupPillStyle}"
                             IsChecked="{Binding IsAdvancedGroup, Mode=OneWay}"
                             Command="{Binding SelectNavGroupCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                             CommandParameter="2"/>
            </StackPanel>
        </Border>
        <!-- Main Content with Tabbed Interface -->
        <TabControl Grid.Row="3" Margin="15,4,15,10" Background="Transparent" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Tab 1: Image Generator (Merged Text Generation + Image Analysis) -->
            <TabItem Header="🎨 Image Generator" IsVisible="{Binding IsCreateGroup}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15,12,15,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="52*"/>
                        </Grid.ColumnDefinitions>
                        <!-- LEFT COLUMN - Input & Settings -->
                        <StackPanel Grid.Column="0">
                            <!-- Section A: Input Mode Toggle -->
                            <Border Theme="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Input Mode" Theme="{StaticResource HeaderTextStyle}"/>
                                    <!-- Input Mode Toggle -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton Content="Text Prompt"
                                                     IsChecked="{Binding Analyzer.IsTextPromptMode, Mode=OneWay}"
                                                     GroupName="InputMode"
                                                     Theme="{StaticResource ToggleRadioStyle}"
                                                     Margin="0,0,5,0"/>
                                        <RadioButton Content="Image Analysis"
                                                     IsChecked="{Binding Analyzer.IsImageAnalysisMode}"
                                                     GroupName="InputMode"
                                                     Theme="{StaticResource ToggleRadioStyle}"
                                                     Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <!-- Text Prompt Section (visible only in Text Prompt mode) -->
                                    <StackPanel IsVisible="{Binding Analyzer.IsTextPromptMode}">
                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ImagePrompt, Mode=TwoWay}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Height="120"
                                                 Padding="10"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 FontSize="12"/>
                                        <!-- Validation hint -->
                                        <TextBlock Text="Enter a prompt to enable generation"
                                                   FontSize="10"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   Margin="0,4,0,0"
                                                   FontStyle="Italic"
                                                   Classes="s3"
                                                   Classes.s3_0="{Binding !CanGenerate}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.s3.s3_0" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                </Style>
                                            </TextBlock.Styles>
                                            <TextBlock.Theme>
                                                <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </ControlTheme>
                                            </TextBlock.Theme>
                                        </TextBlock>
                                        <!-- Saved prompts (tucked away) -->
                                        <Expander Header="📝 Saved prompts" IsExpanded="False" Margin="0,8,0,0">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding SavedPrompts}"
                                                          SelectedItem="{Binding SelectedSavedPrompt, Mode=TwoWay}"
                                                          SelectedValueBinding="{ReflectionBinding Id}"
                                                          FontSize="12"
                                                          Height="40"
                                                          Margin="0,0,6,0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="m:SavedPrompt">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="1"
                                                        Content="💾 Save"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding SavePromptCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Padding="10,5"
                                                        Margin="0,0,5,0"
                                                        Height="40"
                                                        ToolTip.Tip="Save current prompt"/>
                                                <Button Grid.Column="2"
                                                        Content="🗑️"
                                                        Theme="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding DeletePromptCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Padding="12,5"
                                                        Height="40"
                                                        ToolTip.Tip="Delete selected prompt"/>
                                            </Grid>
                                        </Expander>
                                        <!-- Example prompts (tucked away) -->
                                        <Expander Header="💡 Example prompts" IsExpanded="False" Margin="0,4,0,0">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,3"
                                                           TextWrapping="Wrap"
                                                           Text="• Latina female with thick wavy hair, harbor boats and pastel houses behind."/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,3"
                                                           TextWrapping="Wrap"
                                                           Text="• A majestic mountain landscape at sunset with dramatic clouds and golden light"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,0"
                                                           TextWrapping="Wrap"
                                                           Text="• Portrait of a cyberpunk character with neon lights reflecting on metallic surfaces"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                    <!-- Image Analysis Section (visible only in Image Analysis mode) -->
                                    <StackPanel IsVisible="{Binding Analyzer.IsImageAnalysisMode}">
                                        <TextBlock Text="Upload an image to analyze" FontSize="11" Foreground="#666" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Analyzer.SourceImagePath, Mode=TwoWay}"
                                                     IsReadOnly="True"
                                                     Padding="8"
                                                     Background="White"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="11"
                                                     Height="30"/>
                                            <Button Grid.Column="1"
                                                    Content="Browse"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding Analyzer.BrowseImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                    Margin="6,0,0,0"
                                                    Height="30"
                                                    Padding="12,6"/>
                                        </Grid>
                                        <!-- Image Preview -->
                                        <Border BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="2"
                                                Background="White"
                                                Height="160"
                                                CornerRadius="5"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="No image selected"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#999"
                                                           FontStyle="Italic"
                                                           FontSize="13"
                                                           Classes="s4"
                                                           Classes.s4_0="{Binding !Analyzer.HasSourceImage}">
                                                    <TextBlock.Styles>
                                                        <Style Selector="TextBlock.s4.s4_0" x:DataType="vm:ImageGeneratorViewModel">
                                                            <Setter Property="IsVisible" Value="True"/>
                                                        </Style>
                                                    </TextBlock.Styles>
                                                    <TextBlock.Theme>
                                                        <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                                            <Setter Property="IsVisible" Value="False"/>
                                                        </ControlTheme>
                                                    </TextBlock.Theme>
                                                </TextBlock>
                                                <Image Source="{Binding Analyzer.SourceImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="Uniform"
                                                       Margin="5"
                                                       IsVisible="{Binding Analyzer.HasSourceImage}"/>
                                            </Grid>
                                        </Border>
                                        <!-- Analyze Button + analysis mode -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="Analyze Image"
                                                    Theme="{StaticResource AnalyzeButtonStyle}"
                                                    Command="{Binding Analyzer.AnalyzeImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="38"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding Analyzer.AnalysisModes}"
                                                      SelectedIndex="{Binding Analyzer.SelectedAnalysisModeIndex, Mode=TwoWay}"
                                                      Height="38"
                                                      MinWidth="170"
                                                      FontSize="11"
                                                      VerticalContentAlignment="Center"
                                                      Margin="6,0,0,0"
                                                      ToolTip.Tip="Match description &amp; pose: describe the person, outfit and exact body pose so the result reproduces the image.&#10;Spicy variation: keep the same person and pose but swap in a sexier, more revealing outfit."/>
                                        </Grid>
                                        <!-- Processing Status for Analysis -->
                                        <Border Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="#FCD34D"
                                                BorderThickness="2"
                                                CornerRadius="6"
                                                Padding="12"
                                                IsVisible="{Binding Analyzer.IsAnalyzing}">
                                            <StackPanel>
                                                <TextBlock Text="Analyzing image..."
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Margin="0,0,0,6"
                                                           TextAlignment="Center"
                                                           Foreground="#92400E"/>
                                                <ProgressBar IsIndeterminate="True" Height="18" Foreground="{StaticResource AccentAmberBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding Analyzer.AnalysisText, Mode=TwoWay}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Height="100"
                                                 Padding="10"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 FontSize="12"/>
                                        <!-- Saved prompts (tucked away) -->
                                        <Expander Header="📝 Saved prompts" IsExpanded="False" Margin="0,8,0,0">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding Analyzer.SavedPrompts}"
                                                          SelectedItem="{Binding Analyzer.SelectedSavedPrompt, Mode=TwoWay}"
                                                          SelectedValueBinding="{ReflectionBinding Id}"
                                                          FontSize="12"
                                                          Height="40"
                                                          Margin="0,0,6,0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="m:SavedPrompt">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="1"
                                                        Content="💾 Save"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding Analyzer.SavePromptCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Padding="10,5"
                                                        Margin="0,0,5,0"
                                                        Height="40"
                                                        ToolTip.Tip="Save current prompt"/>
                                                <Button Grid.Column="2"
                                                        Content="🗑️"
                                                        Theme="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding Analyzer.DeletePromptCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Padding="12,5"
                                                        Height="40"
                                                        ToolTip.Tip="Delete selected prompt"/>
                                            </Grid>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Generation Settings (one shared panel for both input modes) -->
                            <Border Theme="{StaticResource SectionPanelStyle}">
                                <ContentControl Content="{Binding ActiveGenerationVM}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <StackPanel>
                                                <TextBlock Text="Generation Settings" Theme="{StaticResource HeaderTextStyle}"/>
                                                <!-- Workflow -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="Model Workflow" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox SelectedIndex="{Binding SelectedWorkflow, Mode=TwoWay}" FontSize="11" Height="32">
                                                        <ComboBoxItem Content="Zimage (with LoRA support)"/>
                                                        <ComboBoxItem Content="Qwen 2512"/>
                                                        <ComboBoxItem Content="Klien (Flux2)"/>
                                                        <ComboBoxItem Content="Anima"/>
                                                        <ComboBoxItem Content="Krea2 (Turbo)"/>
                                                        <ComboBoxItem Content="Zimage Base (no style)"/>
                                                        <ComboBoxItem Content="Qwen 2.1 (prompt enhancer)"/>
                                                        <ComboBoxItem Content="MOSS (Serenity)"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <!-- Prompt enhancer (Qwen 2.1 only) -->
                                                <StackPanel Margin="0,0,0,12" IsVisible="{Binding ShowPromptEnhancerOption}">
                                                    <CheckBox Content="Rewrite prompt with Qwen3-VL 8B"
                                                              IsChecked="{Binding UsePromptEnhancer, Mode=TwoWay}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"/>
                                                    <TextBlock Text="Runs the workflow's own prompt-rewriting pass on the server before encoding. Off = the prompt is used exactly as written."
                                                               FontSize="10"
                                                               Foreground="#6B7280"
                                                               TextWrapping="Wrap"
                                                               Margin="22,2,0,0"/>
                                                </StackPanel>
                                                <!-- Style Preset (Zimage only) -->
                                                <StackPanel Margin="0,0,0,12" IsVisible="{Binding ShowStyleOptions}">
                                                    <TextBlock Text="Style Preset" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox SelectedIndex="{Binding SelectedStyleIndex, Mode=TwoWay}"
                                                              ItemsSource="{Binding StyleNames}"
                                                              FontSize="11"
                                                              Height="32"/>
                                                </StackPanel>
                                                <!-- LoRA (Zimage only) -->
                                                <StackPanel Margin="0,0,0,12" IsVisible="{Binding ShowLoraOptions}">
                                                    <CheckBox Content="Enable LoRA"
                                                              IsChecked="{Binding LoraEnabled, Mode=TwoWay}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,6"/>
                                                    <Grid IsVisible="{Binding LoraEnabled}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Grid.Column="0"
                                                                  ItemsSource="{Binding AvailableLoras}"
                                                                  SelectedItem="{Binding SelectedLora, Mode=TwoWay}"
                                                                  FontSize="11"
                                                                  Height="32"
                                                                  Margin="0,0,6,0"/>
                                                        <Button Grid.Column="1"
                                                                Content="Refresh"
                                                                Command="{Binding RefreshLorasCommand}"
                                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                                Width="60"
                                                                Height="32"
                                                                Padding="10,5"/>
                                                    </Grid>
                                                </StackPanel>
                                                <!-- LoRA (Krea2 only) — multiple LoRAs, each with its own strength -->
                                                <StackPanel Margin="0,0,0,12" IsVisible="{Binding ShowKreaLoraOptions}">
                                                    <TextBlock Text="Krea2 LoRAs" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBlock Text="Trigger word is prepended to the prompt — edit it if the LoRA wants something else, clear it to prepend nothing."
                                                               FontSize="10"
                                                               Opacity="0.6"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,6"/>
                                                    <ItemsControl ItemsSource="{Binding SelectedKreaLoras}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:CompileBindings="False">
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox Grid.Column="0"
                                                                              ItemsSource="{ReflectionBinding DataContext.KreaLoras, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              SelectedItem="{Binding LoraName, Mode=TwoWay}"
                                                                              FontSize="11"
                                                                              Height="32"
                                                                              Margin="0,0,6,0"/>
                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding TriggerWord, Mode=TwoWay}"
                                                                             ToolTip.Tip="Trigger word prepended to the prompt for this LoRA (remembered for next time)"
                                                                             FontSize="11"
                                                                             Width="110"
                                                                             Height="32"
                                                                             Margin="0,0,6,0"
                                                                             VerticalContentAlignment="Center"/>
                                                                    <TextBox Grid.Column="2"
                                                                             Text="{Binding Strength, Mode=TwoWay, StringFormat={}{0:0.##}}"
                                                                             ToolTip.Tip="LoRA strength"
                                                                             FontSize="11"
                                                                             Width="46"
                                                                             Height="32"
                                                                             Margin="0,0,6,0"
                                                                             VerticalContentAlignment="Center"
                                                                             TextAlignment="Center"/>
                                                                    <Button Grid.Column="3"
                                                                            Content="✕"
                                                                            Command="{ReflectionBinding DataContext.RemoveKreaLoraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Theme="{StaticResource SecondaryButtonStyle}"
                                                                            ToolTip.Tip="Remove this LoRA"
                                                                            Width="32"
                                                                            Height="32"
                                                                            Padding="0"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="➕ Add LoRA"
                                                                Command="{Binding AddKreaLoraCommand}"
                                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                                Height="30"
                                                                Padding="10,5"
                                                                Margin="0,0,6,0"/>
                                                        <Button Content="Refresh"
                                                                Command="{Binding RefreshKreaLorasCommand}"
                                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                                Width="60"
                                                                Height="30"
                                                                Padding="10,5"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- Aspect Ratio -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox SelectedIndex="{Binding AspectRatioIndex, Mode=TwoWay}" FontSize="11" Height="30">
                                                        <ComboBoxItem Content="Landscape"/>
                                                        <ComboBoxItem Content="Portrait"/>
                                                        <ComboBoxItem Content="Square"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <!-- Primary actions -->
                                                <Button Content="Generate Image"
                                                        Theme="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding PrimaryGenerateCommand}"
                                                        HorizontalAlignment="Stretch"
                                                        Height="44"
                                                        FontSize="14"
                                                        Margin="0,4,0,8"/>
                                                <Button Content="Add to Queue"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding AddToQueueCommand}"
                                                        HorizontalAlignment="Stretch"
                                                        Height="38"
                                                        FontSize="13"
                                                        Margin="0,0,0,4"/>
                                                <!-- Advanced -->
                                                <Expander Header="⚙️ Advanced Settings" IsExpanded="False" IsVisible="{Binding ShowSamplerSettings}">
                                                    <StackPanel Margin="0,10,0,0">
                                                        <StackPanel Margin="0,0,0,10">
                                                            <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Slider Grid.Column="0"
                                                                        Value="{Binding Steps, Mode=TwoWay}"
                                                                        Minimum="4"
                                                                        Maximum="20"
                                                                        TickFrequency="1"
                                                                        IsSnapToTickEnabled="True"
                                                                        VerticalAlignment="Center"
                                                                        Height="20"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Steps}"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           MinWidth="25"
                                                                           FontWeight="Bold"
                                                                           FontSize="11"/>
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,0,10">
                                                            <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Slider Grid.Column="0"
                                                                        Value="{Binding Cfg, Mode=TwoWay}"
                                                                        Minimum="1"
                                                                        Maximum="3"
                                                                        TickFrequency="0.5"
                                                                        IsSnapToTickEnabled="True"
                                                                        VerticalAlignment="Center"
                                                                        Height="20"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Cfg, StringFormat={}{0:F1}}"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           MinWidth="25"
                                                                           FontWeight="Bold"
                                                                           FontSize="11"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>
                            <!-- LM Studio Connection (Image Analysis mode only) -->
                            <Expander Header="🔌 LM Studio Connection"
                                      Margin="0,0,0,10"
                                      IsExpanded="False"
                                      IsVisible="{Binding Analyzer.IsImageAnalysisMode}">
                                <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="LM Studio Settings" Theme="{StaticResource HeaderTextStyle}"/>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Saved Servers" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Analyzer.ServerProfiles}"
                                                      DisplayMemberBinding="{ReflectionBinding ListLabel}"
                                                      SelectedItem="{Binding Analyzer.SelectedServerProfile, Mode=TwoWay}"
                                                      Padding="8"
                                                      Background="White"
                                                      BorderBrush="{StaticResource BorderBrush}"
                                                      FontSize="11"
                                                      Height="30"
                                                      ToolTip.Tip="Pick a saved computer (named in Settings) to switch the Server/Port below"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Server" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Analyzer.LMStudioServer}"
                                                         Padding="8"
                                                         Background="White"
                                                         BorderBrush="{StaticResource BorderBrush}"
                                                         FontSize="11"
                                                         Height="30"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Port" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Analyzer.LMStudioPort}"
                                                         Padding="8"
                                                         Background="White"
                                                         BorderBrush="{StaticResource BorderBrush}"
                                                         FontSize="11"
                                                         Height="30"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="" Height="15" Margin="0,0,0,4"/>
                                                <Button Content="Test"
                                                        Command="{Binding Analyzer.TestLMStudioConnectionCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Width="50"
                                                        Height="30"
                                                        Padding="10,5"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="AI Model" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding Analyzer.AvailableModels}"
                                                          SelectedValue="{Binding Analyzer.SelectedModel}"
                                                          SelectedValueBinding="{ReflectionBinding Name}"
                                                          Padding="8"
                                                          Background="White"
                                                          BorderBrush="{StaticResource BorderBrush}"
                                                          FontSize="11"
                                                          Height="30">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="m:LMStudioModel">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="" Height="15" Margin="0,0,0,4"/>
                                                <Button Content="Refresh"
                                                        Command="{Binding Analyzer.RefreshModelsCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Width="65"
                                                        Height="30"
                                                        Padding="10,5"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                        <!-- RIGHT COLUMN - Queue & Results -->
                        <StackPanel Grid.Column="2">
                            <!-- Queue Status Bar - Text Prompt Mode -->
                            <Border Theme="{StaticResource SectionPanelStyle}" IsVisible="{Binding Analyzer.IsTextPromptMode}">
                                <StackPanel>
                                    <TextBlock Text="Queue Status" Theme="{StaticResource HeaderTextStyle}"/>
                                    <!-- Start Queue Button (visible when not processing) -->
                                    <Button Content="▶ Start Queue"
                                            Command="{Binding ProcessQueueCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="36"
                                            FontSize="12"
                                            Margin="0,0,0,8"
                                            ToolTip.Tip="Start processing queued items"
                                            Classes="s5"
                                            Classes.s5_0="{Binding IsProcessingQueue}">
                                        <Button.Styles>
                                            <Style Selector="Button.s5.s5_0" x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"
                                                          BasedOn="{StaticResource PrimaryButtonStyle}"
                                                          x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                            </ControlTheme>
                                        </Button.Theme>
                                    </Button>
                                    <!-- Processing Progress -->
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12"
                                            IsVisible="{Binding IsProcessingQueue}">
                                        <StackPanel>
                                            <!-- Waiting for lease status -->
                                            <TextBlock Text="⏳ Waiting for other workflows to finish..."
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Margin="0,0,0,5"
                                                       TextAlignment="Center"
                                                       Foreground="{StaticResource AccentAmberBrush}"
                                                       IsVisible="{Binding IsWaitingForLease}"/>
                                            <!-- Processing status -->
                                            <TextBlock Text="Processing queue..."
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Margin="0,0,0,5"
                                                       TextAlignment="Center"
                                                       Classes="s6"
                                                       Classes.s6_0="{Binding !IsWaitingForLease}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s6.s6_0" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <!-- Pause/Resume/Cancel Buttons -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="⏸ Pause"
                                                        Command="{Binding PauseQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Width="70"
                                                        Height="28"
                                                        HorizontalAlignment="Center"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Margin="0,0,5,0"/>
                                                <Button Grid.Column="1"
                                                        Content="▶ Resume"
                                                        Command="{Binding ResumeQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Width="70"
                                                        Height="28"
                                                        HorizontalAlignment="Center"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Margin="5,0"/>
                                                <Button Grid.Column="2"
                                                        Content="✖ Cancel"
                                                        Command="{Binding CancelQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Width="70"
                                                        Height="28"
                                                        HorizontalAlignment="Center"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Background="{StaticResource DangerBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="5,0,0,0"
                                                        Classes="s7">
                                                    <Button.Styles>
                                                        <Style Selector="Button.s7:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                                            <Setter Property="Background" Value="#E55563"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <Button.Theme>
                                                        <ControlTheme TargetType="Button"
                                                                      BasedOn="{StaticResource {x:Type Button}}"
                                                                      x:DataType="vm:ImageGeneratorViewModel">
                                                            <Setter Property="Background" Value="#DC3545"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="8,4"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="5"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"
                                                                                              Content="{TemplateBinding Content}"
                                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                              Name="PART_ContentPresenter"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </ControlTheme>
                                                    </Button.Theme>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Queue Status Bar - Image Analysis Mode -->
                            <Border Theme="{StaticResource SectionPanelStyle}" IsVisible="{Binding Analyzer.IsImageAnalysisMode}">
                                <StackPanel>
                                    <TextBlock Text="Queue Status" Theme="{StaticResource HeaderTextStyle}"/>
                                    <!-- Start Queue Button -->
                                    <Button Content="▶ Start Queue"
                                            Command="{Binding Analyzer.ProcessQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            HorizontalAlignment="Stretch"
                                            Height="36"
                                            FontSize="12"
                                            Margin="0,0,0,8"
                                            ToolTip.Tip="Start processing queued items"
                                            Classes="s8"
                                            Classes.s8_0="{Binding Analyzer.IsProcessingQueue}">
                                        <Button.Styles>
                                            <Style Selector="Button.s8.s8_0" x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"
                                                          BasedOn="{StaticResource PrimaryButtonStyle}"
                                                          x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                            </ControlTheme>
                                        </Button.Theme>
                                    </Button>
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Queue:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Analyzer.QueuedCount, StringFormat={}Queued: {0}}"
                                                       Margin="10,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Analyzer.CompletedCount, StringFormat={}Completed: {0}}"
                                                       Margin="10,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SuccessBrush}"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Analyzer.FailedCount, StringFormat={}Failed: {0}}"
                                                       Margin="10,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                        </Grid>
                                    </Border>
                                    <!-- Processing Progress -->
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12"
                                            Margin="0,8,0,0"
                                            IsVisible="{Binding Analyzer.IsProcessingQueue}">
                                        <StackPanel>
                                            <!-- Waiting for lease status -->
                                            <TextBlock Text="⏳ Waiting for other workflows to finish..."
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Margin="0,0,0,5"
                                                       TextAlignment="Center"
                                                       Foreground="{StaticResource AccentAmberBrush}"
                                                       IsVisible="{Binding Analyzer.IsWaitingForLease}"/>
                                            <!-- Processing status -->
                                            <TextBlock Text="{Binding Analyzer.QueueProgressText, StringFormat={}Processing: {0}}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Margin="0,0,0,5"
                                                       TextAlignment="Center"
                                                       Classes="s9"
                                                       Classes.s9_0="{Binding !Analyzer.IsWaitingForLease}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s9.s9_0" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <ProgressBar Value="{Binding Analyzer.QueueProgress, Mode=OneWay}"
                                                         Maximum="{Binding Analyzer.QueueTotal, Mode=OneWay}"
                                                         Height="16"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         Margin="0,0,0,5"
                                                         Classes="s10"
                                                         Classes.s10_0="{Binding !Analyzer.IsWaitingForLease}">
                                                <ProgressBar.Styles>
                                                    <Style Selector="ProgressBar.s10.s10_0" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </ProgressBar.Styles>
                                                <ProgressBar.Theme>
                                                    <ControlTheme TargetType="ProgressBar"
                                                                  BasedOn="{StaticResource {x:Type ProgressBar}}"
                                                                  x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </ProgressBar.Theme>
                                            </ProgressBar>
                                            <!-- Pause/Resume/Cancel Buttons -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="⏸ Pause"
                                                        Command="{Binding Analyzer.PauseQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Width="70"
                                                        Height="28"
                                                        HorizontalAlignment="Center"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Margin="0,0,5,0"/>
                                                <Button Grid.Column="1"
                                                        Content="▶ Resume"
                                                        Command="{Binding Analyzer.ResumeQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Width="70"
                                                        Height="28"
                                                        HorizontalAlignment="Center"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Margin="5,0"/>
                                                <Button Grid.Column="2"
                                                        Content="✖ Cancel"
                                                        Command="{Binding Analyzer.CancelProcessingCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                        Width="70"
                                                        Height="28"
                                                        HorizontalAlignment="Center"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Background="{StaticResource DangerBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="5,0,0,0"
                                                        Classes="s11">
                                                    <Button.Styles>
                                                        <Style Selector="Button.s11:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                                            <Setter Property="Background" Value="#E55563"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <Button.Theme>
                                                        <ControlTheme TargetType="Button"
                                                                      BasedOn="{StaticResource {x:Type Button}}"
                                                                      x:DataType="vm:ImageGeneratorViewModel">
                                                            <Setter Property="Background" Value="#DC3545"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="8,4"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="5"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"
                                                                                              Content="{TemplateBinding Content}"
                                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                              Name="PART_ContentPresenter"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </ControlTheme>
                                                    </Button.Theme>
                                                </Button>
                                            </Grid>
                                            <!-- Retry Failed Button -->
                                            <Button Content="🔄 Retry Failed"
                                                    Command="{Binding Analyzer.ReprocessAllFailedCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,8,0,0"
                                                    Height="28"
                                                    FontSize="11"
                                                    Background="{StaticResource AccentAmberBrush}"
                                                    Padding="12,4"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Queue Items List - Text Prompt Mode -->
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Background="White"
                                    Margin="0,0,0,10"
                                    IsVisible="{Binding Analyzer.IsTextPromptMode}">
                                <StackPanel>
                                    <TextBlock Text="Queue Items" Theme="{StaticResource HeaderTextStyle}" Padding="15,15,15,0"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250" Padding="15">
                                        <ItemsControl ItemsSource="{Binding PromptQueue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:ImagePromptQueueItem">
                                                    <Border BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="12" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Workflow Badge -->
                                                            <Border Grid.Column="0"
                                                                    Background="{Binding WorkflowBadgeColor}"
                                                                    CornerRadius="4"
                                                                    Padding="6,4"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding WorkflowBadge}"
                                                                           FontWeight="Bold"
                                                                           FontSize="10"
                                                                           Foreground="White"/>
                                                            </Border>
                                                            <!-- Item Info -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DisplayPrompt}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="300"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding StyleName}"
                                                                               FontSize="10"
                                                                               Foreground="#666"
                                                                               IsVisible="{Binding StyleNameVisibility, Converter={x:Static conv:WpfConverters.VisibilityToBool}}"/>
                                                                    <TextBlock Text="{Binding AspectRatioDisplay}"
                                                                               FontSize="10"
                                                                               Foreground="#666"
                                                                               Margin="5,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <!-- Status / Thumbnail -->
                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Margin="10,0">
                                                                <!-- Show status text when NOT completed -->
                                                                <TextBlock Text="{Binding StatusDisplay}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding StatusColor}"
                                                                           Classes="s12"
                                                                           Classes.s12_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Completed}">
                                                                    <TextBlock.Styles>
                                                                        <Style Selector="TextBlock.s12.s12_0" x:DataType="m:ImagePromptQueueItem">
                                                                            <Setter Property="IsVisible" Value="False"/>
                                                                        </Style>
                                                                    </TextBlock.Styles>
                                                                    <TextBlock.Theme>
                                                                        <ControlTheme TargetType="TextBlock" x:DataType="m:ImagePromptQueueItem">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                        </ControlTheme>
                                                                    </TextBlock.Theme>
                                                                </TextBlock>
                                                                <!-- Progress bar during processing -->
                                                                <ProgressBar Value="{Binding Progress}"
                                                                             Width="50"
                                                                             Height="12"
                                                                             Margin="5,0"
                                                                             Classes="s13"
                                                                             Classes.s13_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Processing}">
                                                                    <ProgressBar.Styles>
                                                                        <Style Selector="ProgressBar.s13.s13_0" x:DataType="m:ImagePromptQueueItem">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                        </Style>
                                                                    </ProgressBar.Styles>
                                                                    <ProgressBar.Theme>
                                                                        <ControlTheme TargetType="ProgressBar"
                                                                                      BasedOn="{StaticResource {x:Type ProgressBar}}"
                                                                                      x:DataType="m:ImagePromptQueueItem">
                                                                            <Setter Property="IsVisible" Value="False"/>
                                                                        </ControlTheme>
                                                                    </ProgressBar.Theme>
                                                                </ProgressBar>
                                                                <!-- Clickable thumbnail when completed -->
                                                                <Button Command="{Binding $parent[Window].((vm:ImageGeneratorViewModel)DataContext).SelectQueueResultCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        ToolTip.Tip="Click to open the full-size image (also loads it into Latest Result)"
                                                                        Padding="0"
                                                                        Classes="s14"
                                                                        Classes.s14_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Completed}">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button.s14.s14_0" x:DataType="m:ImagePromptQueueItem">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                        </Style>
                                                                    </Button.Styles>
                                                                    <Button.Theme>
                                                                        <ControlTheme TargetType="Button"
                                                                                      BasedOn="{StaticResource {x:Type Button}}"
                                                                                      x:DataType="m:ImagePromptQueueItem">
                                                                            <Setter Property="IsVisible" Value="False"/>
                                                                        </ControlTheme>
                                                                    </Button.Theme>
                                                                    <Image Source="{Binding ThumbnailImage, Converter={StaticResource PathToBitmapConverter}}"
                                                                           Height="50"
                                                                           Stretch="Uniform"/>
                                                                </Button>
                                                            </StackPanel>
                                                            <!-- Retry / Remove Buttons -->
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="🔄"
                                                                        Command="{Binding $parent[Window].((vm:ImageGeneratorViewModel)DataContext).RetryQueueItemCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="5"
                                                                        ToolTip.Tip="Retry failed item"
                                                                        FontSize="12"
                                                                        Cursor="Hand"
                                                                        Classes="s15"
                                                                        Classes.s15_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Failed}">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button.s15.s15_0" x:DataType="m:ImagePromptQueueItem">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                        </Style>
                                                                    </Button.Styles>
                                                                    <Button.Theme>
                                                                        <ControlTheme TargetType="Button"
                                                                                      BasedOn="{StaticResource {x:Type Button}}"
                                                                                      x:DataType="m:ImagePromptQueueItem">
                                                                            <Setter Property="IsVisible" Value="False"/>
                                                                        </ControlTheme>
                                                                    </Button.Theme>
                                                                </Button>
                                                                <Button Content="❌"
                                                                        Command="{Binding $parent[Window].((vm:ImageGeneratorViewModel)DataContext).RemoveFromQueueCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="5"
                                                                        ToolTip.Tip="Remove from queue"
                                                                        FontSize="12"
                                                                        Cursor="Hand"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            <!-- Queue Items List - Image Analysis Mode -->
                            <Border x:Name="AnalyzerQueueBorder"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Background="White"
                                    Margin="0,0,0,10"
                                    IsVisible="{Binding Analyzer.IsImageAnalysisMode}">
                                <StackPanel>
                                    <TextBlock Text="Queue Items" Theme="{StaticResource HeaderTextStyle}" Padding="15,15,15,0"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250" Padding="15">
                                        <ItemsControl ItemsSource="{Binding Analyzer.QueueItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:ImageAnalyzerQueueItem">
                                                    <Border BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="12" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Workflow Badge -->
                                                            <Border Grid.Column="0"
                                                                    Background="{Binding WorkflowBadgeColor}"
                                                                    CornerRadius="4"
                                                                    Padding="6,4"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding WorkflowBadge}"
                                                                           FontWeight="Bold"
                                                                           FontSize="10"
                                                                           Foreground="White"/>
                                                            </Border>
                                                            <!-- Item Info -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DisplayPrompt}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="300"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding StyleName}"
                                                                               FontSize="10"
                                                                               Foreground="#666"
                                                                               IsVisible="{Binding StyleNameVisibility, Converter={x:Static conv:WpfConverters.VisibilityToBool}}"/>
                                                                    <TextBlock Text="{Binding AspectRatioDisplay}"
                                                                               FontSize="10"
                                                                               Foreground="#666"
                                                                               Margin="5,0,0,0"/>
                                                                </StackPanel>
                                                                <!-- Output Image Thumbnail -->
                                                                <Button Command="{Binding $parent[Window].((vm:ImageGeneratorViewModel)DataContext).Analyzer.SelectQueueResultCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Padding="0"
                                                                        Margin="0,8,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        ToolTip.Tip="Click to open the full-size image (also loads it into Latest Result)"
                                                                        Classes="s16"
                                                                        Classes.s16_0="{Binding HasOutputImage}">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button.s16.s16_0" x:DataType="m:ImageAnalyzerQueueItem">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                        </Style>
                                                                    </Button.Styles>
                                                                    <Button.Theme>
                                                                        <ControlTheme TargetType="Button"
                                                                                      BasedOn="{StaticResource {x:Type Button}}"
                                                                                      x:DataType="m:ImageAnalyzerQueueItem">
                                                                            <Setter Property="IsVisible" Value="False"/>
                                                                        </ControlTheme>
                                                                    </Button.Theme>
                                                                    <Image Source="{Binding OutputImageThumbnail, Converter={StaticResource PathToBitmapConverter}}"
                                                                           Stretch="Uniform"
                                                                           Height="50"/>
                                                                </Button>
                                                            </StackPanel>
                                                            <!-- Status -->
                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Margin="10,0">
                                                                <TextBlock Text="{Binding StatusDisplay}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding StatusColor}"/>
                                                                <ProgressBar Value="{Binding Progress}"
                                                                             Width="50"
                                                                             Height="12"
                                                                             Margin="5,0"
                                                                             Classes="s17"
                                                                             Classes.s17_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Processing}">
                                                                    <ProgressBar.Styles>
                                                                        <Style Selector="ProgressBar.s17.s17_0" x:DataType="m:ImageAnalyzerQueueItem">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                        </Style>
                                                                    </ProgressBar.Styles>
                                                                    <ProgressBar.Theme>
                                                                        <ControlTheme TargetType="ProgressBar"
                                                                                      BasedOn="{StaticResource {x:Type ProgressBar}}"
                                                                                      x:DataType="m:ImageAnalyzerQueueItem">
                                                                            <Setter Property="IsVisible" Value="False"/>
                                                                        </ControlTheme>
                                                                    </ProgressBar.Theme>
                                                                </ProgressBar>
                                                            </StackPanel>
                                                            <!-- Remove Button -->
                                                            <Button Grid.Column="3"
                                                                    Content="❌"
                                                                    Command="{Binding $parent[Window].((vm:ImageGeneratorViewModel)DataContext).Analyzer.RemoveFromQueueCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="5"
                                                                    ToolTip.Tip="Remove from queue"
                                                                    FontSize="12"
                                                                    Cursor="Hand"
                                                                    Classes="s18"
                                                                    Classes.s18_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Processing}">
                                                                <Button.Styles>
                                                                    <Style Selector="Button.s18.s18_0" x:DataType="m:ImageAnalyzerQueueItem">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </Style>
                                                                </Button.Styles>
                                                                <Button.Theme>
                                                                    <ControlTheme TargetType="Button"
                                                                                  BasedOn="{StaticResource {x:Type Button}}"
                                                                                  x:DataType="m:ImageAnalyzerQueueItem">
                                                                        <Setter Property="IsVisible" Value="True"/>
                                                                    </ControlTheme>
                                                                </Button.Theme>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            <!-- Queue Control Buttons - Text Prompt Mode -->
                            <Border Theme="{StaticResource SectionPanelStyle}" IsVisible="{Binding Analyzer.IsTextPromptMode}">
                                <StackPanel>
                                    <TextBlock Text="Queue Controls" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="Clear Queue"
                                                Command="{Binding ClearQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                Margin="0,0,5,0"
                                                Height="38"
                                                Classes="s19">
                                            <Button.Styles>
                                                <Style Selector="Button.s19:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="#E55563"/>
                                                </Style>
                                            </Button.Styles>
                                            <Button.Theme>
                                                <ControlTheme TargetType="Button"
                                                              BasedOn="{StaticResource SecondaryButtonStyle}"
                                                              x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                </ControlTheme>
                                            </Button.Theme>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Content="Open Folder"
                                                Command="{Binding OpenResultFolderCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                IsEnabled="{Binding HasResultImage}"
                                                Margin="5,0,0,0"
                                                Height="38"
                                                Theme="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Queue Control Buttons - Image Analysis Mode -->
                            <Border Theme="{StaticResource SectionPanelStyle}" IsVisible="{Binding Analyzer.IsImageAnalysisMode}">
                                <StackPanel>
                                    <TextBlock Text="Queue Controls" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="Clear Queue"
                                                Command="{Binding Analyzer.ClearQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                Margin="0,0,5,0"
                                                Height="38"
                                                Classes="s20">
                                            <Button.Styles>
                                                <Style Selector="Button.s20:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="#E55563"/>
                                                </Style>
                                            </Button.Styles>
                                            <Button.Theme>
                                                <ControlTheme TargetType="Button"
                                                              BasedOn="{StaticResource SecondaryButtonStyle}"
                                                              x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                </ControlTheme>
                                            </Button.Theme>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Content="Open Folder"
                                                Command="{Binding Analyzer.OpenResultFolderCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                IsEnabled="{Binding Analyzer.HasResultImage}"
                                                Margin="5,0,0,0"
                                                Height="38"
                                                Theme="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Result Preview - Text Prompt Mode -->
                            <Border Theme="{StaticResource SectionPanelStyle}" IsVisible="{Binding Analyzer.IsTextPromptMode}">
                                <StackPanel>
                                    <TextBlock Text="Latest Result" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="2"
                                            Background="White"
                                            Height="200"
                                            CornerRadius="5"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Result will appear here"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#999"
                                                       FontStyle="Italic"
                                                       FontSize="13"
                                                       Classes="s21"
                                                       Classes.s21_0="{Binding !HasResultImage}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s21.s21_0" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <Button Command="{Binding OpenResultImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="Click to open in image viewer"
                                                    Padding="0">
                                                <Image Source="{Binding ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="Uniform"
                                                       Margin="5"
                                                       IsVisible="{Binding HasResultImage}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="🎥 Camera Angle"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SendToCameraAngleCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                IsEnabled="{Binding HasResultImage}"
                                                Margin="0,0,4,0"/>
                                        <Button Grid.Column="1"
                                                Content="🎬 Video Generator"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SendToVideoGeneratorCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                IsEnabled="{Binding HasResultImage}"
                                                Margin="4,0,4,0"/>
                                        <Button Grid.Column="2"
                                                Content="📖 Story"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SendToStoryCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                IsEnabled="{Binding HasResultImage}"
                                                Margin="4,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ImageInfo}"
                                               FontStyle="Italic"
                                               Foreground="#666"
                                               FontSize="10"
                                               Margin="0,8,0,0"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Result Preview - Image Analysis Mode -->
                            <Border Theme="{StaticResource SectionPanelStyle}" IsVisible="{Binding Analyzer.IsImageAnalysisMode}">
                                <StackPanel>
                                    <TextBlock Text="Latest Result" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="2"
                                            Background="White"
                                            Height="200"
                                            CornerRadius="5"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Result will appear here"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#999"
                                                       FontStyle="Italic"
                                                       FontSize="13"
                                                       Classes="s22"
                                                       Classes.s22_0="{Binding !Analyzer.HasResultPreview}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s22.s22_0" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <Button Command="{Binding Analyzer.OpenResultImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="Click to open in image viewer"
                                                    Padding="0">
                                                <Image Source="{Binding Analyzer.ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="Uniform"
                                                       Margin="5"
                                                       IsVisible="{Binding Analyzer.HasResultPreview}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="🎥 Camera Angle"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SendToCameraAngleCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                IsEnabled="{Binding Analyzer.HasResultImage}"
                                                Margin="0,0,4,0"/>
                                        <Button Grid.Column="1"
                                                Content="🎬 Video Generator"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SendToVideoGeneratorCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                IsEnabled="{Binding Analyzer.HasResultImage}"
                                                Margin="4,0,4,0"/>
                                        <Button Grid.Column="2"
                                                Content="📖 Story"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SendToStoryCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                IsEnabled="{Binding Analyzer.HasResultImage}"
                                                Margin="4,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Analyzer.ImageInfo}"
                                               FontStyle="Italic"
                                               Foreground="#666"
                                               FontSize="10"
                                               Margin="0,8,0,0"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- Tab 3.5: Story Image Generator Q (Qwen Rapid Edit) -->
            <TabItem Header="📖 Story Image Q" IsVisible="{Binding IsCreateGroup}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">
                        <!-- Header with Workflow Selector and Settings Toggle -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="✨ Story Image Generator Q"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentVioletBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Workflow selector -->
                                <TextBlock Text="Workflow:"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{x:Static vm:StoryImageGeneratorQViewModel.WorkflowModes}"
                                          SelectedItem="{Binding StoryGeneratorQ.SelectedWorkflowMode, Mode=TwoWay}"
                                          Width="120"
                                          Height="32"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          FontSize="12"/>
                                <!-- Settings gear -->
                                <Button Command="{Binding StoryGeneratorQ.ToggleSettingsVisibilityCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderThickness="0"
                                        Classes="s23">
                                    <Button.Styles>
                                        <Style Selector="Button.s23:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                        </Style>
                                    </Button.Styles>
                                    <Button.Content>
                                        <TextBlock Text="⚙️" FontSize="20"/>
                                    </Button.Content>
                                    <Button.Theme>
                                        <ControlTheme TargetType="Button"
                                                      BasedOn="{StaticResource {x:Type Button}}"
                                                      x:DataType="vm:ImageGeneratorViewModel">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                              Name="PART_ContentPresenter"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </ControlTheme>
                                    </Button.Theme>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- Settings Panel (Collapsible) -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20"
                                Classes="s24"
                                Classes.s24_0="{Binding StoryGeneratorQ.SettingsVisible}">
                            <Border.Styles>
                                <Style Selector="Border.s24.s24_0" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="True"/>
                                </Style>
                            </Border.Styles>
                            <Border.Theme>
                                <ControlTheme TargetType="Border" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="False"/>
                                </ControlTheme>
                            </Border.Theme>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Steps -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,15,0">
                                    <TextBlock Text="Steps"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding StoryGeneratorQ.Steps, Mode=TwoWay}"
                                                Minimum="1"
                                                Maximum="20"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StoryGeneratorQ.Steps}"
                                                   Margin="8,0,0,0"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- CFG -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,15,0">
                                    <TextBlock Text="CFG"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding StoryGeneratorQ.Cfg, Mode=TwoWay}"
                                                Minimum="1"
                                                Maximum="10"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StoryGeneratorQ.Cfg, StringFormat={}{0:F1}}"
                                                   Margin="8,0,0,0"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- Denoise -->
                                <StackPanel Grid.Column="2" Grid.Row="0">
                                    <TextBlock Text="Denoise"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding StoryGeneratorQ.Denoise, Mode=TwoWay}"
                                                Minimum="0"
                                                Maximum="1"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StoryGeneratorQ.Denoise, StringFormat={}{0:F2}}"
                                                   Margin="8,0,0,0"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- Negative Prompt -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="0,15,0,0">
                                    <TextBlock Text="Negative Prompt"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.NegativePrompt, Mode=TwoWay}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Height="60"
                                             Padding="12"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Background="White"
                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                             FontSize="12">
                                        <TextBox.Styles>
                                            <Style Selector="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Styles>
                                    </TextBox>
                                </StackPanel>
                                <!-- LoRA Toggle (FireRed only) -->
                                <StackPanel Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            Grid.Row="2"
                                            Margin="0,12,0,0"
                                            Classes="s25"
                                            Classes.s25_0="{Binding StoryGeneratorQ.ShowLoRAOption}">
                                    <StackPanel.Styles>
                                        <Style Selector="StackPanel.s25.s25_0" x:DataType="vm:ImageGeneratorViewModel">
                                            <Setter Property="IsVisible" Value="True"/>
                                        </Style>
                                    </StackPanel.Styles>
                                    <StackPanel.Theme>
                                        <ControlTheme TargetType="StackPanel" x:DataType="vm:ImageGeneratorViewModel">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </ControlTheme>
                                    </StackPanel.Theme>
                                    <CheckBox Content="Use LoRA"
                                              IsChecked="{Binding StoryGeneratorQ.UseLoRA, Mode=TwoWay}"
                                              FontSize="12"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Krea2 Orientation Panel -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="#C4B5FD"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20"
                                Classes="s26"
                                Classes.s26_0="{Binding StoryGeneratorQ.ShowKrea2Orientation}">
                            <Border.Styles>
                                <Style Selector="Border.s26.s26_0" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="True"/>
                                </Style>
                            </Border.Styles>
                            <Border.Theme>
                                <ControlTheme TargetType="Border" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="False"/>
                                </ControlTheme>
                            </Border.Theme>
                            <StackPanel>
                                <TextBlock Text="📐 Orientation (Krea2 / MOSS)" FontWeight="SemiBold" FontSize="13" Foreground="#6D28D9" Margin="0,0,0,2"/>
                                <TextBlock Text="Canvas every image in the story is rendered at. All sizes sit near 1 MP so the fast few-step passes stay fast."
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{x:Static vm:StoryImageGeneratorQViewModel.Krea2Orientations}"
                                          SelectedItem="{Binding StoryGeneratorQ.Krea2SelectedOrientation, Mode=TwoWay}"
                                          Height="32"
                                          Padding="8,0"
                                          FontSize="12"
                                          HorizontalAlignment="Left"
                                          MinWidth="220"
                                          Background="White"
                                          BorderBrush="#C4B5FD"/>
                            </StackPanel>
                        </Border>
                        <!-- Krea2 LoRA Panel -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="#C4B5FD"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20"
                                Classes="s27"
                                Classes.s27_0="{Binding StoryGeneratorQ.ShowKreaLoraOption}">
                            <Border.Styles>
                                <Style Selector="Border.s27.s27_0" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="True"/>
                                </Style>
                            </Border.Styles>
                            <Border.Theme>
                                <ControlTheme TargetType="Border" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="False"/>
                                </ControlTheme>
                            </Border.Theme>
                            <StackPanel>
                                <TextBlock Text="🔧 Krea2 LoRAs" FontWeight="SemiBold" FontSize="13" Foreground="#6D28D9" Margin="0,0,0,2"/>
                                <TextBlock Text="Trigger word is prepended to every prompt in the story — edit it if the LoRA wants something else, clear it to prepend nothing."
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding StoryGeneratorQ.SelectedKreaLoras}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:KreaLoraSelection">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding $parent[ItemsControl].((vm:ImageGeneratorViewModel)DataContext).StoryGeneratorQ.KreaLoras}"
                                                          SelectedItem="{Binding LoraName, Mode=TwoWay}"
                                                          FontSize="12"
                                                          Height="32"
                                                          Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding TriggerWord, Mode=TwoWay}"
                                                         ToolTip.Tip="Trigger word prepended to the prompt for this LoRA (remembered for next time)"
                                                         FontSize="12"
                                                         Width="110"
                                                         Height="32"
                                                         Margin="0,0,6,0"
                                                         VerticalContentAlignment="Center"/>
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Strength, Mode=TwoWay, StringFormat={}{0:0.##}}"
                                                         ToolTip.Tip="LoRA strength"
                                                         FontSize="12"
                                                         Width="46"
                                                         Height="32"
                                                         Margin="0,0,6,0"
                                                         VerticalContentAlignment="Center"
                                                         TextAlignment="Center"/>
                                                <Button Grid.Column="3"
                                                        Content="✕"
                                                        Command="{Binding $parent[ItemsControl].((vm:ImageGeneratorViewModel)DataContext).StoryGeneratorQ.RemoveKreaLoraCommand}"
                                                        CommandParameter="{Binding}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        ToolTip.Tip="Remove this LoRA"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="➕ Add LoRA"
                                            Command="{Binding StoryGeneratorQ.AddKreaLoraCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Height="30"
                                            Padding="10,5"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Refresh"
                                            Command="{Binding StoryGeneratorQ.RefreshKreaLorasCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Width="60"
                                            Height="30"
                                            Padding="10,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Krea2 Edit Panel (reference image B) -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="#C4B5FD"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20"
                                Classes="s28"
                                Classes.s28_0="{Binding StoryGeneratorQ.ShowKrea2EditOption}">
                            <Border.Styles>
                                <Style Selector="Border.s28.s28_0" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="True"/>
                                </Style>
                            </Border.Styles>
                            <Border.Theme>
                                <ControlTheme TargetType="Border" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="False"/>
                                </ControlTheme>
                            </Border.Theme>
                            <StackPanel>
                                <TextBlock Text="🧑 Krea2 Edit — Reference Image (image B)"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="#6D28D9"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="The story queue's input image is image A (the scene edited each prompt). This reference is the subject swapped in — it stays the same for every image in the run."
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding StoryGeneratorQ.Krea2EditRefImagePath, Mode=TwoWay}"
                                             IsReadOnly="True"
                                             Padding="10"
                                             Background="White"
                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             Height="38"/>
                                    <Button Grid.Column="1"
                                            Content="Browse"
                                            Command="{Binding StoryGeneratorQ.SelectKrea2EditRefImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            Width="80"
                                            Height="38"
                                            FontSize="12"/>
                                    <Border Grid.Column="2"
                                            Width="52"
                                            Height="52"
                                            Margin="8,0,0,0"
                                            Background="White"
                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Image Source="{Binding StoryGeneratorQ.Krea2EditRefImagePreview, Mode=OneWay, Converter={StaticResource PathToBitmapConverter}}"
                                               Stretch="UniformToFill"
                                               Margin="2"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- StoryImageZ Options Panel (Style + LoRA) -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20"
                                Classes="s29"
                                Classes.s29_0="{Binding StoryGeneratorQ.ShowZOptions}">
                            <Border.Styles>
                                <Style Selector="Border.s29.s29_0" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="True"/>
                                </Style>
                            </Border.Styles>
                            <Border.Theme>
                                <ControlTheme TargetType="Border" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="False"/>
                                </ControlTheme>
                            </Border.Theme>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Style selector -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🎨 ZStyle" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding StoryGeneratorQ.ZStyleNames}"
                                              SelectedIndex="{Binding StoryGeneratorQ.ZSelectedStyleIndex, Mode=TwoWay}"
                                              Height="32"
                                              Padding="8,0"
                                              FontSize="12"
                                              Background="White"
                                              BorderBrush="#86EFAC"/>
                                    <TextBlock Text="Workflow from ZStyles folder" FontSize="10" Foreground="#4D7C5F" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- LoRA settings -->
                                <StackPanel Grid.Column="2" Grid.ColumnSpan="1">
                                    <TextBlock Text="🔧 LoRA" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" Margin="0,0,0,8"/>
                                    <CheckBox Content="Enable LoRA"
                                              IsChecked="{Binding StoryGeneratorQ.ZLoraEnabled, Mode=TwoWay}"
                                              FontSize="12"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              Margin="0,0,0,8"/>
                                    <Grid IsVisible="{Binding StoryGeneratorQ.ZLoraEnabled}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding StoryGeneratorQ.ZAvailableLoras}"
                                                  SelectedItem="{Binding StoryGeneratorQ.ZSelectedLora, Mode=TwoWay}"
                                                  Height="32"
                                                  Padding="8,0"
                                                  FontSize="11"
                                                  Background="White"
                                                  BorderBrush="#86EFAC"
                                                  Margin="0,0,6,0"/>
                                        <Button Grid.Column="1"
                                                Content="↻"
                                                Command="{Binding StoryGeneratorQ.RefreshZLorasCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                Width="32"
                                                Height="32"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Background="{StaticResource SuccessBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Classes="t30">
                                            <Button.Styles>
                                                <Style Selector="Button.t30:pointerover">
                                                    <Setter Property="Background" Value="#15803D"/>
                                                </Style>
                                            </Button.Styles>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          Name="PART_ContentPresenter"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Theme>
                                                <ControlTheme TargetType="Button"/>
                                            </Button.Theme>
                                        </Button>
                                    </Grid>
                                    <StackPanel IsVisible="{Binding StoryGeneratorQ.ZLoraEnabled}" Margin="0,8,0,0">
                                        <TextBlock Text="Strength" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding StoryGeneratorQ.ZLoraStrengthModel, Mode=TwoWay}"
                                                    Minimum="0"
                                                    Maximum="2"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StoryGeneratorQ.ZLoraStrengthModel, StringFormat={}{0:F2}}"
                                                       Margin="8,0,0,0"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SuccessTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Orientation selector -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="📐 Orientation" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{x:Static vm:StoryImageGeneratorQViewModel.ZOrientations}"
                                              SelectedItem="{Binding StoryGeneratorQ.ZSelectedOrientation, Mode=TwoWay}"
                                              Height="32"
                                              Padding="8,0"
                                              FontSize="12"
                                              Background="White"
                                              BorderBrush="#86EFAC"/>
                                    <TextBlock Text="Portrait · Landscape · Square" FontSize="10" Foreground="#4D7C5F" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Main Content Area -->
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Left Column - File Selection -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📝 Story Prompts"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,15"/>
                                    <!-- Input Image Selection (moved up) -->
                                    <TextBlock Text="Input Image" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding StoryGeneratorQ.InputImagePath, Mode=TwoWay}"
                                                 IsReadOnly="True"
                                                 Padding="10"
                                                 Background="{StaticResource SurfaceAltBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="11"
                                                 Height="38"/>
                                        <Button Grid.Column="1"
                                                Content="Browse"
                                                Command="{Binding StoryGeneratorQ.SelectInputImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                Margin="8,0,0,0"
                                                Width="80"
                                                Height="38"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                BorderThickness="0"
                                                FontSize="12"
                                                Theme="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                    <!-- Character Name Input -->
                                    <TextBlock Text="Character Name (optional)"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.CharacterName, Mode=TwoWay}"
                                             Padding="10"
                                             Background="{StaticResource SurfaceAltBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             Height="38"
                                             Margin="0,0,0,10"
                                             ToolTip.Tip="e.g. Tara — replaces generic character references (like 'a woman') with this name in every scene"/>
                                    <!-- Character Clothing Input -->
                                    <TextBlock Text="Character Clothing (optional)"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.CharacterClothing, Mode=TwoWay}"
                                             Padding="10"
                                             Background="{StaticResource SurfaceAltBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             Height="38"
                                             Margin="0,0,0,10"
                                             ToolTip.Tip="e.g. a red leather jacket and blue jeans — keeps the character in this same outfit across every scene"/>
                                    <!-- Story Concept Input -->
                                    <TextBlock Text="Story Concept (optional)"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.StoryConcept, Mode=TwoWay}"
                                             Padding="10"
                                             Background="{StaticResource SurfaceAltBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             Height="38"
                                             Margin="0,0,0,10"
                                             ToolTip.Tip="e.g. revenge thriller, romantic journey, sci-fi survival"/>
                                    <!-- Story Prompt Template Selector -->
                                    <TextBlock Text="Prompt Style" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding StoryGeneratorQ.StoryPromptTemplates}"
                                              SelectedItem="{Binding StoryGeneratorQ.SelectedStoryPromptTemplate, Mode=TwoWay}"
                                              Height="38"
                                              FontSize="11"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,0,10"
                                              ToolTip.Tip="System prompt sent to Qwen VL. FFLF Continuous Shot generates 10 keyframes (5s apart) for one continuous video shot."/>
                                    <!-- Analyze Image with Qwen VL Button (NEW) -->
                                    <Button Content="🔍 Analyze Image with Qwen VL"
                                            Command="{Binding StoryGeneratorQ.AnalyzeImageWithQwenVLCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            HorizontalAlignment="Stretch"
                                            Height="44"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Margin="0,0,0,5"
                                            Classes="s31">
                                        <Button.Styles>
                                            <Style Selector="Button.s31:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                                            </Style>
                                            <Style Selector="Button.s31:disabled" x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="#CBD5E1"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"
                                                          BasedOn="{StaticResource {x:Type Button}}"
                                                          x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="8"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Content="{TemplateBinding Content}"
                                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                  Name="PART_ContentPresenter"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </ControlTheme>
                                        </Button.Theme>
                                    </Button>
                                    <!-- Analysis Progress (shown when analyzing) -->
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="#FCD34D"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            IsVisible="{Binding StoryGeneratorQ.IsAnalyzingImage}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding StoryGeneratorQ.AnalysisStatus}"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       Margin="0,0,0,6"
                                                       TextAlignment="Center"
                                                       Foreground="#92400E"/>
                                            <ProgressBar IsIndeterminate="True" Height="18" Foreground="{StaticResource AccentAmberBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Prompt JSON File (moved below analyze button) -->
                                    <TextBlock Text="Prompts JSON File" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding StoryGeneratorQ.PromptJsonFilePath, Mode=TwoWay}"
                                                 IsReadOnly="True"
                                                 Padding="10"
                                                 Background="{StaticResource SurfaceAltBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="11"
                                                 Height="38"/>
                                        <Button Grid.Column="1"
                                                Content="Browse"
                                                Command="{Binding StoryGeneratorQ.SelectPromptJsonCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                Margin="8,0,0,0"
                                                Width="80"
                                                Height="38"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                BorderThickness="0"
                                                FontSize="12"
                                                Theme="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                    <!-- Add Prompts from JSON Button -->
                                    <Button Content="📥 Add Prompts from JSON"
                                            Command="{Binding StoryGeneratorQ.LoadPromptsCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="48"
                                            Background="{StaticResource BrandBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Theme="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                                <!-- Right Column - Image Preview -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="🖼️ Image Preview"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,15"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="2"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="12"
                                            Height="220">
                                        <Grid>
                                            <TextBlock Text="No image selected"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="13"
                                                       Classes="s32"
                                                       Classes.s32_0="{Binding StoryGeneratorQ.InputImagePreview, Converter={x:Static ObjectConverters.IsNull}}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.s32.s32_0" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                                <TextBlock.Theme>
                                                    <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </ControlTheme>
                                                </TextBlock.Theme>
                                            </TextBlock>
                                            <Image Source="{Binding StoryGeneratorQ.InputImagePreview, Mode=OneWay, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   Margin="4"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Queue Management Section -->
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="24"
                                Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="📋 Queue Management"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,15"/>
                                <!-- Queue Controls -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="🚀 Generate Story"
                                            Command="{Binding StoryGeneratorQ.ProcessQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Height="44"
                                            Background="{StaticResource BrandBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Margin="0,0,8,0"
                                            Theme="{StaticResource PrimaryButtonStyle}"/>
                                    <Button Grid.Column="1"
                                            Content="📂 Output Folder"
                                            Command="{Binding StoryGeneratorQ.OpenOutputFolderCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Height="44"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            BorderThickness="0"
                                            FontSize="13"
                                            Margin="0,0,8,0"
                                            Theme="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Grid.Column="2"
                                            Content="🗑️ Clear Queue"
                                            Command="{Binding StoryGeneratorQ.ClearQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Height="44"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            Foreground="{StaticResource DangerBrush}"
                                            BorderThickness="0"
                                            FontSize="13"
                                            Classes="s33">
                                        <Button.Styles>
                                            <Style Selector="Button.s33:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="#FECACA"/>
                                            </Style>
                                            <Style Selector="Button.s33:disabled" x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                <Setter Property="Foreground" Value="#FCA5A5"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"
                                                          BasedOn="{StaticResource SecondaryButtonStyle}"
                                                          x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </ControlTheme>
                                        </Button.Theme>
                                    </Button>
                                </Grid>
                                <!-- Pause/Resume Controls (Q) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" IsVisible="{Binding StoryGeneratorQ.IsProcessingQueue}">
                                    <Button Content="⏸ Pause"
                                            Width="100"
                                            Height="32"
                                            Margin="0,0,8,0"
                                            Command="{Binding StoryGeneratorQ.PauseQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Background="{StaticResource AccentAmberBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"/>
                                    <Button Content="▶ Resume"
                                            Width="100"
                                            Height="32"
                                            Margin="0,0,8,0"
                                            Command="{Binding StoryGeneratorQ.ResumeQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Background="{StaticResource SuccessBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"/>
                                </StackPanel>
                                <!-- Queue Status -->
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Queue Status"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource AccentAmberBrush}"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                Margin="10,0">
                                            <TextBlock Text="{Binding StoryGeneratorQ.QueuedCount, StringFormat={}Remaining: {0}}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StoryGeneratorQ.QueuedCount, StringFormat={}Queued: {0}}"
                                                   Margin="10,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding StoryGeneratorQ.CompletedCount, StringFormat={}Completed: {0}}"
                                                   Margin="10,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SuccessTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding StoryGeneratorQ.FailedCount, StringFormat={}Failed: {0}}"
                                                   Margin="10,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <!-- Queue Progress -->
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource AccentAmberBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,15"
                                        IsVisible="{Binding StoryGeneratorQ.IsProcessingQueue}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StoryGeneratorQ.QueueProgressText, StringFormat={}Processing: {0}}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Foreground="#92400E"
                                                   Margin="0,0,0,6"/>
                                        <ProgressBar Value="{Binding StoryGeneratorQ.QueueProgress, Mode=OneWay}"
                                                     Maximum="{Binding StoryGeneratorQ.QueueTotal, Mode=OneWay}"
                                                     Height="6"
                                                     Foreground="{StaticResource AccentVioletBrush}"
                                                     Background="{StaticResource SurfaceAltBrush}"
                                                     BorderThickness="0"/>
                                        <TextBlock Text="{Binding StoryGeneratorQ.CurrentQueueItem.Prompt, StringFormat={}Current: {0}}"
                                                   FontSize="10"
                                                   Foreground="#92400E"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Queue Items List (compact) -->
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding StoryGeneratorQ.QueueItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:StoryPromptItem">
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Index, StringFormat='#{0}'}"
                                                                       FontWeight="Bold"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,10,0"
                                                                       Foreground="{StaticResource AccentVioletBrush}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Prompt}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       Classes="s34"
                                                                       Classes.s34_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Completed}"
                                                                       Classes.s34_1="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Processing}"
                                                                       Classes.s34_2="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Failed}">
                                                                <TextBlock.Styles>
                                                                    <Style Selector="TextBlock.s34.s34_0" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    </Style>
                                                                    <Style Selector="TextBlock.s34.s34_1" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentVioletBrush}"/>
                                                                    </Style>
                                                                    <Style Selector="TextBlock.s34.s34_2" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </Style>
                                                                </TextBlock.Styles>
                                                                <TextBlock.Theme>
                                                                    <ControlTheme TargetType="TextBlock" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="Foreground" Value="#374151"/>
                                                                    </ControlTheme>
                                                                </TextBlock.Theme>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding StatusDisplay}"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- Storyboard View (visible once items are loaded) -->
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="24"
                                Margin="0,20,0,0"
                                Classes="s35"
                                Classes.s35_0="{Binding StoryGeneratorQ.HasAnyItems}">
                            <Border.Styles>
                                <Style Selector="Border.s35.s35_0" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="True"/>
                                </Style>
                            </Border.Styles>
                            <Border.Theme>
                                <ControlTheme TargetType="Border" x:DataType="vm:ImageGeneratorViewModel">
                                    <Setter Property="IsVisible" Value="False"/>
                                </ControlTheme>
                            </Border.Theme>
                            <StackPanel>
                                <!-- Storyboard header + Save Final controls -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="🎬 Storyboard"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Save to folder:"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding StoryGeneratorQ.FinalFolderName, Mode=TwoWay}"
                                                 Width="180"
                                                 Height="36"
                                                 Padding="10,0"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="12"
                                                 Background="{StaticResource SurfaceAltBrush}"
                                                 BorderBrush="{StaticResource BorderStrongBrush}"
                                                 Margin="0,0,10,0">
                                            <TextBox.Styles>
                                                <Style Selector="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </TextBox.Styles>
                                        </TextBox>
                                        <Button Content="💾 Save Final Storyboard"
                                                Command="{Binding StoryGeneratorQ.SaveFinalStoryboardCommand}"
                                                Height="36"
                                                Padding="16,0"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Classes="s36">
                                            <Button.Styles>
                                                <Style Selector="Button.s36:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                </Style>
                                                <Style Selector="Button.s36:disabled" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="#CBD5E1"/>
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                </Style>
                                            </Button.Styles>
                                            <Button.Theme>
                                                <ControlTheme TargetType="Button"
                                                              BasedOn="{StaticResource {x:Type Button}}"
                                                              x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="8"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Content="{TemplateBinding Content}"
                                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                      Name="PART_ContentPresenter"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </ControlTheme>
                                            </Button.Theme>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- Hint text -->
                                <TextBlock Text="Click an image to open it. Edit the prompt below each image, then click Regenerate to redo that scene."
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,16"/>
                                <!-- Storyboard cards grid -->
                                <ItemsControl ItemsSource="{Binding StoryGeneratorQ.QueueItems}" x:Name="StoryboardQItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:StoryPromptItem">
                                            <Border Width="240"
                                                    Margin="6,6"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <StackPanel Margin="12">
                                                    <!-- Scene label + delete button + status badge -->
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Index, StringFormat='Scene #{0}'}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource AccentVioletBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Delete X button -->
                                                        <Button HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,-6,-6,0"
                                                                Width="18"
                                                                Height="18"
                                                                Padding="0"
                                                                Background="{StaticResource BorderBrush}"
                                                                BorderThickness="0"
                                                                FontSize="9"
                                                                FontWeight="Bold"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Content="✕"
                                                                ToolTip.Tip="Delete scene"
                                                                Command="{Binding $parent[ItemsControl].((vm:ImageGeneratorViewModel)DataContext).StoryGeneratorQ.DeleteItemCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="s37">
                                                            <Button.Styles>
                                                                <Style Selector="Button.s37:pointerover" x:DataType="m:StoryPromptItem">
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Style>
                                                            </Button.Styles>
                                                            <Button.Theme>
                                                                <ControlTheme TargetType="Button"
                                                                              BasedOn="{StaticResource {x:Type Button}}"
                                                                              x:DataType="m:StoryPromptItem">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        CornerRadius="9"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                                      VerticalAlignment="Center"
                                                                                                      Content="{TemplateBinding Content}"
                                                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                                      Name="PART_ContentPresenter"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </ControlTheme>
                                                            </Button.Theme>
                                                        </Button>
                                                        <Border HorizontalAlignment="Right"
                                                                CornerRadius="8"
                                                                Padding="7,2"
                                                                Margin="0,0,24,0"
                                                                Classes="s38"
                                                                Classes.s38_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Completed}"
                                                                Classes.s38_1="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Processing}"
                                                                Classes.s38_2="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Failed}">
                                                            <Border.Styles>
                                                                <Style Selector="Border.s38.s38_0" x:DataType="m:StoryPromptItem">
                                                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                </Style>
                                                                <Style Selector="Border.s38.s38_1" x:DataType="m:StoryPromptItem">
                                                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                </Style>
                                                                <Style Selector="Border.s38.s38_2" x:DataType="m:StoryPromptItem">
                                                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                </Style>
                                                            </Border.Styles>
                                                            <Border.Theme>
                                                                <ControlTheme TargetType="Border" x:DataType="m:StoryPromptItem">
                                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                                </ControlTheme>
                                                            </Border.Theme>
                                                            <TextBlock FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Status}"
                                                                       Classes="s39"
                                                                       Classes.s39_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Completed}"
                                                                       Classes.s39_1="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Processing}"
                                                                       Classes.s39_2="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Failed}">
                                                                <TextBlock.Styles>
                                                                    <Style Selector="TextBlock.s39.s39_0" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    </Style>
                                                                    <Style Selector="TextBlock.s39.s39_1" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentVioletBrush}"/>
                                                                    </Style>
                                                                    <Style Selector="TextBlock.s39.s39_2" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </Style>
                                                                </TextBlock.Styles>
                                                                <TextBlock.Theme>
                                                                    <ControlTheme TargetType="TextBlock" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                                    </ControlTheme>
                                                                </TextBlock.Theme>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Image thumbnail area (click to open) -->
                                                    <Border Height="195"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Margin="0,0,0,10"
                                                            Cursor="Hand"
                                                            ctrl:Click.Command="{Binding OpenImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}">
                                                        <Grid>
                                                            <!-- Placeholder when not yet completed -->
                                                            <StackPanel HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Classes="s40"
                                                                        Classes.s40_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Completed}">
                                                                <StackPanel.Styles>
                                                                    <Style Selector="StackPanel.s40.s40_0" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </Style>
                                                                </StackPanel.Styles>
                                                                <StackPanel.Theme>
                                                                    <ControlTheme TargetType="StackPanel" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="IsVisible" Value="True"/>
                                                                    </ControlTheme>
                                                                </StackPanel.Theme>
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           FontSize="36"
                                                                           Classes="s41"
                                                                           Classes.s41_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Processing}"
                                                                           Classes.s41_1="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Failed}">
                                                                    <TextBlock.Styles>
                                                                        <Style Selector="TextBlock.s41.s41_0" x:DataType="m:StoryPromptItem">
                                                                            <Setter Property="Text" Value="⚙️"/>
                                                                        </Style>
                                                                        <Style Selector="TextBlock.s41.s41_1" x:DataType="m:StoryPromptItem">
                                                                            <Setter Property="Text" Value="❌"/>
                                                                        </Style>
                                                                    </TextBlock.Styles>
                                                                    <TextBlock.Theme>
                                                                        <ControlTheme TargetType="TextBlock" x:DataType="m:StoryPromptItem">
                                                                            <Setter Property="Text" Value="🖼️"/>
                                                                        </ControlTheme>
                                                                    </TextBlock.Theme>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Status}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,4,0,0"/>
                                                                <!-- Progress bar while processing -->
                                                                <ProgressBar Value="{Binding Progress}"
                                                                             Maximum="100"
                                                                             Height="4"
                                                                             Width="120"
                                                                             Margin="0,6,0,0"
                                                                             Foreground="{StaticResource AccentVioletBrush}"
                                                                             Background="{StaticResource BorderBrush}"
                                                                             BorderThickness="0"
                                                                             Classes="s42"
                                                                             Classes.s42_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Processing}">
                                                                    <ProgressBar.Styles>
                                                                        <Style Selector="ProgressBar.s42.s42_0" x:DataType="m:StoryPromptItem">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                        </Style>
                                                                    </ProgressBar.Styles>
                                                                    <ProgressBar.Theme>
                                                                        <ControlTheme TargetType="ProgressBar"
                                                                                      BasedOn="{StaticResource {x:Type ProgressBar}}"
                                                                                      x:DataType="m:StoryPromptItem">
                                                                            <Setter Property="IsVisible" Value="False"/>
                                                                        </ControlTheme>
                                                                    </ProgressBar.Theme>
                                                                </ProgressBar>
                                                            </StackPanel>
                                                            <!-- Generated image -->
                                                            <Image Source="{Binding StoryboardThumbnailImage, Converter={StaticResource PathToBitmapConverter}}"
                                                                   Stretch="Uniform"
                                                                   Margin="4"
                                                                   Classes="s43"
                                                                   Classes.s43_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Completed}">
                                                                <Image.Styles>
                                                                    <Style Selector="Image.s43.s43_0" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="IsVisible" Value="True"/>
                                                                    </Style>
                                                                </Image.Styles>
                                                                <Image.Theme>
                                                                    <ControlTheme TargetType="Image" x:DataType="m:StoryPromptItem">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </ControlTheme>
                                                                </Image.Theme>
                                                            </Image>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Editable prompt -->
                                                    <TextBox Text="{Binding Prompt, Mode=TwoWay}"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="False"
                                                             Height="80"
                                                             Padding="8"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             Background="White"
                                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                                             FontSize="11"
                                                             VerticalContentAlignment="Top"
                                                             Margin="0,0,0,8"
                                                             ToolTip.Tip="Edit this prompt and click Regenerate">
                                                        <TextBox.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </TextBox.Styles>
                                                    </TextBox>
                                                    <!-- Regenerate button -->
                                                    <Button Content="🔄 Regenerate"
                                                            Command="{Binding $parent[ItemsControl].((vm:ImageGeneratorViewModel)DataContext).StoryGeneratorQ.RegenerateItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            Height="32"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Classes="s44">
                                                        <Button.Styles>
                                                            <Style Selector="Button.s44:pointerover" x:DataType="m:StoryPromptItem">
                                                                <Setter Property="Background" Value="{StaticResource AccentIndigoBrush}"/>
                                                            </Style>
                                                            <Style Selector="Button.s44:disabled" x:DataType="m:StoryPromptItem">
                                                                <Setter Property="Background" Value="#CBD5E1"/>
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                            </Style>
                                                        </Button.Styles>
                                                        <Button.Theme>
                                                            <ControlTheme TargetType="Button"
                                                                          BasedOn="{StaticResource {x:Type Button}}"
                                                                          x:DataType="m:StoryPromptItem">
                                                                <Setter Property="Background" Value="{StaticResource AccentIndigoBrush}"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    CornerRadius="6"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center"
                                                                                                  Content="{TemplateBinding Content}"
                                                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                                  Name="PART_ContentPresenter"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </ControlTheme>
                                                        </Button.Theme>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!-- Log Output (Collapsible) -->
                        <Expander Margin="0,20,0,0" Background="Transparent" BorderThickness="0" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="📋 Activity Log" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Expander.Header>
                            <Border Background="{StaticResource PlayerSurfaceBrush}"
                                    BorderBrush="#374151"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,8,0,0">
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding StoryGeneratorQ.LogOutput}"
                                             TextWrapping="Wrap"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="10"
                                             Background="Transparent"
                                             Foreground="{StaticResource BorderStrongBrush}"
                                             BorderThickness="0"
                                             Padding="12"/>
                                </ScrollViewer>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Tab: Amateur Generator -->
            <TabItem Header="📷 Amateur" IsVisible="{Binding IsCreateGroup}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">
                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="✨ Amateur Photo Generator"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Saved Prompts Section -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="📝 Saved Prompts"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Select a saved prompt or save current:"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="💾 Save"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AmateurGenerator.SavePromptCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Padding="10,5"
                                            Margin="5,0,5,0"
                                            ToolTip.Tip="Save current prompt settings"
                                            Background="{StaticResource SuccessBrush}"/>
                                    <Button Grid.Column="2"
                                            Content="🗑️ Delete"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AmateurGenerator.DeletePromptCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Padding="10,5"
                                            Margin="0,0,0,0"
                                            ToolTip.Tip="Delete selected saved prompt"
                                            Background="{StaticResource DangerBrush}"/>
                                </Grid>
                                <ComboBox ItemsSource="{Binding AmateurGenerator.SavedPrompts}"
                                          SelectedItem="{Binding AmateurGenerator.SelectedSavedPrompt, Mode=TwoWay}"
                                          SelectedValueBinding="{ReflectionBinding Id}"
                                          Padding="10"
                                          Background="White"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          FontSize="12"
                                          Margin="0,5,0,10"
                                          Height="40">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="m:SavedPrompt">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="10"
                                                           Foreground="#666"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="💡 Tip: Your saved prompts appear here. Click Save to store the current prompt settings."
                                           FontSize="11"
                                           Foreground="#666"
                                           FontStyle="Italic"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Image Analysis & Prompt Enhancement -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="#C7D2FE"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="📷 Image Analysis &amp; Prompt Enhancement"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{StaticResource AccentIndigoBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Upload an image — it will be analyzed by the remote LLaMA server and automatically generate an enhanced prompt."
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <!-- Browse row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding AmateurGenerator.SourceImagePath, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Padding="8"
                                             Background="White"
                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             Height="30"
                                             Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Grid.Column="1"
                                            Content="Browse..."
                                            Command="{Binding AmateurGenerator.BrowseImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Height="30"
                                            Width="80"
                                            Margin="6,0,0,0"
                                            Background="{StaticResource BrandBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Classes="s45">
                                        <Button.Styles>
                                            <Style Selector="Button.s45:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="{StaticResource AccentIndigoBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                </Grid>
                                <!-- Image preview -->
                                <Border BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        Background="White"
                                        Height="160"
                                        CornerRadius="6"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="No image selected — click Browse to upload"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontStyle="Italic"
                                                   FontSize="12"
                                                   Classes="s46"
                                                   Classes.s46_0="{Binding !AmateurGenerator.HasSourceImage}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.s46.s46_0" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                </Style>
                                            </TextBlock.Styles>
                                            <TextBlock.Theme>
                                                <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </ControlTheme>
                                            </TextBlock.Theme>
                                        </TextBlock>
                                        <Image Source="{Binding AmateurGenerator.SourceImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                               Stretch="Uniform"
                                               Margin="5"
                                               IsVisible="{Binding AmateurGenerator.HasSourceImage}"/>
                                    </Grid>
                                </Border>
                                <!-- Analyze button + status -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="🔍 Analyze &amp; Enhance Prompt"
                                            Command="{Binding AmateurGenerator.AnalyzeImageCommand}"
                                            Height="38"
                                            Background="{StaticResource AccentAmberBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Classes="s47">
                                        <Button.Styles>
                                            <Style Selector="Button.s47:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                                            </Style>
                                            <Style Selector="Button.s47:disabled" x:DataType="vm:ImageGeneratorViewModel">
                                                <Setter Property="Background" Value="#CBD5E1"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                    <Border Grid.Column="1"
                                            IsVisible="{Binding AmateurGenerator.IsAnalyzingImage}"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ProgressBar IsIndeterminate="True" Width="80" Height="10" Foreground="{StaticResource AccentAmberBrush}"/>
                                            <TextBlock Text="Analyzing..."
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- Main Controls Panel -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Additional Prompt -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Additional Prompt"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="📋 Paste"
                                                Command="{Binding AmateurGenerator.PasteFromClipboardCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                Width="80"
                                                Height="28"
                                                HorizontalAlignment="Right"
                                                FontSize="11"
                                                Padding="5,0"
                                                Background="#6B7280"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                                    </Grid>
                                    <TextBox Text="{Binding AmateurGenerator.AdditionalPrompt, Mode=TwoWay}"
                                             Height="80"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Padding="12"
                                             FontSize="13"
                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                             Background="White"/>
                                    <TextBlock Text="The photographer prefix will be added automatically"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                                <!-- Orientation Selection -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Image Orientation"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AmateurGenerator.Orientations}"
                                              SelectedIndex="{Binding AmateurGenerator.OrientationIndex}"
                                              FontSize="13"
                                              Padding="10"
                                              Background="White"
                                              BorderBrush="{StaticResource BorderStrongBrush}"/>
                                </StackPanel>
                                <!-- Style Selection -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,0">
                                    <TextBlock Text="Style"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AmateurGenerator.Styles}"
                                              SelectedIndex="{Binding AmateurGenerator.StyleIndex}"
                                              FontSize="13"
                                              Padding="10"
                                              Background="White"
                                              BorderBrush="{StaticResource BorderStrongBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Character LoRA -->
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <CheckBox Content="Character LoRA"
                                          IsChecked="{Binding AmateurGenerator.LoraEnabled, Mode=TwoWay}"
                                          FontWeight="SemiBold"
                                          FontSize="13"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,8"/>
                                <Grid IsVisible="{Binding AmateurGenerator.LoraEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AmateurGenerator.AvailableLoras}"
                                              SelectedItem="{Binding AmateurGenerator.SelectedLora, Mode=TwoWay}"
                                              Padding="8"
                                              Background="White"
                                              BorderBrush="{StaticResource BorderStrongBrush}"
                                              FontSize="12"/>
                                    <Button Grid.Column="1"
                                            Content="↻"
                                            Command="{Binding AmateurGenerator.RefreshLorasCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Width="36"
                                            Margin="6,0,0,0"
                                            Theme="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>
                                <StackPanel IsVisible="{Binding AmateurGenerator.LoraEnabled}" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Strength:"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <Slider Grid.Column="1"
                                                Value="{Binding AmateurGenerator.LoraStrength, Mode=TwoWay}"
                                                Minimum="0"
                                                Maximum="1.5"
                                                TickFrequency="0.05"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AmateurGenerator.LoraStrength, StringFormat='{}{0:F2}'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Width="32"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Add to Queue Button -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="➕ Add to Queue"
                                    Command="{Binding AmateurGenerator.AddToQueueCommand}"
                                    Theme="{StaticResource PrimaryButtonStyle}"
                                    Height="45"
                                    FontSize="15"
                                    Background="{StaticResource SuccessBrush}"/>
                            <Button Grid.Column="1"
                                    Content="▶ Start Queue"
                                    Command="{Binding AmateurGenerator.ProcessQueueCommand}"
                                    Height="45"
                                    Width="130"
                                    Background="{StaticResource SuccessBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Margin="10,0,0,0"
                                    Classes="s48">
                                <Button.Styles>
                                    <Style Selector="Button.s48:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                    </Style>
                                    <Style Selector="Button.s48:disabled" x:DataType="vm:ImageGeneratorViewModel">
                                        <Setter Property="Background" Value="#CCC"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Style>
                                </Button.Styles>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Name="PART_ContentPresenter"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Theme>
                                    <ControlTheme TargetType="Button"/>
                                </Button.Theme>
                            </Button>
                            <Button Grid.Column="2"
                                    Content="⏹ Cancel"
                                    Command="{Binding AmateurGenerator.CancelQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                    Height="45"
                                    Width="90"
                                    Background="{StaticResource DangerBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Margin="8,0,0,0"
                                    Classes="s49">
                                <Button.Styles>
                                    <Style Selector="Button.s49:pointerover" x:DataType="vm:ImageGeneratorViewModel">
                                        <Setter Property="Background" Value="#DC2626"/>
                                    </Style>
                                    <Style Selector="Button.s49:disabled" x:DataType="vm:ImageGeneratorViewModel">
                                        <Setter Property="Background" Value="#CCC"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Style>
                                </Button.Styles>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Name="PART_ContentPresenter"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Theme>
                                    <ControlTheme TargetType="Button"/>
                                </Button.Theme>
                            </Button>
                        </Grid>
                        <!-- Queue Panel -->
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Queue Header -->
                                <Grid Margin="15,12,15,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Queue"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource SuccessBrush}"
                                                CornerRadius="10"
                                                Padding="6,2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AmateurGenerator.QueueCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="processing..."
                                                   FontSize="11"
                                                   Foreground="{StaticResource SuccessTextBrush}"
                                                   FontStyle="Italic"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding AmateurGenerator.IsProcessingQueue}"/>
                                    </StackPanel>
                                    <Button Content="Clear All"
                                            Command="{Binding AmateurGenerator.ClearQueueCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            HorizontalAlignment="Right"
                                            Background="#6B7280"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="10,4"
                                            FontSize="11"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220" Padding="15,0,15,10">
                                    <ItemsControl ItemsSource="{Binding AmateurGenerator.Queue}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:AmateurQueueItem">
                                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Item Info -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayPrompt}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding OrientationDisplay}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding StyleDisplay}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <!-- Status / Progress -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                            <TextBlock Text="{Binding StatusDisplay}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding StatusColor}"
                                                                       Classes="s50"
                                                                       Classes.s50_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Completed}">
                                                                <TextBlock.Styles>
                                                                    <Style Selector="TextBlock.s50.s50_0" x:DataType="m:AmateurQueueItem">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </Style>
                                                                </TextBlock.Styles>
                                                                <TextBlock.Theme>
                                                                    <ControlTheme TargetType="TextBlock" x:DataType="m:AmateurQueueItem">
                                                                        <Setter Property="IsVisible" Value="True"/>
                                                                    </ControlTheme>
                                                                </TextBlock.Theme>
                                                            </TextBlock>
                                                            <ProgressBar Value="{Binding Progress}"
                                                                         Width="50"
                                                                         Height="10"
                                                                         Margin="4,0"
                                                                         Classes="s51"
                                                                         Classes.s51_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Processing}">
                                                                <ProgressBar.Styles>
                                                                    <Style Selector="ProgressBar.s51.s51_0" x:DataType="m:AmateurQueueItem">
                                                                        <Setter Property="IsVisible" Value="True"/>
                                                                    </Style>
                                                                </ProgressBar.Styles>
                                                                <ProgressBar.Theme>
                                                                    <ControlTheme TargetType="ProgressBar"
                                                                                  BasedOn="{StaticResource {x:Type ProgressBar}}"
                                                                                  x:DataType="m:AmateurQueueItem">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </ControlTheme>
                                                                </ProgressBar.Theme>
                                                            </ProgressBar>
                                                        </StackPanel>
                                                        <!-- Thumbnail when completed -->
                                                        <Button Grid.Column="2"
                                                                Command="{Binding OpenImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Click to open image"
                                                                Padding="0"
                                                                Margin="4,0"
                                                                Classes="s52"
                                                                Classes.s52_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Completed}">
                                                            <Button.Styles>
                                                                <Style Selector="Button.s52.s52_0" x:DataType="m:AmateurQueueItem">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                </Style>
                                                            </Button.Styles>
                                                            <Button.Theme>
                                                                <ControlTheme TargetType="Button"
                                                                              BasedOn="{StaticResource {x:Type Button}}"
                                                                              x:DataType="m:AmateurQueueItem">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </ControlTheme>
                                                            </Button.Theme>
                                                            <Image Source="{Binding ThumbnailImage, Converter={StaticResource PathToBitmapConverter}}"
                                                                   Height="44"
                                                                   Stretch="Uniform"/>
                                                        </Button>
                                                        <!-- Remove Button -->
                                                        <Button Grid.Column="3"
                                                                Content="❌"
                                                                Command="{Binding $parent[Window].((vm:ImageGeneratorViewModel)DataContext).AmateurGenerator.RemoveFromQueueCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4"
                                                                ToolTip.Tip="Remove from queue"
                                                                FontSize="11"
                                                                Cursor="Hand"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <!-- Progress Section -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20"
                                IsVisible="{Binding AmateurGenerator.IsProcessing}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Processing..." FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding AmateurGenerator.ProgressPercentage}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{StaticResource SuccessTextBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding AmateurGenerator.ProcessingProgress}"
                                             Maximum="100"
                                             Height="8"
                                             Margin="0,10,0,0"
                                             Background="{StaticResource BorderBrush}"
                                             Foreground="{StaticResource SuccessTextBrush}"/>
                                <TextBlock Text="{Binding AmateurGenerator.ProcessingStatus}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Result Section -->
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20"
                                IsVisible="{Binding AmateurGenerator.HasResultImage}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <TextBlock Text="Generated Image"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Content="Open Folder"
                                            Command="{Binding AmateurGenerator.OpenResultFolderCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Width="100"
                                            Height="32"
                                            Background="#6B7280"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="12"
                                            HorizontalAlignment="Right"
                                            Cursor="Hand"/>
                                </Grid>
                                <Border Grid.Row="1"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Background="White"
                                        HorizontalAlignment="Center">
                                    <Button Command="{Binding AmateurGenerator.OpenResultImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="Click to open in image viewer"
                                            Padding="0">
                                        <Image Source="{Binding AmateurGenerator.ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                               MaxWidth="600"
                                               MaxHeight="400"
                                               Margin="10"/>
                                    </Button>
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding AmateurGenerator.ImageInfo}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,15,0,0"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- Log Output -->
                        <Border Background="{StaticResource PlayerSurfaceBrush}"
                                BorderBrush="#374151"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Log Output"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{StaticResource PlayerTextBrush}"
                                           Margin="0,0,0,10"/>
                                <TextBox Grid.Row="1"
                                         Text="{Binding AmateurGenerator.LogOutput}"
                                         IsReadOnly="True"
                                         Height="150"
                                         TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource PlayerSurfaceBrush}"
                                         Foreground="{StaticResource PlayerTextBrush}"
                                         BorderThickness="0"
                                         FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                         FontSize="11"
                                         Padding="10"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Tab: Camera Angle Generator -->
            <TabItem Header="🎥 Camera Angle" IsVisible="{Binding IsAdvancedGroup}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">
                        <!-- Header -->
                        <TextBlock Text="Camera Angle Generator"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Generate multiple character angles from a single image"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,15"/>
                        <!-- Engine Selection -->
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Engine" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Flux2 Klein generates every angle in one batch. Qwen Image 2.1 runs one submission per angle, slower but a different model."
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding CameraAngle.Engines}"
                                          SelectedItem="{Binding CameraAngle.SelectedEngine}"
                                          FontSize="12"
                                          Padding="6,4"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- Input Section -->
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Input Image"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,10"/>
                                <!-- File Selection Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            Padding="12,10">
                                        <TextBlock Text="{Binding CameraAngle.InputImagePath, FallbackValue='No image selected'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="2"
                                            Content="Browse..."
                                            Command="{Binding CameraAngle.SelectInputImageCommand}"
                                            Background="{StaticResource BrandBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="15,8"
                                            FontSize="12"
                                            FontWeight="SemiBold"/>
                                </Grid>
                                <!-- Image Preview -->
                                <Border Margin="0,15,0,0"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        HorizontalAlignment="Left"
                                        Width="300"
                                        Height="200">
                                    <Grid>
                                        <Image Source="{Binding CameraAngle.InputImagePreview, Converter={StaticResource PathToBitmapConverter}}"
                                               Stretch="Uniform"
                                               Margin="10"/>
                                        <TextBlock Text="No image loaded"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Classes="s53"
                                                   Classes.s53_0="{Binding CameraAngle.InputImagePreview, Converter={x:Static ObjectConverters.IsNull}}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.s53.s53_0" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                </Style>
                                            </TextBlock.Styles>
                                            <TextBlock.Theme>
                                                <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </ControlTheme>
                                            </TextBlock.Theme>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- Prompts Section -->
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Prompts (one image each)"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="These camera angles will be generated from your input image."
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,10"/>
                                <!-- Training Prompts -->
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Training Prompts"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="Replace all prompts above with one or more saved training sets. Select any combination, then Load."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>
                                        <!-- Saved sets list (checkbox + name + delete) -->
                                        <ItemsControl ItemsSource="{Binding CameraAngle.TrainingSets}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CameraAngleViewModel+TrainingSetItem">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                                  FontSize="12"
                                                                  VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                                Content="Delete"
                                                                FontSize="11"
                                                                Padding="8,3"
                                                                Background="{StaticResource DangerBrush}"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                Command="{Binding $parent[Window].((vm:ImageGeneratorViewModel)DataContext).CameraAngle.DeleteTrainingSetCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No training sets saved yet."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,8"
                                                   Classes="s54"
                                                   Classes.s54_0="{Binding CameraAngle.TrainingSets.Count, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=0}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.s54.s54_0" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                </Style>
                                            </TextBlock.Styles>
                                            <TextBlock.Theme>
                                                <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </ControlTheme>
                                            </TextBlock.Theme>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="Load Training Prompts"
                                                    Command="{Binding CameraAngle.LoadTrainingPromptsCommand}"
                                                    Background="{StaticResource BrandBrush}"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Padding="12,7"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Reset to Camera Angles"
                                                    Command="{Binding CameraAngle.ResetToCameraAnglesCommand}"
                                                    Background="{StaticResource BorderBrush}"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    BorderThickness="0"
                                                    Padding="12,7"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <!-- Create a new training set from pasted prompts -->
                                        <Border Background="White"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="Save a new training set"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock Text="Paste one or more prompts (one per line), give the set a name, then Save."
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding CameraAngle.NewSetName}"
                                                         BorderBrush="{StaticResource BorderStrongBrush}"
                                                         BorderThickness="1"
                                                         Padding="8,6"
                                                         FontSize="12"
                                                         Background="{StaticResource SurfaceAltBrush}"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         Margin="0,0,0,6"
                                                         ToolTip.Tip="Training set name"/>
                                                <TextBox Text="{Binding CameraAngle.NewSetPrompts}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="80"
                                                         MaxHeight="160"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderStrongBrush}"
                                                         BorderThickness="1"
                                                         Padding="8,6"
                                                         FontSize="12"
                                                         Background="{StaticResource SurfaceAltBrush}"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         Margin="0,0,0,6"
                                                         ToolTip.Tip="Paste prompts here, one per line"/>
                                                <Button Content="Save Set"
                                                        Command="{Binding CameraAngle.SaveTrainingSetCommand}"
                                                        Background="{StaticResource SuccessBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Padding="12,7"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding CameraAngle.Prompts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CameraAngleViewModel+CameraPromptItem">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Number}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Optional Extra Prompt -->
                                <TextBlock Text="Extra prompt (optional)"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,15,0,4"/>
                                <TextBlock Text="Add your own prompt to generate one additional image."
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CameraAngle.ExtraPrompt}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="60"
                                         MaxHeight="120"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         BorderBrush="{StaticResource BorderStrongBrush}"
                                         BorderThickness="1"
                                         Padding="10,8"
                                         FontSize="12"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <!-- Action Buttons -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Generate Camera Angles"
                                    Command="{Binding CameraAngle.GenerateCameraAnglesCommand}"
                                    Background="{StaticResource SuccessBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="15,10"
                                    FontSize="13"
                                    FontWeight="SemiBold"/>
                            <Button Grid.Column="2"
                                    Content="Cancel"
                                    Command="{Binding CameraAngle.CancelGenerationCommand}"
                                    Background="{StaticResource DangerBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="15,10"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    IsVisible="{Binding CameraAngle.IsProcessing}"/>
                            <Button Grid.Column="4"
                                    Content="Open Output Folder"
                                    Command="{Binding CameraAngle.OpenOutputFolderCommand}"
                                    Background="{StaticResource BrandBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="15,10"
                                    FontSize="13"
                                    FontWeight="SemiBold"/>
                            <Button Grid.Column="6"
                                    Content="Clear Output"
                                    Command="{Binding CameraAngle.ClearOutputCommand}"
                                    Background="{StaticResource BrandBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="15,10"
                                    FontSize="13"
                                    FontWeight="SemiBold"/>
                        </Grid>
                        <!-- Progress Section -->
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,20"
                                IsVisible="{Binding CameraAngle.IsProcessing}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Processing Status"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CameraAngle.ProgressPercentage}"
                                               FontSize="13"
                                               Foreground="{StaticResource SuccessTextBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding CameraAngle.ProcessingProgress}"
                                             Maximum="100"
                                             Height="8"
                                             Margin="0,10,0,5"
                                             Foreground="{StaticResource SuccessTextBrush}"
                                             Background="{StaticResource BorderBrush}"/>
                                <TextBlock Text="{Binding CameraAngle.ProcessingStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <!-- Output Section -->
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Generated Camera Angles"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding CameraAngle.OutputItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CameraAngleViewModel+CameraAngleOutputItem">
                                            <Border Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10"
                                                    Margin="0,0,10,10">
                                                <StackPanel Width="180">
                                                    <!-- Thumbnail Image -->
                                                    <Border Background="White"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Margin="0,0,0,8">
                                                        <Image Source="{Binding Thumbnail, Converter={StaticResource PathToBitmapConverter}}"
                                                               Stretch="Uniform"
                                                               Width="160"
                                                               Height="160"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                                               Classes="s55"
                                                               Classes.s55_0="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <Image.Styles>
                                                                <Style Selector="Image.s55.s55_0"
                                                                       x:DataType="vm:CameraAngleViewModel+CameraAngleOutputItem">
                                                                    <Setter Property="Source" Value="{x:Null}"/>
                                                                </Style>
                                                            </Image.Styles>
                                                        </Image>
                                                    </Border>
                                                    <!-- Info and Button -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="5"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding DisplayName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2"
                                                                Content="Open"
                                                                FontSize="11"
                                                                Padding="8,4"
                                                                Background="{StaticResource BrandBrush}"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                Tag="{Binding FilePath}"
                                                                Click="OpenOutputImage_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No camera angles generated yet"
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Padding="20"
                                           Classes="s56"
                                           Classes.s56_0="{Binding CameraAngle.OutputItems.Count, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=0}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock.s56.s56_0" x:DataType="vm:ImageGeneratorViewModel">
                                            <Setter Property="IsVisible" Value="True"/>
                                        </Style>
                                    </TextBlock.Styles>
                                    <TextBlock.Theme>
                                        <ControlTheme TargetType="TextBlock" x:DataType="vm:ImageGeneratorViewModel">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </ControlTheme>
                                    </TextBlock.Theme>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <!-- Log Output -->
                        <Border Background="{StaticResource PlayerSurfaceBrush}"
                                BorderBrush="#374151"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <TextBox Text="{Binding CameraAngle.LogOutput}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource PlayerSurfaceBrush}"
                                     Foreground="{StaticResource PlayerTextBrush}"
                                     BorderThickness="0"
                                     FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                     FontSize="11"
                                     Padding="10"
                                     Height="150"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Tab: Inpaint Editor -->
            <TabItem Header="✏️ Editor" IsVisible="{Binding IsEditGroup}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource AppBackgroundBrush}" Padding="15,10,15,6">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="🖌 Paint mask"
                                         GroupName="EditorMode"
                                         Theme="{StaticResource GroupPillStyle}"
                                         IsChecked="{Binding IsPaintEditor, Mode=OneWay}"
                                         Command="{Binding SelectEditorModeCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                         CommandParameter="0"/>
                            <RadioButton Content="🪄 Auto-detect"
                                         GroupName="EditorMode"
                                         Theme="{StaticResource GroupPillStyle}"
                                         IsChecked="{Binding IsAutoDetectEditor, Mode=OneWay}"
                                         Command="{Binding SelectEditorModeCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                         CommandParameter="1"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid IsVisible="{Binding IsPaintEditor}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- LEFT: Source image + mask painting -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="15,12,8,12">
                                    <!-- Upload section -->
                                    <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Source Image" Theme="{StaticResource HeaderTextStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Background="White"
                                                        Padding="8,6">
                                                    <TextBlock Text="{Binding InpaintEditor.SourceImagePath, FallbackValue='No image selected'}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Content="📂 Browse"
                                                        Command="{Binding InpaintEditor.BrowseImageCommand}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Background="{StaticResource BrandBrush}"
                                                        Padding="14,8"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <!-- Canvas: source image + mask painting overlay -->
                                    <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="Paint Mask" Theme="{StaticResource HeaderTextStyle}" Margin="0,0,0,6"/>
                                            <TextBlock Text="Paint over the area you want to edit. Red strokes = inpaint region."
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,8"/>
                                            <!-- Brush controls -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Brush:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Slider x:Name="BrushSizeSlider"
                                                        Minimum="5"
                                                        Maximum="120"
                                                        Value="{Binding InpaintEditor.BrushSize, Mode=TwoWay}"
                                                        Width="140"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="BrushSizeSlider_ValueChanged"/>
                                                <TextBlock Text="{Binding InpaintEditor.BrushSize, StringFormat='  {0}px'}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Button Content="🗑️ Clear Mask"
                                                        Click="ClearMask_Click"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Background="{StaticResource DangerBrush}"
                                                        Padding="10,6"
                                                        Margin="12,0,0,0"
                                                        FontSize="12"/>
                                            </StackPanel>
                                            <!-- Image + InkCanvas layered in a Grid -->
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    Height="420"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <!-- Source image -->
                                                    <Image x:Name="EditorSourceImage"
                                                           Source="{Binding InpaintEditor.SourceImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                    <!-- Placeholder when no image loaded -->
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding InpaintEditor.NoSourceImage}">
                                                        <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Browse an image to start"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource PlayerTextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                    <!-- InkCanvas mask painter (transparent bg, red strokes) -->
                                                    <ctrl:MaskPaintCanvas x:Name="MaskInkCanvas"
                                                                          Background="Transparent"
                                                                          Cursor="Cross"
                                                                          IsEnabled="{Binding InpaintEditor.HasSourceImage}"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <!-- Prompt section -->
                                    <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Edit Prompt" Theme="{StaticResource HeaderTextStyle}"/>
                                            <TextBox Text="{Binding InpaintEditor.Prompt}"
                                                     MinHeight="70"
                                                     MaxHeight="120"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     FontSize="13"
                                                     Padding="8"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     BorderThickness="1"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Generate button + progress -->
                                    <Border Theme="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <Button Content="⚡ Generate Inpaint"
                                                    Click="RunInpaint_Click"
                                                    Theme="{StaticResource PrimaryButtonStyle}"
                                                    IsEnabled="{Binding InpaintEditor.CanGenerate}"
                                                    Padding="20,12"
                                                    FontSize="14"
                                                    HorizontalAlignment="Stretch"/>
                                            <!-- Progress -->
                                            <StackPanel Margin="0,12,0,0" IsVisible="{Binding InpaintEditor.IsProcessing}">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding InpaintEditor.StatusMessage}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding InpaintEditor.ProgressText}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource AccentIndigoBrush}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding InpaintEditor.Progress}"
                                                             Maximum="100"
                                                             Height="8"
                                                             Foreground="{StaticResource AccentIndigoBrush}"
                                                             Background="{StaticResource BorderBrush}"/>
                                            </StackPanel>
                                            <!-- Status message -->
                                            <TextBlock Text="{Binding InpaintEditor.StatusMessage}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Splitter -->
                            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>
                            <!-- RIGHT: Result -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8,12,15,12">
                                    <!-- Result image -->
                                    <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="Result" Theme="{StaticResource HeaderTextStyle}"/>
                                            <!-- Result image display -->
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    Height="420"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding InpaintEditor.ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding InpaintEditor.NoResult}">
                                                        <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Result will appear here"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource PlayerTextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <!-- Result actions -->
                                    <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Output" Theme="{StaticResource HeaderTextStyle}"/>
                                            <TextBlock Text="{Binding InpaintEditor.ResultImagePath, FallbackValue='—'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="📁 Open Folder"
                                                        Command="{Binding InpaintEditor.OpenResultFolderCommand}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Background="{StaticResource BrandBrush}"
                                                        Padding="12,8"
                                                        FontSize="12"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="🖼️ Open Image"
                                                        Command="{Binding InpaintEditor.OpenResultImageCommand}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Background="{StaticResource SuccessBrush}"
                                                        Padding="12,8"
                                                        FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- Log -->
                                    <Border Background="{StaticResource PlayerSurfaceBrush}"
                                            BorderBrush="#374151"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Log"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding InpaintEditor.LogOutput}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     Background="{StaticResource PlayerSurfaceBrush}"
                                                     Foreground="{StaticResource PlayerTextBrush}"
                                                     BorderThickness="0"
                                                     FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                     FontSize="11"
                                                     Padding="4"
                                                     Height="200"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <Grid IsVisible="{Binding IsAutoDetectEditor}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- LEFT: Controls -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="15,12,8,12">
                                    <!-- Source Image -->
                                    <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Source Image" Theme="{StaticResource HeaderTextStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Background="White"
                                                        Padding="8,6">
                                                    <TextBlock Text="{Binding KleinInpaintEditor.SourceImagePath, FallbackValue='No image selected'}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Content="📂 Browse"
                                                        Command="{Binding KleinInpaintEditor.BrowseImageCommand}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Background="{StaticResource BrandBrush}"
                                                        Padding="14,8"/>
                                            </Grid>
                                            <!-- Source preview thumbnail -->
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    Height="240"
                                                    Margin="0,10,0,0"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding KleinInpaintEditor.SourceImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding KleinInpaintEditor.NoSourceImage}">
                                                        <TextBlock Text="📷" FontSize="40" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Upload an image to begin"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource PlayerTextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <!-- Detect & Replace -->
                                    <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Detect &amp; Replace" Theme="{StaticResource HeaderTextStyle}"/>
                                            <!-- Detection Target -->
                                            <TextBlock Text="What to detect"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="0,4,0,4"/>
                                            <TextBlock Text="Florence2 + SAM2 will auto-segment this subject"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding KleinInpaintEditor.DetectionTarget}"
                                                     Height="36"
                                                     FontSize="13"
                                                     Padding="8,6"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     BorderThickness="1"
                                                     VerticalContentAlignment="Center"
                                                     Classes="s57"
                                                     Classes.s57_0="{Binding $self.Text, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <TextBox.Styles>
                                                    <Style Selector="TextBox.s57.s57_0" x:DataType="vm:ImageGeneratorViewModel">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="e.g. face, person, cup, sky"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   FontSize="12"
                                                                                   Margin="10,0,0,0"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Styles>
                                            </TextBox>
                                            <!-- Prompt -->
                                            <TextBlock Text="Replace with"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="0,12,0,4"/>
                                            <TextBlock Text="Describe what should appear in the detected area"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding KleinInpaintEditor.Prompt}"
                                                     MinHeight="80"
                                                     MaxHeight="140"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     FontSize="13"
                                                     Padding="8"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     BorderThickness="1"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Generation Settings -->
                                    <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Generation Settings" Theme="{StaticResource HeaderTextStyle}"/>
                                            <!-- Steps -->
                                            <Grid Margin="0,6,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="Steps"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Slider Grid.Column="1"
                                                        Minimum="1"
                                                        Maximum="30"
                                                        Value="{Binding KleinInpaintEditor.Steps, Mode=TwoWay}"
                                                        VerticalAlignment="Center"
                                                        TickFrequency="1"
                                                        IsSnapToTickEnabled="True"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding KleinInpaintEditor.Steps}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentVioletBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <!-- CFG -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="CFG"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Slider Grid.Column="1"
                                                        Minimum="1"
                                                        Maximum="10"
                                                        Value="{Binding KleinInpaintEditor.Cfg, Mode=TwoWay}"
                                                        VerticalAlignment="Center"
                                                        TickFrequency="0.5"
                                                        IsSnapToTickEnabled="False"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding KleinInpaintEditor.CfgText}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentVioletBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <!-- Denoise -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="Denoise"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Slider Grid.Column="1"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        Value="{Binding KleinInpaintEditor.Denoise, Mode=TwoWay}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding KleinInpaintEditor.DenoiseText}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentVioletBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <!-- LoRA Strength -->
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="LoRA"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Slider Grid.Column="1"
                                                        Minimum="0"
                                                        Maximum="4"
                                                        Value="{Binding KleinInpaintEditor.LoraStrength, Mode=TwoWay}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding KleinInpaintEditor.LoraStrengthText}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentVioletBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <!-- Models (collapsible) -->
                                            <Expander Header="Models"
                                                      Margin="0,10,0,0"
                                                      FontSize="12"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      IsExpanded="False">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Text="UNET"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding KleinInpaintEditor.UnetName}"
                                                             Height="30"
                                                             FontSize="11"
                                                             Padding="6,4"
                                                             BorderBrush="{StaticResource BorderBrush}"
                                                             BorderThickness="1"
                                                             Margin="0,0,0,8"
                                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"/>
                                                    <TextBlock Text="LoRA"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding KleinInpaintEditor.LoraName}"
                                                             Height="30"
                                                             FontSize="11"
                                                             Padding="6,4"
                                                             BorderBrush="{StaticResource BorderBrush}"
                                                             BorderThickness="1"
                                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                    <!-- Generate -->
                                    <Border Theme="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <Button Content="⚡ Generate"
                                                    Command="{Binding KleinInpaintEditor.GenerateCommand}"
                                                    Theme="{StaticResource PrimaryButtonStyle}"
                                                    Background="{StaticResource BrandBrush}"
                                                    IsEnabled="{Binding KleinInpaintEditor.CanGenerate}"
                                                    Padding="20,12"
                                                    FontSize="14"
                                                    HorizontalAlignment="Stretch"/>
                                            <StackPanel Margin="0,12,0,0" IsVisible="{Binding KleinInpaintEditor.IsProcessing}">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding KleinInpaintEditor.StatusMessage}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding KleinInpaintEditor.ProgressText}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource AccentVioletBrush}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding KleinInpaintEditor.Progress}"
                                                             Maximum="100"
                                                             Height="8"
                                                             Foreground="{StaticResource AccentVioletBrush}"
                                                             Background="{StaticResource BorderBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding KleinInpaintEditor.StatusMessage}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Splitter -->
                            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>
                            <!-- RIGHT: Result + Log -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8,12,15,12">
                                    <!-- Pipeline info badge -->
                                    <Border Background="#F3F0FF"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Klein Flux 2 — Auto Inpaint"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentVioletBrush}"/>
                                            <TextBlock FontSize="11" Foreground="#6D28D9" Margin="0,4,0,0" TextWrapping="Wrap">Florence2 detects the subject → SAM2 creates a precise mask → Klein model replaces it seamlessly</TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <!-- Result image -->
                                    <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="Result" Theme="{StaticResource HeaderTextStyle}"/>
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="{StaticResource PlayerSurfaceBrush}"
                                                    Height="420"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding KleinInpaintEditor.ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding KleinInpaintEditor.NoResult}">
                                                        <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Result will appear here"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource PlayerTextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <!-- Actions -->
                                    <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Output" Theme="{StaticResource HeaderTextStyle}"/>
                                            <TextBlock Text="{Binding KleinInpaintEditor.ResultImagePath, FallbackValue='—'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="📁 Open Folder"
                                                        Command="{Binding KleinInpaintEditor.OpenResultFolderCommand}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Background="{StaticResource BrandBrush}"
                                                        Padding="12,8"
                                                        FontSize="12"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="🖼️ Open Image"
                                                        Command="{Binding KleinInpaintEditor.OpenResultImageCommand}"
                                                        Theme="{StaticResource SecondaryButtonStyle}"
                                                        Background="{StaticResource SuccessBrush}"
                                                        Padding="12,8"
                                                        FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- Log -->
                                    <Border Background="{StaticResource PlayerSurfaceBrush}"
                                            BorderBrush="#374151"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Log"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding KleinInpaintEditor.LogOutput}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     Background="{StaticResource PlayerSurfaceBrush}"
                                                     Foreground="{StaticResource PlayerTextBrush}"
                                                     BorderThickness="0"
                                                     FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                     FontSize="11"
                                                     Padding="4"
                                                     Height="200"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>
            <!-- ===== CONTROL: Klein Flux 2 Control Net (reference + pose → analyze → generate) ===== -->
            <TabItem Header="🎛️ Control" IsVisible="{Binding IsAdvancedGroup}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>
                    <!-- LEFT: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">
                            <!-- Workflow selector -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Workflow" Theme="{StaticResource HeaderTextStyle}"/>
                                    <ComboBox ItemsSource="{Binding KleinControl.WorkflowOptions}"
                                              SelectedIndex="{Binding KleinControl.SelectedWorkflowIndex}"
                                              FontSize="12"
                                              Padding="8,5"/>
                                </StackPanel>
                            </Border>
                            <!-- Pipeline badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding KleinControl.WorkflowTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                    <TextBlock Text="{Binding KleinControl.WorkflowDescription}"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentIndigoBrush}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <!-- Reference image -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding KleinControl.RefImageLabel}" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding KleinControl.RefImagePath, FallbackValue='No image selected'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Reference"
                                            Command="{Binding KleinControl.BrowseRefImageCommand}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}"
                                            Padding="12,8"
                                            FontSize="12"
                                            Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="180"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding KleinControl.RefImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding KleinControl.NoRefImage}">
                                                <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Reference image"
                                                           FontSize="12"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Pose image / video picker -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding KleinControl.PoseImageLabel}" Theme="{StaticResource HeaderTextStyle}"/>
                                    <!-- Browse row: image OR video -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="📂 Browse Image"
                                                Command="{Binding KleinControl.BrowsePoseImageCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="10,7"
                                                FontSize="12"
                                                Margin="0,0,6,0"/>
                                        <Button Content="🎬 Browse Video"
                                                Command="{Binding KleinControl.BrowseVideoCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="10,7"
                                                FontSize="12"/>
                                    </StackPanel>
                                    <!-- IMAGE MODE: shown when no video loaded -->
                                    <StackPanel IsVisible="{Binding KleinControl.NoVideo}">
                                        <TextBlock Text="{Binding KleinControl.PoseImagePath, FallbackValue='No image selected'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,6"/>
                                        <Border BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="180"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding KleinControl.PoseImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding KleinControl.NoPoseImage}">
                                                    <TextBlock Text="🕴️" FontSize="36" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Browse an image or video"
                                                               FontSize="12"
                                                               Foreground="{StaticResource PlayerTextBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <!-- VIDEO MODE: shown when video is loaded -->
                                    <StackPanel IsVisible="{Binding KleinControl.HasVideo}">
                                        <!-- Video info -->
                                        <Border Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="#C4B5FD"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,5"
                                                Margin="0,0,0,8">
                                            <TextBlock Text="{Binding KleinControl.VideoInfoText}" FontSize="11" Foreground="#5B21B6"/>
                                        </Border>
                                        <!-- Frame preview -->
                                        <Border BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200"
                                                ClipToBounds="True"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Image Source="{Binding KleinControl.FramePreviewSource, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding KleinControl.NoFramePreview}">
                                                    <TextBlock Text="🎞️" FontSize="36" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Loading frame..."
                                                               FontSize="12"
                                                               Foreground="{StaticResource PlayerTextBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <!-- Extracting spinner overlay -->
                                                <Border Background="#80000000" CornerRadius="4" IsVisible="{Binding KleinControl.IsExtractingFrame}">
                                                    <TextBlock Text="⏳ Extracting..."
                                                               FontSize="13"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <!-- Seek slider -->
                                        <Slider Value="{Binding KleinControl.FramePositionSeconds, Mode=TwoWay}"
                                                Minimum="0"
                                                Maximum="{Binding KleinControl.VideoDurationSeconds}"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="False"
                                                Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding KleinControl.FramePositionText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <!-- Use This Frame button + set indicator -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📌 Use This Frame"
                                                    Command="{Binding KleinControl.UseFrameCommand}"
                                                    Theme="{StaticResource PrimaryButtonStyle}"
                                                    Background="{StaticResource BrandBrush}"
                                                    Padding="12,8"
                                                    FontSize="12"/>
                                            <Border Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="#6EE7B7"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    Margin="8,0,0,0"
                                                    IsVisible="{Binding KleinControl.HasPoseImage}">
                                                <TextBlock Text="✓ Frame set"
                                                           FontSize="11"
                                                           Foreground="{StaticResource SuccessTextBrush}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Analyze button (Klein mode only) -->
                            <Border Theme="{StaticResource SectionPanelStyle}"
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    IsVisible="{Binding KleinControl.ShowAnalyzeSection}">
                                <StackPanel>
                                    <TextBlock Text="Step 1 — Analyze" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">Runs QwenVL inside ComfyUI to analyze the pose image and generate a prompt.
                                        Also produces a first generated image.</TextBlock>
                                    <Button Content="🔍 Analyze"
                                            Command="{Binding KleinControl.AnalyzeCommand}"
                                            IsEnabled="{Binding KleinControl.CanAnalyze}"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource SuccessBrush}"
                                            Padding="16,10"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsVisible="{Binding KleinControl.IsAnalyzing}">
                                        <TextBlock Text="⏳ " FontSize="13"/>
                                        <TextBlock Text="{Binding KleinControl.StatusMessage}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Prompt editor -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 2 — Edit Prompt" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding KleinControl.Prompt}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinLines="5"
                                             MaxLines="10"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             FontSize="12"
                                             Padding="8"
                                             Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- Generate button -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 3 — Generate" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">Sends the edited prompt to ComfyUI with your reference and pose images.</TextBlock>
                                    <Button Content="🚀 Generate"
                                            Command="{Binding KleinControl.GenerateCommand}"
                                            IsEnabled="{Binding KleinControl.CanGenerate}"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}"
                                            Padding="16,10"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding KleinControl.StatusMessage}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding KleinControl.Progress}"
                                                     Maximum="100"
                                                     Height="6"
                                                     Margin="0,4,0,0"
                                                     Background="{StaticResource BorderBrush}"
                                                     Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>
                    <!-- RIGHT: result + log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">
                            <!-- Info badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="#BBF7D0"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Klein Flux 2 — Control Net Pipeline" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource SuccessTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap">QwenVL analyzes the pose image → DWPose extracts skeleton → Klein Flux 2 generates
                                        with your reference subject in the target pose</TextBlock>
                                </StackPanel>
                            </Border>
                            <!-- Result image -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="420"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding KleinControl.ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding KleinControl.NoResult}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here"
                                                           FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Actions -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding KleinControl.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding KleinControl.OpenResultFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="12,8"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding KleinControl.OpenResultImageCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}"
                                                Padding="12,8"
                                                FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}"
                                    BorderBrush="#374151"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PlayerTextBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KleinControl.LogOutput}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}"
                                             Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="11"
                                             Padding="4"
                                             Height="200"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- ===== IDEOGRAM: Image → LLM prompt → Ideogram v4 generation ===== -->
            <TabItem Header="🔤 Ideogram" IsVisible="{Binding IsCreateGroup}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>
                    <!-- LEFT COLUMN: Inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="12,12,12,12">
                        <StackPanel>
                            <!-- Aspect ratio + resolution -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 1 — Format" Theme="{StaticResource HeaderTextStyle}"/>
                                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,8">
                                        <Button Content="◼ Square"
                                                Command="{Binding Ideogram.SetAspectCommand}"
                                                CommandParameter="Square"
                                                FontSize="12"
                                                Padding="6,8"
                                                Margin="0,0,4,0"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                Classes="s58"
                                                Classes.s58_0="{Binding Ideogram.IsSquare}">
                                            <Button.Styles>
                                                <Style Selector="Button.s58.s58_0" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="{StaticResource AccentRoseBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </Button.Styles>
                                            <Button.Theme>
                                                <ControlTheme TargetType="Button"
                                                              BasedOn="{StaticResource {x:Type Button}}"
                                                              x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                </ControlTheme>
                                            </Button.Theme>
                                        </Button>
                                        <Button Content="▭ Wide"
                                                Command="{Binding Ideogram.SetAspectCommand}"
                                                CommandParameter="Widescreen"
                                                FontSize="12"
                                                Padding="6,8"
                                                Margin="2,0,2,0"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                Classes="s59"
                                                Classes.s59_0="{Binding Ideogram.IsWidescreen}">
                                            <Button.Styles>
                                                <Style Selector="Button.s59.s59_0" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="{StaticResource AccentRoseBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </Button.Styles>
                                            <Button.Theme>
                                                <ControlTheme TargetType="Button"
                                                              BasedOn="{StaticResource {x:Type Button}}"
                                                              x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                </ControlTheme>
                                            </Button.Theme>
                                        </Button>
                                        <Button Content="▯ Portrait"
                                                Command="{Binding Ideogram.SetAspectCommand}"
                                                CommandParameter="Portrait"
                                                FontSize="12"
                                                Padding="6,8"
                                                Margin="4,0,0,0"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                Classes="s60"
                                                Classes.s60_0="{Binding Ideogram.IsPortrait}">
                                            <Button.Styles>
                                                <Style Selector="Button.s60.s60_0" x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="{StaticResource AccentRoseBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </Button.Styles>
                                            <Button.Theme>
                                                <ControlTheme TargetType="Button"
                                                              BasedOn="{StaticResource {x:Type Button}}"
                                                              x:DataType="vm:ImageGeneratorViewModel">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                </ControlTheme>
                                            </Button.Theme>
                                        </Button>
                                    </UniformGrid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Resolution"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   ToolTip.Tip="Output megapixels. The Instant graph renders in one pass, so this is the saved size; the summary on the right shows the exact pixels for the chosen format."/>
                                        <ComboBox Grid.Column="1"
                                                  Width="70"
                                                  FontSize="12"
                                                  ItemsSource="{Binding Ideogram.MegapixelChoices}"
                                                  SelectedItem="{Binding Ideogram.Megapixel}"
                                                  ToolTip.Tip="Output megapixels. The Instant graph renders in one pass, so this is the saved size; the summary on the right shows the exact pixels for the chosen format."/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Ideogram.AspectSummary}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- High-level prompt -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 2 — High-Level Prompt" Theme="{StaticResource HeaderTextStyle}"/>
                                    <!-- Browse image → LLM → fills prompt + region 1 -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Thumbnail -->
                                        <Border Grid.Column="0"
                                                Width="48"
                                                Height="48"
                                                CornerRadius="4"
                                                Margin="0,0,8,0"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                Background="{StaticResource PlayerSurfaceBrush}"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Ideogram.InputImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <TextBlock Text="🖼️"
                                                           FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding Ideogram.NoInputImage}"/>
                                            </Grid>
                                        </Border>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Ideogram.AvailableModels}"
                                                  SelectedItem="{Binding Ideogram.SelectedLlmModel}"
                                                  VerticalAlignment="Center"
                                                  FontSize="11"
                                                  Padding="6,4"
                                                  ToolTip.Tip="LLM (llama-server) model used to analyze the image"/>
                                        <Button Grid.Column="2"
                                                Content="🔄"
                                                Command="{Binding Ideogram.LoadModelsCommand}"
                                                FontSize="12"
                                                Padding="8,4"
                                                Margin="6,0,0,0"
                                                ToolTip.Tip="Refresh models"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"/>
                                    </Grid>
                                    <Button Content="📂 Upload Image → Auto Prompt + Segments"
                                            Command="{Binding Ideogram.BrowseAndAnalyzeCommand}"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource SuccessBrush}"
                                            Padding="12,8"
                                            FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,4"
                                            ToolTip.Tip="Upload an image: it is analyzed automatically into an enhanced prompt, a style block and the composition segments, then queued for generation"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding Ideogram.IsAnalyzing}">
                                        <TextBlock Text="⏳ " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Ideogram.StatusMessage}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="✖ Cancel"
                                                Command="{Binding Ideogram.CancelAnalyzeCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource DangerBrush}"
                                                FontSize="11"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                ToolTip.Tip="Stop sending the image to the LLM"/>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap">Written automatically the moment an image is uploaded. Used as the global prompt and as the fallback for segments with no description.</TextBlock>
                                    <TextBox Text="{Binding Ideogram.HighLevelPrompt}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinLines="4"
                                             MaxLines="10"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             FontSize="12"
                                             Padding="8"/>
                                </StackPanel>
                            </Border>
                            <!-- Enriched style (from the autoprompter analysis) -->
                            <Border Theme="{StaticResource SectionPanelStyle}"
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    IsVisible="{Binding Ideogram.HasStyleDetails}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Enriched Style (auto)" Theme="{StaticResource HeaderTextStyle}" VerticalAlignment="Center"/>
                                        <CheckBox Content="Enabled"
                                                  IsChecked="{Binding Ideogram.UseEnrichedStyle}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  FontSize="11"
                                                  Foreground="{StaticResource AccentCyanBrush}"/>
                                    </Grid>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap">Medium, aesthetics, lighting, camera and background detected by the LLM. When enabled these are fed into Ideogram4PromptBuilderKJ alongside the per-region boxes; when off, only the high-level prompt and regions drive the image.</TextBlock>
                                    <TextBlock Text="{Binding Ideogram.StyleSummary}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               IsEnabled="{Binding Ideogram.UseEnrichedStyle}"/>
                                </StackPanel>
                            </Border>
                            <!-- Region canvas editor -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Step 3 — Composition Segments" Theme="{StaticResource HeaderTextStyle}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                            <Button Content="➕ Segment"
                                                    Command="{Binding Ideogram.AddRegionCommand}"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Background="{StaticResource BrandBrush}"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    Margin="0,0,6,0"/>
                                            <Button Content="🗑 Clear"
                                                    Command="{Binding Ideogram.ClearRegionsCommand}"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Background="#6B7280"
                                                    Padding="8,4"
                                                    FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">Filled in automatically by the analysis. Drag boxes to move them; drag the corner to resize. Each box gets its own description below.</TextBlock>
                                    <CheckBox Content="Use composition segments (recommended)"
                                              IsChecked="{Binding Ideogram.UseRegions}"
                                              FontSize="12"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource AccentVioletBrush}"
                                              Margin="0,0,0,4"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap">On: each box is sent to Ideogram as its own placed element, which is what reproduces the reference layout. Off: one full-frame element carrying just the high-level prompt.</TextBlock>
                                    <!-- Canvas -->
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Padding="10"
                                            HorizontalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Ideogram.Regions}"
                                                      Width="{Binding Ideogram.CanvasWidth}"
                                                      Height="{Binding Ideogram.CanvasHeight}"
                                                      Background="#0F0F1E"
                                                      ClipToBounds="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerTheme>
                                                <ControlTheme TargetType="ContentPresenter" x:DataType="m:IdeogramRegion">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </ControlTheme>
                                            </ItemsControl.ItemContainerTheme>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:IdeogramRegion">
                                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                        <!-- Body / move -->
                                                        <Thumb DragDelta="RegionMove_DragDelta"
                                                               DragStarted="Region_DragStarted"
                                                               Cursor="SizeAll"
                                                               Classes="t61"
                                                               Classes.t61_0="{Binding IsSelected}">
                                                            <Thumb.Styles>
                                                                <Style Selector="Thumb.t61.t61_0 /template/ Border#box">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                                                                    <Setter Property="Background" Value="#44F59E0B"/>
                                                                </Style>
                                                            </Thumb.Styles>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border x:Name="box"
                                                                            Background="#330EA5E9"
                                                                            BorderBrush="{StaticResource AccentCyanBrush}"
                                                                            BorderThickness="2"
                                                                            CornerRadius="2">
                                                                        <Border Background="{StaticResource BrandBrush}"
                                                                                CornerRadius="2"
                                                                                Padding="4,1"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Top"
                                                                                Margin="2">
                                                                            <TextBlock Text="{ReflectionBinding Label}"
                                                                                       Foreground="White"
                                                                                       FontSize="11"
                                                                                       FontWeight="Bold"/>
                                                                        </Border>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                            <Thumb.Theme>
                                                                <ControlTheme TargetType="Thumb"/>
                                                            </Thumb.Theme>
                                                        </Thumb>
                                                        <!-- Resize handle -->
                                                        <Thumb DragDelta="RegionResize_DragDelta"
                                                               DragStarted="Region_DragStarted"
                                                               Width="16"
                                                               Height="16"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Bottom"
                                                               Cursor="TopLeftCorner">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="{StaticResource BrandBrush}"
                                                                            BorderBrush="White"
                                                                            BorderThickness="1"
                                                                            CornerRadius="2"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                            <Thumb.Theme>
                                                                <ControlTheme TargetType="Thumb"/>
                                                            </Thumb.Theme>
                                                        </Thumb>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <!-- Region descriptions -->
                                    <ItemsControl ItemsSource="{Binding Ideogram.Regions}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:IdeogramRegion">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Background="{StaticResource BrandBrush}"
                                                            CornerRadius="10"
                                                            Width="20"
                                                            Height="20"
                                                            VerticalAlignment="Top"
                                                            Margin="0,2,6,0">
                                                        <TextBlock Text="{Binding Label}"
                                                                   Foreground="White"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBox Text="{Binding Description}"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 MinLines="1"
                                                                 MaxLines="4"
                                                                 FontSize="11"
                                                                 Padding="6"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                 Tag="Describe this segment (optional)"/>
                                                        <!-- Typography segments also carry the literal string Ideogram must render. -->
                                                        <Grid Margin="0,4,0,0" IsVisible="{Binding IsTextElement}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="🅣"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource AccentVioletBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"
                                                                       ToolTip.Tip="Text segment — the exact lettering to render"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Text}"
                                                                     FontSize="11"
                                                                     Padding="6"
                                                                     FontWeight="SemiBold"/>
                                                        </Grid>
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Content="✕"
                                                            FontSize="12"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            FontWeight="Bold"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Padding="6,0"
                                                            VerticalAlignment="Top"
                                                            Margin="2,0,0,0"
                                                            ToolTip.Tip="Remove segment"
                                                            Command="{Binding $parent[ScrollViewer].((vm:ImageGeneratorViewModel)DataContext).Ideogram.RemoveRegionCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- Generate -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 4 — Generate" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">Renders one image at the chosen aspect ratio, then refines it through the workflow's 2× second pass.</TextBlock>
                                    <Button Content="🚀 Generate"
                                            Command="{Binding Ideogram.GenerateCommand}"
                                            IsEnabled="{Binding Ideogram.CanGenerate}"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}"
                                            Padding="16,10"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Ideogram.StatusMessage}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding Ideogram.Progress}"
                                                     Maximum="100"
                                                     Height="6"
                                                     Margin="0,4,0,0"
                                                     Background="{StaticResource BorderBrush}"
                                                     Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Queue Section -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Queue" Theme="{StaticResource HeaderTextStyle}"/>
                                    <!-- Queue buttons -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="➕ Add to Queue"
                                                Command="{Binding Ideogram.AddToQueueCommand}"
                                                Theme="{StaticResource PrimaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="10,8"
                                                FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1"
                                                Content="▶ Start"
                                                Command="{Binding Ideogram.ProcessQueueCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}"
                                                Padding="12,8"
                                                FontSize="12"
                                                Margin="6,0,0,0"/>
                                        <Button Grid.Column="2"
                                                Content="⏹ Stop"
                                                Command="{Binding Ideogram.CancelQueueCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource DangerBrush}"
                                                Padding="10,8"
                                                FontSize="12"
                                                Margin="6,0,0,0"/>
                                    </Grid>
                                    <!-- Queue status -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{StaticResource BrandBrush}" CornerRadius="10" Padding="6,2">
                                            <TextBlock Text="{Binding Ideogram.QueueCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="waiting..."
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentIndigoBrush}"
                                                   FontStyle="Italic"
                                                   Margin="8,0,0,0"
                                                   IsVisible="{Binding Ideogram.IsWaitingForLease}"/>
                                        <TextBlock Text="processing..."
                                                   FontSize="11"
                                                   Foreground="{StaticResource SuccessTextBrush}"
                                                   FontStyle="Italic"
                                                   Margin="8,0,0,0"
                                                   IsVisible="{Binding Ideogram.IsProcessingQueue}"/>
                                    </StackPanel>
                                    <!-- Queue items list -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <ItemsControl ItemsSource="{Binding Ideogram.Queue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:IdeogramQueueItem">
                                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Item info -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayPrompt}"
                                                                           FontSize="11"
                                                                           FontWeight="Medium"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding RatioDisplay}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <!-- Status -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding StatusDisplay}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding StatusColor}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0"/>
                                                            <ProgressBar Grid.Column="1"
                                                                         Value="{Binding Progress}"
                                                                         Width="40"
                                                                         Height="8"
                                                                         Margin="8,0"
                                                                         Classes="s62"
                                                                         Classes.s62_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Processing}">
                                                                <ProgressBar.Styles>
                                                                    <Style Selector="ProgressBar.s62.s62_0" x:DataType="m:IdeogramQueueItem">
                                                                        <Setter Property="IsVisible" Value="True"/>
                                                                    </Style>
                                                                </ProgressBar.Styles>
                                                                <ProgressBar.Theme>
                                                                    <ControlTheme TargetType="ProgressBar"
                                                                                  BasedOn="{StaticResource {x:Type ProgressBar}}"
                                                                                  x:DataType="m:IdeogramQueueItem">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </ControlTheme>
                                                                </ProgressBar.Theme>
                                                            </ProgressBar>
                                                            <!-- Actions -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="🖼️"
                                                                        Command="{Binding OpenImageCommand, Converter={x:Static conv:WpfConverters.ToAvalonia}}"
                                                                        FontSize="12"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Padding="2"
                                                                        ToolTip.Tip="Open image"
                                                                        Classes="s63"
                                                                        Classes.s63_0="{Binding Status, Converter={x:Static conv:WpfConverters.Equal}, ConverterParameter=Completed}">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button.s63.s63_0" x:DataType="m:IdeogramQueueItem">
                                                                            <Setter Property="IsVisible" Value="True"/>
                                                                        </Style>
                                                                    </Button.Styles>
                                                                    <Button.Theme>
                                                                        <ControlTheme TargetType="Button"
                                                                                      BasedOn="{StaticResource {x:Type Button}}"
                                                                                      x:DataType="m:IdeogramQueueItem">
                                                                            <Setter Property="IsVisible" Value="False"/>
                                                                        </ControlTheme>
                                                                    </Button.Theme>
                                                                </Button>
                                                                <Button Content="✕"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource DangerBrush}"
                                                                        FontWeight="Bold"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Padding="4,0"
                                                                        ToolTip.Tip="Remove"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Button Content="Clear All"
                                            Command="{Binding Ideogram.ClearQueueCommand}"
                                            HorizontalAlignment="Right"
                                            Background="#6B7280"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="8,3"
                                            FontSize="10"
                                            Cursor="Hand"
                                            Margin="0,4,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Name="PART_ContentPresenter"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Theme>
                                            <ControlTheme TargetType="Button"/>
                                        </Button.Theme>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <!-- Generated Images gallery -->
                            <Border Theme="{StaticResource SectionPanelStyle}"
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    IsVisible="{Binding Ideogram.HasGeneratedImages}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Generated Images"
                                                   Theme="{StaticResource HeaderTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0"/>
                                        <Button Grid.Column="1"
                                                Content="Clear All"
                                                Command="{Binding Ideogram.ClearGeneratedImagesCommand}"
                                                Background="#6B7280"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Padding="8,3"
                                                FontSize="10"
                                                Cursor="Hand"
                                                ToolTip.Tip="Remove thumbnails from view (does not delete files)">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          Name="PART_ContentPresenter"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Theme>
                                                <ControlTheme TargetType="Button"/>
                                            </Button.Theme>
                                        </Button>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                        <ItemsControl ItemsSource="{Binding Ideogram.GeneratedImages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:GeneratedImageItem">
                                                    <Grid Width="96" Height="96" Margin="4">
                                                        <!-- Click image center → open in registered Windows image viewer -->
                                                        <Button Command="{Binding $parent[ItemsControl].((vm:ImageGeneratorViewModel)DataContext).Ideogram.OpenGeneratedImageCommand}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand"
                                                                Padding="0"
                                                                BorderThickness="1"
                                                                ToolTip.Tip="{Binding FileName}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Background="{StaticResource SurfaceAltBrush}">
                                                                        <Image Source="{ReflectionBinding Thumbnail, Converter={StaticResource PathToBitmapConverter}}"
                                                                               Stretch="UniformToFill"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Button.Theme>
                                                                <ControlTheme TargetType="Button"/>
                                                            </Button.Theme>
                                                        </Button>
                                                        <!-- "x" top-right → delete file from disk -->
                                                        <Button Command="{Binding $parent[ItemsControl].((vm:ImageGeneratorViewModel)DataContext).Ideogram.DeleteGeneratedImageCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="✕"
                                                                FontSize="11"
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,2,2,0"
                                                                Width="18"
                                                                Height="18"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Delete image file from disk">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{StaticResource DangerBrush}" CornerRadius="9" Opacity="0.9">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"
                                                                                          Content="{TemplateBinding Content}"
                                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                          Name="PART_ContentPresenter"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Button.Theme>
                                                                <ControlTheme TargetType="Button"/>
                                                            </Button.Theme>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Column separator -->
                    <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,10"/>
                    <!-- RIGHT COLUMN: Result -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,12,12,12">
                        <StackPanel>
                            <!-- Result image -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Result" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="420"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Ideogram.ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Ideogram.NoResult}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here"
                                                           FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Actions -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding Ideogram.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding Ideogram.OpenResultFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="12,8"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding Ideogram.OpenResultImageCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}"
                                                Padding="12,8"
                                                FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}"
                                    BorderBrush="#374151"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PlayerTextBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Ideogram.LogOutput}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}"
                                             Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="11"
                                             Padding="4"
                                             Height="200"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- ===== QWEN EDIT: character replacement in a scene ===== -->
            <TabItem Header="🧑‍🤝‍🧑 Qwen Edit" IsVisible="{Binding IsEditGroup}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>
                    <!-- LEFT: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">
                            <!-- Pipeline badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="#FBCFE8"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🧑‍🤝‍🧑 Qwen Image Edit — Character Swap"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#BE185D"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource AccentRoseBrush}" Margin="0,4,0,0" TextWrapping="Wrap">Upload Character 1, Character 2 and a Base scene (always one man + one woman).
                                        Character 1 replaces the man, Character 2 replaces the woman. Click Analyze to
                                        let the VLM write the edit prompt, then edit it and click Generate.</TextBlock>
                                </StackPanel>
                            </Border>
                            <!-- Character 1 -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Character 1 → replaces the MAN" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding QwenEdit.Char1ImagePath, FallbackValue='No image selected'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Character 1"
                                            Command="{Binding QwenEdit.BrowseChar1Command}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}"
                                            Padding="12,8"
                                            FontSize="12"
                                            Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="170"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding QwenEdit.Char1ImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding QwenEdit.NoChar1Image}">
                                                <TextBlock Text="👨" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Character 1 (man)"
                                                           FontSize="12"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Character 2 -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Character 2 → replaces the WOMAN" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding QwenEdit.Char2ImagePath, FallbackValue='No image selected'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Character 2"
                                            Command="{Binding QwenEdit.BrowseChar2Command}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}"
                                            Padding="12,8"
                                            FontSize="12"
                                            Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="170"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding QwenEdit.Char2ImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding QwenEdit.NoChar2Image}">
                                                <TextBlock Text="👩" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Character 2 (woman)"
                                                           FontSize="12"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Base scene -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Base Scene (man + woman to replace)" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding QwenEdit.BaseImagePath, FallbackValue='No image selected'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="📂 Browse Image"
                                                Command="{Binding QwenEdit.BrowseBaseCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="12,8"
                                                FontSize="12"
                                                Margin="0,0,4,0"/>
                                        <Button Grid.Column="1"
                                                Content="📹 Upload Video"
                                                Command="{Binding QwenEdit.BrowseBaseVideoCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="12,8"
                                                FontSize="12"
                                                Margin="4,0,0,0"/>
                                    </Grid>
                                    <!-- Image preview (shown when no video is loaded) -->
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="200"
                                            ClipToBounds="True"
                                            IsVisible="{Binding QwenEdit.NoBaseVideo}">
                                        <Grid>
                                            <Image Source="{Binding QwenEdit.BaseImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding QwenEdit.NoBaseImage}">
                                                <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Base scene with a man and a woman"
                                                           FontSize="12"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Video scrub + snap (shown when a video is loaded) -->
                                    <StackPanel IsVisible="{Binding QwenEdit.HasBaseVideo}">
                                        <Border BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200"
                                                ClipToBounds="True">
                                            <ctrl:VideoPreview x:Name="QwenBaseVideoPlayer"
                                                               Source="{Binding QwenEdit.BaseVideoFileUri}"
                                                               Stretch="Uniform"
                                                               MediaOpened="QwenBaseVideoPlayer_MediaOpened"
                                                               MediaEnded="QwenBaseVideoPlayer_MediaEnded"/>
                                        </Border>
                                        <Slider x:Name="QwenBaseScrubSlider"
                                                Margin="0,6,0,0"
                                                Minimum="0"
                                                Maximum="1"
                                                SmallChange="0.04"
                                                LargeChange="0.5"
                                                Thumb.DragStarted="QwenBaseScrub_DragStarted"
                                                Thumb.DragCompleted="QwenBaseScrub_DragCompleted"
                                                PointerReleased="QwenBaseScrub_Click"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="▶"
                                                    Click="QwenBasePlay_Click"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    Margin="0,0,4,0"/>
                                            <Button Grid.Column="1"
                                                    Content="⏸"
                                                    Click="QwenBasePause_Click"
                                                    Theme="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    Margin="0,0,4,0"/>
                                            <Button Grid.Column="3"
                                                    Content="📸 Snap &amp; Send"
                                                    Click="QwenBaseSnapAndSend_Click"
                                                    Theme="{StaticResource PrimaryButtonStyle}"
                                                    Background="{StaticResource BrandBrush}"
                                                    Padding="14,6"
                                                    FontSize="12"/>
                                        </Grid>
                                        <TextBlock Text="Scrub to a frame, then Snap &amp; Send to set it as the base scene."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Step 1: Analyze -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 1 — Analyze (VLM writes the edit prompt)" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding QwenEdit.AvailableModels}"
                                                  SelectedItem="{Binding QwenEdit.SelectedLlmModel}"
                                                  FontSize="11"
                                                  Padding="6,4"
                                                  VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="🔄"
                                                Command="{Binding QwenEdit.LoadModelsCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4"
                                                FontSize="12"
                                                Margin="6,0,0,0"/>
                                    </Grid>
                                    <Button Content="🔍 Analyze 3 Images → Edit Prompt"
                                            Command="{Binding QwenEdit.AnalyzeCommand}"
                                            IsEnabled="{Binding QwenEdit.CanAnalyze}"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource SuccessBrush}"
                                            Padding="16,10"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsVisible="{Binding QwenEdit.IsAnalyzing}">
                                        <TextBlock Text="⏳ " FontSize="13"/>
                                        <TextBlock Text="{Binding QwenEdit.StatusMessage}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Step 2: Edit prompt -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 2 — Edit Prompt" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding QwenEdit.Prompt}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinLines="5"
                                             MaxLines="12"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             FontSize="12"
                                             Padding="8"/>
                                </StackPanel>
                            </Border>
                            <!-- Step 3: Generate -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 3 — Generate" Theme="{StaticResource HeaderTextStyle}"/>
                                    <!-- Workflow selector: Qwen Edit (default) or Klein (Flux.2) -->
                                    <TextBlock Text="Workflow"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding QwenEdit.WorkflowOptions}"
                                              SelectedItem="{Binding QwenEdit.SelectedWorkflow}"
                                              FontSize="12"
                                              Padding="6,4"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding QwenEdit.GenerateDescription}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,8"
                                               TextWrapping="Wrap"/>
                                    <Button Content="🚀 Generate"
                                            Command="{Binding QwenEdit.GenerateCommand}"
                                            IsEnabled="{Binding QwenEdit.CanGenerate}"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}"
                                            Padding="16,10"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding QwenEdit.StatusMessage}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding QwenEdit.Progress}"
                                                     Maximum="100"
                                                     Height="6"
                                                     Margin="0,4,0,0"
                                                     Background="{StaticResource BorderBrush}"
                                                     Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>
                    <!-- RIGHT: result + log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">
                            <!-- Result image -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="460"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding QwenEdit.ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding QwenEdit.NoResult}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here"
                                                           FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Actions -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding QwenEdit.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding QwenEdit.OpenResultFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="12,8"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding QwenEdit.OpenResultImageCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}"
                                                Padding="12,8"
                                                FontSize="12"/>
                                    </StackPanel>
                                    <Button Content="✨ Enhance (Klein img2img)"
                                            Command="{Binding QwenEdit.EnhanceCommand}"
                                            IsEnabled="{Binding QwenEdit.CanEnhance}"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}"
                                            Padding="14,9"
                                            FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,10,0,0"/>
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Text="Refines the current result with a Flux.2 Klein img2img pass."/>
                                </StackPanel>
                            </Border>
                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}"
                                    BorderBrush="#374151"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PlayerTextBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding QwenEdit.LogOutput}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}"
                                             Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="11"
                                             Padding="4"
                                             Height="220"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- ===== QWEN EDIT 2.1: simple image editing with Qwen Image 2.1 ===== -->
            <TabItem Header="🎨 Qwen Edit 2.1" IsVisible="{Binding IsEditGroup}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>
                    <!-- LEFT: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">
                            <!-- Pipeline badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="#C4B5FD"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎨 Qwen Image 2.1 — Image Edit" FontSize="13" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource AccentVioletBrush}" Margin="0,4,0,0" TextWrapping="Wrap">Upload a source image and describe the edit you want to make.
                                        Qwen Image 2.1 will transform the image based on your prompt.</TextBlock>
                                </StackPanel>
                            </Border>
                            <!-- Source image -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Source Image" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding QwenEdit21.SourceImagePath, FallbackValue='No image selected'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Image"
                                            Command="{Binding QwenEdit21.BrowseSourceCommand}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}"
                                            Padding="12,8"
                                            FontSize="12"
                                            Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="200"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding QwenEdit21.SourceImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding QwenEdit21.NoSourceImage}">
                                                <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Source image to edit"
                                                           FontSize="12"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Edit Prompt -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Edit Prompt" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap">Describe the transformation you want to apply to the image.</TextBlock>
                                    <TextBox Text="{Binding QwenEdit21.Prompt}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinLines="4"
                                             MaxLines="10"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             FontSize="12"
                                             Padding="8"/>
                                </StackPanel>
                            </Border>
                            <!-- Negative Prompt -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Negative Prompt" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding QwenEdit21.NegativePrompt}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinLines="2"
                                             MaxLines="6"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             FontSize="11"
                                             Padding="8"/>
                                </StackPanel>
                            </Border>
                            <!-- Settings -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Settings" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Aspect Ratio -->
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Aspect Ratio:"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,8"/>
                                        <ComboBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  ItemsSource="{Binding QwenEdit21.AspectRatios}"
                                                  SelectedItem="{Binding QwenEdit21.SelectedAspectRatio}"
                                                  FontSize="12"
                                                  Padding="6,4"
                                                  VerticalContentAlignment="Center"
                                                  Margin="0,0,0,8"/>
                                        <!-- Steps -->
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Steps:"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,8"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Slider Value="{Binding QwenEdit21.Steps}" Minimum="1" Maximum="50" Width="150" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding QwenEdit21.Steps}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <!-- CFG -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="CFG:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <Slider Value="{Binding QwenEdit21.Cfg}" Minimum="1" Maximum="15" Width="150" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding QwenEdit21.Cfg, StringFormat='{}{0:F1}'}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Generate -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Generate" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Button Content="🚀 Generate"
                                            Command="{Binding QwenEdit21.GenerateCommand}"
                                            IsEnabled="{Binding QwenEdit21.CanGenerate}"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}"
                                            Padding="16,10"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,6,0,0"/>
                                    <Button Content="❌ Cancel"
                                            Command="{Binding QwenEdit21.CancelCommand}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,8"
                                            FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,6,0,0"
                                            IsVisible="{Binding QwenEdit21.IsGenerating}"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding QwenEdit21.StatusMessage}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding QwenEdit21.Progress}"
                                                     Maximum="100"
                                                     Height="6"
                                                     Margin="0,4,0,0"
                                                     Background="{StaticResource BorderBrush}"
                                                     Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>
                    <!-- RIGHT: result + log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">
                            <!-- Result image -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="460"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding QwenEdit21.ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding QwenEdit21.NoResult}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here"
                                                           FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Actions -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding QwenEdit21.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding QwenEdit21.OpenResultFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="12,8"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding QwenEdit21.OpenResultImageCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}"
                                                Padding="12,8"
                                                FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}"
                                    BorderBrush="#374151"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PlayerTextBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding QwenEdit21.LogOutput}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}"
                                             Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="11"
                                             Padding="4"
                                             Height="220"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="♻️ Restore" IsVisible="{Binding IsEditGroup}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>
                    <!-- LEFT: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">
                            <!-- Pipeline badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="#A5F3FC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="♻️ Image Restoration — Flux.2 Klein" FontSize="13" FontWeight="SemiBold" Foreground="#0E7490"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0" TextWrapping="Wrap">Upload an image to restore. It is upscaled to the target megapixels, re-rendered with
                                        Flux.2 Klein, realigned (Pixel Drift Fix) and blended back over the original. Lower
                                        blend = more restoration; higher blend = closer to the original.</TextBlock>
                                </StackPanel>
                            </Border>
                            <!-- Source image -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Image to Restore" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding Restore.SourceImagePath, FallbackValue='No image selected'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Image"
                                            Command="{Binding Restore.BrowseSourceImageCommand}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}"
                                            Padding="12,8"
                                            FontSize="12"
                                            Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="220"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Restore.SourceImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding Restore.NoSourceImage}">
                                                <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Image to restore"
                                                           FontSize="12"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Guidance prompt -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Guidance Prompt" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding Restore.Prompt}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinLines="3"
                                             MaxLines="8"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             FontSize="12"
                                             Padding="8"/>
                                </StackPanel>
                            </Border>
                            <!-- Settings -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Settings" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Original blend"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Restore.BlendFactorText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                    <Slider Minimum="0"
                                            Maximum="1"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            Value="{Binding Restore.BlendFactor}"
                                            Margin="0,2,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Target resolution"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Restore.MegapixelsText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                    <Slider Minimum="0.5"
                                            Maximum="4"
                                            SmallChange="0.5"
                                            LargeChange="1"
                                            Value="{Binding Restore.Megapixels}"
                                            Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- Generate -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Restore" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Button Content="🚀 Restore Image"
                                            Command="{Binding Restore.GenerateCommand}"
                                            IsEnabled="{Binding Restore.CanGenerate}"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}"
                                            Padding="16,10"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Restore.StatusMessage}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding Restore.Progress}"
                                                     Maximum="100"
                                                     Height="6"
                                                     Margin="0,4,0,0"
                                                     Background="{StaticResource BorderBrush}"
                                                     Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>
                    <!-- RIGHT: result + log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">
                            <!-- Result image -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="460"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Restore.ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Restore.NoResult}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here"
                                                           FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Actions -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding Restore.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding Restore.OpenResultFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="12,8"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding Restore.OpenResultImageCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}"
                                                Padding="12,8"
                                                FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}"
                                    BorderBrush="#374151"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PlayerTextBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Restore.LogOutput}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}"
                                             Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="11"
                                             Padding="4"
                                             Height="220"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="🔍 Image Upscaler" IsVisible="{Binding IsEditGroup}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>
                    <!-- LEFT: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">
                            <!-- Pipeline badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="#C7D2FE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🔍 Tiled Upscaling — SeedVR2"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentIndigoBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">The picture is cut into overlapping tiles, each tile is upscaled by the SeedVR2
                                        diffusion transformer, and the tiles are blended back together. Peak VRAM is set by
                                        the tile size rather than the output size, so 4K and beyond stays reachable.
                                        Upscale one image, or point at a folder and run the whole thing.</TextBlock>
                                </StackPanel>
                            </Border>
                            <!-- Mode -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Mode" Theme="{StaticResource HeaderTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <RadioButton Content="🖼️ Single Image"
                                                     GroupName="UpscalerMode"
                                                     Theme="{StaticResource ToggleRadioStyle}"
                                                     IsChecked="{Binding ImageUpscaler.IsSingleMode}"
                                                     Margin="0,0,8,0"/>
                                        <RadioButton Content="📁 Batch Folder"
                                                     GroupName="UpscalerMode"
                                                     Theme="{StaticResource ToggleRadioStyle}"
                                                     IsChecked="{Binding ImageUpscaler.IsBatchMode}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Single-image source -->
                            <Border Theme="{StaticResource SectionPanelStyle}"
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    IsVisible="{Binding ImageUpscaler.IsSingleMode}">
                                <StackPanel>
                                    <TextBlock Text="Image to Upscale" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding ImageUpscaler.SourceImagePath, FallbackValue='No image selected'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Image"
                                            Command="{Binding ImageUpscaler.BrowseSourceImageCommand}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}"
                                            Padding="12,8"
                                            FontSize="12"
                                            Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="200"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ImageUpscaler.SourceImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding ImageUpscaler.NoSourceImage}">
                                                <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Image to upscale"
                                                           FontSize="12"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Batch source -->
                            <Border Theme="{StaticResource SectionPanelStyle}"
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    IsVisible="{Binding ImageUpscaler.IsBatchMode}">
                                <StackPanel>
                                    <TextBlock Text="Folder to Upscale" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding ImageUpscaler.BatchFolderPath, FallbackValue='No folder selected'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="📂 Browse Folder"
                                                Command="{Binding ImageUpscaler.BrowseBatchFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="12,8"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Content="🔄 Rescan"
                                                Command="{Binding ImageUpscaler.RescanBatchFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource NeutralBrush}"
                                                Padding="12,8"
                                                FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox Content="Include subfolders (output mirrors the tree)"
                                              IsChecked="{Binding ImageUpscaler.IncludeSubfolders}"
                                              FontSize="12"
                                              Margin="0,0,0,4"/>
                                    <CheckBox Content="Skip images that already have a result"
                                              IsChecked="{Binding ImageUpscaler.SkipExisting}"
                                              FontSize="12"
                                              Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding ImageUpscaler.BatchSummary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentIndigoBrush}"
                                               Margin="0,0,0,6"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource SurfaceBrush}"
                                            Height="180">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,4">
                                            <ItemsControl ItemsSource="{Binding ImageUpscaler.BatchItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="m:ImageUpscaleBatchItem">
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontSize="11" Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding FileName}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding SourcePath}"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Detail}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       MaxWidth="150"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Output folder -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Output Folder" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding ImageUpscaler.EffectiveOutputFolder}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <Button Content="📁 Choose Output Folder"
                                            Command="{Binding ImageUpscaler.BrowseOutputFolderCommand}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource NeutralBrush}"
                                            Padding="12,8"
                                            FontSize="12"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <!-- Model + target -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Model &amp; Target" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="SeedVR2 model" Theme="{StaticResource FieldLabelStyle}" Margin="0,4,0,2"/>
                                    <ComboBox ItemsSource="{Binding ImageUpscaler.DitModels}"
                                              SelectedItem="{Binding ImageUpscaler.SelectedDitModel}"
                                              FontSize="11"
                                              Padding="6,4"
                                              Margin="0,0,0,4"/>
                                    <TextBlock Text="3B is fast; 7B is sharper but much heavier. Models download on first use."
                                               Theme="{StaticResource HintTextStyle}"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Target resolution"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ImageUpscaler.NewResolutionText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                    <Slider Minimum="512"
                                            Maximum="8192"
                                            SmallChange="64"
                                            LargeChange="256"
                                            Value="{Binding ImageUpscaler.NewResolution}"
                                            Margin="0,2,0,8"/>
                                    <TextBlock Text="Which side that applies to" Theme="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding ImageUpscaler.ResolutionTargets}"
                                              SelectedItem="{Binding ImageUpscaler.ResolutionTarget}"
                                              FontSize="11"
                                              Padding="6,4"
                                              Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Seed"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ImageUpscaler.Seed}"
                                                 FontSize="12"
                                                 Padding="6,4"
                                                 ToolTip.Tip="The seed the last run used. Untick Randomize to reuse it."/>
                                        <CheckBox Grid.Column="2"
                                                  Content="Randomize"
                                                  IsChecked="{Binding ImageUpscaler.RandomizeSeed}"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Tiling -->
                            <Expander Header="Tiling" IsExpanded="False" Margin="0,0,0,10" FontSize="12" FontWeight="SemiBold">
                                <Border Theme="{StaticResource SectionPanelStyle}" Padding="12" Margin="0,4,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Tile size"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ImageUpscaler.TileSizeText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="128"
                                                Maximum="2048"
                                                SmallChange="64"
                                                LargeChange="128"
                                                Value="{Binding ImageUpscaler.TileWidth}"
                                                Margin="0,2,0,2"/>
                                        <Slider Minimum="128"
                                                Maximum="2048"
                                                SmallChange="64"
                                                LargeChange="128"
                                                Value="{Binding ImageUpscaler.TileHeight}"
                                                Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Tile overlap"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ImageUpscaler.TilePaddingText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0"
                                                Maximum="256"
                                                SmallChange="8"
                                                LargeChange="16"
                                                Value="{Binding ImageUpscaler.TilePadding}"
                                                Margin="0,2,0,2"/>
                                        <TextBlock Text="More overlap hides seams but costs time. 32–64 is the usual range."
                                                   Theme="{StaticResource HintTextStyle}"
                                                   Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Per-tile resolution cap"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ImageUpscaler.TileUpscaleResolutionText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="256"
                                                Maximum="4096"
                                                SmallChange="64"
                                                LargeChange="256"
                                                Value="{Binding ImageUpscaler.TileUpscaleResolution}"
                                                Margin="0,2,0,2"/>
                                        <TextBlock Text="The real VRAM dial. Drop this first if a run hits out-of-memory."
                                                   Theme="{StaticResource HintTextStyle}"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="Tile order" Theme="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding ImageUpscaler.TilingStrategies}"
                                                  SelectedItem="{Binding ImageUpscaler.TilingStrategy}"
                                                  FontSize="11"
                                                  Padding="6,4"
                                                  Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Tiles per call"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ImageUpscaler.TileBatchSizeText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="1"
                                                Maximum="21"
                                                SmallChange="4"
                                                LargeChange="4"
                                                TickFrequency="4"
                                                Value="{Binding ImageUpscaler.TileBatchSize}"
                                                Margin="0,2,0,2"/>
                                        <TextBlock Text="Faster, but VRAM scales with it. Snapped to SeedVR2's 1/5/9/13/17/21."
                                                   Theme="{StaticResource HintTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                            <!-- Blending & colour -->
                            <Expander Header="Blending &amp; Colour" IsExpanded="False" Margin="0,0,0,10" FontSize="12" FontWeight="SemiBold">
                                <Border Theme="{StaticResource SectionPanelStyle}" Padding="12" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Blending method" Theme="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding ImageUpscaler.BlendingMethods}"
                                                  SelectedItem="{Binding ImageUpscaler.BlendingMethod}"
                                                  FontSize="11"
                                                  Padding="6,4"
                                                  Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Seam blur"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ImageUpscaler.MaskBlurText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0"
                                                Maximum="16"
                                                SmallChange="1"
                                                LargeChange="2"
                                                Value="{Binding ImageUpscaler.MaskBlur}"
                                                Margin="0,2,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Anti-aliasing"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ImageUpscaler.AntiAliasingStrengthText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0"
                                                Maximum="0.5"
                                                SmallChange="0.05"
                                                LargeChange="0.1"
                                                Value="{Binding ImageUpscaler.AntiAliasingStrength}"
                                                Margin="0,2,0,8"/>
                                        <TextBlock Text="Colour correction" Theme="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding ImageUpscaler.ColorCorrections}"
                                                  SelectedItem="{Binding ImageUpscaler.ColorCorrection}"
                                                  FontSize="11"
                                                  Padding="6,4"/>
                                        <TextBlock Text="Matches the upscale back to the original's colours. 'lab' is the safe default."
                                                   Theme="{StaticResource HintTextStyle}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                            <!-- VRAM -->
                            <Expander Header="VRAM" IsExpanded="False" Margin="0,0,0,10" FontSize="12" FontWeight="SemiBold">
                                <Border Theme="{StaticResource SectionPanelStyle}" Padding="12" Margin="0,4,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Block swap"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ImageUpscaler.BlocksToSwapText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0"
                                                Maximum="36"
                                                SmallChange="1"
                                                LargeChange="4"
                                                Value="{Binding ImageUpscaler.BlocksToSwap}"
                                                Margin="0,2,0,2"/>
                                        <TextBlock Text="Parks transformer blocks in system RAM. Slower, but it rescues a run that won't fit."
                                                   Theme="{StaticResource HintTextStyle}"
                                                   Margin="0,0,0,8"/>
                                        <CheckBox Content="Tiled VAE encode/decode"
                                                  IsChecked="{Binding ImageUpscaler.TiledVae}"
                                                  FontSize="12"
                                                  FontWeight="Normal"
                                                  Margin="0,0,0,4"/>
                                        <CheckBox Content="Keep the model loaded between images"
                                                  IsChecked="{Binding ImageUpscaler.KeepModelLoaded}"
                                                  FontSize="12"
                                                  FontWeight="Normal"/>
                                        <TextBlock Text="Keeping it loaded saves a reload per image — worth a lot across a batch."
                                                   Theme="{StaticResource HintTextStyle}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                            <!-- Run -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Upscale" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Button Content="{Binding ImageUpscaler.GenerateButtonText}"
                                            Command="{Binding ImageUpscaler.GenerateCommand}"
                                            IsEnabled="{Binding ImageUpscaler.CanGenerate}"
                                            Theme="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource AccentIndigoBrush}"
                                            Padding="16,10"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <Button Content="✖ Cancel"
                                            Command="{Binding ImageUpscaler.CancelCommand}"
                                            IsEnabled="{Binding ImageUpscaler.IsBusy}"
                                            Theme="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}"
                                            Padding="12,8"
                                            FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,6,0,0"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding ImageUpscaler.StatusMessage}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding ImageUpscaler.Progress}"
                                                     Maximum="100"
                                                     Height="6"
                                                     Margin="0,4,0,0"
                                                     Background="{StaticResource BorderBrush}"
                                                     Foreground="{StaticResource AccentIndigoBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>
                    <!-- RIGHT: result + log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">
                            <!-- Result image -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Theme="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}"
                                            Height="460"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ImageUpscaler.ResultImageSource, Converter={StaticResource PathToBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding ImageUpscaler.NoResult}">
                                                <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="The upscaled image will appear here"
                                                           FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Actions -->
                            <Border Theme="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Theme="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding ImageUpscaler.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding ImageUpscaler.OpenResultFolderCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}"
                                                Padding="12,8"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding ImageUpscaler.OpenResultImageCommand}"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}"
                                                Padding="12,8"
                                                FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}"
                                    BorderBrush="#374151"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PlayerTextBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ImageUpscaler.LogOutput}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}"
                                             Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="11"
                                             Padding="4"
                                             Height="220"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
        <!-- Status Bar -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Height="28">
            <DockPanel LastChildFill="False">
                <ContentControl>
                    <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
                </ContentControl>
                <ContentControl HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text=":" FontSize="11"/>
                        <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </ContentControl>
            </DockPanel>
        </Border>
    </Grid>
</win:AppWindow>
