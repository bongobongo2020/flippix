<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlipPix.UI.Linux.Windows.StoryVideoWindow"
        Title="FlipPix - Story Video Generator" Height="850" Width="1000"
        WindowStartupLocation="CenterScreen"
        MinHeight="750" MinWidth="900">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" PointerPressed="Header_PointerPressed" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#9C27B0" Offset="0"/>
                    <GradientStop Color="#E91E63" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="25,20">
                <TextBlock Text="Story Video Generator"
                           FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Load prompts and generate a story video with multiple clips"
                           FontSize="13" Foreground="#FFFAF0" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20,15,20,15" Spacing="15">

                <!-- Step 1: Load Prompts -->
                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Step 1: Load Story Prompts" FontSize="14" FontWeight="Bold" Foreground="#9C27B0"/>
                        <TextBlock Text="Load a JSON file containing your story prompts or manually edit them below"
                                   FontSize="12" Foreground="#666"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Load Prompts" Classes="primary"
                                    Command="{Binding LoadPromptsCommand}" Width="120" Height="35"/>
                            <Button Content="Save Prompts" Classes="secondary"
                                    Command="{Binding SavePromptsCommand}" Width="120" Height="35"/>
                        </StackPanel>

                        <!-- Prompts Grid -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 1:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt1, Mode=TwoWay}"
                                         TextWrapping="Wrap" Height="70" FontSize="10"
                                         AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 2:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt2, Mode=TwoWay}"
                                         TextWrapping="Wrap" Height="70" FontSize="10"
                                         AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 3:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt3, Mode=TwoWay}"
                                         TextWrapping="Wrap" Height="70" FontSize="10"
                                         AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 4:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt4, Mode=TwoWay}"
                                         TextWrapping="Wrap" Height="70" FontSize="10"
                                         AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 5:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt5, Mode=TwoWay}"
                                         TextWrapping="Wrap" Height="70" FontSize="10"
                                         AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 6:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt6, Mode=TwoWay}"
                                         TextWrapping="Wrap" Height="70" FontSize="10"
                                         AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 7:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt7, Mode=TwoWay}"
                                         TextWrapping="Wrap" Height="70" FontSize="10"
                                         AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 8:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt8, Mode=TwoWay}"
                                         TextWrapping="Wrap" Height="70" FontSize="10"
                                         AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Prompt 9:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt9, Mode=TwoWay}"
                                         TextWrapping="Wrap" Height="70" FontSize="10"
                                         AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Prompt 10:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt10, Mode=TwoWay}"
                                         TextWrapping="Wrap" Height="70" FontSize="10"
                                         AcceptsReturn="True"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Step 2: Generate Video -->
                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Step 2: Generate Story Video" FontSize="14" FontWeight="Bold" Foreground="#9C27B0"/>

                        <!-- Workflow Selection -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="Video Workflow" FontWeight="SemiBold" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding WorkflowNames}"
                                      SelectedIndex="{Binding SelectedWorkflowIndex, Mode=TwoWay}"
                                      FontSize="11" HorizontalAlignment="Stretch"/>
                            <TextBlock FontSize="11">
                                <Run Text="Currently selected: " FontWeight="SemiBold"/>
                                <Run Text="{Binding SelectedWorkflowName}" Foreground="#4CAF50"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="This will generate video clips for each prompt using the selected workflow"
                                   FontSize="12" Foreground="#666"/>

                        <TextBlock Text="Note: Video generation can take 2-10 minutes per clip depending on your hardware"
                                   FontSize="11" Foreground="#E91E63" FontWeight="SemiBold"/>

                        <Button Content="Generate Story Video" Classes="primary"
                                Command="{Binding GenerateVideoCommand}"
                                Width="250" HorizontalAlignment="Left"/>

                        <!-- Processing Status -->
                        <Border Background="#FFF9F0" BorderBrush="#FFE0B0" BorderThickness="1"
                                CornerRadius="5" Padding="15"
                                IsVisible="{Binding IsProcessing}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding ProcessingStatus}" FontWeight="SemiBold"
                                           FontSize="12" TextWrapping="Wrap"/>
                                <ProgressBar Value="{Binding ProcessingProgress}" Height="20"/>
                                <TextBlock Text="{Binding ProgressPercentage}"
                                           HorizontalAlignment="Center" FontSize="12"
                                           FontWeight="Bold" Foreground="#9C27B0"/>
                            </StackPanel>
                        </Border>

                        <!-- Result Video -->
                        <StackPanel IsVisible="{Binding HasResultVideo}" Spacing="8">
                            <TextBlock Text="Videos Generated Successfully!" FontWeight="Bold"
                                       FontSize="14" Foreground="#4CAF50"/>
                            <TextBlock Text="{Binding ResultVideoPath}" FontSize="11"
                                       Foreground="#666" TextWrapping="Wrap"/>
                            <Button Content="Open Output Folder" Classes="secondary"
                                    Command="{Binding OpenResultFolderCommand}"
                                    Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Log (Collapsible) -->
                <Expander Header="Processing Log" IsExpanded="True">
                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="200">
                            <TextBox Text="{Binding LogOutput}" TextWrapping="Wrap"
                                     IsReadOnly="True" FontFamily="Monospace" FontSize="10"
                                     Background="Transparent" BorderThickness="0" Padding="10"/>
                        </ScrollViewer>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="28">
            <DockPanel>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"
                           VerticalAlignment="Center" Margin="5,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
