<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlipPix.UI.Linux.Windows.StoryVideoWindow"
        Title="FlipPix - Story Video Generator" Height="850" Width="1000"
        WindowStartupLocation="CenterScreen"
        MinHeight="700" MinWidth="860">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" PointerPressed="Header_PointerPressed" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#9C27B0" Offset="0"/>
                    <GradientStop Color="#E91E63" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="25,18" Spacing="4">
                <TextBlock Text="Story Video Generator" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Queue multiple batches — each with its own prompts and workflow"
                           FontSize="12" Foreground="#FFFAF0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20,15,20,15" Spacing="15">

                <!-- ═══ Step 1: Configure a Batch ═══ -->
                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Step 1: Configure a New Batch"
                                   FontSize="14" FontWeight="Bold" Foreground="#9C27B0"/>
                        <TextBlock Text="Load a prompts file (.json or .txt), choose a workflow, then add to the queue."
                                   FontSize="12" Foreground="#666"/>

                        <!-- Workflow selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Video Workflow" FontWeight="SemiBold" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding WorkflowNames}"
                                      SelectedIndex="{Binding SelectedWorkflowIndex, Mode=TwoWay}"
                                      FontSize="11" HorizontalAlignment="Stretch" Height="34"/>
                            <TextBlock FontSize="10" Foreground="#999">
                                <Run Text="Selected: "/>
                                <Run Text="{Binding SelectedWorkflowName}" Foreground="#4CAF50" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Load prompts file -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Grid.Column="0" BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                    Background="#F0F0F0" Padding="10,8">
                                <TextBlock Text="{Binding PendingBatchSummary}" FontSize="11"
                                           Foreground="#555" TextWrapping="Wrap"/>
                            </Border>
                            <Button Grid.Column="1" Content="Load Prompts from File"
                                    Classes="secondary"
                                    Command="{Binding LoadPromptsCommand}"
                                    Height="36" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Add to Queue button -->
                        <Button Content="Add to Queue"
                                Classes="primary"
                                Command="{Binding AddToBatchQueueCommand}"
                                Width="180" Height="38" HorizontalAlignment="Left"/>

                        <TextBlock Text="⚠ Each video clip takes 2–10 min depending on hardware"
                                   FontSize="11" Foreground="#E91E63" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Step 2: Batch Queue ═══ -->
                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold" Foreground="#9C27B0">
                                <Run Text="Step 2: Batch Queue"/>
                                <Run Text=" (" Foreground="#999" FontSize="13"/>
                                <Run Text="{Binding BatchQueue.Count}" Foreground="#999" FontSize="13"/>
                                <Run Text=" batches)" Foreground="#999" FontSize="13"/>
                            </TextBlock>
                            <Button Grid.Column="1" Content="Clear Completed"
                                    Classes="secondary"
                                    Command="{Binding ClearCompletedBatchesCommand}"
                                    Height="30" FontSize="11"/>
                        </Grid>

                        <!-- Empty state -->
                        <Border IsVisible="{Binding HasNoBatchItems}"
                                Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="4" Padding="20">
                            <TextBlock Text="No batches queued yet — configure a batch above and click 'Add to Queue'"
                                       FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Queue header row -->
                        <Grid IsVisible="{Binding HasBatchItems}" ColumnDefinitions="30,*,130,70,70">
                            <TextBlock Grid.Column="1" Text="BATCH" FontSize="10" Foreground="#999" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="WORKFLOW" FontSize="10" Foreground="#999" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="CLIPS" FontSize="10" Foreground="#999" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Batch rows -->
                        <ItemsControl ItemsSource="{Binding BatchQueue}" IsVisible="{Binding HasBatchItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="4,7">
                                        <Border.Background>
                                            <!-- Highlight rows by status -->
                                        </Border.Background>
                                        <Grid ColumnDefinitions="30,*,130,70,70">

                                            <!-- Status icon -->
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                                       FontSize="14" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock">
                                                        <Setter Property="Foreground" Value="#2196F3"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                            </TextBlock>

                                            <!-- Batch name -->
                                            <TextBlock Grid.Column="1" Text="{Binding BatchName}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                                            <!-- Workflow -->
                                            <TextBlock Grid.Column="2" Text="{Binding WorkflowName}"
                                                       FontSize="11" Foreground="#555" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                                            <!-- Progress -->
                                            <TextBlock Grid.Column="3" Text="{Binding ProgressText}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" FontWeight="SemiBold"/>

                                            <!-- Remove button (Queued items only) -->
                                            <Button Grid.Column="4"
                                                    Content="Remove"
                                                    FontSize="10" Height="24"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsQueued}"
                                                    Command="{Binding $parent[Window].DataContext.RemoveBatchCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ Processing Status ═══ -->
                <Border Background="#FFF9F0" BorderBrush="#FFE0B0" BorderThickness="1" CornerRadius="5" Padding="15"
                        IsVisible="{Binding IsProcessing}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding ProcessingStatus}"
                                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Cancel"
                                    Classes="secondary"
                                    Command="{Binding CancelGenerationCommand}"
                                    Height="30" Margin="12,0,0,0"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProcessingProgress}" Height="18"/>
                        <TextBlock Text="{Binding ProgressPercentage}"
                                   HorizontalAlignment="Center" FontSize="11"
                                   FontWeight="Bold" Foreground="#9C27B0"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Result ═══ -->
                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Padding="15"
                        IsVisible="{Binding HasResultVideo}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Videos Generated Successfully"
                                   FontWeight="Bold" FontSize="14" Foreground="#4CAF50"/>
                        <TextBlock Text="{Binding ResultVideoPath}" FontSize="11"
                                   Foreground="#666" TextWrapping="Wrap"/>
                        <Button Content="Open Output Folder" Classes="secondary"
                                Command="{Binding OpenResultFolderCommand}"
                                Width="180" Height="34" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Log ═══ -->
                <Expander Header="Processing Log" IsExpanded="True">
                    <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="200">
                            <TextBox Text="{Binding LogOutput}" TextWrapping="Wrap"
                                     IsReadOnly="True" FontFamily="Monospace" FontSize="10"
                                     Background="Transparent" BorderThickness="0" Padding="10"/>
                        </ScrollViewer>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="28">
            <DockPanel>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"
                           VerticalAlignment="Center" Margin="5,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
