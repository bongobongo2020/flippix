<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlipPix.UI.Linux.Controls"
             xmlns:ctrl="clr-namespace:FlipPix.UI.Linux.Controls"
             x:Class="FlipPix.UI.Linux.Views.Video.H3CastView">

    <!-- Ported from VideoGeneratorWindow.xaml lines 2762-3628 ("🪪👥 H3 Cast").
         DataContext is the window's H3CastVM. -->

    <!-- Named so the per-character cards, whose DataContext is a CharacterSlot, can
         still reach the tab's own commands. -->
    <Grid x:Name="H3CastRoot" Theme="{StaticResource TabPageStyle}">
        <Grid.Resources>
            <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentCyanColor}"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
        <Border Grid.Column="0" Theme="{StaticResource TabSideRailStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">

                    <!-- Scene & story: two ways in, either one is enough.
                         The image (never uploaded) carries setting, light and
                         wardrobe; the story carries what happens. With no image
                         the request goes to the llama-server as plain text. -->
                    <Border Theme="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ctrl:SectionHeader Title="SCENE &amp; STORY" Note="  · either one is enough — and the wardrobe comes from it" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="124"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Scene image -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Scene image" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                            Background="{StaticResource SurfaceAltBrush}" Height="126" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="Optional"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10" IsVisible="{Binding SceneImagePreview, Converter={StaticResource IsNullConverter}}"/>
                                            <Image Source="{Binding SceneImagePreview, Converter={StaticResource PathToBitmapConverter}}" Stretch="Uniform"/>
                                        </Grid>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Browse…"
                                                Command="{Binding SelectSceneImageCommand}"
                                                Height="26" Padding="6,0" FontSize="11" Margin="0,0,4,0"
                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <Button Grid.Column="1" Content="✕"
                                                Command="{Binding ClearSceneImageCommand}"
                                                IsEnabled="{Binding HasSceneImage}"
                                                Height="26" Width="26" FontSize="11"
                                                ToolTip.Tip="Drop the scene image and work from the story alone."
                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SceneImageInfo}" FontSize="9" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Story text -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Story" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding StoryText}"
                                             TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
                                             Height="126" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                             FontSize="11" Padding="6"
                                             ToolTip.Tip="Type or paste the story the video tells. With a scene image it says what happens in it; on its own it is the whole brief — Analyze then works from the text alone and writes the setting, lighting and wardrobe out of the prose, casting &lt;Picture 1&gt; and &lt;Picture 2&gt; in the story's roles."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="📄 Load .txt"
                                                Command="{Binding LoadStoryCommand}"
                                                Height="26" Padding="6,0" FontSize="11" Margin="0,0,4,0"
                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                ToolTip.Tip="Read a story out of a .txt or .md file into the box."/>
                                        <Button Grid.Column="1" Content="✕"
                                                Command="{Binding ClearStoryCommand}"
                                                Height="26" Width="26" FontSize="11"
                                                ToolTip.Tip="Empty the story box."
                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding StorySourceSummary}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- Wardrobe. Decided once and written into every clip's
                                 prompt verbatim: the clips are generated separately from
                                 text written block by block, so an outfit left to the
                                 prose is re-invented every few clips. -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wardrobe — derived from the story"
                                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Button Grid.Column="1" Content="{Binding WardrobeLockButtonText}"
                                        Command="{Binding ToggleWardrobeLockCommand}"
                                        Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        ToolTip.Tip="Locked, the wardrobe is the story's: it is rewritten whenever the story, the scene image or the cast changes, and cannot be typed over.&#x0a;&#x0a;Unlock to dress the cast yourself — your text then stands, and the story stops rewriting it until you lock it again."/>
                                <Button Grid.Column="2" Content="🎽 Derive"
                                        Command="{Binding DeriveWardrobeCommand}"
                                        Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        ToolTip.Tip="Re-rolls the outfits now, without waiting for the story to change — off the scene image if there is one, otherwise out of the story.&#x0a;&#x0a;It always writes an outfit for BOTH characters, whether or not their photos have been picked yet: the wardrobe is a decision about the story, and a second character's line is simply left out of any clip they are not in. The sheets are built from whatever is in this box, so derive before you build them."/>
                                <Button Grid.Column="3" Content="✕"
                                        Command="{Binding ClearWardrobeCommand}"
                                        Height="24" Width="24" FontSize="10"
                                        ToolTip.Tip="Empty the wardrobe box and let the story write a fresh one."
                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            </Grid>
                            <TextBox Text="{Binding CastWardrobe}"
                                     IsReadOnly="{Binding IsWardrobeLocked}"
                                     TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
                                     Height="64" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"
                                     BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                     FontSize="11" Padding="6"
                                     ToolTip.Tip="One line per character, naming every garment. It is written from the story a couple of seconds after you stop typing, and it is what the character sheets are generated in AND what every clip's prompt quotes — the picture and the words then agree, which is what stops the cast changing outfits between clips.&#x0a;&#x0a;Read-only while locked; press 🔒 to take it over."/>
                            <TextBlock Text="{Binding WardrobeSummary}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- Total video length. H3 tops out at ~15s per pass, so
                                 anything longer is written as a chain of clips and
                                 queued one job per clip, same sheets throughout. -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Video length" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="10,2">
                                    <TextBlock Text="{Binding StoryDurationSeconds, StringFormat={}{0:0} s}"
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                </Border>
                            </Grid>
                            <Slider Value="{Binding StoryDurationSeconds}"
                                    Minimum="5" Maximum="120"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    SmallChange="5" LargeChange="15"
                                    Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,4"
                                    ToolTip.Tip="Length of the finished video, in 5-second steps up to 2 minutes. MiniMax H3 renders at most ~15s per pass, so anything longer is written as a chain of consecutive clips — Analyze writes them all in one reply, Add to Queue enqueues one job per clip against the same character sheets, and they are joined into a single file when the last one lands."/>
                            <TextBlock Text="{Binding ClipPlanSummary}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- The medium the writer works in. Left on Auto it picks,
                                 and it used to pick gacha anime almost every time
                                 whatever the story was. -->
                            <TextBlock Text="Visual style" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding VisualStyleOptions}"
                                      SelectedItem="{Binding VisualStyle, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding Name}"
                                      HorizontalAlignment="Stretch"
                                      Height="30" FontSize="11" Margin="0,0,0,4"
                                      ToolTip.Tip="The medium every clip is written in. The style words open [Shot 1], which is the only place MiniMax H3 reads the look of the video from &#x2014; so the choice here is handed to the prompt writer as settled fact and copied verbatim into every clip of a chain, exactly the way the wardrobe is.&#x0a;&#x0a;Auto leaves it to the writer, which is what this tab did before: it reads the medium off the scene image where there is one and off the story where there is not."/>
                            <TextBlock Text="{Binding VisualStyleSummary}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="🔍 Analyze → H3 Prompt"
                                        Command="{Binding AnalyzeCommand}"
                                        IsEnabled="{Binding CanAnalyze}"
                                        Height="32" Padding="14,0" FontSize="11"
                                        Theme="{StaticResource AccentButtonStyle}"
                                        ToolTip.Tip="Sends whatever is loaded — the scene image, the story, or both — to the llama-server with texttovideoH3.md and writes a dense multi-shot H3 prompt in which the cast is named only as &lt;Picture 1&gt; / &lt;Picture 2&gt; and framed so faces stay readable. The locked wardrobe above is handed to it as settled fact, so no clip picks its own outfit."/>
                                <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Text="{Binding AnalyzeBusyText}" Foreground="{DynamicResource TabAccentBrush}" IsVisible="{Binding IsAnalyzing}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cast: photo in, sheet out -->
                    <Border Theme="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ctrl:SectionHeader Title="CAST" Note="  · one photo per character, dressed from the wardrobe above" Margin="0,0,0,10"/>

                            <!-- Character 1 -->
                            <StackPanel DataContext="{Binding Character1}" Margin="0,0,0,10">
                                <!-- The sex is a real input, not a label: it goes into the
                                     wardrobe request, into the sheet builder's instruction
                                     and into the reference line H3 reads. -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SexOptions}"
                                              SelectedItem="{Binding Sex, Mode=TwoWay}"
                                              Width="86" Height="24" FontSize="10"
                                              ToolTip.Tip="Male or female. The wardrobe pass dresses this character accordingly, the character sheet is generated as that person, and the prompt names them so H3 uses the right pronouns."/>
                                </Grid>
                                <TextBlock Text="&lt;Picture 1&gt; · the first reference H3 receives"
                                           FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="98"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Source photo -->
                                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Height="92">
                                        <Grid>
                                            <TextBlock Text="Photo"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10" IsVisible="{Binding SourcePreview, Converter={StaticResource IsNullConverter}}"/>
                                            <Image Source="{Binding SourcePreview, Converter={StaticResource PathToBitmapConverter}}" Stretch="Uniform"/>
                                        </Grid>
                                    </Border>

                                    <!-- Built sheet -->
                                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Height="92">
                                        <Grid>
                                            <TextBlock Text="Sheet → H3"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10" IsVisible="{Binding SheetPreview, Converter={StaticResource IsNullConverter}}"/>
                                            <Image Source="{Binding SheetPreview, Converter={StaticResource PathToBitmapConverter}}" Stretch="Uniform"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Button Content="Browse…"
                                        Command="{Binding DataContext.SelectCharacter1Command, ElementName=H3CastRoot}"
                                        Height="26" Padding="8,0" FontSize="11" Margin="0,6,0,0"
                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                <CheckBox Content="This image is already a character sheet"
                                          IsChecked="{Binding UseSourceAsSheet}"
                                          IsEnabled="{Binding HasSource}"
                                          FontSize="10" Margin="0,6,0,0"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          ToolTip.Tip="Skip the Qwen pass and send the loaded image to H3 as it is."/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Panels" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding PanelSplitOptions}"
                                              DisplayMemberBinding="{Binding Label}" SelectedValueBinding="{Binding Value}"
                                              SelectedValue="{Binding SelectedPanelSplit, Mode=TwoWay}"
                                              IsEnabled="{Binding HasSheet}" Height="24" FontSize="10"
                                              ToolTip.Tip="H3 conditions on each reference image as ONE subject, so a three-panel sheet handed over whole is a three-panel grid it will happily render into the video — the same person standing next to themselves against a studio wall.&#x0a;&#x0a;The sheet is therefore cut back into its separate views before it is sent, one reference per view. Auto looks for the background gaps between the figures; a number splits evenly; Whole sheet is the old single-collage behaviour, kept for comparison."/>
                                </Grid>
                                <TextBlock Text="{Binding SheetStatus}" FontSize="9" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PanelStatus}" FontSize="9" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                           TextWrapping="Wrap"/>
                                <!-- The outfit this character's sheet is (or will be) built in. -->
                                <TextBlock Text="{Binding ExpectedWardrobe, StringFormat=👗 {0}}"
                                           IsVisible="{Binding ExpectedWardrobe, Converter={StaticResource StringToVisibilityConverter}}"
                                           FontSize="9" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Character 2 -->
                            <StackPanel DataContext="{Binding Character2}" Margin="0,0,0,8">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SexOptions}"
                                              SelectedItem="{Binding Sex, Mode=TwoWay}"
                                              Width="86" Height="24" FontSize="10"
                                              ToolTip.Tip="Male or female. The wardrobe pass dresses this character accordingly, the character sheet is generated as that person, and the prompt names them so H3 uses the right pronouns."/>
                                </Grid>
                                <TextBlock Text="&lt;Picture 2&gt; · optional — leave empty for a one-character video"
                                           FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="98"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Height="92">
                                        <Grid>
                                            <TextBlock Text="Photo"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10" IsVisible="{Binding SourcePreview, Converter={StaticResource IsNullConverter}}"/>
                                            <Image Source="{Binding SourcePreview, Converter={StaticResource PathToBitmapConverter}}" Stretch="Uniform"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Height="92">
                                        <Grid>
                                            <TextBlock Text="Sheet → H3"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10" IsVisible="{Binding SheetPreview, Converter={StaticResource IsNullConverter}}"/>
                                            <Image Source="{Binding SheetPreview, Converter={StaticResource PathToBitmapConverter}}" Stretch="Uniform"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Browse…"
                                            Command="{Binding DataContext.SelectCharacter2Command, ElementName=H3CastRoot}"
                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"
                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                    <Button Grid.Column="1" Content="✕"
                                            Command="{Binding DataContext.ClearCharacter2Command, ElementName=H3CastRoot}"
                                            IsEnabled="{Binding HasSource}"
                                            Height="26" Width="26" FontSize="11"
                                            ToolTip.Tip="Clear the second character and run as a single-reference scene."
                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                </Grid>
                                <CheckBox Content="This image is already a character sheet"
                                          IsChecked="{Binding UseSourceAsSheet}"
                                          IsEnabled="{Binding HasSource}"
                                          FontSize="10" Margin="0,6,0,0"
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Panels" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding PanelSplitOptions}"
                                              DisplayMemberBinding="{Binding Label}" SelectedValueBinding="{Binding Value}"
                                              SelectedValue="{Binding SelectedPanelSplit, Mode=TwoWay}"
                                              IsEnabled="{Binding HasSheet}" Height="24" FontSize="10"
                                              ToolTip.Tip="How this character's sheet is cut into separate reference images before it is sent to H3. Auto finds the gaps between the figures."/>
                                </Grid>
                                <TextBlock Text="{Binding SheetStatus}" FontSize="9" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PanelStatus}" FontSize="9" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                           TextWrapping="Wrap"/>
                                <!-- The outfit this character's sheet is (or will be) built in. -->
                                <TextBlock Text="{Binding ExpectedWardrobe, StringFormat=👗 {0}}"
                                           IsVisible="{Binding ExpectedWardrobe, Converter={StaticResource StringToVisibilityConverter}}"
                                           FontSize="9" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Content="{Binding BuildSheetsButtonText}"
                                    Command="{Binding BuildSheetsCommand}"
                                    IsEnabled="{Binding CanBuildSheets}"
                                    Height="32" FontSize="11" Margin="0,0,0,6"
                                    Theme="{StaticResource AccentButtonStyle}"
                                    ToolTip.Tip="Runs Qwen-Image-Edit-2511 (int8 convrot, 8-step Lightning) once per character and turns each photo into a three-panel reference sheet on a plain studio background: full-body front, full-body back, face close-up. That sheet — not the photo — is what MiniMax H3 receives, which is how one image can carry silhouette, hair from behind and facial identity at once.&#x0a;&#x0a;The sheet is generated with the character wearing the locked wardrobe, so the reference photographs and every clip's prompt describe the same clothes. Change the wardrobe and the sheets must be rebuilt — the cast card says so when they no longer match.&#x0a;&#x0a;Safe to press while a video is rendering: it waits for the GPU and runs as soon as that job lets go, so the next pair of characters can be prepared without stopping the queue."/>

                            <!-- The builder's own status line: a render underneath owns
                                 the tab's status bar and progress bar. -->
                            <TextBlock Text="{Binding SheetPhase}"
                                       IsVisible="{Binding IsBuildingSheets}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TabAccentBrush}"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding CastSummary}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                       TextWrapping="Wrap"/>

                            <!-- Which <Picture n> maps to whom once the sheets are split. -->
                            <TextBlock Text="{Binding PanelPlanSummary}"
                                       FontSize="10" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Prompt -->
                    <Border Theme="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ctrl:SectionHeader Title="H3 PROMPT" Note="  · draft idea, or the full prompt"/>
                            <TextBox Text="{Binding Prompt}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Height="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                     FontSize="11" Padding="8"/>

                            <!-- What Add to Queue will actually enqueue: the chain is
                                 split on its headers, so hand-edits here are honoured. -->
                            <TextBlock Text="{Binding PromptClipSummary}"
                                       IsVisible="{Binding HasPromptSequence}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TabAccentBrush}" TextWrapping="Wrap"/>

                            <TextBlock Text="The sheet reference line is rewritten automatically to match how many characters are loaded, which sex each of them is, and whether their sheets were built in the locked wardrobe — when they were, it tells H3 to copy the clothing out of the references rather than ignore it. The studio background is discarded either way."
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Settings -->
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14">
                        <StackPanel>
                            <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>

                            <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                      SelectedItem="{Binding SelectedAspectRatio}"
                                      Height="30" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                            <TextBlock Text="Quality (canvas size)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Value}"
                                      SelectedValue="{Binding Megapixels}"
                                      Height="30" FontSize="11" Margin="0,0,0,8"/>

                            <CheckBox Content="Latent upscale (draft → 2× finish)" IsChecked="{Binding UseLatentUpscale}"
                                      FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      ToolTip.Tip="Renders the base pass in three moves instead of one: four sampler steps at half the width and half the height to settle the composition, a 2× pass through the MiniMax H3 3D latent upscaler, then three fixed-sigma steps at the finished size to put the detail on. Only those last three ever see the full canvas.&#x0a;&#x0a;Your cast&apos;s panels are NOT affected: they are still encoded at the finished canvas, exactly as with this off. (The 🌀 MiniMax I2V tab does shrink them — this tab deliberately does not, because holding a face is the whole point here.)&#x0a;&#x0a;With this on the tab no longer uses its own 6-step shifted schedule; the draft takes four steps of an unshifted ramp and the finish takes three fixed sigmas, which is the recipe validated on MiniMax I2V. The face-refine pass is untouched either way.&#x0a;&#x0a;Needs the MinimaxH3LatentUpscaler3D node pack on the server. Unchecked, the base pass falls back to its own 6-step sampling at the full size and the whole block is pruned out of the graph."/>

                            <CheckBox Content="SLA block-sparse attention" IsChecked="{Binding UseSla}"
                                      FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      ToolTip.Tip="Block-sparse attention for MiniMax H3: each query block is scored against every key block with one pooled matmul, and only the top slice is actually attended. Nothing is loaded and nothing is trained — the sparsity is decided at runtime from q and k. Measured 1.4–1.6× on this pipeline.&#x0a;&#x0a;It patches both H3 passes: the base render, and the face refine downstream of the audio lock. Attention cost grows with the square of frames × canvas area, so long or large clips gain most; anything under the kernel&apos;s minimum sequence length falls back to dense on its own, which is why a short clip at 0.4 MP may show no change at all.&#x0a;&#x0a;Needs the H3-SLA-Attention node pack on the server. Unchecked, the patches are unwired and pruned out of the graph entirely — which is what lets a server without the pack still render the job."/>
                            <ComboBox ItemsSource="{Binding SlaSparsityOptions}"
                                      DisplayMemberBinding="{Binding Label}" SelectedValueBinding="{Binding Value}"
                                      SelectedValue="{Binding SlaSparsity}"
                                      IsEnabled="{Binding UseSla}"
                                      Height="28" FontSize="11" Margin="18,0,0,6"
                                      ToolTip.Tip="Fraction of key blocks skipped. Break-even is around 0.60 — below that the kernel is SLOWER than dense attention, so a low value is a loss, not a safe fallback.&#x0a;&#x0a;0.85 is lightx2v&apos;s shipped value and what the turbo LoRA was distilled against. 0.90 is roughly 13% quicker, and measured hotter and flatter in the speech band — which matters here because every clip this tab renders carries a soundtrack."/>
                            <CheckBox Content="Sol-Attn (legacy sparse attention)" IsChecked="{Binding UseSparseAttention}"
                                      FontSize="11" Margin="0,0,0,10"
                                      ToolTip.Tip="Sol-Attn — the same author&apos;s earlier, general-purpose sparse attention, which this workflow shipped with wired in and always on.&#x0a;&#x0a;Off by default now: SLA supersedes it for H3 and stacking the two has not measured faster than SLA alone, so leaving both on is two approximations bought for one speedup. Unchecked, node 53 is unwired and pruned. Turn it on only to compare against SLA, or if the SLA pack is missing from the server."/>

                            <CheckBox Content="RTX ×2 super-resolution" IsChecked="{Binding RtxUpscale}"
                                      FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      ToolTip.Tip="Doubles the frames on the way to the file — no second diffusion model, so it costs seconds rather than a second render. It is also the graph's largest single allocation: the whole doubled clip is held in one piece at the very end of the run, which is what takes ComfyUI down on a long job.&#x0a;&#x0a;Off by default for that reason. The video is then muxed at the H3 canvas and can be upscaled afterwards in ✨ Enhance Video, where nothing else is holding memory. Worth turning on for a short clip; watch the frame-stack line below."/>
                            <TextBlock Text="{Binding UpscaleSummary}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <!-- Turns red once the frame stack reaches the size that kills the server. -->
                            <TextBlock Text="{Binding LoadSummary}"
                                       FontSize="10" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,0,10" Classes.on="{Binding HasLoadWarning}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    </Style>
                                    <Style Selector="TextBlock.on">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>

                            <CheckBox Content="Face refine pass" IsChecked="{Binding FaceRefine}"
                                      FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      ToolTip.Tip="A second MiniMax H3 pass that tracks and crops every face, re-generates the crops against the same conditioning and stitches them back into the frames. Needs the H3-FaceRefine and NativeAudioLock node packs on the server; unchecked, that whole branch is pruned out of the graph."/>
                            <Slider Value="{Binding RefineDenoise}"
                                    Minimum="0.15" Maximum="0.75"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding FaceRefine}"
                                    Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,2"
                                    ToolTip.Tip="Refine denoise. Low cleans the face up and keeps the performance H3 rendered; high re-draws it from the sheet and starts fighting the lip-sync."/>
                            <TextBlock Text="{Binding RefineSummary}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="Refine blend (how much of the refined face is kept)"
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Slider Value="{Binding RefineBlend}"
                                    Minimum="0.2" Maximum="1.0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding FaceRefine}"
                                    Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,2"
                                    ToolTip.Tip="How much of the refined face is actually composited back over the original.&#x0a;&#x0a;This is the control that matters when faces come back slightly off even at the lowest denoise. The refine pass crops each face, resizes it to the refine canvas, VAE-encodes it, samples, VAE-decodes and resizes it back. Everything except the sampling happens at ANY denoise — a VAE round trip and a resample both change pixels — so turning the denoise down removes the model&apos;s contribution but leaves that residue behind. That residue is the floor, and the denoise slider cannot reach below it.&#x0a;&#x0a;Blend scales it: at 0.60 you get six parts refined face to four parts the pixels H3 originally rendered, so the round-trip error comes down with it. 1.00 is what the workflow shipped. Try 0.5–0.7 if the refine is helping the shape but hurting the texture."/>
                            <CheckBox Content="Never downscale the face crop (close-ups)" IsChecked="{Binding RefineNoDownscale}"
                                      FontSize="11" Margin="0,0,0,2"
                                      IsEnabled="{Binding FaceRefine}"
                                      ToolTip.Tip="Sizes the face-refine canvas from the largest crop in the clip instead of clamping it to 768px.&#x0a;&#x0a;It only does anything on close-ups. Below 768 the two settings are identical — nothing is being downscaled, so there is nothing to recover. Above it they diverge: a 2.5× crop of a 350px face is 875px, and with the cap on that gets shrunk to 768 before H3 ever sees it. That lost detail cannot come back at the stitch, whatever the denoise or the blend is set to. This is the other half of the round-trip loss — the resample half.&#x0a;&#x0a;Uncapped, and the cost is quadratic: a 1200px canvas is 2.4× the latent tokens and 2.4× the crop stack of a 768px one, and the canvas follows whatever the biggest face in the clip happens to be. The node&apos;s own warning is that it can get expensive on clips with close-ups, so it is off by default — and with it on, the frame-stack figures below are a floor rather than a ceiling."/>
                            <CheckBox Content="Composite through a SAM face mask" IsChecked="{Binding UseSamFaceMask}"
                                      FontSize="11" Margin="0,0,0,2"
                                      IsEnabled="{Binding FaceRefine}"
                                      ToolTip.Tip="Composites the refined face through a mask that follows the actual face, instead of through the detected face box.&#x0a;&#x0a;This is the fix for visible moving layers on a face. Without it the stitch pastes an arbitrary rectangle back into the frame — re-detected every frame, so it moves and resizes on its own, while the pixels inside it came from a different pass and differ subtly from everything outside. A subtly-different rectangle that shifts every frame reads as a layer sliding over the face. Neither the denoise nor the blend can reach it: one does not affect compositing at all, the other only lowers the layer&apos;s contrast without removing its edge.&#x0a;&#x0a;With a SAM mask supplied, the blend falls on the jaw and hairline, the mask is smoothed over time to damp what movement is left, and the feather drops from 24px to 6px because a mask that already follows the face is harmed by a wide blend.&#x0a;&#x0a;Costs a SAM pass over the crops. Needs a SAM model on the server; unchecked, the mask nodes are pruned and the face box comes back."/>

                            <TextBlock Text="Clip length (seconds · 4–15)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Slider Value="{Binding LengthSeconds}"
                                    Minimum="4" Maximum="15"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,2"
                                    ToolTip.Tip="How long a single H3 pass is — the model's own limit. The Video length slider divides by this to decide how many clips the story is split into, and it is also what decides the peak frame stack below."/>
                            <TextBlock Text="{Binding LengthSummary}"
                                       FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding ClipPlanSummary}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding Seed}"
                                         Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                         FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="🎲"
                                        Command="{Binding RandomSeedCommand}"
                                        Height="30" Width="36" FontSize="14"
                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="240"/>  <!-- Sheet strip -->
                <RowDefinition Height="3"/>    <!-- Progress bar -->
                <RowDefinition Height="Auto"/> <!-- Status row -->
                <RowDefinition Height="Auto"/> <!-- Action buttons -->
                <RowDefinition Height="Auto"/> <!-- Queue -->
                <RowDefinition Height="Auto"/> <!-- Result output -->
                <RowDefinition Height="Auto"/> <!-- Log -->
            </Grid.RowDefinitions>

            <!-- ─── Sheet strip: what H3 will actually see ───────────────── -->
            <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasCharacter1, Converter={StaticResource InverseBoolConverter}}">
                        <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="🪪" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MiniMax H3 · Character Sheets" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Photo per character → Build Sheets → scene image and/or story → Analyze → Generate"
                                   FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid IsVisible="{Binding HasCharacter1}"
                          Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Stretch="Uniform"
                               Source="{Binding Character1.SheetPreview, Converter={StaticResource PathToBitmapConverter}}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sheet 1 · &lt;Picture 1&gt;"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>

                        <Image Grid.Row="0" Grid.Column="1" Margin="6,0" Stretch="Uniform"
                               Source="{Binding Character2.SheetPreview, Converter={StaticResource PathToBitmapConverter}}"
                               IsVisible="{Binding HasCharacter2}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Sheet 2 · &lt;Picture 2&gt;"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   FontSize="10" Foreground="{StaticResource PlayerTextBrush}"
                                   IsVisible="{Binding HasCharacter2}"/>

                        <Image Grid.Row="0" Grid.Column="2" Margin="6,0,0,0" Stretch="Uniform"
                               Source="{Binding SceneImagePreview, Converter={StaticResource PathToBitmapConverter}}"
                               IsVisible="{Binding HasSceneImage}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Scene · prompt only"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   FontSize="10" Foreground="{StaticResource PlayerTextBrush}"
                                   IsVisible="{Binding HasSceneImage}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ─── Progress bar ──────────────────────────────────────── -->
            <ProgressBar Grid.Row="1"
                         Value="{Binding ProcessingProgress, Mode=OneWay}"
                         Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                         IsVisible="{Binding IsProcessing}"/>

            <!-- ─── Status row ────────────────────────────────────────── -->
            <Border Grid.Row="2" Theme="{StaticResource ToolStripStyle}"
                    BorderThickness="0,1,0,0" Padding="12,5">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0" Classes.on="{Binding IsProcessing}">
                            <Ellipse.Styles>
                                <Style Selector="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                </Style>
                                <Style Selector="Ellipse.on">
                                    <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                </Style>
                            </Ellipse.Styles>
                        </Ellipse>
                        <TextBlock Text="{Binding ProcessingStatus}"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding ProgressPercentage, Mode=OneWay}"
                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                               FontFamily="Consolas"
                               IsVisible="{Binding IsProcessing}"/>
                </Grid>
            </Border>

            <!-- ─── Action Buttons ────────────────────────────────────── -->
            <Border Grid.Row="3" Theme="{StaticResource ToolStripStyle}"
                    BorderThickness="0,1,0,0" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                            Command="{Binding GenerateCommand}"
                            IsEnabled="{Binding CanGenerate}"
                            Theme="{StaticResource AccentButtonStyle}"
                            FontSize="12" FontWeight="Bold" BorderThickness="0"
                            ToolTip.Tip="Snapshots the sheets, the prompt and the settings into the queue and starts rendering. The sheets are already built, so nothing here waits on the GPU — load the next scene image and Analyze it while this one runs.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                            <TextBlock Text="Add to Queue &amp; Generate" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Height="40" Width="82"
                            Command="{Binding CancelCommand}"
                            Theme="{StaticResource DangerButtonStyle}"
                            FontSize="11"
                            ToolTip.Tip="Stops whatever is on the GPU — the sheet builder or the queue. Pending items stay queued.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕ " VerticalAlignment="Center"/>
                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ─── Queue ─────────────────────────────────────────────── -->
            <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"
                    IsVisible="{Binding HasQueueItems}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🪪 Cast Queue"
                                   FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                   FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Content="▶ Start"
                                Command="{Binding StartQueueCommand}"
                                Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                Theme="{StaticResource AccentButtonStyle}"
                                ToolTip.Tip="Resume draining pending items."/>
                        <Button Grid.Column="3" Content="🔄 Retry"
                                Command="{Binding ReprocessAllFailedCommand}"
                                Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                Theme="{StaticResource AccentButtonStyle}"
                                ToolTip.Tip="Put every failed item back to Pending and run them again."/>
                        <Button Grid.Column="4" Content="⏹ Stop"
                                Command="{Binding StopQueueCommand}"
                                Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                Theme="{StaticResource AccentButtonStyle}"/>
                        <Button Grid.Column="5" Content="🗑️ Clear"
                                Command="{Binding ClearQueueCommand}"
                                Height="26" Padding="8,0" FontSize="11"
                                Theme="{StaticResource AccentButtonStyle}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Queue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                        Padding="8,5" Margin="0,0,0,3" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding StatusColor}">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                        <Image Grid.Column="1" Source="{Binding QueueThumbnail, Converter={StaticResource PathToBitmapConverter}}"
                                               Height="34" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Prompt}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="✕"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveQueueItemCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"
                                                Width="26" Height="26" Padding="0" FontSize="10"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ─── Result Output ──────────────────────────────────────── -->
            <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                            Height="200" CornerRadius="6" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock Text="Video will appear here after generation"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic" IsVisible="{Binding HasResult, Converter={StaticResource InverseBoolConverter}}"/>
                            <controls:VideoPreview x:Name="H3CastVideoPlayer" Source="{Binding ResultVideoPath}" IsVisible="{Binding HasResult}"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="▶ Play" Theme="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding PlayVideoCommand}"
                                IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                        <Button Content="📁 Open Folder" Theme="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenResultFolderCommand}"
                                IsEnabled="{Binding HasResult}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ResultVideoInfo}"
                               FontStyle="Italic" Foreground="#666" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- ─── Log ───────────────────────────────────────────────── -->
            <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

        </Grid>
        </ScrollViewer>
    </Grid>

</UserControl>
