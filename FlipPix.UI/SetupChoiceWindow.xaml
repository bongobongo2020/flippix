<Window x:Class="FlipPix.UI.SetupChoiceWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlipPix Setup"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Welcome to FlipPix!"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <!-- Question -->
        <TextBlock Grid.Row="1"
                   Text="Where is your ComfyUI installed?"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Choice Buttons -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Local Option -->
            <Button Name="LocalButton"
                    Content="Local Installation"
                    FontSize="16"
                    Padding="40,20"
                    Margin="0,0,0,20"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Cursor="Hand"
                    Click="LocalButton_Click">
                <Button.LayoutTransform>
                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                </Button.LayoutTransform>
            </Button>

            <!-- Remote Option -->
            <Button Name="RemoteButton"
                    Content="Remote Server"
                    FontSize="16"
                    Padding="40,20"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Cursor="Hand"
                    Click="RemoteButton_Click">
                <Button.LayoutTransform>
                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                </Button.LayoutTransform>
            </Button>
        </StackPanel>

        <!-- Info Text -->
        <TextBlock Grid.Row="3"
                   Text="Choose Local if ComfyUI is on this computer, or Remote if it's on another machine."
                   FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>