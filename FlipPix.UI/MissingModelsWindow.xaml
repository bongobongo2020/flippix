<Window x:Class="FlipPix.UI.MissingModelsWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Missing Models"
        Height="540"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="420"
        MinWidth="560"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Some models aren't installed"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="#CCCCCC"
                   Margin="0,0,0,12"
                   Text="The connected ComfyUI is missing the model file(s) below. Download the known ones automatically, or point FlipPix at a folder that already contains them — that folder is remembered so you're only asked once."/>

        <Border Grid.Row="2"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                Padding="2">
            <ListView Name="ModelsList"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="White"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Model" Width="300"
                                        DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="Folder" Width="140"
                                        DisplayMemberBinding="{Binding Category}"/>
                        <GridViewColumn Header="Status" Width="230"
                                        DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <ProgressBar Grid.Row="3"
                     Name="Progress"
                     Height="6"
                     Margin="0,12,0,6"
                     Minimum="0"
                     Maximum="100"
                     Foreground="#0E639C"
                     Background="#2D2D30"
                     BorderThickness="0"
                     Visibility="Collapsed"/>

        <TextBlock Grid.Row="4"
                   Name="StatusText"
                   FontSize="12"
                   Foreground="#AAAAAA"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Name="DownloadButton"
                    Content="Download missing"
                    Click="DownloadButton_Click"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Background="#0E639C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button Name="LocateButton"
                    Content="Locate folder..."
                    Click="LocateButton_Click"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Background="#0E639C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button Name="DoneButton"
                    Content="Done"
                    Click="DoneButton_Click"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Background="#3F8E3F"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsEnabled="False"/>
            <Button Name="CancelButton"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Padding="20,10"
                    Background="#3F3F46"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
