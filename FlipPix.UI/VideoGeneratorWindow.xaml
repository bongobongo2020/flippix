<Window x:Class="FlipPix.UI.VideoGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlipPix - Video Generator" Height="750" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="650" MinWidth="850"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF6B35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8556"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66BB6A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6B35" Offset="0"/>
                    <GradientStop Color="#F7931E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="25,20">
                <TextBlock Text="🎬 Video Generator"
                          FontSize="28" FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Generate videos from images using AI - Upload an image and describe the motion"
                          FontSize="13" Foreground="#FFFAF0"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="#E9ECEF" BorderBrush="#DEE2E6" BorderThickness="0,1,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Navigate:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#495057"/>
                <Button Content="Image Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToImageGeneratorCommand}"/>
                <Button Content="Camera Edit" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToCameraEditCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,15,20,15">
                <TabControl>

                    <!-- Tab 1: Single Video Generator -->
                    <TabItem Header="🎬 Single Video Generator">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- Image Input Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📤 Input Image" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Image Preview -->
                            <Border Grid.Column="0"
                                    BorderBrush="#DEE2E6" BorderThickness="2"
                                    Background="White" Height="300"
                                    CornerRadius="5" Margin="0,0,15,0">
                                <Grid>
                                    <TextBlock Text="No image selected"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="#999"
                                              FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImagePreviewSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Source="{Binding ImagePreviewSource}"
                                           Stretch="Uniform"/>
                                </Grid>
                            </Border>

                            <!-- File Selection -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Select Image File" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                            Text="{Binding ImageFilePath, Mode=TwoWay}"
                                            IsReadOnly="True"
                                            Padding="10"
                                            Background="White"
                                            BorderBrush="#CED4DA"
                                            FontSize="12"
                                            VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                           Content="Browse..."
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           Margin="8,0,0,0"
                                           Command="{Binding SelectImageCommand}"/>
                                </Grid>

                                <TextBlock Text="{Binding ImageInfo}"
                                          FontStyle="Italic"
                                          Foreground="#666"
                                          FontSize="11"
                                          Margin="0,0,0,15"/>

                                <TextBlock Text="Supported formats: JPG, PNG, BMP"
                                          FontSize="11"
                                          Foreground="#999"
                                          FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Workflow Selection Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="⚙️ Workflow Selection" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Workflow Indicator -->
                            <Border Grid.Column="0"
                                    Background="#E9ECEF"
                                    BorderBrush="#DEE2E6"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="12,8"
                                    Margin="0,0,15,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding WorkflowIndicator}"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <TextBlock Text="Current"
                                              FontSize="11"
                                              Foreground="#6C757D"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Workflow Toggle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Select Workflow"
                                          FontWeight="SemiBold"
                                          FontSize="12"
                                          Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LTXV Workflow Toggle -->
                                    <Border Grid.Column="0"
                                            CornerRadius="5"
                                            Padding="10,8"
                                            Background="White"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="2"
                                            Margin="0,0,8,0"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseLTXWorkflow}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#28A745"/>
                                                        <Setter Property="Background" Value="#D4EDDA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding ToggleWorkflowCommand}" MouseAction="LeftClick"/>
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <TextBlock Text="🟢 LTXV"
                                                      FontSize="13"
                                                      FontWeight="Bold"
                                                      Foreground="#212529"/>
                                            <TextBlock Text="LTX-2_image2video_distilledAPI.json"
                                                      FontSize="10"
                                                      Foreground="#6C757D"
                                                      Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Painter Workflow Toggle -->
                                    <Border Grid.Column="1"
                                            CornerRadius="5"
                                            Padding="10,8"
                                            Background="White"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="2"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseLTXWorkflow}" Value="False">
                                                        <Setter Property="BorderBrush" Value="#007BFF"/>
                                                        <Setter Property="Background" Value="#CCE5FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding ToggleWorkflowCommand}" MouseAction="LeftClick"/>
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <TextBlock Text="🔵 Painter"
                                                      FontSize="13"
                                                      FontWeight="Bold"
                                                      Foreground="#212529"/>
                                            <TextBlock Text="painteri2vAPI.json"
                                                      FontSize="10"
                                                      Foreground="#6C757D"
                                                      Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Workflow Description -->
                        <TextBlock Text="{Binding WorkflowDisplay}"
                                  FontStyle="Italic"
                                  Foreground="#6C757D"
                                  FontSize="11"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Image Analysis Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="🔍 Image Analysis" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35" HorizontalAlignment="Left"/>
                            <!-- Settings button for LM Studio configuration -->
                            <Button Content="⚙️"
                                   Style="{StaticResource NavButtonStyle}"
                                   Command="{Binding OpenLMStudioSettingsCommand}"
                                   ToolTip="LM Studio Settings"
                                   HorizontalAlignment="Right"
                                   Width="40"
                                   Height="30"
                                   Padding="0"
                                   Margin="0,0,5,0"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                   Content="🧠 Analyze with Qwen-VL"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding AnalyzeImageCommand}"
                                   IsEnabled="{Binding HasImage}"
                                   Height="40"
                                   Margin="0,0,10,0"
                                   HorizontalAlignment="Stretch"/>

                            <Button Grid.Column="1"
                                   Content="📤 Send to Queue"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding SendAnalysisToQueueCommand}"
                                   IsEnabled="{Binding HasAnalysis}"
                                   Height="40"
                                   Width="120"/>
                        </Grid>

                        <TextBox Text="{Binding ImageAnalysis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="120"
                                Padding="12"
                                VerticalScrollBarVisibility="Auto"
                                Background="White"
                                BorderBrush="#CED4DA"
                                FontSize="12"
                                Margin="0,10,0,10"
                                IsReadOnly="{Binding IsAnalyzing}"/>

                        <!-- Processing Status for Analysis -->
                        <Border Background="#FFF9F0"
                                BorderBrush="#FFE0B0"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12"
                                Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding AnalysisStatus}"
                                          FontWeight="SemiBold"
                                          FontSize="11"
                                          Margin="0,0,0,5"
                                          TextAlignment="Center"/>
                                <ProgressBar Value="{Binding AnalysisProgress}"
                                            Height="16"
                                            Foreground="#FF6B35"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

  
                <!-- Prompt Queue Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="📝 Prompt Queue" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding NewQueuePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"
                                     Background="White"
                                     BorderBrush="#CED4DA"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                   Content="➕ Add to Queue"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding AddToQueueCommand}"
                                   Height="35"
                                   Width="120"
                                   Margin="0,0,5,0"/>

                            <Button Grid.Column="2"
                                   Content="▶️ Process Queue"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Command="{Binding ProcessQueueCommand}"
                                   IsEnabled="{Binding CanProcessQueue}"
                                   Height="35"
                                   Width="120"
                                   Margin="0,0,5,0"/>

                            <Button Grid.Column="3"
                                   Content="🔄 Reprocess Failed"
                                   Command="{Binding ReprocessAllFailedCommand}"
                                   IsEnabled="{Binding HasFailedItems}"
                                   Height="35"
                                   Width="140">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Background" Value="#FFA500"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF8C00"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCC"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <TextBlock Text="Queue Items:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>

                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                                <ItemsControl ItemsSource="{Binding PromptQueue}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                             Text="{Binding DisplayText}"
                                                             TextWrapping="Wrap"
                                                             FontSize="11"
                                                             VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                             Text="{Binding StatusDisplay}"
                                                             FontSize="10"
                                                             FontWeight="SemiBold"
                                                             Foreground="{Binding StatusColor}"
                                                             VerticalAlignment="Center"
                                                             Margin="10,0,10,0"/>

                                                    <!-- Reprocess button - only visible for failed items -->
                                                    <Button Grid.Column="2"
                                                           Content="🔄"
                                                           Command="{Binding DataContext.ReprocessItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Padding="5,2"
                                                           FontSize="11"
                                                           ToolTip="Reprocess this item"
                                                           Margin="0,0,5,0"
                                                           Width="30">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                                                <Setter Property="Background" Value="#FFA500"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#FF8C00"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button Grid.Column="3"
                                                           Content="❌"
                                                           Style="{StaticResource NavButtonStyle}"
                                                           Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Padding="5,2"
                                                           FontSize="10"
                                                           ToolTip="Remove from queue"
                                                           Width="30"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="{Binding QueueStatus}"
                                  FontSize="11"
                                  Foreground="#666"
                                  FontStyle="Italic"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Video Settings and Generate -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Settings -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="⚙️ Video Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Video Length -->
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Video Length (frames)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding VideoLength, Mode=TwoWay}"
                                                Minimum="21" Maximum="240"
                                                TickFrequency="20"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding VideoLength}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="35"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Text="{Binding VideoLengthSeconds}"
                                              FontSize="10"
                                              Foreground="#999"
                                              Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- FPS -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FPS (Frames Per Second)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Fps, Mode=TwoWay}"
                                                Minimum="8" Maximum="30"
                                                TickFrequency="2"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Fps}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Generate Button and Status -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="🎬 Generate Video"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Command="{Binding GenerateVideoCommand}"
                                   HorizontalAlignment="Stretch"
                                   Height="55"
                                   FontSize="15"
                                   Margin="0,0,0,15"/>

                            <!-- Processing Status -->
                            <Border Background="#FFF9F0"
                                    BorderBrush="#FFE0B0"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="12"
                                    Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProcessingStatus}"
                                              FontWeight="SemiBold"
                                              FontSize="11"
                                              Margin="0,0,0,5"
                                              TextAlignment="Center"
                                              TextWrapping="Wrap"/>
                                    <ProgressBar Value="{Binding ProcessingProgress}"
                                                Height="16"
                                                Foreground="#FF6B35"
                                                Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding ProgressPercentage}"
                                              HorizontalAlignment="Center"
                                              FontSize="11"
                                              FontWeight="Bold"
                                              Foreground="#FF6B35"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Result Video Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                        <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                Background="White" Height="250"
                                CornerRadius="5" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="Video will appear here after generation"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="#999"
                                          FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasResultVideo}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Video Player -->
                                <MediaElement x:Name="VideoPlayer"
                                            Source="{Binding ResultVideoPath}"
                                            LoadedBehavior="Manual"
                                            UnloadedBehavior="Stop"
                                            Stretch="Uniform"
                                            Visibility="{Binding HasResultVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                   Content="▶️ Play"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding PlayVideoCommand}"
                                   IsEnabled="{Binding HasResultVideo}"
                                   Margin="0,0,8,0"/>

                            <Button Grid.Column="1"
                                   Content="📂 Open Folder"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding OpenResultFolderCommand}"
                                   IsEnabled="{Binding HasResultVideo}"
                                   Margin="0,0,8,0"/>

                            <Button Grid.Column="2"
                                   Content="📷 Send to Edit Camera"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding SendToEditCameraCommand}"
                                   IsEnabled="{Binding HasResultVideo}"/>
                        </Grid>

                        <TextBlock Text="{Binding VideoInfo}"
                                  FontStyle="Italic"
                                  Foreground="#666"
                                  FontSize="11"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Advanced Settings (Collapsible) -->
                <Expander Header="⚙️ Advanced Settings"
                         Margin="0,0,0,15"
                         IsExpanded="False">
                    <Border Background="#F8F9FA"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Steps -->
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Steps, Mode=TwoWay}"
                                                Minimum="1" Maximum="10"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Steps}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- CFG -->
                                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                    <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Cfg, Mode=TwoWay}"
                                                Minimum="1" Maximum="5"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Cfg, StringFormat={}{0:F1}}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Seed -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Seed (0 = Random)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding Seed, Mode=TwoWay}"
                                            Padding="8"
                                            Background="White"
                                            BorderBrush="#CED4DA"
                                            FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <!-- Negative Prompt -->
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="Negative Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        Height="60"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Log (Collapsible) -->
                <Expander Header="📝 Processing Log"
                         IsExpanded="True"
                         Margin="0,0,0,0">
                    <Border Background="White"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="150"
                                     VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LogOutput}"
                                    TextWrapping="Wrap"
                                    IsReadOnly="True"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10"/>
                        </ScrollViewer>
                    </Border>
                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Story Video Generator -->
                    <TabItem Header="📖 Story Video Generator">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Story Setup Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📁 Story Setup" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Prompt JSON File Selection -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="1. Select the prompts JSON file (from Story Image Generator)"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📄 Select JSON File"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SelectStoryPromptJsonCommand}"
                                                   Height="35"
                                                   Width="150"/>
                                        </Grid>

                                        <TextBox Text="{Binding StoryPromptJsonPath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="11"
                                                Margin="0,0,0,15"
                                                VerticalAlignment="Center"/>

                                        <!-- Images Folder Selection -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="2. Select the folder containing the 10 generated story images"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Select Images Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SelectStoryImagesFolderCommand}"
                                                   Height="35"
                                                   Width="170"/>
                                        </Grid>

                                        <TextBox Text="{Binding StoryImagesFolderPath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="11"
                                                Margin="0,0,0,10"
                                                VerticalAlignment="Center"/>

                                        <!-- Load Queue Button -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="3. Load the queue with images and prompts"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📥 Load Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding LoadStoryQueueCommand}"
                                                   IsEnabled="{Binding CanLoadStoryQueue}"
                                                   Height="35"
                                                   Width="140"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Story Queue Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎞️ Story Video Queue" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Queue Controls -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="{Binding StoryQueueStatus}"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Foreground="#666"/>

                                            <Button Grid.Column="1"
                                                   Content="▶️ Process Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding ProcessStoryQueueCommand}"
                                                   IsEnabled="{Binding CanProcessStoryQueue}"
                                                   Height="35"
                                                   Width="140"
                                                   Margin="0,0,10,0"/>

                                            <Button Grid.Column="2"
                                                   Content="🗑️ Clear Queue"
                                                   Command="{Binding ClearStoryQueueCommand}"
                                                   Height="35"
                                                   Width="120">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                                        <Setter Property="Background" Value="#DC3545"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#C82333"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- Progress Display -->
                                        <Border Background="#FFF9F0"
                                                BorderBrush="#FFE0B0"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="12"
                                                Visibility="{Binding IsProcessingStoryQueue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                              Text="{Binding StoryQueueStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,5"
                                                              VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding StoryQueueProgressText}"
                                                              FontWeight="Bold"
                                                              FontSize="12"
                                                              Foreground="#FF6B35"
                                                              VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Current Item Info -->
                                                <TextBlock Text="Current:"
                                                          FontSize="10"
                                                          FontWeight="SemiBold"
                                                          Margin="0,5,0,3"/>

                                                <TextBlock Text="{Binding CurrentStoryQueueItem.Index, StringFormat='Prompt #{0}'}"
                                                          FontSize="11"
                                                          Margin="10,0,0,0"/>

                                                <ProgressBar Value="{Binding CurrentStoryQueueItem.Progress}"
                                                            Height="16"
                                                            Foreground="#FF6B35"
                                                            Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Queue Items List -->
                                        <TextBlock Text="Queue Items:"
                                                  FontWeight="SemiBold"
                                                  FontSize="12"
                                                  Margin="0,0,0,5"/>

                                        <Border BorderBrush="#DEE2E6"
                                                BorderThickness="1"
                                                Background="White"
                                                CornerRadius="5"
                                                MaxHeight="250">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                                                <ItemsControl ItemsSource="{Binding StoryVideoQueue}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#E9ECEF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Padding="10"
                                                                    Margin="0,0,0,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Index -->
                                                                    <Border Grid.Column="0"
                                                                            Background="#FF6B35"
                                                                            CornerRadius="3"
                                                                            Padding="8,4"
                                                                            Margin="0,0,10,0"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Index}"
                                                                                  Foreground="White"
                                                                                  FontWeight="Bold"
                                                                                  FontSize="12"
                                                                                  MinWidth="30"
                                                                                  TextAlignment="Center"/>
                                                                    </Border>

                                                                    <!-- Prompt Text -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Prompt}"
                                                                                  TextWrapping="Wrap"
                                                                                  FontSize="11"
                                                                                  MaxWidth="500"
                                                                                  ToolTip="{Binding Prompt}"/>
                                                                        <TextBlock Text="{Binding InputImagePath}"
                                                                                  FontSize="9"
                                                                                  Foreground="#999"
                                                                                  FontStyle="Italic"
                                                                                  Margin="0,3,0,0"/>
                                                                    </StackPanel>

                                                                    <!-- Status -->
                                                                    <TextBlock Grid.Column="2"
                                                                              Text="{Binding StatusDisplay}"
                                                                              FontSize="10"
                                                                              FontWeight="SemiBold"
                                                                              Foreground="{Binding StatusColor}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="10,0"/>

                                                                    <!-- Progress Bar (for processing items) -->
                                                                    <Grid Grid.Column="3"
                                                                          Width="100"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <ProgressBar Value="{Binding Progress}"
                                                                                    Height="10"
                                                                                    Foreground="#FFA500"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Story Log (Collapsible) -->
                                <Expander Header="📝 Processing Log"
                                         IsExpanded="True"
                                         Margin="0,0,0,0">
                                    <Border Background="White"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="1"
                                            Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding LogOutput}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: VACE Video Generator -->
                    <TabItem Header="🎭 VACE Video Generator">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- VACE Setup Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎬 VACE Video Inputs" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Background Image -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Background:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            BorderBrush="#DEE2E6" BorderThickness="1"
                                                            Background="White" Height="80"
                                                            CornerRadius="3" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="No background image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding VaceBackgroundImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding VaceBackgroundImagePreview}"
                                                                   Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectVACEBackgroundImageCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding VaceBackgroundImageInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Foreground Image -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Foreground:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            BorderBrush="#DEE2E6" BorderThickness="1"
                                                            Background="White" Height="80"
                                                            CornerRadius="3" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="No foreground image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding VaceForegroundImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding VaceForegroundImagePreview}"
                                                                   Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectVACEForegroundImageCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding VaceForegroundImageInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Video Input -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Input Video:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding VaceVideoPath, Mode=TwoWay}"
                                                            IsReadOnly="True"
                                                            Padding="10"
                                                            Background="White"
                                                            BorderBrush="#CED4DA"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"/>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectVACEVideoCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding VaceVideoInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- VACE Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📝 VACE Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <TextBlock Text="Describe how you want to transform the video:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                                        <TextBox Text="{Binding VacePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="100"
                                                Padding="12"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- VACE Generate Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Instructions -->
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="ℹ️ VACE (Video-to-Video with Control)" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                            <TextBlock Text="This workflow combines a background image, foreground reference image, and input video to create a processed video using the Wan VACE model." FontSize="11" TextWrapping="Wrap" Foreground="#666" Margin="0,5,0,10"/>
                                            <TextBlock Text="The model will use pose estimation from the input video and reference images to guide the video generation." FontSize="11" TextWrapping="Wrap" Foreground="#666"/>
                                        </StackPanel>

                                        <!-- Generate Button and Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="🎭 Generate VACE Video"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding GenerateVACEVideoCommand}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="55"
                                                   FontSize="15"
                                                   Margin="0,0,0,15"/>

                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0"
                                                    BorderBrush="#FFE0B0"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="12"
                                                    Visibility="{Binding IsProcessingVACE, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ProcessingStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,5"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap"/>
                                                    <ProgressBar Value="{Binding ProcessingProgress}"
                                                                Height="16"
                                                                Foreground="#FF6B35"
                                                                Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding ProgressPercentage}"
                                                              HorizontalAlignment="Center"
                                                              FontSize="11"
                                                              FontWeight="Bold"
                                                              Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- VACE Result Video Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                Background="White" Height="250"
                                                CornerRadius="5" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999"
                                                          FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResultVideo}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Video Player -->
                                                <MediaElement x:Name="VACEVideoPlayer"
                                                            Source="{Binding ResultVideoPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasResultVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                   Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayVideoCommand}"
                                                   IsEnabled="{Binding HasResultVideo}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenResultFolderCommand}"
                                                   IsEnabled="{Binding HasResultVideo}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="2"
                                                   Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendToEditCameraCommand}"
                                                   IsEnabled="{Binding HasResultVideo}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding VideoInfo}"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- VACE Log (Collapsible) -->
                                <Expander Header="📝 Processing Log"
                                         IsExpanded="True"
                                         Margin="0,0,0,0">
                                    <Border Background="White"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="1"
                                            Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding LogOutput}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 4: LTX2 Audio Generator -->
                    <TabItem Header="🎵 LTX2 Audio">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- LTX2 Audio Setup Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎬 LTX2 Audio Video Inputs" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Image Input -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Source Image:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            BorderBrush="#DEE2E6" BorderThickness="1"
                                                            Background="White" Height="80"
                                                            CornerRadius="3" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="No image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding LTX2AudioImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding LTX2AudioImagePreview}"
                                                                   Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectLTX2AudioImageCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding LTX2AudioImageInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Audio Input -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Audio File:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding LTX2AudioPath, Mode=TwoWay}"
                                                            IsReadOnly="True"
                                                            Padding="10"
                                                            Background="White"
                                                            BorderBrush="#CED4DA"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"/>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectLTX2AudioCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding LTX2AudioInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- LTX2 Audio Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📝 Video Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <TextBlock Text="Describe the video action you want to generate:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                                        <TextBox Text="{Binding LTX2AudioPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="100"
                                                Padding="12"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- LTX2 Audio Settings Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Video Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Width:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding LTX2AudioWidth, Mode=TwoWay}"
                                                        Padding="8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="Height:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding LTX2AudioHeight, Mode=TwoWay}"
                                                        Padding="8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="12"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="ℹ️ Video will be generated in 20-second chunks and automatically merged"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- LTX2 Audio Generate Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Instructions -->
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="ℹ️ LTX2 Audio-Synchronized Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                            <TextBlock Text="Generate videos synchronized to audio using the LTX2 model. The system automatically calculates the number of frames needed based on the audio duration and generates the video in 20-second chunks for optimal performance." FontSize="11" TextWrapping="Wrap" Foreground="#666" Margin="0,5,0,10"/>
                                            <TextBlock Text="Total Frames:" FontWeight="Bold" FontSize="11" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding LTX2AudioTotalFrames}" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                                            <TextBlock Text="Estimated Duration:" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding LTX2AudioEstimatedDuration}" FontSize="11" Foreground="#666"/>
                                        </StackPanel>

                                        <!-- Generate Button and Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="🎵 Generate Video"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding GenerateLTX2AudioVideoCommand}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="55"
                                                   FontSize="15"
                                                   Margin="0,0,0,15"/>

                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0"
                                                    BorderBrush="#FFE0B0"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="12"
                                                    Visibility="{Binding IsProcessingLTX2Audio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding LTX2AudioProcessingStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,5"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap"/>
                                                    <ProgressBar Value="{Binding LTX2AudioProcessingProgress}"
                                                                Height="16"
                                                                Foreground="#FF6B35"
                                                                Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding LTX2AudioProgressPercentage}"
                                                              HorizontalAlignment="Center"
                                                              FontSize="11"
                                                              FontWeight="Bold"
                                                              Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- LTX2 Audio Result Video Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                Background="White" Height="250"
                                                CornerRadius="5" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999"
                                                          FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLTX2AudioResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Video Player -->
                                                <MediaElement x:Name="LTX2AudioVideoPlayer"
                                                            Source="{Binding LTX2AudioResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasLTX2AudioResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                   Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayLTX2AudioVideoCommand}"
                                                   IsEnabled="{Binding HasLTX2AudioResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenLTX2AudioResultFolderCommand}"
                                                   IsEnabled="{Binding HasLTX2AudioResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="2"
                                                   Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendLTX2AudioToEditCameraCommand}"
                                                   IsEnabled="{Binding HasLTX2AudioResult}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding LTX2AudioVideoInfo}"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- LTX2 Audio Log (Collapsible) -->
                                <Expander Header="📝 Processing Log"
                                         IsExpanded="True"
                                         Margin="0,0,0,0">
                                    <Border Background="White"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="1"
                                            Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding LTX2AudioLogOutput}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 5: Mocha Video Generator -->
                    <TabItem Header="Mocha">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- Input Files Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📤 Input Files" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Video Input -->
                                            <Border Grid.Column="0" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="🎬 Input Video" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                Text="{Binding MochaVideoPath, Mode=TwoWay}"
                                                                IsReadOnly="True"
                                                                Padding="8"
                                                                Background="White"
                                                                BorderBrush="#CED4DA"
                                                                FontSize="11"
                                                                VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                               Content="Browse..."
                                                               Style="{StaticResource SecondaryButtonStyle}"
                                                               Margin="8,0,0,0"
                                                               Command="{Binding SelectMochaVideoCommand}"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding MochaSourceVideoInfo}"
                                                              FontStyle="Italic"
                                                              Foreground="#666"
                                                              FontSize="10"
                                                              TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Image Input -->
                                            <Border Grid.Column="1" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="15" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="🖼️ Reference Image" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                                                    <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                            Background="White" Height="120"
                                                            CornerRadius="5" Margin="0,0,0,10">
                                                        <Grid>
                                                            <TextBlock Text="No image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding MochaImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding MochaImagePreview}"
                                                                   Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                Text="{Binding MochaImagePath, Mode=TwoWay}"
                                                                IsReadOnly="True"
                                                                Padding="8"
                                                                Background="White"
                                                                BorderBrush="#CED4DA"
                                                                FontSize="11"
                                                                VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                               Content="Browse..."
                                                               Style="{StaticResource SecondaryButtonStyle}"
                                                               Margin="8,0,0,0"
                                                               Command="{Binding SelectMochaImageCommand}"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding MochaImageInfo}"
                                                              FontStyle="Italic"
                                                              Foreground="#666"
                                                              FontSize="10"
                                                              TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <TextBlock Margin="0,10,0,0"
                                                  FontSize="11"
                                                  Foreground="#999"
                                                  FontStyle="Italic"
                                                  TextWrapping="Wrap">
                                            <Run Text="The video will be processed in 81-frame chunks. ffmpeg is required to count frames and merge the final output."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="✍️ Prompt (Optional)" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <TextBlock Text="Describe what you want to generate with the Mocha model"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,0,0,10"/>

                                        <TextBox Text="{Binding MochaPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="80"
                                                 Padding="10"
                                                 FontSize="12"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"/>

                                        <TextBlock Margin="0,8,0,0"
                                                  FontSize="10"
                                                  Foreground="#999"
                                                  FontStyle="Italic">
                                            <Run Text="Chunks:"/>
                                            <Run Text="{Binding MochaTotalChunks, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="• 81 frames per chunk"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Generate Button -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <Button Content="🎬 Generate Mocha Video"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="50"
                                                FontSize="16"
                                                Command="{Binding GenerateMochaVideoCommand}"
                                                IsEnabled="{Binding CanGenerateMochaVideo, Mode=OneWay}"/>

                                        <ProgressBar Value="{Binding MochaProcessingProgress}"
                                                     Maximum="100"
                                                     Height="25"
                                                     Margin="0,15,0,0"
                                                     Visibility="{Binding IsProcessingMocha, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <TextBlock Text="{Binding MochaProcessingStatus}"
                                                  FontSize="12"
                                                  Margin="0,8,0,0"
                                                  Foreground="#666"
                                                  Visibility="{Binding IsProcessingMocha, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Output Section -->
                                <Border Style="{StaticResource SectionPanelStyle}"
                                        Visibility="{Binding HasMochaResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="📺 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#28A745"/>

                                        <MediaElement x:Name="MochaVideoPlayer"
                                                    Source="{Binding MochaResultPath}"
                                                    Width="640"
                                                    Height="360"
                                                    LoadedBehavior="Manual"
                                                    UnloadedBehavior="Stop"
                                                    Margin="0,10,0,0"
                                                    Stretch="Uniform"/>

                                        <Grid Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                   Content="▶ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayMochaVideoCommand}"
                                                   IsEnabled="{Binding HasMochaResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📁 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenMochaResultFolderCommand}"
                                                   IsEnabled="{Binding HasMochaResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="2"
                                                   Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendMochaToEditCameraCommand}"
                                                   IsEnabled="{Binding HasMochaResult}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding MochaResultVideoInfo}"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Mocha Log (Collapsible) -->
                                <Expander Header="📝 Processing Log"
                                         IsExpanded="True"
                                         Margin="0,0,0,0">
                                    <Border Background="White"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="1"
                                            Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding MochaLogOutput}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
