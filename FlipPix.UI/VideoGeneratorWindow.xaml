<Window x:Class="FlipPix.UI.VideoGeneratorWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:FlipPix.UI.Converters"
        mc:Ignorable="d"
        Title="FlipPix - Video Generator" Height="750" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="650" MinWidth="850"
        ResizeMode="CanResize">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6B35" Offset="0"/>
                    <GradientStop Color="#F7931E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="25,20">
                <TextBlock Text="🎬 Video Generator"
                          FontSize="28" FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Generate videos from images using AI - Upload an image and describe the motion"
                          FontSize="13" Foreground="#FFFAF0"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="#E9ECEF" BorderBrush="#DEE2E6" BorderThickness="0,1,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Navigate:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#495057"/>
                <Button Content="Image Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToImageGeneratorCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,15,20,15">
                <TabControl>

                    <!-- Tab 1: FFLF -->
                    <TabItem Header="🎬 FFLF">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- Workflow Selection for Single Video -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="🎬 Workflow Selection"
                                                  FontSize="14"
                                                  FontWeight="Bold"
                                                  Foreground="#FF6B35"
                                                  Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- LTX2V Workflow Toggle -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UseLTX2V}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#28A745"/>
                                                                <Setter Property="Background" Value="#D4EDDA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding ToggleSingleWorkflowCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="🟢 LTX2V"
                                                              FontSize="13"
                                                              FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="LTXV-DoEverything-v2.json"
                                                              FontSize="10"
                                                              Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Wan 2.2 Workflow Toggle -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UseWan22}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#007BFF"/>
                                                                <Setter Property="Background" Value="#CCE5FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding ToggleSingleWorkflowCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="🔵 Wan 2.2"
                                                              FontSize="13"
                                                              FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="LF-t2v-i2v-FFLF-Main v1.1API.json"
                                                              FontSize="10"
                                                              Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Dual Frame Input & Analysis Section -->
                                <Border Style="{StaticResource SectionPanelStyle}" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: First Frame Input -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🖼️ First Frame" FontSize="13" FontWeight="Bold" Foreground="#FF6B35" Margin="0,0,0,8"/>
                                            <!-- Image Preview -->
                                            <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                    Background="White" Height="160"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="No first frame"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="#999"
                                                              FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FirstFrameImagePreview}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding FirstFrameImagePreview}" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>

                                            <!-- Browse and Analyze Buttons -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Button Grid.Row="0"
                                                       Content="📁 Browse First Frame"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Command="{Binding SelectFirstFrameImageCommand}"
                                                       Height="32"
                                                       FontSize="11"/>

                                                <Button Grid.Row="1"
                                                       Content="🧠 Analyze First Frame"
                                                       Style="{StaticResource PrimaryButtonStyle}"
                                                       Command="{Binding AnalyzeFirstFrameImageCommand}"
                                                       IsEnabled="{Binding HasFirstFrameImage}"
                                                       Height="36"
                                                       Margin="0,5,0,0"
                                                       FontSize="11"/>
                                            </Grid>

                                            <!-- Image Info -->
                                            <TextBlock Text="{Binding FirstFrameImageInfo}"
                                                      FontStyle="Italic"
                                                      Foreground="#666"
                                                      FontSize="9"
                                                      Margin="0,5,0,0"
                                                      TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Middle Column: Last Frame Input -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="🖼️ Last Frame" FontSize="13" FontWeight="Bold" Foreground="#FF6B35" Margin="0,0,0,8"/>
                                            <!-- Image Preview -->
                                            <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                    Background="White" Height="160"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="No last frame"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="#999"
                                                              FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LastFrameImagePreview}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding LastFrameImagePreview}" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>

                                            <!-- Browse Button -->
                                            <Button Content="📁 Browse Last Frame"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SelectLastFrameImageCommand}"
                                                   Height="32"
                                                   Margin="0,8,0,0"
                                                   FontSize="11"/>

                                            <!-- Image Info -->
                                            <TextBlock Text="{Binding LastFrameImageInfo}"
                                                      FontStyle="Italic"
                                                      Foreground="#666"
                                                      FontSize="9"
                                                      Margin="0,5,0,0"
                                                      TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Right Column: Analysis Result -->
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <!-- Header with Settings and Copy -->
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="🔍 Image Analysis"
                                                          FontSize="14" FontWeight="Bold"
                                                          Foreground="#FF6B35"
                                                          VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="📋"
                                                           Style="{StaticResource NavButtonStyle}"
                                                           Command="{Binding CopyAnalysisCommand}"
                                                           ToolTip="Copy to Clipboard"
                                                           Width="32" Height="28"
                                                           Padding="0" Margin="0,0,5,0"
                                                           IsEnabled="{Binding HasAnalysis}"/>
                                                    <Button Content="⚙️"
                                                           Style="{StaticResource NavButtonStyle}"
                                                           Command="{Binding OpenLMStudioSettingsCommand}"
                                                           ToolTip="LM Studio Settings"
                                                           Width="32" Height="28"
                                                           Padding="0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Analysis Result TextBox -->
                                            <TextBox Text="{Binding ImageAnalysis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap"
                                                    AcceptsReturn="True"
                                                    Height="180"
                                                    Padding="10"
                                                    VerticalScrollBarVisibility="Auto"
                                                    Background="White"
                                                    BorderBrush="#CED4DA"
                                                    FontSize="11"
                                                    IsReadOnly="{Binding IsAnalyzing}"/>

                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0"
                                                    BorderBrush="#FFE0B0"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8"
                                                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AnalysisStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="10"
                                                              TextAlignment="Center"/>
                                                    <ProgressBar Value="{Binding AnalysisProgress}"
                                                                Height="12" Margin="0,4,0,0"
                                                                Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Send to Queue Button -->
                                            <Button Content="📤 Send to Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding SendAnalysisToQueueCommand}"
                                                   IsEnabled="{Binding HasAnalysis}"
                                                   Height="38"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Stretch"/>

                                            <!-- Collapsible Video Settings -->
                                            <Expander Margin="0,15,0,0" IsExpanded="False">
                                                <Expander.Header>
                                                    <TextBlock Text="⚙️ Video Settings" FontSize="12" FontWeight="Bold" Foreground="#FF6B35"/>
                                                </Expander.Header>
                                                <StackPanel Margin="0,10,0,0">
                                                    <!-- Video Length -->
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock Text="Video Length (frames)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider Grid.Column="0"
                                                                    Value="{Binding VideoLength, Mode=TwoWay}"
                                                                    Minimum="21" Maximum="240"
                                                                    TickFrequency="20"
                                                                    IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1"
                                                                      Text="{Binding VideoLength}"
                                                                      Margin="8,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      MinWidth="35"
                                                                      FontWeight="Bold"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding VideoLengthSeconds}"
                                                                  FontSize="10"
                                                                  Foreground="#999"
                                                                  Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <!-- FPS -->
                                                    <StackPanel>
                                                        <TextBlock Text="FPS (Frames Per Second)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider Grid.Column="0"
                                                                    Value="{Binding Fps, Mode=TwoWay}"
                                                                    Minimum="8" Maximum="30"
                                                                    TickFrequency="2"
                                                                    IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1"
                                                                      Text="{Binding Fps}"
                                                                      Margin="8,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      MinWidth="25"
                                                                      FontWeight="Bold"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Generate Video Button -->
                                            <Button Content="🎬 Generate Video"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding GenerateVideoCommand}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="45"
                                                   FontSize="13"
                                                   Margin="0,10,0,0"/>

                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0"
                                                    BorderBrush="#FFE0B0"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8"
                                                    Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ProcessingStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="10"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap"
                                                              Margin="0,0,0,5"/>
                                                    <ProgressBar Value="{Binding ProcessingProgress}"
                                                                Height="14"
                                                                Foreground="#FF6B35"
                                                                Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding ProgressPercentage}"
                                                              HorizontalAlignment="Center"
                                                              FontSize="10"
                                                              FontWeight="Bold"
                                                              Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

  
                <!-- Prompt Queue Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="📝 Prompt Queue" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding NewQueuePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"
                                     Background="White"
                                     BorderBrush="#CED4DA"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                   Content="➕ Add to Queue"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding AddToQueueCommand}"
                                   Height="35"
                                   Width="120"
                                   Margin="0,0,5,0"/>

                            <Button Grid.Column="2"
                                   Content="▶️ Process Queue"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Command="{Binding ProcessQueueCommand}"
                                   IsEnabled="{Binding CanProcessQueue}"
                                   Height="35"
                                   Width="120"
                                   Margin="0,0,5,0"/>

                            <Button Grid.Column="3"
                                   Content="🔄 Reprocess Failed"
                                   Command="{Binding ReprocessAllFailedCommand}"
                                   IsEnabled="{Binding HasFailedItems}"
                                   Height="35"
                                   Width="140"
                                   Margin="0,0,5,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Background" Value="#FFA500"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF8C00"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCC"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="4"
                                   Content="⏹ Stop"
                                   Command="{Binding StopQueueCommand}"
                                   IsEnabled="{Binding IsProcessingQueue}"
                                   Height="35"
                                   Width="80"
                                   Margin="0,0,5,0"
                                   Background="#F59E0B" Foreground="White"
                                   BorderThickness="0" FontWeight="SemiBold"/>

                            <Button Grid.Column="5"
                                   Content="🗑️ Clear"
                                   Command="{Binding ClearQueueCommand}"
                                   Height="35"
                                   Width="80">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                        <Setter Property="Background" Value="#DC3545"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#C82333"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Pause/Resume Controls (Video Queue) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                    Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="⏸ Pause" Width="100" Height="32" Margin="0,0,8,0"
                                    Command="{Binding PauseQueueCommand}"
                                    Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                            <Button Content="▶ Resume" Width="100" Height="32" Margin="0,0,8,0"
                                    Command="{Binding ResumeQueueCommand}"
                                    Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="Queue Items:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>

                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                                <ItemsControl ItemsSource="{Binding PromptQueue}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                             Text="{Binding DisplayText}"
                                                             TextWrapping="Wrap"
                                                             FontSize="11"
                                                             VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                             Text="{Binding StatusDisplay}"
                                                             FontSize="10"
                                                             FontWeight="SemiBold"
                                                             Foreground="{Binding StatusColor}"
                                                             VerticalAlignment="Center"
                                                             Margin="10,0,10,0"/>

                                                    <!-- Reprocess button - only visible for failed items -->
                                                    <Button Grid.Column="2"
                                                           Content="🔄"
                                                           Command="{Binding DataContext.ReprocessItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Padding="5,2"
                                                           FontSize="11"
                                                           ToolTip="Reprocess this item"
                                                           Margin="0,0,5,0"
                                                           Width="30">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                                                <Setter Property="Background" Value="#FFA500"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#FF8C00"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button Grid.Column="3"
                                                           Content="❌"
                                                           Style="{StaticResource NavButtonStyle}"
                                                           Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Padding="5,2"
                                                           FontSize="10"
                                                           ToolTip="Remove from queue"
                                                           Width="30"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="{Binding QueueStatus}"
                                  FontSize="11"
                                  Foreground="#666"
                                  FontStyle="Italic"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Result Video Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                        <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                Background="White" Height="250"
                                CornerRadius="5" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="Video will appear here after generation"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="#999"
                                          FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasResultVideo}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Video Player -->
                                <MediaElement x:Name="VideoPlayer"
                                            Source="{Binding ResultVideoPath}"
                                            LoadedBehavior="Manual"
                                            UnloadedBehavior="Stop"
                                            Stretch="Uniform"
                                            Visibility="{Binding HasResultVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                   Content="▶️ Play"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding PlayVideoCommand}"
                                   IsEnabled="{Binding HasResultVideo}"
                                   Margin="0,0,8,0"/>

                            <Button Grid.Column="1"
                                   Content="📂 Open Folder"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding OpenResultFolderCommand}"
                                   IsEnabled="{Binding HasResultVideo}"
                                   Margin="0,0,8,0"/>

                            <Button Grid.Column="2"
                                   Content="📷 Send to Edit Camera"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding SendToEditCameraCommand}"
                                   IsEnabled="{Binding HasResultVideo}"/>
                        </Grid>

                        <TextBlock Text="{Binding VideoInfo}"
                                  FontStyle="Italic"
                                  Foreground="#666"
                                  FontSize="11"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Advanced Settings (Collapsible) -->
                <Expander Header="⚙️ Advanced Settings"
                         Margin="0,0,0,15"
                         IsExpanded="False">
                    <Border Background="#F8F9FA"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Steps -->
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Steps, Mode=TwoWay}"
                                                Minimum="1" Maximum="10"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Steps}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- CFG -->
                                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                    <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Cfg, Mode=TwoWay}"
                                                Minimum="1" Maximum="5"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Cfg, StringFormat={}{0:F1}}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Seed -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Seed (0 = Random)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding Seed, Mode=TwoWay}"
                                            Padding="8"
                                            Background="White"
                                            BorderBrush="#CED4DA"
                                            FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <!-- Negative Prompt -->
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="Negative Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        Height="60"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Log (Collapsible) -->
                <Expander Header="📝 Processing Log"
                         IsExpanded="True"
                         Margin="0,0,0,0">
                    <Border Background="White"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="150"
                                     VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LogOutput, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    IsReadOnly="True"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10"/>
                        </ScrollViewer>
                    </Border>
                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Story Video Generator -->
                    <TabItem Header="📖 Story Video Generator">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Workflow Selection -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Current Workflow Indicator -->
                                        <Border Grid.Column="0"
                                                Background="White"
                                                BorderBrush="#DEE2E6"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="12,8"
                                                Margin="0,0,15,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding WorkflowIndicator}"
                                                          FontSize="14"
                                                          FontWeight="SemiBold"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"/>
                                                <TextBlock Text="Current"
                                                          FontSize="11"
                                                          Foreground="#6C757D"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Workflow Toggle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Select Workflow"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- LTXV Workflow Toggle -->
                                                <Border Grid.Column="0"
                                                        CornerRadius="5"
                                                        Padding="10,8"
                                                        Background="White"
                                                        BorderBrush="#DEE2E6"
                                                        BorderThickness="2"
                                                        Margin="0,0,8,0"
                                                        Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UseLTXWorkflow}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#28A745"/>
                                                                    <Setter Property="Background" Value="#D4EDDA"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding Command="{Binding ToggleWorkflowCommand}" MouseAction="LeftClick"/>
                                                    </Border.InputBindings>
                                                    <StackPanel>
                                                        <TextBlock Text="🟢 LTXV"
                                                                  FontSize="13"
                                                                  FontWeight="Bold"
                                                                  Foreground="#212529"/>
                                                        <TextBlock Text="LTX-2_image2video_distilledAPI.json"
                                                                  FontSize="10"
                                                                  Foreground="#6C757D"
                                                                  Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Painter Workflow Toggle -->
                                                <Border Grid.Column="1"
                                                        CornerRadius="5"
                                                        Padding="10,8"
                                                        Background="White"
                                                        BorderBrush="#DEE2E6"
                                                        BorderThickness="2"
                                                        Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UseLTXWorkflow}" Value="False">
                                                                    <Setter Property="BorderBrush" Value="#007BFF"/>
                                                                    <Setter Property="Background" Value="#CCE5FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding Command="{Binding ToggleWorkflowCommand}" MouseAction="LeftClick"/>
                                                    </Border.InputBindings>
                                                    <StackPanel>
                                                        <TextBlock Text="🔵 Painter"
                                                                  FontSize="13"
                                                                  FontWeight="Bold"
                                                                  Foreground="#212529"/>
                                                        <TextBlock Text="painteri2vAPI.json"
                                                                  FontSize="10"
                                                                  Foreground="#6C757D"
                                                                  Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Story Setup Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📁 Story Setup" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Prompt JSON File Selection -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="1. Select the prompts JSON file (from Story Image Generator)"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📄 Select JSON File"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SelectStoryPromptJsonCommand}"
                                                   Height="35"
                                                   Width="150"/>
                                        </Grid>

                                        <TextBox Text="{Binding StoryPromptJsonPath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="11"
                                                Margin="0,0,0,15"
                                                VerticalAlignment="Center"/>

                                        <!-- Images Folder Selection -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="2. Select the folder containing the 10 generated story images"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Select Images Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SelectStoryImagesFolderCommand}"
                                                   Height="35"
                                                   Width="170"/>
                                        </Grid>

                                        <TextBox Text="{Binding StoryImagesFolderPath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="11"
                                                Margin="0,0,0,10"
                                                VerticalAlignment="Center"/>

                                        <!-- Load Queue Button -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="3. Load the queue with images and prompts"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📥 Load Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding LoadStoryQueueCommand}"
                                                   IsEnabled="{Binding CanLoadStoryQueue}"
                                                   Height="35"
                                                   Width="140"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Story Queue Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎞️ Story Video Queue" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Queue Controls -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="{Binding StoryQueueStatus}"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Foreground="#666"/>

                                            <Button Grid.Column="1"
                                                   Content="▶️ Process Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding ProcessStoryQueueCommand}"
                                                   IsEnabled="{Binding CanProcessStoryQueue}"
                                                   Height="35"
                                                   Width="140"
                                                   Margin="0,0,5,0"/>

                                            <Button Grid.Column="2"
                                                   Content="🔄 Retry Failed"
                                                   Command="{Binding ReprocessAllStoryFailedCommand}"
                                                   IsEnabled="{Binding HasStoryFailedItems}"
                                                   Height="35"
                                                   Width="110"
                                                   Margin="0,0,5,0"
                                                   Background="#FFA500" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>

                                            <Button Grid.Column="3"
                                                   Content="⏹ Stop"
                                                   Command="{Binding StopStoryQueueCommand}"
                                                   IsEnabled="{Binding IsProcessingStoryQueue}"
                                                   Height="35"
                                                   Width="80"
                                                   Margin="0,0,5,0"
                                                   Background="#F59E0B" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>

                                            <Button Grid.Column="4"
                                                   Content="🗑️ Clear Queue"
                                                   Command="{Binding ClearStoryQueueCommand}"
                                                   Height="35"
                                                   Width="110">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                                        <Setter Property="Background" Value="#DC3545"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#C82333"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- Pause/Resume Controls (Story Video Queue) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                                    Visibility="{Binding IsProcessingStoryQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Content="⏸ Pause" Width="100" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding PauseStoryQueueCommand}"
                                                    Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                                            <Button Content="▶ Resume" Width="100" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding ResumeStoryQueueCommand}"
                                                    Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Progress Display -->
                                        <Border Background="#FFF9F0"
                                                BorderBrush="#FFE0B0"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="12"
                                                Visibility="{Binding IsProcessingStoryQueue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                              Text="{Binding StoryQueueStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,5"
                                                              VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding StoryQueueProgressText}"
                                                              FontWeight="Bold"
                                                              FontSize="12"
                                                              Foreground="#FF6B35"
                                                              VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Current Item Info -->
                                                <TextBlock Text="Current:"
                                                          FontSize="10"
                                                          FontWeight="SemiBold"
                                                          Margin="0,5,0,3"/>

                                                <TextBlock Text="{Binding CurrentStoryQueueItem.Index, StringFormat='Prompt #{0}'}"
                                                          FontSize="11"
                                                          Margin="10,0,0,0"/>

                                                <ProgressBar Value="{Binding CurrentStoryQueueItem.Progress}"
                                                            Height="16"
                                                            Foreground="#FF6B35"
                                                            Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Queue Items List -->
                                        <TextBlock Text="Queue Items:"
                                                  FontWeight="SemiBold"
                                                  FontSize="12"
                                                  Margin="0,0,0,5"/>

                                        <Border BorderBrush="#DEE2E6"
                                                BorderThickness="1"
                                                Background="White"
                                                CornerRadius="5"
                                                MaxHeight="250">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                                                <ItemsControl ItemsSource="{Binding StoryVideoQueue}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#E9ECEF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Padding="10"
                                                                    Margin="0,0,0,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Index -->
                                                                    <Border Grid.Column="0"
                                                                            Background="#FF6B35"
                                                                            CornerRadius="3"
                                                                            Padding="8,4"
                                                                            Margin="0,0,10,0"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Index}"
                                                                                  Foreground="White"
                                                                                  FontWeight="Bold"
                                                                                  FontSize="12"
                                                                                  MinWidth="30"
                                                                                  TextAlignment="Center"/>
                                                                    </Border>

                                                                    <!-- Prompt Text -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Prompt}"
                                                                                  TextWrapping="Wrap"
                                                                                  FontSize="11"
                                                                                  MaxWidth="500"
                                                                                  ToolTip="{Binding Prompt}"/>
                                                                        <TextBlock Text="{Binding InputImagePath}"
                                                                                  FontSize="9"
                                                                                  Foreground="#999"
                                                                                  FontStyle="Italic"
                                                                                  Margin="0,3,0,0"/>
                                                                    </StackPanel>

                                                                    <!-- Status -->
                                                                    <TextBlock Grid.Column="2"
                                                                              Text="{Binding StatusDisplay}"
                                                                              FontSize="10"
                                                                              FontWeight="SemiBold"
                                                                              Foreground="{Binding StatusColor}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="10,0"/>

                                                                    <!-- Progress Bar (for processing items) -->
                                                                    <Grid Grid.Column="3"
                                                                          Width="100"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <ProgressBar Value="{Binding Progress}"
                                                                                    Height="10"
                                                                                    Foreground="#FFA500"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Story Log (Collapsible) -->
                                <Expander Header="📝 Processing Log"
                                         IsExpanded="True"
                                         Margin="0,0,0,0">
                                    <Border Background="White"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="1"
                                            Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding LogOutput, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: VACE Video Generator -->
                    <TabItem Header="🎭 VACE Video Generator">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- VACE Setup Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎬 VACE Video Inputs" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Reference Image -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Reference:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            BorderBrush="#DEE2E6" BorderThickness="1"
                                                            Background="White" Height="80"
                                                            CornerRadius="3" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="No foreground image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding VaceForegroundImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding VaceForegroundImagePreview}"
                                                                   Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectVACEForegroundImageCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding VaceForegroundImageInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                                <!-- Analyze Image Button -->
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="Analyze Image"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding AnalyzeVACEImageCommand}"
                                                            IsEnabled="{Binding HasVACEForegroundImage}"
                                                            Height="32"
                                                            Padding="12,0"
                                                            HorizontalAlignment="Left"/>
                                                    <TextBlock Text="Analyzing image..."
                                                               FontStyle="Italic"
                                                               Foreground="#FF6B35"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,0,0"
                                                               Visibility="{Binding IsAnalyzingVACE, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Video Input -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Input Video:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding VaceVideoPath, Mode=TwoWay}"
                                                            IsReadOnly="True"
                                                            Padding="10"
                                                            Background="White"
                                                            BorderBrush="#CED4DA"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"/>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectVACEVideoCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding VaceVideoInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- VACE Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📝 VACE Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <TextBlock Text="Describe how you want to transform the video:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                                        <TextBox Text="{Binding VacePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="100"
                                                Padding="12"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- VACE Generate Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Instructions -->
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="ℹ️ VACE (Video-to-Video with Control)" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                            <TextBlock Text="This workflow uses a reference image and input video to create a processed video using the Wan VACE V2V model." FontSize="11" TextWrapping="Wrap" Foreground="#666" Margin="0,5,0,10"/>
                                            <TextBlock Text="The model will use pose estimation from the input video and reference images to guide the video generation." FontSize="11" TextWrapping="Wrap" Foreground="#666"/>
                                        </StackPanel>

                                        <!-- Generate Button and Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="➕ Add to VACE Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding GenerateVACEVideoCommand}"
                                                   IsEnabled="{Binding VaceCanAddToQueue, Mode=OneWay}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="55"
                                                   FontSize="15"
                                                   Margin="0,0,0,15"/>

                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0"
                                                    BorderBrush="#FFE0B0"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="12"
                                                    Visibility="{Binding IsProcessingVACE, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding VaceProcessingStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,5"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap"/>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="#FF6B35"
                                                               Margin="0,0,0,5">
                                                        <Run Text="Chunks: "/>
                                                        <Run Text="{Binding VaceTotalChunks, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" × 81 frames"/>
                                                    </TextBlock>
                                                    <ProgressBar Value="{Binding VaceProcessingProgress, Mode=OneWay}"
                                                                Height="16"
                                                                Foreground="#FF6B35"
                                                                Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding VaceProgressPercentage}"
                                                              HorizontalAlignment="Center"
                                                              FontSize="11"
                                                              FontWeight="Bold"
                                                              Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- VACE Queue Panel -->
                                <Border Style="{StaticResource SectionPanelStyle}"
                                        Visibility="{Binding VaceHasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🎭 VACE Queue" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding VaceQueueStatus}"
                                                      FontStyle="Italic" Foreground="#666" FontSize="11"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2"
                                                   Content="🔄 Retry"
                                                   Command="{Binding ReprocessAllVaceFailedCommand}"
                                                   IsEnabled="{Binding VaceHasFailedItems}"
                                                   Height="28" Width="70" FontSize="11"
                                                   Margin="0,0,5,0"
                                                   Background="#FFA500" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>
                                            <Button Grid.Column="3"
                                                   Content="⏹ Stop"
                                                   Command="{Binding StopVaceQueueCommand}"
                                                   IsEnabled="{Binding VaceIsProcessingQueue}"
                                                   Height="28" Width="65" FontSize="11"
                                                   Margin="0,0,5,0"
                                                   Background="#F59E0B" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>
                                            <Button Grid.Column="4"
                                                   Content="🗑️ Clear"
                                                   Command="{Binding ClearVaceQueueCommand}"
                                                   Height="28" Width="65" FontSize="11"
                                                   Background="#DC3545" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding VaceQueue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4"
                                                            Padding="10,6" Margin="0,0,0,4" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding Prompt}" FontSize="10" Foreground="#666"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <Button Grid.Column="2"
                                                                    Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveVaceQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="28" Height="28"
                                                                    Padding="0"
                                                                    FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- VACE Result Video Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                Background="White" Height="250"
                                                CornerRadius="5" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999"
                                                          FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasVACEResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Video Player -->
                                                <MediaElement x:Name="VACEVideoPlayer"
                                                            Source="{Binding VaceResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasVACEResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                   Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayVACEVideoCommand}"
                                                   IsEnabled="{Binding HasVACEResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenVACEResultFolderCommand}"
                                                   IsEnabled="{Binding HasVACEResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="2"
                                                   Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendToEditCameraCommand}"
                                                   IsEnabled="{Binding HasVACEResult}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding VaceResultVideoInfo}"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- VACE Log (Collapsible) -->
                                <Expander Header="📝 Processing Log"
                                         IsExpanded="True"
                                         Margin="0,0,0,0">
                                    <Border Background="White"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="1"
                                            Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding VaceLogOutput, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 5: Single Video -->
                    <TabItem Header="🎬 Single Video">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Workflow Selector -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,5">
                                    <StackPanel>
                                        <TextBlock Text="🔧 Workflow" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                        <ComboBox SelectedIndex="{Binding SingleVideoWorkflowIndex, Mode=TwoWay}"
                                                  Height="32" Margin="0,6,0,0"
                                                  FontSize="13">
                                            <ComboBoxItem Content="🎬 LTX 2.3"/>
                                            <ComboBoxItem Content="🎨 Wan 2.2 Remix"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- LTX 2.3 Content -->
                                <StackPanel Visibility="{Binding SingleVideoIsLTX23, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <!-- Reference Image Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🖼️ Reference Image" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Column: Image Preview -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Source Image:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                    <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                            Background="White" Height="200"
                                                            CornerRadius="3">
                                                        <Grid>
                                                            <TextBlock Text="No image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding LTX23ImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding LTX23ImagePreview}" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Browse..."
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding SelectLTX23ImageCommand}"
                                                            Height="32"
                                                            HorizontalAlignment="Stretch"
                                                            Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding LTX23ImageInfo}"
                                                              FontStyle="Italic"
                                                              Foreground="#666"
                                                              FontSize="10"
                                                              Margin="0,6,0,0"
                                                              TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Right Column: Analyze Button + Result -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Image Analysis:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                    <Button Content="🧠 Analyze &amp; Generate"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding AnalyzeLTX23ImageCommand}"
                                                            IsEnabled="{Binding CanLTX23AnalyzeImage, Mode=OneWay}"
                                                            Height="32"
                                                            HorizontalAlignment="Stretch"/>
                                                    <TextBox Text="{Binding LTX23AnalysisResult, Mode=OneWay}"
                                                            TextWrapping="Wrap"
                                                            AcceptsReturn="True"
                                                            Height="188"
                                                            Padding="10"
                                                            VerticalScrollBarVisibility="Auto"
                                                            Background="#F8F9FA"
                                                            BorderBrush="#CED4DA"
                                                            FontSize="11"
                                                            IsReadOnly="True"
                                                            Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Video Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📝 Video Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <TextBlock Text="Describe the video action you want to generate:"
                                                  FontWeight="SemiBold" FontSize="12"
                                                  Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding LTX23Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="120"
                                                Padding="12"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="12"/>

                                        <!-- Frame Count -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Frames:"
                                                      FontWeight="SemiBold" FontSize="12"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Slider Grid.Column="1"
                                                   Minimum="49" Maximum="481"
                                                   SmallChange="24" LargeChange="48"
                                                   Value="{Binding LTX23FrameCount, Mode=TwoWay}"
                                                   VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2"
                                                    Text="{Binding LTX23FrameCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="48" Height="28"
                                                    TextAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    FontSize="12" Margin="8,0,0,0"
                                                    BorderBrush="#CED4DA"/>
                                        </Grid>
                                        <TextBlock Text="{Binding LTX23FrameCountHint}"
                                                  FontSize="10" Foreground="#888"
                                                  Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Processing Status + Queue Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <!-- Processing Status -->
                                        <Border Background="#FFF9F0"
                                                BorderBrush="#FFE0B0"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="12"
                                                Visibility="{Binding IsProcessingLTX23, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LTX23ProcessingStatus}"
                                                          FontWeight="SemiBold" FontSize="11"
                                                          TextAlignment="Center" TextWrapping="Wrap"/>
                                                <ProgressBar Value="{Binding LTX23ProcessingProgress, Mode=OneWay}"
                                                            Height="14" Foreground="#FF6B35"
                                                            Margin="0,6,0,4"/>
                                                <TextBlock Text="{Binding LTX23ProgressPercentage}"
                                                          HorizontalAlignment="Center"
                                                          FontSize="11" FontWeight="Bold"
                                                          Foreground="#FF6B35"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Queue List -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                CornerRadius="5" Margin="0,12,0,0"
                                                Visibility="{Binding LTX23HasQueueItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel>
                                                <Border Background="#F0F0F0" Padding="10,6" CornerRadius="5,5,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding LTX23QueueStatus}"
                                                                  FontSize="10" Foreground="#666"
                                                                  VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                               Content="⏹ Stop"
                                                               Command="{Binding StopLTX23QueueCommand}"
                                                               IsEnabled="{Binding LTX23IsProcessingQueue}"
                                                               Width="60" Height="22" FontSize="10"
                                                               Margin="4,0,4,0"
                                                               Background="#F59E0B" Foreground="White"
                                                               BorderThickness="0" Padding="4,2"/>
                                                        <Button Grid.Column="2"
                                                               Content="🔄 Retry"
                                                               Command="{Binding ReprocessLTX23FailedCommand}"
                                                               IsEnabled="{Binding LTX23HasFailedItems}"
                                                               Width="60" Height="22" FontSize="10"
                                                               Margin="0,0,4,0"
                                                               Background="#FFA500" Foreground="White"
                                                               BorderThickness="0" Padding="4,2"/>
                                                        <Button Grid.Column="3"
                                                               Content="🗑️ Clear"
                                                               Command="{Binding ClearLTX23QueueCommand}"
                                                               Width="60" Height="22" FontSize="10"
                                                               Background="#DC3545" Foreground="White"
                                                               BorderThickness="0" Padding="4,2"/>
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Padding="5">
                                                    <ItemsControl ItemsSource="{Binding LTX23Queue}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="#E9ECEF" BorderThickness="1"
                                                                        CornerRadius="4" Padding="8,6"
                                                                        Margin="2,2,2,0" Background="White">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding DisplayText}"
                                                                                      FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>

                                                                        <TextBlock Grid.Column="1"
                                                                                  Text="{Binding StatusDisplay}"
                                                                                  Foreground="{Binding StatusColor}"
                                                                                  FontSize="10" FontWeight="SemiBold"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="8,0,8,0"/>

                                                                        <Button Grid.Column="2"
                                                                               Content="✕"
                                                                               Width="22" Height="22"
                                                                               FontSize="10"
                                                                               Background="Transparent"
                                                                               BorderThickness="0"
                                                                               Foreground="#999"
                                                                               Padding="0"
                                                                               Command="{Binding DataContext.RemoveLTX23QueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                               CommandParameter="{Binding}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                        <!-- Latest Result Preview -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                Background="White" Height="220" CornerRadius="5"
                                                Margin="0,12,0,0">
                                            <Grid>
                                                <TextBlock Text="Latest generated video will appear here"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLTX23Result}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="LTX23VideoPlayer"
                                                            Source="{Binding LTX23ResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasLTX23Result, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Result Actions -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayLTX23VideoCommand}"
                                                   IsEnabled="{Binding HasLTX23Result}"
                                                   Margin="0,0,8,0"/>
                                            <Button Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenLTX23ResultFolderCommand}"
                                                   IsEnabled="{Binding HasLTX23Result}"
                                                   Margin="0,0,8,0"/>
                                            <Button Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendLTX23ToEditCameraCommand}"
                                                   IsEnabled="{Binding HasLTX23Result}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding LTX23VideoInfo}"
                                                  FontStyle="Italic" Foreground="#666"
                                                  FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Log Output -->
                                <Expander Header="📋 Generation Log" Margin="0,5,0,0" IsExpanded="False">
                                    <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                            Background="#F8F9FA" CornerRadius="5"
                                            Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding LTX23LogOutput, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                                </StackPanel>
                                <!-- End LTX 2.3 Content -->

                                <!-- Wan 2.2 Remix Content -->
                                <StackPanel Visibility="{Binding SingleVideoIsWan22, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <!-- Reference Image Section -->
                                    <Border Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Text="🖼️ Reference Image" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                            <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Image Preview -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Source Image:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" Height="200" CornerRadius="3">
                                                            <Grid>
                                                                <TextBlock Text="No image selected"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          Foreground="#999" FontStyle="Italic">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Wan22ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding Wan22ImagePreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Button Content="Browse..."
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding SelectWan22ImageCommand}"
                                                                Height="32" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                                        <TextBlock Text="{Binding Wan22ImageInfo}"
                                                                  FontStyle="Italic" Foreground="#666" FontSize="10"
                                                                  Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Right: Analyze Button + Result -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Image Analysis:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                        <Button Content="🧠 Analyze Image"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding AnalyzeWan22ImageCommand}"
                                                                IsEnabled="{Binding CanWan22AnalyzeImage, Mode=OneWay}"
                                                                Height="32" HorizontalAlignment="Stretch"/>
                                                        <TextBlock Text="Sends image to qwen-4-vl → auto-queues result"
                                                                  FontSize="10" Foreground="#888" FontStyle="Italic"
                                                                  Margin="0,4,0,4" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding Wan22AnalysisResult, Mode=OneWay}"
                                                                TextWrapping="Wrap" AcceptsReturn="True"
                                                                Height="160" Padding="10"
                                                                VerticalScrollBarVisibility="Auto"
                                                                Background="#F8F9FA" BorderBrush="#CED4DA"
                                                                FontSize="11" IsReadOnly="True" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Video Prompt Section -->
                                    <Border Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Text="📝 Video Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                            <TextBlock Text="Describe the video action (or edit the auto-generated prompt):"
                                                      FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding Wan22Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap" AcceptsReturn="True"
                                                    Height="120" Padding="12"
                                                    VerticalScrollBarVisibility="Auto"
                                                    Background="White" BorderBrush="#CED4DA" FontSize="12"/>
                                            <Button Content="➕ Add to Queue"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding GenerateWan22VideoCommand}"
                                                    IsEnabled="{Binding CanWan22AddToQueue, Mode=OneWay}"
                                                    Height="35" Width="140" HorizontalAlignment="Left"
                                                    Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Processing Status + Queue -->
                                    <Border Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0" BorderBrush="#FFE0B0" BorderThickness="1"
                                                    CornerRadius="5" Padding="12" Margin="0,0,0,10"
                                                    Visibility="{Binding IsProcessingWan22, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Wan22ProcessingStatus}"
                                                              FontWeight="SemiBold" FontSize="11"
                                                              TextAlignment="Center" TextWrapping="Wrap"/>
                                                    <ProgressBar Value="{Binding Wan22ProcessingProgress, Mode=OneWay}"
                                                                Height="14" Foreground="#FF6B35" Margin="0,6,0,4"/>
                                                    <TextBlock Text="{Binding Wan22ProgressPercentage}"
                                                              HorizontalAlignment="Center" FontSize="11"
                                                              FontWeight="Bold" Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Queue List -->
                                            <Border BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5"
                                                    Visibility="{Binding Wan22HasQueueItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <Border Background="#F0F0F0" Padding="10,6" CornerRadius="5,5,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Wan22QueueStatus}"
                                                                      FontSize="10" Foreground="#666"
                                                                      VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1"
                                                                   Content="⏹ Stop"
                                                                   Command="{Binding StopWan22QueueCommand}"
                                                                   IsEnabled="{Binding Wan22IsProcessingQueue}"
                                                                   Width="60" Height="22" FontSize="10"
                                                                   Margin="4,0,4,0"
                                                                   Background="#F59E0B" Foreground="White"
                                                                   BorderThickness="0" Padding="4,2"/>
                                                            <Button Grid.Column="2"
                                                                   Content="🔄 Retry"
                                                                   Command="{Binding ReprocessWan22FailedCommand}"
                                                                   IsEnabled="{Binding Wan22HasFailedItems}"
                                                                   Width="60" Height="22" FontSize="10"
                                                                   Margin="0,0,4,0"
                                                                   Background="#FFA500" Foreground="White"
                                                                   BorderThickness="0" Padding="4,2"/>
                                                            <Button Grid.Column="3"
                                                                   Content="🗑️ Clear"
                                                                   Command="{Binding ClearWan22QueueCommand}"
                                                                   Width="60" Height="22" FontSize="10"
                                                                   Background="#DC3545" Foreground="White"
                                                                   BorderThickness="0" Padding="4,2"/>
                                                        </Grid>
                                                    </Border>
                                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Padding="5">
                                                        <ItemsControl ItemsSource="{Binding Wan22Queue}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#E9ECEF" BorderThickness="1"
                                                                            CornerRadius="4" Padding="8,6"
                                                                            Margin="2,2,2,0" Background="White">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayText}"
                                                                                      FontSize="11" TextTrimming="CharacterEllipsis"
                                                                                      VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                      Text="{Binding StatusDisplay}"
                                                                                      Foreground="{Binding StatusColor}"
                                                                                      FontSize="10" FontWeight="SemiBold"
                                                                                      VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                                            <Button Grid.Column="2" Content="✕"
                                                                                   Width="22" Height="22" FontSize="10"
                                                                                   Background="Transparent" BorderThickness="0"
                                                                                   Foreground="#999" Padding="0"
                                                                                   Command="{Binding DataContext.RemoveWan22QueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                   CommandParameter="{Binding}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>

                                            <!-- Video Output Preview -->
                                            <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                    Background="White" Height="220" CornerRadius="5" Margin="0,12,0,0">
                                                <Grid>
                                                    <TextBlock Text="Latest generated video will appear here"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Foreground="#999" FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasWan22Result}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <MediaElement Source="{Binding Wan22ResultPath}"
                                                                LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                Stretch="Uniform"
                                                                Visibility="{Binding HasWan22Result, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Result Actions -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="▶️ Play"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Command="{Binding PlayWan22VideoCommand}"
                                                       IsEnabled="{Binding HasWan22Result}" Margin="0,0,8,0"/>
                                                <Button Content="📂 Open Folder"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Command="{Binding OpenWan22ResultFolderCommand}"
                                                       IsEnabled="{Binding HasWan22Result}" Margin="0,0,8,0"/>
                                                <Button Content="📷 Send to Edit Camera"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Command="{Binding SendWan22ToEditCameraCommand}"
                                                       IsEnabled="{Binding HasWan22Result}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Wan22VideoInfo}"
                                                      FontStyle="Italic" Foreground="#666"
                                                      FontSize="10" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Log Output -->
                                    <Expander Header="📋 Generation Log" Margin="0,5,0,0" IsExpanded="False">
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                Background="#F8F9FA" CornerRadius="5" Margin="0,8,0,0">
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                <TextBox Text="{Binding Wan22LogOutput, Mode=OneWay}"
                                                        TextWrapping="Wrap" IsReadOnly="True"
                                                        FontFamily="Consolas" FontSize="10"
                                                        Background="Transparent" BorderThickness="0" Padding="10"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Expander>

                                </StackPanel>
                                <!-- End Wan 2.2 Remix Content -->

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 6: Infinite Talk Video Generator -->
                    <TabItem Header="🎤 Infinite Talk">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Infinite Talk Setup Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎬 Infinite Talk Video Inputs" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Image Input -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Source Image:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            BorderBrush="#DEE2E6" BorderThickness="1"
                                                            Background="White" Height="80"
                                                            CornerRadius="3" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="No image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding InfiniteTalkImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding InfiniteTalkImagePreview}"
                                                                   Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectInfiniteTalkImageCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding InfiniteTalkImageInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                                <Button Content="Analyze Image"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding AnalyzeInfiniteTalkImageCommand}"
                                                        IsEnabled="{Binding CanInfiniteTalkAnalyzeImage, Mode=OneWay}"
                                                        Height="35"
                                                        Width="150"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"/>
                                                <TextBlock Text="Image Analysis Result:" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,5"/>
                                                <TextBox Text="{Binding InfiniteTalkAnalysisResult, Mode=OneWay}"
                                                        TextWrapping="Wrap"
                                                        AcceptsReturn="True"
                                                        Height="120"
                                                        Padding="12"
                                                        VerticalScrollBarVisibility="Auto"
                                                        Background="#F8F9FA"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="11"
                                                        IsReadOnly="True"
                                                        Visibility="{Binding HasInfiniteTalkAnalysis, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Audio Input -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Audio File:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding InfiniteTalkAudioPath, Mode=TwoWay}"
                                                            IsReadOnly="True"
                                                            Padding="10"
                                                            Background="White"
                                                            BorderBrush="#CED4DA"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"/>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectInfiniteTalkAudioCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding InfiniteTalkAudioInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📝 Video Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Button Content="Enhance Prompt"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding EnhanceInfiniteTalkPromptCommand}"
                                                IsEnabled="{Binding CanInfiniteTalkEnhancePrompt, Mode=OneWay}"
                                                Height="35"
                                                Width="160"
                                                HorizontalAlignment="Left"
                                                Margin="0,5,0,10"/>

                                        <StackPanel Visibility="{Binding ShowInfiniteTalkVideoPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Describe the video action you want to generate:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                                            <TextBox Text="{Binding InfiniteTalkPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap"
                                                    AcceptsReturn="True"
                                                    Height="100"
                                                    Padding="12"
                                                    VerticalScrollBarVisibility="Auto"
                                                    Background="White"
                                                    BorderBrush="#CED4DA"
                                                    FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Settings Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Video Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Width:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding InfiniteTalkWidth, Mode=TwoWay}"
                                                        Padding="8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="Height:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding InfiniteTalkHeight, Mode=TwoWay}"
                                                        Padding="8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="12"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="ℹ️ InfiniteTalk mode processes the entire audio using 81-frame windows internally"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Generate Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Instructions -->
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="ℹ️ Wan2.1 InfiniteTalk Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                            <TextBlock Text="Generate talking head videos synchronized to audio using Wan2.1 InfiniteTalk model. The system automatically calculates the number of frames needed based on the audio duration. The InfiniteTalk mode processes the video using 81-frame windows internally." FontSize="11" TextWrapping="Wrap" Foreground="#666" Margin="0,5,0,10"/>
                                            <TextBlock Text="Total Frames:" FontWeight="Bold" FontSize="11" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding InfiniteTalkTotalFrames}" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                                            <TextBlock Text="Estimated Duration:" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding InfiniteTalkEstimatedDuration}" FontSize="11" Foreground="#666"/>
                                        </StackPanel>

                                        <!-- Generate Button and Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="🎤 Generate Video"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding GenerateInfiniteTalkVideoCommand}"
                                                   IsEnabled="{Binding CanGenerateInfiniteTalkVideo, Mode=OneWay}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="55"
                                                   FontSize="15"
                                                   Margin="0,0,0,15"/>

                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0"
                                                    BorderBrush="#FFE0B0"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="12"
                                                    Visibility="{Binding IsProcessingInfiniteTalk, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding InfiniteTalkProcessingStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,5"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap"/>
                                                    <ProgressBar Value="{Binding InfiniteTalkProcessingProgress, Mode=OneWay}"
                                                                Height="16"
                                                                Foreground="#FF6B35"
                                                                Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding InfiniteTalkProgressPercentage}"
                                                              HorizontalAlignment="Center"
                                                              FontSize="11"
                                                              FontWeight="Bold"
                                                              Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Infinite Talk Result Video Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                Background="White" Height="250"
                                                CornerRadius="5" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999"
                                                          FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasInfiniteTalkResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Video Player -->
                                                <MediaElement x:Name="InfiniteTalkVideoPlayer"
                                                            Source="{Binding InfiniteTalkResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasInfiniteTalkResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                   Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayInfiniteTalkVideoCommand}"
                                                   IsEnabled="{Binding HasInfiniteTalkResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenInfiniteTalkResultFolderCommand}"
                                                   IsEnabled="{Binding HasInfiniteTalkResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="2"
                                                   Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendInfiniteTalkToEditCameraCommand}"
                                                   IsEnabled="{Binding HasInfiniteTalkResult}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding InfiniteTalkVideoInfo}"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Log Section -->
                                <Expander Header="📋 Processing Log" IsExpanded="False" Margin="0,10,0,0">
                                    <Border Style="{StaticResource SectionPanelStyle}">
                                        <ScrollViewer>
                                            <TextBox Text="{Binding InfiniteTalkLogOutput, Mode=OneWay}"
                                                    IsReadOnly="True"
                                                    TextWrapping="Wrap"
                                                    Background="#F8F9FA"
                                                    BorderBrush="#CED4DA"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Padding="10"
                                                    Height="200"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 8: LTX 2.3 Text to Video -->
                    <TabItem Header="✨ Text to Video">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Hero Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="✨ Text to Video"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>
                                        <TextBlock Text="Describe the video you want to generate — no image required."
                                                  FontSize="12" Foreground="#6C757D"
                                                  Margin="0,0,0,12"/>

                                        <TextBox Text="{Binding T2VPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                MinHeight="140"
                                                MaxHeight="260"
                                                Padding="14"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                BorderThickness="1"
                                                FontSize="13"
                                                VerticalAlignment="Stretch">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#FF6B35"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- Generate Button -->
                                        <Button Content="🎬  Generate Video"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding T2VGenerateCommand}"
                                                IsEnabled="{Binding T2VCanAddToQueue}"
                                                Height="44"
                                                Margin="0,14,0,0"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>

                                <!-- Settings Section -->
                                <Expander Header="⚙️ Generation Settings" IsExpanded="False" Margin="0,5,0,0">
                                    <Border Style="{StaticResource SectionPanelStyle}" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Duration -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Duration (seconds)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="#495057"/>
                                                <TextBox Text="{Binding T2VLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Padding="10,8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="13"
                                                        HorizontalContentAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Width -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Width (px)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="#495057"/>
                                                <TextBox Text="{Binding T2VWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Padding="10,8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="13"
                                                        HorizontalContentAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Height -->
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Height (px)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="#495057"/>
                                                <TextBox Text="{Binding T2VHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Padding="10,8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="13"
                                                        HorizontalContentAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Seed -->
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Seed (-1 = random)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="#495057"/>
                                                <TextBox Text="{Binding T2VSeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Padding="10,8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="13"
                                                        HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Expander>

                                <!-- Processing Status -->
                                <Border Background="#FFF9F0"
                                        BorderBrush="#FFE0B0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding IsProcessingT2V, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding T2VProcessingStatus}"
                                                  FontWeight="SemiBold" FontSize="12"
                                                  TextAlignment="Center" TextWrapping="Wrap"
                                                  Foreground="#495057"/>
                                        <ProgressBar Value="{Binding T2VProcessingProgress, Mode=OneWay}"
                                                    Height="10"
                                                    Foreground="#FF6B35"
                                                    Background="#F0F0F0"
                                                    BorderThickness="0"
                                                    Margin="0,8,0,4"/>
                                        <TextBlock Text="{Binding T2VProgressPercentage}"
                                                  HorizontalAlignment="Center"
                                                  FontSize="11" FontWeight="Bold"
                                                  Foreground="#FF6B35"/>
                                    </StackPanel>
                                </Border>

                                <!-- Queue Panel -->
                                <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                        CornerRadius="6" Margin="0,10,0,0"
                                        Visibility="{Binding T2VHasQueueItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Border Background="#F8F9FA" Padding="12,8" CornerRadius="6,6,0,0">
                                            <Grid>
                                                <TextBlock Text="📋 Queue"
                                                          FontWeight="Bold" FontSize="12"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding T2VQueueStatus}"
                                                          FontSize="10" Foreground="#6C757D"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Padding="6">
                                            <ItemsControl ItemsSource="{Binding T2VQueue}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#E9ECEF" BorderThickness="1"
                                                                CornerRadius="5" Padding="10,7"
                                                                Margin="2,2,2,0" Background="White">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                          Text="{Binding Prompt}"
                                                                          FontSize="11"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="#212529"/>

                                                                <TextBlock Grid.Column="1"
                                                                          Text="{Binding StatusDisplay}"
                                                                          Foreground="{Binding StatusColor}"
                                                                          FontSize="10" FontWeight="SemiBold"
                                                                          VerticalAlignment="Center"
                                                                          Margin="10,0,10,0"/>

                                                                <Button Grid.Column="2"
                                                                       Content="✕"
                                                                       Width="22" Height="22"
                                                                       FontSize="10"
                                                                       Background="Transparent"
                                                                       BorderThickness="0"
                                                                       Foreground="#ADB5BD"
                                                                       Padding="0"
                                                                       Command="{Binding DataContext.T2VRemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                       CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- Result Preview -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                Background="#FAFAFA" Height="240" CornerRadius="5"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Generated video will appear here"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#ADB5BD" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasT2VResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="T2VVideoPlayer"
                                                            Source="{Binding T2VResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasT2VResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding T2VPlayVideoCommand}"
                                                   IsEnabled="{Binding HasT2VResult}"
                                                   Margin="0,0,8,0"/>
                                            <Button Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding T2VOpenResultFolderCommand}"
                                                   IsEnabled="{Binding HasT2VResult}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding T2VVideoInfo}"
                                                  FontStyle="Italic" Foreground="#6C757D"
                                                  FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Generation Log -->
                                <Expander Header="📋 Generation Log" IsExpanded="False" Margin="0,5,0,0">
                                    <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                            Background="#F8F9FA" CornerRadius="5"
                                            Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding T2VLogOutput, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab: Long Video -->
                    <TabItem Header="🔄 Long Video">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Intro -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🔄 Long Video Generator"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#6C757D"
                                                  Margin="0,0,0,0">
                                            Upload a video → extract last frame → analyze → generate new video → repeat.
                                            Choose between Wan 2.2 Remix or LTX 2.3. Each iteration feeds the previous output as its input.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Workflow Selection -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🎬 Workflow"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">

                                            <!-- Wan 2.2 Remix -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LongVideoUseWan}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#007BFF"/>
                                                                <Setter Property="Background" Value="#CCE5FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding ToggleLongVideoWorkflowCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="🔵 Wan 2.2 Remix"
                                                              FontSize="13" FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="Wan2_2_RemixAPI.json"
                                                              FontSize="10" Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- LTX 2.3 -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LongVideoUseLTX23}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#28A745"/>
                                                                <Setter Property="Background" Value="#D4EDDA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding ToggleLongVideoWorkflowCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="🟢 LTX 2.3"
                                                              FontSize="13" FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="LTX2.3-I2VAPI.json"
                                                              FontSize="10" Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Wan Analysis Prompt Selection (Wan workflow only) -->
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LongVideoUseWan}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🧠 Analysis Prompt"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>
                                        <TextBlock Text="Selects which system prompt is sent with the last frame to llamaserver:"
                                                  FontSize="11" Foreground="#6C757D" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">

                                            <!-- Button 1: wan-system-single -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LongVideoUseWanSinglePrompt}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#6F42C1"/>
                                                                <Setter Property="Background" Value="#EDE7F6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding SelectLongVideoWanSinglePromptCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="1 — Single Frame"
                                                              FontSize="13" FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="wan-system-single.md"
                                                              FontSize="10" Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                    <TextBlock Text="Cinematic action prompt"
                                                              FontSize="10" Foreground="#6C757D"
                                                              FontStyle="Italic"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Button 2: wan-long-fight (default) -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LongVideoUseWanFightPrompt}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#DC3545"/>
                                                                <Setter Property="Background" Value="#FDECEA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding SelectLongVideoWanFightPromptCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="2 — Long Fight  ✓"
                                                              FontSize="13" FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="wan-long-fight.md"
                                                              FontSize="10" Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                    <TextBlock Text="Martial arts / combat prompt"
                                                              FontSize="10" Foreground="#6C757D"
                                                              FontStyle="Italic"/>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- Video Input -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="📹 Input Video"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>

                                        <Button Content="📁 Browse Video"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SelectLongVideoCommand}"
                                                Height="36"
                                                HorizontalAlignment="Left"
                                                MinWidth="160"
                                                Margin="0,0,0,8"/>

                                        <TextBlock Text="{Binding LongVideoInfo}"
                                                  FontStyle="Italic"
                                                  Foreground="#495057"
                                                  FontSize="11"
                                                  TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Loop Settings -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Loop Settings"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Iterations (1–10):"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>
                                            <Slider Value="{Binding LongVideoMaxIterations, Mode=TwoWay}"
                                                   Minimum="1" Maximum="10"
                                                   TickFrequency="1"
                                                   IsSnapToTickEnabled="True"
                                                   Width="160"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LongVideoMaxIterations}"
                                                      FontWeight="Bold"
                                                      FontSize="16"
                                                      Foreground="#FF6B35"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Start / Stop -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                           Content="{Binding LongVideoStartButtonContent}"
                                           Style="{StaticResource PrimaryButtonStyle}"
                                           Command="{Binding StartLongVideoCommand}"
                                           IsEnabled="{Binding LongVideoCanStart}"
                                           Height="44"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                    <Button Grid.Column="2"
                                           Content="⏹ Stop"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           Command="{Binding StopLongVideoCommand}"
                                           IsEnabled="{Binding LongVideoIsRunning}"
                                           Height="44"
                                           Width="90"
                                           FontSize="13"/>
                                </Grid>

                                <!-- Queue indicator -->
                                <Border Margin="0,4,0,0" Padding="10,6" CornerRadius="4"
                                        Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LongVideoHasQueuedJobs}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" Foreground="#856404">
                                        <Run Text="⏳ "/>
                                        <Run Text="{Binding LongVideoQueueCount, Mode=OneWay}"/>
                                        <Run Text=" job(s) queued — will start automatically when current finishes"/>
                                    </TextBlock>
                                </Border>

                                <!-- Progress -->
                                <Border Background="#FFF9F0"
                                        BorderBrush="#FFE0B0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding LongVideoIsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LongVideoProcessingStatus}"
                                                  FontWeight="SemiBold" FontSize="12"
                                                  TextWrapping="Wrap"
                                                  TextAlignment="Center"
                                                  Foreground="#495057"/>
                                        <ProgressBar Value="{Binding LongVideoProcessingProgress, Mode=OneWay}"
                                                    Height="10"
                                                    Foreground="#FF6B35"
                                                    Background="#F0F0F0"
                                                    BorderThickness="0"
                                                    Margin="0,8,0,4"/>
                                        <TextBlock Text="{Binding LongVideoProgressPercentage}"
                                                  HorizontalAlignment="Center"
                                                  FontSize="11" FontWeight="Bold"
                                                  Foreground="#FF6B35"/>
                                    </StackPanel>
                                </Border>

                                <!-- Iterations List -->
                                <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                        CornerRadius="6" Margin="0,8,0,0"
                                        Visibility="{Binding LongVideoHasIterations, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Border Background="#F8F9FA" Padding="12,8" CornerRadius="6,6,0,0">
                                            <TextBlock Text="📋 Iterations"
                                                      FontWeight="Bold" FontSize="12"
                                                      VerticalAlignment="Center"/>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding LongVideoIterations}" Margin="6,4,6,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E9ECEF" BorderThickness="1"
                                                            CornerRadius="5" Padding="10,8"
                                                            Margin="2,2,2,0" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}"
                                                                          FontWeight="SemiBold" FontSize="12"
                                                                          Foreground="#212529"/>
                                                                <TextBlock Text="{Binding AnalysisPrompt}"
                                                                          FontSize="10" Foreground="#6C757D"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          MaxWidth="300"
                                                                          Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1"
                                                                      Text="{Binding StatusDisplay}"
                                                                      Foreground="{Binding StatusColor}"
                                                                      FontSize="11" FontWeight="SemiBold"
                                                                      VerticalAlignment="Center"
                                                                      Margin="10,0,6,0"/>

                                                            <Button Grid.Column="2"
                                                                   Content="▶"
                                                                   Width="28" Height="28"
                                                                   FontSize="11"
                                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                                   Padding="0"
                                                                   IsEnabled="{Binding HasOutput}"
                                                                   ToolTip="Play this iteration's video"
                                                                   Command="{Binding DataContext.PlayLongVideoIterationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   Margin="2,0,0,0"/>

                                                            <Button Grid.Column="3"
                                                                   Content="📂"
                                                                   Width="28" Height="28"
                                                                   FontSize="11"
                                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                                   Padding="0"
                                                                   IsEnabled="{Binding HasOutput}"
                                                                   ToolTip="Open output folder"
                                                                   Command="{Binding DataContext.OpenLongVideoIterationFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   Margin="2,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Last Frame Preview + Analysis -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0"
                                        Visibility="{Binding LongVideoIsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Frame preview -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🖼️ Last Frame"
                                                      FontSize="12" FontWeight="Bold"
                                                      Foreground="#FF6B35" Margin="0,0,0,6"/>
                                            <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                    Background="White" Height="160" CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="Extracting frame..."
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="#999" FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LongVideoFramePreview}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding LongVideoFramePreview}" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- Analysis result -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="🧠 Analysis"
                                                      FontSize="12" FontWeight="Bold"
                                                      Foreground="#FF6B35" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding LongVideoCurrentAnalysis, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    AcceptsReturn="True"
                                                    Height="160"
                                                    Padding="10"
                                                    VerticalScrollBarVisibility="Auto"
                                                    Background="#F8F9FA"
                                                    BorderBrush="#CED4DA"
                                                    FontSize="11"
                                                    IsReadOnly="True"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Result -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0"
                                        Visibility="{Binding HasLongVideoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Latest Result"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                Background="#FAFAFA" Height="240"
                                                CornerRadius="5" Margin="0,0,0,10">
                                            <MediaElement x:Name="LongVideoPlayer"
                                                        Source="{Binding LongVideoResultPath}"
                                                        LoadedBehavior="Manual"
                                                        UnloadedBehavior="Stop"
                                                        Stretch="Uniform"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayLongVideoResultCommand}"
                                                   IsEnabled="{Binding HasLongVideoResult}"
                                                   Margin="0,0,8,0"/>
                                            <Button Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenLongVideoResultFolderCommand}"
                                                   IsEnabled="{Binding HasLongVideoResult}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding LongVideoResultInfo}"
                                                  FontStyle="Italic" Foreground="#6C757D"
                                                  FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Log -->
                                <Expander Header="📋 Generation Log" IsExpanded="False" Margin="0,5,0,0">
                                    <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                            Background="#F8F9FA" CornerRadius="5" Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding LongVideoLogOutput, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 8: WanAnimate -->
                    <TabItem Header="🕺 WanAnimate">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Inputs Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎬 WanAnimate Inputs" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Reference Image -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Identity Reference Image" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="1"
                                                            BorderBrush="#DEE2E6" BorderThickness="1"
                                                            Background="White" Height="80"
                                                            CornerRadius="3" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="No reference image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding WanAnimateRefImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding WanAnimateRefImagePreview}" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectWanAnimateRefImageCommand}"
                                                           Height="35" Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding WanAnimateRefImageInfo}"
                                                          FontStyle="Italic" Foreground="#666" FontSize="10" Margin="0,6,0,0"/>
                                                <!-- Analyze button -->
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="Analyze Image"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding AnalyzeWanAnimateImageCommand}"
                                                            IsEnabled="{Binding WanAnimateHasRefImage}"
                                                            Height="32" Padding="12,0" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="Analyzing..."
                                                               FontStyle="Italic" Foreground="#FF6B35" FontSize="11"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                                               Visibility="{Binding WanAnimateIsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Face Reference Image -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Face Reference Image" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="1"
                                                            BorderBrush="#DEE2E6" BorderThickness="1"
                                                            Background="White" Height="80"
                                                            CornerRadius="3" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="No face image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding WanAnimateFaceImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding WanAnimateFaceImagePreview}" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectWanAnimateFaceImageCommand}"
                                                           Height="35" Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding WanAnimateFaceImageInfo}"
                                                          FontStyle="Italic" Foreground="#666" FontSize="10" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Input Video -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Input Video" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding WanAnimateVideoPath, Mode=TwoWay}"
                                                            IsReadOnly="True"
                                                            Padding="10"
                                                            Background="White"
                                                            BorderBrush="#CED4DA"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"/>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectWanAnimateVideoCommand}"
                                                           Height="35" Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding WanAnimateVideoInfo}"
                                                          FontStyle="Italic" Foreground="#666" FontSize="10" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📝 Prompts" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <TextBlock Text="Positive Prompt:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding WanAnimatePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="80"
                                                Padding="12"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="12"
                                                Margin="0,0,0,10"/>

                                        <TextBlock Text="Negative Prompt:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding WanAnimateNegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="60"
                                                Padding="12"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- Resolution + Generate Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="ℹ️ WanAnimate (Steady Dancer + OneToAll)" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                            <TextBlock Text="Uses reference image for identity + aspect ratio, face image for face swap, and input video for motion. Output resolution is auto-detected from the reference image (portrait → 640×1024, landscape → 832×480, square → 704×704). Processes in 81-frame chunks automatically." FontSize="11" TextWrapping="Wrap" Foreground="#666" Margin="0,5,0,10"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Output:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Width="60"/>
                                                <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                                                        CornerRadius="4" Padding="8,4">
                                                    <TextBlock VerticalAlignment="Center" FontSize="12">
                                                        <Run Text="{Binding WanAnimateOutputWidth, Mode=OneWay}" FontWeight="Bold"/>
                                                        <Run Text="×"/>
                                                        <Run Text="{Binding WanAnimateOutputHeight, Mode=OneWay}" FontWeight="Bold"/>
                                                        <Run Text=" (auto from image)" Foreground="#666" FontSize="10"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Generate button + status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="➕ Add to Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding GenerateWanAnimateVideoCommand}"
                                                   IsEnabled="{Binding WanAnimateCanAddToQueue, Mode=OneWay}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="55"
                                                   FontSize="15"
                                                   Margin="0,0,0,15"/>

                                            <Border Background="#FFF9F0"
                                                    BorderBrush="#FFE0B0"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="12"
                                                    Visibility="{Binding IsProcessingWanAnimate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding WanAnimateProcessingStatus}"
                                                              FontWeight="SemiBold" FontSize="11"
                                                              Margin="0,0,0,5"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap"/>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               FontSize="11" Foreground="#FF6B35"
                                                               Margin="0,0,0,5">
                                                        <Run Text="Chunks: "/>
                                                        <Run Text="{Binding WanAnimateTotalChunks, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" × 81 frames"/>
                                                    </TextBlock>
                                                    <ProgressBar Value="{Binding WanAnimateProcessingProgress, Mode=OneWay}"
                                                                Height="16"
                                                                Foreground="#FF6B35"
                                                                Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding WanAnimateProgressPercentage}"
                                                              HorizontalAlignment="Center"
                                                              FontSize="11" FontWeight="Bold"
                                                              Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Queue Panel -->
                                <Border Style="{StaticResource SectionPanelStyle}"
                                        Visibility="{Binding WanAnimateHasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🕺 WanAnimate Queue" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding WanAnimateQueueStatus}"
                                                      FontStyle="Italic" Foreground="#666" FontSize="11"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2"
                                                   Content="🔄 Retry"
                                                   Command="{Binding ReprocessAllWanAnimateFailedCommand}"
                                                   IsEnabled="{Binding WanAnimateHasFailedItems}"
                                                   Height="28" Width="70" FontSize="11"
                                                   Margin="0,0,5,0"
                                                   Background="#FFA500" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>
                                            <Button Grid.Column="3"
                                                   Content="⏹ Stop"
                                                   Command="{Binding StopWanAnimateQueueCommand}"
                                                   IsEnabled="{Binding WanAnimateIsProcessingQueue}"
                                                   Height="28" Width="65" FontSize="11"
                                                   Margin="0,0,5,0"
                                                   Background="#F59E0B" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>
                                            <Button Grid.Column="4"
                                                   Content="🗑️ Clear"
                                                   Command="{Binding ClearWanAnimateQueueCommand}"
                                                   Height="28" Width="65" FontSize="11"
                                                   Background="#DC3545" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding WanAnimateQueue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4"
                                                            Padding="10,6" Margin="0,0,0,4" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding Prompt}" FontSize="10" Foreground="#666"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <Button Grid.Column="2"
                                                                    Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveWanAnimateQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="28" Height="28"
                                                                    Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Result Video Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                Background="White" Height="250"
                                                CornerRadius="5" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999"
                                                          FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWanAnimateResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <MediaElement x:Name="WanAnimateVideoPlayer"
                                                            Source="{Binding WanAnimateResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasWanAnimateResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                   Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayWanAnimateVideoCommand}"
                                                   IsEnabled="{Binding HasWanAnimateResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenWanAnimateResultFolderCommand}"
                                                   IsEnabled="{Binding HasWanAnimateResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="2"
                                                   Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendWanAnimateToEditCameraCommand}"
                                                   IsEnabled="{Binding HasWanAnimateResult}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding WanAnimateResultVideoInfo}"
                                                  FontStyle="Italic" Foreground="#666" FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Log -->
                                <Expander Header="📝 Processing Log"
                                         IsExpanded="True"
                                         Margin="0,0,0,0">
                                    <Border Background="White"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="1"
                                            Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding WanAnimateLogOutput, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 9: WAN SCAIL -->
                    <TabItem Header="⚡ WAN SCAIL" FontWeight="Bold" FontSize="13">
                        <!-- 2-column layout: left inputs + right video editor -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Background="#F9FAFB">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Character Image -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CHARACTER IMAGE" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>

                                                <Border BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6"
                                                        Background="#FAF5FF" Height="130" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No character image selected"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="#9CA3AF" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding WanScailCharacterImagePreview}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding WanScailCharacterImagePreview}" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding WanScailCharacterImageInfo}"
                                                               FontSize="10" Foreground="#6B7280" FontStyle="Italic"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectWanScailCharacterImageCommand}"
                                                            Height="28" Padding="10,0" FontSize="11"
                                                            Background="#EDE9FE" Foreground="#7C3AED"
                                                            BorderBrush="#DDD6FE" BorderThickness="1"/>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze Image"
                                                            Command="{Binding AnalyzeWanScailImageCommand}"
                                                            IsEnabled="{Binding WanScailHasCharacterImage}"
                                                            Height="30" Padding="12,0" FontSize="11"
                                                            Background="#7C3AED" Foreground="White" BorderThickness="0"/>
                                                    <TextBlock Text="  Analyzing…" FontStyle="Italic" Foreground="#7C3AED"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Visibility="{Binding WanScailIsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reference Video -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="REFERENCE VIDEO" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding WanScailVideoPath, Mode=OneWay}"
                                                             IsReadOnly="True" Height="30"
                                                             VerticalContentAlignment="Center" Padding="6,0"
                                                             BorderBrush="#DDD6FE" Background="#F0FDF4"
                                                             FontSize="11" Foreground="#555" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectWanScailVideoCommand}"
                                                            Height="30" Padding="10,0" FontSize="11"
                                                            Background="#ECFDF5" Foreground="#059669"
                                                            BorderBrush="#A7F3D0" BorderThickness="1"/>
                                                </Grid>
                                                <TextBlock Text="{Binding WanScailVideoInfo}"
                                                           FontSize="10" Foreground="#6B7280" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#818CF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="POSITIVE PROMPT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding WanScailPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="90" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="#DDD6FE" Background="#FAF5FF"
                                                         FontSize="12" Padding="8" Margin="0,0,0,10"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="NEGATIVE PROMPT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding WanScailNegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="55" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="#DDD6FE" Background="#FAF5FF"
                                                         FontSize="11" Padding="8"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                        <TextBlock Text="Frame Rate" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding WanScailFps, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                                 BorderBrush="#DDD6FE" Background="#FAF5FF"
                                                                 FontSize="12" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Max Edge (px)" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding WanScailMaxEdge, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                                 BorderBrush="#DDD6FE" Background="#FAF5FF"
                                                                 FontSize="12" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding WanScailSeed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="#DDD6FE" Background="#FAF5FF"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomWanScailSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="#EDE9FE" Foreground="#7C3AED"
                                                            BorderBrush="#DDD6FE" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL: Video Editor ════════════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="290"/>  <!-- Reference video area -->
                                    <RowDefinition Height="Auto"/> <!-- Timeline -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Queue panel -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Reference Video Area ──────────────────────────── -->
                                <Border Grid.Row="0" Background="#030712">
                                    <Grid>
                                        <!-- Idle placeholder -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WanScailHasVideo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14"
                                                    Background="#0A0F1E" BorderBrush="#1F2937" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🎬" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Drop reference video here" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Use Browse button in the Reference Video card on the left"
                                                       FontSize="11" Foreground="#374151" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                                        </StackPanel>

                                        <!-- Reference video player -->
                                        <MediaElement x:Name="WanScailRefVideoPlayer"
                                                      Source="{Binding WanScailVideoFileUri}"
                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      Stretch="Uniform"
                                                      Visibility="{Binding WanScailHasVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- Info bar overlay -->
                                        <Border VerticalAlignment="Bottom" Margin="10,0,10,10"
                                                CornerRadius="8" Padding="12,6"
                                                Visibility="{Binding WanScailHasVideoInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.Background>
                                                <SolidColorBrush Color="#030712" Opacity="0.88"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="#1F2937" Opacity="0.7"/>
                                            </Border.BorderBrush>
                                            <Border.BorderThickness>1</Border.BorderThickness>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="10" Foreground="#9CA3AF">
                                                    <Run Text="Duration "/>
                                                    <Run Text="{Binding WanScailVideoDuration, Mode=OneWay}" FontWeight="Bold" Foreground="#E5E7EB" FontFamily="Consolas"/>
                                                </TextBlock>
                                                <Border Width="1" Background="#374151" Margin="10,0"/>
                                                <TextBlock FontSize="10" Foreground="#9CA3AF">
                                                    <Run Text="FPS "/>
                                                    <Run Text="{Binding WanScailVideoFpsDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="#E5E7EB" FontFamily="Consolas"/>
                                                </TextBlock>
                                                <Border Width="1" Background="#374151" Margin="10,0"/>
                                                <TextBlock FontSize="10" Foreground="#9CA3AF">
                                                    <Run Text="Frames "/>
                                                    <Run Text="{Binding WanScailVideoFrameCountDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="#E5E7EB" FontFamily="Consolas"/>
                                                </TextBlock>
                                                <Border Width="1" Background="#374151" Margin="10,0"/>
                                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="#C084FC" FontFamily="Consolas"
                                                           Text="{Binding WanScailVideoChunksDisplay, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ─── Timeline ───────────────────────────────────────── -->
                                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1F2937"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="5" Height="5" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="121-FRAME WINDOWS" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                                                <TextBlock Text="  · click to seek video" FontSize="9" Foreground="#374151"/>
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding WanScailChunkSelectionInfo, Mode=OneWay}"
                                                       FontSize="10" Foreground="#6B7280" FontFamily="Consolas"/>
                                        </Grid>

                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Height="58" Background="Transparent">
                                            <ItemsControl ItemsSource="{Binding WanScailChunkItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="62" Height="52" Margin="1,0"
                                                                Background="{Binding BackgroundColor}"
                                                                BorderBrush="{Binding BorderColor}"
                                                                BorderThickness="1.5" Padding="0" Cursor="Hand"
                                                                Command="{Binding DataContext.SelectWanScailChunkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid>
                                                                <StackPanel VerticalAlignment="Center" Margin="2,4,2,6">
                                                                    <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="{Binding LabelColor}"/>
                                                                    <TextBlock Text="{Binding FrameRange}" FontSize="7.5"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="{Binding LabelColor}"
                                                                               FontFamily="Consolas"/>
                                                                    <TextBlock Text="{Binding StatusDot}" FontSize="9"
                                                                               HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                                </StackPanel>
                                                                <Border VerticalAlignment="Bottom" Height="3"
                                                                        Background="{Binding BottomBarColor}"
                                                                        CornerRadius="0,0,2,2"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Progress bar ───────────────────────────────────── -->
                                <ProgressBar Grid.Row="2"
                                             Value="{Binding WanScailProcessingProgress, Mode=OneWay}"
                                             Foreground="#7C3AED" Background="#1F2937" BorderThickness="0"
                                             Visibility="{Binding WanScailIsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ─────────────────────────────────────── -->
                                <Border Grid.Row="3" Background="#111827" BorderBrush="#1F2937"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#374151"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WanScailIsProcessingQueue}" Value="True">
                                                                <Setter Property="Fill" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding WanScailProcessingStatus}"
                                                       FontSize="11" Foreground="#6B7280"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding WanScailProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#7C3AED"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding WanScailIsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ─────────────────────────────────── -->
                                <Border Grid.Row="4" Background="#0F172A" BorderBrush="#1F2937"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,5,0" Height="40"
                                                Command="{Binding ProcessSelectedWanScailChunkCommand}"
                                                IsEnabled="{Binding WanScailCanAddToQueue}"
                                                Background="#7C3AED" Foreground="White"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Process Selected Chunk" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Margin="0,0,5,0" Height="40"
                                                Command="{Binding GenerateWanScailVideoCommand}"
                                                IsEnabled="{Binding WanScailCanAddToQueue}"
                                                Background="#059669" Foreground="White"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Process Entire Video" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Height="40" Width="82"
                                                Command="{Binding StopWanScailQueueCommand}"
                                                IsEnabled="{Binding WanScailIsProcessingQueue}"
                                                Background="#1F2937" Foreground="#F87171"
                                                FontSize="11" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Queue Panel ────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="#F5F3FF" BorderBrush="#DDD6FE"
                                        BorderThickness="0,1,0,0" Padding="12,8"
                                        Visibility="{Binding WanScailHasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚡ WAN SCAIL Queue"
                                                       FontWeight="Bold" FontSize="12" Foreground="#7C3AED"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding WanScailQueueStatus}"
                                                       FontStyle="Italic" Foreground="#666" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="🔄 Retry"
                                                    Command="{Binding ReprocessAllWanScailFailedCommand}"
                                                    IsEnabled="{Binding WanScailHasFailedItems}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Background="#7C3AED" Foreground="White" BorderThickness="0"/>
                                            <Button Grid.Column="3" Content="⏹ Stop"
                                                    Command="{Binding StopWanScailQueueCommand}"
                                                    IsEnabled="{Binding WanScailIsProcessingQueue}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Background="#A78BFA" Foreground="White" BorderThickness="0"/>
                                            <Button Grid.Column="4" Content="🗑️ Clear"
                                                    Command="{Binding ClearWanScailQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11"
                                                    Background="#DC3545" Foreground="White" BorderThickness="0"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding WanScailQueue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4"
                                                            Padding="10,5" Margin="0,0,0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding Prompt}" FontSize="10" Foreground="#666"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveWanScailQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────── -->
                                <Border Grid.Row="6" Background="White" BorderBrush="#DDD6FE"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="#7C3AED" Margin="0,0,0,8"/>

                                        <Border BorderBrush="#DDD6FE" BorderThickness="1" Background="#030712"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#374151" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWanScailResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="WanScailVideoPlayer"
                                                              Source="{Binding WanScailResultPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasWanScailResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayWanScailVideoCommand}"
                                                    IsEnabled="{Binding HasWanScailResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenWanScailResultFolderCommand}"
                                                    IsEnabled="{Binding HasWanScailResult}" Margin="0,0,8,0"/>
                                            <Button Content="📷 Send to Edit Camera" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding SendWanScailToEditCameraCommand}"
                                                    IsEnabled="{Binding HasWanScailResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding WanScailResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ────────────────────────────────────────────── -->
                                <Border Grid.Row="7" Background="White" BorderBrush="#DDD6FE" BorderThickness="0,1,0,0">
                                    <Expander Header="📝 Processing Log" IsExpanded="False" Margin="6">
                                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                            <TextBox Text="{Binding WanScailLogOutput, Mode=OneWay}"
                                                     TextWrapping="Wrap" IsReadOnly="True"
                                                     FontFamily="Consolas" FontSize="10"
                                                     Background="Transparent" BorderThickness="0" Padding="10"/>
                                        </ScrollViewer>
                                    </Expander>
                                </Border>

                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="⚡ WAN SCAIL 2" FontWeight="Bold" FontSize="13">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Inputs Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="⚡ WAN SCAIL — Motion Transfer" Style="{StaticResource HeaderTextStyle}" Foreground="#7C3AED"/>
                                        <TextBlock Text="Multi-Character Pose &amp; Style Transfer · 121-frame chunk processing"
                                                   FontSize="11" Foreground="#7C3AED" Margin="0,-8,0,12" Opacity="0.8"/>

                                        <!-- Character Image -->
                                        <Border BorderBrush="#DDD6FE" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Character Image" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            BorderBrush="#DDD6FE" BorderThickness="1"
                                                            Background="#FAF5FF" Height="100"
                                                            CornerRadius="3" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="No character image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding WanScailCharacterImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding WanScailCharacterImagePreview}" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="1"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectWanScailCharacterImageCommand}"
                                                           Height="35" Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding WanScailCharacterImageInfo}"
                                                          FontStyle="Italic" Foreground="#666" FontSize="10" Margin="0,6,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="🔍 Analyze Image"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding AnalyzeWanScailImageCommand}"
                                                            IsEnabled="{Binding WanScailHasCharacterImage}"
                                                            Height="32" Padding="12,0" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="Analyzing..."
                                                               FontStyle="Italic" Foreground="#7C3AED" FontSize="11"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                                               Visibility="{Binding WanScailIsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reference Video -->
                                        <Border BorderBrush="#DDD6FE" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Reference Video (Motion Source)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding WanScailVideoPath, Mode=TwoWay}"
                                                             IsReadOnly="True"
                                                             Height="32"
                                                             VerticalContentAlignment="Center"
                                                             Padding="8,0"
                                                             BorderBrush="#DDD6FE"
                                                             Margin="0,0,10,0"
                                                             FontSize="11"
                                                             Foreground="#555"
                                                             Background="#FAF5FF"/>
                                                    <Button Grid.Column="1"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectWanScailVideoCommand}"
                                                           Height="35" Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding WanScailVideoInfo}"
                                                          FontStyle="Italic" Foreground="#666" FontSize="10" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Border>

                                <!-- Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="✏️ Motion Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#7C3AED"/>

                                        <TextBlock Text="Positive Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5" Foreground="#555"/>
                                        <TextBox Text="{Binding WanScailPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Height="90"
                                                 VerticalScrollBarVisibility="Auto"
                                                 BorderBrush="#DDD6FE"
                                                 Background="#FAF5FF"
                                                 FontSize="12"
                                                 Padding="8"
                                                 Margin="0,0,0,10"/>

                                        <TextBlock Text="Negative Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5" Foreground="#555"/>
                                        <TextBox Text="{Binding WanScailNegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Height="60"
                                                 VerticalScrollBarVisibility="Auto"
                                                 BorderBrush="#DDD6FE"
                                                 Background="#FAF5FF"
                                                 FontSize="11"
                                                 Padding="8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Settings + Generate Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Settings -->
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="⚙️ Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#7C3AED"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Frame Rate (FPS)" FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding WanScailFps, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="#DDD6FE" Background="#FAF5FF" FontSize="12"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Max Edge (px)" FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding WanScailMaxEdge, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="#DDD6FE" Background="#FAF5FF" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="Seed (-1 = random)" FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding WanScailSeed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="#DDD6FE" Background="#FAF5FF" FontSize="12"
                                                             Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1"
                                                            Content="🎲 Random"
                                                            Command="{Binding RandomWanScailSeedCommand}"
                                                            Height="30" Padding="10,0" FontSize="11"
                                                            Background="#EDE9FE" Foreground="#7C3AED"
                                                            BorderBrush="#DDD6FE" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Chunk info -->
                                            <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1"
                                                    CornerRadius="5" Padding="10" Margin="0,12,0,0">
                                                <TextBlock FontSize="11" Foreground="#7C3AED" TextWrapping="Wrap">
                                                    <Run Text="121-frame windows · Chunk size: 121 frames"/>
                                                    <LineBreak/>
                                                    <Run Text="Chunks: "/>
                                                    <Run Text="{Binding WanScailTotalChunks, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text=" (from "/>
                                                    <Run Text="{Binding WanScailTotalFrames, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text=" frames)"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- Right: Generate + Status -->
                                        <StackPanel Grid.Column="1" Width="220" VerticalAlignment="Top">
                                            <TextBlock Text="🚀 Generate" Style="{StaticResource HeaderTextStyle}" Foreground="#7C3AED"/>

                                            <Button Content="⚡ Add to Queue"
                                                    Command="{Binding GenerateWanScailVideoCommand}"
                                                    IsEnabled="{Binding WanScailCanAddToQueue}"
                                                    Height="42" FontSize="14" FontWeight="Bold"
                                                    Background="#7C3AED" Foreground="White"
                                                    BorderThickness="0"
                                                    Margin="0,0,0,10"/>

                                            <!-- Processing status -->
                                            <Border Background="#F5F3FF"
                                                    BorderBrush="#DDD6FE"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="12"
                                                    Visibility="{Binding WanScailIsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding WanScailProcessingStatus}"
                                                              FontWeight="SemiBold" FontSize="11"
                                                              Margin="0,0,0,5"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap"
                                                              Foreground="#7C3AED"/>
                                                    <ProgressBar Value="{Binding WanScailProcessingProgress, Mode=OneWay}"
                                                                Height="16"
                                                                Foreground="#7C3AED"
                                                                Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding WanScailProgressPercentage}"
                                                              HorizontalAlignment="Center"
                                                              FontSize="11" FontWeight="Bold"
                                                              Foreground="#7C3AED"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Queue Panel -->
                                <Border Style="{StaticResource SectionPanelStyle}"
                                        Visibility="{Binding WanScailHasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚡ WAN SCAIL Queue" Style="{StaticResource HeaderTextStyle}" Foreground="#7C3AED" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding WanScailQueueStatus}"
                                                      FontStyle="Italic" Foreground="#666" FontSize="11"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2"
                                                   Content="🔄 Retry"
                                                   Command="{Binding ReprocessAllWanScailFailedCommand}"
                                                   IsEnabled="{Binding WanScailHasFailedItems}"
                                                   Height="28" Width="70" FontSize="11"
                                                   Margin="0,0,5,0"
                                                   Background="#7C3AED" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>
                                            <Button Grid.Column="3"
                                                   Content="⏹ Stop"
                                                   Command="{Binding StopWanScailQueueCommand}"
                                                   IsEnabled="{Binding WanScailIsProcessingQueue}"
                                                   Height="28" Width="65" FontSize="11"
                                                   Margin="0,0,5,0"
                                                   Background="#A78BFA" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>
                                            <Button Grid.Column="4"
                                                   Content="🗑️ Clear"
                                                   Command="{Binding ClearWanScailQueueCommand}"
                                                   Height="28" Width="65" FontSize="11"
                                                   Background="#DC3545" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding WanScailQueue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4"
                                                            Padding="10,6" Margin="0,0,0,4" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding Prompt}" FontSize="10" Foreground="#666"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <Button Grid.Column="2"
                                                                    Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveWanScailQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="28" Height="28"
                                                                    Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Result Video Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#7C3AED"/>

                                        <Border BorderBrush="#DDD6FE" BorderThickness="2"
                                                Background="White" Height="250"
                                                CornerRadius="5" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999"
                                                          FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWanScailResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <MediaElement x:Name="WanScailVideoPlayer2"
                                                            Source="{Binding WanScailResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasWanScailResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                   Content="▶ Play"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding PlayWanScailVideoCommand}"
                                                   IsEnabled="{Binding HasWanScailResult}"
                                                   Margin="0,0,8,0"/>
                                            <Button Grid.Column="1"
                                                   Content="📁 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenWanScailResultFolderCommand}"
                                                   IsEnabled="{Binding HasWanScailResult}"
                                                   Margin="0,0,8,0"/>
                                            <Button Grid.Column="2"
                                                   Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendWanScailToEditCameraCommand}"
                                                   IsEnabled="{Binding HasWanScailResult}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding WanScailResultVideoInfo}"
                                                  FontStyle="Italic" Foreground="#666" FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Log -->
                                <Expander Header="📝 Processing Log"
                                         IsExpanded="False"
                                         Margin="0,0,0,0">
                                    <Border Background="White"
                                            BorderBrush="#DDD6FE"
                                            BorderThickness="1"
                                            Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding WanScailLogOutput, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    IsReadOnly="True"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10"/>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
