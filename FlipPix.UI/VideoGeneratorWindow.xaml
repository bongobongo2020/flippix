<Window x:Class="FlipPix.UI.VideoGeneratorWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:FlipPix.UI.Converters"
        xmlns:ctrl="clr-namespace:FlipPix.UI.Controls"
        mc:Ignorable="d"
        Title="FlipPix - Video Generator" Height="750" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="650" MinWidth="850"
        ResizeMode="CanResize">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource BrandColor}"/>
            </Border.Background>
            <StackPanel Margin="20,8" Orientation="Horizontal">
                <TextBlock Text="🎬 Video Generator"
                          FontSize="18" FontWeight="Bold"
                          Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="Generate videos from images using AI — upload an image and describe the motion"
                          FontSize="11" Foreground="#FFFAF0"
                          VerticalAlignment="Center" Margin="14,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="#E9ECEF" BorderBrush="#DEE2E6" BorderThickness="0,1,0,1" Padding="15,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Navigate:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#495057"/>
                <Button Content="Image Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToImageGeneratorCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="2" Margin="15,10,15,10">

                    <!-- Tab 1: FFLF -->
                    <TabItem Header="🎬 FFLF">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- Workflow Selection for Single Video -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="🎬 Workflow Selection"
                                                  FontSize="14"
                                                  FontWeight="Bold"
                                                  Foreground="#FF6B35"
                                                  Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- LTX2V Workflow Toggle -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UseLTX2V}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#28A745"/>
                                                                <Setter Property="Background" Value="#D4EDDA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding ToggleSingleWorkflowCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="🟢 LTX2V"
                                                              FontSize="13"
                                                              FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="LTXV-DoEverything-v2.json"
                                                              FontSize="10"
                                                              Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Wan 2.2 Workflow Toggle -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UseWan22}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#007BFF"/>
                                                                <Setter Property="Background" Value="#CCE5FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding ToggleSingleWorkflowCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="🔵 Wan 2.2"
                                                              FontSize="13"
                                                              FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="LF-t2v-i2v-FFLF-Main v1.1API.json"
                                                              FontSize="10"
                                                              Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Dual Frame Input & Analysis Section -->
                                <Border Style="{StaticResource SectionPanelStyle}" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: First Frame Input -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🖼️ First Frame" FontSize="13" FontWeight="Bold" Foreground="#FF6B35" Margin="0,0,0,8"/>
                                            <!-- Image Preview -->
                                            <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                    Background="White" Height="160"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="No first frame"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="#999"
                                                              FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FirstFrameImagePreview}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding FirstFrameImagePreview}" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>

                                            <!-- Browse and Analyze Buttons -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Button Grid.Row="0"
                                                       Content="📁 Browse First Frame"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Command="{Binding SelectFirstFrameImageCommand}"
                                                       Height="32"
                                                       FontSize="11"/>

                                                <Button Grid.Row="1"
                                                       Content="🧠 Analyze First Frame"
                                                       Style="{StaticResource PrimaryButtonStyle}"
                                                       Command="{Binding AnalyzeFirstFrameImageCommand}"
                                                       IsEnabled="{Binding HasFirstFrameImage}"
                                                       Height="36"
                                                       Margin="0,5,0,0"
                                                       FontSize="11"/>
                                            </Grid>

                                            <!-- Image Info -->
                                            <TextBlock Text="{Binding FirstFrameImageInfo}"
                                                      FontStyle="Italic"
                                                      Foreground="#666"
                                                      FontSize="9"
                                                      Margin="0,5,0,0"
                                                      TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Middle Column: Last Frame Input -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="🖼️ Last Frame" FontSize="13" FontWeight="Bold" Foreground="#FF6B35" Margin="0,0,0,8"/>
                                            <!-- Image Preview -->
                                            <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                    Background="White" Height="160"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="No last frame"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="#999"
                                                              FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LastFrameImagePreview}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding LastFrameImagePreview}" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>

                                            <!-- Browse Button -->
                                            <Button Content="📁 Browse Last Frame"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SelectLastFrameImageCommand}"
                                                   Height="32"
                                                   Margin="0,8,0,0"
                                                   FontSize="11"/>

                                            <!-- Image Info -->
                                            <TextBlock Text="{Binding LastFrameImageInfo}"
                                                      FontStyle="Italic"
                                                      Foreground="#666"
                                                      FontSize="9"
                                                      Margin="0,5,0,0"
                                                      TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Right Column: Analysis Result -->
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <!-- Header with Settings and Copy -->
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="🔍 Image Analysis"
                                                          FontSize="14" FontWeight="Bold"
                                                          Foreground="#FF6B35"
                                                          VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="📋"
                                                           Style="{StaticResource NavButtonStyle}"
                                                           Command="{Binding CopyAnalysisCommand}"
                                                           ToolTip="Copy to Clipboard"
                                                           Width="32" Height="28"
                                                           Padding="0" Margin="0,0,5,0"
                                                           IsEnabled="{Binding HasAnalysis}"/>
                                                    <Button Content="⚙️"
                                                           Style="{StaticResource NavButtonStyle}"
                                                           Command="{Binding OpenLMStudioSettingsCommand}"
                                                           ToolTip="LM Studio Settings"
                                                           Width="32" Height="28"
                                                           Padding="0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Analysis Result TextBox -->
                                            <TextBox Text="{Binding ImageAnalysis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap"
                                                    AcceptsReturn="True"
                                                    Height="180"
                                                    Padding="10"
                                                    VerticalScrollBarVisibility="Auto"
                                                    Background="White"
                                                    BorderBrush="#CED4DA"
                                                    FontSize="11"
                                                    IsReadOnly="{Binding IsAnalyzing}"/>

                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0"
                                                    BorderBrush="#FFE0B0"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8"
                                                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AnalysisStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="10"
                                                              TextAlignment="Center"/>
                                                    <ProgressBar Value="{Binding AnalysisProgress}"
                                                                Height="12" Margin="0,4,0,0"
                                                                Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Send to Queue Button -->
                                            <Button Content="📤 Send to Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding SendAnalysisToQueueCommand}"
                                                   IsEnabled="{Binding HasAnalysis}"
                                                   Height="38"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Stretch"/>

                                            <!-- Collapsible Video Settings -->
                                            <Expander Margin="0,15,0,0" IsExpanded="False">
                                                <Expander.Header>
                                                    <TextBlock Text="⚙️ Video Settings" FontSize="12" FontWeight="Bold" Foreground="#FF6B35"/>
                                                </Expander.Header>
                                                <StackPanel Margin="0,10,0,0">
                                                    <!-- Video Length -->
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock Text="Video Length (frames)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider Grid.Column="0"
                                                                    Value="{Binding VideoLength, Mode=TwoWay}"
                                                                    Minimum="21" Maximum="240"
                                                                    TickFrequency="20"
                                                                    IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1"
                                                                      Text="{Binding VideoLength}"
                                                                      Margin="8,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      MinWidth="35"
                                                                      FontWeight="Bold"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding VideoLengthSeconds}"
                                                                  FontSize="10"
                                                                  Foreground="#999"
                                                                  Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <!-- FPS -->
                                                    <StackPanel>
                                                        <TextBlock Text="FPS (Frames Per Second)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider Grid.Column="0"
                                                                    Value="{Binding Fps, Mode=TwoWay}"
                                                                    Minimum="8" Maximum="30"
                                                                    TickFrequency="2"
                                                                    IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1"
                                                                      Text="{Binding Fps}"
                                                                      Margin="8,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      MinWidth="25"
                                                                      FontWeight="Bold"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Generate Video Button -->
                                            <Button Content="🎬 Generate Video"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding GenerateVideoCommand}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="45"
                                                   FontSize="13"
                                                   Margin="0,10,0,0"/>

                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0"
                                                    BorderBrush="#FFE0B0"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8"
                                                    Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ProcessingStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="10"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap"
                                                              Margin="0,0,0,5"/>
                                                    <ProgressBar Value="{Binding ProcessingProgress}"
                                                                Height="14"
                                                                Foreground="#FF6B35"
                                                                Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding ProgressPercentage}"
                                                              HorizontalAlignment="Center"
                                                              FontSize="10"
                                                              FontWeight="Bold"
                                                              Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

  
                <!-- Prompt Queue Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="📝 Prompt Queue" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding NewQueuePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"
                                     Background="White"
                                     BorderBrush="#CED4DA"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                   Content="➕ Add to Queue"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding AddToQueueCommand}"
                                   Height="35"
                                   Width="120"
                                   Margin="0,0,5,0"/>

                            <Button Grid.Column="2"
                                   Content="▶️ Process Queue"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Command="{Binding ProcessQueueCommand}"
                                   IsEnabled="{Binding CanProcessQueue}"
                                   Height="35"
                                   Width="120"
                                   Margin="0,0,5,0"/>

                            <Button Grid.Column="3"
                                   Content="🔄 Reprocess Failed"
                                   Command="{Binding ReprocessAllFailedCommand}"
                                   IsEnabled="{Binding HasFailedItems}"
                                   Height="35"
                                   Width="140"
                                   Margin="0,0,5,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Background" Value="#FFA500"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF8C00"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCC"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="4"
                                   Content="⏹ Stop"
                                   Command="{Binding StopQueueCommand}"
                                   IsEnabled="{Binding IsProcessingQueue}"
                                   Height="35"
                                   Width="80"
                                   Margin="0,0,5,0"
                                   Background="#F59E0B" Foreground="White"
                                   BorderThickness="0" FontWeight="SemiBold"/>

                            <Button Grid.Column="5"
                                   Content="🗑️ Clear"
                                   Command="{Binding ClearQueueCommand}"
                                   Height="35"
                                   Width="80">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                        <Setter Property="Background" Value="#DC3545"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#C82333"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Pause/Resume Controls (Video Queue) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                    Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="⏸ Pause" Width="100" Height="32" Margin="0,0,8,0"
                                    Command="{Binding PauseQueueCommand}"
                                    Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                            <Button Content="▶ Resume" Width="100" Height="32" Margin="0,0,8,0"
                                    Command="{Binding ResumeQueueCommand}"
                                    Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="Queue Items:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>

                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                                <ItemsControl ItemsSource="{Binding PromptQueue}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                             Text="{Binding DisplayText}"
                                                             TextWrapping="Wrap"
                                                             FontSize="11"
                                                             VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                             Text="{Binding StatusDisplay}"
                                                             FontSize="10"
                                                             FontWeight="SemiBold"
                                                             Foreground="{Binding StatusColor}"
                                                             VerticalAlignment="Center"
                                                             Margin="10,0,10,0"/>

                                                    <!-- Reprocess button - only visible for failed items -->
                                                    <Button Grid.Column="2"
                                                           Content="🔄"
                                                           Command="{Binding DataContext.ReprocessItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Padding="5,2"
                                                           FontSize="11"
                                                           ToolTip="Reprocess this item"
                                                           Margin="0,0,5,0"
                                                           Width="30">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                                                <Setter Property="Background" Value="#FFA500"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#FF8C00"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button Grid.Column="3"
                                                           Content="❌"
                                                           Style="{StaticResource NavButtonStyle}"
                                                           Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Padding="5,2"
                                                           FontSize="10"
                                                           ToolTip="Remove from queue"
                                                           Width="30"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="{Binding QueueStatus}"
                                  FontSize="11"
                                  Foreground="#666"
                                  FontStyle="Italic"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Result Video Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                        <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                Background="White" Height="250"
                                CornerRadius="5" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="Video will appear here after generation"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="#999"
                                          FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasResultVideo}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Video Player -->
                                <MediaElement x:Name="VideoPlayer"
                                            Source="{Binding ResultVideoPath}"
                                            LoadedBehavior="Manual"
                                            UnloadedBehavior="Stop"
                                            Stretch="Uniform"
                                            Visibility="{Binding HasResultVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                   Content="▶️ Play"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding PlayVideoCommand}"
                                   IsEnabled="{Binding HasResultVideo}"
                                   Margin="0,0,8,0"/>

                            <Button Grid.Column="1"
                                   Content="📂 Open Folder"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding OpenResultFolderCommand}"
                                   IsEnabled="{Binding HasResultVideo}"
                                   Margin="0,0,8,0"/>

                            <Button Grid.Column="2"
                                   Content="📷 Send to Edit Camera"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding SendToEditCameraCommand}"
                                   IsEnabled="{Binding HasResultVideo}"/>
                        </Grid>

                        <TextBlock Text="{Binding VideoInfo}"
                                  FontStyle="Italic"
                                  Foreground="#666"
                                  FontSize="11"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Advanced Settings (Collapsible) -->
                <Expander Header="⚙️ Advanced Settings"
                         Margin="0,0,0,15"
                         IsExpanded="False">
                    <Border Background="#F8F9FA"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Steps -->
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Steps, Mode=TwoWay}"
                                                Minimum="1" Maximum="10"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Steps}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- CFG -->
                                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                    <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Cfg, Mode=TwoWay}"
                                                Minimum="1" Maximum="5"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Cfg, StringFormat={}{0:F1}}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Seed -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Seed (0 = Random)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding Seed, Mode=TwoWay}"
                                            Padding="8"
                                            Background="White"
                                            BorderBrush="#CED4DA"
                                            FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <!-- Negative Prompt -->
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="Negative Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        Height="60"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Log (Collapsible) - shared reusable panel -->
                <ctrl:ProcessingLogPanel LogText="{Binding LogOutput}" IsLogExpanded="True"/>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Story Video Generator -->
                    <TabItem Header="📖 Story Video Generator">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Workflow Selection -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="LTX Workflow"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox SelectedIndex="{Binding SelectedStoryWorkflowIndex, Mode=TwoWay}"
                                                  Height="32"
                                                  FontSize="13">
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🟢 Vantage Sulphur 2" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Vantage-Sulphur-2-WorkflowAPI.json" Foreground="#6C757D" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🟠 10Eros InstantAction" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="10Eros_10SNodes_InstantAction_I2VAPI.json" Foreground="#6C757D" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔵 LTX-22-B" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="LTX-22-B.json" Foreground="#6C757D" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🟣 DaSiWa WAN 2.2" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="DasiwaWan22WorkflowsI2VSVI2_fastfidelityCAioV83API.json" Foreground="#6C757D" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔴 WAN 2.2 FunCamera I2V" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="WAN22-I2V-API.json" Foreground="#6C757D" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Story Setup Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📁 Story Setup" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Prompt JSON File Selection -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="1. Select prompts file (.json or .txt) — or select the images folder below to auto-detect"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📄 Select Prompts File"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SelectStoryPromptJsonCommand}"
                                                   Height="35"
                                                   Width="160"/>
                                        </Grid>

                                        <TextBox Text="{Binding StoryPromptJsonPath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="11"
                                                Margin="0,0,0,15"
                                                VerticalAlignment="Center"/>

                                        <!-- Images Folder Selection -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="2. Select the folder containing the 10 generated story images"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Select Images Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SelectStoryImagesFolderCommand}"
                                                   Height="35"
                                                   Width="170"/>
                                        </Grid>

                                        <TextBox Text="{Binding StoryImagesFolderPath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="11"
                                                Margin="0,0,0,10"
                                                VerticalAlignment="Center"/>

                                        <!-- Load Queue Button -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="3. Load the queue with images and prompts"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📥 Load Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding LoadStoryQueueCommand}"
                                                   IsEnabled="{Binding CanLoadStoryQueue}"
                                                   Height="35"
                                                   Width="140"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Story Queue Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎞️ Story Video Queue" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Queue Controls -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="{Binding StoryQueueStatus}"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Foreground="#666"/>

                                            <Button Grid.Column="1"
                                                   Content="▶️ Process Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding ProcessStoryQueueCommand}"
                                                   IsEnabled="{Binding CanProcessStoryQueue}"
                                                   Height="35"
                                                   Width="140"
                                                   Margin="0,0,5,0"/>

                                            <Button Grid.Column="2"
                                                   Content="🔄 Retry Failed"
                                                   Command="{Binding ReprocessAllStoryFailedCommand}"
                                                   IsEnabled="{Binding HasStoryFailedItems}"
                                                   Height="35"
                                                   Width="110"
                                                   Margin="0,0,5,0"
                                                   Background="#FFA500" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>

                                            <Button Grid.Column="3"
                                                   Content="⏹ Stop"
                                                   Command="{Binding StopStoryQueueCommand}"
                                                   IsEnabled="{Binding IsProcessingStoryQueue}"
                                                   Height="35"
                                                   Width="80"
                                                   Margin="0,0,5,0"
                                                   Background="#F59E0B" Foreground="White"
                                                   BorderThickness="0" FontWeight="SemiBold"/>

                                            <Button Grid.Column="4"
                                                   Content="🗑️ Clear Queue"
                                                   Command="{Binding ClearStoryQueueCommand}"
                                                   Height="35"
                                                   Width="110">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                                        <Setter Property="Background" Value="#DC3545"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#C82333"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- Pause/Resume Controls (Story Video Queue) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                                    Visibility="{Binding IsProcessingStoryQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Content="⏸ Pause" Width="100" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding PauseStoryQueueCommand}"
                                                    Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                                            <Button Content="▶ Resume" Width="100" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding ResumeStoryQueueCommand}"
                                                    Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Progress Display -->
                                        <Border Background="#FFF9F0"
                                                BorderBrush="#FFE0B0"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="12"
                                                Visibility="{Binding IsProcessingStoryQueue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                              Text="{Binding StoryQueueStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,5"
                                                              VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding StoryQueueProgressText}"
                                                              FontWeight="Bold"
                                                              FontSize="12"
                                                              Foreground="#FF6B35"
                                                              VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Current Item Info -->
                                                <TextBlock Text="Current:"
                                                          FontSize="10"
                                                          FontWeight="SemiBold"
                                                          Margin="0,5,0,3"/>

                                                <TextBlock Text="{Binding CurrentStoryQueueItem.Index, StringFormat='Prompt #{0}'}"
                                                          FontSize="11"
                                                          Margin="10,0,0,0"/>

                                                <ProgressBar Value="{Binding CurrentStoryQueueItem.Progress}"
                                                            Height="16"
                                                            Foreground="#FF6B35"
                                                            Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Storyboard hint -->
                                        <TextBlock Text="Click a clip to play it. Edit the prompt below, then click Regenerate to redo that clip."
                                                   FontSize="11"
                                                   Foreground="#9CA3AF"
                                                   Margin="0,0,0,12"/>

                                        <!-- Storyboard cards -->
                                        <ItemsControl ItemsSource="{Binding StoryVideoQueue}"
                                                      x:Name="StoryVideoStoryboardControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="240"
                                                            Margin="6,6"
                                                            Background="#F9FAFB"
                                                            BorderBrush="#E5E7EB"
                                                            BorderThickness="1"
                                                            CornerRadius="12">
                                                        <StackPanel Margin="12">

                                                            <!-- Clip label + delete button + status badge -->
                                                            <Grid Margin="0,0,0,8">
                                                                <TextBlock Text="{Binding Index, StringFormat='Clip #{0}'}"
                                                                           FontWeight="Bold"
                                                                           FontSize="13"
                                                                           Foreground="#FF6B35"
                                                                           VerticalAlignment="Center"/>
                                                                <!-- Delete X button -->
                                                                <Button HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,-6,-6,0"
                                                                        Width="18" Height="18"
                                                                        Padding="0"
                                                                        Background="#E5E7EB"
                                                                        BorderThickness="0"
                                                                        FontSize="9"
                                                                        FontWeight="Bold"
                                                                        Foreground="#6B7280"
                                                                        Content="✕"
                                                                        ToolTip="Delete clip"
                                                                        Command="{Binding DataContext.DeleteStoryItemCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}"
                                                                                                CornerRadius="9"
                                                                                                Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#EF4444"/>
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <!-- Status badge -->
                                                                <Border HorizontalAlignment="Right"
                                                                        CornerRadius="8"
                                                                        Padding="7,2"
                                                                        Margin="0,0,24,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#F3F4F6"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Background" Value="#EDE9FE"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding Status}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                        <Setter Property="Foreground" Value="#059669"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                        <Setter Property="Foreground" Value="#7C3AED"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Video thumbnail area (click to play) -->
                                                            <Border Height="155"
                                                                    Background="#F3F4F6"
                                                                    BorderBrush="#E5E7EB"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    ClipToBounds="True"
                                                                    Margin="0,0,0,10"
                                                                    Cursor="Hand">
                                                                <Border.InputBindings>
                                                                    <MouseBinding Command="{Binding OpenImageCommand}" MouseAction="LeftClick"/>
                                                                </Border.InputBindings>
                                                                <Grid>
                                                                    <!-- Extracted first-frame thumbnail -->
                                                                    <Image Source="{Binding VideoThumbnailImage}"
                                                                           Stretch="UniformToFill"
                                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasVideoThumbnail}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                    <!-- Play button overlay on thumbnail -->
                                                                    <Border Background="#55000000">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasVideoThumbnail}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="▶"
                                                                                   FontSize="36"
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <!-- Icon/status fallback when no thumbnail yet -->
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasVideoThumbnail}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <!-- Icon changes by status -->
                                                                        <TextBlock HorizontalAlignment="Center" FontSize="40">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="🎬"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                            <Setter Property="Text" Value="⚙️"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                            <Setter Property="Text" Value="▶"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                            <Setter Property="Text" Value="❌"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock FontSize="11"
                                                                                   Foreground="#9CA3AF"
                                                                                   HorizontalAlignment="Center"
                                                                                   Margin="0,4,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{Binding Status}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                            <Setter Property="Text" Value="Click to play"/>
                                                                                            <Setter Property="Foreground" Value="#059669"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <!-- Progress bar while processing -->
                                                                        <ProgressBar Value="{Binding Progress}"
                                                                                     Maximum="100"
                                                                                     Height="4"
                                                                                     Width="120"
                                                                                     Margin="0,6,0,0"
                                                                                     Foreground="#FF6B35"
                                                                                     Background="#E5E7EB"
                                                                                     BorderThickness="0">
                                                                            <ProgressBar.Style>
                                                                                <Style TargetType="ProgressBar">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ProgressBar.Style>
                                                                        </ProgressBar>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Editable prompt -->
                                                            <TextBox Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextWrapping="Wrap"
                                                                     AcceptsReturn="False"
                                                                     Height="80"
                                                                     Padding="8"
                                                                     VerticalScrollBarVisibility="Auto"
                                                                     Background="White"
                                                                     BorderBrush="#D1D5DB"
                                                                     FontSize="11"
                                                                     VerticalContentAlignment="Top"
                                                                     Margin="0,0,0,8"
                                                                     ToolTip="Edit this prompt and click Regenerate">
                                                                <TextBox.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="6"/>
                                                                    </Style>
                                                                </TextBox.Resources>
                                                            </TextBox>

                                                            <!-- Regenerate button -->
                                                            <Button Content="🔄 Regenerate"
                                                                    Command="{Binding DataContext.RegenerateStoryItemCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalAlignment="Stretch"
                                                                    Height="32"
                                                                    Foreground="White"
                                                                    BorderThickness="0"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="#FF6B35"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}"
                                                                                            CornerRadius="6"
                                                                                            Padding="{TemplateBinding Padding}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#E55A25"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                <Setter Property="Background" Value="#CBD5E1"/>
                                                                                <Setter Property="Foreground" Value="#475569"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>

                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>

                                <!-- Join Clips Section -->
                                <Border Background="White"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,12,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StoryVideoQueue.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="🔗 Join All Clips"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="Concatenate all completed clips with FFmpeg and save to your Videos folder."
                                                       FontSize="11"
                                                       Foreground="#6B7280"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="🔗 Join Clips"
                                                Command="{Binding JoinClipsCommand}"
                                                Height="40"
                                                Padding="20,0"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#059669"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="8"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#047857"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#CBD5E1"/>
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                    </Grid>
                                </Border>

                                <!-- Story Log (Collapsible) - shared panel -->
                                <ctrl:ProcessingLogPanel LogText="{Binding LogOutput}" IsLogExpanded="True"/>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 5: Single Video -->
                    <TabItem Header="🎬 Single Video">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Workflow Selector -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,5">
                                    <StackPanel>
                                        <TextBlock Text="🔧 Workflow" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                        <ComboBox SelectedIndex="{Binding SingleVideoWorkflowIndex, Mode=TwoWay}"
                                                  Height="32" Margin="0,6,0,0"
                                                  FontSize="13">
                                            <ComboBoxItem Content="🎬 LTX 2.3"/>
                                            <ComboBoxItem Content="🎨 Wan 2.2 Remix"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- LTX 2.3 Content -->
                                <StackPanel Visibility="{Binding SingleVideoIsLTX23, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <!-- Reference Image Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🖼️ Reference Image" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Column: Image Preview -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Source Image:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                    <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                            Background="White" Height="200"
                                                            CornerRadius="3">
                                                        <Grid>
                                                            <TextBlock Text="No image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding LTX23ImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding LTX23ImagePreview}" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Browse..."
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding SelectLTX23ImageCommand}"
                                                            Height="32"
                                                            HorizontalAlignment="Stretch"
                                                            Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding LTX23ImageInfo}"
                                                              FontStyle="Italic"
                                                              Foreground="#666"
                                                              FontSize="10"
                                                              Margin="0,6,0,0"
                                                              TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Right Column: Analyze Button + Result -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Image Analysis:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                    <Button Content="🧠 Analyze &amp; Generate"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding AnalyzeLTX23ImageCommand}"
                                                            IsEnabled="{Binding CanLTX23AnalyzeImage, Mode=OneWay}"
                                                            Height="32"
                                                            HorizontalAlignment="Stretch"/>
                                                    <TextBox Text="{Binding LTX23AnalysisResult, Mode=OneWay}"
                                                            TextWrapping="Wrap"
                                                            AcceptsReturn="True"
                                                            Height="188"
                                                            Padding="10"
                                                            VerticalScrollBarVisibility="Auto"
                                                            Background="#F8F9FA"
                                                            BorderBrush="#CED4DA"
                                                            FontSize="11"
                                                            IsReadOnly="True"
                                                            Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Video Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📝 Video Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <TextBlock Text="Describe the video action you want to generate:"
                                                  FontWeight="SemiBold" FontSize="12"
                                                  Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding LTX23Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="120"
                                                Padding="12"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="12"/>

                                        <!-- Frame Count -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Frames:"
                                                      FontWeight="SemiBold" FontSize="12"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Slider Grid.Column="1"
                                                   Minimum="49" Maximum="481"
                                                   SmallChange="24" LargeChange="48"
                                                   Value="{Binding LTX23FrameCount, Mode=TwoWay}"
                                                   VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2"
                                                    Text="{Binding LTX23FrameCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="48" Height="28"
                                                    TextAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    FontSize="12" Margin="8,0,0,0"
                                                    BorderBrush="#CED4DA"/>
                                        </Grid>
                                        <TextBlock Text="{Binding LTX23FrameCountHint}"
                                                  FontSize="10" Foreground="#888"
                                                  Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Processing Status + Queue Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <!-- Processing Status -->
                                        <Border Background="#FFF9F0"
                                                BorderBrush="#FFE0B0"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="12"
                                                Visibility="{Binding IsProcessingLTX23, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LTX23ProcessingStatus}"
                                                          FontWeight="SemiBold" FontSize="11"
                                                          TextAlignment="Center" TextWrapping="Wrap"/>
                                                <ProgressBar Value="{Binding LTX23ProcessingProgress, Mode=OneWay}"
                                                            Height="14" Foreground="#FF6B35"
                                                            Margin="0,6,0,4"/>
                                                <TextBlock Text="{Binding LTX23ProgressPercentage}"
                                                          HorizontalAlignment="Center"
                                                          FontSize="11" FontWeight="Bold"
                                                          Foreground="#FF6B35"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Queue List -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                CornerRadius="5" Margin="0,12,0,0"
                                                Visibility="{Binding LTX23HasQueueItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel>
                                                <Border Background="#F0F0F0" Padding="10,6" CornerRadius="5,5,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding LTX23QueueStatus}"
                                                                  FontSize="10" Foreground="#666"
                                                                  VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                               Content="⏹ Stop"
                                                               Command="{Binding StopLTX23QueueCommand}"
                                                               IsEnabled="{Binding LTX23IsProcessingQueue}"
                                                               Width="60" Height="22" FontSize="10"
                                                               Margin="4,0,4,0"
                                                               Background="#F59E0B" Foreground="White"
                                                               BorderThickness="0" Padding="4,2"/>
                                                        <Button Grid.Column="2"
                                                               Content="🔄 Retry"
                                                               Command="{Binding ReprocessLTX23FailedCommand}"
                                                               IsEnabled="{Binding LTX23HasFailedItems}"
                                                               Width="60" Height="22" FontSize="10"
                                                               Margin="0,0,4,0"
                                                               Background="#FFA500" Foreground="White"
                                                               BorderThickness="0" Padding="4,2"/>
                                                        <Button Grid.Column="3"
                                                               Content="🗑️ Clear"
                                                               Command="{Binding ClearLTX23QueueCommand}"
                                                               Width="60" Height="22" FontSize="10"
                                                               Background="#DC3545" Foreground="White"
                                                               BorderThickness="0" Padding="4,2"/>
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Padding="5">
                                                    <ItemsControl ItemsSource="{Binding LTX23Queue}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="#E9ECEF" BorderThickness="1"
                                                                        CornerRadius="4" Padding="8,6"
                                                                        Margin="2,2,2,0" Background="White">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding DisplayText}"
                                                                                      FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>

                                                                        <TextBlock Grid.Column="1"
                                                                                  Text="{Binding StatusDisplay}"
                                                                                  Foreground="{Binding StatusColor}"
                                                                                  FontSize="10" FontWeight="SemiBold"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="8,0,8,0"/>

                                                                        <Button Grid.Column="2"
                                                                               Content="✕"
                                                                               Width="22" Height="22"
                                                                               FontSize="10"
                                                                               Background="Transparent"
                                                                               BorderThickness="0"
                                                                               Foreground="#999"
                                                                               Padding="0"
                                                                               Command="{Binding DataContext.RemoveLTX23QueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                               CommandParameter="{Binding}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                        <!-- Latest Result Preview -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                Background="White" Height="220" CornerRadius="5"
                                                Margin="0,12,0,0">
                                            <Grid>
                                                <TextBlock Text="Latest generated video will appear here"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLTX23Result}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="LTX23VideoPlayer"
                                                            Source="{Binding LTX23ResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasLTX23Result, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Result Actions -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayLTX23VideoCommand}"
                                                   IsEnabled="{Binding HasLTX23Result}"
                                                   Margin="0,0,8,0"/>
                                            <Button Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenLTX23ResultFolderCommand}"
                                                   IsEnabled="{Binding HasLTX23Result}"
                                                   Margin="0,0,8,0"/>
                                            <Button Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendLTX23ToEditCameraCommand}"
                                                   IsEnabled="{Binding HasLTX23Result}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding LTX23VideoInfo}"
                                                  FontStyle="Italic" Foreground="#666"
                                                  FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Log Output - shared panel -->
                                <ctrl:ProcessingLogPanel LogText="{Binding LTX23LogOutput}" Header="📋 Generation Log"/>

                                </StackPanel>
                                <!-- End LTX 2.3 Content -->

                                <!-- Wan 2.2 Remix Content -->
                                <StackPanel Visibility="{Binding SingleVideoIsWan22, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <!-- Reference Image Section -->
                                    <Border Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Text="🖼️ Reference Image" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                            <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Image Preview -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Source Image:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" Height="200" CornerRadius="3">
                                                            <Grid>
                                                                <TextBlock Text="No image selected"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          Foreground="#999" FontStyle="Italic">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Wan22ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding Wan22ImagePreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Button Content="Browse..."
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding SelectWan22ImageCommand}"
                                                                Height="32" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                                        <TextBlock Text="{Binding Wan22ImageInfo}"
                                                                  FontStyle="Italic" Foreground="#666" FontSize="10"
                                                                  Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Right: Analyze Button + Result -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Image Analysis:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                        <Button Content="🧠 Analyze Image"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding AnalyzeWan22ImageCommand}"
                                                                IsEnabled="{Binding CanWan22AnalyzeImage, Mode=OneWay}"
                                                                Height="32" HorizontalAlignment="Stretch"/>
                                                        <TextBlock Text="Sends image to qwen-4-vl → auto-queues result"
                                                                  FontSize="10" Foreground="#888" FontStyle="Italic"
                                                                  Margin="0,4,0,4" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding Wan22AnalysisResult, Mode=OneWay}"
                                                                TextWrapping="Wrap" AcceptsReturn="True"
                                                                Height="160" Padding="10"
                                                                VerticalScrollBarVisibility="Auto"
                                                                Background="#F8F9FA" BorderBrush="#CED4DA"
                                                                FontSize="11" IsReadOnly="True" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Video Prompt Section -->
                                    <Border Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Text="📝 Video Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                            <TextBlock Text="Describe the video action (or edit the auto-generated prompt):"
                                                      FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding Wan22Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap" AcceptsReturn="True"
                                                    Height="120" Padding="12"
                                                    VerticalScrollBarVisibility="Auto"
                                                    Background="White" BorderBrush="#CED4DA" FontSize="12"/>
                                            <Button Content="➕ Add to Queue"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding GenerateWan22VideoCommand}"
                                                    IsEnabled="{Binding CanWan22AddToQueue, Mode=OneWay}"
                                                    Height="35" Width="140" HorizontalAlignment="Left"
                                                    Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Processing Status + Queue -->
                                    <Border Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0" BorderBrush="#FFE0B0" BorderThickness="1"
                                                    CornerRadius="5" Padding="12" Margin="0,0,0,10"
                                                    Visibility="{Binding IsProcessingWan22, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Wan22ProcessingStatus}"
                                                              FontWeight="SemiBold" FontSize="11"
                                                              TextAlignment="Center" TextWrapping="Wrap"/>
                                                    <ProgressBar Value="{Binding Wan22ProcessingProgress, Mode=OneWay}"
                                                                Height="14" Foreground="#FF6B35" Margin="0,6,0,4"/>
                                                    <TextBlock Text="{Binding Wan22ProgressPercentage}"
                                                              HorizontalAlignment="Center" FontSize="11"
                                                              FontWeight="Bold" Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Queue List -->
                                            <Border BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5"
                                                    Visibility="{Binding Wan22HasQueueItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <Border Background="#F0F0F0" Padding="10,6" CornerRadius="5,5,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Wan22QueueStatus}"
                                                                      FontSize="10" Foreground="#666"
                                                                      VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1"
                                                                   Content="⏹ Stop"
                                                                   Command="{Binding StopWan22QueueCommand}"
                                                                   IsEnabled="{Binding Wan22IsProcessingQueue}"
                                                                   Width="60" Height="22" FontSize="10"
                                                                   Margin="4,0,4,0"
                                                                   Background="#F59E0B" Foreground="White"
                                                                   BorderThickness="0" Padding="4,2"/>
                                                            <Button Grid.Column="2"
                                                                   Content="🔄 Retry"
                                                                   Command="{Binding ReprocessWan22FailedCommand}"
                                                                   IsEnabled="{Binding Wan22HasFailedItems}"
                                                                   Width="60" Height="22" FontSize="10"
                                                                   Margin="0,0,4,0"
                                                                   Background="#FFA500" Foreground="White"
                                                                   BorderThickness="0" Padding="4,2"/>
                                                            <Button Grid.Column="3"
                                                                   Content="🗑️ Clear"
                                                                   Command="{Binding ClearWan22QueueCommand}"
                                                                   Width="60" Height="22" FontSize="10"
                                                                   Background="#DC3545" Foreground="White"
                                                                   BorderThickness="0" Padding="4,2"/>
                                                        </Grid>
                                                    </Border>
                                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Padding="5">
                                                        <ItemsControl ItemsSource="{Binding Wan22Queue}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#E9ECEF" BorderThickness="1"
                                                                            CornerRadius="4" Padding="8,6"
                                                                            Margin="2,2,2,0" Background="White">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayText}"
                                                                                      FontSize="11" TextTrimming="CharacterEllipsis"
                                                                                      VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                      Text="{Binding StatusDisplay}"
                                                                                      Foreground="{Binding StatusColor}"
                                                                                      FontSize="10" FontWeight="SemiBold"
                                                                                      VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                                            <Button Grid.Column="2" Content="✕"
                                                                                   Width="22" Height="22" FontSize="10"
                                                                                   Background="Transparent" BorderThickness="0"
                                                                                   Foreground="#999" Padding="0"
                                                                                   Command="{Binding DataContext.RemoveWan22QueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                   CommandParameter="{Binding}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>

                                            <!-- Video Output Preview -->
                                            <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                    Background="White" Height="220" CornerRadius="5" Margin="0,12,0,0">
                                                <Grid>
                                                    <TextBlock Text="Latest generated video will appear here"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Foreground="#999" FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasWan22Result}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <MediaElement Source="{Binding Wan22ResultPath}"
                                                                LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                Stretch="Uniform"
                                                                Visibility="{Binding HasWan22Result, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Result Actions -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="▶️ Play"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Command="{Binding PlayWan22VideoCommand}"
                                                       IsEnabled="{Binding HasWan22Result}" Margin="0,0,8,0"/>
                                                <Button Content="📂 Open Folder"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Command="{Binding OpenWan22ResultFolderCommand}"
                                                       IsEnabled="{Binding HasWan22Result}" Margin="0,0,8,0"/>
                                                <Button Content="📷 Send to Edit Camera"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Command="{Binding SendWan22ToEditCameraCommand}"
                                                       IsEnabled="{Binding HasWan22Result}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Wan22VideoInfo}"
                                                      FontStyle="Italic" Foreground="#666"
                                                      FontSize="10" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Log Output - shared panel -->
                                    <ctrl:ProcessingLogPanel LogText="{Binding Wan22LogOutput}" Header="📋 Generation Log"/>

                                </StackPanel>
                                <!-- End Wan 2.2 Remix Content -->

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 6: Infinite Talk Video Generator -->
                    <TabItem Header="🎤 Infinite Talk">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Infinite Talk Setup Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎬 Infinite Talk Video Inputs" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <!-- Image Input -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Source Image:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            BorderBrush="#DEE2E6" BorderThickness="1"
                                                            Background="White" Height="80"
                                                            CornerRadius="3" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="No image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding InfiniteTalkImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding InfiniteTalkImagePreview}"
                                                                   Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectInfiniteTalkImageCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding InfiniteTalkImageInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                                <Button Content="Analyze Image"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding AnalyzeInfiniteTalkImageCommand}"
                                                        IsEnabled="{Binding CanInfiniteTalkAnalyzeImage, Mode=OneWay}"
                                                        Height="35"
                                                        Width="150"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"/>
                                                <TextBlock Text="Image Analysis Result:" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,5"/>
                                                <TextBox Text="{Binding InfiniteTalkAnalysisResult, Mode=OneWay}"
                                                        TextWrapping="Wrap"
                                                        AcceptsReturn="True"
                                                        Height="120"
                                                        Padding="12"
                                                        VerticalScrollBarVisibility="Auto"
                                                        Background="#F8F9FA"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="11"
                                                        IsReadOnly="True"
                                                        Visibility="{Binding HasInfiniteTalkAnalysis, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Audio Input -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Audio File:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding InfiniteTalkAudioPath, Mode=TwoWay}"
                                                            IsReadOnly="True"
                                                            Padding="10"
                                                            Background="White"
                                                            BorderBrush="#CED4DA"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"/>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectInfiniteTalkAudioCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding InfiniteTalkAudioInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📝 Video Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Button Content="Enhance Prompt"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding EnhanceInfiniteTalkPromptCommand}"
                                                IsEnabled="{Binding CanInfiniteTalkEnhancePrompt, Mode=OneWay}"
                                                Height="35"
                                                Width="160"
                                                HorizontalAlignment="Left"
                                                Margin="0,5,0,10"/>

                                        <StackPanel Visibility="{Binding ShowInfiniteTalkVideoPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Describe the video action you want to generate:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                                            <TextBox Text="{Binding InfiniteTalkPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap"
                                                    AcceptsReturn="True"
                                                    Height="100"
                                                    Padding="12"
                                                    VerticalScrollBarVisibility="Auto"
                                                    Background="White"
                                                    BorderBrush="#CED4DA"
                                                    FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Settings Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Video Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Width:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding InfiniteTalkWidth, Mode=TwoWay}"
                                                        Padding="8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="Height:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding InfiniteTalkHeight, Mode=TwoWay}"
                                                        Padding="8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="12"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="ℹ️ InfiniteTalk mode processes the entire audio using 81-frame windows internally"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Generate Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Instructions -->
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="ℹ️ Wan2.1 InfiniteTalk Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                            <TextBlock Text="Generate talking head videos synchronized to audio using Wan2.1 InfiniteTalk model. The system automatically calculates the number of frames needed based on the audio duration. The InfiniteTalk mode processes the video using 81-frame windows internally." FontSize="11" TextWrapping="Wrap" Foreground="#666" Margin="0,5,0,10"/>
                                            <TextBlock Text="Total Frames:" FontWeight="Bold" FontSize="11" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding InfiniteTalkTotalFrames}" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                                            <TextBlock Text="Estimated Duration:" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding InfiniteTalkEstimatedDuration}" FontSize="11" Foreground="#666"/>
                                        </StackPanel>

                                        <!-- Generate Button and Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="🎤 Generate Video"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding GenerateInfiniteTalkVideoCommand}"
                                                   IsEnabled="{Binding CanGenerateInfiniteTalkVideo, Mode=OneWay}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="55"
                                                   FontSize="15"
                                                   Margin="0,0,0,15"/>

                                            <!-- Processing Status -->
                                            <Border Background="#FFF9F0"
                                                    BorderBrush="#FFE0B0"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="12"
                                                    Visibility="{Binding IsProcessingInfiniteTalk, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding InfiniteTalkProcessingStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,5"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap"/>
                                                    <ProgressBar Value="{Binding InfiniteTalkProcessingProgress, Mode=OneWay}"
                                                                Height="16"
                                                                Foreground="#FF6B35"
                                                                Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding InfiniteTalkProgressPercentage}"
                                                              HorizontalAlignment="Center"
                                                              FontSize="11"
                                                              FontWeight="Bold"
                                                              Foreground="#FF6B35"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Infinite Talk Result Video Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                Background="White" Height="250"
                                                CornerRadius="5" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999"
                                                          FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasInfiniteTalkResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Video Player -->
                                                <MediaElement x:Name="InfiniteTalkVideoPlayer"
                                                            Source="{Binding InfiniteTalkResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasInfiniteTalkResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                   Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayInfiniteTalkVideoCommand}"
                                                   IsEnabled="{Binding HasInfiniteTalkResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenInfiniteTalkResultFolderCommand}"
                                                   IsEnabled="{Binding HasInfiniteTalkResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="2"
                                                   Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendInfiniteTalkToEditCameraCommand}"
                                                   IsEnabled="{Binding HasInfiniteTalkResult}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding InfiniteTalkVideoInfo}"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Log Section - shared panel -->
                                <ctrl:ProcessingLogPanel LogText="{Binding InfiniteTalkLogOutput}" Header="📋 Processing Log" MaxLogHeight="200"/>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 8: LTX 2.3 Text to Video -->
                    <TabItem Header="✨ Text to Video">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Hero Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="✨ Text to Video"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>
                                        <TextBlock Text="Describe the video you want to generate — no image required."
                                                  FontSize="12" Foreground="#6C757D"
                                                  Margin="0,0,0,12"/>

                                        <TextBox Text="{Binding T2VPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                MinHeight="140"
                                                MaxHeight="260"
                                                Padding="14"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                BorderThickness="1"
                                                FontSize="13"
                                                VerticalAlignment="Stretch">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#FF6B35"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- Generate Button -->
                                        <Button Content="🎬  Generate Video"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding T2VGenerateCommand}"
                                                IsEnabled="{Binding T2VCanAddToQueue}"
                                                Height="44"
                                                Margin="0,14,0,0"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>

                                <!-- Settings Section -->
                                <Expander Header="⚙️ Generation Settings" IsExpanded="False" Margin="0,5,0,0">
                                    <Border Style="{StaticResource SectionPanelStyle}" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Duration -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Duration (seconds)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="#495057"/>
                                                <TextBox Text="{Binding T2VLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Padding="10,8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="13"
                                                        HorizontalContentAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Width -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Width (px)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="#495057"/>
                                                <TextBox Text="{Binding T2VWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Padding="10,8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="13"
                                                        HorizontalContentAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Height -->
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Height (px)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="#495057"/>
                                                <TextBox Text="{Binding T2VHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Padding="10,8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="13"
                                                        HorizontalContentAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Seed -->
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Seed (-1 = random)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="#495057"/>
                                                <TextBox Text="{Binding T2VSeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Padding="10,8"
                                                        Background="White"
                                                        BorderBrush="#CED4DA"
                                                        FontSize="13"
                                                        HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Expander>

                                <!-- Processing Status -->
                                <Border Background="#FFF9F0"
                                        BorderBrush="#FFE0B0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding IsProcessingT2V, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding T2VProcessingStatus}"
                                                  FontWeight="SemiBold" FontSize="12"
                                                  TextAlignment="Center" TextWrapping="Wrap"
                                                  Foreground="#495057"/>
                                        <ProgressBar Value="{Binding T2VProcessingProgress, Mode=OneWay}"
                                                    Height="10"
                                                    Foreground="#FF6B35"
                                                    Background="#F0F0F0"
                                                    BorderThickness="0"
                                                    Margin="0,8,0,4"/>
                                        <TextBlock Text="{Binding T2VProgressPercentage}"
                                                  HorizontalAlignment="Center"
                                                  FontSize="11" FontWeight="Bold"
                                                  Foreground="#FF6B35"/>
                                    </StackPanel>
                                </Border>

                                <!-- Queue Panel -->
                                <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                        CornerRadius="6" Margin="0,10,0,0"
                                        Visibility="{Binding T2VHasQueueItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Border Background="#F8F9FA" Padding="12,8" CornerRadius="6,6,0,0">
                                            <Grid>
                                                <TextBlock Text="📋 Queue"
                                                          FontWeight="Bold" FontSize="12"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding T2VQueueStatus}"
                                                          FontSize="10" Foreground="#6C757D"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Padding="6">
                                            <ItemsControl ItemsSource="{Binding T2VQueue}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#E9ECEF" BorderThickness="1"
                                                                CornerRadius="5" Padding="10,7"
                                                                Margin="2,2,2,0" Background="White">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                          Text="{Binding Prompt}"
                                                                          FontSize="11"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="#212529"/>

                                                                <TextBlock Grid.Column="1"
                                                                          Text="{Binding StatusDisplay}"
                                                                          Foreground="{Binding StatusColor}"
                                                                          FontSize="10" FontWeight="SemiBold"
                                                                          VerticalAlignment="Center"
                                                                          Margin="10,0,10,0"/>

                                                                <Button Grid.Column="2"
                                                                       Content="✕"
                                                                       Width="22" Height="22"
                                                                       FontSize="10"
                                                                       Background="Transparent"
                                                                       BorderThickness="0"
                                                                       Foreground="#ADB5BD"
                                                                       Padding="0"
                                                                       Command="{Binding DataContext.T2VRemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                       CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- Result Preview -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                Background="#FAFAFA" Height="240" CornerRadius="5"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Generated video will appear here"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#ADB5BD" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasT2VResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="T2VVideoPlayer"
                                                            Source="{Binding T2VResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasT2VResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding T2VPlayVideoCommand}"
                                                   IsEnabled="{Binding HasT2VResult}"
                                                   Margin="0,0,8,0"/>
                                            <Button Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding T2VOpenResultFolderCommand}"
                                                   IsEnabled="{Binding HasT2VResult}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding T2VVideoInfo}"
                                                  FontStyle="Italic" Foreground="#6C757D"
                                                  FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Generation Log - shared panel -->
                                <ctrl:ProcessingLogPanel LogText="{Binding T2VLogOutput}" Header="📋 Generation Log"/>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab: Long Video -->
                    <TabItem Header="🔄 Long Video">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Intro -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🔄 Long Video Generator"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#6C757D"
                                                  Margin="0,0,0,0">
                                            Upload a video → extract last frame → analyze → generate new video → repeat.
                                            Choose between Wan 2.2 Remix or LTX 2.3. Each iteration feeds the previous output as its input.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Workflow Selection -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🎬 Workflow"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">

                                            <!-- Wan 2.2 Remix -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LongVideoUseWan}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#007BFF"/>
                                                                <Setter Property="Background" Value="#CCE5FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding ToggleLongVideoWorkflowCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="🔵 Wan 2.2 Remix"
                                                              FontSize="13" FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="Wan2_2_RemixAPI.json"
                                                              FontSize="10" Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- LTX 2.3 -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LongVideoUseLTX23}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#28A745"/>
                                                                <Setter Property="Background" Value="#D4EDDA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding ToggleLongVideoWorkflowCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="🟢 LTX 2.3"
                                                              FontSize="13" FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="LTX2.3-I2VAPI.json"
                                                              FontSize="10" Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Wan Analysis Prompt Selection (Wan workflow only) -->
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LongVideoUseWan}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🧠 Analysis Prompt"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>
                                        <TextBlock Text="Selects which system prompt is sent with the last frame to llamaserver:"
                                                  FontSize="11" Foreground="#6C757D" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">

                                            <!-- Button 1: wan-system-single -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LongVideoUseWanSinglePrompt}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#6F42C1"/>
                                                                <Setter Property="Background" Value="#EDE7F6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding SelectLongVideoWanSinglePromptCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="1 — Single Frame"
                                                              FontSize="13" FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="wan-system-single.md"
                                                              FontSize="10" Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                    <TextBlock Text="Cinematic action prompt"
                                                              FontSize="10" Foreground="#6C757D"
                                                              FontStyle="Italic"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Button 2: wan-long-fight (default) -->
                                            <Border CornerRadius="5"
                                                    Padding="10,8"
                                                    BorderThickness="2"
                                                    Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LongVideoUseWanFightPrompt}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#DC3545"/>
                                                                <Setter Property="Background" Value="#FDECEA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding SelectLongVideoWanFightPromptCommand}" MouseAction="LeftClick"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="2 — Long Fight  ✓"
                                                              FontSize="13" FontWeight="Bold"
                                                              Foreground="#212529"/>
                                                    <TextBlock Text="wan-long-fight.md"
                                                              FontSize="10" Foreground="#6C757D"
                                                              Margin="0,2,0,0"/>
                                                    <TextBlock Text="Martial arts / combat prompt"
                                                              FontSize="10" Foreground="#6C757D"
                                                              FontStyle="Italic"/>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- Video Input -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="📹 Input Video"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>

                                        <Button Content="📁 Browse Video"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SelectLongVideoCommand}"
                                                Height="36"
                                                HorizontalAlignment="Left"
                                                MinWidth="160"
                                                Margin="0,0,0,8"/>

                                        <TextBlock Text="{Binding LongVideoInfo}"
                                                  FontStyle="Italic"
                                                  Foreground="#495057"
                                                  FontSize="11"
                                                  TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Loop Settings -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Loop Settings"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Iterations (1–10):"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>
                                            <Slider Value="{Binding LongVideoMaxIterations, Mode=TwoWay}"
                                                   Minimum="1" Maximum="10"
                                                   TickFrequency="1"
                                                   IsSnapToTickEnabled="True"
                                                   Width="160"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LongVideoMaxIterations}"
                                                      FontWeight="Bold"
                                                      FontSize="16"
                                                      Foreground="#FF6B35"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Start / Stop -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                           Content="{Binding LongVideoStartButtonContent}"
                                           Style="{StaticResource PrimaryButtonStyle}"
                                           Command="{Binding StartLongVideoCommand}"
                                           IsEnabled="{Binding LongVideoCanStart}"
                                           Height="44"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                    <Button Grid.Column="2"
                                           Content="⏹ Stop"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           Command="{Binding StopLongVideoCommand}"
                                           IsEnabled="{Binding LongVideoIsRunning}"
                                           Height="44"
                                           Width="90"
                                           FontSize="13"/>
                                </Grid>

                                <!-- Queue indicator -->
                                <Border Margin="0,4,0,0" Padding="10,6" CornerRadius="4"
                                        Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LongVideoHasQueuedJobs}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" Foreground="#856404">
                                        <Run Text="⏳ "/>
                                        <Run Text="{Binding LongVideoQueueCount, Mode=OneWay}"/>
                                        <Run Text=" job(s) queued — will start automatically when current finishes"/>
                                    </TextBlock>
                                </Border>

                                <!-- Progress -->
                                <Border Background="#FFF9F0"
                                        BorderBrush="#FFE0B0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding LongVideoIsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LongVideoProcessingStatus}"
                                                  FontWeight="SemiBold" FontSize="12"
                                                  TextWrapping="Wrap"
                                                  TextAlignment="Center"
                                                  Foreground="#495057"/>
                                        <ProgressBar Value="{Binding LongVideoProcessingProgress, Mode=OneWay}"
                                                    Height="10"
                                                    Foreground="#FF6B35"
                                                    Background="#F0F0F0"
                                                    BorderThickness="0"
                                                    Margin="0,8,0,4"/>
                                        <TextBlock Text="{Binding LongVideoProgressPercentage}"
                                                  HorizontalAlignment="Center"
                                                  FontSize="11" FontWeight="Bold"
                                                  Foreground="#FF6B35"/>
                                    </StackPanel>
                                </Border>

                                <!-- Iterations List -->
                                <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                        CornerRadius="6" Margin="0,8,0,0"
                                        Visibility="{Binding LongVideoHasIterations, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Border Background="#F8F9FA" Padding="12,8" CornerRadius="6,6,0,0">
                                            <TextBlock Text="📋 Iterations"
                                                      FontWeight="Bold" FontSize="12"
                                                      VerticalAlignment="Center"/>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding LongVideoIterations}" Margin="6,4,6,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E9ECEF" BorderThickness="1"
                                                            CornerRadius="5" Padding="10,8"
                                                            Margin="2,2,2,0" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}"
                                                                          FontWeight="SemiBold" FontSize="12"
                                                                          Foreground="#212529"/>
                                                                <TextBlock Text="{Binding AnalysisPrompt}"
                                                                          FontSize="10" Foreground="#6C757D"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          MaxWidth="300"
                                                                          Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1"
                                                                      Text="{Binding StatusDisplay}"
                                                                      Foreground="{Binding StatusColor}"
                                                                      FontSize="11" FontWeight="SemiBold"
                                                                      VerticalAlignment="Center"
                                                                      Margin="10,0,6,0"/>

                                                            <Button Grid.Column="2"
                                                                   Content="▶"
                                                                   Width="28" Height="28"
                                                                   FontSize="11"
                                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                                   Padding="0"
                                                                   IsEnabled="{Binding HasOutput}"
                                                                   ToolTip="Play this iteration's video"
                                                                   Command="{Binding DataContext.PlayLongVideoIterationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   Margin="2,0,0,0"/>

                                                            <Button Grid.Column="3"
                                                                   Content="📂"
                                                                   Width="28" Height="28"
                                                                   FontSize="11"
                                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                                   Padding="0"
                                                                   IsEnabled="{Binding HasOutput}"
                                                                   ToolTip="Open output folder"
                                                                   Command="{Binding DataContext.OpenLongVideoIterationFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   Margin="2,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Last Frame Preview + Analysis -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0"
                                        Visibility="{Binding LongVideoIsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Frame preview -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🖼️ Last Frame"
                                                      FontSize="12" FontWeight="Bold"
                                                      Foreground="#FF6B35" Margin="0,0,0,6"/>
                                            <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                    Background="White" Height="160" CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="Extracting frame..."
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="#999" FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LongVideoFramePreview}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding LongVideoFramePreview}" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- Analysis result -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="🧠 Analysis"
                                                      FontSize="12" FontWeight="Bold"
                                                      Foreground="#FF6B35" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding LongVideoCurrentAnalysis, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    AcceptsReturn="True"
                                                    Height="160"
                                                    Padding="10"
                                                    VerticalScrollBarVisibility="Auto"
                                                    Background="#F8F9FA"
                                                    BorderBrush="#CED4DA"
                                                    FontSize="11"
                                                    IsReadOnly="True"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Result -->
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0"
                                        Visibility="{Binding HasLongVideoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Latest Result"
                                                  Style="{StaticResource HeaderTextStyle}"
                                                  Foreground="#FF6B35"/>

                                        <Border BorderBrush="#DEE2E6" BorderThickness="1"
                                                Background="#FAFAFA" Height="240"
                                                CornerRadius="5" Margin="0,0,0,10">
                                            <MediaElement x:Name="LongVideoPlayer"
                                                        Source="{Binding LongVideoResultPath}"
                                                        LoadedBehavior="Manual"
                                                        UnloadedBehavior="Stop"
                                                        Stretch="Uniform"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayLongVideoResultCommand}"
                                                   IsEnabled="{Binding HasLongVideoResult}"
                                                   Margin="0,0,8,0"/>
                                            <Button Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenLongVideoResultFolderCommand}"
                                                   IsEnabled="{Binding HasLongVideoResult}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding LongVideoResultInfo}"
                                                  FontStyle="Italic" Foreground="#6C757D"
                                                  FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Log - shared panel -->
                                <ctrl:ProcessingLogPanel LogText="{Binding LongVideoLogOutput}" Header="📋 Generation Log"/>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab: Scail 2 (unified Klein char-swap → SCAIL II motion transfer) -->
                    <TabItem Header="🎭 Scail 2">
                        <Grid DataContext="{Binding Scail2VM}" Background="#0B1020">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14" MaxWidth="640" HorizontalAlignment="Center">

                                    <!-- ═══ 1) Base scene (video) ═══════════════════════════ -->
                                    <Border Background="#0F172A" BorderBrush="#1F2937" BorderThickness="1"
                                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="BASE SCENE" FontSize="12" FontWeight="Bold" Foreground="#E5E7EB"/>
                                                    <TextBlock Text="{Binding InputVideoInfo}" FontSize="10" Foreground="#6B7280"
                                                               FontStyle="Italic" VerticalAlignment="Center" Margin="10,0,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Upload video…"
                                                        Command="{Binding SelectVideoCommand}"
                                                        Height="30" Padding="12,0" FontSize="11"
                                                        Background="#065F46" Foreground="#A7F3D0" BorderThickness="0" Cursor="Hand"/>
                                            </Grid>

                                            <!-- Reference video preview (Source assigned in code-behind) -->
                                            <Border Background="#030712" BorderBrush="#1F2937" BorderThickness="1"
                                                    CornerRadius="6" Height="200">
                                                <Grid>
                                                    <TextBlock Text="Upload a base scene video, then scrub to a frame showing both people"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#4B5563" FontSize="12" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxWidth="320">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasInputVideo}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <MediaElement x:Name="Scail2RefVideoPlayer"
                                                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                  ScrubbingEnabled="True"
                                                                  MediaOpened="Scail2RefPlayer_MediaOpened"
                                                                  MediaEnded="Scail2RefPlayer_MediaEnded"
                                                                  Stretch="Uniform"
                                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Scrub + In/Out trim track (playhead = Klein frame; markers = SCAIL II range) -->
                                            <Grid x:Name="Scail2TrimTrack" Height="30" Margin="2,10,2,0"
                                                  Background="Transparent" ClipToBounds="False"
                                                  SizeChanged="Scail2TrimTrack_SizeChanged"
                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Height="8" VerticalAlignment="Center" CornerRadius="4" Background="#1F2937"/>
                                                <Border x:Name="Scail2TrimRegion" Height="8" Width="0"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        CornerRadius="4" Background="#7C3AED" IsHitTestVisible="False"/>
                                                <Border x:Name="Scail2TrimPlayhead" Width="2" Height="24"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Background="#E5E7EB" IsHitTestVisible="False"/>
                                                <Thumb x:Name="Scail2InThumb" Width="14" Height="24"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE"
                                                       DragDelta="Scail2InThumb_DragDelta"
                                                       ToolTip="Drag to set the start (in) point">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#86EFAC" CornerRadius="3" BorderBrush="#14532D" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                                <Thumb x:Name="Scail2OutThumb" Width="14" Height="24"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE"
                                                       DragDelta="Scail2OutThumb_DragDelta"
                                                       ToolTip="Drag to set the end (out) point">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#FCA5A5" CornerRadius="3" BorderBrush="#7F1D1D" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Grid>

                                            <Grid Margin="0,8,0,0"
                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="▶" Click="Scail2Play_Click"
                                                            Width="30" Height="26" FontSize="11" Margin="0,0,4,0"
                                                            Background="#1F2937" Foreground="#E5E7EB" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="⏸" Click="Scail2Pause_Click"
                                                            Width="30" Height="26" FontSize="11" Margin="0,0,10,0"
                                                            Background="#1F2937" Foreground="#E5E7EB" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="⟦ In" Command="{Binding MarkInCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"
                                                            Background="#14532D" Foreground="#86EFAC" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="Out ⟧" Command="{Binding MarkOutCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"
                                                            Background="#7F1D1D" Foreground="#FCA5A5" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="Reset" Command="{Binding ResetTrimCommand}"
                                                            Height="26" Padding="8,0" FontSize="11"
                                                            Background="#1F2937" Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="ETA" FontSize="9" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding EstimatedTime}" FontSize="13" FontWeight="Bold"
                                                               FontFamily="Consolas" Foreground="#C084FC" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding TrimInfo}" FontSize="10" Foreground="#9CA3AF"
                                                       FontFamily="Consolas" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ 2) Characters → Character image (Klein char-swap) ═══ -->
                                    <Border Background="#0F172A" BorderBrush="#1F2937" BorderThickness="1"
                                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Ellipse Width="7" Height="7" Fill="#7C3AED" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="CHARACTERS" FontSize="12" FontWeight="Bold" Foreground="#E5E7EB"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Character 1 -->
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <Border Height="110" CornerRadius="6" Background="#030712"
                                                            BorderBrush="#312E81" BorderThickness="1" Cursor="Hand">
                                                        <Grid>
                                                            <TextBlock Text="＋ Character 1 (LEFT)" Foreground="#6B7280" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding NoChar1Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Image Source="{Binding Char1ImageSource}" Stretch="UniformToFill"/>
                                                            <Button Content="✕" Command="{Binding RemoveChar1Command}"
                                                                    Width="20" Height="20" Margin="0,3,3,0" Padding="0" FontSize="11"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Background="#CC111827" Foreground="#FCA5A5" BorderThickness="0"
                                                                    Cursor="Hand" ToolTip="Remove Character 1"
                                                                    Visibility="{Binding HasChar1Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Browse…" Command="{Binding BrowseChar1Command}"
                                                            Height="26" FontSize="10" Margin="0,5,0,0"
                                                            Background="#1F2937" Foreground="#C7D2FE" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="Replace this one only"
                                                            Command="{Binding SwapChar1OnlyCommand}"
                                                            Height="26" FontSize="10" Margin="0,4,0,0"
                                                            Background="#5B21B6" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Replace just one person in the current base frame with Character 1 (works for a man or a woman), then use the result as the character image"/>
                                                </StackPanel>

                                                <!-- Character 2 -->
                                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                    <Border Height="110" CornerRadius="6" Background="#030712"
                                                            BorderBrush="#312E81" BorderThickness="1" Cursor="Hand">
                                                        <Grid>
                                                            <TextBlock Text="＋ Character 2 (RIGHT)" Foreground="#6B7280" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding NoChar2Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Image Source="{Binding Char2ImageSource}" Stretch="UniformToFill"/>
                                                            <Button Content="✕" Command="{Binding RemoveChar2Command}"
                                                                    Width="20" Height="20" Margin="0,3,3,0" Padding="0" FontSize="11"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Background="#CC111827" Foreground="#FCA5A5" BorderThickness="0"
                                                                    Cursor="Hand" ToolTip="Remove Character 2"
                                                                    Visibility="{Binding HasChar2Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Browse…" Command="{Binding BrowseChar2Command}"
                                                            Height="26" FontSize="10" Margin="0,5,0,0"
                                                            Background="#1F2937" Foreground="#C7D2FE" BorderThickness="0" Cursor="Hand"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="→" FontSize="20" Foreground="#7C3AED"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Character image (Klein composite) -->
                                                <StackPanel Grid.Column="3">
                                                    <Border Height="110" CornerRadius="6" Background="#030712"
                                                            BorderBrush="#5B21B6" BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="Character image"
                                                                       Foreground="#6B7280" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding NoCharSwapResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Image Source="{Binding CharSwapResultSource}" Stretch="Uniform"/>
                                                            <Border Background="#CC030712"
                                                                    Visibility="{Binding IsCharSwapping, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="⏳ working…" Foreground="#C084FC" FontSize="12"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Swap characters"
                                                            Command="{Binding SwapCharactersCommand}"
                                                            Height="26" FontSize="10" Margin="0,5,0,0"
                                                            Background="#7C3AED" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Replace both people in the current base frame with Character 1 (left) and Character 2 (right), then use the result as the character image"/>
                                                    <TextBlock Text="Built when you press Swap" FontSize="9"
                                                               Foreground="#6B7280" FontStyle="Italic" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding CharSwapStatus}" FontSize="11" Foreground="#C084FC"
                                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ 3) Generate progress / status ═══════════════════ -->
                                    <Border Background="#0F172A" BorderBrush="#1F2937" BorderThickness="1"
                                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <ProgressBar Height="6" Margin="0,0,0,8"
                                                         Value="{Binding ProcessingProgress, Mode=OneWay}"
                                                         Foreground="#7C3AED" Background="#1F2937" BorderThickness="0"
                                                         Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Grid>
                                                <TextBlock Text="{Binding ProcessingStatus}" FontSize="11" Foreground="#9CA3AF"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Content="⚡ Generate video" HorizontalAlignment="Right"
                                                        Click="Scail2Process_Click" Height="30" Padding="14,0" FontSize="11"
                                                        FontWeight="Bold" Background="#059669" Foreground="White"
                                                        BorderThickness="0" Cursor="Hand"
                                                        IsEnabled="{Binding CanAddToQueue}"
                                                        ToolTip="Analyzes the marked In/Out range and generates the SCAIL II video. Build the character image first."/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ 4) Result ═══════════════════════════════════════ -->
                                    <Border Background="#0F172A" BorderBrush="#1F2937" BorderThickness="1"
                                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="🎥 RESULT" FontSize="12" FontWeight="Bold"
                                                       Foreground="#E5E7EB" Margin="0,0,0,8"/>
                                            <Border Background="#030712" BorderBrush="#1F2937" BorderThickness="1"
                                                    Height="200" CornerRadius="6" Margin="0,0,0,8">
                                                <Grid>
                                                    <TextBlock Text="The motion-transfer video will appear here"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#4B5563" FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasResult}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <MediaElement x:Name="Scail2VideoPlayer"
                                                                  Source="{Binding ResultVideoPath}"
                                                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                  Stretch="Uniform"
                                                                  Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="▶ Play" Command="{Binding PlayVideoCommand}"
                                                        IsEnabled="{Binding HasResult}" Height="30" Padding="14,0" FontSize="11"
                                                        Background="#7C3AED" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                                                <Button Content="📁 Open folder" Command="{Binding OpenResultFolderCommand}"
                                                        IsEnabled="{Binding HasResult}" Height="30" Padding="14,0" FontSize="11"
                                                        Background="#1F2937" Foreground="#E5E7EB" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                                                <Button Content="📷 Send to Edit Camera" Command="{Binding SendToEditCameraCommand}"
                                                        IsEnabled="{Binding HasResult}" Height="30" Padding="14,0" FontSize="11"
                                                        Background="#1F2937" Foreground="#E5E7EB" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ResultVideoInfo}" FontStyle="Italic"
                                                       Foreground="#6B7280" FontSize="11" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ Log ═════════════════════════════════════════════ -->
                                    <Expander Header="📝 Log" IsExpanded="False" Foreground="#9CA3AF" Margin="0,0,0,4">
                                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                            <TextBox Text="{Binding LogOutput, Mode=OneWay}"
                                                     TextWrapping="Wrap" IsReadOnly="True"
                                                     FontFamily="Consolas" FontSize="10"
                                                     Background="#030712" Foreground="#9CA3AF" BorderThickness="0" Padding="10"/>
                                        </ScrollViewer>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Tab: LTX Control -->
                    <TabItem Header="🎛️ LTX Control">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Background="#F9FAFB">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Reference Image -->
                                        <Border Background="White" BorderBrush="#BFDBFE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Ellipse Width="6" Height="6" Fill="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="REFERENCE IMAGE" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="  · subject &amp; aesthetics" FontSize="10" Foreground="#9CA3AF"/>
                                                </StackPanel>

                                                <Border BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6"
                                                        Background="#EFF6FF" Height="130" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No image selected"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="#9CA3AF" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding LtxControlRefImagePreview}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding LtxControlRefImagePreview}" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding LtxControlRefImageInfo}"
                                                               FontSize="10" Foreground="#6B7280" FontStyle="Italic"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectLtxControlRefImageCommand}"
                                                            Height="28" Padding="10,0" FontSize="11"
                                                            Background="#DBEAFE" Foreground="#2563EB"
                                                            BorderBrush="#BFDBFE" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reference Video -->
                                        <Border Background="White" BorderBrush="#BFDBFE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="REFERENCE VIDEO" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="  · motion &amp; structure" FontSize="10" Foreground="#9CA3AF"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding LtxControlRefVideoPath, Mode=OneWay}"
                                                             IsReadOnly="True" Height="30"
                                                             VerticalContentAlignment="Center" Padding="6,0"
                                                             BorderBrush="#BFDBFE" Background="#F0FDF4"
                                                             FontSize="11" Foreground="#555" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectLtxControlRefVideoCommand}"
                                                            Height="30" Padding="10,0" FontSize="11"
                                                            Background="#ECFDF5" Foreground="#059669"
                                                            BorderBrush="#A7F3D0" BorderThickness="1"/>
                                                </Grid>
                                                <TextBlock Text="{Binding LtxControlRefVideoInfo}"
                                                           FontSize="10" Foreground="#6B7280" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Analyze -->
                                        <Border Background="White" BorderBrush="#BFDBFE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze Image"
                                                            Command="{Binding AnalyzeLtxControlCommand}"
                                                            IsEnabled="{Binding LtxControlCanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Background="#2563EB" Foreground="White" BorderThickness="0"
                                                            ToolTip="Analyzes the reference image to generate an IC-LoRA aesthetic prompt. The reference video provides structural control signals automatically."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="Analyzing…" Foreground="#2563EB">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LtxControlIsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap"
                                                           Text="Generates an aesthetic prompt from the reference image. The video's pose, depth, and edge maps are extracted automatically."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Background="White" BorderBrush="#BFDBFE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#818CF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="POSITIVE PROMPT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding LtxControlPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="90" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="#BFDBFE" Background="#EFF6FF"
                                                         FontSize="12" Padding="8" Margin="0,0,0,10"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="NEGATIVE PROMPT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding LtxControlNegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="55" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="#BFDBFE" Background="#EFF6FF"
                                                         FontSize="11" Padding="8"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="#BFDBFE" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding LtxControlSeed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="#BFDBFE" Background="#EFF6FF"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomLtxControlSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="#DBEAFE" Foreground="#2563EB"
                                                            BorderBrush="#BFDBFE" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ═══════════════════════════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="290"/>  <!-- Reference video preview -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Queue panel -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Reference Video Preview ───────────────────────────── -->
                                <Border Grid.Row="0" Background="#030712">
                                    <Grid>
                                        <!-- Idle placeholder -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LtxControlHasRefVideo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14"
                                                    Background="#0A0F1E" BorderBrush="#1F2937" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🎛️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Drop reference video here" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Upload → Analyze → Generate"
                                                       FontSize="11" Foreground="#374151" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Reference video player -->
                                        <MediaElement x:Name="LtxControlRefVideoPlayer"
                                                      Source="{Binding LtxControlRefVideoFileUri}"
                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      ScrubbingEnabled="True"
                                                      MediaOpened="LtxControlRefPlayer_MediaOpened"
                                                      Stretch="Uniform"
                                                      Visibility="{Binding LtxControlHasRefVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- Info bar overlay -->
                                        <Border VerticalAlignment="Bottom" Margin="10,0,10,10"
                                                CornerRadius="8" Padding="12,6"
                                                Visibility="{Binding LtxControlHasRefVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.Background>
                                                <SolidColorBrush Color="#030712" Opacity="0.88"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="#1F2937" Opacity="0.7"/>
                                            </Border.BorderBrush>
                                            <Border.BorderThickness>1</Border.BorderThickness>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="10" Foreground="#9CA3AF">
                                                    <Run Text="IC-LoRA Control  "/>
                                                    <Run Text="pose · depth · canny" FontWeight="Bold" Foreground="#60A5FA" FontFamily="Consolas"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding LtxControlProcessingProgress, Mode=OneWay}"
                                             Foreground="#2563EB" Background="#1F2937" BorderThickness="0"
                                             Visibility="{Binding LtxControlIsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#374151"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LtxControlIsProcessingQueue}" Value="True">
                                                                <Setter Property="Fill" Value="#60A5FA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding LtxControlProcessingStatus}"
                                                       FontSize="11" Foreground="#6B7280"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding LtxControlProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#2563EB"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding LtxControlIsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1F2937"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateLtxControlVideoCommand}"
                                                IsEnabled="{Binding LtxControlCanAddToQueue}"
                                                Background="#2563EB" Foreground="White"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate Video" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Height="40" Width="82"
                                                Command="{Binding StopLtxControlQueueCommand}"
                                                IsEnabled="{Binding LtxControlIsProcessingQueue}"
                                                Background="#1F2937" Foreground="#F87171"
                                                FontSize="11" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Queue Panel ───────────────────────────────────────── -->
                                <Border Grid.Row="4" Background="#EFF6FF" BorderBrush="#BFDBFE"
                                        BorderThickness="0,1,0,0" Padding="12,8"
                                        Visibility="{Binding LtxControlHasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🎛️ LTX Control Queue"
                                                       FontWeight="Bold" FontSize="12" Foreground="#2563EB"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LtxControlQueueStatus}"
                                                       FontStyle="Italic" Foreground="#666" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="🔄 Retry"
                                                    Command="{Binding ReprocessAllLtxControlFailedCommand}"
                                                    IsEnabled="{Binding LtxControlHasFailedItems}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Background="#2563EB" Foreground="White" BorderThickness="0"/>
                                            <Button Grid.Column="3" Content="⏹ Stop"
                                                    Command="{Binding StopLtxControlQueueCommand}"
                                                    IsEnabled="{Binding LtxControlIsProcessingQueue}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Background="#60A5FA" Foreground="White" BorderThickness="0"/>
                                            <Button Grid.Column="4" Content="🗑️ Clear"
                                                    Command="{Binding ClearLtxControlQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11"
                                                    Background="#DC3545" Foreground="White" BorderThickness="0"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding LtxControlQueue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4"
                                                            Padding="10,5" Margin="0,0,0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding Prompt}" FontSize="10" Foreground="#666"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveLtxControlQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="White" BorderBrush="#BFDBFE"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="#2563EB" Margin="0,0,0,8"/>

                                        <Border BorderBrush="#BFDBFE" BorderThickness="1" Background="#030712"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#374151" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLtxControlResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="LtxControlVideoPlayer"
                                                              Source="{Binding LtxControlResultPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasLtxControlResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayLtxControlVideoCommand}"
                                                    IsEnabled="{Binding HasLtxControlResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenLtxControlResultFolderCommand}"
                                                    IsEnabled="{Binding HasLtxControlResult}" Margin="0,0,8,0"/>
                                            <Button Content="📷 Send to Edit Camera" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding SendLtxControlToEditCameraCommand}"
                                                    IsEnabled="{Binding HasLtxControlResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LtxControlResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LtxControlLogOutput}" MaxLogHeight="130"/>

                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Tab: VR 180 -->
                    <TabItem Header="🥽 VR 180">
                        <Grid DataContext="{Binding Vr180VM}" Background="#ECFEFF">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL · Inputs ════════════════════════════════════ -->
                            <Border Grid.Column="0" BorderBrush="#A5F3FC" BorderThickness="0,0,1,0" Background="#F0FDFF">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Intro -->
                                        <Border Background="#0E7490" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🥽 Flat → 360° VR" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#CFFAFE" Margin="0,4,0,0"
                                                           Text="Drop in an ordinary flat clip. The LTX-2.3-22B equirect IC-LoRA paints a VR hemisphere, Video-Depth-Anything adds per-frame depth, and a side-by-side 3D VR180 file is assembled for your headset."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Input video -->
                                        <Border Background="White" BorderBrush="#A5F3FC" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#0891B2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="FLAT VIDEO" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="  · required" FontSize="10" Foreground="#9CA3AF"/>
                                                </StackPanel>
                                                <Border BorderBrush="#A5F3FC" BorderThickness="1" CornerRadius="6"
                                                        Background="#0C0A09" Height="150" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No video selected" Foreground="#57534E" FontStyle="Italic"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <MediaElement x:Name="Vr180InputPlayer"
                                                                      Source="{Binding VideoFileUri}"
                                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                      ScrubbingEnabled="True" Stretch="Uniform"
                                                                      MediaOpened="Vr180InputPlayer_MediaOpened"
                                                                      Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <Button Content="📁 Choose video…" Command="{Binding SelectVideoCommand}"
                                                        Height="32" FontSize="12" FontWeight="SemiBold"
                                                        Background="#0891B2" Foreground="White" BorderThickness="0"/>
                                                <TextBlock Text="{Binding VideoInfo}" FontSize="10" Foreground="#6B7280"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt + analyze -->
                                        <Border Background="White" BorderBrush="#A5F3FC" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" Fill="#0891B2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="SCENE PROMPT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                        <TextBlock Text="  · optional" FontSize="10" Foreground="#9CA3AF"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="Analyzing…" FontStyle="Italic" FontSize="10" Foreground="#0891B2"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Button Content="🔍 Analyze" Command="{Binding AnalyzeCommand}"
                                                                IsEnabled="{Binding CanAnalyze}"
                                                                Height="26" Padding="10,0" FontSize="11" FontWeight="SemiBold"
                                                                Background="#CFFAFE" Foreground="#0E7490" BorderThickness="1" BorderBrush="#A5F3FC"
                                                                ToolTip="Extract the first frame and describe the scene as a 360° environment"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="70" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="#A5F3FC" Background="#F0FDFF"
                                                         FontSize="12" Padding="8" Margin="0,0,0,10"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="NEGATIVE PROMPT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="60" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="#A5F3FC" Background="#F0FDFF"
                                                         FontSize="11" Padding="8"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Output settings -->
                                        <Border Background="White" BorderBrush="#A5F3FC" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Ellipse Width="6" Height="6" Fill="#0891B2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="OUTPUT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Equirect size (2:1)" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding ResolutionChoices}"
                                                                  SelectedItem="{Binding Resolution}"
                                                                  Height="30" FontSize="12" Padding="6,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Frame cap" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding FrameCap, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                                 BorderBrush="#A5F3FC" Background="#F0FDFF"
                                                                 FontSize="12" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,8,0,0"
                                                           Text="Bigger size = sharper but slower. Frame cap limits clip length (121 ≈ 5s @ 24fps)."/>

                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="3D depth" FontSize="10"
                                                               Foreground="#6B7280" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.4"
                                                            Value="{Binding StereoStrength}" Margin="8,0"
                                                            TickFrequency="0.02" IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StereoStrength, StringFormat={}{0:0.00}}"
                                                               FontSize="11" FontFamily="Consolas" Foreground="#0891B2"
                                                               FontWeight="Bold" VerticalAlignment="Center" Width="34"
                                                               TextAlignment="Right"/>
                                                </Grid>
                                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,4,0,0"
                                                           Text="Stereo parallax from the depth pass. 0 = flat-in-VR (both eyes identical); higher = more pop, but more edge warping."/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ════════════════════════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="*"/>    <!-- Scrollable: result + queue + log -->
                                </Grid.RowDefinitions>

                                <!-- Progress bar -->
                                <ProgressBar Grid.Row="0"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="#0891B2" Background="#164E5C" BorderThickness="0"
                                             Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Status row -->
                                <Border Grid.Row="1" Background="#083344" BorderBrush="#0E7490"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#155E6F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessingQueue}" Value="True">
                                                                <Setter Property="Fill" Value="#22D3EE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}" FontSize="11" Foreground="#A5F3FC"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#22D3EE" FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Action buttons -->
                                <Border Grid.Row="2" Background="#062330" BorderBrush="#0E7490"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateVideoCommand}"
                                                IsEnabled="{Binding CanAddToQueue}"
                                                Background="#0891B2" Foreground="White"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🥽 " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate VR Video" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Height="40" Width="82"
                                                Command="{Binding StopQueueCommand}"
                                                IsEnabled="{Binding IsProcessingQueue}"
                                                Background="#155E6F" Foreground="#FCA5A5"
                                                FontSize="11" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Scrollable: result + queue + log -->
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Background="White">
                                    <StackPanel>
                                        <!-- Result -->
                                        <Border Background="White" BorderBrush="#A5F3FC" BorderThickness="0,0,0,1" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="🎥 360° Result" FontWeight="Bold" FontSize="13"
                                                           Foreground="#0891B2" Margin="0,0,0,8"/>
                                                <Border BorderBrush="#A5F3FC" BorderThickness="1" Background="#0C0A09"
                                                        Height="260" CornerRadius="6" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="Your 360° panorama will appear here after generation"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="#57534E" FontStyle="Italic">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <MediaElement x:Name="Vr180VideoPlayer"
                                                                      Source="{Binding ResultVideoPath}"
                                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                      Stretch="Uniform"
                                                                      Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                            Command="{Binding PlayVideoCommand}"
                                                            IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                                    <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding OpenResultFolderCommand}"
                                                            IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                                    <Button Content="📷 Send to Edit Camera" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding SendToEditCameraCommand}"
                                                            IsEnabled="{Binding HasResult}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ResultVideoInfo}"
                                                           FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Queue -->
                                        <Border Background="#F0FDFF" BorderBrush="#A5F3FC"
                                                BorderThickness="0,0,0,1" Padding="12,8"
                                                Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🥽 VR Queue"
                                                               FontWeight="Bold" FontSize="12" Foreground="#0891B2" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                               FontStyle="Italic" Foreground="#666" FontSize="11"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Content="🔄 Retry"
                                                            Command="{Binding ReprocessAllFailedCommand}"
                                                            IsEnabled="{Binding HasFailedItems}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                            Background="#0891B2" Foreground="White" BorderThickness="0"/>
                                                    <Button Grid.Column="3" Content="⏹ Stop"
                                                            Command="{Binding StopQueueCommand}"
                                                            IsEnabled="{Binding IsProcessingQueue}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                            Background="#0E7490" Foreground="White" BorderThickness="0"/>
                                                    <Button Grid.Column="4" Content="🗑️ Clear"
                                                            Command="{Binding ClearQueueCommand}"
                                                            Height="26" Padding="8,0" FontSize="11"
                                                            Background="#DC3545" Foreground="White" BorderThickness="0"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Queue}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#A5F3FC" BorderThickness="1" CornerRadius="4"
                                                                    Padding="10,5" Margin="0,0,0,3" Background="White">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                            Background="{Binding StatusColor}">
                                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                                   FontWeight="SemiBold" Foreground="White"/>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"/>
                                                                        <TextBlock Text="{Binding Prompt}" FontSize="10" Foreground="#666"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2" Content="✕"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="26" Height="26" Padding="0" FontSize="10"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Log - shared panel -->
                                        <ctrl:ProcessingLogPanel LogText="{Binding LogOutput}" MaxLogHeight="130"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Tab: Video Sound -->
                    <TabItem Header="🔊 Video Sound">
                        <Grid DataContext="{Binding VideoSoundVM}" Background="#F5F3FF">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL · Inputs ════════════════════════════════════ -->
                            <Border Grid.Column="0" BorderBrush="#DDD6FE" BorderThickness="0,0,1,0" Background="#FAF5FF">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Intro -->
                                        <Border Background="#6D28D9" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🔊 Video → Talking Video" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#EDE9FE" Margin="0,4,0,0"
                                                           Text="Drop in a clip and Analyze — its first frame is read into a [VISUAL]/[SPEECH]/[SOUNDS] script. The LTX-2.3 audio-video model then re-generates the shot with synchronized speech and sound effects."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Input video -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="VIDEO" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="  · required" FontSize="10" Foreground="#9CA3AF"/>
                                                </StackPanel>
                                                <Border BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6"
                                                        Background="#0C0A09" Height="150" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No video selected" Foreground="#57534E" FontStyle="Italic"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <MediaElement x:Name="VideoSoundInputPlayer"
                                                                      Source="{Binding VideoFileUri}"
                                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                      ScrubbingEnabled="True" Stretch="Uniform"
                                                                      MediaOpened="VideoSoundInputPlayer_MediaOpened"
                                                                      Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <Button Content="📁 Choose video…" Command="{Binding SelectVideoCommand}"
                                                        Height="32" FontSize="12" FontWeight="SemiBold"
                                                        Background="#7C3AED" Foreground="White" BorderThickness="0"/>
                                                <TextBlock Text="{Binding VideoInfo}" FontSize="10" Foreground="#6B7280"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt + analyze -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="SCRIPT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                        <TextBlock Text="  · [VISUAL]/[SPEECH]/[SOUNDS]" FontSize="10" Foreground="#9CA3AF"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="Analyzing…" FontStyle="Italic" FontSize="10" Foreground="#7C3AED"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Button Content="🔍 Analyze" Command="{Binding AnalyzeCommand}"
                                                                IsEnabled="{Binding CanAnalyze}"
                                                                Height="26" Padding="10,0" FontSize="11" FontWeight="SemiBold"
                                                                Background="#EDE9FE" Foreground="#5B21B6" BorderThickness="1" BorderBrush="#DDD6FE"
                                                                ToolTip="Extract the first frame and write a [VISUAL]/[SPEECH]/[SOUNDS] script"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="150" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="#DDD6FE" Background="#FAF5FF"
                                                         FontSize="12" FontFamily="Consolas" Padding="8"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,6,0,0"
                                                           Text="Edit freely. Keep the three labelled blocks so the model knows what to speak and what to sound like."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reference voice (optional) -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="REFERENCE VOICE" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="  · optional" FontSize="10" Foreground="#9CA3AF"/>
                                                </StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="🎙 Choose voice audio…"
                                                            Command="{Binding SelectReferenceAudioCommand}"
                                                            Height="30" FontSize="11" FontWeight="SemiBold"
                                                            Background="#EDE9FE" Foreground="#5B21B6"
                                                            BorderThickness="1" BorderBrush="#DDD6FE"/>
                                                    <Button Grid.Column="1" Content="✕" Width="30" Height="30" Margin="6,0,0,0"
                                                            Command="{Binding ClearReferenceAudioCommand}"
                                                            IsEnabled="{Binding HasReferenceAudio}"
                                                            Background="#F3F4F6" Foreground="#6B7280" BorderThickness="1" BorderBrush="#DDD6FE"
                                                            ToolTip="Clear reference voice (use workflow default)"/>
                                                </Grid>
                                                <TextBlock Text="{Binding ReferenceAudioInfo}" FontSize="10" Foreground="#6B7280"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Output settings -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="OUTPUT SIZE" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Width" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                                 BorderBrush="#DDD6FE" Background="#FAF5FF"
                                                                 FontSize="12" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Height" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                                 BorderBrush="#DDD6FE" Background="#FAF5FF"
                                                                 FontSize="12" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF" Margin="0,8,0,0"
                                                           Text="The input frames are re-fit to this size (default 720×1280 portrait). Match your clip's orientation to avoid stretching. Clip length follows the source video."/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ════════════════════════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="*"/>    <!-- Scrollable: result + queue + log -->
                                </Grid.RowDefinitions>

                                <!-- Progress bar -->
                                <ProgressBar Grid.Row="0"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="#7C3AED" Background="#3B1E73" BorderThickness="0"
                                             Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Status row -->
                                <Border Grid.Row="1" Background="#2E1065" BorderBrush="#6D28D9"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#5B3F9E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessingQueue}" Value="True">
                                                                <Setter Property="Fill" Value="#A78BFA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}" FontSize="11" Foreground="#DDD6FE"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#A78BFA" FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Action buttons -->
                                <Border Grid.Row="2" Background="#1E0B47" BorderBrush="#6D28D9"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateVideoCommand}"
                                                IsEnabled="{Binding CanAddToQueue}"
                                                Background="#7C3AED" Foreground="White"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔊 " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate Video Sound" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Height="40" Width="82"
                                                Command="{Binding StopQueueCommand}"
                                                IsEnabled="{Binding IsProcessingQueue}"
                                                Background="#5B3F9E" Foreground="#FCA5A5"
                                                FontSize="11" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Scrollable: result + queue + log -->
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Background="White">
                                    <StackPanel>
                                        <!-- Result -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="0,0,0,1" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="🎬 Result" FontWeight="Bold" FontSize="13"
                                                           Foreground="#7C3AED" Margin="0,0,0,8"/>
                                                <Border BorderBrush="#DDD6FE" BorderThickness="1" Background="#0C0A09"
                                                        Height="260" CornerRadius="6" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="Your video with sound will appear here after generation"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="#57534E" FontStyle="Italic">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <MediaElement x:Name="VideoSoundVideoPlayer"
                                                                      Source="{Binding ResultVideoPath}"
                                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                      Stretch="Uniform"
                                                                      Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                            Command="{Binding PlayVideoCommand}"
                                                            IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                                    <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding OpenResultFolderCommand}"
                                                            IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                                    <Button Content="📷 Send to Edit Camera" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding SendToEditCameraCommand}"
                                                            IsEnabled="{Binding HasResult}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ResultVideoInfo}"
                                                           FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Queue -->
                                        <Border Background="#FAF5FF" BorderBrush="#DDD6FE"
                                                BorderThickness="0,0,0,1" Padding="12,8"
                                                Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🔊 Sound Queue"
                                                               FontWeight="Bold" FontSize="12" Foreground="#7C3AED" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                               FontStyle="Italic" Foreground="#666" FontSize="11"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Content="🔄 Retry"
                                                            Command="{Binding ReprocessAllFailedCommand}"
                                                            IsEnabled="{Binding HasFailedItems}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                            Background="#7C3AED" Foreground="White" BorderThickness="0"/>
                                                    <Button Grid.Column="3" Content="⏹ Stop"
                                                            Command="{Binding StopQueueCommand}"
                                                            IsEnabled="{Binding IsProcessingQueue}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                            Background="#6D28D9" Foreground="White" BorderThickness="0"/>
                                                    <Button Grid.Column="4" Content="🗑️ Clear"
                                                            Command="{Binding ClearQueueCommand}"
                                                            Height="26" Padding="8,0" FontSize="11"
                                                            Background="#DC3545" Foreground="White" BorderThickness="0"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Queue}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4"
                                                                    Padding="10,5" Margin="0,0,0,3" Background="White">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                            Background="{Binding StatusColor}">
                                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                                   FontWeight="SemiBold" Foreground="White"/>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"/>
                                                                        <TextBlock Text="{Binding Prompt}" FontSize="10" Foreground="#666"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2" Content="✕"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="26" Height="26" Padding="0" FontSize="10"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Log - shared panel -->
                                        <ctrl:ProcessingLogPanel LogText="{Binding LogOutput}" MaxLogHeight="130"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- Tab: Seed Director (SeedHunt × LTX Director fusion)             -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🎬 Seed Director">
                        <Grid DataContext="{Binding SeedDirectorVM}" Background="#FFFBEB">
                            <Grid.ColumnDefinitions>
                                <!-- Auto so the drawer takes ZERO width when collapsed → timeline gets the whole page -->
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT DRAWER · Global options (hidden by default, toggled from the toolbar) ═══ -->
                            <Border Grid.Column="0" Width="340" BorderBrush="#FDE68A" BorderThickness="0,0,1,0" Background="#FEFCE8"
                                    Visibility="{Binding IsOptionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Intro -->
                                        <Border Background="#B45309" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🎬 Seed Director" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FEF3C7" Margin="0,4,0,0"
                                                           Text="A timeline of shots — each gets 4 low-res seed previews. Pick a seed (or several) per shot, then join the chosen hi-res clips into one video."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Output -->
                                        <Border Background="White" BorderBrush="#FDE68A" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Ellipse Width="6" Height="6" Fill="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="OUTPUT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="  · applies to all shots" FontSize="10" Foreground="#9CA3AF"/>
                                                </StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Resolution" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding ResolutionChoices}"
                                                                  SelectedItem="{Binding Resolution}"
                                                                  Height="30" FontSize="12" Padding="6,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Orientation" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding OrientationChoices}"
                                                                  SelectedItem="{Binding Orientation}"
                                                                  Height="30" FontSize="12" Padding="6,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="Seed previews are fast &amp; low-res; the final join renders the chosen seeds at this resolution."
                                                           FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Analysis template -->
                                        <Border Background="White" BorderBrush="#FDE68A" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ANALYSIS TEMPLATE" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding PromptTemplates}"
                                                          SelectedItem="{Binding SelectedPromptTemplate, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName" Height="28"
                                                          ToolTip="System prompt sent to llama-server when analyzing each shot's image."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Character LoRA (optional) -->
                                        <Border Background="White" BorderBrush="#FDE68A" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CHARACTER LORA" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="  · optional" FontSize="10" Foreground="#9CA3AF"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0" ItemsSource="{Binding CharacterLoras}"
                                                              SelectedItem="{Binding SelectedCharacterLora, Mode=TwoWay}"
                                                              DisplayMemberPath="DisplayName"
                                                              Height="28" VerticalContentAlignment="Center"
                                                              ToolTip="Scanned from ComfyUI loras/LTX-23/characters. Leave on (none) to skip."/>
                                                    <Button Grid.Column="1" Content="🔄" Command="{Binding RefreshLorasCommand}"
                                                            Width="36" Height="28" Margin="6,0,0,0"
                                                            Background="#F59E0B" Foreground="White" BorderThickness="0"
                                                            ToolTip="Rescan the characters folder"/>
                                                </Grid>
                                                <Grid Visibility="{Binding HasCharacterLora, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Strength" VerticalAlignment="Center"
                                                               Foreground="#A16207" FontSize="11" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CharacterLoraStrength, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="26" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="#FCD34D" ToolTip="LoRA strength (0–3, default 1)."/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ════════════════════════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Timeline strip -->
                                    <RowDefinition Height="Auto"/> <!-- Selected-shot editor -->
                                    <RowDefinition Height="*"/>    <!-- Workspace: seeds | player -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Timeline filmstrip ──────────────────────────────────── -->
                                <Border Grid.Row="0" Background="#1C1917" Padding="12,10"
                                        AllowDrop="True" Drop="SeedDirectorTimeline_Drop" DragOver="SeedDirectorTimeline_DragOver">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding OptionsToggleLabel}" Command="{Binding ToggleOptionsCommand}"
                                                        Height="28" Padding="10,0" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0"
                                                        Background="#292524" Foreground="#FBBF24" BorderThickness="1" BorderBrush="#44403C"
                                                        ToolTip="Show/hide output resolution, analysis template &amp; character LoRA settings"/>
                                                <TextBlock Text="🎬" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="TIMELINE" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TimelineSummary}" FontSize="11" Foreground="#A8A29E"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Analyzing…" FontStyle="Italic" FontSize="10" Foreground="#FBBF24"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Button Content="＋ Add images" Command="{Binding AddImagesCommand}"
                                                        Height="28" Padding="12,0" FontSize="11" FontWeight="SemiBold"
                                                        Background="#292524" Foreground="#FBBF24" BorderThickness="1" BorderBrush="#44403C" Margin="0,0,6,0"/>
                                                <Button Content="💾" Command="{Binding SaveProjectCommand}"
                                                        Height="28" Width="34" FontSize="12"
                                                        Background="#292524" Foreground="#FBBF24" BorderThickness="1" BorderBrush="#44403C" Margin="0,0,6,0"
                                                        ToolTip="Save this timeline (image paths, prompts, durations) so the analysis survives a restart"/>
                                                <Button Content="📂" Command="{Binding LoadProjectCommand}"
                                                        Height="28" Width="34" FontSize="12"
                                                        Background="#292524" Foreground="#FBBF24" BorderThickness="1" BorderBrush="#44403C" Margin="0,0,6,0"
                                                        ToolTip="Restore a saved timeline (or the auto-recovered last session) — prompts come back without re-analyzing"/>
                                                <Button Content="🎬 Analyze → Seeds" Command="{Binding GenerateAllSeedsCommand}"
                                                        IsEnabled="{Binding CanGenerateSeeds}"
                                                        Height="28" Padding="14,0" FontSize="11" FontWeight="Bold"
                                                        Background="#D97706" Foreground="White" BorderThickness="0" Margin="0,0,6,0"
                                                        ToolTip="Analyze every shot's image one-by-one, then automatically generate 4 seed previews for each"/>
                                                <Button Content="🗑️" Command="{Binding ClearTimelineCommand}"
                                                        Height="28" Width="34" FontSize="12"
                                                        Background="#292524" Foreground="#F87171" BorderThickness="0"
                                                        ToolTip="Clear timeline"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Empty state -->
                                        <Border Height="72" CornerRadius="8" BorderThickness="1.5"
                                                BorderBrush="#44403C" Background="#0C0A09">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTimeline}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock Text="🖼️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Drag images here, or click ＋ Add images"
                                                               Foreground="#A8A29E" FontSize="12"/>
                                                    <TextBlock Text="Each image becomes a shot with its own prompt, duration &amp; 4 seed previews"
                                                               Foreground="#78716C" FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Filmstrip -->
                                        <ListBox x:Name="SeedDirectorFilmstrip"
                                                 ItemsSource="{Binding Timeline}"
                                                 SelectedItem="{Binding SelectedShot, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 Visibility="{Binding HasTimeline, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="cardBorder" CornerRadius="8"
                                                                        BorderThickness="2" BorderBrush="#292524"
                                                                        Background="#0C0A09">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="#F59E0B"/>
                                                                        <Setter TargetName="cardBorder" Property="Background" Value="#1C1410"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="92" Margin="4">
                                                        <StackPanel>
                                                            <Border CornerRadius="4" Height="48" ClipToBounds="True" Background="#000000">
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                            </Border>
                                                            <Grid Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding IndexLabel}" FontSize="11" FontWeight="Bold"
                                                                           Foreground="#FBBF24" VerticalAlignment="Center"/>
                                                                <Border HorizontalAlignment="Right" CornerRadius="3"
                                                                        Background="#292524" Padding="5,1">
                                                                    <TextBlock Text="{Binding DurationLabel}" FontSize="10"
                                                                               FontFamily="Consolas" Foreground="#D6D3D1"/>
                                                                </Border>
                                                            </Grid>
                                                            <Border CornerRadius="3" Background="#14532D" Padding="5,1" Margin="0,3,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Visibility="{Binding HasSelectedSeed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#86EFAC"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <!-- Remove overlay -->
                                                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Width="20" Height="20" FontSize="10" Padding="0"
                                                                Background="#DC2626" Foreground="White" BorderThickness="0"
                                                                Command="{Binding DataContext.RemoveShotCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Selected-shot editor (compact single row) ───────────── -->
                                <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="0,1,0,1"
                                        Padding="12,6"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="EDITING" FontSize="9" FontWeight="Bold" Foreground="#92400E"/>
                                            <TextBlock Text="{Binding SelectedShot.IndexLabel}" FontSize="13" FontWeight="Bold" Foreground="#D97706"/>
                                        </StackPanel>

                                        <TextBox Grid.Column="1" Text="{Binding SelectedShot.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 Height="48" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                 BorderBrush="#FCD34D" Background="White"
                                                 FontSize="12" Padding="8,4" Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Duration (s)" FontSize="9" Foreground="#92400E" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedShot.DurationSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.0}}"
                                                         Width="56" Height="28" Padding="6,0" VerticalContentAlignment="Center"
                                                         BorderBrush="#FCD34D" Background="White"
                                                         FontSize="13" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <Button Content="↤" Command="{Binding MoveLeftCommand}" ToolTip="Move shot left"
                                                    Width="30" Height="28" FontSize="13" Margin="0,0,4,0"
                                                    Background="#FDE68A" Foreground="#92400E" BorderThickness="0"/>
                                            <Button Content="↦" Command="{Binding MoveRightCommand}" ToolTip="Move shot right"
                                                    Width="30" Height="28" FontSize="13" Margin="0,0,10,0"
                                                    Background="#FDE68A" Foreground="#92400E" BorderThickness="0"/>
                                            <Button Content="🔍 Analyze" Command="{Binding AnalyzeSelectedCommand}"
                                                    IsEnabled="{Binding CanAnalyze}"
                                                    Height="28" Padding="10,0" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"
                                                    Background="#D97706" Foreground="White" BorderThickness="0"
                                                    ToolTip="Generate this shot's motion + audio prompt from its image"/>
                                            <Button Content="🎲 Reroll" Command="{Binding RerollShotCommand}"
                                                    IsEnabled="{Binding CanRerollShot}"
                                                    Height="28" Padding="10,0" FontSize="11" FontWeight="SemiBold"
                                                    Background="#B45309" Foreground="White" BorderThickness="0"
                                                    ToolTip="Generate a fresh batch of 4 seeds for this shot"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ────────────────────────────────────────── -->
                                <ProgressBar Grid.Row="3"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="#D97706" Background="#1C1917" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ──────────────────────────────────────────── -->
                                <Border Grid.Row="4" Background="#1C1917" BorderBrush="#292524"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#44403C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}" FontSize="11" Foreground="#A8A29E"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding JoinHint}" FontSize="11" Foreground="#FBBF24"
                                                       VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#D97706" FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action buttons ──────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="#0F0D0C" BorderBrush="#292524"
                                        BorderThickness="0,1,0,0" Padding="10,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="34"
                                                Command="{Binding GenerateAllSeedsCommand}"
                                                IsEnabled="{Binding CanGenerateSeeds}"
                                                Background="#D97706" Foreground="White"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0"
                                                ToolTip="Re-run analysis (for shots with no prompt) and regenerate all seed previews">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🎲 " VerticalAlignment="Center"/>
                                                <TextBlock Text="Regenerate Seeds" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Height="34"
                                                Command="{Binding CreateJoinedVideoCommand}"
                                                IsEnabled="{Binding CanCreateJoined}"
                                                Background="#16A34A" Foreground="White"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0"
                                                ToolTip="Render the chosen seeds at full resolution and join the shots into one video">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✅ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Create Joined Video(s)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Height="34" Width="82" Margin="8,0,0,0"
                                                Command="{Binding StopCommand}"
                                                IsEnabled="{Binding IsProcessing}"
                                                Background="#292524" Foreground="#F87171"
                                                FontSize="11" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Workspace: seeds | (drag) | player — proportional with min-widths -->
                                <!-- so neither side collapses and the seed-grid header can never char-wrap. -->
                                <Grid Grid.Row="2" Background="White">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" MinWidth="360"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2*" MinWidth="340"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: big seed grid for the selected shot -->
                                    <Grid Grid.Column="0" Margin="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Seeds for the selected shot — click a tile to preview • check ✓ to keep it for the join"
                                                   FontWeight="Bold" Foreground="#92400E" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <Border Grid.Row="1" Background="#FFFBEB" CornerRadius="6" Padding="6"
                                                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl ItemsSource="{Binding SelectedShot.Samples}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="4" Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="4" CornerRadius="6" Background="#1F2937" BorderThickness="3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#FCD34D"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#16A34A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" Foreground="#9CA3AF" FontStyle="Italic">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ThumbnailImage}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                                                <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                                                        Background="#CC000000" CornerRadius="0,0,6,0" Padding="6,2">
                                                                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                        ToolTip="Click to preview in the player below"
                                                                        Command="{Binding DataContext.PreviewSampleCommand,
                                                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="Transparent"/>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                                <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                                        Background="#CC000000" CornerRadius="0,6,0,6" Padding="6,3"
                                                                        Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              Foreground="White" FontSize="10" FontWeight="Bold"
                                                                              Content="Keep" Cursor="Hand"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="Select a shot in the timeline to see and pick its seeds."
                                                   Foreground="#A16207" FontStyle="Italic" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Draggable divider so the user can rebalance seeds vs. player -->
                                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" Background="#FDE68A"
                                                  ShowsPreview="True" ResizeBehavior="PreviousAndNext"
                                                  ToolTip="Drag to resize the seed grid and player"/>

                                    <!-- Right: player + joined results -->
                                    <Grid Grid.Column="2" Margin="12,12,12,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Shared player -->
                                        <Border Grid.Row="0" CornerRadius="6"
                                                Background="#111827" BorderBrush="#16A34A" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="Click a seed to preview it here • the joined video plays here after Create Joined Video"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                           TextWrapping="Wrap" Margin="20,0" Foreground="#9CA3AF" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasActivePreview}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="SeedDirectorPlayer" Source="{Binding ActivePreviewUri}"
                                                              Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              IsMuted="{Binding IsPreviewMuted}"
                                                              MediaOpened="SeedDirectorPlayer_MediaOpened"
                                                              MediaEnded="SeedDirectorPlayer_MediaEnded"
                                                              Visibility="{Binding HasActivePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Results + player controls -->
                                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Joined:" VerticalAlignment="Center" FontWeight="SemiBold"
                                                           Foreground="#92400E" FontSize="11" Margin="0,0,8,0"/>
                                                <ItemsControl ItemsSource="{Binding Results}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Label}" ToolTip="{Binding Info}"
                                                                    Command="{Binding DataContext.PlayResultCommand,
                                                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Height="26" Padding="10,0" Margin="0,0,6,0"
                                                                    Background="#15803D" Foreground="White" BorderThickness="0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="▶ Replay" Click="SeedDirectorReplay_Click"
                                                        IsEnabled="{Binding HasActivePreview}" Height="28" Padding="10,0" Margin="0,0,8,0"
                                                        Background="#16A34A" Foreground="White" BorderThickness="0"/>
                                                <Button Content="{Binding MuteIcon}" Command="{Binding ToggleMuteCommand}"
                                                        Height="28" Padding="10,0" Margin="0,0,8,0"
                                                        Background="#B45309" Foreground="White" BorderThickness="0"
                                                        ToolTip="Mute/unmute the preview player"/>
                                                <Button Content="📁 Open Folder" Command="{Binding OpenResultFolderCommand}"
                                                        IsEnabled="{Binding HasResult}" Height="28" Padding="10,0" Margin="0,0,8,0"
                                                        Background="#6B7280" Foreground="White" BorderThickness="0"/>
                                                <TextBlock Text="{Binding ResultVideoInfo}" VerticalAlignment="Center"
                                                           FontStyle="Italic" Foreground="#92400E" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- ─── Log (collapsed by default) ──────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="120"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════ FFLF-DASIWA TAB ═══════════════════════ -->
                    <TabItem Header="🔗 FFLF-Dasiwa">
                        <Grid DataContext="{Binding FflfDasiwaVM}" Background="#ECFEFF">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL · Inputs ════════════════════════════════════ -->
                            <Border Grid.Column="0" BorderBrush="#A5F3FC" BorderThickness="0,0,1,0" Background="#F0FDFF">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Intro -->
                                        <Border Background="#0E7490" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🔗 FFLF-Dasiwa Chain" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#CFFAFE" Margin="0,4,0,0"
                                                           Text="Upload one image and analyze it. Each clip's last frame becomes the next clip's first frame (re-analyzed automatically). Pick how many links to chain — the segments are joined into one continuous video."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- First frame image -->
                                        <Border Background="White" BorderBrush="#A5F3FC" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#0891B2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="FIRST FRAME" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <Border Height="150" Background="#F0FDFF" BorderBrush="#A5F3FC" BorderThickness="1"
                                                        CornerRadius="6" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No image selected" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Foreground="#9CA3AF" FontStyle="Italic"
                                                                   Visibility="{Binding HasFirstImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                        <Image Source="{Binding FirstImagePreview}" Stretch="Uniform" Margin="4"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding FirstImageInfo}" FontSize="10" Foreground="#6B7280" Margin="0,0,0,8"/>
                                                <Button Content="📁 Select Image" Command="{Binding SelectImageCommand}"
                                                        Height="30" Background="#0891B2" Foreground="White" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Analyze + prompt -->
                                        <Border Background="White" BorderBrush="#A5F3FC" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#0891B2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="PROMPT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <Button Content="🔍 Analyze First Frame" Command="{Binding AnalyzeCommand}"
                                                        Height="30" Margin="0,0,0,8"
                                                        Background="#06B6D4" Foreground="White" BorderThickness="0"
                                                        ToolTip="Send the first frame to llama-server (dasiwa-fflf.md) to write the segment-1 prompt."/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70" MaxHeight="140"
                                                         VerticalScrollBarVisibility="Auto" Padding="6" BorderBrush="#A5F3FC"
                                                         ToolTip="Prompt used for segment 1. Later segments are auto-analyzed from each extracted frame."/>
                                                <Expander Header="Negative prompt" FontSize="11" Foreground="#6B7280" Margin="0,8,0,0">
                                                    <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="120"
                                                             VerticalScrollBarVisibility="Auto" Padding="6" BorderBrush="#A5F3FC" Margin="0,4,0,0"/>
                                                </Expander>
                                            </StackPanel>
                                        </Border>

                                        <!-- Chain settings -->
                                        <Border Background="White" BorderBrush="#A5F3FC" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#0891B2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CHAIN SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Iterations (links in the chain)"
                                                               VerticalAlignment="Center" Foreground="#155E75" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Iterations}" FontWeight="Bold"
                                                               Foreground="#0E7490" FontSize="13" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Slider Minimum="1" Maximum="5" Value="{Binding Iterations}"
                                                        IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight"
                                                        Margin="0,0,0,10"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Seconds / clip" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding LengthSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="28" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#A5F3FC"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                                     Height="28" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#A5F3FC"/>
                                                            <Button Grid.Column="1" Content="🎲" Command="{Binding RandomSeedCommand}"
                                                                    Width="34" Height="28" Margin="4,0,0,0"
                                                                    Background="#0891B2" Foreground="White" BorderThickness="0"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="Fresh random seed is used per segment when Seed is -1."
                                                           FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ════════════════════════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Segments filmstrip -->
                                    <RowDefinition Height="*"/>    <!-- Player -->
                                    <RowDefinition Height="Auto"/> <!-- Progress -->
                                    <RowDefinition Height="Auto"/> <!-- Action bar -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- Segments filmstrip -->
                                <Border Grid.Row="0" Background="#F0FDFF" BorderBrush="#A5F3FC" BorderThickness="0,0,0,1" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="CHAIN SEGMENTS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <ListBox ItemsSource="{Binding Segments}"
                                                 SelectedItem="{Binding SelectedSegment, Mode=TwoWay}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 Background="Transparent" BorderThickness="0" Height="64">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0E7490" CornerRadius="6" Padding="14,8" Margin="0,0,8,0">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Seed}" Foreground="#A5F3FC" FontSize="9"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="Segments appear here as each clip finishes — click one to preview it."
                                                   FontSize="10" Foreground="#9CA3AF" FontStyle="Italic" Margin="0,4,0,0"
                                                   Visibility="{Binding HasSegments, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Shared player -->
                                <Border Grid.Row="1" Margin="12" CornerRadius="6"
                                        Background="#111827" BorderBrush="#06B6D4" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Generate a chain — segments and the joined video play here."
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap" Margin="20,0" Foreground="#9CA3AF" FontStyle="Italic"
                                                   Visibility="{Binding HasActivePreview, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <MediaElement x:Name="FflfDasiwaPlayer" Source="{Binding ActivePreviewUri}"
                                                      Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      MediaOpened="FflfDasiwaPlayer_MediaOpened"
                                                      MediaEnded="FflfDasiwaPlayer_MediaEnded"
                                                      Visibility="{Binding HasActivePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Progress -->
                                <Grid Grid.Row="2" Margin="12,0,12,6">
                                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProcessingProgress}"
                                                 Background="#CFFAFE" Foreground="#06B6D4" BorderThickness="0"/>
                                </Grid>

                                <!-- Action bar -->
                                <Border Grid.Row="3" Background="#F0FDFF" BorderBrush="#A5F3FC" BorderThickness="0,1,0,0" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🎬 Generate Chain" Command="{Binding RunChainCommand}"
                                                Height="32" Padding="16,0" Margin="0,0,8,0" FontWeight="Bold"
                                                Background="#0E7490" Foreground="White" BorderThickness="0"/>
                                        <Button Content="✕ Cancel" Command="{Binding CancelCommand}"
                                                Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Background="#B91C1C" Foreground="White" BorderThickness="0"/>
                                        <Button Content="▶ Replay" Click="FflfDasiwaReplay_Click"
                                                IsEnabled="{Binding HasActivePreview}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Background="#06B6D4" Foreground="White" BorderThickness="0"/>
                                        <Button Content="📁 Open Folder" Command="{Binding OpenResultFolderCommand}"
                                                IsEnabled="{Binding HasResult}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Background="#6B7280" Foreground="White" BorderThickness="0"/>
                                        <TextBlock Text="{Binding ProcessingStatus}" VerticalAlignment="Center"
                                                   FontStyle="Italic" Foreground="#155E75" FontSize="11" Margin="4,0,0,0"/>
                                        <TextBlock Text="{Binding ResultVideoInfo}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="#0E7490" FontSize="11" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Log -->
                                <ctrl:ProcessingLogPanel Grid.Row="4" LogText="{Binding LogOutput}" MaxLogHeight="120"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <!-- Tab: FFLF Seed Hunter (first+last frame → 3 seeds → finish)        -->
                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🎯 FFLF Seed Hunter">
                        <Grid DataContext="{Binding FflfSeedHuntVM}" Background="#F5F3FF">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL · Inputs ════════════════════════════════════ -->
                            <Border Grid.Column="0" BorderBrush="#DDD6FE" BorderThickness="0,0,1,0" Background="#FAF8FF">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Intro -->
                                        <Border Background="#6D28D9" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🎯 FFLF Seed Hunter" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#EDE9FE" Margin="0,4,0,0"
                                                           Text="Upload a first and last frame, then Analyze to write the action that bridges them. Generate 3 seed previews (reroll for fresh seeds), pick one, then Finish to upscale it (Stage 2 → Stage 3)."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Folder batch -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="FOLDER BATCH" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <Button Content="📂 Load Folder of Images" Command="{Binding SelectFolderCommand}"
                                                        Height="30" Background="#7C3AED" Foreground="White" BorderThickness="0"
                                                        ToolTip="Pick a folder; images are ordered by creation time into overlapping first→last pairs, then analyzed and seed-hunted automatically."/>
                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding BatchInfo}" FontSize="11" FontWeight="Bold" Foreground="#6D28D9"/>
                                                    <TextBlock Text="Selected pair prompt:" FontSize="9" Foreground="#9CA3AF" Margin="0,6,0,2"/>
                                                    <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1"
                                                            CornerRadius="4" Padding="6" MaxHeight="120">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <TextBlock Text="{Binding SelectedPair.Prompt}" TextWrapping="Wrap"
                                                                       FontSize="10" Foreground="#374151"/>
                                                        </ScrollViewer>
                                                    </Border>
                                                    <Button Content="✕ Exit Batch Mode" Command="{Binding ClearFolderCommand}"
                                                            Height="26" Margin="0,8,0,0" Background="#6B7280" Foreground="White" BorderThickness="0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- First + Last frame images -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10"
                                                Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="FIRST FRAME" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                    </StackPanel>
                                                    <Border Height="120" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1"
                                                            CornerRadius="6" Margin="0,0,0,8">
                                                        <Grid>
                                                            <TextBlock Text="none" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="#9CA3AF" FontStyle="Italic"
                                                                       Visibility="{Binding HasFirstImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                            <Image Source="{Binding FirstImagePreview}" Stretch="Uniform" Margin="4"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding FirstImageInfo}" FontSize="9" Foreground="#6B7280" Margin="0,0,0,6"/>
                                                    <Button Content="📁 First" Command="{Binding SelectFirstImageCommand}"
                                                            Height="28" Background="#7C3AED" Foreground="White" BorderThickness="0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="LAST FRAME" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                    </StackPanel>
                                                    <Border Height="120" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1"
                                                            CornerRadius="6" Margin="0,0,0,8">
                                                        <Grid>
                                                            <TextBlock Text="none" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="#9CA3AF" FontStyle="Italic"
                                                                       Visibility="{Binding HasLastImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                            <Image Source="{Binding LastImagePreview}" Stretch="Uniform" Margin="4"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding LastImageInfo}" FontSize="9" Foreground="#6B7280" Margin="0,0,0,6"/>
                                                    <Button Content="📁 Last" Command="{Binding SelectLastImageCommand}"
                                                            Height="28" Background="#7C3AED" Foreground="White" BorderThickness="0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Analyze + prompt -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,0,0,10"
                                                Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="PROMPT" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <Button Content="🔍 Analyze First + Last" Command="{Binding AnalyzeCommand}"
                                                        Height="30" Margin="0,0,0,8"
                                                        Background="#8B5CF6" Foreground="White" BorderThickness="0"
                                                        ToolTip="Send both frames to llama-server (fflf-seedhunter.md) to write the FFLF transition prompt."/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="160"
                                                         VerticalScrollBarVisibility="Auto" Padding="6" BorderBrush="#DDD6FE"
                                                         ToolTip="The action that bridges the first frame to the last frame. Edit freely before generating."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Generation settings -->
                                        <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                                </StackPanel>

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Seconds" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding LengthSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="28" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#DDD6FE"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" Text="{Binding BaseSeed, UpdateSourceTrigger=PropertyChanged}"
                                                                     Height="28" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#DDD6FE"/>
                                                            <Button Grid.Column="1" Content="🎲" Command="{Binding RandomSeedCommand}"
                                                                    Width="34" Height="28" Margin="4,0,0,0"
                                                                    Background="#7C3AED" Foreground="White" BorderThickness="0"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="First-frame reference strength"
                                                               VerticalAlignment="Center" Foreground="#5B21B6" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding InputRefStrength, StringFormat={}{0:0.00}}"
                                                               FontWeight="Bold" Foreground="#6D28D9" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="1" Value="{Binding InputRefStrength}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Last-frame reference strength"
                                                               VerticalAlignment="Center" Foreground="#5B21B6" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding EndRefStrength, StringFormat={}{0:0.00}}"
                                                               FontWeight="Bold" Foreground="#6D28D9" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="1" Value="{Binding EndRefStrength}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
                                                <TextBlock Text="Best 0.6–0.9. Higher sticks closer to the uploaded frames."
                                                           FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ════════════════════════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Pairs list (batch) -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Pairs list — one per overlapping first→last pair (batch mode) -->
                                <Border Grid.Column="0" Width="220" Background="#FAF8FF"
                                        BorderBrush="#DDD6FE" BorderThickness="0,0,1,0"
                                        Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="PAIRS — click to review &amp; pick"
                                                   FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="10,8,10,6"/>
                                        <ListBox ItemsSource="{Binding Pairs}" SelectedItem="{Binding SelectedPair, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="6,3"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="sel" CornerRadius="7" Padding="2"
                                                                        BorderThickness="2" BorderBrush="Transparent">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="sel" Property="BorderBrush" Value="#7C3AED"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Background="White" BorderBrush="#DDD6FE"
                                                            BorderThickness="1" Padding="6">
                                                        <StackPanel>
                                                            <Grid Height="46">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="14"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Image Grid.Column="0" Source="{Binding FirstThumb}" Stretch="UniformToFill"/>
                                                                <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center" Foreground="#7C3AED" FontWeight="Bold"/>
                                                                <Image Grid.Column="2" Source="{Binding LastThumb}" Stretch="UniformToFill"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#374151"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                            <Grid Margin="0,2,0,0">
                                                                <TextBlock HorizontalAlignment="Left" Text="{Binding StatusText}"
                                                                           FontSize="9" Foreground="#7C3AED"/>
                                                                <TextBlock HorizontalAlignment="Right" FontSize="9" FontWeight="Bold"
                                                                           Foreground="#059669"
                                                                           Text="{Binding SelectedCount, StringFormat=✓{0} queued}"
                                                                           Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Sample tiles -->
                                    <RowDefinition Height="*"/>    <!-- Player -->
                                    <RowDefinition Height="Auto"/> <!-- Results strip -->
                                    <RowDefinition Height="Auto"/> <!-- Progress -->
                                    <RowDefinition Height="Auto"/> <!-- Action bar -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- Sample tiles -->
                                <Border Grid.Row="0" Background="#FAF8FF" BorderBrush="#DDD6FE" BorderThickness="0,0,0,1" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="SEED SAMPLES — click to preview, tick to queue for Finish"
                                                   FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <ListBox ItemsSource="{Binding Samples}"
                                                 SelectedItem="{Binding SelectedSampleForPreview, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="3"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="3"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="tile" CornerRadius="6" BorderThickness="2"
                                                                        Background="#111827" BorderBrush="#312E81">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="tile" Property="BorderBrush" Value="#8B5CF6"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="96" Background="Transparent" ToolTip="Click to preview this sample">
                                                        <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4"
                                                                   Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                        <CheckBox Content="Queue" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Foreground="White" FontSize="10" FontWeight="Bold"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,4"
                                                                  Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="#A5B4FC" FontSize="9"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <!-- Shared player -->
                                <Border Grid.Row="1" Margin="12" CornerRadius="6"
                                        Background="#111827" BorderBrush="#8B5CF6" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Generate 3 samples, then click one to preview it here. The final upscaled video plays here after Finish."
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap" Margin="20,0" Foreground="#9CA3AF" FontStyle="Italic"
                                                   Visibility="{Binding HasActivePreview, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <MediaElement x:Name="FflfSeedHuntPlayer" Source="{Binding ActivePreviewUri}"
                                                      Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      MediaOpened="FflfSeedHuntPlayer_MediaOpened"
                                                      MediaEnded="FflfSeedHuntPlayer_MediaEnded"
                                                      MediaFailed="FflfSeedHuntPlayer_MediaFailed"
                                                      Visibility="{Binding HasActivePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Results strip -->
                                <Border Grid.Row="2" Background="#FAF8FF" BorderBrush="#DDD6FE" BorderThickness="0,1,0,0" Padding="12,6"
                                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="FINISHED VIDEOS — click to replay" FontSize="10" FontWeight="Bold"
                                                   Foreground="#6B7280" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Results}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.PlayResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,8,0" Padding="10,4"
                                                            Background="#6D28D9" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="11"/>
                                                            <TextBlock Text="{Binding Info}" FontSize="9" Foreground="#DDD6FE"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Progress -->
                                <Grid Grid.Row="3" Margin="12,6,12,6">
                                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProcessingProgress}"
                                                 Background="#EDE9FE" Foreground="#8B5CF6" BorderThickness="0"/>
                                </Grid>

                                <!-- Action bar -->
                                <Border Grid.Row="4" Background="#FAF8FF" BorderBrush="#DDD6FE" BorderThickness="0,1,0,0" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="▶ Run Batch — analyze + 3 seeds / pair" Command="{Binding RunBatchCommand}"
                                                Height="32" Padding="16,0" Margin="0,0,8,0" FontWeight="Bold"
                                                Background="#6D28D9" Foreground="White" BorderThickness="0"
                                                Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Walk every pair: analyze the transition then generate 3 seed previews. Failed pairs are skipped."/>
                                        <Button Content="{Binding HuntButtonText}" Command="{Binding HuntCommand}"
                                                Height="32" Padding="16,0" Margin="0,0,8,0" FontWeight="Bold"
                                                Background="#6D28D9" Foreground="White" BorderThickness="0"
                                                Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Button Content="{Binding FinishButtonText}" Command="{Binding FinishCommand}"
                                                Height="32" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold"
                                                Background="#059669" Foreground="White" BorderThickness="0"/>
                                        <Button Content="✕ Cancel" Command="{Binding CancelCommand}"
                                                Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Background="#B91C1C" Foreground="White" BorderThickness="0"/>
                                        <Button Content="📁 Open Folder" Command="{Binding OpenResultFolderCommand}"
                                                IsEnabled="{Binding HasResult}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Background="#6B7280" Foreground="White" BorderThickness="0"/>
                                        <TextBlock Text="{Binding ProcessingStatus}" VerticalAlignment="Center"
                                                   FontStyle="Italic" Foreground="#5B21B6" FontSize="11" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Log -->
                                <ctrl:ProcessingLogPanel Grid.Row="5" LogText="{Binding LogOutput}" MaxLogHeight="120"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
