<Window x:Class="FlipPix.UI.VideoGeneratorWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:FlipPix.UI.Converters"
        xmlns:ctrl="clr-namespace:FlipPix.UI.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="FlipPix - Video Generator" Height="750" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="650" MinWidth="850"
        ResizeMode="CanResize">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource BrandColor}"/>
            </Border.Background>
            <StackPanel Margin="20,8" Orientation="Horizontal">
                <TextBlock Text="🎬 Video Generator"
                          FontSize="18" FontWeight="Bold"
                          Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="Generate videos from images using AI — upload an image and describe the motion"
                          FontSize="11" Foreground="#E6FFFFFF"
                          VerticalAlignment="Center" Margin="14,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="15,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Navigate:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="Image Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToImageGeneratorCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="2" Margin="15,10,15,10" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                    <!-- Tab 2: Story Video Generator -->
                    <TabItem Header="📖 Story Video Generator">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Workflow Selection -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="LTX Workflow"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox SelectedIndex="{Binding SelectedStoryWorkflowIndex, Mode=TwoWay}"
                                                  Height="32"
                                                  FontSize="13">
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🟢 Vantage Sulphur 2" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Vantage-Sulphur-2-WorkflowAPI.json" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🟠 10Eros InstantAction" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="10Eros_10SNodes_InstantAction_I2VAPI.json" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔵 LTX-22-B" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="LTX-22-B.json" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🟣 DaSiWa WAN 2.2" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="DasiwaWan22WorkflowsI2VSVI2_fastfidelityCAioV83API.json" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔴 WAN 2.2 FunCamera I2V" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="WAN22-I2V-API.json" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Story Setup Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📁 Story Setup" Style="{StaticResource HeaderTextStyle}"/>

                                        <!-- Prompt JSON File Selection -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="1. Select prompts file (.json or .txt) — or select the images folder below to auto-detect"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📄 Select Prompts File"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SelectStoryPromptJsonCommand}"
                                                   Height="35"
                                                   Width="160"/>
                                        </Grid>

                                        <TextBox Text="{Binding StoryPromptJsonPath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                FontSize="11"
                                                Margin="0,0,0,15"
                                                VerticalAlignment="Center"/>

                                        <!-- Images Folder Selection -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="2. Select the folder containing the 10 generated story images"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Select Images Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SelectStoryImagesFolderCommand}"
                                                   Height="35"
                                                   Width="170"/>
                                        </Grid>

                                        <TextBox Text="{Binding StoryImagesFolderPath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                FontSize="11"
                                                Margin="0,0,0,10"
                                                VerticalAlignment="Center"/>

                                        <!-- Load Queue Button -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="3. Load the queue with images and prompts"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📥 Load Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding LoadStoryQueueCommand}"
                                                   IsEnabled="{Binding CanLoadStoryQueue}"
                                                   Height="35"
                                                   Width="140"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Story Queue Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎞️ Story Video Queue" Style="{StaticResource HeaderTextStyle}"/>

                                        <!-- Queue Controls -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="{Binding StoryQueueStatus}"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Foreground="#666"/>

                                            <Button Grid.Column="1"
                                                   Content="▶️ Process Queue"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding ProcessStoryQueueCommand}"
                                                   IsEnabled="{Binding CanProcessStoryQueue}"
                                                   Height="35"
                                                   Width="140"
                                                   Margin="0,0,5,0"/>

                                            <Button Grid.Column="2"
                                                   Content="🔄 Retry Failed"
                                                   Command="{Binding ReprocessAllStoryFailedCommand}"
                                                   IsEnabled="{Binding HasStoryFailedItems}"
                                                   Height="35"
                                                   Width="110"
                                                   Margin="0,0,5,0"
                                                   Style="{StaticResource AccentButtonStyle}"
                                                   BorderThickness="0" FontWeight="SemiBold"/>

                                            <Button Grid.Column="3"
                                                   Content="⏹ Stop"
                                                   Command="{Binding StopStoryQueueCommand}"
                                                   IsEnabled="{Binding IsProcessingStoryQueue}"
                                                   Height="35"
                                                   Width="80"
                                                   Margin="0,0,5,0"
                                                   Style="{StaticResource AccentButtonStyle}"
                                                   BorderThickness="0" FontWeight="SemiBold"/>

                                            <Button Grid.Column="4"
                                                   Content="🗑️ Clear Queue"
                                                   Command="{Binding ClearStoryQueueCommand}"
                                                   Height="35"
                                                   Width="110"
                                                   Style="{StaticResource DangerButtonStyle}"/>
                                        </Grid>

                                        <!-- Pause/Resume Controls (Story Video Queue) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                                    Visibility="{Binding IsProcessingStoryQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Content="⏸ Pause" Width="100" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding PauseStoryQueueCommand}"
                                                    Style="{StaticResource AccentButtonStyle}" FontWeight="SemiBold"/>
                                            <Button Content="▶ Resume" Width="100" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding ResumeStoryQueueCommand}"
                                                    Style="{StaticResource SuccessButtonStyle}" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Progress Display -->
                                        <Border Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="12"
                                                Visibility="{Binding IsProcessingStoryQueue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                              Text="{Binding StoryQueueStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,5"
                                                              VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding StoryQueueProgressText}"
                                                              FontWeight="Bold"
                                                              FontSize="12"
                                                              Foreground="{StaticResource TextPrimaryBrush}"
                                                              VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Current Item Info -->
                                                <TextBlock Text="Current:"
                                                          FontSize="10"
                                                          FontWeight="SemiBold"
                                                          Margin="0,5,0,3"/>

                                                <TextBlock Text="{Binding CurrentStoryQueueItem.Index, StringFormat='Prompt #{0}'}"
                                                          FontSize="11"
                                                          Margin="10,0,0,0"/>

                                                <ProgressBar Value="{Binding CurrentStoryQueueItem.Progress}"
                                                            Height="16"
                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                            Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Storyboard hint -->
                                        <TextBlock Text="Click a clip to play it. Edit the prompt below, then click Regenerate to redo that clip."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,12"/>

                                        <!-- Storyboard cards -->
                                        <ItemsControl ItemsSource="{Binding StoryVideoQueue}"
                                                      x:Name="StoryVideoStoryboardControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="240"
                                                            Margin="6,6"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12">
                                                        <StackPanel Margin="12">

                                                            <!-- Clip label + delete button + status badge -->
                                                            <Grid Margin="0,0,0,8">
                                                                <TextBlock Text="{Binding Index, StringFormat='Clip #{0}'}"
                                                                           FontWeight="Bold"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <!-- Delete X button -->
                                                                <Button HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,-6,-6,0"
                                                                        Width="18" Height="18"
                                                                        Padding="0"
                                                                        Background="{StaticResource SurfaceAltBrush}"
                                                                        BorderThickness="0"
                                                                        FontSize="9"
                                                                        FontWeight="Bold"
                                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                                        Content="✕"
                                                                        ToolTip="Delete clip"
                                                                        Command="{Binding DataContext.DeleteStoryItemCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource DangerButtonStyle}"/>
                                                                <!-- Status badge -->
                                                                <Border HorizontalAlignment="Right"
                                                                        CornerRadius="8"
                                                                        Padding="7,2"
                                                                        Margin="0,0,24,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding Status}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Video thumbnail area (click to play) -->
                                                            <Border Height="155"
                                                                    Background="{StaticResource SurfaceAltBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    ClipToBounds="True"
                                                                    Margin="0,0,0,10"
                                                                    Cursor="Hand">
                                                                <Border.InputBindings>
                                                                    <MouseBinding Command="{Binding OpenImageCommand}" MouseAction="LeftClick"/>
                                                                </Border.InputBindings>
                                                                <Grid>
                                                                    <!-- Extracted first-frame thumbnail -->
                                                                    <Image Source="{Binding VideoThumbnailImage}"
                                                                           Stretch="UniformToFill"
                                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasVideoThumbnail}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                    <!-- Play button overlay on thumbnail -->
                                                                    <Border Background="{StaticResource ScrimBrush}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasVideoThumbnail}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="▶"
                                                                                   FontSize="36"
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <!-- Icon/status fallback when no thumbnail yet -->
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasVideoThumbnail}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <!-- Icon changes by status -->
                                                                        <TextBlock HorizontalAlignment="Center" FontSize="40">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="🎬"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                            <Setter Property="Text" Value="⚙️"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                            <Setter Property="Text" Value="▶"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                            <Setter Property="Text" Value="❌"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock FontSize="11"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   HorizontalAlignment="Center"
                                                                                   Margin="0,4,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{Binding Status}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                            <Setter Property="Text" Value="Click to play"/>
                                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <!-- Progress bar while processing -->
                                                                        <ProgressBar Value="{Binding Progress}"
                                                                                     Maximum="100"
                                                                                     Height="4"
                                                                                     Width="120"
                                                                                     Margin="0,6,0,0"
                                                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                                                     Background="{StaticResource SurfaceAltBrush}"
                                                                                     BorderThickness="0">
                                                                            <ProgressBar.Style>
                                                                                <Style TargetType="ProgressBar">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ProgressBar.Style>
                                                                        </ProgressBar>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Editable prompt -->
                                                            <TextBox Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextWrapping="Wrap"
                                                                     AcceptsReturn="False"
                                                                     Height="80"
                                                                     Padding="8"
                                                                     VerticalScrollBarVisibility="Auto"
                                                                     Background="White"
                                                                     BorderBrush="{StaticResource BorderBrush}"
                                                                     FontSize="11"
                                                                     VerticalContentAlignment="Top"
                                                                     Margin="0,0,0,8"
                                                                     ToolTip="Edit this prompt and click Regenerate">
                                                                <TextBox.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="6"/>
                                                                    </Style>
                                                                </TextBox.Resources>
                                                            </TextBox>

                                                            <!-- Regenerate button -->
                                                            <Button Content="🔄 Regenerate"
                                                                    Command="{Binding DataContext.RegenerateStoryItemCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalAlignment="Stretch"
                                                                    Height="32"
                                                                    Foreground="White"
                                                                    BorderThickness="0"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Style="{StaticResource PrimaryButtonStyle}"/>

                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>

                                <!-- Join Clips Section -->
                                <Border Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,12,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StoryVideoQueue.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="🔗 Join All Clips"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="Concatenate all completed clips with FFmpeg and save to your Videos folder."
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="🔗 Join Clips"
                                                Command="{Binding JoinClipsCommand}"
                                                Height="40"
                                                Padding="20,0"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SuccessButtonStyle}"/>

                                    </Grid>
                                </Border>

                                <!-- Story Log (Collapsible) - shared panel -->
                                <ctrl:ProcessingLogPanel LogText="{Binding LogOutput}" IsLogExpanded="True"/>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 6: Infinite Talk Video Generator -->
                    <TabItem Header="🎤 Infinite Talk">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Infinite Talk Setup Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎬 Infinite Talk Video Inputs" Style="{StaticResource HeaderTextStyle}"/>

                                        <!-- Image Input -->
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Source Image:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            Background="White" Height="80"
                                                            CornerRadius="3" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="No image selected"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#999"
                                                                      FontStyle="Italic">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding InfiniteTalkImagePreview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding InfiniteTalkImagePreview}"
                                                                   Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectInfiniteTalkImageCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding InfiniteTalkImageInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                                <Button Content="Analyze Image"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding AnalyzeInfiniteTalkImageCommand}"
                                                        IsEnabled="{Binding CanInfiniteTalkAnalyzeImage, Mode=OneWay}"
                                                        Height="35"
                                                        Width="150"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"/>
                                                <TextBlock Text="Image Analysis Result:" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,5"/>
                                                <TextBox Text="{Binding InfiniteTalkAnalysisResult, Mode=OneWay}"
                                                        TextWrapping="Wrap"
                                                        AcceptsReturn="True"
                                                        Height="120"
                                                        Padding="12"
                                                        VerticalScrollBarVisibility="Auto"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        FontSize="11"
                                                        IsReadOnly="True"
                                                        Visibility="{Binding HasInfiniteTalkAnalysis, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Audio Input -->
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Audio File:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding InfiniteTalkAudioPath, Mode=TwoWay}"
                                                            IsReadOnly="True"
                                                            Padding="10"
                                                            Background="White"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"/>
                                                    <Button Grid.Column="2"
                                                           Content="Browse..."
                                                           Style="{StaticResource SecondaryButtonStyle}"
                                                           Command="{Binding SelectInfiniteTalkAudioCommand}"
                                                           Height="35"
                                                           Width="100"/>
                                                </Grid>
                                                <TextBlock Text="{Binding InfiniteTalkAudioInfo}"
                                                          FontStyle="Italic"
                                                          Foreground="#666"
                                                          FontSize="10"
                                                          Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Prompt Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📝 Video Prompt" Style="{StaticResource HeaderTextStyle}"/>

                                        <Button Content="Enhance Prompt"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding EnhanceInfiniteTalkPromptCommand}"
                                                IsEnabled="{Binding CanInfiniteTalkEnhancePrompt, Mode=OneWay}"
                                                Height="35"
                                                Width="160"
                                                HorizontalAlignment="Left"
                                                Margin="0,5,0,10"/>

                                        <StackPanel Visibility="{Binding ShowInfiniteTalkVideoPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Describe the video action you want to generate:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                                            <TextBox Text="{Binding InfiniteTalkPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap"
                                                    AcceptsReturn="True"
                                                    Height="100"
                                                    Padding="12"
                                                    VerticalScrollBarVisibility="Auto"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Settings Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Video Settings" Style="{StaticResource HeaderTextStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Width:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding InfiniteTalkWidth, Mode=TwoWay}"
                                                        Padding="8"
                                                        Background="White"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="Height:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding InfiniteTalkHeight, Mode=TwoWay}"
                                                        Padding="8"
                                                        Background="White"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        FontSize="12"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="ℹ️ InfiniteTalk mode processes the entire audio using 81-frame windows internally"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Generate Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Instructions -->
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="ℹ️ Wan2.1 InfiniteTalk Video" Style="{StaticResource HeaderTextStyle}"/>
                                            <TextBlock Text="Generate talking head videos synchronized to audio using Wan2.1 InfiniteTalk model. The system automatically calculates the number of frames needed based on the audio duration. The InfiniteTalk mode processes the video using 81-frame windows internally." FontSize="11" TextWrapping="Wrap" Foreground="#666" Margin="0,5,0,10"/>
                                            <TextBlock Text="Total Frames:" FontWeight="Bold" FontSize="11" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding InfiniteTalkTotalFrames}" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                                            <TextBlock Text="Estimated Duration:" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding InfiniteTalkEstimatedDuration}" FontSize="11" Foreground="#666"/>
                                        </StackPanel>

                                        <!-- Generate Button and Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="🎤 Generate Video"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Command="{Binding GenerateInfiniteTalkVideoCommand}"
                                                   IsEnabled="{Binding CanGenerateInfiniteTalkVideo, Mode=OneWay}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="55"
                                                   FontSize="15"
                                                   Margin="0,0,0,15"/>

                                            <!-- Processing Status -->
                                            <Border Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="12"
                                                    Visibility="{Binding IsProcessingInfiniteTalk, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding InfiniteTalkProcessingStatus}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,5"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap"/>
                                                    <ProgressBar Value="{Binding InfiniteTalkProcessingProgress, Mode=OneWay}"
                                                                Height="16"
                                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                                Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding InfiniteTalkProgressPercentage}"
                                                              HorizontalAlignment="Center"
                                                              FontSize="11"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Infinite Talk Result Video Section -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" Style="{StaticResource HeaderTextStyle}"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                                Background="White" Height="250"
                                                CornerRadius="5" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999"
                                                          FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasInfiniteTalkResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Video Player -->
                                                <MediaElement x:Name="InfiniteTalkVideoPlayer"
                                                            Source="{Binding InfiniteTalkResultPath}"
                                                            LoadedBehavior="Manual"
                                                            UnloadedBehavior="Stop"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding HasInfiniteTalkResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                   Content="▶️ Play"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding PlayInfiniteTalkVideoCommand}"
                                                   IsEnabled="{Binding HasInfiniteTalkResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="1"
                                                   Content="📂 Open Folder"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding OpenInfiniteTalkResultFolderCommand}"
                                                   IsEnabled="{Binding HasInfiniteTalkResult}"
                                                   Margin="0,0,8,0"/>

                                            <Button Grid.Column="2"
                                                   Content="📷 Send to Edit Camera"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding SendInfiniteTalkToEditCameraCommand}"
                                                   IsEnabled="{Binding HasInfiniteTalkResult}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding InfiniteTalkVideoInfo}"
                                                  FontStyle="Italic"
                                                  Foreground="#666"
                                                  FontSize="11"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Infinite Talk Log Section - shared panel -->
                                <ctrl:ProcessingLogPanel LogText="{Binding InfiniteTalkLogOutput}" Header="📋 Processing Log" MaxLogHeight="200"/>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab: Scail 2 (unified Klein char-swap → SCAIL II motion transfer) -->
                    <TabItem Header="🎭 Scail 2">
                        <Grid DataContext="{Binding Scail2VM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentIndigoColor}"/>
                            </Grid.Resources>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14" MaxWidth="640" HorizontalAlignment="Center">

                                    <!-- ═══ 1) Base scene (video) ═══════════════════════════ -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TabAccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="BASE SCENE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding InputVideoInfo}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontStyle="Italic" VerticalAlignment="Center" Margin="10,0,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Upload video…"
                                                        Command="{Binding SelectVideoCommand}"
                                                        Height="30" Padding="12,0" FontSize="11"
                                                        Style="{StaticResource SuccessButtonStyle}" Cursor="Hand"/>
                                            </Grid>

                                            <!-- Reference video preview (Source assigned in code-behind) -->
                                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Height="200">
                                                <Grid>
                                                    <TextBlock Text="Upload a base scene video, then scrub to a frame showing both people"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource PlayerTextBrush}" FontSize="12" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxWidth="320">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasInputVideo}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <MediaElement x:Name="Scail2RefVideoPlayer"
                                                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                  ScrubbingEnabled="True"
                                                                  MediaOpened="Scail2RefPlayer_MediaOpened"
                                                                  MediaEnded="Scail2RefPlayer_MediaEnded"
                                                                  Stretch="Uniform"
                                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Scrub + In/Out trim track (playhead = Klein frame; markers = SCAIL II range) -->
                                            <Grid x:Name="Scail2TrimTrack" Height="30" Margin="2,10,2,0"
                                                  Background="Transparent" ClipToBounds="False"
                                                  SizeChanged="Scail2TrimTrack_SizeChanged"
                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Height="8" VerticalAlignment="Center" CornerRadius="4" Background="{StaticResource BorderStrongBrush}"/>
                                                <Border x:Name="Scail2TrimRegion" Height="8" Width="0"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        CornerRadius="4" Background="{DynamicResource TabAccentBrush}" IsHitTestVisible="False"/>
                                                <Border x:Name="Scail2TrimPlayhead" Width="2" Height="24"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Background="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/>
                                                <Thumb x:Name="Scail2InThumb" Width="14" Height="24"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE"
                                                       DragDelta="Scail2InThumb_DragDelta"
                                                       ToolTip="Drag to set the start (in) point">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{StaticResource SuccessBrush}" CornerRadius="3" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                                <Thumb x:Name="Scail2OutThumb" Width="14" Height="24"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE"
                                                       DragDelta="Scail2OutThumb_DragDelta"
                                                       ToolTip="Drag to set the end (out) point">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{StaticResource DangerBrush}" CornerRadius="3" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Grid>

                                            <Grid Margin="0,8,0,0"
                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="▶" Click="Scail2Play_Click"
                                                            Width="30" Height="26" FontSize="11" Margin="0,0,4,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="⏸" Click="Scail2Pause_Click"
                                                            Width="30" Height="26" FontSize="11" Margin="0,0,10,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="⟦ In" Command="{Binding MarkInCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"
                                                            Style="{StaticResource SuccessButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="Out ⟧" Command="{Binding MarkOutCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"
                                                            Style="{StaticResource DangerButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="Reset" Command="{Binding ResetTrimCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,10,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="📌 Use this frame" Command="{Binding UsePoseFrameCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" FontWeight="Bold"
                                                            Style="{StaticResource AccentButtonStyle}" Cursor="Hand"
                                                            ToolTip="Pins the frame under the playhead as the pose source, like the Image Generator ▸ Advanced ▸ Control tab's 'Use This Frame'. Analyze and every Generate then work from this exact still, so re-runs keep the same pose."/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="ETA" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding EstimatedTime}" FontSize="13" FontWeight="Bold"
                                                               FontFamily="Consolas" Foreground="{DynamicResource TabAccentBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding TrimInfo}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="Consolas" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Pinned pose frame (the Control tab's "Use This Frame" still) -->
                                            <Grid Margin="0,8,0,0"
                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="112" Height="64" CornerRadius="4"
                                                        Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="🕴️" FontSize="20" Foreground="{StaticResource PlayerTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding NoPoseFrame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Image Source="{Binding PoseFrameSource}" Stretch="Uniform"/>
                                                        <Border Background="{StaticResource ScrimBrush}"
                                                                Visibility="{Binding IsGrabbingPoseFrame, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="⏳" Foreground="White" FontSize="14"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PoseFrameInfo}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <Button Content="Unpin" Command="{Binding ClearPoseFrameCommand}"
                                                            HorizontalAlignment="Left" Height="22" Padding="8,0" FontSize="10"
                                                            Margin="0,5,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                                            BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Drop the pinned frame and go back to using whatever frame the playhead is on"
                                                            Visibility="{Binding HasPoseFrame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ 2) Characters → Character image (Klein char-swap) ═══ -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TabAccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CHARACTERS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Replace method" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox SelectedIndex="{Binding CharReplaceMethodIndex, Mode=TwoWay}"
                                                              Width="190" Height="26" FontSize="10" VerticalContentAlignment="Center"
                                                              ToolTip="Which workflow the single-character 'Replace this one only' button runs. Klein Flux2 Control (default) holds the subject's likeness more accurately; Character Replacer is the legacy path; Krea2 Edit (two ref) keeps the base scene composition while swapping the subject in. 'Replace Both' always uses the 2-character replacer.">
                                                        <ComboBoxItem Content="🟢 Klein Flux2 Control"/>
                                                        <ComboBoxItem Content="⚪ Character Replacer (legacy)"/>
                                                        <ComboBoxItem Content="🔵 Krea2 Edit (two ref)"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Krea2 Edit (two ref) instruction prompt — only for that method -->
                                            <StackPanel Margin="0,0,0,10"
                                                        Visibility="{Binding IsKrea2EditSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Edit instruction (Krea2 Edit)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Krea2EditPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="10" MinHeight="46" TextWrapping="Wrap" AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Padding="6"
                                                         ToolTip="Instruction written into the Krea2 Edit grounded-encode node. 'image a' is the base scene frame (person to replace); 'image b' is Character 1. Edit for either sex or extra guidance."/>
                                            </StackPanel>

                                            <!-- Klein Flux2 Control — the Image Generator ▸ Advanced ▸ Control flow:
                                                 Step 1 Analyze (QwenVL subject + pose) → Step 2 edit prompt → Step 3 Generate (repeatable) -->
                                            <StackPanel Margin="0,0,0,10"
                                                        Visibility="{Binding IsKleinControlSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="Step 1 — Analyze pose + subject" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="🔍 Analyze"
                                                            Command="{Binding AnalyzeKleinPromptCommand}"
                                                            HorizontalAlignment="Right" Height="24" Padding="14,0" FontSize="10"
                                                            Style="{StaticResource SuccessButtonStyle}"
                                                            ToolTip="Runs the Klein Flux2 Control workflow's QwenVL pass on Character 1 (appearance) and the pinned pose frame, then fills the box below with the combined prompt so you can edit it. The generated image is also adopted as the character image."/>
                                                </Grid>
                                                <TextBlock Text="Step 2 — Edit prompt" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,4"/>
                                                <TextBox Text="{Binding KleinControlPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="10" MinHeight="80" MaxHeight="180" TextWrapping="Wrap" AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Padding="6"
                                                         ToolTip="Positive prompt for the Klein Flux2 Control generation. Leave empty to let the workflow write it from QwenVL (subject appearance + pose frame); anything here is used instead."/>
                                                <TextBlock Text="Leave empty to let QwenVL write the prompt during Generate."
                                                           FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,6"/>
                                                <Grid>
                                                    <TextBlock Text="Step 3 — Generate (press again for another take)"
                                                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="🚀 Generate image"
                                                            Command="{Binding GenerateKleinImageCommand}"
                                                            HorizontalAlignment="Right" Height="24" Padding="14,0" FontSize="10"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends the edited prompt to ComfyUI with Character 1 and the pinned pose frame, reseeding each run. Press it again if the first image isn't good enough — the result becomes the character image."/>
                                                </Grid>
                                                <ProgressBar Value="{Binding KleinProgress, Mode=OneWay}" Maximum="100" Height="4"
                                                             Margin="0,6,0,0" Foreground="{DynamicResource TabAccentBrush}"
                                                             BorderThickness="0"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Character 1 -->
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <Border Height="110" CornerRadius="6" Background="{StaticResource PlayerSurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                                                        <Grid>
                                                            <TextBlock Text="＋ Character 1 (LEFT)" Foreground="{StaticResource PlayerTextBrush}" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding NoChar1Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Image Source="{Binding Char1ImageSource}" Stretch="UniformToFill"/>
                                                            <Button Content="✕" Command="{Binding RemoveChar1Command}"
                                                                    Width="20" Height="20" Margin="0,3,3,0" Padding="0" FontSize="11"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Background="{StaticResource ScrimBrush}" Foreground="White" BorderThickness="0"
                                                                    Cursor="Hand" ToolTip="Remove Character 1"
                                                                    Visibility="{Binding HasChar1Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Browse…" Command="{Binding BrowseChar1Command}"
                                                            Height="26" FontSize="10" Margin="0,5,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="Replace this one only"
                                                            Command="{Binding SwapChar1OnlyCommand}"
                                                            Height="26" FontSize="10" Margin="0,4,0,0"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Replace just one person in the pose frame with Character 1 (works for a man or a woman), then use the result as the character image. In Klein Flux2 Control mode this is the same as Step 3 — Generate image."/>
                                                </StackPanel>

                                                <!-- Character 2 -->
                                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                    <Border Height="110" CornerRadius="6" Background="{StaticResource PlayerSurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                                                        <Grid>
                                                            <TextBlock Text="＋ Character 2 (RIGHT)" Foreground="{StaticResource PlayerTextBrush}" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding NoChar2Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Image Source="{Binding Char2ImageSource}" Stretch="UniformToFill"/>
                                                            <Button Content="✕" Command="{Binding RemoveChar2Command}"
                                                                    Width="20" Height="20" Margin="0,3,3,0" Padding="0" FontSize="11"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Background="{StaticResource ScrimBrush}" Foreground="White" BorderThickness="0"
                                                                    Cursor="Hand" ToolTip="Remove Character 2"
                                                                    Visibility="{Binding HasChar2Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Browse…" Command="{Binding BrowseChar2Command}"
                                                            Height="26" FontSize="10" Margin="0,5,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="Replace Both"
                                                            Command="{Binding SwapCharactersCommand}"
                                                            Height="26" FontSize="10" Margin="0,4,0,0"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Replace both people in the current base frame with Character 1 (left) and Character 2 (right), then use the result as the character image"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="→" FontSize="20" Foreground="{DynamicResource TabAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Character image (Klein composite) -->
                                                <StackPanel Grid.Column="3">
                                                    <Border Height="110" CornerRadius="6" Background="{StaticResource PlayerSurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="Character image"
                                                                       Foreground="{StaticResource PlayerTextBrush}" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding NoCharSwapResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Image Source="{Binding CharSwapResultSource}" Stretch="Uniform"/>
                                                            <Border Background="{StaticResource ScrimBrush}"
                                                                    Visibility="{Binding IsCharSwapping, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="⏳ working…" Foreground="White" FontSize="12"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Browse…" Command="{Binding BrowseFinalImageCommand}"
                                                            Height="26" FontSize="10" Margin="0,5,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"
                                                            ToolTip="Upload your own image to use as the final character image instead of running a swap"/>
                                                    <TextBlock Text="Built by Replace Both / Replace this one only, or upload your own" FontSize="9"
                                                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding CharSwapStatus}" FontSize="11" Foreground="{DynamicResource TabAccentBrush}"
                                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ 3) Generate progress / status ═══════════════════ -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <ProgressBar Height="6" Margin="0,0,0,8"
                                                         Value="{Binding ProcessingProgress, Mode=OneWay}" Foreground="{DynamicResource TabAccentBrush}"
                                                         Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Chunk size (VRAM)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox SelectedValue="{Binding VideoBatchSize, Mode=TwoWay}" SelectedValuePath="Tag"
                                                          Width="150" Height="24" FontSize="10" VerticalContentAlignment="Center"
                                                          ToolTip="Frames processed per internal chunk. The clip is generated in windows of this size (VRAM purged between them) then stitched into one video.&#10;&#10;Measured: lowering this does NOT prevent the crash seen at 1280 × 720 — a full-length clip died at both 40 and 17 frames, while 17 ran ~5× slower. Use the Resolution setting below to stay within memory; leave this at 40 unless you have a specific reason.">
                                                    <ComboBoxItem Content="24 — lowest VRAM"><ComboBoxItem.Tag><sys:Int32>24</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                    <ComboBoxItem Content="40 — recommended"><ComboBoxItem.Tag><sys:Int32>40</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                    <ComboBoxItem Content="60 — balanced"><ComboBoxItem.Tag><sys:Int32>60</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                    <ComboBoxItem Content="80 — most VRAM"><ComboBoxItem.Tag><sys:Int32>80</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Resolution" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox SelectedValue="{Binding OutputResolution, Mode=TwoWay}" SelectedValuePath="Tag"
                                                          Width="200" Height="24" FontSize="10" VerticalContentAlignment="Center"
                                                          ToolTip="Resolution the video is generated at. Measured on a 24 GB card with a ~21s clip: 960 × 544 completes in ~14 min; 1280 × 720 takes the ComfyUI server down mid-run (a hard process kill, not a recoverable error) on anything longer than a few seconds, at any chunk size. Memory use grows with clip LENGTH as well as resolution, so longer clips need a lower preset.">
                                                    <ComboBoxItem Content="960 × 544 (landscape — recommended)" Tag="960x544"/>
                                                    <ComboBoxItem Content="Default (640 × 960 portrait)" Tag="0x0"/>
                                                    <ComboBoxItem Content="832 × 480 (landscape)" Tag="832x480"/>
                                                    <ComboBoxItem Content="768 × 768 (square)" Tag="768x768"/>
                                                    <ComboBoxItem Content="544 × 960 (portrait)" Tag="544x960"/>
                                                    <ComboBoxItem Content="1280 × 720 (720p — crashes on long clips)" Tag="1280x720"/>
                                                    <ComboBoxItem Content="720 × 1280 (720p portrait — crashes on long clips)" Tag="720x1280"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <CheckBox Content="Keep original background" IsChecked="{Binding KeepOriginalBackground, Mode=TwoWay}"
                                                      FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"
                                                      ToolTip="Replacement mode: composite the driving video's real background every frame and regenerate only the swapped character.&#10;&#10;Turn ON when the scene behind the person is real footage you want kept (e.g. a waterfall). Because the background is never generated, it can't colour-drift or soften across the internal chunks — the artefacts that appear ~20s into a long clip.&#10;&#10;Turn OFF (animation mode) to regenerate the whole frame, e.g. when re-lighting the character into a new environment."/>
                                            <CheckBox Content="Interpolate + RTX upscale (2× fps, 2× size)" IsChecked="{Binding InterpolateAndUpscale, Mode=TwoWay}"
                                                      FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"
                                                      ToolTip="Runs the workflow's post pass after generation: RIFE frame interpolation (2× the frame rate) followed by the RTX Video Super Resolution upscale (2× the resolution).&#10;&#10;A 960 × 544 clip at 16 fps comes out 1920 × 1088 at 32 fps. It adds a noticeable amount of time to every run and needs the RIFE VFI and NVIDIA RTX (nvidia-vfx) custom nodes installed on the server, so it's off by default — with it off the raw sampler output is saved instead."/>
                                            <Grid>
                                                <TextBlock Text="{Binding ProcessingStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Content="⚡ Generate video" HorizontalAlignment="Right"
                                                        Click="Scail2Process_Click" Height="30" Padding="14,0" FontSize="11"
                                                        FontWeight="Bold" Style="{StaticResource SuccessButtonStyle}"
                                                        BorderThickness="0" Cursor="Hand"
                                                        IsEnabled="{Binding CanAddToQueue}"
                                                        ToolTip="Analyzes the marked In/Out range and generates the SCAIL II video. Build the character image first."/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ 4) Result ═══════════════════════════════════════ -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="🎥 RESULT" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Height="200" CornerRadius="6" Margin="0,0,0,8">
                                                <Grid>
                                                    <TextBlock Text="The motion-transfer video will appear here"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasResult}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <MediaElement x:Name="Scail2VideoPlayer"
                                                                  Source="{Binding ResultVideoPath}"
                                                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                  Stretch="Uniform"
                                                                  Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="▶ Play" Command="{Binding PlayVideoCommand}"
                                                        IsEnabled="{Binding HasResult}" Height="30" Padding="14,0" FontSize="11"
                                                        Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Content="📁 Open folder" Command="{Binding OpenResultFolderCommand}"
                                                        IsEnabled="{Binding HasResult}" Height="30" Padding="14,0" FontSize="11"
                                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Content="📷 Send to Edit Camera" Command="{Binding SendToEditCameraCommand}"
                                                        IsEnabled="{Binding HasResult}" Height="30" Padding="14,0" FontSize="11"
                                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ResultVideoInfo}" FontStyle="Italic"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ Log ═════════════════════════════════════════════ -->
                                    <Expander Header="📝 Log" IsExpanded="False" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4">
                                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                            <TextBox Text="{Binding LogOutput, Mode=OneWay}"
                                                     TextWrapping="Wrap" IsReadOnly="True"
                                                     FontFamily="Consolas" FontSize="10"
                                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Padding="10"/>
                                        </ScrollViewer>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Tab: VR 180 -->
                    <TabItem Header="🥽 VR 180">
                        <Grid DataContext="{Binding Vr180VM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentCyanColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL · Inputs ════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Intro -->
                                        <Border Style="{StaticResource IntroBannerStyle}">
                                            <StackPanel>
                                                <TextBlock Text="🥽 Flat → 360° VR" Style="{StaticResource IntroTitleStyle}"/>
                                                <TextBlock Style="{StaticResource IntroBodyStyle}"
                                                           Text="Drop in an ordinary flat clip. The LTX-2.3-22B equirect IC-LoRA paints a VR hemisphere, Video-Depth-Anything adds per-frame depth, and a side-by-side 3D VR180 file is assembled for your headset."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Input video -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="FLAT VIDEO" Note="  · required"/>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                        Background="{StaticResource PlayerSurfaceBrush}" Height="150" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No video selected" Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <MediaElement x:Name="Vr180InputPlayer"
                                                                      Source="{Binding VideoFileUri}"
                                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                      ScrubbingEnabled="True" Stretch="Uniform"
                                                                      MediaOpened="Vr180InputPlayer_MediaOpened"
                                                                      Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <Button Content="📁 Choose video…" Command="{Binding SelectVideoCommand}"
                                                        Height="32" FontSize="12" FontWeight="SemiBold"
                                                        Style="{StaticResource AccentButtonStyle}"/>
                                                <TextBlock Text="{Binding VideoInfo}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt + analyze -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <ctrl:SectionHeader Title="SCENE PROMPT" Note="  · optional" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="Analyzing…" FontStyle="Italic" FontSize="10" Foreground="{DynamicResource TabAccentBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Button Content="🔍 Analyze" Command="{Binding AnalyzeCommand}"
                                                                IsEnabled="{Binding CanAnalyze}"
                                                                Height="26" Padding="10,0" FontSize="11" FontWeight="SemiBold"
                                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                                ToolTip="Extract the first frame and describe the scene as a 360° environment"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="70" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="12" Padding="8" Margin="0,0,0,10"/>

                                                <ctrl:SectionHeader Title="NEGATIVE PROMPT"/>
                                                <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="60" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Output settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="OUTPUT" Margin="0,0,0,10"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Equirect size (2:1)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding ResolutionChoices}"
                                                                  SelectedItem="{Binding Resolution}"
                                                                  Height="30" FontSize="12" Padding="6,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Frame cap" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding FrameCap, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                                 FontSize="12" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"
                                                           Text="Bigger size = sharper but slower. Frame cap limits clip length (121 ≈ 5s @ 24fps)."/>

                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="3D depth" FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.4"
                                                            Value="{Binding StereoStrength}" Margin="8,0"
                                                            TickFrequency="0.02" IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StereoStrength, StringFormat={}{0:0.00}}"
                                                               FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TabAccentBrush}"
                                                               FontWeight="Bold" VerticalAlignment="Center" Width="34"
                                                               TextAlignment="Right"/>
                                                </Grid>
                                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                                                           Text="Stereo parallax from the depth pass. 0 = flat-in-VR (both eyes identical); higher = more pop, but more edge warping."/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ════════════════════════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="*"/>    <!-- Scrollable: result + queue + log -->
                                </Grid.RowDefinitions>

                                <!-- Progress bar -->
                                <ProgressBar Grid.Row="0"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Status row -->
                                <Border Grid.Row="1" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource DisabledBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessingQueue}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}" FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Action buttons -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateVideoCommand}"
                                                IsEnabled="{Binding CanAddToQueue}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🥽 " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate VR Video" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Height="40" Width="82"
                                                Command="{Binding StopQueueCommand}"
                                                IsEnabled="{Binding IsProcessingQueue}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Scrollable: result + queue + log -->
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Background="White">
                                    <StackPanel>
                                        <!-- Result -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="🎥 360° Result" FontWeight="Bold" FontSize="13"
                                                           Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                        Height="260" CornerRadius="6" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="Your 360° panorama will appear here after generation"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <MediaElement x:Name="Vr180VideoPlayer"
                                                                      Source="{Binding ResultVideoPath}"
                                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                      Stretch="Uniform"
                                                                      Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                            Command="{Binding PlayVideoCommand}"
                                                            IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                                    <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding OpenResultFolderCommand}"
                                                            IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                                    <Button Content="📷 Send to Edit Camera" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding SendToEditCameraCommand}"
                                                            IsEnabled="{Binding HasResult}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ResultVideoInfo}"
                                                           FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Queue -->
                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1" Padding="12,8"
                                                Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🥽 VR Queue"
                                                               FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                               FontStyle="Italic" Foreground="#666" FontSize="11"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Content="🔄 Retry"
                                                            Command="{Binding ReprocessAllFailedCommand}"
                                                            IsEnabled="{Binding HasFailedItems}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                            Style="{StaticResource AccentButtonStyle}"/>
                                                    <Button Grid.Column="3" Content="⏹ Stop"
                                                            Command="{Binding StopQueueCommand}"
                                                            IsEnabled="{Binding IsProcessingQueue}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                            Style="{StaticResource AccentButtonStyle}"/>
                                                    <Button Grid.Column="4" Content="🗑️ Clear"
                                                            Command="{Binding ClearQueueCommand}"
                                                            Height="26" Padding="8,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Queue}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                                    Padding="10,5" Margin="0,0,0,3" Background="White">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                            Background="{Binding StatusColor}">
                                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                                   FontWeight="SemiBold" Foreground="White"/>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"/>
                                                                        <TextBlock Text="{Binding Prompt}" FontSize="10" Foreground="#666"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2" Content="✕"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="26" Height="26" Padding="0" FontSize="10"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Log - shared panel -->
                                        <ctrl:ProcessingLogPanel LogText="{Binding LogOutput}" MaxLogHeight="130"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Tab: Video Sound -->
                    <TabItem Header="🔊 Video Sound">
                        <Grid DataContext="{Binding VideoSoundVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentVioletColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL · Inputs ════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Intro -->
                                        <Border Style="{StaticResource IntroBannerStyle}">
                                            <StackPanel>
                                                <TextBlock Text="🔊 Video → Talking Video" Style="{StaticResource IntroTitleStyle}"/>
                                                <TextBlock Style="{StaticResource IntroBodyStyle}"
                                                           Text="Drop in a clip and Analyze — its first frame is read into a [VISUAL]/[SPEECH]/[SOUNDS] script. The LTX-2.3 audio-video model then re-generates the shot with synchronized speech and sound effects."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Input video -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="VIDEO" Note="  · required"/>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                        Background="{StaticResource PlayerSurfaceBrush}" Height="150" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No video selected" Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <MediaElement x:Name="VideoSoundInputPlayer"
                                                                      Source="{Binding VideoFileUri}"
                                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                      ScrubbingEnabled="True" Stretch="Uniform"
                                                                      MediaOpened="VideoSoundInputPlayer_MediaOpened"
                                                                      Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <Button Content="📁 Choose video…" Command="{Binding SelectVideoCommand}"
                                                        Height="32" FontSize="12" FontWeight="SemiBold"
                                                        Style="{StaticResource AccentButtonStyle}"/>
                                                <TextBlock Text="{Binding VideoInfo}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt + analyze -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ctrl:SectionHeader Title="SCRIPT" Note="  · [VISUAL]/[SPEECH]/[SOUNDS]" Grid.Column="0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="Analyzing…" FontStyle="Italic" FontSize="10" Foreground="{DynamicResource TabAccentBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Button Content="🔍 Analyze" Command="{Binding AnalyzeCommand}"
                                                                IsEnabled="{Binding CanAnalyze}"
                                                                Height="26" Padding="10,0" FontSize="11" FontWeight="SemiBold"
                                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                                ToolTip="Extract the first frame and write a [VISUAL]/[SPEECH]/[SOUNDS] script"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="150" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="12" FontFamily="Consolas" Padding="8"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"
                                                           Text="Edit freely. Keep the three labelled blocks so the model knows what to speak and what to sound like."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reference voice (optional) -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="REFERENCE VOICE" Note="  · optional"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="🎙 Choose voice audio…"
                                                            Command="{Binding SelectReferenceAudioCommand}"
                                                            Height="30" FontSize="11" FontWeight="SemiBold"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                                    <Button Grid.Column="1" Content="✕" Width="30" Height="30" Margin="6,0,0,0"
                                                            Command="{Binding ClearReferenceAudioCommand}"
                                                            IsEnabled="{Binding HasReferenceAudio}"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                            ToolTip="Clear reference voice (use workflow default)"/>
                                                </Grid>
                                                <TextBlock Text="{Binding ReferenceAudioInfo}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Output settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="OUTPUT SIZE" Margin="0,0,0,10"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Width" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                                 FontSize="12" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Height" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                                 FontSize="12" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"
                                                           Text="The input frames are re-fit to this size (default 720×1280 portrait). Match your clip's orientation to avoid stretching. Clip length follows the source video."/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ════════════════════════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="*"/>    <!-- Scrollable: result + queue + log -->
                                </Grid.RowDefinitions>

                                <!-- Progress bar -->
                                <ProgressBar Grid.Row="0"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Status row -->
                                <Border Grid.Row="1" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource DisabledBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessingQueue}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}" FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Action buttons -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateVideoCommand}"
                                                IsEnabled="{Binding CanAddToQueue}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔊 " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate Video Sound" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Height="40" Width="82"
                                                Command="{Binding StopQueueCommand}"
                                                IsEnabled="{Binding IsProcessingQueue}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Scrollable: result + queue + log -->
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Background="White">
                                    <StackPanel>
                                        <!-- Result -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="🎬 Result" FontWeight="Bold" FontSize="13"
                                                           Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                        Height="260" CornerRadius="6" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="Your video with sound will appear here after generation"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <MediaElement x:Name="VideoSoundVideoPlayer"
                                                                      Source="{Binding ResultVideoPath}"
                                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                      Stretch="Uniform"
                                                                      Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                            Command="{Binding PlayVideoCommand}"
                                                            IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                                    <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding OpenResultFolderCommand}"
                                                            IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                                    <Button Content="📷 Send to Edit Camera" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding SendToEditCameraCommand}"
                                                            IsEnabled="{Binding HasResult}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ResultVideoInfo}"
                                                           FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Queue -->
                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1" Padding="12,8"
                                                Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🔊 Sound Queue"
                                                               FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                               FontStyle="Italic" Foreground="#666" FontSize="11"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Content="🔄 Retry"
                                                            Command="{Binding ReprocessAllFailedCommand}"
                                                            IsEnabled="{Binding HasFailedItems}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                            Style="{StaticResource AccentButtonStyle}"/>
                                                    <Button Grid.Column="3" Content="⏹ Stop"
                                                            Command="{Binding StopQueueCommand}"
                                                            IsEnabled="{Binding IsProcessingQueue}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                            Style="{StaticResource AccentButtonStyle}"/>
                                                    <Button Grid.Column="4" Content="🗑️ Clear"
                                                            Command="{Binding ClearQueueCommand}"
                                                            Height="26" Padding="8,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Queue}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                                    Padding="10,5" Margin="0,0,0,3" Background="White">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                            Background="{Binding StatusColor}">
                                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                                   FontWeight="SemiBold" Foreground="White"/>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"/>
                                                                        <TextBlock Text="{Binding Prompt}" FontSize="10" Foreground="#666"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2" Content="✕"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="26" Height="26" Padding="0" FontSize="10"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Log - shared panel -->
                                        <ctrl:ProcessingLogPanel LogText="{Binding LogOutput}" MaxLogHeight="130"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <!-- Tab: 10Eros ConvRot (face ref → 4 seeds → full-res upscale)        -->
                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🎭 10Eros ConvRot">
                        <Grid DataContext="{Binding ErosConvRotVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentRoseColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL · Inputs ════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Intro -->
                                        <Border Style="{StaticResource IntroBannerStyle}">
                                            <StackPanel>
                                                <TextBlock Text="🎭 10Eros ConvRot" Style="{StaticResource IntroTitleStyle}"/>
                                                <TextBlock Style="{StaticResource IntroBodyStyle}"
                                                           Text="Upload one photo → build a 4-panel character sheet with Krea 2 → type an action (Analyze to fold in the character's look) → generate 4 seed previews → Upscale the chosen seed(s) at full resolution. The character sheet is the reference the LTX FaceID model is trained on."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Workflow selector -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="WORKFLOW"/>
                                                <ComboBox ItemsSource="{Binding WorkflowOptions}" SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}"
                                                          Height="30"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Source photo -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SOURCE PHOTO"/>
                                                <Border Height="150" Style="{StaticResource PreviewFrameStyle}">
                                                    <Grid>
                                                        <TextBlock Text="none" Style="{StaticResource PlaceholderTextStyle}"
                                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                        <Image Source="{Binding ImagePreview}" Stretch="Uniform" Margin="4"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding ImageInfo}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                <Button Content="📁 Choose Source Photo" Command="{Binding SelectImageCommand}"
                                                        Height="28" Style="{StaticResource AccentButtonStyle}"/>
                                                <CheckBox Content="This photo is already a character sheet (skip Krea 2)"
                                                          IsChecked="{Binding UseSourceAsSheet, Mode=TwoWay}"
                                                          Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Character sheet (Krea 2) -->
                                        <Border Style="{StaticResource SectionCardStyle}"
                                                Visibility="{Binding UseSourceAsSheet, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CHARACTER SHEET"/>
                                                <Border Height="120" Style="{StaticResource PreviewFrameStyle}">
                                                    <Grid>
                                                        <TextBlock Text="not built yet" Style="{StaticResource PlaceholderTextStyle}"
                                                                   Visibility="{Binding HasSheet, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                        <Image Source="{Binding SheetPreview}" Stretch="Uniform" Margin="4"/>
                                                    </Grid>
                                                </Border>
                                                <Button Content="🎨 Build Character Sheet (Krea 2)" Command="{Binding BuildSheetCommand}"
                                                        Height="30" Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="Turn the source photo into a 4-panel character reference sheet (close-up face + full-body front/side/back at 1536×1024) using the Krea 2 edit workflow — the reference the LTX FaceID checkpoint expects."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="ACTION PROMPT"/>
                                                <TextBox Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90" MaxHeight="200"
                                                         VerticalScrollBarVisibility="Auto" Padding="6"
                                                         FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                                         ToolTip="Describe the scene/action. The character's identity comes from the face reference (FaceID), so you only need the action."/>
                                                <Button Content="✨ Analyze — fold appearance into prompt" Command="{Binding AnalyzeCommand}"
                                                        Height="28" Margin="0,8,0,0" Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="Send the face image + your draft prompt to the LLM to merge the character's visible appearance into the caption."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS"/>
                                                <TextBlock Text="Duration (seconds)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding LengthSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="26" Padding="6,3"                                                         FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                                <TextBlock Text="Base seed (blank = random each run)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding BaseSeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="26" Padding="6,3"                                                             FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Button Grid.Column="1" Content="🎲" Command="{Binding RandomSeedCommand}"
                                                            Width="30" Height="26" Margin="6,0,0,0" Style="{StaticResource AccentButtonStyle}"
                                                            BorderThickness="0" ToolTip="New random base seed"/>
                                                </Grid>
                                                <TextBlock Text="Samples use base, base+1, base+2, base+3." FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL · Samples + player ═════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Sample tiles -->
                                    <RowDefinition Height="*"/>    <!-- Player -->
                                    <RowDefinition Height="Auto"/> <!-- Results strip -->
                                    <RowDefinition Height="Auto"/> <!-- Progress -->
                                    <RowDefinition Height="Auto"/> <!-- Action bar -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- Sample tiles -->
                                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="SEED SAMPLES — click to preview, tick to queue for Upscale"
                                                   FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ListBox ItemsSource="{Binding Samples}"
                                                 SelectedItem="{Binding SelectedSampleForPreview, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="4"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="3"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="tile" CornerRadius="6" BorderThickness="2"
                                                                        Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="96" Background="Transparent" ToolTip="Click to preview this sample">
                                                        <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"
                                                                   IsHitTestVisible="False"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4"
                                                                   Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                ToolTip="Click to preview this sample"
                                                                Command="{Binding DataContext.PreviewSampleCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent"/>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <CheckBox Content="Queue" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Foreground="White" FontSize="10" FontWeight="Bold"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,4"
                                                                  Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9"
                                                                   IsHitTestVisible="False"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <!-- Shared player -->
                                <Border Grid.Row="1" Margin="12" CornerRadius="6"
                                        Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Generate 4 samples, then click one to preview it here. The final upscaled video plays here after Upscale."
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap" Margin="20,0" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                   Visibility="{Binding HasActivePreview, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <!-- Source is set from code-behind (ApplyErosConvRotSource) as an ABSOLUTE Uri;
                                             a string {Binding} to MediaElement.Source silently fails on Z:\ output paths. -->
                                        <MediaElement x:Name="ErosConvRotPlayer"
                                                      Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      MediaOpened="ErosConvRotPlayer_MediaOpened"
                                                      MediaEnded="ErosConvRotPlayer_MediaEnded"
                                                      MediaFailed="ErosConvRotPlayer_MediaFailed"/>
                                    </Grid>
                                </Border>

                                <!-- Results strip -->
                                <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6"
                                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="FINISHED VIDEOS — click to replay" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Results}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.PlayResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,8,0" Padding="10,4"
                                                            Style="{StaticResource AccentButtonStyle}" Cursor="Hand">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="11"/>
                                                            <TextBlock Text="{Binding Info}" FontSize="9" Foreground="#E6FFFFFF"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Progress -->
                                <Grid Grid.Row="3" Margin="12,6,12,6">
                                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProcessingProgress}"
                                                 Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"/>
                                </Grid>

                                <!-- Action bar -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🎯 Generate 4 Samples" Command="{Binding HuntCommand}"
                                                Height="32" Padding="16,0" Margin="0,0,8,0" FontWeight="Bold"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{Binding ShowReroll, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                ToolTip="Generate 4 seed previews from the face reference and prompt."/>
                                        <Button Content="🎲 Reroll — new 4 seeds" Command="{Binding HuntCommand}"
                                                Height="32" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{Binding ShowReroll, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Don't like these? Regenerate 4 fresh previews with a new random seed."/>
                                        <Button Content="{Binding FinishButtonText}" Command="{Binding FinishCommand}"
                                                Height="32" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold"
                                                Style="{StaticResource SuccessButtonStyle}"/>
                                        <Button Content="✕ Cancel" Command="{Binding CancelCommand}"
                                                Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Style="{StaticResource DangerButtonStyle}"/>
                                        <Button Content="📁 Open Folder" Command="{Binding OpenResultFolderCommand}"
                                                IsEnabled="{Binding HasResult}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Style="{StaticResource AccentButtonStyle}"/>
                                        <TextBlock Text="{Binding ProcessingStatus}" VerticalAlignment="Center"
                                                   FontStyle="Italic" Foreground="{DynamicResource TabAccentBrush}" FontSize="11" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Log -->
                                <ctrl:ProcessingLogPanel Grid.Row="5" LogText="{Binding LogOutput}" MaxLogHeight="120"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Tab: FaceID Character Sheet -->
                    <TabItem Header="🪪 FaceID Char Sheet">
                        <Grid DataContext="{Binding FaceIdCharSheetVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentEmeraldColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Character Image -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CHARACTER IMAGE" Note="  · identity (FaceID)" Margin="0,0,0,10"/>

                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                        Background="{StaticResource SurfaceAltBrush}" Height="130" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No image selected"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding ImagePreview}" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ImageInfo}"
                                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectImageCommand}"
                                                            Height="28" Padding="10,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Audio -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="AUDIO" Note="  · drives speech &amp; sound"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding AudioPath, Mode=OneWay}"
                                                             IsReadOnly="True" Height="30"
                                                             VerticalContentAlignment="Center" Padding="6,0"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="11" Foreground="#555" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectAudioCommand}"
                                                            Height="30" Padding="10,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                                <TextBlock Text="{Binding AudioInfo}"
                                                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reference Video -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="REFERENCE VIDEO" Note="  · pose · depth · edges"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding RefVideoPath, Mode=OneWay}"
                                                             IsReadOnly="True" Height="30"
                                                             VerticalContentAlignment="Center" Padding="6,0"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="11" Foreground="#555" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectRefVideoCommand}"
                                                            Height="30" Padding="10,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource SuccessTextBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                                <TextBlock Text="{Binding RefVideoInfo}"
                                                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"/>

                                                <!-- Analyze (a frame of the reference video → action prompt) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Content="🔍 Analyze Video → Prompt"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource SuccessButtonStyle}"
                                                            ToolTip="Extracts a frame from the reference video, sends it to the llama-server, and writes an LTX action prompt describing the action shown."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="Analyzing…" Foreground="{StaticResource SuccessTextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="ACTION PROMPT" Note="  · leave blank = auto from image"/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="90" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="12" Padding="8" Margin="0,0,0,10"/>

                                                <ctrl:SectionHeader Title="NEGATIVE PROMPT"/>
                                                <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="55" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Length (seconds)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding LengthSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL (scrollable so the result + buttons are always reachable) ═══ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>  <!-- Reference video preview -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Reference Video Preview ───────────────────────────── -->
                                <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRefVideo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource PlayerSurfaceRaisedBrush}" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                   
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🪪" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Image + Audio + Reference Video" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Upload all three → Analyze → Generate"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <MediaElement x:Name="FaceIdCharSheetRefPlayer"
                                                      Source="{Binding RefVideoFileUri}"
                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      ScrubbingEnabled="True"
                                                      MediaOpened="FaceIdCharSheetRefPlayer_MediaOpened"
                                                      Stretch="Uniform"
                                                      Visibility="{Binding HasRefVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <Border VerticalAlignment="Bottom" Margin="10,0,10,10"
                                                CornerRadius="8" Padding="12,6"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                Visibility="{Binding HasRefVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="FaceID + Union-Control  "/>
                                                <Run Text="pose · depth · canny" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}" FontFamily="Consolas"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate Video" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                IsEnabled="{Binding IsProcessing}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="FaceIdCharSheetVideoPlayer"
                                                              Source="{Binding ResultVideoPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="5" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="🌀 MiniMax H3">
                        <Grid DataContext="{Binding MiniMaxH3VM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentAmberColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- First Frame Image -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="FIRST FRAME" Note="  · the image at 0.00s" Margin="0,0,0,10"/>

                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                        Background="{StaticResource SurfaceAltBrush}" Height="130" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No image selected"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding ImagePreview}" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ImageInfo}"
                                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectImageCommand}"
                                                            Height="28" Padding="10,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>

                                                <!-- Analyze (image + draft idea → full H3 prompt) -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze → H3 Prompt"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends the image (plus whatever is in the prompt box as a draft idea) to the llama-server and writes a complete MiniMax H3 prompt: the I2VA instruction line, integrated_multimodal_description, overall_soundscape and non_diegetic_music."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="Analyzing…" Foreground="{DynamicResource TabAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="H3 PROMPT" Note="  · draft idea, or the full prompt"/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="200" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>
                                                <TextBlock Text="The I2VA instruction line is added automatically if missing."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,6,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                                                <TextBlock Text="Quality (canvas size)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Megapixels}"
                                                          Height="30" FontSize="11" Margin="0,0,0,10"/>

                                                <TextBlock Text="Length (seconds · 4–15)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding LengthSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>  <!-- First-frame preview -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── First-frame preview ───────────────────────────────── -->
                                <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource PlayerSurfaceRaisedBrush}" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                   
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🌀" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MiniMax H3 · Image to Video" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Upload an image → Analyze → Generate (video + synced audio)"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Image Source="{Binding ImagePreview}" Stretch="Uniform"
                                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <Border VerticalAlignment="Bottom" Margin="10,0,10,10"
                                                CornerRadius="8" Padding="12,6"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="First frame at 0.00s  "/>
                                                <Run Text="{Binding ResolvedAspectRatio, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}" FontFamily="Consolas"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate Video" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                IsEnabled="{Binding IsProcessing}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="MiniMaxH3VideoPlayer"
                                                              Source="{Binding ResultVideoPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="5" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <!-- Tab: MiniMax FFLF (first+last frame → 3 cheap seeds → full res)    -->
                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🌀🎯 MiniMax FFLF">
                        <Grid DataContext="{Binding MiniMaxFflfVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentAmberColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL · Inputs ════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Intro -->
                                        <Border Style="{StaticResource IntroBannerStyle}">
                                            <StackPanel>
                                                <TextBlock Text="🌀🎯 MiniMax FFLF Seed Hunter" Style="{StaticResource IntroTitleStyle}"/>
                                                <TextBlock Style="{StaticResource IntroBodyStyle}"
                                                           Text="Upload a first and last frame — or a whole folder chained into overlapping pairs — then Analyze to write the MiniMax H3 FL2VA prompt. Three cheap seed previews per pair (low MP, few steps); tick the keepers and Finish re-renders them at full resolution and the full step count, with synchronized audio."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Folder batch -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="FOLDER BATCH"/>
                                                <Button Content="📂 Load Folder of Images" Command="{Binding SelectFolderCommand}"
                                                        Height="30" Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="Pick a folder; images are ordered by creation time into overlapping first→last pairs, then analyzed and seed-hunted automatically."/>
                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding BatchInfo}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"/>
                                                    <TextBlock Text="Selected pair prompt (edit before rerolling):" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,2"/>
                                                    <TextBox Text="{Binding SelectedPair.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="140"
                                                             VerticalScrollBarVisibility="Auto" Padding="6"
                                                            
                                                             FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"
                                                             ToolTip="This pair's full H3 prompt: the FL2VA alignment line plus integrated_multimodal_description / overall_soundscape / non_diegetic_music. Edit freely, then Reroll This Pair."/>
                                                    <Button Content="✕ Exit Batch Mode" Command="{Binding ClearFolderCommand}"
                                                            Height="26" Margin="0,8,0,0" Style="{StaticResource AccentButtonStyle}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- First + Last frame images -->
                                        <Border Style="{StaticResource SectionCardStyle}"
                                                Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <ctrl:SectionHeader Title="FIRST FRAME"/>
                                                    <Border Height="120" Style="{StaticResource PreviewFrameStyle}">
                                                        <Grid>
                                                            <TextBlock Text="none" Style="{StaticResource PlaceholderTextStyle}"
                                                                       Visibility="{Binding HasFirstImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                            <Image Source="{Binding FirstImagePreview}" Stretch="Uniform" Margin="4"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding FirstImageInfo}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                    <Button Content="📁 First" Command="{Binding SelectFirstImageCommand}"
                                                            Height="28" Style="{StaticResource AccentButtonStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <ctrl:SectionHeader Title="LAST FRAME"/>
                                                    <Border Height="120" Style="{StaticResource PreviewFrameStyle}">
                                                        <Grid>
                                                            <TextBlock Text="none" Style="{StaticResource PlaceholderTextStyle}"
                                                                       Visibility="{Binding HasLastImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                            <Image Source="{Binding LastImagePreview}" Stretch="Uniform" Margin="4"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding LastImageInfo}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                    <Button Content="📁 Last" Command="{Binding SelectLastImageCommand}"
                                                            Height="28" Style="{StaticResource AccentButtonStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Analyze + prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}"
                                                Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="H3 PROMPT (FL2VA)"/>
                                                <Button Content="🔍 Analyze First + Last" Command="{Binding AnalyzeCommand}"
                                                        Height="30" Margin="0,0,0,8"
                                                        Style="{StaticResource AccentButtonStyle}" FontWeight="Bold"
                                                        ToolTip="Send both frames to llama-server (h3minimax-fflf.md) to write the full MiniMax H3 FL2VA prompt. Whatever is already in the box is used as your draft idea."/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="110" MaxHeight="220"
                                                         VerticalScrollBarVisibility="Auto" Padding="6" BorderBrush="{StaticResource BorderBrush}"
                                                         ToolTip="Alignment line + integrated_multimodal_description / overall_soundscape / non_diegetic_music. The alignment line's end timestamp is rewritten to match the duration on every submit."/>
                                                <TextBlock Text="Type a rough idea first and Analyze will build the full H3 prompt around it."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Generation settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS"/>

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Seconds (4–15)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding LengthSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="28" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" Text="{Binding BaseSeed, UpdateSourceTrigger=PropertyChanged}"
                                                                     Height="28" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}"/>
                                                            <Button Grid.Column="1" Content="🎲" Command="{Binding RandomSeedCommand}"
                                                                    Width="34" Height="28" Margin="4,0,0,0"
                                                                    Style="{StaticResource AccentButtonStyle}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio, Mode=TwoWay}"
                                                          Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"
                                                          ToolTip="Auto picks the option closest to the first frame's own aspect (per pair in batch mode)."/>

                                                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="SEED PREVIEWS — cheap and fast" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,6"/>
                                                        <TextBlock Text="Resolution" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding PreviewMegapixelOptions}"
                                                                  SelectedValue="{Binding PreviewMegapixels, Mode=TwoWay}"
                                                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                                                  Height="28" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                                        <TextBlock Text="Steps" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding PreviewSteps, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="28" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}"
                                                                 ToolTip="Sampling steps for the 3 seed previews. The turbo LoRA needs only 4; previews also skip the RTX upscale pass."/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="10">
                                                    <StackPanel>
                                                        <TextBlock Text="FINISH — full quality" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,6"/>
                                                        <TextBlock Text="Resolution" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding FinalMegapixelOptions}"
                                                                  SelectedValue="{Binding FinalMegapixels, Mode=TwoWay}"
                                                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                                                  Height="28" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                                        <TextBlock Text="Steps" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding FinalSteps, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="28" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}"
                                                                 ToolTip="Sampling steps for the finished videos. 8 is what the turbo workflow ships with; going much higher buys nothing on a 4-step LoRA."/>
                                                        <TextBlock Text="Same prompt, duration, aspect and seed as the chosen preview — only the canvas, the step count and the ×2 RTX upscale go up, so the final closely tracks the preview without matching it pixel for pixel."
                                                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ════════════════════════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Pairs list (batch) -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Pairs list — one per overlapping first→last pair (batch mode) -->
                                <Border Grid.Column="0" Width="220" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                                        Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="PAIRS — click to review &amp; pick"
                                                   FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,8,10,6"/>
                                        <ListBox ItemsSource="{Binding Pairs}" SelectedItem="{Binding SelectedPair, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="6,3"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="sel" CornerRadius="7" Padding="2"
                                                                        BorderThickness="2" BorderBrush="Transparent">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="sel" Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" Padding="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <Grid Height="46">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="14"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Image Grid.Column="0" Source="{Binding FirstThumb}" Stretch="UniformToFill"/>
                                                                    <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center"
                                                                               HorizontalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}" FontWeight="Bold"/>
                                                                    <Image Grid.Column="2" Source="{Binding LastThumb}" Stretch="UniformToFill"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                                <Grid Margin="0,2,0,0">
                                                                    <TextBlock HorizontalAlignment="Left" Text="{Binding StatusText}"
                                                                               FontSize="9" Foreground="{DynamicResource TabAccentBrush}"/>
                                                                    <TextBlock HorizontalAlignment="Right" FontSize="9" FontWeight="Bold"
                                                                               Foreground="{StaticResource SuccessTextBrush}"
                                                                               Text="{Binding SelectedCount, StringFormat=✓{0} queued}"
                                                                               Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                            <!-- Reorder this pair up/down → changes the sequence in the final joined video. -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <Button Content="▲" FontSize="10" Width="22" Height="22" Padding="0"
                                                                        Foreground="{DynamicResource TabAccentBrush}" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="1" Cursor="Hand" ToolTip="Move pair up"
                                                                        Command="{Binding DataContext.MovePairUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Content="▼" FontSize="10" Width="22" Height="22" Padding="0" Margin="0,4,0,0"
                                                                        Foreground="{DynamicResource TabAccentBrush}" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="1" Cursor="Hand" ToolTip="Move pair down"
                                                                        Command="{Binding DataContext.MovePairDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Sample tiles -->
                                        <RowDefinition Height="*"/>    <!-- Player -->
                                        <RowDefinition Height="Auto"/> <!-- Results strip -->
                                        <RowDefinition Height="Auto"/> <!-- Progress -->
                                        <RowDefinition Height="Auto"/> <!-- Action bar -->
                                        <RowDefinition Height="Auto"/> <!-- Log -->
                                    </Grid.RowDefinitions>

                                    <!-- Sample tiles -->
                                    <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="SEED SAMPLES — click to preview, tick to queue for Finish"
                                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ListBox ItemsSource="{Binding Samples}"
                                                     SelectedItem="{Binding SelectedSampleForPreview, Mode=TwoWay}"
                                                     Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="3"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="3"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="tile" CornerRadius="6" BorderThickness="2"
                                                                            Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="96" Background="Transparent" ToolTip="Click to preview this sample">
                                                            <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"
                                                                       IsHitTestVisible="False"
                                                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4"
                                                                       Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                            <!-- Transparent overlay drives the shared player directly; ListBox
                                                                 SelectedItem alone doesn't reliably reload the clicked sample. -->
                                                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    ToolTip="Click to preview this sample"
                                                                    Command="{Binding DataContext.PreviewSampleCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent"/>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <CheckBox Content="Queue" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Foreground="White" FontSize="10" FontWeight="Bold"
                                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,4"
                                                                      Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TabAccentBrush}" FontSize="9"
                                                                       IsHitTestVisible="False"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Shared player -->
                                    <Border Grid.Row="1" Margin="12" CornerRadius="6"
                                            Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="Generate 3 samples, then click one to preview it here. The finished full-resolution video plays here after Finish."
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                       TextWrapping="Wrap" Margin="20,0" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                       Visibility="{Binding HasActivePreview, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                            <!-- Source is set from code-behind (ApplyMiniMaxFflfSource) as an ABSOLUTE Uri; a
                                                 string {Binding} to MediaElement.Source silently fails on Z:\ output paths. The
                                                 element stays visible so Source is never assigned while Collapsed. -->
                                            <MediaElement x:Name="MiniMaxFflfPlayer"
                                                          Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                          MediaOpened="MiniMaxFflfPlayer_MediaOpened"
                                                          MediaEnded="MiniMaxFflfPlayer_MediaEnded"
                                                          MediaFailed="MiniMaxFflfPlayer_MediaFailed"/>
                                        </Grid>
                                    </Border>

                                    <!-- Results strip -->
                                    <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6"
                                            Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="FINISHED VIDEOS — click to replay" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Results}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.PlayResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Margin="0,0,8,0" Padding="10,4"
                                                                Style="{StaticResource AccentButtonStyle}" Cursor="Hand">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="11"/>
                                                                <TextBlock Text="{Binding Info}" FontSize="9" Foreground="#E6FFFFFF"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Progress -->
                                    <Grid Grid.Row="3" Margin="12,6,12,6">
                                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProcessingProgress}"
                                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"/>
                                    </Grid>

                                    <!-- Action bar -->
                                    <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="▶ Run Batch — analyze + 3 seeds / pair" Command="{Binding RunBatchCommand}"
                                                    Height="32" Padding="16,0" Margin="0,0,8,0" FontWeight="Bold"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="Walk every pair: write its H3 prompt then generate 3 seed previews. Failed pairs are skipped."/>
                                            <Button Content="🎲 Reroll This Pair" Command="{Binding RerollPairCommand}"
                                                    Height="32" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="Regenerate the selected pair's 3 seed previews with a fresh random seed, reusing its prompt. Other pairs are left untouched."/>
                                            <Button Content="🎯 Generate 3 Samples" Command="{Binding HuntCommand}"
                                                    Height="32" Padding="16,0" Margin="0,0,8,0" FontWeight="Bold"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="Generate 3 cheap seed previews from the first/last frame and prompt."/>
                                            <Button Content="🎲 Reroll — new 3 seeds" Command="{Binding HuntCommand}"
                                                    Height="32" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Don't like these? Regenerate 3 fresh previews with a new random seed."
                                                    Visibility="{Binding ShowSingleReroll, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Content="{Binding FinishButtonText}" Command="{Binding FinishCommand}"
                                                    Height="32" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold"
                                                    Style="{StaticResource SuccessButtonStyle}"/>
                                            <Button Content="✕ Cancel" Command="{Binding CancelCommand}"
                                                    Height="32" Padding="12,0" Margin="0,0,8,0"
                                                    Style="{StaticResource DangerButtonStyle}"/>
                                            <Button Content="📁 Open Folder" Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                            <TextBlock Text="{Binding ProcessingStatus}" VerticalAlignment="Center"
                                                       FontStyle="Italic" Foreground="{DynamicResource TabAccentBrush}" FontSize="11" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Log -->
                                    <ctrl:ProcessingLogPanel Grid.Row="5" LogText="{Binding LogOutput}" MaxLogHeight="120"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <!-- Tab: MiniMax H3 T2V (image → 15s multi-shot prompt → one video)   -->
                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🌀📝 MiniMax H3 T2V">
                        <Grid DataContext="{Binding MiniMaxH3T2VVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentAmberColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Source Image -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SOURCE IMAGE" Note="  · analyzed into the prompt" Margin="0,0,0,10"/>

                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                        Background="{StaticResource SurfaceAltBrush}" Height="130" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No image selected"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding ImagePreview}" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ImageInfo}"
                                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectImageCommand}"
                                                            Height="28" Padding="10,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>

                                                <!-- Image role: conditioned first frame, or LLM inspiration only -->
                                                <CheckBox Content="Use image as first frame"
                                                          IsChecked="{Binding UseImageAsFirstFrame}"
                                                          FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="On: the image uploads to ComfyUI and becomes frame 0, and the prompt keeps its &lt;Picture 1&gt; anchor line. Off: pure text-to-video — the LoadImage node and the first_frame link are removed before submit, so the image only ever reaches the llama-server."/>
                                                <TextBlock Text="{Binding ImageRoleDescription}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- Analyze (image + draft idea → 15s multi-shot H3 prompt) -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze → 15s Prompt"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends the image (plus whatever is in the prompt box as a draft idea) to the llama-server with texttovideoH3.md, and writes a dense multi-shot H3 prompt: 9–14 timestamped shots of continuous motion, beat-locked cuts, then overall_soundscape and non_diegetic_music."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="Analyzing…" Foreground="{DynamicResource TabAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="H3 PROMPT" Note="  · draft idea, or the full prompt"/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="260" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>
                                                <TextBlock Text="The &lt;Picture 1&gt; anchor line is added or removed automatically to match the first-frame setting."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,6,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                                                <TextBlock Text="Quality (canvas size)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Megapixels}"
                                                          Height="30" FontSize="11" Margin="0,0,0,10"/>

                                                <TextBlock Text="Length (seconds · 4–15)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Slider Value="{Binding LengthSeconds}"
                                                        Minimum="4" Maximum="15"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding LengthSummary}"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,10"/>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>  <!-- Source image preview -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Source image preview ──────────────────────────────── -->
                                <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="📝" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MiniMax H3 · Text to Video" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Upload an image → Analyze into a 15s multi-shot prompt → Generate"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Image Source="{Binding ImagePreview}" Stretch="Uniform"
                                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <Border VerticalAlignment="Bottom" Margin="10,0,10,10"
                                                CornerRadius="8" Padding="12,6"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                                <Run Text="{Binding ImageRoleDescription, Mode=OneWay}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding ResolvedAspectRatio, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}" FontFamily="Consolas"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate Video" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                IsEnabled="{Binding IsProcessing}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="MiniMaxH3T2VVideoPlayer"
                                                              Source="{Binding ResultVideoPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="5" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <!-- Tab: MiniMax Character (2 character refs + scene image → video)   -->
                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🎭👥 MiniMax Character">
                        <Grid DataContext="{Binding MiniMaxCharacterVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentVioletColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Character references -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CHARACTERS" Note="  · reference frames sent to H3" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Character 1 -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Character 1 · &lt;Picture 1&gt;" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource SurfaceAltBrush}" Height="112" Margin="0,0,0,6">
                                                            <Grid>
                                                                <TextBlock Text="Required"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Character1Preview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding Character1Preview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Button Content="Browse…" Command="{Binding SelectCharacter1Command}"
                                                                Height="26" Padding="8,0" FontSize="11"
                                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        <TextBlock Text="{Binding Character1Info}" FontSize="9" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Character 2 -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Character 2 · &lt;Picture 2&gt;" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource SurfaceAltBrush}" Height="112" Margin="0,0,0,6">
                                                            <Grid>
                                                                <TextBlock Text="Optional"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Character2Preview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding Character2Preview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="Browse…" Command="{Binding SelectCharacter2Command}"
                                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                            <Button Grid.Column="1" Content="✕" Command="{Binding ClearCharacter2Command}"
                                                                    IsEnabled="{Binding HasCharacter2}"
                                                                    Height="26" Width="26" FontSize="11"
                                                                    ToolTip="Clear the second character and run as a single-reference scene."
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Character2Info}" FontSize="9" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding CharacterSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Scene image -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SCENE IMAGE" Note="  · analyzed into the prompt only" Margin="0,0,0,10"/>

                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                        Background="{StaticResource SurfaceAltBrush}" Height="130" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No scene image selected"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SceneImagePreview}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding SceneImagePreview}" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding SceneImageInfo}"
                                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectSceneImageCommand}"
                                                            Height="28" Padding="10,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>

                                                <TextBlock Text="This image is never uploaded to ComfyUI — only the llama-server sees it. It sets the setting, lighting and art style the characters act in."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- Story guidance + total video duration.
                                                     H3 caps out at ~15s, so a longer target is written as a
                                                     chain of clips and queued one job per clip. -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="118"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Story (optional)" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding StoryGuidance, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                                 Height="86" VerticalScrollBarVisibility="Auto"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                                 FontSize="11" Padding="6"
                                                                 ToolTip="What the video is about, from beginning to end. Left empty, Analyze invents a story that suits the scene image; filled, every clip is written against this."/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Video duration" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="0,5" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding StoryDurationSeconds, StringFormat={}{0:0} s}"
                                                                       HorizontalAlignment="Center" FontFamily="Consolas"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TabAccentBrush}"/>
                                                        </Border>
                                                        <Slider Value="{Binding StoryDurationSeconds}"
                                                                Minimum="5" Maximum="120"
                                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                                SmallChange="5" LargeChange="15"
                                                                Foreground="{DynamicResource TabAccentBrush}"
                                                                ToolTip="Length of the finished video, in 5-second steps up to 2 minutes. MiniMax H3 renders at most ~15s per pass, so anything longer is written as a chain of clips and queued one job per clip."/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding StorySummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze → Scene Prompt"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends the scene image, the story box and whatever is in the prompt box as a draft idea to the llama-server with texttovideoH3.md, and writes a dense multi-shot H3 prompt in which the characters are referred to as &lt;Picture 1&gt; / &lt;Picture 2&gt;. Past one clip's worth of duration it writes the whole chain in one reply — one complete prompt per clip, split by &quot;=== CLIP n of N ===&quot; headers."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="Analyzing…" Foreground="{DynamicResource TabAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="H3 PROMPT" Note="  · draft idea, or the full prompt"/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="240" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>

                                                <!-- What Generate will actually queue: the chain is split on
                                                     its headers, so hand-edits here are honoured. -->
                                                <TextBlock Text="{Binding PromptClipSummary}"
                                                           Visibility="{Binding HasPromptSequence, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TabAccentBrush}" TextWrapping="Wrap"/>

                                                <!-- Scene library: analyzed prompts are filed automatically;
                                                     this row is how they come back out. -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{Binding SceneLibraryLabel}"
                                                            Command="{Binding OpenSceneLibraryCommand}"
                                                            Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Browse the scenes this tab has saved and drop one into the prompt box. Handy for reusing a scene with a different pair of characters."/>
                                                    <Button Grid.Column="1" Content="💾 Save"
                                                            Command="{Binding SaveSceneCommand}"
                                                            Height="28" Width="76" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="File the prompt box's current contents in the scene library. Analyzed and generated prompts are saved automatically — this is for hand-edited ones."/>
                                                </Grid>

                                                <TextBlock Text="The reference line is rewritten automatically to match how many character images are loaded."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,6,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                                                <TextBlock Text="Quality (canvas size)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Megapixels}"
                                                          Height="30" FontSize="11" Margin="0,0,0,10"/>

                                                <TextBlock Text="Refinement pass" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="RTX Video Super Resolution ×2 (ULTRA)"
                                                           FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"
                                                           ToolTip="Fixed. The H3 frames are upscaled ×2 on the way to the file — no second diffusion model, so it costs seconds rather than a second render. It replaced the old Wan 2.2 / LTX 2.3 branches, which are pruned out of the graph."/>
                                                <TextBlock Text="{Binding UpscaleSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <TextBlock Text="Clip length (seconds · 4–15)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Slider Value="{Binding LengthSeconds}"
                                                        Minimum="4" Maximum="15"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,2"
                                                        ToolTip="How long a single H3 pass is — the model's own limit. The Video duration slider divides by this to decide how many clips the story is split into."/>
                                                <TextBlock Text="{Binding LengthSummary}"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding StorySummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>  <!-- Cast strip -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Queue -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Cast strip: the two references and the scene ─────────── -->
                                <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCharacter1}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🎭" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MiniMax H3 · Character Reference" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Load 1–2 character images + a scene image → Analyze → Generate"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Visibility="{Binding HasCharacter1, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <Image Source="{Binding Character1Preview}" Stretch="Uniform" Height="176"/>
                                                <TextBlock Text="Character 1 · &lt;Picture 1&gt;" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="6,0"
                                                        Visibility="{Binding HasCharacter2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Source="{Binding Character2Preview}" Stretch="Uniform" Height="176"/>
                                                <TextBlock Text="Character 2 · &lt;Picture 2&gt;" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="6,0,0,0"
                                                        Visibility="{Binding HasSceneImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Source="{Binding SceneImagePreview}" Stretch="Uniform" Height="176"/>
                                                <TextBlock Text="Scene · prompt only" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold" BorderThickness="0"
                                                ToolTip="Snapshots the characters, prompt and settings into the queue and starts rendering. A multi-clip story is split on its &quot;=== CLIP n of N ===&quot; headers and queued as one job per clip, rendered in order. The tab stays free — load the next scene image and Analyze it while this one runs.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Add to Queue &amp; Generate" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- A story queued in this session joins itself when its last clip
                                             lands; this is for clips already sitting on disk. -->
                                        <Button Grid.Column="1" Height="40" Width="92" Margin="0,0,8,0"
                                                Command="{Binding JoinClipsCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="11"
                                                ToolTip="Joins clips that are already on disk — for stories rendered in an earlier session, which the queue no longer knows about. Pick any ONE clip of a story and its siblings are collected automatically, in clip order; pick several files and exactly those are joined, in file-name order. Never overwrites an existing joined file.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔗 " VerticalAlignment="Center"/>
                                                <TextBlock Text="Join" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                IsEnabled="{Binding IsProcessingQueue}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11"
                                                ToolTip="Stops the queue after cancelling the item currently on the GPU. Pending items stay queued.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Queue ─────────────────────────────────────────────────
                                     Each row is a frozen snapshot of the whole form, so new scene
                                     images can be loaded and analyzed while earlier jobs render. -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"
                                        Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🎭 Character Queue"
                                                       FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="▶ Start"
                                                    Command="{Binding StartQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Resume draining pending items."/>
                                            <Button Grid.Column="3" Content="🔄 Retry"
                                                    Command="{Binding ReprocessAllFailedCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Put every failed item back to Pending and run them again."/>
                                            <Button Grid.Column="4" Content="⏹ Stop"
                                                    Command="{Binding StopQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                            <Button Grid.Column="5" Content="🗑️ Clear"
                                                    Command="{Binding ClearQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Queue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,5" Margin="0,0,0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <Image Grid.Column="1" Source="{Binding QueueThumbnail}"
                                                                   Height="34" Stretch="Uniform" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Prompt}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                                           Foreground="{StaticResource DangerBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="MiniMaxCharacterVideoPlayer"
                                                              Source="{Binding ResultVideoPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
