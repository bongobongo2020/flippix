<Window x:Class="FlipPix.UI.OllamaWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ollama Prompt Enhancer" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <!--
        This window used to carry a full dark-theme override of Button/TextBox/ComboBox/
        GroupBox, which made it the odd one out. The local copies are gone: TextBox,
        ComboBox and ProgressBar now inherit the app-wide implicit styles, and the rest
        derive from the shared keyed styles.
    -->
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection Settings -->
        <GroupBox Grid.Row="0" Header="Ollama Connection">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding OllamaUrl}"/>
                <Button Grid.Column="1" Content="Connect"
                        Command="{Binding ConnectCommand}"/>
                <Button Grid.Column="2" Content="Refresh Models"
                        Command="{Binding RefreshModelsCommand}"/>
            </Grid>
        </GroupBox>

        <!-- Model Selection and Enhancement Type -->
        <GroupBox Grid.Row="1" Header="Settings">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Select Model:"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel}"
                              DisplayMemberPath="Name"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Enhancement Type:"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding EnhancementTypes}"
                              SelectedValue="{Binding SelectedEnhancementType}"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- User Prompt -->
            <GroupBox Grid.Column="0" Header="Your Prompt">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding UserPrompt}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <Button Grid.Row="1" Content="Enhance Prompt"
                            Command="{Binding EnhancePromptCommand}"
                            Margin="0,10,0,0"/>
                </Grid>
            </GroupBox>

            <!-- Enhanced Prompt -->
            <GroupBox Grid.Column="1" Header="Enhanced Prompt">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding EnhancedPrompt}"
                                   Style="{StaticResource {x:Type TextBlock}}"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Send to Image Generator"
                                Command="{Binding SendToImageGeneratorCommand}"/>
                        <Button Content="Send to Video Generator"
                                Command="{Binding SendToVideoGeneratorCommand}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Height="30" Background="{StaticResource AppBackgroundBrush}"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" Margin="10,0"/>
                    <ProgressBar Width="100" Height="16" Margin="10,0,0,0"
                                 IsIndeterminate="{Binding IsProcessing}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>