                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="60"
                                            Height="32"
                                            Padding="10,5"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- StoryImageZ Options Panel (Style + LoRA) -->
