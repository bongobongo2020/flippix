<Window x:Class="FlipPix.UI.ImageGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlipPix - Image Generator" Height="950" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="650" MinWidth="850"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF6B35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8556"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66BB6A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnalyzeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6B35" Offset="0"/>
                    <GradientStop Color="#F7931E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title Section -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Image Generator"
                              FontSize="28" FontWeight="Bold"
                              Foreground="White"/>
                    <TextBlock Text="Generate images from text descriptions using AI"
                              FontSize="13" Foreground="#FFFAF0"
                              Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Settings Button -->
                <Button Grid.Column="1"
                        Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10"
                        Cursor="Hand"
                        ToolTip="Open Settings"
                        Margin="20,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="⚙️" FontSize="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="#E9ECEF" BorderBrush="#DEE2E6" BorderThickness="0,1,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Navigate:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#495057"/>
                <Button Content="🎬 Video Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToVideoGeneratorCommand}" Background="#6366F1"/>
                <Button Content="📖 Story Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToStoryVideoCommand}" Background="#10B981"/>
            </StackPanel>
        </Border>

        <!-- Main Content with Tabbed Interface -->
        <TabControl Grid.Row="2" Margin="15,10,15,10" Background="Transparent"
                   SelectedIndex="{Binding SelectedTabIndex}">

            <!-- Tab 1: Text Generation -->
            <TabItem Header="✏️ Text Generation" FontWeight="Bold" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5,15,5,15">

                        <!-- Image Prompt Section -->
                        <Border Style="{StaticResource SectionPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Image Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                <!-- Saved Prompts Section -->
                                <Border Background="#FFF8DC" BorderBrush="#DEB887" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="📝 Saved Prompts" FontWeight="Bold" FontSize="13" Foreground="#8B4513" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Select a saved prompt or save current:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="💾 Save" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding SavePromptCommand}" Padding="10,5" Margin="5,0,5,0"
                                                    ToolTip="Save current prompt settings"
                                                    Background="#4CAF50"/>
                                            <Button Grid.Column="2" Content="🗑️ Delete" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DeletePromptCommand}" Padding="10,5" Margin="0,0,0,0"
                                                    ToolTip="Delete selected saved prompt"
                                                    Background="#F44336"/>
                                        </Grid>

                                    <ComboBox ItemsSource="{Binding SavedPrompts}"
                                              SelectedItem="{Binding SelectedSavedPrompt, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              Padding="10"
                                              Background="White"
                                              BorderBrush="#CED4DA"
                                              FontSize="12"
                                              Margin="0,5,0,10"
                                              Height="40">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}"
                                                               FontSize="10" Foreground="#666"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="💡 Tip: Your saved prompts appear here. Click Save to store the current prompt settings."
                                               FontSize="11" Foreground="#666" FontStyle="Italic" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                                <TextBlock Text="Describe the image you want to generate"
                                           FontSize="12"
                                           Foreground="#666"
                                           Margin="0,0,0,10"/>

                                <TextBox Text="{Binding ImagePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        Height="120"
                                        Padding="12"
                                        VerticalScrollBarVisibility="Auto"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        FontSize="13"
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="Example prompts:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,3">
                                    <Run Text="• "/>
                                    <Run Text="Latina female with thick wavy hair, harbor boats and pastel houses behind. Breezy seaside light, warm tones, cinematic close-up."/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,3">
                                    <Run Text="• "/>
                                    <Run Text="A majestic mountain landscape at sunset with dramatic clouds and golden light"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#666">
                                    <Run Text="• "/>
                                    <Run Text="Portrait of a cyberpunk character with neon lights reflecting on metallic surfaces"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Image Settings and Generate -->
                        <Border Style="{StaticResource SectionPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Settings -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Image Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                    <!-- Aspect Ratio -->
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <ComboBox SelectedIndex="{Binding AspectRatioIndex, Mode=TwoWay}"
                                                 Padding="10"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="12">
                                            <ComboBoxItem Content="SDXL - 1:1 square 1024x1024"/>
                                            <ComboBoxItem Content="SDXL - 3:4 portrait 896x1152"/>
                                            <ComboBoxItem Content="SDXL - 9:16 portrait 768x1344"/>
                                            <ComboBoxItem Content="SDXL - 4:3 landscape 1152x896"/>
                                            <ComboBoxItem Content="SDXL - 16:9 landscape 1344x768"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Steps -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding Steps, Mode=TwoWay}"
                                                    Minimum="4" Maximum="20"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding Steps}"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      MinWidth="25"
                                                      FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- CFG -->
                                    <StackPanel>
                                        <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding Cfg, Mode=TwoWay}"
                                                    Minimum="1" Maximum="3"
                                                    TickFrequency="0.5"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding Cfg, StringFormat={}{0:F1}}"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      MinWidth="25"
                                                      FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Lora Settings -->
                                    <StackPanel Margin="0,15,0,0">
                                        <TextBlock Text="LoRA Model" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>

                                        <!-- Lora Enable Toggle -->
                                        <CheckBox Content="Enable LoRA"
                                                 IsChecked="{Binding LoraEnabled, Mode=TwoWay}"
                                                 FontWeight="SemiBold"
                                                 FontSize="12"
                                                 Margin="0,0,0,8"/>

                                        <!-- Lora Selection (only visible when enabled) -->
                                        <Grid Visibility="{Binding LoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox Grid.Column="0"
                                                         ItemsSource="{Binding AvailableLoras}"
                                                         SelectedItem="{Binding SelectedLora, Mode=TwoWay}"
                                                         Padding="10"
                                                         Background="White"
                                                         BorderBrush="#CED4DA"
                                                         FontSize="12"
                                                         Height="35"
                                                         Margin="0,0,8,0"/>

                                                <Button Grid.Column="1"
                                                       Content="↻"
                                                       Command="{Binding RefreshLorasCommand}"
                                                       Padding="10,5"
                                                       Background="#6C757D"
                                                       Foreground="White"
                                                       BorderThickness="0"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Width="35"
                                                       Height="35"
                                                       Cursor="Hand"
                                                       ToolTip="Refresh LoRA list">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="5"
                                                                   Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#5A6268"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                     Text="Configure ComfyUI installation path in Settings. LoRAs will be auto-detected from ComfyUI's model paths"
                                                     FontSize="10"
                                                     Foreground="#666"
                                                     FontStyle="Italic"
                                                     Margin="0,5,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Generate Button and Status -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Generate Image"
                                           Style="{StaticResource PrimaryButtonStyle}"
                                           Command="{Binding GenerateImageCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="55"
                                           FontSize="15"
                                           Margin="0,0,0,15"/>

                                    <!-- Processing Status -->
                                    <Border Background="#FFF9F0"
                                            BorderBrush="#FFE0B0"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12"
                                            Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                      FontWeight="SemiBold"
                                                      FontSize="11"
                                                      Margin="0,0,0,5"
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap"/>
                                            <ProgressBar Value="{Binding ProcessingProgress}"
                                                        Height="16"
                                                        Foreground="#FF6B35"
                                                        Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding ProgressPercentage}"
                                                      HorizontalAlignment="Center"
                                                      FontSize="11"
                                                      FontWeight="Bold"
                                                      Foreground="#FF6B35"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Result Image Section -->
                        <Border Style="{StaticResource SectionPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Result Image" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                        Background="White" Height="400"
                                        CornerRadius="5" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="Image will appear here after generation"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="#999"
                                                  FontStyle="Italic">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasResultImage}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Image Source="{Binding ResultImageSource}"
                                               Stretch="Uniform"
                                               Visibility="{Binding HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                           Content="🎥 Camera Edit"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           Command="{Binding SendToCameraEditCommand}"
                                           IsEnabled="{Binding HasResultImage}"
                                           Margin="0,0,8,0"/>

                                    <Button Grid.Column="1"
                                           Content="🎬 Video Generator"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           Command="{Binding SendToVideoGeneratorCommand}"
                                           IsEnabled="{Binding HasResultImage}"
                                           Margin="0,0,8,0"/>

                                    <Button Grid.Column="2"
                                           Content="📂 Open Folder"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           Command="{Binding OpenResultFolderCommand}"
                                           IsEnabled="{Binding HasResultImage}"/>
                                </Grid>

                                <TextBlock Text="{Binding ImageInfo}"
                                          FontStyle="Italic"
                                          Foreground="#666"
                                          FontSize="11"
                                          Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Advanced Settings (Collapsible) -->
                        <Expander Header="Advanced Settings"
                                 Margin="0,0,0,15"
                                 IsExpanded="False">
                            <Border Background="#F8F9FA"
                                    BorderBrush="#DEE2E6"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="15"
                                    Margin="0,8,0,0">
                                <StackPanel>
                                    <!-- Seed -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Seed (0 = Random)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding Seed, Mode=TwoWay}"
                                                Padding="8"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="11"/>
                                    </StackPanel>

                                    <!-- Denoise -->
                                    <StackPanel>
                                        <TextBlock Text="Denoise" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding Denoise, Mode=TwoWay}"
                                                    Minimum="0.5" Maximum="1"
                                                    TickFrequency="0.1"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding Denoise, StringFormat={}{0:F1}}"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      MinWidth="25"
                                                      FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Log (Collapsible) -->
                        <Expander Header="Processing Log"
                                 IsExpanded="True"
                                 Margin="0,0,0,0">
                            <Border Background="White"
                                    BorderBrush="#DEE2E6"
                                    BorderThickness="1"
                                    Margin="0,8,0,0">
                                <ScrollViewer MaxHeight="150"
                                             VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding LogOutput}"
                                            TextWrapping="Wrap"
                                            IsReadOnly="True"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="10"/>
                                </ScrollViewer>
                            </Border>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Image Analysis -->
            <TabItem Header="🔍 Image Analysis" FontWeight="Bold" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10,15,10,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column - Image Input -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <!-- Source Image Upload Section -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Source Image" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>

                                    <TextBlock Text="Upload an image to analyze"
                                               FontSize="12"
                                               Foreground="#666"
                                               Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                Text="{Binding Analyzer.SourceImagePath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                VerticalContentAlignment="Center"/>

                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding Analyzer.BrowseImageCommand}"
                                               Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Image Preview -->
                                    <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                            Background="White" Height="300"
                                            CornerRadius="5">
                                        <Grid>
                                            <TextBlock Text="No image selected"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#999"
                                                      FontStyle="Italic"
                                                      FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Analyzer.HasSourceImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Image Source="{Binding Analyzer.SourceImageSource}"
                                                   Stretch="Uniform"
                                                   Margin="5"
                                                   Visibility="{Binding Analyzer.HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Analyze Button -->
                                    <Button Content="Analyze Image with QwenVL"
                                           Style="{StaticResource AnalyzeButtonStyle}"
                                           Command="{Binding Analyzer.AnalyzeImageCommand}"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,15,0,0"
                                           Height="45"
                                           Background="#F59E0B"/>
                                </StackPanel>
                            </Border>

                            <!-- Analysis Settings -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Analysis Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>

                                    <!-- Aspect Ratio -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <ComboBox SelectedIndex="{Binding Analyzer.AspectRatioIndex, Mode=TwoWay}"
                                                 Padding="10"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="12">
                                            <ComboBoxItem Content="SDXL - 1:1 square 1024x1024"/>
                                            <ComboBoxItem Content="SDXL - 3:4 portrait 896x1152"/>
                                            <ComboBoxItem Content="SDXL - 9:16 portrait 768x1344"/>
                                            <ComboBoxItem Content="SDXL - 4:3 landscape 1152x896"/>
                                            <ComboBoxItem Content="SDXL - 16:9 landscape 1344x768"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Style Preset -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Style Preset" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <ComboBox SelectedIndex="{Binding Analyzer.SelectedStyleIndex, Mode=TwoWay}"
                                                 Padding="10"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="12">
                                            <ComboBoxItem Content="None"/>
                                            <ComboBoxItem Content="Phone Photo"/>
                                            <ComboBoxItem Content="Cinematic"/>
                                            <ComboBoxItem Content="Anime"/>
                                            <ComboBoxItem Content="Oil Painting"/>
                                            <ComboBoxItem Content="3D Render"/>
                                            <ComboBoxItem Content="Watercolor"/>
                                            <ComboBoxItem Content="Digital Art"/>
                                            <ComboBoxItem Content="Vintage Photo"/>
                                            <ComboBoxItem Content="Cyberpunk"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Steps -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding Analyzer.Steps, Mode=TwoWay}"
                                                    Minimum="4" Maximum="20"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding Analyzer.Steps}"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      MinWidth="30"
                                                      FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- CFG -->
                                    <StackPanel>
                                        <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding Analyzer.Cfg, Mode=TwoWay}"
                                                    Minimum="1" Maximum="3"
                                                    TickFrequency="0.5"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding Analyzer.Cfg, StringFormat={}{0:F1}}"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      MinWidth="30"
                                                      FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column - Analysis Result -->
                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                            <!-- Analysis Result Section -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="AI Analysis Result" Style="{StaticResource HeaderTextStyle}" Foreground="#8B5CF6"/>

                                    <TextBlock Text="Edit the analysis before generating the image"
                                               FontSize="12"
                                               Foreground="#666"
                                               Margin="0,0,0,10"/>

                                    <TextBox Text="{Binding Analyzer.AnalysisText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap"
                                            AcceptsReturn="True"
                                            Height="200"
                                            Padding="12"
                                            VerticalScrollBarVisibility="Auto"
                                            Background="White"
                                            BorderBrush="#CED4DA"
                                            FontSize="13"
                                            Margin="0,0,0,15"/>

                                    <!-- Processing Status for Analysis -->
                                    <Border Background="#FEF3C7"
                                            BorderBrush="#FCD34D"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Padding="15"
                                            Margin="0,0,0,15"
                                            Visibility="{Binding Analyzer.IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="Analyzing image..."
                                                      FontWeight="Bold"
                                                      FontSize="12"
                                                      Margin="0,0,0,8"
                                                      TextAlignment="Center"
                                                      Foreground="#92400E"/>
                                            <ProgressBar IsIndeterminate="True"
                                                        Height="20"
                                                        Foreground="#F59E0B"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Generate Button -->
                                    <Button Content="Process &amp; Generate Image"
                                           Style="{StaticResource PrimaryButtonStyle}"
                                           Command="{Binding Analyzer.GenerateImageCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="50"
                                           FontSize="16"
                                           Background="#8B5CF6"/>
                                </StackPanel>
                            </Border>

                            <!-- Result Image Section -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Generated Image" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                                    <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                            Background="White" Height="350"
                                            CornerRadius="5" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Generated image will appear here"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#999"
                                                      FontStyle="Italic"
                                                      FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Analyzer.HasResultImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Image Source="{Binding Analyzer.ResultImageSource}"
                                                   Stretch="Uniform"
                                                   Margin="5"
                                                   Visibility="{Binding Analyzer.HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <Button Content="Open Output Folder"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           Command="{Binding Analyzer.OpenResultFolderCommand}"
                                           IsEnabled="{Binding Analyzer.HasResultImage}"
                                           HorizontalAlignment="Stretch"/>

                                    <TextBlock Text="{Binding Analyzer.ImageInfo}"
                                              FontStyle="Italic"
                                              Foreground="#666"
                                              FontSize="11"
                                              Margin="0,10,0,0"
                                              TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Story Image Generator -->
            <TabItem Header="📖 Story Image Z" FontWeight="Bold" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5,15,5,15">

                        <!-- Story Prompts and Input Section -->
                        <Border Style="{StaticResource SectionPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column - JSON File and Input Image -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="📝 Story Prompts" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                                    <!-- Prompt JSON File Selection -->
                                    <TextBlock Text="Select story prompts JSON file"
                                               FontSize="12"
                                               Foreground="#666"
                                               Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                Text="{Binding StoryGenerator.PromptJsonFilePath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                VerticalContentAlignment="Center"
                                                FontSize="11"/>

                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding StoryGenerator.SelectPromptJsonCommand}"
                                               Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Input Image Section (Hidden - Text-to-Image Workflow) -->
                                    <!-- Note: This section is hidden since amazing-z-image-a workflow is text-to-image only -->
                                    <TextBlock Text="Select input image"
                                               FontSize="12"
                                               Foreground="#666"
                                               Margin="0,0,0,10"
                                               Visibility="Collapsed"/>

                                    <Grid Margin="0,0,0,15" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                Text="{Binding StoryGenerator.InputImagePath, Mode=TwoWay}"
                                                IsReadOnly="True"
                                                Padding="10"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                VerticalContentAlignment="Center"
                                                FontSize="11"/>

                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding StoryGenerator.SelectInputImageCommand}"
                                               Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Input Image Preview (Hidden) -->
                                    <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                            Background="White" Height="200"
                                            CornerRadius="5" Margin="0,0,0,10"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <TextBlock Text="No input image selected"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#999"
                                                      FontStyle="Italic">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StoryGenerator.InputImagePreview}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding StoryGenerator.InputImagePreview, Mode=OneWay}"
                                                   Stretch="Uniform"
                                                   Margin="5"/>
                                        </Grid>
                                    </Border>

                                    <!-- Load Prompts Button -->
                                    <Button Content="📥 Load Prompts from JSON"
                                           Style="{StaticResource PrimaryButtonStyle}"
                                           Command="{Binding StoryGenerator.LoadPromptsCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="45"
                                           Background="#10B981"/>
                                </StackPanel>

                                <!-- Right Column - Generation Settings -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="⚙️ Generation Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                                    <!-- Steps -->
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding StoryGenerator.Steps, Mode=TwoWay}"
                                                    Minimum="1" Maximum="20"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding StoryGenerator.Steps}"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      MinWidth="25"
                                                      FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- CFG -->
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding StoryGenerator.Cfg, Mode=TwoWay}"
                                                    Minimum="1" Maximum="10"
                                                    TickFrequency="0.5"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding StoryGenerator.Cfg, StringFormat={}{0:F1}}"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      MinWidth="25"
                                                      FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Denoise -->
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Text="Denoise" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding StoryGenerator.Denoise, Mode=TwoWay}"
                                                    Minimum="0" Maximum="1"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding StoryGenerator.Denoise, StringFormat={}{0:F2}}"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      MinWidth="25"
                                                      FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Negative Prompt -->
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Text="Negative Prompt" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding StoryGenerator.NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="60"
                                                Padding="10"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="11"/>
                                    </StackPanel>

                                    <!-- Orientation/Resolution -->
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Text="📐 Orientation &amp; Resolution" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <ComboBox ItemsSource="{Binding StoryGenerator.AvailableOrientations}"
                                                  SelectedItem="{Binding StoryGenerator.SelectedOrientation, Mode=TwoWay}"
                                                  Padding="10"
                                                  Background="White"
                                                  BorderBrush="#CED4DA"
                                                  FontSize="11"/>
                                        <TextBlock Text="Select the image orientation and resolution"
                                                  FontSize="10"
                                                  Foreground="#999"
                                                  Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Spicy Content Toggle -->
                                    <StackPanel Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="🌶️ Spicy Content Mode"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"/>

                                            <CheckBox Grid.Column="1"
                                                    IsChecked="{Binding StoryGenerator.SpicyContentEnabled, Mode=TwoWay}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Enable for more mature/sensual content"
                                                  FontSize="10"
                                                  Foreground="#999"
                                                  Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Art Style Selection -->
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Text="🎨 Art Style" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                        <ComboBox ItemsSource="{Binding StoryGenerator.AvailableStyles}"
                                                  SelectedItem="{Binding StoryGenerator.SelectedStyle, Mode=TwoWay}"
                                                  Padding="10"
                                                  Background="White"
                                                  BorderBrush="#CED4DA"
                                                  FontSize="11"/>
                                        <TextBlock Text="Select the artistic style for image generation"
                                                  FontSize="10"
                                                  Foreground="#999"
                                                  Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Upscale Settings -->
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Text="🔍 Upscale Settings" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>

                                        <!-- Upscale Enabled -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="Enable Upscaling"
                                                      FontSize="11"
                                                      VerticalAlignment="Center"/>

                                            <CheckBox Grid.Column="1"
                                                    IsChecked="{Binding StoryGenerator.UpscaleEnabled, Mode=TwoWay}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Upscale Method -->
                                        <TextBlock Text="Upscale Method" FontSize="11" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding StoryGenerator.UpscaleMethods}"
                                                  SelectedItem="{Binding StoryGenerator.UpscaleMethod, Mode=TwoWay}"
                                                  Padding="8"
                                                  Background="White"
                                                  BorderBrush="#CED4DA"
                                                  FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Queue Management Section -->
                        <Border Style="{StaticResource SectionPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="📋 Story Queue Management" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                                <!-- Queue Controls -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                           Content="🚀 Generate Story"
                                           Style="{StaticResource PrimaryButtonStyle}"
                                           Command="{Binding StoryGenerator.ProcessQueueCommand}"
                                           Margin="0,0,5,0"
                                           Background="#10B981"/>

                                    <Button Grid.Column="1"
                                           Content="📂 Open Output Folder"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           Command="{Binding StoryGenerator.OpenOutputFolderCommand}"
                                           Margin="5,0,5,0"/>

                                    <Button Grid.Column="2"
                                           Content="🗑️ Clear Queue"
                                           Command="{Binding StoryGenerator.ClearQueueCommand}"
                                           Margin="5,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Background" Value="#DC3545"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E55563"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#CCC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Queue Status -->
                                <Border Background="#F8F9FA"
                                        BorderBrush="#DEE2E6"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12"
                                        Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                  Text="Queue Status"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGenerator.QueuedCount, StringFormat={}Queued: {0}}"
                                                  Margin="10,0"
                                                  VerticalAlignment="Center"
                                                  FontSize="11"/>

                                        <TextBlock Grid.Column="2"
                                                  Text="{Binding StoryGenerator.CompletedCount, StringFormat={}Completed: {0}}"
                                                  Margin="10,0"
                                                  VerticalAlignment="Center"
                                                  FontSize="11"
                                                  Foreground="#28A745"/>

                                        <TextBlock Grid.Column="3"
                                                  Text="{Binding StoryGenerator.FailedCount, StringFormat={}Failed: {0}}"
                                                  Margin="10,0"
                                                  VerticalAlignment="Center"
                                                  FontSize="11"
                                                  Foreground="#DC3545"/>
                                    </Grid>
                                </Border>

                                <!-- Queue Progress -->
                                <Border Background="#FFF9F0"
                                        BorderBrush="#FFE0B0"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12"
                                        Margin="0,0,0,15"
                                        Visibility="{Binding StoryGenerator.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StoryGenerator.QueueProgressText, StringFormat={}Processing Story: {0}}"
                                                  FontWeight="SemiBold"
                                                  FontSize="11"
                                                  Margin="0,0,0,5"
                                                  TextAlignment="Center"/>
                                        <ProgressBar Value="{Binding StoryGenerator.QueueProgress, Mode=OneWay}"
                                                    Maximum="{Binding StoryGenerator.QueueTotal, Mode=OneWay}"
                                                    Height="16"
                                                    Foreground="#10B981"
                                                    Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding StoryGenerator.CurrentQueueItem.Prompt, StringFormat={}Current: {0}}"
                                                  HorizontalAlignment="Center"
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  Foreground="#10B981"
                                                  TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- Queue Items List -->
                                <Border Background="White"
                                        BorderBrush="#DEE2E6"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        MaxHeight="300">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding StoryGenerator.QueueItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E9ECEF"
                                                           BorderThickness="0,0,0,1"
                                                           Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Index -->
                                                            <TextBlock Grid.Column="0"
                                                                      Text="{Binding Index, StringFormat='#{0}'}"
                                                                      FontWeight="Bold"
                                                                      FontSize="14"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,10,0"
                                                                      Foreground="#10B981"/>

                                                            <!-- Item Info -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Prompt}"
                                                                          FontWeight="SemiBold"
                                                                          FontSize="12"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          MaxWidth="400"/>
                                                                <TextBlock Text="{Binding InputImagePath}"
                                                                          FontSize="10"
                                                                          Foreground="#666"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          MaxWidth="400"/>
                                                                <TextBlock Text="{Binding OutputImagePath}"
                                                                          FontSize="10"
                                                                          Foreground="#28A745"
                                                                          Visibility="{Binding OutputImagePath, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          MaxWidth="400"/>
                                                            </StackPanel>

                                                            <!-- Status -->
                                                            <StackPanel Grid.Column="2"
                                                                       Orientation="Horizontal"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0">
                                                                <TextBlock Text="{Binding Status}"
                                                                          FontSize="11"
                                                                          FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#6C757D"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                                    <Setter Property="Foreground" Value="#007BFF"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Foreground" Value="#FF6B35"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                    <Setter Property="Foreground" Value="#28A745"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                    <Setter Property="Foreground" Value="#DC3545"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <!-- Progress bar for processing items -->
                                                                <ProgressBar Value="{Binding Progress}"
                                                                           Width="50"
                                                                           Height="12"
                                                                           Margin="5,0">
                                                                    <ProgressBar.Style>
                                                                        <Style TargetType="ProgressBar">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ProgressBar.Style>
                                                                </ProgressBar>
                                                            </StackPanel>

                                                            <!-- Error Message (if any) -->
                                                            <TextBlock Grid.Column="3"
                                                                      Text="{Binding ErrorMessage}"
                                                                      FontSize="10"
                                                                      Foreground="#DC3545"
                                                                      VerticalAlignment="Center"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      MaxWidth="150"
                                                                      Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Log Section -->
                        <Expander Header="Processing Log"
                                 IsExpanded="True"
                                 Margin="0,0,0,0">
                            <Border Background="White"
                                    BorderBrush="#DEE2E6"
                                    BorderThickness="1"
                                    Margin="0,8,0,0">
                                <ScrollViewer MaxHeight="150"
                                             VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding StoryGenerator.LogOutput}"
                                            TextWrapping="Wrap"
                                            IsReadOnly="True"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="10"/>
                                </ScrollViewer>
                            </Border>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3.5: Story Image Generator Q (Qwen Rapid Edit) -->
            <TabItem Header="📖 Story Image Q" FontWeight="Bold" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">

                        <!-- Header with Settings Toggle -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="✨ Story Image Generator Q"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#8B5CF6"
                                       VerticalAlignment="Center"/>

                            <Button HorizontalAlignment="Right"
                                    Command="{Binding StoryGeneratorQ.ToggleSettingsVisibilityCommand}"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Background="#F3F4F6"
                                    BorderThickness="0">
                                <Button.Content>
                                    <TextBlock Text="⚙️" FontSize="20" />
                                </Button.Content>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                           CornerRadius="8"
                                                           Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E5E7EB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Settings Panel (Collapsible) -->
                        <Border Background="#F9FAFB"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.SettingsVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Steps -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,15,0">
                                    <TextBlock Text="Steps"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding StoryGeneratorQ.Steps, Mode=TwoWay}"
                                               Minimum="1" Maximum="20"
                                               TickFrequency="1"
                                               IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.Steps}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="#8B5CF6"/>
                                    </Grid>
                                </StackPanel>

                                <!-- CFG -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,15,0">
                                    <TextBlock Text="CFG"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding StoryGeneratorQ.Cfg, Mode=TwoWay}"
                                               Minimum="1" Maximum="10"
                                               TickFrequency="0.5"
                                               IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.Cfg, StringFormat={}{0:F1}}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="#8B5CF6"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Denoise -->
                                <StackPanel Grid.Column="2" Grid.Row="0">
                                    <TextBlock Text="Denoise"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding StoryGeneratorQ.Denoise, Mode=TwoWay}"
                                               Minimum="0" Maximum="1"
                                               TickFrequency="0.05"
                                               IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.Denoise, StringFormat={}{0:F2}}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="#8B5CF6"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Negative Prompt -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="0,15,0,0">
                                    <TextBlock Text="Negative Prompt"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           TextWrapping="Wrap"
                                           AcceptsReturn="True"
                                           Height="60"
                                           Padding="12"
                                           VerticalScrollBarVisibility="Auto"
                                           Background="White"
                                           BorderBrush="#D1D5DB"
                                           FontSize="12">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Content Area -->
                        <Border Background="White"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="16"
                               Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column - File Selection -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📝 Story Prompts"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,15"/>

                                    <!-- Prompt JSON File -->
                                    <TextBlock Text="Prompts JSON File"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                               Text="{Binding StoryGeneratorQ.PromptJsonFilePath, Mode=TwoWay}"
                                               IsReadOnly="True"
                                               Padding="10"
                                               Background="#F9FAFB"
                                               BorderBrush="#E5E7EB"
                                               VerticalContentAlignment="Center"
                                               FontSize="11"
                                               Height="38"/>
                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               Command="{Binding StoryGeneratorQ.SelectPromptJsonCommand}"
                                               Margin="8,0,0,0"
                                               Width="80"
                                               Height="38"
                                               Background="#F3F4F6"
                                               Foreground="#374151"
                                               BorderThickness="0"
                                               FontSize="12"
                                               Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>

                                    <!-- Input Image Selection -->
                                    <TextBlock Text="Input Image"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                               Text="{Binding StoryGeneratorQ.InputImagePath, Mode=TwoWay}"
                                               IsReadOnly="True"
                                               Padding="10"
                                               Background="#F9FAFB"
                                               BorderBrush="#E5E7EB"
                                               VerticalContentAlignment="Center"
                                               FontSize="11"
                                               Height="38"/>
                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               Command="{Binding StoryGeneratorQ.SelectInputImageCommand}"
                                               Margin="8,0,0,0"
                                               Width="80"
                                               Height="38"
                                               Background="#F3F4F6"
                                               Foreground="#374151"
                                               BorderThickness="0"
                                               FontSize="12"
                                               Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>

                                    <!-- Load Prompts Button -->
                                    <Button Content="📥 Load Prompts from JSON"
                                           Command="{Binding StoryGeneratorQ.LoadPromptsCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="48"
                                           Background="#8B5CF6"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>

                                <!-- Right Column - Image Preview -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="🖼️ Image Preview"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,15"/>

                                    <Border BorderBrush="#E5E7EB"
                                           BorderThickness="2"
                                           Background="#F9FAFB"
                                           CornerRadius="12"
                                           Height="220">
                                        <Grid>
                                            <TextBlock Text="No image selected"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#9CA3AF"
                                                      FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StoryGeneratorQ.InputImagePreview}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding StoryGeneratorQ.InputImagePreview, Mode=OneWay}"
                                                  Stretch="Uniform"
                                                  Margin="4"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Queue Management Section -->
                        <Border Background="White"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="16"
                               Padding="24"
                               Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="📋 Queue Management"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,0,15"/>

                                <!-- Queue Controls -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                           Content="🚀 Generate Story"
                                           Command="{Binding StoryGeneratorQ.ProcessQueueCommand}"
                                           Height="44"
                                           Background="#8B5CF6"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           Style="{StaticResource PrimaryButtonStyle}"/>

                                    <Button Grid.Column="1"
                                           Content="📂 Output Folder"
                                           Command="{Binding StoryGeneratorQ.OpenOutputFolderCommand}"
                                           Height="44"
                                           Background="#F3F4F6"
                                           Foreground="#374151"
                                           BorderThickness="0"
                                           FontSize="13"
                                           Margin="0,0,8,0"
                                           Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button Grid.Column="2"
                                           Content="🗑️ Clear Queue"
                                           Command="{Binding StoryGeneratorQ.ClearQueueCommand}"
                                           Height="44"
                                           Background="#FEE2E2"
                                           Foreground="#DC2626"
                                           BorderThickness="0"
                                           FontSize="13">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FECACA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Queue Status -->
                                <Border Background="#F9FAFB"
                                       BorderBrush="#E5E7EB"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Padding="12"
                                       Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                  Text="Queue Status"
                                                  FontWeight="SemiBold"
                                                  FontSize="12"
                                                  Foreground="#374151"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.QueuedCount, StringFormat={}Queued: {0}}"
                                                  Margin="10,0"
                                                  FontSize="11"
                                                  Foreground="#6B7280"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                  Text="{Binding StoryGeneratorQ.CompletedCount, StringFormat={}Completed: {0}}"
                                                  Margin="10,0"
                                                  FontSize="11"
                                                  Foreground="#059669"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                  Text="{Binding StoryGeneratorQ.FailedCount, StringFormat={}Failed: {0}}"
                                                  Margin="10,0"
                                                  FontSize="11"
                                                  Foreground="#DC2626"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Queue Progress -->
                                <Border Background="#FEF3C7"
                                       BorderBrush="#F59E0B"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Padding="12"
                                       Margin="0,0,0,15"
                                       Visibility="{Binding StoryGeneratorQ.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StoryGeneratorQ.QueueProgressText, StringFormat={}Processing: {0}}"
                                                  FontWeight="SemiBold"
                                                  FontSize="11"
                                                  Foreground="#92400E"
                                                  Margin="0,0,0,6"/>
                                        <ProgressBar Value="{Binding StoryGeneratorQ.QueueProgress, Mode=OneWay}"
                                                  Maximum="{Binding StoryGeneratorQ.QueueTotal, Mode=OneWay}"
                                                  Height="6"
                                                  Foreground="#8B5CF6"
                                                  Background="#F3F4F6"
                                                  BorderThickness="0"/>
                                        <TextBlock Text="{Binding StoryGeneratorQ.CurrentQueueItem.Prompt, StringFormat={}Current: {0}}"
                                                  FontSize="10"
                                                  Foreground="#92400E"
                                                  TextTrimming="CharacterEllipsis"
                                                  Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Queue Items List -->
                                <Border Background="#F9FAFB"
                                       BorderBrush="#E5E7EB"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       MaxHeight="250">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding StoryGeneratorQ.QueueItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E5E7EB"
                                                           BorderThickness="0,0,0,1"
                                                           Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                      Text="{Binding Index, StringFormat='#{0}'}"
                                                                      FontWeight="Bold"
                                                                      FontSize="13"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,12,0"
                                                                      Foreground="#8B5CF6"/>

                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Prompt}"
                                                                          FontWeight="SemiBold"
                                                                          FontSize="12"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          MaxWidth="400"/>
                                                                <TextBlock Text="{Binding Status}"
                                                                          FontSize="10"
                                                                          Margin="0,4,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                    <Setter Property="Foreground" Value="#059669"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Foreground" Value="#8B5CF6"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2"
                                                                      Text="{Binding Progress, StringFormat={}{0:F0}%}"
                                                                      FontSize="11"
                                                                      FontWeight="SemiBold"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="#8B5CF6"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Log Output (Collapsible) -->
                        <Expander Margin="0,20,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="📋 Activity Log"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="#6B7280"/>
                            </Expander.Header>
                            <Border Background="#1F2937"
                                   BorderBrush="#374151"
                                   BorderThickness="1"
                                   CornerRadius="8"
                                   Margin="0,8,0,0">
                                <ScrollViewer MaxHeight="150"
                                             VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding StoryGeneratorQ.LogOutput}"
                                           TextWrapping="Wrap"
                                           IsReadOnly="True"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Background="Transparent"
                                           Foreground="#D1D5DB"
                                           BorderThickness="0"
                                           Padding="12"/>
                                </ScrollViewer>
                            </Border>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Amateur Generator -->
            <TabItem Header="📷 Amateur" FontWeight="Bold" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">

                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="✨ Amateur Photo Generator"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#10B981"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Saved Prompts Section -->
                        <Border Background="#FFF8DC" BorderBrush="#DEB887" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="📝 Saved Prompts" FontWeight="Bold" FontSize="13" Foreground="#8B4513" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Select a saved prompt or save current:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="💾 Save" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AmateurGenerator.SavePromptCommand}" Padding="10,5" Margin="5,0,5,0"
                                            ToolTip="Save current prompt settings"
                                            Background="#4CAF50"/>
                                    <Button Grid.Column="2" Content="🗑️ Delete" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AmateurGenerator.DeletePromptCommand}" Padding="10,5" Margin="0,0,0,0"
                                            ToolTip="Delete selected saved prompt"
                                            Background="#F44336"/>
                                </Grid>

                                <ComboBox ItemsSource="{Binding AmateurGenerator.SavedPrompts}"
                                          SelectedItem="{Binding AmateurGenerator.SelectedSavedPrompt, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          Padding="10"
                                          Background="White"
                                          BorderBrush="#CED4DA"
                                          FontSize="12"
                                          Margin="0,5,0,10"
                                          Height="40">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="10" Foreground="#666"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="💡 Tip: Your saved prompts appear here. Click Save to store the current prompt settings."
                                           FontSize="11" Foreground="#666" FontStyle="Italic" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Main Controls Panel -->
                        <Border Background="#F9FAFB"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Additional Prompt -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Additional Prompt"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="📋 Paste"
                                               Command="{Binding AmateurGenerator.PasteFromClipboardCommand}"
                                               Width="80"
                                               Height="28"
                                               HorizontalAlignment="Right"
                                               FontSize="11"
                                               Padding="5,0"
                                               Background="#6B7280"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Cursor="Hand"/>
                                    </Grid>
                                    <TextBox Text="{Binding AmateurGenerator.AdditionalPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="80"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Padding="12"
                                             FontSize="13"
                                             BorderBrush="#D1D5DB"
                                             Background="White"/>
                                    <TextBlock Text="The photographer prefix will be added automatically"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Orientation Selection -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Image Orientation"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AmateurGenerator.Orientations}"
                                              SelectedIndex="{Binding AmateurGenerator.OrientationIndex}"
                                              FontSize="13"
                                              Padding="10"
                                              Background="White"
                                              BorderBrush="#D1D5DB"/>
                                </StackPanel>

                                <!-- Style Selection -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,0">
                                    <TextBlock Text="Style"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AmateurGenerator.Styles}"
                                              SelectedIndex="{Binding AmateurGenerator.StyleIndex}"
                                              FontSize="13"
                                              Padding="10"
                                              Background="White"
                                              BorderBrush="#D1D5DB"/>
                                </StackPanel>

                                <!-- Advanced Settings Row -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="Advanced Settings"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#374151"
                                               Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Steps -->
                                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                            <TextBlock Text="Steps"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="#374151"
                                                       Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0"
                                                       Value="{Binding AmateurGenerator.Steps, Mode=TwoWay}"
                                                       Minimum="1" Maximum="20"
                                                       TickFrequency="1"
                                                       IsSnapToTickEnabled="True"/>
                                                <TextBlock Grid.Column="1"
                                                          Text="{Binding AmateurGenerator.Steps}"
                                                          Margin="8,0,0,0"
                                                          FontWeight="Bold"
                                                          FontSize="13"
                                                          Foreground="#10B981"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- CFG -->
                                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                            <TextBlock Text="CFG"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="#374151"
                                                       Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0"
                                                       Value="{Binding AmateurGenerator.Cfg, Mode=TwoWay}"
                                                       Minimum="0.5" Maximum="2.0"
                                                       TickFrequency="0.1"
                                                       IsSnapToTickEnabled="True"/>
                                                <TextBlock Grid.Column="1"
                                                          Text="{Binding AmateurGenerator.Cfg, StringFormat=F1}"
                                                          Margin="8,0,0,0"
                                                          FontWeight="Bold"
                                                          FontSize="13"
                                                          Foreground="#10B981"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Seed -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Seed (0 = Random)"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="#374151"
                                                       Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding AmateurGenerator.Seed, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30"
                                                     Padding="8"
                                                     FontSize="13"
                                                     BorderBrush="#D1D5DB"
                                                     Background="White"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Additional LoRA Section -->
                        <Border Background="#F9FAFB"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                         Content="Add Character LoRA"
                                         IsChecked="{Binding AmateurGenerator.LoraEnabled}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,15,0"
                                         FontSize="13"
                                         FontWeight="SemiBold"/>

                                <ComboBox Grid.Column="1"
                                         ItemsSource="{Binding AmateurGenerator.AvailableLoras}"
                                         SelectedItem="{Binding AmateurGenerator.SelectedLora}"
                                         IsEnabled="{Binding AmateurGenerator.LoraEnabled}"
                                         FontSize="13"
                                         Padding="10"
                                         Background="White"
                                         BorderBrush="#D1D5DB"/>

                                <Button Grid.Column="2"
                                       Content="Refresh"
                                       Command="{Binding AmateurGenerator.RefreshLorasCommand}"
                                       Width="80"
                                       Height="32"
                                       Margin="15,0,15,0"
                                       Background="#6B7280"
                                       Foreground="White"
                                       BorderThickness="0"
                                       FontSize="12"
                                       Cursor="Hand"/>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="LoRA Strength"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="#374151"
                                               Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding AmateurGenerator.LoraStrength, Mode=TwoWay}"
                                               Minimum="0.1" Maximum="1.5"
                                               TickFrequency="0.1"
                                               IsSnapToTickEnabled="True"
                                               IsEnabled="{Binding AmateurGenerator.LoraEnabled}"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding AmateurGenerator.LoraStrength, StringFormat=F1}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="12"
                                                  Foreground="#10B981"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Generate Button -->
                            <Button Grid.Column="0"
                                   Content="Generate Amateur Photo"
                                   Command="{Binding AmateurGenerator.GenerateImageCommand}"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Height="45"
                                   FontSize="15"/>

                            <!-- Cancel Button -->
                            <Button Grid.Column="1"
                                   Content="Cancel"
                                   Command="{Binding AmateurGenerator.CancelGenerationCommand}"
                                   Width="100"
                                   Height="45"
                                   Background="#EF4444"
                                   Foreground="White"
                                   BorderThickness="0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Cursor="Hand"
                                   Margin="15,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               CornerRadius="5"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#DC2626"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCC"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Progress Section -->
                        <Border Background="#F9FAFB"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20"
                               Visibility="{Binding AmateurGenerator.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Processing..."
                                              FontWeight="SemiBold"
                                              FontSize="13"
                                              Foreground="#374151"/>
                                    <TextBlock Text="{Binding AmateurGenerator.ProgressPercentage}"
                                              FontWeight="Bold"
                                              FontSize="13"
                                              Foreground="#10B981"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding AmateurGenerator.ProcessingProgress}"
                                           Maximum="100"
                                           Height="8"
                                           Margin="0,10,0,0"
                                           Background="#E5E7EB"
                                           Foreground="#10B981"/>
                                <TextBlock Text="{Binding AmateurGenerator.ProcessingStatus}"
                                          FontSize="12"
                                          Foreground="#6B7280"
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Result Section -->
                        <Border BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20"
                               Visibility="{Binding AmateurGenerator.HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <TextBlock Text="Generated Image"
                                              FontWeight="SemiBold"
                                              FontSize="14"
                                              Foreground="#374151"/>
                                    <Button Content="Open Folder"
                                           Command="{Binding AmateurGenerator.OpenResultFolderCommand}"
                                           Width="100"
                                           Height="32"
                                           Background="#6B7280"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           Cursor="Hand"/>
                                </Grid>

                                <Border Grid.Row="1"
                                       BorderBrush="#E5E7EB"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Background="White"
                                       HorizontalAlignment="Center">
                                    <Image Source="{Binding AmateurGenerator.ResultImageSource}"
                                          MaxWidth="600"
                                          MaxHeight="400"
                                          Margin="10"/>
                                </Border>

                                <TextBlock Grid.Row="1"
                                          Text="{Binding AmateurGenerator.ImageInfo}"
                                          FontSize="12"
                                          Foreground="#6B7280"
                                          Margin="0,15,0,0"
                                          HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Log Output -->
                        <Border Background="#1F2937"
                               BorderBrush="#374151"
                               BorderThickness="1"
                               CornerRadius="8"
                               Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                          Text="Log Output"
                                          FontWeight="SemiBold"
                                          FontSize="12"
                                          Foreground="#9CA3AF"
                                          Margin="0,0,0,10"/>

                                <TextBox Grid.Row="1"
                                         Text="{Binding AmateurGenerator.LogOutput}"
                                         IsReadOnly="True"
                                         Height="150"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#111827"
                                         Foreground="#9CA3AF"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Padding="10"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
