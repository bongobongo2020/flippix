<Window x:Class="FlipPix.UI.ImageGeneratorWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlipPix.UI.ViewModels"
        mc:Ignorable="d"
        Title="FlipPix - Image Generator" Height="950" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="650" MinWidth="850"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="AnalyzeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Radio Button Style for Input Mode -->
        <Style x:Key="ToggleRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DEE2E6"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentIndigoBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentIndigoBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Queue Flash Animation -->
        <Storyboard x:Key="QueueFlashAnimation">
            <ColorAnimation Storyboard.TargetName="AnalyzerQueueBorder"
                          Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                          From="#28A745" To="#DEE2E6" Duration="0:0:1"/>
        </Storyboard>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource BrandColor}"/>
            </Border.Background>
            <Grid Margin="25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title Section -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Image Generator"
                              FontSize="28" FontWeight="Bold"
                              Foreground="White"/>
                    <TextBlock Text="Generate images from text descriptions using AI"
                              FontSize="13" Foreground="#E6FFFFFF"
                              Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Settings Button -->
                <Button Grid.Column="1"
                        Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10"
                        Cursor="Hand"
                        ToolTip="Open Settings"
                        Margin="20,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="⚙️" FontSize="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Navigate:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="🎬 Video Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToVideoGeneratorCommand}"/>
                <Button Content="✨ Enhance Video" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToEnhanceVideoCommand}"/>
            </StackPanel>
        </Border>

        <!-- Group selector: 3 pills that switch which set of tabs is visible -->
        <Border Grid.Row="2" Background="{StaticResource AppBackgroundBrush}" Padding="15,10,15,2">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="🎨 Create" GroupName="NavGroup"
                             Style="{StaticResource GroupPillStyle}"
                             IsChecked="{Binding IsCreateGroup, Mode=OneWay}"
                             Command="{Binding SelectNavGroupCommand}" CommandParameter="0"/>
                <RadioButton Content="✏️ Edit" GroupName="NavGroup"
                             Style="{StaticResource GroupPillStyle}"
                             IsChecked="{Binding IsEditGroup, Mode=OneWay}"
                             Command="{Binding SelectNavGroupCommand}" CommandParameter="1"/>
                <RadioButton Content="🎛️ Advanced" GroupName="NavGroup"
                             Style="{StaticResource GroupPillStyle}"
                             IsChecked="{Binding IsAdvancedGroup, Mode=OneWay}"
                             Command="{Binding SelectNavGroupCommand}" CommandParameter="2"/>
            </StackPanel>
        </Border>

        <!-- Main Content with Tabbed Interface -->
        <TabControl Grid.Row="3" Margin="15,4,15,10" Background="Transparent"
                   SelectedIndex="{Binding SelectedTabIndex}">

            <!-- Tab 1: Image Generator (Merged Text Generation + Image Analysis) -->
            <TabItem Header="🎨 Image Generator" Visibility="{Binding IsCreateGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15,12,15,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="52*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN - Input & Settings -->
                        <StackPanel Grid.Column="0">

                            <!-- Section A: Input Mode Toggle -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Input Mode" Style="{StaticResource HeaderTextStyle}"/>

                                    <!-- Input Mode Toggle -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton Content="Text Prompt"
                                                   IsChecked="{Binding Analyzer.IsTextPromptMode, Mode=OneWay}"
                                                   GroupName="InputMode"
                                                   Style="{StaticResource ToggleRadioStyle}"
                                                   Margin="0,0,5,0"/>
                                        <RadioButton Content="Image Analysis"
                                                   IsChecked="{Binding Analyzer.IsImageAnalysisMode}"
                                                   GroupName="InputMode"
                                                   Style="{StaticResource ToggleRadioStyle}"
                                                   Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <!-- Text Prompt Section (visible only in Text Prompt mode) -->
                                    <StackPanel Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ImagePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap" AcceptsReturn="True" Height="120" Padding="10"
                                                VerticalScrollBarVisibility="Auto" FontSize="12"/>

                                        <!-- Validation hint -->
                                        <TextBlock Text="Enter a prompt to enable generation" FontSize="10"
                                                   Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" FontStyle="Italic">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanGenerate}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Saved prompts (tucked away) -->
                                        <Expander Header="📝 Saved prompts" IsExpanded="False" Margin="0,8,0,0">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding SavedPrompts}"
                                                          SelectedItem="{Binding SelectedSavedPrompt, Mode=TwoWay}"
                                                          SelectedValuePath="Id" FontSize="12" Height="40" Margin="0,0,6,0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="1" Content="💾 Save" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SavePromptCommand}" Padding="10,5" Margin="0,0,5,0" Height="40" ToolTip="Save current prompt"/>
                                                <Button Grid.Column="2" Content="🗑️" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeletePromptCommand}" Padding="12,5" Height="40" ToolTip="Delete selected prompt"/>
                                            </Grid>
                                        </Expander>

                                        <!-- Example prompts (tucked away) -->
                                        <Expander Header="💡 Example prompts" IsExpanded="False" Margin="0,4,0,0">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" TextWrapping="Wrap" Text="• Latina female with thick wavy hair, harbor boats and pastel houses behind."/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" TextWrapping="Wrap" Text="• A majestic mountain landscape at sunset with dramatic clouds and golden light"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,0" TextWrapping="Wrap" Text="• Portrait of a cyberpunk character with neon lights reflecting on metallic surfaces"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>

                                    <!-- Image Analysis Section (visible only in Image Analysis mode) -->
                                    <StackPanel Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Upload an image to analyze"
                                                   FontSize="11"
                                                   Foreground="#666"
                                                   Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                    Text="{Binding Analyzer.SourceImagePath, Mode=TwoWay}"
                                                    IsReadOnly="True"
                                                    Padding="8"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    VerticalContentAlignment="Center"
                                                    FontSize="11"
                                                    Height="30"/>

                                            <Button Grid.Column="1"
                                                   Content="Browse"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding Analyzer.BrowseImageCommand}"
                                                   Margin="6,0,0,0"
                                                   Height="30"
                                                   Padding="12,6"/>
                                        </Grid>

                                        <!-- Image Preview -->
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                                Background="White" Height="160"
                                                CornerRadius="5" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="No image selected"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999"
                                                          FontStyle="Italic"
                                                          FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Analyzer.HasSourceImage}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Image Source="{Binding Analyzer.SourceImageSource}"
                                                       Stretch="Uniform"
                                                       Margin="5"
                                                       Visibility="{Binding Analyzer.HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Analyze Button -->
                                        <Button Content="Analyze Image with QwenVL"
                                               Style="{StaticResource AnalyzeButtonStyle}"
                                               Command="{Binding Analyzer.AnalyzeImageCommand}"
                                               HorizontalAlignment="Stretch"
                                               Height="38"
                                               Margin="0,0,0,8"/>

                                        <!-- Processing Status for Analysis -->
                                        <Border Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="#FCD34D"
                                                BorderThickness="2"
                                                CornerRadius="6"
                                                Padding="12"
                                                Visibility="{Binding Analyzer.IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="Analyzing image..."
                                                          FontWeight="Bold"
                                                          FontSize="11"
                                                          Margin="0,0,0,6"
                                                          TextAlignment="Center"
                                                          Foreground="#92400E"/>
                                                <ProgressBar IsIndeterminate="True"
                                                            Height="18"
                                                            Foreground="{StaticResource AccentAmberBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding Analyzer.AnalysisText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="100"
                                                Padding="10"
                                                VerticalScrollBarVisibility="Auto"
                                                FontSize="12"/>

                                        <!-- Saved prompts (tucked away) -->
                                        <Expander Header="📝 Saved prompts" IsExpanded="False" Margin="0,8,0,0">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding Analyzer.SavedPrompts}"
                                                          SelectedItem="{Binding Analyzer.SelectedSavedPrompt, Mode=TwoWay}"
                                                          SelectedValuePath="Id" FontSize="12" Height="40" Margin="0,0,6,0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="1" Content="💾 Save" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Analyzer.SavePromptCommand}" Padding="10,5" Margin="0,0,5,0" Height="40" ToolTip="Save current prompt"/>
                                                <Button Grid.Column="2" Content="🗑️" Style="{StaticResource DangerButtonStyle}" Command="{Binding Analyzer.DeletePromptCommand}" Padding="12,5" Height="40" ToolTip="Delete selected prompt"/>
                                            </Grid>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                                                        <!-- Generation Settings (one shared panel for both input modes) -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <ContentControl Content="{Binding ActiveGenerationVM}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="Generation Settings" Style="{StaticResource HeaderTextStyle}"/>

                                                <!-- Workflow -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="Model Workflow" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox SelectedIndex="{Binding SelectedWorkflow, Mode=TwoWay}" FontSize="11" Height="32">
                                                        <ComboBoxItem Content="Zimage (with LoRA support)"/>
                                                        <ComboBoxItem Content="Qwen 2512"/>
                                                        <ComboBoxItem Content="Klien (Flux2)"/>
                                                        <ComboBoxItem Content="Anima"/>
                                                        <ComboBoxItem Content="Krea2 (Turbo)"/>
                                                        <ComboBoxItem Content="Zimage Base (no style)"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Style Preset (Zimage only) -->
                                                <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowStyleOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Style Preset" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox SelectedIndex="{Binding SelectedStyleIndex, Mode=TwoWay}" ItemsSource="{Binding StyleNames}" FontSize="11" Height="32"/>
                                                </StackPanel>

                                                <!-- LoRA (Zimage only) -->
                                                <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowLoraOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <CheckBox Content="Enable LoRA" IsChecked="{Binding LoraEnabled, Mode=TwoWay}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                                    <Grid Visibility="{Binding LoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableLoras}" SelectedItem="{Binding SelectedLora, Mode=TwoWay}" FontSize="11" Height="32" Margin="0,0,6,0"/>
                                                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshLorasCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="60" Height="32" Padding="10,5"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- LoRA (Krea2 only) — multiple LoRAs, each with its own strength -->
                                                <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowKreaLoraOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Krea2 LoRAs" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBlock Text="Trigger word is prepended to the prompt — edit it if the LoRA wants something else, clear it to prepend nothing."
                                                               FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                    <ItemsControl ItemsSource="{Binding SelectedKreaLoras}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox Grid.Column="0"
                                                                              ItemsSource="{Binding DataContext.KreaLoras, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              SelectedItem="{Binding LoraName, Mode=TwoWay}"
                                                                              FontSize="11" Height="32" Margin="0,0,6,0"/>
                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding TriggerWord, Mode=TwoWay}"
                                                                             ToolTip="Trigger word prepended to the prompt for this LoRA (remembered for next time)"
                                                                             FontSize="11" Width="110" Height="32" Margin="0,0,6,0"
                                                                             VerticalContentAlignment="Center"/>
                                                                    <TextBox Grid.Column="2"
                                                                             Text="{Binding Strength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                                                             ToolTip="LoRA strength"
                                                                             FontSize="11" Width="46" Height="32" Margin="0,0,6,0"
                                                                             VerticalContentAlignment="Center" TextAlignment="Center"/>
                                                                    <Button Grid.Column="3" Content="✕"
                                                                            Command="{Binding DataContext.RemoveKreaLoraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            ToolTip="Remove this LoRA"
                                                                            Width="32" Height="32" Padding="0"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="➕ Add LoRA" Command="{Binding AddKreaLoraCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="10,5" Margin="0,0,6,0"/>
                                                        <Button Content="Refresh" Command="{Binding RefreshKreaLorasCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="60" Height="30" Padding="10,5"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Aspect Ratio -->
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox SelectedIndex="{Binding AspectRatioIndex, Mode=TwoWay}" FontSize="11" Height="30">
                                                        <ComboBoxItem Content="Landscape"/>
                                                        <ComboBoxItem Content="Portrait"/>
                                                        <ComboBoxItem Content="Square"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Primary actions -->
                                                <Button Content="Generate Image" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PrimaryGenerateCommand}" HorizontalAlignment="Stretch" Height="44" FontSize="14" Margin="0,4,0,8"/>
                                                <Button Content="Add to Queue" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddToQueueCommand}" HorizontalAlignment="Stretch" Height="38" FontSize="13" Margin="0,0,0,4"/>

                                                <!-- Advanced -->
                                                <Expander Header="⚙️ Advanced Settings" IsExpanded="False" Visibility="{Binding ShowSamplerSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Margin="0,10,0,0">
                                                        <StackPanel Margin="0,0,0,10">
                                                            <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Slider Grid.Column="0" Value="{Binding Steps, Mode=TwoWay}" Minimum="4" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Height="20"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Steps}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="25" FontWeight="Bold" FontSize="11"/>
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,0,10">
                                                            <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Slider Grid.Column="0" Value="{Binding Cfg, Mode=TwoWay}" Minimum="1" Maximum="3" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Height="20"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Cfg, StringFormat={}{0:F1}}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="25" FontWeight="Bold" FontSize="11"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>

                            <!-- LM Studio Connection (Image Analysis mode only) -->
                            <Expander Header="🔌 LM Studio Connection"
                                     Margin="0,0,0,10"
                                     IsExpanded="False"
                                     Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="LM Studio Settings" Style="{StaticResource HeaderTextStyle}"/>

                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Saved Servers" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Analyzer.ServerProfiles}"
                                                      DisplayMemberPath="ListLabel"
                                                      SelectedItem="{Binding Analyzer.SelectedServerProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Padding="8"
                                                      Background="White"
                                                      BorderBrush="{StaticResource BorderBrush}"
                                                      FontSize="11"
                                                      Height="30"
                                                      ToolTip="Pick a saved computer (named in Settings) to switch the Server/Port below"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Server" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Analyzer.LMStudioServer, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="8"
                                                         Background="White"
                                                         BorderBrush="{StaticResource BorderBrush}"
                                                         FontSize="11"
                                                         Height="30"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Port" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Analyzer.LMStudioPort, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="8"
                                                         Background="White"
                                                         BorderBrush="{StaticResource BorderBrush}"
                                                         FontSize="11"
                                                         Height="30"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="" Height="15" Margin="0,0,0,4"/>
                                                <Button Content="Test"
                                                       Command="{Binding Analyzer.TestLMStudioConnectionCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="50"
                                                       Height="30"
                                                       Padding="10,5"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="AI Model" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding Analyzer.AvailableModels}"
                                                          SelectedValue="{Binding Analyzer.SelectedModel}"
                                                          SelectedValuePath="Name"
                                                          Padding="8"
                                                          Background="White"
                                                          BorderBrush="{StaticResource BorderBrush}"
                                                          FontSize="11"
                                                          Height="30">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="" Height="15" Margin="0,0,0,4"/>
                                                <Button Content="Refresh"
                                                       Command="{Binding Analyzer.RefreshModelsCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="65"
                                                       Height="30"
                                                       Padding="10,5"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </StackPanel>

                        <!-- RIGHT COLUMN - Queue & Results -->
                        <StackPanel Grid.Column="2">

                            <!-- Queue Status Bar - Text Prompt Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Status" Style="{StaticResource HeaderTextStyle}"/>

                                    <!-- Start Queue Button (visible when not processing) -->
                                    <Button Content="▶ Start Queue"
                                           Command="{Binding ProcessQueueCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="36"
                                           FontSize="12"
                                           Margin="0,0,0,8"
                                           ToolTip="Start processing queued items">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProcessingQueue}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Processing Progress -->
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12"
                                            Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <!-- Waiting for lease status -->
                                            <TextBlock Text="⏳ Waiting for other workflows to finish..."
                                                      FontWeight="SemiBold"
                                                      FontSize="11"
                                                      Margin="0,0,0,5"
                                                      TextAlignment="Center"
                                                      Foreground="{StaticResource AccentAmberBrush}"
                                                      Visibility="{Binding IsWaitingForLease, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Processing status -->
                                            <TextBlock Text="Processing queue..."
                                                      FontWeight="SemiBold"
                                                      FontSize="11"
                                                      Margin="0,0,0,5"
                                                      TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWaitingForLease}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Pause/Resume/Cancel Buttons -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                       Content="⏸ Pause"
                                                       Command="{Binding PauseQueueCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Margin="0,0,5,0"/>

                                                <Button Grid.Column="1"
                                                       Content="▶ Resume"
                                                       Command="{Binding ResumeQueueCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Margin="5,0"/>

                                                <Button Grid.Column="2"
                                                       Content="✖ Cancel"
                                                       Command="{Binding CancelQueueCommand}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Background="{StaticResource DangerBrush}"
                                                       Foreground="White"
                                                       BorderThickness="0"
                                                       Margin="5,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#DC3545"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="8,4"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="5"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#E55563"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Queue Status Bar - Image Analysis Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Status" Style="{StaticResource HeaderTextStyle}"/>

                                    <!-- Start Queue Button -->
                                    <Button Content="▶ Start Queue"
                                           Command="{Binding Analyzer.ProcessQueueCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="36"
                                           FontSize="12"
                                           Margin="0,0,0,8"
                                           ToolTip="Start processing queued items">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Analyzer.IsProcessingQueue}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="Queue:"
                                                      FontWeight="SemiBold"
                                                      VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding Analyzer.QueuedCount, StringFormat={}Queued: {0}}"
                                                      Margin="10,0"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"/>

                                            <TextBlock Grid.Column="2"
                                                      Text="{Binding Analyzer.CompletedCount, StringFormat={}Completed: {0}}"
                                                      Margin="10,0"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"
                                                      Foreground="{StaticResource SuccessBrush}"/>

                                            <TextBlock Grid.Column="3"
                                                      Text="{Binding Analyzer.FailedCount, StringFormat={}Failed: {0}}"
                                                      Margin="10,0"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"
                                                      Foreground="{StaticResource DangerBrush}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Processing Progress -->
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding Analyzer.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <!-- Waiting for lease status -->
                                            <TextBlock Text="⏳ Waiting for other workflows to finish..."
                                                      FontWeight="SemiBold"
                                                      FontSize="11"
                                                      Margin="0,0,0,5"
                                                      TextAlignment="Center"
                                                      Foreground="{StaticResource AccentAmberBrush}"
                                                      Visibility="{Binding Analyzer.IsWaitingForLease, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Processing status -->
                                            <TextBlock Text="{Binding Analyzer.QueueProgressText, StringFormat={}Processing: {0}}"
                                                      FontWeight="SemiBold"
                                                      FontSize="11"
                                                      Margin="0,0,0,5"
                                                      TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Analyzer.IsWaitingForLease}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ProgressBar Value="{Binding Analyzer.QueueProgress, Mode=OneWay}"
                                                        Maximum="{Binding Analyzer.QueueTotal, Mode=OneWay}"
                                                        Height="16"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        Margin="0,0,0,5">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Analyzer.IsWaitingForLease}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>

                                            <!-- Pause/Resume/Cancel Buttons -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                       Content="⏸ Pause"
                                                       Command="{Binding Analyzer.PauseQueueCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Margin="0,0,5,0"/>

                                                <Button Grid.Column="1"
                                                       Content="▶ Resume"
                                                       Command="{Binding Analyzer.ResumeQueueCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Margin="5,0"/>

                                                <Button Grid.Column="2"
                                                       Content="✖ Cancel"
                                                       Command="{Binding Analyzer.CancelProcessingCommand}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Background="{StaticResource DangerBrush}"
                                                       Foreground="White"
                                                       BorderThickness="0"
                                                       Margin="5,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#DC3545"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="8,4"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="5"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#E55563"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>

                                            <!-- Retry Failed Button -->
                                            <Button Content="🔄 Retry Failed"
                                                   Command="{Binding Analyzer.ReprocessAllFailedCommand}"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Margin="0,8,0,0"
                                                   Height="28"
                                                   FontSize="11"
                                                   Background="{StaticResource AccentAmberBrush}"
                                                   Padding="12,4"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Queue Items List - Text Prompt Mode -->
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Background="White"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Items" Style="{StaticResource HeaderTextStyle}" Padding="15,15,15,0"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250" Padding="15">
                                        <ItemsControl ItemsSource="{Binding PromptQueue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E9ECEF"
                                                           BorderThickness="0,0,0,1"
                                                           Padding="12"
                                                           Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Workflow Badge -->
                                                            <Border Grid.Column="0"
                                                                    Background="{Binding WorkflowBadgeColor}"
                                                                    CornerRadius="4"
                                                                    Padding="6,4"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding WorkflowBadge}"
                                                                          FontWeight="Bold"
                                                                          FontSize="10"
                                                                          Foreground="White"/>
                                                            </Border>

                                                            <!-- Item Info -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DisplayPrompt}"
                                                                          FontWeight="SemiBold"
                                                                          FontSize="12"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          MaxWidth="300"/>

                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding StyleName}"
                                                                              FontSize="10"
                                                                              Foreground="#666"
                                                                              Visibility="{Binding StyleNameVisibility}"/>

                                                                    <TextBlock Text="{Binding AspectRatioDisplay}"
                                                                              FontSize="10"
                                                                              Foreground="#666"
                                                                              Margin="5,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Status / Thumbnail -->
                                                            <StackPanel Grid.Column="2"
                                                                       Orientation="Horizontal"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0">
                                                                <!-- Show status text when NOT completed -->
                                                                <TextBlock Text="{Binding StatusDisplay}"
                                                                          FontSize="11"
                                                                          FontWeight="Bold"
                                                                          Foreground="{Binding StatusColor}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <!-- Progress bar during processing -->
                                                                <ProgressBar Value="{Binding Progress}"
                                                                           Width="50"
                                                                           Height="12"
                                                                           Margin="5,0">
                                                                    <ProgressBar.Style>
                                                                        <Style TargetType="ProgressBar">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ProgressBar.Style>
                                                                </ProgressBar>

                                                                <!-- Clickable thumbnail when completed -->
                                                                <Button Command="{Binding DataContext.SelectQueueResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}"
                                                                       Background="Transparent"
                                                                       BorderThickness="0"
                                                                       Cursor="Hand"
                                                                       ToolTip="Click to open the full-size image (also loads it into Latest Result)"
                                                                       Padding="0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Image Source="{Binding ThumbnailImage}"
                                                                          Height="50"
                                                                          Stretch="Uniform"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- Retry / Remove Buttons -->
                                                            <StackPanel Grid.Column="3"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Button Content="🔄"
                                                                       Command="{Binding DataContext.RetryQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}"
                                                                       Background="Transparent"
                                                                       BorderThickness="0"
                                                                       Padding="5"
                                                                       ToolTip="Retry failed item"
                                                                       FontSize="12"
                                                                       Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="❌"
                                                                       Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}"
                                                                       Background="Transparent"
                                                                       BorderThickness="0"
                                                                       Padding="5"
                                                                       ToolTip="Remove from queue"
                                                                       FontSize="12"
                                                                       Cursor="Hand"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Queue Items List - Image Analysis Mode -->
                            <Border x:Name="AnalyzerQueueBorder"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Background="White"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Items" Style="{StaticResource HeaderTextStyle}" Padding="15,15,15,0"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250" Padding="15">
                                        <ItemsControl ItemsSource="{Binding Analyzer.QueueItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E9ECEF"
                                                           BorderThickness="0,0,0,1"
                                                           Padding="12"
                                                           Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Workflow Badge -->
                                                            <Border Grid.Column="0"
                                                                    Background="{Binding WorkflowBadgeColor}"
                                                                    CornerRadius="4"
                                                                    Padding="6,4"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding WorkflowBadge}"
                                                                          FontWeight="Bold"
                                                                          FontSize="10"
                                                                          Foreground="White"/>
                                                            </Border>

                                                            <!-- Item Info -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DisplayPrompt}"
                                                                          FontWeight="SemiBold"
                                                                          FontSize="12"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          MaxWidth="300"/>

                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding StyleName}"
                                                                              FontSize="10"
                                                                              Foreground="#666"
                                                                              Visibility="{Binding StyleNameVisibility}"/>

                                                                    <TextBlock Text="{Binding AspectRatioDisplay}"
                                                                              FontSize="10"
                                                                              Foreground="#666"
                                                                              Margin="5,0,0,0"/>
                                                                </StackPanel>

                                                                <!-- Output Image Thumbnail -->
                                                                <Button Command="{Binding DataContext.Analyzer.SelectQueueResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Padding="0"
                                                                        Margin="0,8,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        ToolTip="Click to open the full-size image (also loads it into Latest Result)">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasOutputImage}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Image Source="{Binding OutputImageThumbnail}"
                                                                           Stretch="Uniform"
                                                                           Height="50"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- Status -->
                                                            <StackPanel Grid.Column="2"
                                                                       Orientation="Horizontal"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0">
                                                                <TextBlock Text="{Binding StatusDisplay}"
                                                                          FontSize="11"
                                                                          FontWeight="Bold"
                                                                          Foreground="{Binding StatusColor}"/>

                                                                <ProgressBar Value="{Binding Progress}"
                                                                           Width="50"
                                                                           Height="12"
                                                                           Margin="5,0">
                                                                    <ProgressBar.Style>
                                                                        <Style TargetType="ProgressBar">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ProgressBar.Style>
                                                                </ProgressBar>
                                                            </StackPanel>

                                                            <!-- Remove Button -->
                                                            <Button Grid.Column="3"
                                                                   Content="❌"
                                                                   Command="{Binding DataContext.Analyzer.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"
                                                                   Background="Transparent"
                                                                   BorderThickness="0"
                                                                   Padding="5"
                                                                   ToolTip="Remove from queue"
                                                                   FontSize="12"
                                                                   Cursor="Hand">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Queue Control Buttons - Text Prompt Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Controls" Style="{StaticResource HeaderTextStyle}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                               Content="Clear Queue"
                                               Command="{Binding ClearQueueCommand}"
                                               Margin="0,0,5,0"
                                               Height="38">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E55563"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="1"
                                               Content="Open Folder"
                                               Command="{Binding OpenResultFolderCommand}"
                                               IsEnabled="{Binding HasResultImage}"
                                               Margin="5,0,0,0"
                                               Height="38"
                                               Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Queue Control Buttons - Image Analysis Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Controls" Style="{StaticResource HeaderTextStyle}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                               Content="Clear Queue"
                                               Command="{Binding Analyzer.ClearQueueCommand}"
                                               Margin="0,0,5,0"
                                               Height="38">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E55563"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="1"
                                               Content="Open Folder"
                                               Command="{Binding Analyzer.OpenResultFolderCommand}"
                                               IsEnabled="{Binding Analyzer.HasResultImage}"
                                               Margin="5,0,0,0"
                                               Height="38"
                                               Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Result Preview - Text Prompt Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Latest Result" Style="{StaticResource HeaderTextStyle}"/>

                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                            Background="White" Height="200"
                                            CornerRadius="5" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Result will appear here"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#999"
                                                      FontStyle="Italic"
                                                      FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasResultImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Command="{Binding OpenResultImageCommand}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Click to open in image viewer" Padding="0">
                                                <Image Source="{Binding ResultImageSource}"
                                                       Stretch="Uniform" Margin="5"
                                                       Visibility="{Binding HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                               Content="🎥 Camera Angle"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding SendToCameraAngleCommand}"
                                               IsEnabled="{Binding HasResultImage}"
                                               Margin="0,0,4,0"/>

                                        <Button Grid.Column="1"
                                               Content="🎬 Video Generator"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding SendToVideoGeneratorCommand}"
                                               IsEnabled="{Binding HasResultImage}"
                                               Margin="4,0,4,0"/>

                                        <Button Grid.Column="2"
                                               Content="📖 Story"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding SendToStoryCommand}"
                                               IsEnabled="{Binding HasResultImage}"
                                               Margin="4,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="{Binding ImageInfo}"
                                              FontStyle="Italic"
                                              Foreground="#666"
                                              FontSize="10"
                                              Margin="0,8,0,0"
                                              TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Result Preview - Image Analysis Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Latest Result" Style="{StaticResource HeaderTextStyle}"/>

                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                            Background="White" Height="200"
                                            CornerRadius="5" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Result will appear here"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#999"
                                                      FontStyle="Italic"
                                                      FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Analyzer.HasResultImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Command="{Binding Analyzer.OpenResultImageCommand}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Click to open in image viewer" Padding="0">
                                                <Image Source="{Binding Analyzer.ResultImageSource}"
                                                       Stretch="Uniform" Margin="5"
                                                       Visibility="{Binding Analyzer.HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                               Content="🎥 Camera Angle"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding SendToCameraAngleCommand}"
                                               IsEnabled="{Binding Analyzer.HasResultImage}"
                                               Margin="0,0,4,0"/>

                                        <Button Grid.Column="1"
                                               Content="🎬 Video Generator"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding SendToVideoGeneratorCommand}"
                                               IsEnabled="{Binding Analyzer.HasResultImage}"
                                               Margin="4,0,4,0"/>

                                        <Button Grid.Column="2"
                                               Content="📖 Story"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding SendToStoryCommand}"
                                               IsEnabled="{Binding Analyzer.HasResultImage}"
                                               Margin="4,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Analyzer.ImageInfo}"
                                              FontStyle="Italic"
                                              Foreground="#666"
                                              FontSize="10"
                                              Margin="0,8,0,0"
                                              TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- Tab 3.5: Story Image Generator Q (Qwen Rapid Edit) -->
            <TabItem Header="📖 Story Image Q" Visibility="{Binding IsCreateGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">

                        <!-- Header with Workflow Selector and Settings Toggle -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="✨ Story Image Generator Q"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentVioletBrush}"
                                       VerticalAlignment="Center"/>

                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- Workflow selector -->
                                <TextBlock Text="Workflow:"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{x:Static local:StoryImageGeneratorQViewModel.WorkflowModes}"
                                          SelectedItem="{Binding StoryGeneratorQ.SelectedWorkflowMode, Mode=TwoWay}"
                                          Width="120"
                                          Height="32"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          FontSize="12"/>
                                <!-- Settings gear -->
                                <Button Command="{Binding StoryGeneratorQ.ToggleSettingsVisibilityCommand}"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderThickness="0">
                                    <Button.Content>
                                        <TextBlock Text="⚙️" FontSize="20" />
                                    </Button.Content>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                               CornerRadius="8"
                                                               Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Settings Panel (Collapsible) -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                               BorderBrush="{StaticResource BorderBrush}"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.SettingsVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Steps -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,15,0">
                                    <TextBlock Text="Steps"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding StoryGeneratorQ.Steps, Mode=TwoWay}"
                                               Minimum="1" Maximum="20"
                                               TickFrequency="1"
                                               IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.Steps}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- CFG -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,15,0">
                                    <TextBlock Text="CFG"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding StoryGeneratorQ.Cfg, Mode=TwoWay}"
                                               Minimum="1" Maximum="10"
                                               TickFrequency="0.5"
                                               IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.Cfg, StringFormat={}{0:F1}}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Denoise -->
                                <StackPanel Grid.Column="2" Grid.Row="0">
                                    <TextBlock Text="Denoise"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding StoryGeneratorQ.Denoise, Mode=TwoWay}"
                                               Minimum="0" Maximum="1"
                                               TickFrequency="0.05"
                                               IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.Denoise, StringFormat={}{0:F2}}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Negative Prompt -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="0,15,0,0">
                                    <TextBlock Text="Negative Prompt"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           TextWrapping="Wrap"
                                           AcceptsReturn="True"
                                           Height="60"
                                           Padding="12"
                                           VerticalScrollBarVisibility="Auto"
                                           Background="White"
                                           BorderBrush="{StaticResource BorderStrongBrush}"
                                           FontSize="12">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>

                                <!-- LoRA Toggle (FireRed only) -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Margin="0,12,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StoryGeneratorQ.ShowLoRAOption}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <CheckBox Content="Use LoRA"
                                              IsChecked="{Binding StoryGeneratorQ.UseLoRA, Mode=TwoWay}"
                                              FontSize="12"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Krea2 Orientation Panel -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="#C4B5FD"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.ShowKrea2Orientation}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="&#x1F4D0; Krea2 Orientation"
                                           FontWeight="SemiBold" FontSize="13" Foreground="#6D28D9" Margin="0,0,0,2"/>
                                <TextBlock Text="Canvas every image in the story is rendered at. All sizes sit near 1 MP so the Turbo pass stays fast."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{x:Static local:StoryImageGeneratorQViewModel.Krea2Orientations}"
                                          SelectedItem="{Binding StoryGeneratorQ.Krea2SelectedOrientation, Mode=TwoWay}"
                                          Height="32"
                                          Padding="8,0"
                                          FontSize="12"
                                          HorizontalAlignment="Left"
                                          MinWidth="220"
                                          Background="White"
                                          BorderBrush="#C4B5FD"/>
                            </StackPanel>
                        </Border>

                        <!-- Krea2 LoRA Panel -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="#C4B5FD"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.ShowKreaLoraOption}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="🔧 Krea2 LoRAs" FontWeight="SemiBold" FontSize="13" Foreground="#6D28D9" Margin="0,0,0,2"/>
                                <TextBlock Text="Trigger word is prepended to every prompt in the story — edit it if the LoRA wants something else, clear it to prepend nothing."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding StoryGeneratorQ.SelectedKreaLoras}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding DataContext.StoryGeneratorQ.KreaLoras, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding LoraName, Mode=TwoWay}"
                                                          FontSize="12" Height="32" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding TriggerWord, Mode=TwoWay}"
                                                         ToolTip="Trigger word prepended to the prompt for this LoRA (remembered for next time)"
                                                         FontSize="12" Width="110" Height="32" Margin="0,0,6,0"
                                                         VerticalContentAlignment="Center"/>
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Strength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                                         ToolTip="LoRA strength"
                                                         FontSize="12" Width="46" Height="32" Margin="0,0,6,0"
                                                         VerticalContentAlignment="Center" TextAlignment="Center"/>
                                                <Button Grid.Column="3" Content="✕"
                                                        Command="{Binding DataContext.StoryGeneratorQ.RemoveKreaLoraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        ToolTip="Remove this LoRA"
                                                        Width="32" Height="32" Padding="0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="➕ Add LoRA" Command="{Binding StoryGeneratorQ.AddKreaLoraCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="10,5" Margin="0,0,6,0"/>
                                    <Button Content="Refresh" Command="{Binding StoryGeneratorQ.RefreshKreaLorasCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="60" Height="30" Padding="10,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Krea2 Edit Panel (reference image B) -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="#C4B5FD"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.ShowKrea2EditOption}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="🧑 Krea2 Edit — Reference Image (image B)"
                                           FontWeight="SemiBold" FontSize="13" Foreground="#6D28D9" Margin="0,0,0,4"/>
                                <TextBlock Text="The story queue's input image is image A (the scene edited each prompt). This reference is the subject swapped in — it stays the same for every image in the run."
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding StoryGeneratorQ.Krea2EditRefImagePath, Mode=TwoWay}"
                                             IsReadOnly="True"
                                             Padding="10"
                                             Background="White"
                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             Height="38"/>
                                    <Button Grid.Column="1"
                                            Content="Browse"
                                            Command="{Binding StoryGeneratorQ.SelectKrea2EditRefImageCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0" Width="80" Height="38" FontSize="12"/>
                                    <Border Grid.Column="2"
                                            Width="52" Height="52"
                                            Margin="8,0,0,0"
                                            Background="White"
                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Image Source="{Binding StoryGeneratorQ.Krea2EditRefImagePreview, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               Margin="2"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- StoryImageZ Options Panel (Style + LoRA) -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.ShowZOptions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Style selector -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🎨 ZStyle"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#166534"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding StoryGeneratorQ.ZStyleNames}"
                                              SelectedIndex="{Binding StoryGeneratorQ.ZSelectedStyleIndex, Mode=TwoWay}"
                                              Height="32"
                                              Padding="8,0"
                                              FontSize="12"
                                              Background="White"
                                              BorderBrush="#86EFAC"/>
                                    <TextBlock Text="Workflow from ZStyles folder"
                                               FontSize="10"
                                               Foreground="#4D7C5F"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- LoRA settings -->
                                <StackPanel Grid.Column="2" Grid.ColumnSpan="1">
                                    <TextBlock Text="🔧 LoRA"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#166534"
                                               Margin="0,0,0,8"/>
                                    <CheckBox Content="Enable LoRA"
                                              IsChecked="{Binding StoryGeneratorQ.ZLoraEnabled, Mode=TwoWay}"
                                              FontSize="12"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              Margin="0,0,0,8"/>
                                    <Grid Visibility="{Binding StoryGeneratorQ.ZLoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding StoryGeneratorQ.ZAvailableLoras}"
                                                  SelectedItem="{Binding StoryGeneratorQ.ZSelectedLora, Mode=TwoWay}"
                                                  Height="32"
                                                  Padding="8,0"
                                                  FontSize="11"
                                                  Background="White"
                                                  BorderBrush="#86EFAC"
                                                  Margin="0,0,6,0"/>
                                        <Button Grid.Column="1"
                                                Content="↻"
                                                Command="{Binding StoryGeneratorQ.RefreshZLorasCommand}"
                                                Width="32" Height="32"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Background="{StaticResource SuccessBrush}"
                                                Foreground="White"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#15803D"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <StackPanel Visibility="{Binding StoryGeneratorQ.ZLoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,8,0,0">
                                        <TextBlock Text="Strength"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding StoryGeneratorQ.ZLoraStrengthModel, Mode=TwoWay}"
                                                    Minimum="0" Maximum="2"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StoryGeneratorQ.ZLoraStrengthModel, StringFormat={}{0:F2}}"
                                                       Margin="8,0,0,0"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SuccessTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Orientation selector -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="📐 Orientation"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#166534"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{x:Static local:StoryImageGeneratorQViewModel.ZOrientations}"
                                              SelectedItem="{Binding StoryGeneratorQ.ZSelectedOrientation, Mode=TwoWay}"
                                              Height="32"
                                              Padding="8,0"
                                              FontSize="12"
                                              Background="White"
                                              BorderBrush="#86EFAC"/>
                                    <TextBlock Text="Portrait · Landscape · Square"
                                               FontSize="10"
                                               Foreground="#4D7C5F"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Content Area -->
                        <Border Background="White"
                               BorderBrush="{StaticResource BorderBrush}"
                               BorderThickness="1"
                               CornerRadius="16"
                               Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column - File Selection -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📝 Story Prompts"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,15"/>

                                    <!-- Input Image Selection (moved up) -->
                                    <TextBlock Text="Input Image"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                               Text="{Binding StoryGeneratorQ.InputImagePath, Mode=TwoWay}"
                                               IsReadOnly="True"
                                               Padding="10"
                                               Background="{StaticResource SurfaceAltBrush}"
                                               BorderBrush="{StaticResource BorderBrush}"
                                               VerticalContentAlignment="Center"
                                               FontSize="11"
                                               Height="38"/>
                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               Command="{Binding StoryGeneratorQ.SelectInputImageCommand}"
                                               Margin="8,0,0,0"
                                               Width="80"
                                               Height="38"
                                               Background="{StaticResource SurfaceAltBrush}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               BorderThickness="0"
                                               FontSize="12"
                                               Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>

                                    <!-- Character Name Input -->
                                    <TextBlock Text="Character Name (optional)"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.CharacterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="10"
                                             Background="{StaticResource SurfaceAltBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             Height="38"
                                             Margin="0,0,0,10"
                                             ToolTip="e.g. Tara — replaces generic character references (like 'a woman') with this name in every scene"/>

                                    <!-- Character Clothing Input -->
                                    <TextBlock Text="Character Clothing (optional)"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.CharacterClothing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="10"
                                             Background="{StaticResource SurfaceAltBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             Height="38"
                                             Margin="0,0,0,10"
                                             ToolTip="e.g. a red leather jacket and blue jeans — keeps the character in this same outfit across every scene"/>

                                    <!-- Story Concept Input -->
                                    <TextBlock Text="Story Concept (optional)"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.StoryConcept, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="10"
                                             Background="{StaticResource SurfaceAltBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             Height="38"
                                             Margin="0,0,0,10"
                                             ToolTip="e.g. revenge thriller, romantic journey, sci-fi survival"/>

                                    <!-- Story Prompt Template Selector -->
                                    <TextBlock Text="Prompt Style"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding StoryGeneratorQ.StoryPromptTemplates}"
                                              SelectedItem="{Binding StoryGeneratorQ.SelectedStoryPromptTemplate, Mode=TwoWay}"
                                              Height="38"
                                              FontSize="11"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,0,10"
                                              ToolTip="System prompt sent to Qwen VL. FFLF Continuous Shot generates 10 keyframes (5s apart) for one continuous video shot."/>

                                    <!-- Analyze Image with Qwen VL Button (NEW) -->
                                    <Button Content="🔍 Analyze Image with Qwen VL"
                                           Command="{Binding StoryGeneratorQ.AnalyzeImageWithQwenVLCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="44"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="8"
                                                                   Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#CBD5E1"/>
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Analysis Progress (shown when analyzing) -->
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="#FCD34D"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            Visibility="{Binding StoryGeneratorQ.IsAnalyzingImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding StoryGeneratorQ.AnalysisStatus}"
                                                      FontWeight="Bold"
                                                      FontSize="11"
                                                      Margin="0,0,0,6"
                                                      TextAlignment="Center"
                                                      Foreground="#92400E"/>
                                            <ProgressBar IsIndeterminate="True"
                                                        Height="18"
                                                        Foreground="{StaticResource AccentAmberBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Send generated keyframes to MiniMax FFLF (continuous shot) -->
                                    <Button Content="🎯 Open in MiniMax FFLF"
                                           Command="{Binding OpenKeyframesInMiniMaxFflfCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="40"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"
                                           ToolTip="Opens the Video Generator's MiniMax FFLF tab with this session's keyframes loaded as the chain: the first still is the opening frame and each one after it is a keyframe a clip has to arrive at.&#x0a;&#x0a;A chain holds five keyframes at most, so a ten-keyframe run is walked as a series of takes — each one opening on the keyframe the last ended with, so they join.">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource AccentVioletBrush}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="8"
                                                                   Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#6D28D9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Prompt JSON File (moved below analyze button) -->
                                    <TextBlock Text="Prompts JSON File"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                               Text="{Binding StoryGeneratorQ.PromptJsonFilePath, Mode=TwoWay}"
                                               IsReadOnly="True"
                                               Padding="10"
                                               Background="{StaticResource SurfaceAltBrush}"
                                               BorderBrush="{StaticResource BorderBrush}"
                                               VerticalContentAlignment="Center"
                                               FontSize="11"
                                               Height="38"/>
                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               Command="{Binding StoryGeneratorQ.SelectPromptJsonCommand}"
                                               Margin="8,0,0,0"
                                               Width="80"
                                               Height="38"
                                               Background="{StaticResource SurfaceAltBrush}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               BorderThickness="0"
                                               FontSize="12"
                                               Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>

                                    <!-- Add Prompts from JSON Button -->
                                    <Button Content="📥 Add Prompts from JSON"
                                           Command="{Binding StoryGeneratorQ.LoadPromptsCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="48"
                                           Background="{StaticResource BrandBrush}"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>

                                <!-- Right Column - Image Preview -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="🖼️ Image Preview"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,15"/>

                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                           BorderThickness="2"
                                           Background="{StaticResource SurfaceAltBrush}"
                                           CornerRadius="12"
                                           Height="220">
                                        <Grid>
                                            <TextBlock Text="No image selected"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{StaticResource TextMutedBrush}"
                                                      FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StoryGeneratorQ.InputImagePreview}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding StoryGeneratorQ.InputImagePreview, Mode=OneWay}"
                                                  Stretch="Uniform"
                                                  Margin="4"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Queue Management Section -->
                        <Border Background="White"
                               BorderBrush="{StaticResource BorderBrush}"
                               BorderThickness="1"
                               CornerRadius="16"
                               Padding="24"
                               Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="📋 Queue Management"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,15"/>

                                <!-- Queue Controls -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                           Content="🚀 Generate Story"
                                           Command="{Binding StoryGeneratorQ.ProcessQueueCommand}"
                                           Height="44"
                                           Background="{StaticResource BrandBrush}"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           Style="{StaticResource PrimaryButtonStyle}"/>

                                    <Button Grid.Column="1"
                                           Content="📂 Output Folder"
                                           Command="{Binding StoryGeneratorQ.OpenOutputFolderCommand}"
                                           Height="44"
                                           Background="{StaticResource SurfaceAltBrush}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           BorderThickness="0"
                                           FontSize="13"
                                           Margin="0,0,8,0"
                                           Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button Grid.Column="2"
                                           Content="🗑️ Clear Queue"
                                           Command="{Binding StoryGeneratorQ.ClearQueueCommand}"
                                           Height="44"
                                           Background="{StaticResource SurfaceAltBrush}"
                                           Foreground="{StaticResource DangerBrush}"
                                           BorderThickness="0"
                                           FontSize="13">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FECACA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Pause/Resume Controls (Q) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                            Visibility="{Binding StoryGeneratorQ.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button Content="⏸ Pause" Width="100" Height="32" Margin="0,0,8,0"
                                            Command="{Binding StoryGeneratorQ.PauseQueueCommand}"
                                            Background="{StaticResource AccentAmberBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                                    <Button Content="▶ Resume" Width="100" Height="32" Margin="0,0,8,0"
                                            Command="{Binding StoryGeneratorQ.ResumeQueueCommand}"
                                            Background="{StaticResource SuccessBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Queue Status -->
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                       BorderBrush="{StaticResource BorderBrush}"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Padding="12"
                                       Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                  Text="Queue Status"
                                                  FontWeight="SemiBold"
                                                  FontSize="12"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Background="{StaticResource AccentAmberBrush}"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                Margin="10,0">
                                            <TextBlock Text="{Binding StoryGeneratorQ.QueuedCount, StringFormat={}Remaining: {0}}"
                                                      FontWeight="Bold"
                                                      FontSize="12"
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                  Text="{Binding StoryGeneratorQ.QueuedCount, StringFormat={}Queued: {0}}"
                                                  Margin="10,0"
                                                  FontSize="11"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                  Text="{Binding StoryGeneratorQ.CompletedCount, StringFormat={}Completed: {0}}"
                                                  Margin="10,0"
                                                  FontSize="11"
                                                  Foreground="{StaticResource SuccessTextBrush}"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4"
                                                  Text="{Binding StoryGeneratorQ.FailedCount, StringFormat={}Failed: {0}}"
                                                  Margin="10,0"
                                                  FontSize="11"
                                                  Foreground="{StaticResource DangerBrush}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Queue Progress -->
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                       BorderBrush="{StaticResource AccentAmberBrush}"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Padding="12"
                                       Margin="0,0,0,15"
                                       Visibility="{Binding StoryGeneratorQ.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StoryGeneratorQ.QueueProgressText, StringFormat={}Processing: {0}}"
                                                  FontWeight="SemiBold"
                                                  FontSize="11"
                                                  Foreground="#92400E"
                                                  Margin="0,0,0,6"/>
                                        <ProgressBar Value="{Binding StoryGeneratorQ.QueueProgress, Mode=OneWay}"
                                                  Maximum="{Binding StoryGeneratorQ.QueueTotal, Mode=OneWay}"
                                                  Height="6"
                                                  Foreground="{StaticResource AccentVioletBrush}"
                                                  Background="{StaticResource SurfaceAltBrush}"
                                                  BorderThickness="0"/>
                                        <TextBlock Text="{Binding StoryGeneratorQ.CurrentQueueItem.Prompt, StringFormat={}Current: {0}}"
                                                  FontSize="10"
                                                  Foreground="#92400E"
                                                  TextTrimming="CharacterEllipsis"
                                                  Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Queue Items List (compact) -->
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                       BorderBrush="{StaticResource BorderBrush}"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding StoryGeneratorQ.QueueItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                                           BorderThickness="0,0,0,1"
                                                           Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                      Text="{Binding Index, StringFormat='#{0}'}"
                                                                      FontWeight="Bold"
                                                                      FontSize="12"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,10,0"
                                                                      Foreground="{StaticResource AccentVioletBrush}"/>
                                                            <TextBlock Grid.Column="1"
                                                                      Text="{Binding Prompt}"
                                                                      FontSize="11"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#374151"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentVioletBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="2"
                                                                      Text="{Binding StatusDisplay}"
                                                                      FontSize="10"
                                                                      VerticalAlignment="Center"
                                                                      Margin="8,0,0,0"
                                                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Storyboard View (visible once items are loaded) -->
                        <Border Background="White"
                               BorderBrush="{StaticResource BorderBrush}"
                               BorderThickness="1"
                               CornerRadius="16"
                               Padding="24"
                               Margin="0,20,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.HasAnyItems}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>

                                <!-- Storyboard header + Save Final controls -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="🎬 Storyboard"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Save to folder:"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding StoryGeneratorQ.FinalFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="180"
                                                 Height="36"
                                                 Padding="10,0"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="12"
                                                 Background="{StaticResource SurfaceAltBrush}"
                                                 BorderBrush="{StaticResource BorderStrongBrush}"
                                                 Margin="0,0,10,0">
                                            <TextBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Button Content="💾 Save Final Storyboard"
                                                Command="{Binding StoryGeneratorQ.SaveFinalStoryboardCommand}"
                                                Height="36"
                                                Padding="16,0"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="12"
                                                FontWeight="SemiBold">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="8"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#CBD5E1"/>
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Hint text -->
                                <TextBlock Text="Click an image to open it. Edit the prompt below each image, then click Regenerate to redo that scene."
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,16"/>

                                <!-- Storyboard cards grid -->
                                <ItemsControl ItemsSource="{Binding StoryGeneratorQ.QueueItems}"
                                              x:Name="StoryboardQItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="240"
                                                    Margin="6,6"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <StackPanel Margin="12">

                                                    <!-- Scene label + delete button + status badge -->
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Index, StringFormat='Scene #{0}'}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource AccentVioletBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Delete X button -->
                                                        <Button HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,-6,-6,0"
                                                                Width="18" Height="18"
                                                                Padding="0"
                                                                Background="#E5E7EB"
                                                                BorderThickness="0"
                                                                FontSize="9"
                                                                FontWeight="Bold"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Content="✕"
                                                                ToolTip="Delete scene"
                                                                Command="{Binding DataContext.StoryGeneratorQ.DeleteItemCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        CornerRadius="9"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Border HorizontalAlignment="Right"
                                                                CornerRadius="8"
                                                                Padding="7,2"
                                                                Margin="0,0,24,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding Status}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentVioletBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Image thumbnail area (click to open) -->
                                                    <Border Height="195"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Margin="0,0,0,10"
                                                            Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding Command="{Binding OpenImageCommand}" MouseAction="LeftClick"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <!-- Placeholder when not yet completed -->
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock HorizontalAlignment="Center" FontSize="36">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="🖼️"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Text" Value="⚙️"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                    <Setter Property="Text" Value="❌"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Status}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,4,0,0"/>
                                                                <!-- Progress bar while processing -->
                                                                <ProgressBar Value="{Binding Progress}"
                                                                             Maximum="100"
                                                                             Height="4"
                                                                             Width="120"
                                                                             Margin="0,6,0,0"
                                                                             Foreground="{StaticResource AccentVioletBrush}"
                                                                             Background="#E5E7EB"
                                                                             BorderThickness="0">
                                                                    <ProgressBar.Style>
                                                                        <Style TargetType="ProgressBar">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ProgressBar.Style>
                                                                </ProgressBar>
                                                            </StackPanel>
                                                            <!-- Generated image -->
                                                            <Image Source="{Binding StoryboardThumbnailImage}"
                                                                   Stretch="Uniform"
                                                                   Margin="4">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Editable prompt -->
                                                    <TextBox Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="False"
                                                             Height="80"
                                                             Padding="8"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Background="White"
                                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                                             FontSize="11"
                                                             VerticalContentAlignment="Top"
                                                             Margin="0,0,0,8"
                                                             ToolTip="Edit this prompt and click Regenerate">
                                                        <TextBox.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </TextBox.Resources>
                                                    </TextBox>

                                                    <!-- Regenerate button -->
                                                    <Button Content="🔄 Regenerate"
                                                            Command="{Binding DataContext.StoryGeneratorQ.RegenerateItemCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            Height="32"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            FontSize="11"
                                                            FontWeight="SemiBold">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="{StaticResource AccentIndigoBrush}"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    CornerRadius="6"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AccentIndigoBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Background" Value="#CBD5E1"/>
                                                                        <Setter Property="Foreground" Value="#475569"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>

                        <!-- Log Output (Collapsible) -->
                        <Expander Margin="0,20,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="📋 Activity Log"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Expander.Header>
                            <Border Background="{StaticResource PlayerSurfaceBrush}"
                                   BorderBrush="#374151"
                                   BorderThickness="1"
                                   CornerRadius="8"
                                   Margin="0,8,0,0">
                                <ScrollViewer MaxHeight="150"
                                             VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding StoryGeneratorQ.LogOutput}"
                                           TextWrapping="Wrap"
                                           IsReadOnly="True"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Background="Transparent"
                                           Foreground="#D1D5DB"
                                           BorderThickness="0"
                                           Padding="12"/>
                                </ScrollViewer>
                            </Border>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Tab: Amateur Generator -->
            <TabItem Header="📷 Amateur" Visibility="{Binding IsCreateGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">

                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="✨ Amateur Photo Generator"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Saved Prompts Section -->
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="📝 Saved Prompts" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Select a saved prompt or save current:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="💾 Save" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AmateurGenerator.SavePromptCommand}" Padding="10,5" Margin="5,0,5,0"
                                            ToolTip="Save current prompt settings"
                                            Background="{StaticResource SuccessBrush}"/>
                                    <Button Grid.Column="2" Content="🗑️ Delete" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AmateurGenerator.DeletePromptCommand}" Padding="10,5" Margin="0,0,0,0"
                                            ToolTip="Delete selected saved prompt"
                                            Background="{StaticResource DangerBrush}"/>
                                </Grid>

                                <ComboBox ItemsSource="{Binding AmateurGenerator.SavedPrompts}"
                                          SelectedItem="{Binding AmateurGenerator.SelectedSavedPrompt, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          Padding="10"
                                          Background="White"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          FontSize="12"
                                          Margin="0,5,0,10"
                                          Height="40">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="10" Foreground="#666"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="💡 Tip: Your saved prompts appear here. Click Save to store the current prompt settings."
                                           FontSize="11" Foreground="#666" FontStyle="Italic" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Image Analysis & Prompt Enhancement -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                               BorderBrush="#C7D2FE"
                               BorderThickness="1"
                               CornerRadius="8"
                               Padding="16"
                               Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="📷 Image Analysis &amp; Prompt Enhancement"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource AccentIndigoBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Upload an image — it will be analyzed by the remote LLaMA server and automatically generate an enhanced prompt."
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <!-- Browse row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                            Text="{Binding AmateurGenerator.SourceImagePath, Mode=OneWay}"
                                            IsReadOnly="True"
                                            Padding="8"
                                            Background="White"
                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                            VerticalContentAlignment="Center"
                                            FontSize="11"
                                            Height="30"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Grid.Column="1"
                                           Content="Browse..."
                                           Command="{Binding AmateurGenerator.BrowseImageCommand}"
                                           Height="30"
                                           Width="80"
                                           Margin="6,0,0,0"
                                           Background="{StaticResource BrandBrush}"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentIndigoBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Image preview -->
                                <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                        Background="White" Height="160"
                                        CornerRadius="6" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="No image selected — click Browse to upload"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource TextMutedBrush}"
                                                  FontStyle="Italic"
                                                  FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AmateurGenerator.HasSourceImage}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding AmateurGenerator.SourceImageSource}"
                                               Stretch="Uniform"
                                               Margin="5"
                                               Visibility="{Binding AmateurGenerator.HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Analyze button + status -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                           Content="🔍 Analyze &amp; Enhance Prompt"
                                           Command="{Binding AmateurGenerator.AnalyzeImageCommand}"
                                           Height="38"
                                           Background="{StaticResource AccentAmberBrush}"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#CBD5E1"/>
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Border Grid.Column="1"
                                           Visibility="{Binding AmateurGenerator.IsAnalyzingImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ProgressBar IsIndeterminate="True" Width="80" Height="10" Foreground="{StaticResource AccentAmberBrush}"/>
                                            <TextBlock Text="Analyzing..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Main Controls Panel -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                               BorderBrush="{StaticResource BorderBrush}"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Additional Prompt -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Additional Prompt"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="📋 Paste"
                                               Command="{Binding AmateurGenerator.PasteFromClipboardCommand}"
                                               Width="80"
                                               Height="28"
                                               HorizontalAlignment="Right"
                                               FontSize="11"
                                               Padding="5,0"
                                               Background="#6B7280"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Cursor="Hand"/>
                                    </Grid>
                                    <TextBox Text="{Binding AmateurGenerator.AdditionalPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="80"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Padding="12"
                                             FontSize="13"
                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                             Background="White"/>
                                    <TextBlock Text="The photographer prefix will be added automatically"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Orientation Selection -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Image Orientation"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AmateurGenerator.Orientations}"
                                              SelectedIndex="{Binding AmateurGenerator.OrientationIndex}"
                                              FontSize="13"
                                              Padding="10"
                                              Background="White"
                                              BorderBrush="{StaticResource BorderStrongBrush}"/>
                                </StackPanel>

                                <!-- Style Selection -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,0">
                                    <TextBlock Text="Style"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AmateurGenerator.Styles}"
                                              SelectedIndex="{Binding AmateurGenerator.StyleIndex}"
                                              FontSize="13"
                                              Padding="10"
                                              Background="White"
                                              BorderBrush="{StaticResource BorderStrongBrush}"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- Character LoRA -->
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,15">
                            <StackPanel>
                                <CheckBox Content="Character LoRA"
                                         IsChecked="{Binding AmateurGenerator.LoraEnabled, Mode=TwoWay}"
                                         FontWeight="SemiBold"
                                         FontSize="13"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Margin="0,0,0,8"/>
                                <Grid Visibility="{Binding AmateurGenerator.LoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                             ItemsSource="{Binding AmateurGenerator.AvailableLoras}"
                                             SelectedItem="{Binding AmateurGenerator.SelectedLora, Mode=TwoWay}"
                                             Padding="8"
                                             Background="White"
                                             BorderBrush="{StaticResource BorderStrongBrush}"
                                             FontSize="12"/>
                                    <Button Grid.Column="1"
                                           Content="↻"
                                           Command="{Binding AmateurGenerator.RefreshLorasCommand}"
                                           Width="36"
                                           Margin="6,0,0,0"
                                           Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>
                                <StackPanel Visibility="{Binding AmateurGenerator.LoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Strength:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider Grid.Column="1"
                                               Value="{Binding AmateurGenerator.LoraStrength, Mode=TwoWay}"
                                               Minimum="0" Maximum="1.5" TickFrequency="0.05"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                  Text="{Binding AmateurGenerator.LoraStrength, StringFormat='{}{0:F2}'}"
                                                  FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                  Margin="8,0,0,0" Width="32"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Add to Queue Button -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                   Content="➕ Add to Queue"
                                   Command="{Binding AmateurGenerator.AddToQueueCommand}"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Height="45"
                                   FontSize="15"
                                   Background="{StaticResource SuccessBrush}"/>

                            <Button Grid.Column="1"
                                   Content="▶ Start Queue"
                                   Command="{Binding AmateurGenerator.ProcessQueueCommand}"
                                   Height="45"
                                   Width="130"
                                   Background="{StaticResource SuccessBrush}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Cursor="Hand"
                                   Margin="10,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCC"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="2"
                                   Content="⏹ Cancel"
                                   Command="{Binding AmateurGenerator.CancelQueueCommand}"
                                   Height="45"
                                   Width="90"
                                   Background="{StaticResource DangerBrush}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Cursor="Hand"
                                   Margin="8,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#DC2626"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCC"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Queue Panel -->
                        <Border Background="White"
                               BorderBrush="{StaticResource BorderBrush}"
                               BorderThickness="1"
                               CornerRadius="8"
                               Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Queue Header -->
                                <Grid Margin="15,12,15,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Queue"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource SuccessBrush}"
                                               CornerRadius="10"
                                               Padding="6,2"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AmateurGenerator.QueueCount}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="processing..."
                                                   FontSize="11"
                                                   Foreground="{StaticResource SuccessTextBrush}"
                                                   FontStyle="Italic"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding AmateurGenerator.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <Button Content="Clear All"
                                           Command="{Binding AmateurGenerator.ClearQueueCommand}"
                                           HorizontalAlignment="Right"
                                           Background="#6B7280"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Padding="10,4"
                                           FontSize="11"
                                           Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220" Padding="15,0,15,10">
                                    <ItemsControl ItemsSource="{Binding AmateurGenerator.Queue}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F3F4F6"
                                                       BorderThickness="0,0,0,1"
                                                       Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Item Info -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayPrompt}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding OrientationDisplay}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Text=" · "
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding StyleDisplay}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Status / Progress -->
                                                        <StackPanel Grid.Column="1"
                                                                   Orientation="Horizontal"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0">
                                                            <TextBlock Text="{Binding StatusDisplay}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding StatusColor}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ProgressBar Value="{Binding Progress}"
                                                                        Width="50"
                                                                        Height="10"
                                                                        Margin="4,0">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                        </StackPanel>

                                                        <!-- Thumbnail when completed -->
                                                        <Button Grid.Column="2"
                                                               Command="{Binding OpenImageCommand}"
                                                               Background="Transparent"
                                                               BorderThickness="0"
                                                               Cursor="Hand"
                                                               ToolTip="Click to open image"
                                                               Padding="0"
                                                               Margin="4,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Image Source="{Binding ThumbnailImage}"
                                                                   Height="44"
                                                                   Stretch="Uniform"/>
                                                        </Button>

                                                        <!-- Remove Button -->
                                                        <Button Grid.Column="3"
                                                               Content="❌"
                                                               Command="{Binding DataContext.AmateurGenerator.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"
                                                               Background="Transparent"
                                                               BorderThickness="0"
                                                               Padding="4"
                                                               ToolTip="Remove from queue"
                                                               FontSize="11"
                                                               Cursor="Hand"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Progress Section -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                               BorderBrush="{StaticResource BorderBrush}"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20"
                               Visibility="{Binding AmateurGenerator.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Processing..."
                                              FontWeight="SemiBold"
                                              FontSize="13"
                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding AmateurGenerator.ProgressPercentage}"
                                              FontWeight="Bold"
                                              FontSize="13"
                                              Foreground="{StaticResource SuccessTextBrush}"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding AmateurGenerator.ProcessingProgress}"
                                           Maximum="100"
                                           Height="8"
                                           Margin="0,10,0,0"
                                           Background="#E5E7EB"
                                           Foreground="{StaticResource SuccessTextBrush}"/>
                                <TextBlock Text="{Binding AmateurGenerator.ProcessingStatus}"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Result Section -->
                        <Border BorderBrush="{StaticResource BorderBrush}"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20"
                               Visibility="{Binding AmateurGenerator.HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <TextBlock Text="Generated Image"
                                              FontWeight="SemiBold"
                                              FontSize="14"
                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Content="Open Folder"
                                           Command="{Binding AmateurGenerator.OpenResultFolderCommand}"
                                           Width="100"
                                           Height="32"
                                           Background="#6B7280"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           Cursor="Hand"/>
                                </Grid>

                                <Border Grid.Row="1"
                                       BorderBrush="{StaticResource BorderBrush}"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Background="White"
                                       HorizontalAlignment="Center">
                                    <Button Command="{Binding AmateurGenerator.OpenResultImageCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Click to open in image viewer" Padding="0">
                                        <Image Source="{Binding AmateurGenerator.ResultImageSource}"
                                              MaxWidth="600"
                                              MaxHeight="400"
                                              Margin="10"/>
                                    </Button>
                                </Border>

                                <TextBlock Grid.Row="1"
                                          Text="{Binding AmateurGenerator.ImageInfo}"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,15,0,0"
                                          HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Log Output -->
                        <Border Background="{StaticResource PlayerSurfaceBrush}"
                               BorderBrush="#374151"
                               BorderThickness="1"
                               CornerRadius="8"
                               Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                          Text="Log Output"
                                          FontWeight="SemiBold"
                                          FontSize="12"
                                          Foreground="{StaticResource PlayerTextBrush}"
                                          Margin="0,0,0,10"/>

                                <TextBox Grid.Row="1"
                                         Text="{Binding AmateurGenerator.LogOutput}"
                                         IsReadOnly="True"
                                         Height="150"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource PlayerSurfaceBrush}"
                                         Foreground="{StaticResource PlayerTextBrush}"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Padding="10"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Camera Angle Generator -->
            <TabItem Header="🎥 Camera Angle" Visibility="{Binding IsAdvancedGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">
                        <!-- Header -->
                        <TextBlock Text="Camera Angle Generator" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Generate multiple character angles from a single image using Flux2 models" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,25"/>

                        <!-- Input Section -->
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Input Image" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                <!-- File Selection Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Padding="12,10">
                                        <TextBlock Text="{Binding CameraAngle.InputImagePath, FallbackValue='No image selected'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <Button Grid.Column="2" Content="Browse..." Command="{Binding CameraAngle.SelectInputImageCommand}"
                                            Background="{StaticResource BrandBrush}" Foreground="White" BorderThickness="0" Padding="15,8"
                                            FontSize="12" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Image Preview -->
                                <Border Margin="0,15,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}"
                                        HorizontalAlignment="Left" Width="300" Height="200">
                                    <Grid>
                                        <Image Source="{Binding CameraAngle.InputImagePreview}" Stretch="Uniform" Margin="10"/>
                                        <TextBlock Text="No image loaded" FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CameraAngle.InputImagePreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Prompts Section -->
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Prompts (one image each)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="These camera angles will be generated from your input image." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                <!-- Training Prompts -->
                                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Training Prompts" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Replace all prompts above with one or more saved training sets. Select any combination, then Load."
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <!-- Saved sets list (checkbox + name + delete) -->
                                        <ItemsControl ItemsSource="{Binding CameraAngle.TrainingSets}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="Delete" FontSize="11" Padding="8,3"
                                                                Background="{StaticResource DangerBrush}" Foreground="White" BorderThickness="0"
                                                                Command="{Binding DataContext.CameraAngle.DeleteTrainingSetCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="No training sets saved yet." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CameraAngle.TrainingSets.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="Load Training Prompts" Command="{Binding CameraAngle.LoadTrainingPromptsCommand}"
                                                    Background="{StaticResource BrandBrush}" Foreground="White" BorderThickness="0" Padding="12,7"
                                                    FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                            <Button Content="Reset to Camera Angles" Command="{Binding CameraAngle.ResetToCameraAnglesCommand}"
                                                    Background="#E5E7EB" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="12,7"
                                                    FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Create a new training set from pasted prompts -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="Save a new training set" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Paste one or more prompts (one per line), give the set a name, then Save."
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding CameraAngle.NewSetName, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="8,6" FontSize="12"
                                                         Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"
                                                         ToolTip="Training set name"/>
                                                <TextBox Text="{Binding CameraAngle.NewSetPrompts, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"
                                                         VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="8,6" FontSize="12"
                                                         Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"
                                                         ToolTip="Paste prompts here, one per line"/>
                                                <Button Content="Save Set" Command="{Binding CameraAngle.SaveTrainingSetCommand}"
                                                        Background="{StaticResource SuccessBrush}" Foreground="White" BorderThickness="0" Padding="12,7"
                                                        FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding CameraAngle.Prompts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Optional Extra Prompt -->
                                <TextBlock Text="Extra prompt (optional)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,15,0,4"/>
                                <TextBlock Text="Add your own prompt to generate one additional image." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CameraAngle.ExtraPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="10,8" FontSize="12"
                                         Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Generate Camera Angles" Command="{Binding CameraAngle.GenerateCameraAnglesCommand}"
                                    Background="{StaticResource SuccessBrush}" Foreground="White" BorderThickness="0" Padding="15,10"
                                    FontSize="13" FontWeight="SemiBold"/>

                            <Button Grid.Column="2" Content="Cancel" Command="{Binding CameraAngle.CancelGenerationCommand}"
                                    Background="{StaticResource DangerBrush}" Foreground="White" BorderThickness="0" Padding="15,10"
                                    FontSize="13" FontWeight="SemiBold"
                                    Visibility="{Binding CameraAngle.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Button Grid.Column="4" Content="Open Output Folder" Command="{Binding CameraAngle.OpenOutputFolderCommand}"
                                    Background="{StaticResource BrandBrush}" Foreground="White" BorderThickness="0" Padding="15,10"
                                    FontSize="13" FontWeight="SemiBold"/>

                            <Button Grid.Column="6" Content="Clear Output" Command="{Binding CameraAngle.ClearOutputCommand}"
                                    Background="{StaticResource BrandBrush}" Foreground="White" BorderThickness="0" Padding="15,10"
                                    FontSize="13" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Progress Section -->
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20"
                                Visibility="{Binding CameraAngle.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Processing Status" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CameraAngle.ProgressPercentage}" FontSize="13" Foreground="{StaticResource SuccessTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <ProgressBar Value="{Binding CameraAngle.ProcessingProgress}" Maximum="100" Height="8" Margin="0,10,0,5"
                                            Foreground="{StaticResource SuccessTextBrush}" Background="#E5E7EB"/>

                                <TextBlock Text="{Binding CameraAngle.ProcessingStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Output Section -->
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Generated Camera Angles" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding CameraAngle.OutputItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,10">
                                                <StackPanel Width="180">
                                                    <!-- Thumbnail Image -->
                                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Width="160" Height="160"
                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                            <Setter Property="Source" Value="{x:Null}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Border>

                                                    <!-- Info and Button -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="5"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                                        <Button Grid.Column="2" Content="Open" FontSize="11" Padding="8,4"
                                                                Background="{StaticResource BrandBrush}" Foreground="White" BorderThickness="0"
                                                                Tag="{Binding FilePath}" Click="OpenOutputImage_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No camera angles generated yet" FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Padding="20">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CameraAngle.OutputItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Log Output -->
                        <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                            <TextBox Text="{Binding CameraAngle.LogOutput}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource PlayerSurfaceBrush}"
                                     Foreground="{StaticResource PlayerTextBrush}"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Padding="10"
                                     Height="150"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Tab: Inpaint Editor -->
            <TabItem Header="✏️ Editor" Visibility="{Binding IsEditGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource AppBackgroundBrush}" Padding="15,10,15,6">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="🖌 Paint mask" GroupName="EditorMode" Style="{StaticResource GroupPillStyle}"
                                         IsChecked="{Binding IsPaintEditor, Mode=OneWay}"
                                         Command="{Binding SelectEditorModeCommand}" CommandParameter="0"/>
                            <RadioButton Content="🪄 Auto-detect" GroupName="EditorMode" Style="{StaticResource GroupPillStyle}"
                                         IsChecked="{Binding IsAutoDetectEditor, Mode=OneWay}"
                                         Command="{Binding SelectEditorModeCommand}" CommandParameter="1"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                    <Grid Visibility="{Binding IsPaintEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Source image + mask painting -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">

                            <!-- Upload section -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Source Image" Style="{StaticResource HeaderTextStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                Background="White" Padding="8,6">
                                            <TextBlock Text="{Binding InpaintEditor.SourceImagePath, FallbackValue='No image selected'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Button Grid.Column="2" Content="📂 Browse"
                                                Command="{Binding InpaintEditor.BrowseImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="14,8"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Canvas: source image + mask painting overlay -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Paint Mask" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Paint over the area you want to edit. Red strokes = inpaint region."
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                    <!-- Brush controls -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Brush:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Slider x:Name="BrushSizeSlider"
                                                Minimum="5" Maximum="120"
                                                Value="{Binding InpaintEditor.BrushSize, Mode=TwoWay}"
                                                Width="140" VerticalAlignment="Center"
                                                ValueChanged="BrushSizeSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding InpaintEditor.BrushSize, StringFormat='  {0}px'}"
                                                   FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Button Content="🗑️ Clear Mask" Click="ClearMask_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource DangerBrush}" Padding="10,6" Margin="12,0,0,0" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Image + InkCanvas layered in a Grid -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="420" ClipToBounds="True">
                                        <Grid>
                                            <!-- Source image -->
                                            <Image x:Name="EditorSourceImage"
                                                   Source="{Binding InpaintEditor.SourceImageSource}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <!-- Placeholder when no image loaded -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding InpaintEditor.NoSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Browse an image to start" FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <!-- InkCanvas mask painter (transparent bg, red strokes) -->
                                            <InkCanvas x:Name="MaskInkCanvas"
                                                       Background="Transparent"
                                                       Cursor="Cross"
                                                       IsEnabled="{Binding InpaintEditor.HasSourceImage}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Prompt section -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Edit Prompt" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding InpaintEditor.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="70" MaxHeight="120"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="13" Padding="8"
                                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                </StackPanel>
                            </Border>

                            <!-- Generate button + progress -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <Button Content="⚡ Generate Inpaint"
                                            Click="RunInpaint_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            IsEnabled="{Binding InpaintEditor.CanGenerate}"
                                            Padding="20,12" FontSize="14" HorizontalAlignment="Stretch"/>

                                    <!-- Progress -->
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding InpaintEditor.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding InpaintEditor.StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding InpaintEditor.ProgressText}" FontSize="12"
                                                       Foreground="{StaticResource AccentIndigoBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding InpaintEditor.Progress}" Maximum="100" Height="8"
                                                     Foreground="{StaticResource AccentIndigoBrush}" Background="#E5E7EB"/>
                                    </StackPanel>

                                    <!-- Status message -->
                                    <TextBlock Text="{Binding InpaintEditor.StatusMessage}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- RIGHT: Result -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}"/>

                                    <!-- Result image display -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="420" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding InpaintEditor.ResultImageSource}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding InpaintEditor.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here" FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Result actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding InpaintEditor.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding InpaintEditor.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding InpaintEditor.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PlayerTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding InpaintEditor.LogOutput}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}"
                                             Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Padding="4"
                                             Height="200"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                    <Grid Visibility="{Binding IsAutoDetectEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Controls -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">

                            <!-- Source Image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Source Image" Style="{StaticResource HeaderTextStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                Background="White" Padding="8,6">
                                            <TextBlock Text="{Binding KleinInpaintEditor.SourceImagePath, FallbackValue='No image selected'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Button Grid.Column="2" Content="📂 Browse"
                                                Command="{Binding KleinInpaintEditor.BrowseImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="14,8"/>
                                    </Grid>

                                    <!-- Source preview thumbnail -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="240" Margin="0,10,0,0" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding KleinInpaintEditor.SourceImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding KleinInpaintEditor.NoSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="📷" FontSize="40" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Upload an image to begin" FontSize="13"
                                                           Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Detect & Replace -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Detect &amp; Replace" Style="{StaticResource HeaderTextStyle}"/>

                                    <!-- Detection Target -->
                                    <TextBlock Text="What to detect" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                                    <TextBlock Text="Florence2 + SAM2 will auto-segment this subject"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KleinInpaintEditor.DetectionTarget, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" FontSize="13" Padding="8,6"
                                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                             VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="e.g. face, person, cup, sky"
                                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="10,0,0,0"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- Prompt -->
                                    <TextBlock Text="Replace with" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,4"/>
                                    <TextBlock Text="Describe what should appear in the detected area"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KleinInpaintEditor.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="80" MaxHeight="140"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="13" Padding="8"
                                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                </StackPanel>
                            </Border>

                            <!-- Generation Settings -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Generation Settings" Style="{StaticResource HeaderTextStyle}"/>

                                    <!-- Steps -->
                                    <Grid Margin="0,6,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Steps" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Slider Grid.Column="1" Minimum="1" Maximum="30"
                                                Value="{Binding KleinInpaintEditor.Steps, Mode=TwoWay}"
                                                VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="2" Text="{Binding KleinInpaintEditor.Steps}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentVioletBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- CFG -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CFG" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Slider Grid.Column="1" Minimum="1" Maximum="10"
                                                Value="{Binding KleinInpaintEditor.Cfg, Mode=TwoWay}"
                                                VerticalAlignment="Center" TickFrequency="0.5" IsSnapToTickEnabled="False"/>
                                        <TextBlock Grid.Column="2" Text="{Binding KleinInpaintEditor.CfgText}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentVioletBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Denoise -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Denoise" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                Value="{Binding KleinInpaintEditor.Denoise, Mode=TwoWay}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding KleinInpaintEditor.DenoiseText}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentVioletBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- LoRA Strength -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="LoRA" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="4"
                                                Value="{Binding KleinInpaintEditor.LoraStrength, Mode=TwoWay}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding KleinInpaintEditor.LoraStrengthText}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentVioletBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Models (collapsible) -->
                                    <Expander Header="Models" Margin="0,10,0,0" FontSize="12"
                                              Foreground="{StaticResource TextSecondaryBrush}" IsExpanded="False">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="UNET" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding KleinInpaintEditor.UnetName, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30" FontSize="11" Padding="6,4"
                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8"
                                                     FontFamily="Consolas"/>
                                            <TextBlock Text="LoRA" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding KleinInpaintEditor.LoraName, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30" FontSize="11" Padding="6,4"
                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                     FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Generate -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <Button Content="⚡ Generate"
                                            Command="{Binding KleinInpaintEditor.GenerateCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}"
                                            IsEnabled="{Binding KleinInpaintEditor.CanGenerate}"
                                            Padding="20,12" FontSize="14" HorizontalAlignment="Stretch"/>

                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding KleinInpaintEditor.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding KleinInpaintEditor.StatusMessage}"
                                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding KleinInpaintEditor.ProgressText}"
                                                       FontSize="12" Foreground="{StaticResource AccentVioletBrush}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding KleinInpaintEditor.Progress}" Maximum="100" Height="8"
                                                     Foreground="{StaticResource AccentVioletBrush}" Background="#E5E7EB"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding KleinInpaintEditor.StatusMessage}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- RIGHT: Result + Log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">

                            <!-- Pipeline info badge -->
                            <Border Background="#F3F0FF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Klein Flux 2 — Auto Inpaint" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentVioletBrush}"/>
                                    <TextBlock FontSize="11" Foreground="#6D28D9" Margin="0,4,0,0" TextWrapping="Wrap">
                                        Florence2 detects the subject → SAM2 creates a precise mask → Klein model replaces it seamlessly
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="420" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding KleinInpaintEditor.ResultImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding KleinInpaintEditor.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here" FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding KleinInpaintEditor.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding KleinInpaintEditor.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding KleinInpaintEditor.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PlayerTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KleinInpaintEditor.LogOutput}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}" Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0" FontFamily="Consolas"
                                             FontSize="11" Padding="4" Height="200"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===== CONTROL: Klein Flux 2 Control Net (reference + pose → analyze → generate) ===== -->
            <TabItem Header="🎛️ Control" Visibility="{Binding IsAdvancedGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">

                            <!-- Workflow selector -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Workflow" Style="{StaticResource HeaderTextStyle}"/>
                                    <ComboBox ItemsSource="{Binding KleinControl.WorkflowOptions}"
                                              SelectedIndex="{Binding KleinControl.SelectedWorkflowIndex}"
                                              FontSize="12" Padding="8,5"/>
                                </StackPanel>
                            </Border>

                            <!-- Pipeline badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding KleinControl.WorkflowTitle}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#1D4ED8"/>
                                    <TextBlock Text="{Binding KleinControl.WorkflowDescription}"
                                               FontSize="11" Foreground="{StaticResource AccentIndigoBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Reference image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding KleinControl.RefImageLabel}" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding KleinControl.RefImagePath, FallbackValue='No image selected'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Reference"
                                            Command="{Binding KleinControl.BrowseRefImageCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="180" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding KleinControl.RefImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding KleinControl.NoRefImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Reference image" FontSize="12" Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Pose image / video picker -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding KleinControl.PoseImageLabel}" Style="{StaticResource HeaderTextStyle}"/>

                                    <!-- Browse row: image OR video -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="📂 Browse Image"
                                                Command="{Binding KleinControl.BrowsePoseImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="10,7" FontSize="12" Margin="0,0,6,0"/>
                                        <Button Content="🎬 Browse Video"
                                                Command="{Binding KleinControl.BrowseVideoCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="10,7" FontSize="12"/>
                                    </StackPanel>

                                    <!-- IMAGE MODE: shown when no video loaded -->
                                    <StackPanel Visibility="{Binding KleinControl.NoVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding KleinControl.PoseImagePath, FallbackValue='No image selected'}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                Background="{StaticResource PlayerSurfaceBrush}" Height="180" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding KleinControl.PoseImageSource}"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding KleinControl.NoPoseImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="🕴️" FontSize="36" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Browse an image or video" FontSize="12" Foreground="{StaticResource PlayerTextBrush}"
                                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- VIDEO MODE: shown when video is loaded -->
                                    <StackPanel Visibility="{Binding KleinControl.HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <!-- Video info -->
                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="#C4B5FD" BorderThickness="1" CornerRadius="4"
                                                Padding="8,5" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding KleinControl.VideoInfoText}" FontSize="11" Foreground="#5B21B6"/>
                                        </Border>

                                        <!-- Frame preview -->
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                Background="{StaticResource PlayerSurfaceBrush}" Height="200" ClipToBounds="True" Margin="0,0,0,8">
                                            <Grid>
                                                <Image Source="{Binding KleinControl.FramePreviewSource}"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding KleinControl.NoFramePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="🎞️" FontSize="36" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Loading frame..." FontSize="12" Foreground="{StaticResource PlayerTextBrush}"
                                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <!-- Extracting spinner overlay -->
                                                <Border Background="#80000000" CornerRadius="4"
                                                        Visibility="{Binding KleinControl.IsExtractingFrame, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="⏳ Extracting..." FontSize="13" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Seek slider -->
                                        <Slider Value="{Binding KleinControl.FramePositionSeconds, Mode=TwoWay}"
                                                Minimum="0" Maximum="{Binding KleinControl.VideoDurationSeconds}"
                                                TickFrequency="1" IsSnapToTickEnabled="False"
                                                Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding KleinControl.FramePositionText}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"/>

                                        <!-- Use This Frame button + set indicator -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📌 Use This Frame"
                                                    Command="{Binding KleinControl.UseFrameCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12"/>
                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="#6EE7B7" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,4" Margin="8,0,0,0"
                                                    Visibility="{Binding KleinControl.HasPoseImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="✓ Frame set" FontSize="11" Foreground="{StaticResource SuccessTextBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- Analyze button (Klein mode only) -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12"
                                    Visibility="{Binding KleinControl.ShowAnalyzeSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Step 1 — Analyze" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">
                                        Runs QwenVL inside ComfyUI to analyze the pose image and generate a prompt.
                                        Also produces a first generated image.
                                    </TextBlock>
                                    <Button Content="🔍 Analyze"
                                            Command="{Binding KleinControl.AnalyzeCommand}"
                                            IsEnabled="{Binding KleinControl.CanAnalyze}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource SuccessBrush}" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding KleinControl.IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="⏳ " FontSize="13"/>
                                        <TextBlock Text="{Binding KleinControl.StatusMessage}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Prompt editor -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 2 — Edit Prompt" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding KleinControl.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             MinLines="5" MaxLines="10"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="12" Padding="8"
                                             Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Generate button -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 3 — Generate" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">
                                        Sends the edited prompt to ComfyUI with your reference and pose images.
                                    </TextBlock>
                                    <Button Content="🚀 Generate"
                                            Command="{Binding KleinControl.GenerateCommand}"
                                            IsEnabled="{Binding KleinControl.CanGenerate}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding KleinControl.StatusMessage}"
                                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding KleinControl.Progress}" Maximum="100" Height="6"
                                                     Margin="0,4,0,0" Background="#E5E7EB" Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- RIGHT: result + log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">

                            <!-- Info badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Klein Flux 2 — Control Net Pipeline" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#15803D"/>
                                    <TextBlock FontSize="11" Foreground="#166534" Margin="0,4,0,0" TextWrapping="Wrap">
                                        QwenVL analyzes the pose image → DWPose extracts skeleton → Klein Flux 2 generates
                                        with your reference subject in the target pose
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="420" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding KleinControl.ResultImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding KleinControl.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here" FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding KleinControl.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding KleinControl.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding KleinControl.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PlayerTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KleinControl.LogOutput}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}" Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0" FontFamily="Consolas"
                                             FontSize="11" Padding="4" Height="200"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>

            <!-- ===== IDEOGRAM: Image → LLM prompt → Ideogram v4 generation ===== -->
            <TabItem Header="🔤 Ideogram" Visibility="{Binding IsCreateGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="12,12,12,12">
                        <StackPanel>

                            <!-- Aspect ratio + resolution -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 1 — Format" Style="{StaticResource HeaderTextStyle}"/>
                                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,8">
                                        <Button Content="◼ Square" Command="{Binding Ideogram.SetAspectCommand}" CommandParameter="Square"
                                                FontSize="12" Padding="6,8" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ideogram.IsSquare}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentRoseBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="▭ Wide" Command="{Binding Ideogram.SetAspectCommand}" CommandParameter="Widescreen"
                                                FontSize="12" Padding="6,8" Margin="2,0,2,0" Cursor="Hand" BorderThickness="0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ideogram.IsWidescreen}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentRoseBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="▯ Portrait" Command="{Binding Ideogram.SetAspectCommand}" CommandParameter="Portrait"
                                                FontSize="12" Padding="6,8" Margin="4,0,0,0" Cursor="Hand" BorderThickness="0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ideogram.IsPortrait}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentRoseBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </UniformGrid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Resolution" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   ToolTip="Output megapixels. The Instant graph renders in one pass, so this is the saved size; the summary on the right shows the exact pixels for the chosen format."/>
                                        <ComboBox Grid.Column="1" Width="70" FontSize="12"
                                                  ItemsSource="{Binding Ideogram.MegapixelChoices}"
                                                  SelectedItem="{Binding Ideogram.Megapixel}"
                                                  ToolTip="Output megapixels. The Instant graph renders in one pass, so this is the saved size; the summary on the right shows the exact pixels for the chosen format."/>
                                        <TextBlock Grid.Column="2" Text="{Binding Ideogram.AspectSummary}" HorizontalAlignment="Right"
                                                   FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- High-level prompt -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 2 — High-Level Prompt" Style="{StaticResource HeaderTextStyle}"/>

                                    <!-- Browse image → LLM → fills prompt + region 1 -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Thumbnail -->
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4" Margin="0,0,8,0"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Ideogram.InputImageSource}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="🖼️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding Ideogram.NoInputImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Ideogram.AvailableModels}"
                                                  SelectedItem="{Binding Ideogram.SelectedLlmModel}"
                                                  VerticalAlignment="Center" FontSize="11" Padding="6,4"
                                                  ToolTip="LLM (llama-server) model used to analyze the image"/>
                                        <Button Grid.Column="2" Content="🔄"
                                                Command="{Binding Ideogram.LoadModelsCommand}"
                                                FontSize="12" Padding="8,4" Margin="6,0,0,0" ToolTip="Refresh models"
                                                Style="{StaticResource SecondaryButtonStyle}" Background="{StaticResource BrandBrush}"/>
                                    </Grid>
                                    <Button Content="📂 Upload Image → Auto Prompt + Segments"
                                            Command="{Binding Ideogram.BrowseAndAnalyzeCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource SuccessBrush}" Padding="12,8" FontSize="12"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                            ToolTip="Upload an image: it is analyzed automatically into an enhanced prompt, a style block and the composition segments, then queued for generation"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center"
                                                Visibility="{Binding Ideogram.IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="⏳ " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Ideogram.StatusMessage}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button Content="✖ Cancel"
                                                Command="{Binding Ideogram.CancelAnalyzeCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Background="{StaticResource DangerBrush}"
                                                FontSize="11" Padding="8,3" Margin="10,0,0,0"
                                                ToolTip="Stop sending the image to the LLM"/>
                                    </StackPanel>

                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap">
                                        Written automatically the moment an image is uploaded. Used as the global prompt and as the fallback for segments with no description.
                                    </TextBlock>
                                    <TextBox Text="{Binding Ideogram.HighLevelPrompt, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             MinLines="4" MaxLines="10"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="12" Padding="8"/>
                                </StackPanel>
                            </Border>

                            <!-- Enriched style (from the autoprompter analysis) -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12"
                                    Visibility="{Binding Ideogram.HasStyleDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Enriched Style (auto)" Style="{StaticResource HeaderTextStyle}" VerticalAlignment="Center"/>
                                        <CheckBox Content="Enabled" IsChecked="{Binding Ideogram.UseEnrichedStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  FontSize="11" Foreground="{StaticResource AccentCyanBrush}"/>
                                    </Grid>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap">
                                        Medium, aesthetics, lighting, camera and background detected by the LLM. When enabled these are fed into Ideogram4PromptBuilderKJ alongside the per-region boxes; when off, only the high-level prompt and regions drive the image.
                                    </TextBlock>
                                    <TextBlock Text="{Binding Ideogram.StyleSummary}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                                               IsEnabled="{Binding Ideogram.UseEnrichedStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Region canvas editor -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Step 3 — Composition Segments" Style="{StaticResource HeaderTextStyle}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                            <Button Content="➕ Segment" Command="{Binding Ideogram.AddRegionCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Background="{StaticResource BrandBrush}"
                                                    Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Content="🗑 Clear" Command="{Binding Ideogram.ClearRegionsCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Background="#6B7280"
                                                    Padding="8,4" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">
                                        Filled in automatically by the analysis. Drag boxes to move them; drag the corner to resize. Each box gets its own description below.
                                    </TextBlock>

                                    <CheckBox Content="Use composition segments (recommended)" IsChecked="{Binding Ideogram.UseRegions}"
                                              FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap">
                                        On: each box is sent to Ideogram as its own placed element, which is what reproduces the reference layout. Off: one full-frame element carrying just the high-level prompt.
                                    </TextBlock>

                                    <!-- Canvas -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Padding="10" HorizontalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Ideogram.Regions}"
                                                      Width="{Binding Ideogram.CanvasWidth}"
                                                      Height="{Binding Ideogram.CanvasHeight}"
                                                      Background="#0F0F1E"
                                                      ClipToBounds="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                        <!-- Body / move -->
                                                        <Thumb DragDelta="RegionMove_DragDelta" DragStarted="Region_DragStarted" Cursor="SizeAll">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border x:Name="box" Background="#330EA5E9" BorderBrush="{StaticResource AccentCyanBrush}"
                                                                            BorderThickness="2" CornerRadius="2">
                                                                        <Border Background="{StaticResource BrandBrush}" CornerRadius="2" Padding="4,1"
                                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2">
                                                                            <TextBlock Text="{Binding Label}" Foreground="White"
                                                                                       FontSize="11" FontWeight="Bold"/>
                                                                        </Border>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                                                                            <Setter TargetName="box" Property="Background" Value="#44F59E0B"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                        <!-- Resize handle -->
                                                        <Thumb DragDelta="RegionResize_DragDelta" DragStarted="Region_DragStarted"
                                                               Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                               Cursor="SizeNWSE">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="{StaticResource BrandBrush}" BorderBrush="White" BorderThickness="1" CornerRadius="2"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- Region descriptions -->
                                    <ItemsControl ItemsSource="{Binding Ideogram.Regions}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource BrandBrush}" CornerRadius="10" Width="20" Height="20"
                                                            VerticalAlignment="Top" Margin="0,2,6,0">
                                                        <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextWrapping="Wrap" AcceptsReturn="True" MinLines="1" MaxLines="4"
                                                                 FontSize="11" Padding="6"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 Tag="Describe this segment (optional)"/>
                                                        <!-- Typography segments also carry the literal string Ideogram must render. -->
                                                        <Grid Margin="0,4,0,0"
                                                              Visibility="{Binding IsTextElement, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="🅣" FontSize="12" Foreground="{StaticResource AccentVioletBrush}"
                                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                                       ToolTip="Text segment — the exact lettering to render"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontSize="11" Padding="6" FontWeight="SemiBold"/>
                                                        </Grid>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="✕" FontSize="12" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,0"
                                                            VerticalAlignment="Top" Margin="2,0,0,0" ToolTip="Remove segment"
                                                            Command="{Binding DataContext.Ideogram.RemoveRegionCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Generate -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 4 — Generate" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">
                                        Renders one image at the chosen aspect ratio, then refines it through the workflow's 2× second pass.
                                    </TextBlock>
                                    <Button Content="🚀 Generate"
                                            Command="{Binding Ideogram.GenerateCommand}"
                                            IsEnabled="{Binding Ideogram.CanGenerate}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Ideogram.StatusMessage}"
                                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding Ideogram.Progress}" Maximum="100" Height="6"
                                                     Margin="0,4,0,0" Background="#E5E7EB" Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Queue Section -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Queue" Style="{StaticResource HeaderTextStyle}"/>

                                    <!-- Queue buttons -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="➕ Add to Queue"
                                                Command="{Binding Ideogram.AddToQueueCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="10,8" FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="▶ Start"
                                                Command="{Binding Ideogram.ProcessQueueCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}" Padding="12,8" FontSize="12" Margin="6,0,0,0"/>
                                        <Button Grid.Column="2" Content="⏹ Stop"
                                                Command="{Binding Ideogram.CancelQueueCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource DangerBrush}" Padding="10,8" FontSize="12" Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- Queue status -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{StaticResource BrandBrush}" CornerRadius="10" Padding="6,2">
                                            <TextBlock Text="{Binding Ideogram.QueueCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="waiting..."
                                                   FontSize="11" Foreground="{StaticResource AccentIndigoBrush}" FontStyle="Italic" Margin="8,0,0,0"
                                                   Visibility="{Binding Ideogram.IsWaitingForLease, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="processing..."
                                                   FontSize="11" Foreground="{StaticResource SuccessTextBrush}" FontStyle="Italic" Margin="8,0,0,0"
                                                   Visibility="{Binding Ideogram.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Queue items list -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <ItemsControl ItemsSource="{Binding Ideogram.Queue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Item info -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayPrompt}" FontSize="11" FontWeight="Medium"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding RatioDisplay}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Status -->
                                                            <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="8,0"/>
                                                            <ProgressBar Grid.Column="1" Value="{Binding Progress}" Width="40" Height="8" Margin="8,0">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>

                                                            <!-- Actions -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="🖼️" Command="{Binding OpenImageCommand}" FontSize="12"
                                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2"
                                                                        ToolTip="Open image">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="✕" FontSize="11" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0"
                                                                        ToolTip="Remove">
                                                                    <Button.InputBindings>
                                                                        <MouseBinding Gesture="LeftClick"/>
                                                                    </Button.InputBindings>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Button Content="Clear All" Command="{Binding Ideogram.ClearQueueCommand}"
                                            HorizontalAlignment="Right" Background="#6B7280" Foreground="White"
                                            BorderThickness="0" Padding="8,3" FontSize="10" Cursor="Hand" Margin="0,4,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Generated Images gallery -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12"
                                    Visibility="{Binding Ideogram.HasGeneratedImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Generated Images" Style="{StaticResource HeaderTextStyle}"
                                                   VerticalAlignment="Center" Margin="0"/>
                                        <Button Grid.Column="1" Content="Clear All"
                                                Command="{Binding Ideogram.ClearGeneratedImagesCommand}"
                                                Background="#6B7280" Foreground="White" BorderThickness="0"
                                                Padding="8,3" FontSize="10" Cursor="Hand"
                                                ToolTip="Remove thumbnails from view (does not delete files)">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                        <ItemsControl ItemsSource="{Binding Ideogram.GeneratedImages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="96" Height="96" Margin="4">
                                                        <!-- Click image center → open in registered Windows image viewer -->
                                                        <Button Command="{Binding DataContext.Ideogram.OpenGeneratedImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand" Padding="0" BorderThickness="1"
                                                                ToolTip="{Binding FileName}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                                            Background="{StaticResource SurfaceAltBrush}" SnapsToDevicePixels="True">
                                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <!-- "x" top-right → delete file from disk -->
                                                        <Button Command="{Binding DataContext.Ideogram.DeleteGeneratedImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="✕" FontSize="11" FontWeight="Bold" Foreground="White"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                                Width="18" Height="18" Cursor="Hand"
                                                                ToolTip="Delete image file from disk">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{StaticResource DangerBrush}" CornerRadius="9" Opacity="0.9">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Column separator -->
                    <Border Grid.Column="1" Background="#E5E7EB" Margin="0,10,0,10"/>

                    <!-- RIGHT COLUMN: Result -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,12,12,12">
                        <StackPanel>

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="420" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Ideogram.ResultImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding Ideogram.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here" FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding Ideogram.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding Ideogram.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding Ideogram.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PlayerTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Ideogram.LogOutput}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}" Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0" FontFamily="Consolas"
                                             FontSize="11" Padding="4" Height="200"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>

            <!-- ===== QWEN EDIT: character replacement in a scene ===== -->
            <TabItem Header="🧑‍🤝‍🧑 Qwen Edit" Visibility="{Binding IsEditGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">

                            <!-- Pipeline badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🧑‍🤝‍🧑 Qwen Image Edit — Character Swap" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#BE185D"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource AccentRoseBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                                        Upload Character 1, Character 2 and a Base scene (always one man + one woman).
                                        Character 1 replaces the man, Character 2 replaces the woman. Click Analyze to
                                        let the VLM write the edit prompt, then edit it and click Generate.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Character 1 -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Character 1 → replaces the MAN" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding QwenEdit.Char1ImagePath, FallbackValue='No image selected'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Character 1"
                                            Command="{Binding QwenEdit.BrowseChar1Command}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="170" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding QwenEdit.Char1ImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding QwenEdit.NoChar1Image, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="👨" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Character 1 (man)" FontSize="12" Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Character 2 -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Character 2 → replaces the WOMAN" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding QwenEdit.Char2ImagePath, FallbackValue='No image selected'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Character 2"
                                            Command="{Binding QwenEdit.BrowseChar2Command}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="170" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding QwenEdit.Char2ImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding QwenEdit.NoChar2Image, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="👩" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Character 2 (woman)" FontSize="12" Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Base scene -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Base Scene (man + woman to replace)" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding QwenEdit.BaseImagePath, FallbackValue='No image selected'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="📂 Browse Image"
                                                Command="{Binding QwenEdit.BrowseBaseCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="📹 Upload Video"
                                                Command="{Binding QwenEdit.BrowseBaseVideoCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="4,0,0,0"/>
                                    </Grid>

                                    <!-- Image preview (shown when no video is loaded) -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="200" ClipToBounds="True"
                                            Visibility="{Binding QwenEdit.NoBaseVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Image Source="{Binding QwenEdit.BaseImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding QwenEdit.NoBaseImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Base scene with a man and a woman" FontSize="12" Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Video scrub + snap (shown when a video is loaded) -->
                                    <StackPanel Visibility="{Binding QwenEdit.HasBaseVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                Background="{StaticResource PlayerSurfaceBrush}" Height="200" ClipToBounds="True">
                                            <MediaElement x:Name="QwenBaseVideoPlayer"
                                                          Source="{Binding QwenEdit.BaseVideoFileUri}"
                                                          LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                          ScrubbingEnabled="True" Stretch="Uniform"
                                                          MediaOpened="QwenBaseVideoPlayer_MediaOpened"
                                                          MediaEnded="QwenBaseVideoPlayer_MediaEnded"/>
                                        </Border>
                                        <Slider x:Name="QwenBaseScrubSlider" Margin="0,6,0,0"
                                                Minimum="0" Maximum="1" SmallChange="0.04" LargeChange="0.5"
                                                IsMoveToPointEnabled="True"
                                                Thumb.DragStarted="QwenBaseScrub_DragStarted"
                                                Thumb.DragCompleted="QwenBaseScrub_DragCompleted"
                                                PreviewMouseLeftButtonUp="QwenBaseScrub_Click"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="▶" Click="QwenBasePlay_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                            <Button Grid.Column="1" Content="⏸" Click="QwenBasePause_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                            <Button Grid.Column="3" Content="📸 Snap &amp; Send"
                                                    Click="QwenBaseSnapAndSend_Click"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Background="{StaticResource BrandBrush}" Padding="14,6" FontSize="12"/>
                                        </Grid>
                                        <TextBlock Text="Scrub to a frame, then Snap &amp; Send to set it as the base scene."
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Step 1: Analyze -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 1 — Analyze (VLM writes the edit prompt)" Style="{StaticResource HeaderTextStyle}"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding QwenEdit.AvailableModels}"
                                                  SelectedItem="{Binding QwenEdit.SelectedLlmModel}"
                                                  FontSize="11" Padding="6,4" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="🔄"
                                                Command="{Binding QwenEdit.LoadModelsCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4" FontSize="12" Margin="6,0,0,0"/>
                                    </Grid>
                                    <Button Content="🔍 Analyze 3 Images → Edit Prompt"
                                            Command="{Binding QwenEdit.AnalyzeCommand}"
                                            IsEnabled="{Binding QwenEdit.CanAnalyze}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource SuccessBrush}" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding QwenEdit.IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="⏳ " FontSize="13"/>
                                        <TextBlock Text="{Binding QwenEdit.StatusMessage}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Step 2: Edit prompt -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 2 — Edit Prompt" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding QwenEdit.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             MinLines="5" MaxLines="12"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="12" Padding="8"/>
                                </StackPanel>
                            </Border>

                            <!-- Step 3: Generate -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 3 — Generate" Style="{StaticResource HeaderTextStyle}"/>

                                    <!-- Workflow selector: Qwen Edit (default) or Klein (Flux.2) -->
                                    <TextBlock Text="Workflow" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding QwenEdit.WorkflowOptions}"
                                              SelectedItem="{Binding QwenEdit.SelectedWorkflow}"
                                              FontSize="12" Padding="6,4" VerticalContentAlignment="Center"
                                              Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding QwenEdit.GenerateDescription}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Button Content="🚀 Generate"
                                            Command="{Binding QwenEdit.GenerateCommand}"
                                            IsEnabled="{Binding QwenEdit.CanGenerate}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding QwenEdit.StatusMessage}"
                                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding QwenEdit.Progress}" Maximum="100" Height="6"
                                                     Margin="0,4,0,0" Background="#E5E7EB" Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- RIGHT: result + log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="460" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding QwenEdit.ResultImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding QwenEdit.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here" FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding QwenEdit.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding QwenEdit.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding QwenEdit.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                    <Button Content="✨ Enhance (Klein img2img)"
                                            Command="{Binding QwenEdit.EnhanceCommand}"
                                            IsEnabled="{Binding QwenEdit.CanEnhance}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}" Padding="14,9" FontSize="12"
                                            HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Refines the current result with a Flux.2 Klein img2img pass."/>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PlayerTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding QwenEdit.LogOutput}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}" Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0" FontFamily="Consolas"
                                             FontSize="11" Padding="4" Height="220"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>

            <TabItem Header="♻️ Restore" Visibility="{Binding IsEditGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">

                            <!-- Pipeline badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="#A5F3FC" BorderThickness="1" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="♻️ Image Restoration — Flux.2 Klein" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#0E7490"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                                        Upload an image to restore. It is upscaled to the target megapixels, re-rendered with
                                        Flux.2 Klein, realigned (Pixel Drift Fix) and blended back over the original. Lower
                                        blend = more restoration; higher blend = closer to the original.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Source image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Image to Restore" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding Restore.SourceImagePath, FallbackValue='No image selected'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Image"
                                            Command="{Binding Restore.BrowseSourceImageCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="220" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Restore.SourceImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding Restore.NoSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Image to restore" FontSize="12" Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Guidance prompt -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Guidance Prompt" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding Restore.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             MinLines="3" MaxLines="8"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="12" Padding="8"/>
                                </StackPanel>
                            </Border>

                            <!-- Settings -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Settings" Style="{StaticResource HeaderTextStyle}"/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Original blend" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Restore.BlendFactorText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                            Value="{Binding Restore.BlendFactor}"
                                            IsMoveToPointEnabled="True" Margin="0,2,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Target resolution" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Restore.MegapixelsText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                    <Slider Minimum="0.5" Maximum="4" SmallChange="0.5" LargeChange="1"
                                            Value="{Binding Restore.Megapixels}"
                                            IsMoveToPointEnabled="True" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Generate -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Restore" Style="{StaticResource HeaderTextStyle}"/>
                                    <Button Content="🚀 Restore Image"
                                            Command="{Binding Restore.GenerateCommand}"
                                            IsEnabled="{Binding Restore.CanGenerate}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Restore.StatusMessage}"
                                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding Restore.Progress}" Maximum="100" Height="6"
                                                     Margin="0,4,0,0" Background="#E5E7EB" Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- RIGHT: result + log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="460" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Restore.ResultImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding Restore.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here" FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding Restore.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding Restore.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding Restore.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PlayerTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Restore.LogOutput}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}" Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0" FontFamily="Consolas"
                                             FontSize="11" Padding="4" Height="220"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>

            <TabItem Header="🔍 Image Upscaler" Visibility="{Binding IsEditGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">

                            <!-- Pipeline badge -->
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🔍 Tiled Upscaling — SeedVR2" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentIndigoBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                                        The picture is cut into overlapping tiles, each tile is upscaled by the SeedVR2
                                        diffusion transformer, and the tiles are blended back together. Peak VRAM is set by
                                        the tile size rather than the output size, so 4K and beyond stays reachable.
                                        Upscale one image, or point at a folder and run the whole thing.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Mode" Style="{StaticResource HeaderTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <RadioButton Content="🖼️ Single Image" GroupName="UpscalerMode"
                                                     Style="{StaticResource ToggleRadioStyle}"
                                                     IsChecked="{Binding ImageUpscaler.IsSingleMode}"
                                                     Margin="0,0,8,0"/>
                                        <RadioButton Content="📁 Batch Folder" GroupName="UpscalerMode"
                                                     Style="{StaticResource ToggleRadioStyle}"
                                                     IsChecked="{Binding ImageUpscaler.IsBatchMode}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Single-image source -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12"
                                    Visibility="{Binding ImageUpscaler.IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Image to Upscale" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding ImageUpscaler.SourceImagePath, FallbackValue='No image selected'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Image"
                                            Command="{Binding ImageUpscaler.BrowseSourceImageCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,0,8"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="200" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ImageUpscaler.SourceImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding ImageUpscaler.NoSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Image to upscale" FontSize="12" Foreground="{StaticResource PlayerTextBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Batch source -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12"
                                    Visibility="{Binding ImageUpscaler.IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Folder to Upscale" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding ImageUpscaler.BatchFolderPath, FallbackValue='No folder selected'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="📂 Browse Folder"
                                                Command="{Binding ImageUpscaler.BrowseBatchFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🔄 Rescan"
                                                Command="{Binding ImageUpscaler.RescanBatchFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource NeutralBrush}" Padding="12,8" FontSize="12"/>
                                    </StackPanel>

                                    <CheckBox Content="Include subfolders (output mirrors the tree)"
                                              IsChecked="{Binding ImageUpscaler.IncludeSubfolders}"
                                              FontSize="12" Margin="0,0,0,4"/>
                                    <CheckBox Content="Skip images that already have a result"
                                              IsChecked="{Binding ImageUpscaler.SkipExisting}"
                                              FontSize="12" Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding ImageUpscaler.BatchSummary}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentIndigoBrush}" Margin="0,0,0,6"/>

                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource SurfaceBrush}" Height="180">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,4">
                                            <ItemsControl ItemsSource="{Binding ImageUpscaler.BatchItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontSize="11" Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="10"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       MaxWidth="150" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Output folder -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Output Folder" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding ImageUpscaler.EffectiveOutputFolder}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <Button Content="📁 Choose Output Folder"
                                            Command="{Binding ImageUpscaler.BrowseOutputFolderCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource NeutralBrush}" Padding="12,8" FontSize="12"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- Model + target -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Model &amp; Target" Style="{StaticResource HeaderTextStyle}"/>

                                    <TextBlock Text="SeedVR2 model" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,2"/>
                                    <ComboBox ItemsSource="{Binding ImageUpscaler.DitModels}"
                                              SelectedItem="{Binding ImageUpscaler.SelectedDitModel}"
                                              FontSize="11" Padding="6,4" Margin="0,0,0,4"/>
                                    <TextBlock Text="3B is fast; 7B is sharper but much heavier. Models download on first use."
                                               Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Target resolution" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ImageUpscaler.NewResolutionText}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}"/>
                                    </Grid>
                                    <Slider Minimum="512" Maximum="8192" SmallChange="64" LargeChange="256"
                                            Value="{Binding ImageUpscaler.NewResolution}"
                                            IsMoveToPointEnabled="True" Margin="0,2,0,8"/>

                                    <TextBlock Text="Which side that applies to" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding ImageUpscaler.ResolutionTargets}"
                                              SelectedItem="{Binding ImageUpscaler.ResolutionTarget}"
                                              FontSize="11" Padding="6,4" Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Seed" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ImageUpscaler.Seed, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" Padding="6,4"
                                                 ToolTip="The seed the last run used. Untick Randomize to reuse it."/>
                                        <CheckBox Grid.Column="2" Content="Randomize"
                                                  IsChecked="{Binding ImageUpscaler.RandomizeSeed}"
                                                  FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Tiling -->
                            <Expander Header="Tiling" IsExpanded="False" Margin="0,0,0,10" FontSize="12" FontWeight="SemiBold">
                                <Border Style="{StaticResource SectionPanelStyle}" Padding="12" Margin="0,4,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tile size" FontSize="12" FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ImageUpscaler.TileSizeText}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="128" Maximum="2048" SmallChange="64" LargeChange="128"
                                                Value="{Binding ImageUpscaler.TileWidth}"
                                                IsMoveToPointEnabled="True" Margin="0,2,0,2"/>
                                        <Slider Minimum="128" Maximum="2048" SmallChange="64" LargeChange="128"
                                                Value="{Binding ImageUpscaler.TileHeight}"
                                                IsMoveToPointEnabled="True" Margin="0,0,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tile overlap" FontSize="12" FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ImageUpscaler.TilePaddingText}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="256" SmallChange="8" LargeChange="16"
                                                Value="{Binding ImageUpscaler.TilePadding}"
                                                IsMoveToPointEnabled="True" Margin="0,2,0,2"/>
                                        <TextBlock Text="More overlap hides seams but costs time. 32–64 is the usual range."
                                                   Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Per-tile resolution cap" FontSize="12" FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ImageUpscaler.TileUpscaleResolutionText}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="256" Maximum="4096" SmallChange="64" LargeChange="256"
                                                Value="{Binding ImageUpscaler.TileUpscaleResolution}"
                                                IsMoveToPointEnabled="True" Margin="0,2,0,2"/>
                                        <TextBlock Text="The real VRAM dial. Drop this first if a run hits out-of-memory."
                                                   Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"/>

                                        <TextBlock Text="Tile order" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding ImageUpscaler.TilingStrategies}"
                                                  SelectedItem="{Binding ImageUpscaler.TilingStrategy}"
                                                  FontSize="11" Padding="6,4" Margin="0,0,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tiles per call" FontSize="12" FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ImageUpscaler.TileBatchSizeText}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="1" Maximum="21" SmallChange="4" LargeChange="4" TickFrequency="4"
                                                Value="{Binding ImageUpscaler.TileBatchSize}"
                                                IsMoveToPointEnabled="True" Margin="0,2,0,2"/>
                                        <TextBlock Text="Faster, but VRAM scales with it. Snapped to SeedVR2's 1/5/9/13/17/21."
                                                   Style="{StaticResource HintTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <!-- Blending & colour -->
                            <Expander Header="Blending &amp; Colour" IsExpanded="False" Margin="0,0,0,10" FontSize="12" FontWeight="SemiBold">
                                <Border Style="{StaticResource SectionPanelStyle}" Padding="12" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Blending method" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding ImageUpscaler.BlendingMethods}"
                                                  SelectedItem="{Binding ImageUpscaler.BlendingMethod}"
                                                  FontSize="11" Padding="6,4" Margin="0,0,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Seam blur" FontSize="12" FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ImageUpscaler.MaskBlurText}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="16" SmallChange="1" LargeChange="2"
                                                Value="{Binding ImageUpscaler.MaskBlur}"
                                                IsMoveToPointEnabled="True" Margin="0,2,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Anti-aliasing" FontSize="12" FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ImageUpscaler.AntiAliasingStrengthText}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="0.5" SmallChange="0.05" LargeChange="0.1"
                                                Value="{Binding ImageUpscaler.AntiAliasingStrength}"
                                                IsMoveToPointEnabled="True" Margin="0,2,0,8"/>

                                        <TextBlock Text="Colour correction" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding ImageUpscaler.ColorCorrections}"
                                                  SelectedItem="{Binding ImageUpscaler.ColorCorrection}"
                                                  FontSize="11" Padding="6,4"/>
                                        <TextBlock Text="Matches the upscale back to the original's colours. 'lab' is the safe default."
                                                   Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <!-- VRAM -->
                            <Expander Header="VRAM" IsExpanded="False" Margin="0,0,0,10" FontSize="12" FontWeight="SemiBold">
                                <Border Style="{StaticResource SectionPanelStyle}" Padding="12" Margin="0,4,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Block swap" FontSize="12" FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ImageUpscaler.BlocksToSwapText}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="36" SmallChange="1" LargeChange="4"
                                                Value="{Binding ImageUpscaler.BlocksToSwap}"
                                                IsMoveToPointEnabled="True" Margin="0,2,0,2"/>
                                        <TextBlock Text="Parks transformer blocks in system RAM. Slower, but it rescues a run that won't fit."
                                                   Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"/>

                                        <CheckBox Content="Tiled VAE encode/decode"
                                                  IsChecked="{Binding ImageUpscaler.TiledVae}"
                                                  FontSize="12" FontWeight="Normal" Margin="0,0,0,4"/>
                                        <CheckBox Content="Keep the model loaded between images"
                                                  IsChecked="{Binding ImageUpscaler.KeepModelLoaded}"
                                                  FontSize="12" FontWeight="Normal"/>
                                        <TextBlock Text="Keeping it loaded saves a reload per image — worth a lot across a batch."
                                                   Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <!-- Run -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Upscale" Style="{StaticResource HeaderTextStyle}"/>
                                    <Button Content="{Binding ImageUpscaler.GenerateButtonText}"
                                            Command="{Binding ImageUpscaler.GenerateCommand}"
                                            IsEnabled="{Binding ImageUpscaler.CanGenerate}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="{StaticResource AccentIndigoBrush}" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <Button Content="✖ Cancel"
                                            Command="{Binding ImageUpscaler.CancelCommand}"
                                            IsEnabled="{Binding ImageUpscaler.IsBusy}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Background="{StaticResource DangerBrush}" Padding="12,8" FontSize="12"
                                            HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding ImageUpscaler.StatusMessage}"
                                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding ImageUpscaler.Progress}" Maximum="100" Height="6"
                                                     Margin="0,4,0,0" Background="#E5E7EB" Foreground="{StaticResource AccentIndigoBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- RIGHT: result + log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{StaticResource PlayerSurfaceBrush}" Height="460" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ImageUpscaler.ResultImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding ImageUpscaler.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="The upscaled image will appear here" FontSize="14"
                                                           Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding ImageUpscaler.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding ImageUpscaler.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource BrandBrush}" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding ImageUpscaler.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="{StaticResource SuccessBrush}" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PlayerTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ImageUpscaler.LogOutput}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{StaticResource PlayerSurfaceBrush}" Foreground="{StaticResource PlayerTextBrush}"
                                             BorderThickness="0" FontFamily="Consolas"
                                             FontSize="11" Padding="4" Height="220"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
