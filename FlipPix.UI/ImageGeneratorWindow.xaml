                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="#8B5CF6"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Denoise -->
                                <StackPanel Grid.Column="2" Grid.Row="0">
                                    <TextBlock Text="Denoise"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding StoryGeneratorQ.Denoise, Mode=TwoWay}"
                                               Minimum="0" Maximum="1"
                                               TickFrequency="0.05"
                                               IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.Denoise, StringFormat={}{0:F2}}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="#8B5CF6"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Negative Prompt -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="0,15,0,0">
                                    <TextBlock Text="Negative Prompt"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
