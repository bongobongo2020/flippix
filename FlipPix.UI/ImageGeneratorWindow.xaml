<Window x:Class="FlipPix.UI.ImageGeneratorWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlipPix.UI.ViewModels"
        mc:Ignorable="d"
        Title="FlipPix - Image Generator" Height="950" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="650" MinWidth="850"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="AnalyzeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Radio Button Style for Input Mode -->
        <Style x:Key="ToggleRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DEE2E6"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#6366F1"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Queue Flash Animation -->
        <Storyboard x:Key="QueueFlashAnimation">
            <ColorAnimation Storyboard.TargetName="AnalyzerQueueBorder"
                          Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                          From="#28A745" To="#DEE2E6" Duration="0:0:1"/>
        </Storyboard>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6B35" Offset="0"/>
                    <GradientStop Color="#F7931E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title Section -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Image Generator"
                              FontSize="28" FontWeight="Bold"
                              Foreground="White"/>
                    <TextBlock Text="Generate images from text descriptions using AI"
                              FontSize="13" Foreground="#FFFAF0"
                              Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Settings Button -->
                <Button Grid.Column="1"
                        Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10"
                        Cursor="Hand"
                        ToolTip="Open Settings"
                        Margin="20,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="⚙️" FontSize="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="#E9ECEF" BorderBrush="#DEE2E6" BorderThickness="0,1,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Navigate:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#495057"/>
                <Button Content="🎬 Video Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToVideoGeneratorCommand}" Background="#6366F1"/>
                <Button Content="✨ Enhance Video" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToEnhanceVideoCommand}" Background="#1565C0"/>
                <Button Content="📷 Camera Edit" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToCameraEditCommand}" Background="#10B981"/>
            </StackPanel>
        </Border>

        <!-- Main Content with Tabbed Interface -->
        <TabControl Grid.Row="2" Margin="15,10,15,10" Background="Transparent"
                   SelectedIndex="{Binding SelectedTabIndex}">

            <!-- Tab 1: Image Generator (Merged Text Generation + Image Analysis) -->
            <TabItem Header="🎨 Image Generator" FontWeight="Bold" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15,12,15,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="52*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN - Input & Settings -->
                        <StackPanel Grid.Column="0">

                            <!-- Section A: Input Mode Toggle -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Input Mode" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>

                                    <!-- Input Mode Toggle -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton Content="Text Prompt"
                                                   IsChecked="{Binding Analyzer.IsTextPromptMode, Mode=OneWay}"
                                                   GroupName="InputMode"
                                                   Style="{StaticResource ToggleRadioStyle}"
                                                   Margin="0,0,5,0"/>
                                        <RadioButton Content="Image Analysis"
                                                   IsChecked="{Binding Analyzer.IsImageAnalysisMode}"
                                                   GroupName="InputMode"
                                                   Style="{StaticResource ToggleRadioStyle}"
                                                   Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <!-- Text Prompt Section (visible only in Text Prompt mode) -->
                                    <StackPanel Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <!-- Saved Prompts Section -->
                                        <Border Background="#FFF8DC" BorderBrush="#DEB887" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="📝 Saved Prompts" FontWeight="Bold" FontSize="13" Foreground="#8B4513" Margin="0,0,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Select a saved prompt or save current:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="💾 Save" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding SavePromptCommand}" Padding="10,5" Margin="5,0,5,0"
                                                            ToolTip="Save current prompt settings"
                                                            Background="#4CAF50"/>
                                                    <Button Grid.Column="2" Content="🗑️ Delete" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DeletePromptCommand}" Padding="10,5" Margin="0,0,0,0"
                                                            ToolTip="Delete selected saved prompt"
                                                            Background="#F44336"/>
                                                </Grid>

                                                <ComboBox ItemsSource="{Binding SavedPrompts}"
                                                          SelectedItem="{Binding SelectedSavedPrompt, Mode=TwoWay}"
                                                          SelectedValuePath="Id"
                                                          Padding="10"
                                                          Background="White"
                                                          BorderBrush="#CED4DA"
                                                          FontSize="12"
                                                          Margin="0,5,0,10"
                                                          Height="40">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}"
                                                                           FontSize="10" Foreground="#666"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ImagePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="100"
                                                Padding="10"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="12"/>

                                        <!-- Validation hint -->
                                        <TextBlock Text="Enter a prompt to enable generation"
                                                   FontSize="10"
                                                   Foreground="#DC3545"
                                                   Margin="0,4,0,0"
                                                   FontStyle="Italic">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanGenerate}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="Example prompts:" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,5"/>
                                        <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,3">
                                            <Run Text="• "/>
                                            <Run Text="Latina female with thick wavy hair, harbor boats and pastel houses behind."/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,3">
                                            <Run Text="• "/>
                                            <Run Text="A majestic mountain landscape at sunset with dramatic clouds and golden light"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,0">
                                            <Run Text="• "/>
                                            <Run Text="Portrait of a cyberpunk character with neon lights reflecting on metallic surfaces"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Image Analysis Section (visible only in Image Analysis mode) -->
                                    <StackPanel Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Upload an image to analyze"
                                                   FontSize="11"
                                                   Foreground="#666"
                                                   Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                    Text="{Binding Analyzer.SourceImagePath, Mode=TwoWay}"
                                                    IsReadOnly="True"
                                                    Padding="8"
                                                    Background="White"
                                                    BorderBrush="#CED4DA"
                                                    VerticalContentAlignment="Center"
                                                    FontSize="11"
                                                    Height="30"/>

                                            <Button Grid.Column="1"
                                                   Content="Browse"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Command="{Binding Analyzer.BrowseImageCommand}"
                                                   Margin="6,0,0,0"
                                                   Height="30"
                                                   Padding="12,6"/>
                                        </Grid>

                                        <!-- Image Preview -->
                                        <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                                Background="White" Height="160"
                                                CornerRadius="5" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="No image selected"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999"
                                                          FontStyle="Italic"
                                                          FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Analyzer.HasSourceImage}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Image Source="{Binding Analyzer.SourceImageSource}"
                                                       Stretch="Uniform"
                                                       Margin="5"
                                                       Visibility="{Binding Analyzer.HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Analyze Button -->
                                        <Button Content="Analyze Image with QwenVL"
                                               Style="{StaticResource AnalyzeButtonStyle}"
                                               Command="{Binding Analyzer.AnalyzeImageCommand}"
                                               HorizontalAlignment="Stretch"
                                               Height="38"
                                               Margin="0,0,0,8"/>

                                        <!-- Processing Status for Analysis -->
                                        <Border Background="#FEF3C7"
                                                BorderBrush="#FCD34D"
                                                BorderThickness="2"
                                                CornerRadius="6"
                                                Padding="12"
                                                Visibility="{Binding Analyzer.IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="Analyzing image..."
                                                          FontWeight="Bold"
                                                          FontSize="11"
                                                          Margin="0,0,0,6"
                                                          TextAlignment="Center"
                                                          Foreground="#92400E"/>
                                                <ProgressBar IsIndeterminate="True"
                                                            Height="18"
                                                            Foreground="#F59E0B"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Saved Prompts Section -->
                                        <Border Background="#FFF8DC" BorderBrush="#DEB887" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,10">
                                            <StackPanel>
                                                <TextBlock Text="&#x1F4DD; Saved Prompts" FontWeight="Bold" FontSize="13" Foreground="#8B4513" Margin="0,0,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Select a saved prompt or save current:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="&#x1F4BE; Save" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding Analyzer.SavePromptCommand}" Padding="10,5" Margin="5,0,5,0"
                                                            ToolTip="Save current prompt settings"
                                                            Background="#4CAF50"/>
                                                    <Button Grid.Column="2" Content="&#x1F5D1;&#xFE0F; Delete" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding Analyzer.DeletePromptCommand}" Padding="10,5" Margin="0,0,0,0"
                                                            ToolTip="Delete selected saved prompt"
                                                            Background="#F44336"/>
                                                </Grid>

                                                <ComboBox ItemsSource="{Binding Analyzer.SavedPrompts}"
                                                          SelectedItem="{Binding Analyzer.SelectedSavedPrompt, Mode=TwoWay}"
                                                          SelectedValuePath="Id"
                                                          Padding="10"
                                                          Background="White"
                                                          BorderBrush="#CED4DA"
                                                          FontSize="12"
                                                          Margin="0,5,0,10"
                                                          Height="40">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}"
                                                                           FontSize="10" Foreground="#666"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding Analyzer.AnalysisText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                Height="80"
                                                Padding="10"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="White"
                                                BorderBrush="#CED4DA"
                                                FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section B: Text Prompt Settings (visible only in Text Prompt mode) -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Generation Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>

                                    <!-- Workflow Selection -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Model Workflow" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox SelectedIndex="{Binding SelectedWorkflow, Mode=TwoWay}"
                                                 Padding="8"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="11"
                                                 Height="32">
                                            <ComboBoxItem Content="Zimage (with LoRA support)"/>
                                            <ComboBoxItem Content="Qwen 2512"/>
                                            <ComboBoxItem Content="Klien (Flux2)"/>
                                            <ComboBoxItem Content="Anima"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Style Preset (only visible for Zimage) -->
                                    <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowStyleOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Style Preset" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox SelectedIndex="{Binding SelectedStyleIndex, Mode=TwoWay}"
                                                 ItemsSource="{Binding StyleNames}"
                                                 Padding="8"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="11"
                                                 Height="32"/>
                                    </StackPanel>

                                    <!-- LoRA -->
                                    <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowLoraOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <CheckBox Content="Enable LoRA"
                                                 IsChecked="{Binding LoraEnabled, Mode=TwoWay}"
                                                 FontWeight="SemiBold"
                                                 FontSize="11"
                                                 Margin="0,0,0,6"/>
                                        <Grid Visibility="{Binding LoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                     ItemsSource="{Binding AvailableLoras}"
                                                     SelectedItem="{Binding SelectedLora, Mode=TwoWay}"
                                                     Padding="8"
                                                     Background="White"
                                                     BorderBrush="#CED4DA"
                                                     FontSize="11"
                                                     Height="32"
                                                     Margin="0,0,6,0"/>
                                            <Button Grid.Column="1"
                                                   Content="Refresh"
                                                   Command="{Binding RefreshLorasCommand}"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Width="60"
                                                   Height="32"
                                                   Padding="10,5"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Aspect Ratio -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox SelectedIndex="{Binding AspectRatioIndex, Mode=TwoWay}"
                                                 Padding="8"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="11"
                                                 Height="30">
                                            <ComboBoxItem Content="Landscape"/>
                                            <ComboBoxItem Content="Portrait"/>
                                            <ComboBoxItem Content="Square"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Actions" Style="{StaticResource HeaderTextStyle}" Foreground="#FF6B35"/>
                                        <Button Content="Generate Image"
                                               Style="{StaticResource PrimaryButtonStyle}"
                                               Command="{Binding GenerateImageCommand}"
                                               HorizontalAlignment="Stretch"
                                               Height="42"
                                               FontSize="14"
                                               Margin="0,0,0,8"
                                               ToolTip="Enter a prompt to generate an image"/>
                                        <Button Content="Add to Queue"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding AddToQueueCommand}"
                                               HorizontalAlignment="Stretch"
                                               Height="38"
                                               FontSize="13"
                                               Margin="0,0,0,8"
                                               ToolTip="Enter a prompt to add to queue"/>
                                    </StackPanel>

                                    <!-- Advanced Settings Expander -->
                                    <Expander Header="⚙️ Advanced Settings" Margin="0,0,0,0" IsExpanded="False"
                                              Visibility="{Binding ShowSamplerSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Margin="0,10,0,0">
                                            <!-- Steps -->
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0"
                                                            Value="{Binding Steps, Mode=TwoWay}"
                                                            Minimum="4" Maximum="20"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Height="20"/>
                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding Steps}"
                                                              Margin="8,0,0,0"
                                                              VerticalAlignment="Center"
                                                              MinWidth="25"
                                                              FontWeight="Bold"
                                                              FontSize="11"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- CFG -->
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0"
                                                            Value="{Binding Cfg, Mode=TwoWay}"
                                                            Minimum="1" Maximum="3"
                                                            TickFrequency="0.5"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Height="20"/>
                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding Cfg, StringFormat={}{0:F1}}"
                                                              Margin="8,0,0,0"
                                                              VerticalAlignment="Center"
                                                              MinWidth="25"
                                                              FontWeight="Bold"
                                                              FontSize="11"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Section B2: Image Analysis Settings (visible only in Image Analysis mode) -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Generation Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>

                                    <!-- Workflow Selection -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Model Workflow" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox SelectedIndex="{Binding Analyzer.SelectedWorkflow, Mode=TwoWay}"
                                                 Padding="8"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="11"
                                                 Height="32">
                                            <ComboBoxItem Content="Zimage (with LoRA support)"/>
                                            <ComboBoxItem Content="Qwen 2512"/>
                                            <ComboBoxItem Content="Klien (Flux2)"/>
                                            <ComboBoxItem Content="Anima"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Style Preset (only visible for Zimage) -->
                                    <StackPanel Margin="0,0,0,12" Visibility="{Binding Analyzer.ShowStyleOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Style Preset" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox SelectedIndex="{Binding Analyzer.SelectedStyleIndex, Mode=TwoWay}"
                                                 ItemsSource="{Binding Analyzer.StyleNames}"
                                                 Padding="8"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="11"
                                                 Height="32"/>
                                    </StackPanel>

                                    <!-- LoRA -->
                                    <StackPanel Margin="0,0,0,12" Visibility="{Binding Analyzer.ShowLoraOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <CheckBox Content="Enable LoRA"
                                                 IsChecked="{Binding Analyzer.LoraEnabled, Mode=TwoWay}"
                                                 FontWeight="SemiBold"
                                                 FontSize="11"
                                                 Margin="0,0,0,6"/>
                                        <Grid Visibility="{Binding Analyzer.LoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                     ItemsSource="{Binding Analyzer.AvailableLoras}"
                                                     SelectedItem="{Binding Analyzer.SelectedLora, Mode=TwoWay}"
                                                     Padding="8"
                                                     Background="White"
                                                     BorderBrush="#CED4DA"
                                                     FontSize="11"
                                                     Height="32"
                                                     Margin="0,0,6,0"/>
                                            <Button Grid.Column="1"
                                                   Content="Refresh"
                                                   Command="{Binding Analyzer.RefreshLorasCommand}"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Width="60"
                                                   Height="32"
                                                   Padding="10,5"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Aspect Ratio -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox SelectedIndex="{Binding Analyzer.AspectRatioIndex, Mode=TwoWay}"
                                                 Padding="8"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="11"
                                                 Height="30">
                                            <ComboBoxItem Content="Landscape"/>
                                            <ComboBoxItem Content="Portrait"/>
                                            <ComboBoxItem Content="Square"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Actions" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>
                                        <Button Content="Generate Image"
                                               Style="{StaticResource PrimaryButtonStyle}"
                                               Command="{Binding Analyzer.AddToQueueAndStartCommand}"
                                               HorizontalAlignment="Stretch"
                                               Height="42"
                                               FontSize="14"
                                               Margin="0,0,0,8"
                                               Background="#6366F1"/>
                                        <Button Content="Add to Queue"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding Analyzer.AddToQueueCommand}"
                                               HorizontalAlignment="Stretch"
                                               Height="38"
                                               FontSize="13"
                                               Margin="0,0,0,8"/>
                                    </StackPanel>

                                    <!-- Advanced Settings Expander -->
                                    <Expander Header="⚙️ Advanced Settings" Margin="0,0,0,0" IsExpanded="False"
                                              Visibility="{Binding Analyzer.ShowSamplerSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Margin="0,10,0,0">
                                            <!-- Steps -->
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0"
                                                            Value="{Binding Analyzer.Steps, Mode=TwoWay}"
                                                            Minimum="4" Maximum="20"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Height="20"/>
                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding Analyzer.Steps}"
                                                              Margin="8,0,0,0"
                                                              VerticalAlignment="Center"
                                                              MinWidth="25"
                                                              FontWeight="Bold"
                                                              FontSize="11"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- CFG -->
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0"
                                                            Value="{Binding Analyzer.Cfg, Mode=TwoWay}"
                                                            Minimum="1" Maximum="3"
                                                            TickFrequency="0.5"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Height="20"/>
                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding Analyzer.Cfg, StringFormat={}{0:F1}}"
                                                              Margin="8,0,0,0"
                                                              VerticalAlignment="Center"
                                                              MinWidth="25"
                                                              FontWeight="Bold"
                                                              FontSize="11"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- LM Studio Connection (Image Analysis mode only) -->
                            <Expander Header="🔌 LM Studio Connection"
                                     Margin="0,0,0,10"
                                     IsExpanded="False"
                                     Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="LM Studio Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Server" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Analyzer.LMStudioServer, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="8"
                                                         Background="White"
                                                         BorderBrush="#CED4DA"
                                                         FontSize="11"
                                                         Height="30"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Port" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Analyzer.LMStudioPort, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="8"
                                                         Background="White"
                                                         BorderBrush="#CED4DA"
                                                         FontSize="11"
                                                         Height="30"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="" Height="15" Margin="0,0,0,4"/>
                                                <Button Content="Test"
                                                       Command="{Binding Analyzer.TestLMStudioConnectionCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="50"
                                                       Height="30"
                                                       Padding="10,5"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="AI Model" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding Analyzer.AvailableModels}"
                                                          SelectedValue="{Binding Analyzer.SelectedModel}"
                                                          SelectedValuePath="Name"
                                                          Padding="8"
                                                          Background="White"
                                                          BorderBrush="#CED4DA"
                                                          FontSize="11"
                                                          Height="30">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="" Height="15" Margin="0,0,0,4"/>
                                                <Button Content="Refresh"
                                                       Command="{Binding Analyzer.RefreshModelsCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="65"
                                                       Height="30"
                                                       Padding="10,5"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </StackPanel>

                        <!-- RIGHT COLUMN - Queue & Results -->
                        <StackPanel Grid.Column="2">

                            <!-- Queue Status Bar - Text Prompt Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Status" Style="{StaticResource HeaderTextStyle}" Foreground="#EC4899"/>

                                    <!-- Start Queue Button (visible when not processing) -->
                                    <Button Content="▶ Start Queue"
                                           Command="{Binding ProcessQueueCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="36"
                                           FontSize="12"
                                           Margin="0,0,0,8"
                                           ToolTip="Start processing queued items">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Background" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProcessingQueue}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Processing Progress -->
                                    <Border Background="#FFF9F0"
                                            BorderBrush="#FFE0B0"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12"
                                            Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <!-- Waiting for lease status -->
                                            <TextBlock Text="⏳ Waiting for other workflows to finish..."
                                                      FontWeight="SemiBold"
                                                      FontSize="11"
                                                      Margin="0,0,0,5"
                                                      TextAlignment="Center"
                                                      Foreground="#F59E0B"
                                                      Visibility="{Binding IsWaitingForLease, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Processing status -->
                                            <TextBlock Text="Processing queue..."
                                                      FontWeight="SemiBold"
                                                      FontSize="11"
                                                      Margin="0,0,0,5"
                                                      TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWaitingForLease}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Pause/Resume/Cancel Buttons -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                       Content="⏸ Pause"
                                                       Command="{Binding PauseQueueCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Margin="0,0,5,0"/>

                                                <Button Grid.Column="1"
                                                       Content="▶ Resume"
                                                       Command="{Binding ResumeQueueCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Margin="5,0"/>

                                                <Button Grid.Column="2"
                                                       Content="✖ Cancel"
                                                       Command="{Binding CancelQueueCommand}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Background="#DC3545"
                                                       Foreground="White"
                                                       BorderThickness="0"
                                                       Margin="5,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#DC3545"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="8,4"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="5"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#E55563"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Queue Status Bar - Image Analysis Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Status" Style="{StaticResource HeaderTextStyle}" Foreground="#EC4899"/>

                                    <!-- Start Queue Button -->
                                    <Button Content="▶ Start Queue"
                                           Command="{Binding Analyzer.ProcessQueueCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="36"
                                           FontSize="12"
                                           Margin="0,0,0,8"
                                           ToolTip="Start processing queued items">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Background" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Analyzer.IsProcessingQueue}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Border Background="#F8F9FA"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                      Text="Queue:"
                                                      FontWeight="SemiBold"
                                                      VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding Analyzer.QueuedCount, StringFormat={}Queued: {0}}"
                                                      Margin="10,0"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"/>

                                            <TextBlock Grid.Column="2"
                                                      Text="{Binding Analyzer.CompletedCount, StringFormat={}Completed: {0}}"
                                                      Margin="10,0"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"
                                                      Foreground="#28A745"/>

                                            <TextBlock Grid.Column="3"
                                                      Text="{Binding Analyzer.FailedCount, StringFormat={}Failed: {0}}"
                                                      Margin="10,0"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"
                                                      Foreground="#DC3545"/>
                                        </Grid>
                                    </Border>

                                    <!-- Processing Progress -->
                                    <Border Background="#FFF9F0"
                                            BorderBrush="#FFE0B0"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding Analyzer.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <!-- Waiting for lease status -->
                                            <TextBlock Text="⏳ Waiting for other workflows to finish..."
                                                      FontWeight="SemiBold"
                                                      FontSize="11"
                                                      Margin="0,0,0,5"
                                                      TextAlignment="Center"
                                                      Foreground="#F59E0B"
                                                      Visibility="{Binding Analyzer.IsWaitingForLease, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Processing status -->
                                            <TextBlock Text="{Binding Analyzer.QueueProgressText, StringFormat={}Processing: {0}}"
                                                      FontWeight="SemiBold"
                                                      FontSize="11"
                                                      Margin="0,0,0,5"
                                                      TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Analyzer.IsWaitingForLease}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ProgressBar Value="{Binding Analyzer.QueueProgress, Mode=OneWay}"
                                                        Maximum="{Binding Analyzer.QueueTotal, Mode=OneWay}"
                                                        Height="16"
                                                        Foreground="#FF6B35"
                                                        Margin="0,0,0,5">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Analyzer.IsWaitingForLease}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>

                                            <!-- Pause/Resume/Cancel Buttons -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                       Content="⏸ Pause"
                                                       Command="{Binding Analyzer.PauseQueueCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Margin="0,0,5,0"/>

                                                <Button Grid.Column="1"
                                                       Content="▶ Resume"
                                                       Command="{Binding Analyzer.ResumeQueueCommand}"
                                                       Style="{StaticResource SecondaryButtonStyle}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Margin="5,0"/>

                                                <Button Grid.Column="2"
                                                       Content="✖ Cancel"
                                                       Command="{Binding Analyzer.CancelProcessingCommand}"
                                                       Width="70"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       Padding="8,4"
                                                       FontSize="11"
                                                       Background="#DC3545"
                                                       Foreground="White"
                                                       BorderThickness="0"
                                                       Margin="5,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#DC3545"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="8,4"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="5"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#E55563"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>

                                            <!-- Retry Failed Button -->
                                            <Button Content="🔄 Retry Failed"
                                                   Command="{Binding Analyzer.ReprocessAllFailedCommand}"
                                                   Style="{StaticResource SecondaryButtonStyle}"
                                                   Margin="0,8,0,0"
                                                   Height="28"
                                                   FontSize="11"
                                                   Background="#FFA500"
                                                   Padding="12,4"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Queue Items List - Text Prompt Mode -->
                            <Border BorderBrush="#DEE2E6"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Background="White"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Items" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1" Padding="15,15,15,0"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250" Padding="15">
                                        <ItemsControl ItemsSource="{Binding PromptQueue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E9ECEF"
                                                           BorderThickness="0,0,0,1"
                                                           Padding="12"
                                                           Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Workflow Badge -->
                                                            <Border Grid.Column="0"
                                                                    Background="{Binding WorkflowBadgeColor}"
                                                                    CornerRadius="4"
                                                                    Padding="6,4"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding WorkflowBadge}"
                                                                          FontWeight="Bold"
                                                                          FontSize="10"
                                                                          Foreground="White"/>
                                                            </Border>

                                                            <!-- Item Info -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DisplayPrompt}"
                                                                          FontWeight="SemiBold"
                                                                          FontSize="12"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          MaxWidth="300"/>

                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding StyleName}"
                                                                              FontSize="10"
                                                                              Foreground="#666"
                                                                              Visibility="{Binding StyleNameVisibility}"/>

                                                                    <TextBlock Text="{Binding AspectRatioDisplay}"
                                                                              FontSize="10"
                                                                              Foreground="#666"
                                                                              Margin="5,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Status / Thumbnail -->
                                                            <StackPanel Grid.Column="2"
                                                                       Orientation="Horizontal"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0">
                                                                <!-- Show status text when NOT completed -->
                                                                <TextBlock Text="{Binding StatusDisplay}"
                                                                          FontSize="11"
                                                                          FontWeight="Bold"
                                                                          Foreground="{Binding StatusColor}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <!-- Progress bar during processing -->
                                                                <ProgressBar Value="{Binding Progress}"
                                                                           Width="50"
                                                                           Height="12"
                                                                           Margin="5,0">
                                                                    <ProgressBar.Style>
                                                                        <Style TargetType="ProgressBar">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ProgressBar.Style>
                                                                </ProgressBar>

                                                                <!-- Clickable thumbnail when completed -->
                                                                <Button Command="{Binding OpenImageCommand}"
                                                                       Background="Transparent"
                                                                       BorderThickness="0"
                                                                       Cursor="Hand"
                                                                       ToolTip="Click to open image"
                                                                       Padding="0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Image Source="{Binding ThumbnailImage}"
                                                                          Height="50"
                                                                          Stretch="Uniform"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- Retry / Remove Buttons -->
                                                            <StackPanel Grid.Column="3"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Button Content="🔄"
                                                                       Command="{Binding DataContext.RetryQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}"
                                                                       Background="Transparent"
                                                                       BorderThickness="0"
                                                                       Padding="5"
                                                                       ToolTip="Retry failed item"
                                                                       FontSize="12"
                                                                       Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="❌"
                                                                       Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}"
                                                                       Background="Transparent"
                                                                       BorderThickness="0"
                                                                       Padding="5"
                                                                       ToolTip="Remove from queue"
                                                                       FontSize="12"
                                                                       Cursor="Hand"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Queue Items List - Image Analysis Mode -->
                            <Border x:Name="AnalyzerQueueBorder"
                                    BorderBrush="#DEE2E6"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Background="White"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Items" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1" Padding="15,15,15,0"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250" Padding="15">
                                        <ItemsControl ItemsSource="{Binding Analyzer.QueueItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E9ECEF"
                                                           BorderThickness="0,0,0,1"
                                                           Padding="12"
                                                           Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Workflow Badge -->
                                                            <Border Grid.Column="0"
                                                                    Background="{Binding WorkflowBadgeColor}"
                                                                    CornerRadius="4"
                                                                    Padding="6,4"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding WorkflowBadge}"
                                                                          FontWeight="Bold"
                                                                          FontSize="10"
                                                                          Foreground="White"/>
                                                            </Border>

                                                            <!-- Item Info -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DisplayPrompt}"
                                                                          FontWeight="SemiBold"
                                                                          FontSize="12"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          MaxWidth="300"/>

                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding StyleName}"
                                                                              FontSize="10"
                                                                              Foreground="#666"
                                                                              Visibility="{Binding StyleNameVisibility}"/>

                                                                    <TextBlock Text="{Binding AspectRatioDisplay}"
                                                                              FontSize="10"
                                                                              Foreground="#666"
                                                                              Margin="5,0,0,0"/>
                                                                </StackPanel>

                                                                <!-- Output Image Thumbnail -->
                                                                <Button Command="{Binding OpenImageCommand}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Padding="0"
                                                                        Margin="0,8,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        ToolTip="Click to open image">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasOutputImage}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Image Source="{Binding OutputImageThumbnail}"
                                                                           Stretch="Uniform"
                                                                           Height="50"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- Status -->
                                                            <StackPanel Grid.Column="2"
                                                                       Orientation="Horizontal"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0">
                                                                <TextBlock Text="{Binding StatusDisplay}"
                                                                          FontSize="11"
                                                                          FontWeight="Bold"
                                                                          Foreground="{Binding StatusColor}"/>

                                                                <ProgressBar Value="{Binding Progress}"
                                                                           Width="50"
                                                                           Height="12"
                                                                           Margin="5,0">
                                                                    <ProgressBar.Style>
                                                                        <Style TargetType="ProgressBar">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ProgressBar.Style>
                                                                </ProgressBar>
                                                            </StackPanel>

                                                            <!-- Remove Button -->
                                                            <Button Grid.Column="3"
                                                                   Content="❌"
                                                                   Command="{Binding DataContext.Analyzer.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"
                                                                   Background="Transparent"
                                                                   BorderThickness="0"
                                                                   Padding="5"
                                                                   ToolTip="Remove from queue"
                                                                   FontSize="12"
                                                                   Cursor="Hand">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Queue Control Buttons - Text Prompt Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Controls" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                               Content="Clear Queue"
                                               Command="{Binding ClearQueueCommand}"
                                               Margin="0,0,5,0"
                                               Height="38">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E55563"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="1"
                                               Content="Open Folder"
                                               Command="{Binding OpenResultFolderCommand}"
                                               IsEnabled="{Binding HasResultImage}"
                                               Margin="5,0,0,0"
                                               Height="38"
                                               Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Queue Control Buttons - Image Analysis Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Queue Controls" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                               Content="Clear Queue"
                                               Command="{Binding Analyzer.ClearQueueCommand}"
                                               Margin="0,0,5,0"
                                               Height="38">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E55563"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="1"
                                               Content="Open Folder"
                                               Command="{Binding Analyzer.OpenResultFolderCommand}"
                                               IsEnabled="{Binding Analyzer.HasResultImage}"
                                               Margin="5,0,0,0"
                                               Height="38"
                                               Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Result Preview - Text Prompt Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsTextPromptMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Latest Result" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                                    <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                            Background="White" Height="200"
                                            CornerRadius="5" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Result will appear here"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#999"
                                                      FontStyle="Italic"
                                                      FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasResultImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Command="{Binding OpenResultImageCommand}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Click to open in image viewer" Padding="0">
                                                <Image Source="{Binding ResultImageSource}"
                                                       Stretch="Uniform" Margin="5"
                                                       Visibility="{Binding HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                               Content="🎥 Camera Edit"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding SendToCameraEditCommand}"
                                               IsEnabled="{Binding HasResultImage}"
                                               Margin="0,0,5,0"/>

                                        <Button Grid.Column="1"
                                               Content="🎬 Video Generator"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Command="{Binding SendToVideoGeneratorCommand}"
                                               IsEnabled="{Binding HasResultImage}"
                                               Margin="5,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="{Binding ImageInfo}"
                                              FontStyle="Italic"
                                              Foreground="#666"
                                              FontSize="10"
                                              Margin="0,8,0,0"
                                              TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Result Preview - Image Analysis Mode -->
                            <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding Analyzer.IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Latest Result" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                                    <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                            Background="White" Height="200"
                                            CornerRadius="5" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Result will appear here"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#999"
                                                      FontStyle="Italic"
                                                      FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Analyzer.HasResultImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Command="{Binding Analyzer.OpenResultImageCommand}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Click to open in image viewer" Padding="0">
                                                <Image Source="{Binding Analyzer.ResultImageSource}"
                                                       Stretch="Uniform" Margin="5"
                                                       Visibility="{Binding Analyzer.HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding Analyzer.ImageInfo}"
                                              FontStyle="Italic"
                                              Foreground="#666"
                                              FontSize="10"
                                              Margin="0,8,0,0"
                                              TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- Tab 3.5: Story Image Generator Q (Qwen Rapid Edit) -->
            <TabItem Header="📖 Story Image Q" FontWeight="Bold" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">

                        <!-- Header with Workflow Selector and Settings Toggle -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="✨ Story Image Generator Q"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#8B5CF6"
                                       VerticalAlignment="Center"/>

                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- Workflow selector -->
                                <TextBlock Text="Workflow:"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{x:Static local:StoryImageGeneratorQViewModel.WorkflowModes}"
                                          SelectedItem="{Binding StoryGeneratorQ.SelectedWorkflowMode, Mode=TwoWay}"
                                          Width="100"
                                          Height="32"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          FontSize="12"/>
                                <!-- Settings gear -->
                                <Button Command="{Binding StoryGeneratorQ.ToggleSettingsVisibilityCommand}"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Background="#F3F4F6"
                                        BorderThickness="0">
                                    <Button.Content>
                                        <TextBlock Text="⚙️" FontSize="20" />
                                    </Button.Content>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                               CornerRadius="8"
                                                               Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Settings Panel (Collapsible) -->
                        <Border Background="#F9FAFB"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.SettingsVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Steps -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,15,0">
                                    <TextBlock Text="Steps"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding StoryGeneratorQ.Steps, Mode=TwoWay}"
                                               Minimum="1" Maximum="20"
                                               TickFrequency="1"
                                               IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.Steps}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="#8B5CF6"/>
                                    </Grid>
                                </StackPanel>

                                <!-- CFG -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,15,0">
                                    <TextBlock Text="CFG"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding StoryGeneratorQ.Cfg, Mode=TwoWay}"
                                               Minimum="1" Maximum="10"
                                               TickFrequency="0.5"
                                               IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.Cfg, StringFormat={}{0:F1}}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="#8B5CF6"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Denoise -->
                                <StackPanel Grid.Column="2" Grid.Row="0">
                                    <TextBlock Text="Denoise"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                               Value="{Binding StoryGeneratorQ.Denoise, Mode=TwoWay}"
                                               Minimum="0" Maximum="1"
                                               TickFrequency="0.05"
                                               IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StoryGeneratorQ.Denoise, StringFormat={}{0:F2}}"
                                                  Margin="8,0,0,0"
                                                  FontWeight="Bold"
                                                  FontSize="13"
                                                  Foreground="#8B5CF6"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Negative Prompt -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="0,15,0,0">
                                    <TextBlock Text="Negative Prompt"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           TextWrapping="Wrap"
                                           AcceptsReturn="True"
                                           Height="60"
                                           Padding="12"
                                           VerticalScrollBarVisibility="Auto"
                                           Background="White"
                                           BorderBrush="#D1D5DB"
                                           FontSize="12">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>

                                <!-- LoRA Toggle (FireRed only) -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Margin="0,12,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StoryGeneratorQ.ShowLoRAOption}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <CheckBox Content="Use LoRA"
                                              IsChecked="{Binding StoryGeneratorQ.UseLoRA, Mode=TwoWay}"
                                              FontSize="12"
                                              FontWeight="SemiBold"
                                              Foreground="#374151"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- StoryImageZ Options Panel (Style + LoRA) -->
                        <Border Background="#F0FDF4"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.ShowZOptions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Style selector -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🎨 ZStyle"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#166534"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding StoryGeneratorQ.ZStyleNames}"
                                              SelectedIndex="{Binding StoryGeneratorQ.ZSelectedStyleIndex, Mode=TwoWay}"
                                              Height="32"
                                              Padding="8,0"
                                              FontSize="12"
                                              Background="White"
                                              BorderBrush="#86EFAC"/>
                                    <TextBlock Text="Workflow from ZStyles folder"
                                               FontSize="10"
                                               Foreground="#4D7C5F"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- LoRA settings -->
                                <StackPanel Grid.Column="2" Grid.ColumnSpan="1">
                                    <TextBlock Text="🔧 LoRA"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#166534"
                                               Margin="0,0,0,8"/>
                                    <CheckBox Content="Enable LoRA"
                                              IsChecked="{Binding StoryGeneratorQ.ZLoraEnabled, Mode=TwoWay}"
                                              FontSize="12"
                                              Foreground="#374151"
                                              Margin="0,0,0,8"/>
                                    <Grid Visibility="{Binding StoryGeneratorQ.ZLoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding StoryGeneratorQ.ZAvailableLoras}"
                                                  SelectedItem="{Binding StoryGeneratorQ.ZSelectedLora, Mode=TwoWay}"
                                                  Height="32"
                                                  Padding="8,0"
                                                  FontSize="11"
                                                  Background="White"
                                                  BorderBrush="#86EFAC"
                                                  Margin="0,0,6,0"/>
                                        <Button Grid.Column="1"
                                                Content="↻"
                                                Command="{Binding StoryGeneratorQ.RefreshZLorasCommand}"
                                                Width="32" Height="32"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Background="#16A34A"
                                                Foreground="White"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#15803D"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <StackPanel Visibility="{Binding StoryGeneratorQ.ZLoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,8,0,0">
                                        <TextBlock Text="Strength"
                                                   FontSize="11"
                                                   Foreground="#374151"
                                                   Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Value="{Binding StoryGeneratorQ.ZLoraStrengthModel, Mode=TwoWay}"
                                                    Minimum="0" Maximum="2"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StoryGeneratorQ.ZLoraStrengthModel, StringFormat={}{0:F2}}"
                                                       Margin="8,0,0,0"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="#16A34A"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Orientation selector -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="📐 Orientation"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#166534"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{x:Static local:StoryImageGeneratorQViewModel.ZOrientations}"
                                              SelectedItem="{Binding StoryGeneratorQ.ZSelectedOrientation, Mode=TwoWay}"
                                              Height="32"
                                              Padding="8,0"
                                              FontSize="12"
                                              Background="White"
                                              BorderBrush="#86EFAC"/>
                                    <TextBlock Text="Portrait · Landscape · Square"
                                               FontSize="10"
                                               Foreground="#4D7C5F"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Content Area -->
                        <Border Background="White"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="16"
                               Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column - File Selection -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📝 Story Prompts"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,15"/>

                                    <!-- Input Image Selection (moved up) -->
                                    <TextBlock Text="Input Image"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                               Text="{Binding StoryGeneratorQ.InputImagePath, Mode=TwoWay}"
                                               IsReadOnly="True"
                                               Padding="10"
                                               Background="#F9FAFB"
                                               BorderBrush="#E5E7EB"
                                               VerticalContentAlignment="Center"
                                               FontSize="11"
                                               Height="38"/>
                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               Command="{Binding StoryGeneratorQ.SelectInputImageCommand}"
                                               Margin="8,0,0,0"
                                               Width="80"
                                               Height="38"
                                               Background="#F3F4F6"
                                               Foreground="#374151"
                                               BorderThickness="0"
                                               FontSize="12"
                                               Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>

                                    <!-- Story Concept Input -->
                                    <TextBlock Text="Story Concept (optional)"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding StoryGeneratorQ.StoryConcept, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="10"
                                             Background="#F9FAFB"
                                             BorderBrush="#E5E7EB"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             Height="38"
                                             Margin="0,0,0,10"
                                             ToolTip="e.g. revenge thriller, romantic journey, sci-fi survival"/>

                                    <!-- Analyze Image with Qwen VL Button (NEW) -->
                                    <Button Content="🔍 Analyze Image with Qwen VL"
                                           Command="{Binding StoryGeneratorQ.AnalyzeImageWithQwenVLCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="44"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F59E0B"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="8"
                                                                   Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#D97706"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#CBD5E1"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Analysis Progress (shown when analyzing) -->
                                    <Border Background="#FEF3C7"
                                            BorderBrush="#FCD34D"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            Visibility="{Binding StoryGeneratorQ.IsAnalyzingImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding StoryGeneratorQ.AnalysisStatus}"
                                                      FontWeight="Bold"
                                                      FontSize="11"
                                                      Margin="0,0,0,6"
                                                      TextAlignment="Center"
                                                      Foreground="#92400E"/>
                                            <ProgressBar IsIndeterminate="True"
                                                        Height="18"
                                                        Foreground="#F59E0B"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Prompt JSON File (moved below analyze button) -->
                                    <TextBlock Text="Prompts JSON File"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                               Text="{Binding StoryGeneratorQ.PromptJsonFilePath, Mode=TwoWay}"
                                               IsReadOnly="True"
                                               Padding="10"
                                               Background="#F9FAFB"
                                               BorderBrush="#E5E7EB"
                                               VerticalContentAlignment="Center"
                                               FontSize="11"
                                               Height="38"/>
                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               Command="{Binding StoryGeneratorQ.SelectPromptJsonCommand}"
                                               Margin="8,0,0,0"
                                               Width="80"
                                               Height="38"
                                               Background="#F3F4F6"
                                               Foreground="#374151"
                                               BorderThickness="0"
                                               FontSize="12"
                                               Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>

                                    <!-- Add Prompts from JSON Button -->
                                    <Button Content="📥 Add Prompts from JSON"
                                           Command="{Binding StoryGeneratorQ.LoadPromptsCommand}"
                                           HorizontalAlignment="Stretch"
                                           Height="48"
                                           Background="#8B5CF6"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>

                                <!-- Right Column - Image Preview -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="🖼️ Image Preview"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,15"/>

                                    <Border BorderBrush="#E5E7EB"
                                           BorderThickness="2"
                                           Background="#F9FAFB"
                                           CornerRadius="12"
                                           Height="220">
                                        <Grid>
                                            <TextBlock Text="No image selected"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#9CA3AF"
                                                      FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StoryGeneratorQ.InputImagePreview}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding StoryGeneratorQ.InputImagePreview, Mode=OneWay}"
                                                  Stretch="Uniform"
                                                  Margin="4"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Queue Management Section -->
                        <Border Background="White"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="16"
                               Padding="24"
                               Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="📋 Queue Management"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,0,15"/>

                                <!-- Queue Controls -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                           Content="🚀 Generate Story"
                                           Command="{Binding StoryGeneratorQ.ProcessQueueCommand}"
                                           Height="44"
                                           Background="#8B5CF6"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           Style="{StaticResource PrimaryButtonStyle}"/>

                                    <Button Grid.Column="1"
                                           Content="📂 Output Folder"
                                           Command="{Binding StoryGeneratorQ.OpenOutputFolderCommand}"
                                           Height="44"
                                           Background="#F3F4F6"
                                           Foreground="#374151"
                                           BorderThickness="0"
                                           FontSize="13"
                                           Margin="0,0,8,0"
                                           Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button Grid.Column="2"
                                           Content="🗑️ Clear Queue"
                                           Command="{Binding StoryGeneratorQ.ClearQueueCommand}"
                                           Height="44"
                                           Background="#FEE2E2"
                                           Foreground="#DC2626"
                                           BorderThickness="0"
                                           FontSize="13">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FECACA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Pause/Resume Controls (Q) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                            Visibility="{Binding StoryGeneratorQ.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button Content="⏸ Pause" Width="100" Height="32" Margin="0,0,8,0"
                                            Command="{Binding StoryGeneratorQ.PauseQueueCommand}"
                                            Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                                    <Button Content="▶ Resume" Width="100" Height="32" Margin="0,0,8,0"
                                            Command="{Binding StoryGeneratorQ.ResumeQueueCommand}"
                                            Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Queue Status -->
                                <Border Background="#F9FAFB"
                                       BorderBrush="#E5E7EB"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Padding="12"
                                       Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                  Text="Queue Status"
                                                  FontWeight="SemiBold"
                                                  FontSize="12"
                                                  Foreground="#374151"
                                                  VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Background="#FF8C00"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                Margin="10,0">
                                            <TextBlock Text="{Binding StoryGeneratorQ.QueuedCount, StringFormat={}Remaining: {0}}"
                                                      FontWeight="Bold"
                                                      FontSize="12"
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                  Text="{Binding StoryGeneratorQ.QueuedCount, StringFormat={}Queued: {0}}"
                                                  Margin="10,0"
                                                  FontSize="11"
                                                  Foreground="#6B7280"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                  Text="{Binding StoryGeneratorQ.CompletedCount, StringFormat={}Completed: {0}}"
                                                  Margin="10,0"
                                                  FontSize="11"
                                                  Foreground="#059669"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4"
                                                  Text="{Binding StoryGeneratorQ.FailedCount, StringFormat={}Failed: {0}}"
                                                  Margin="10,0"
                                                  FontSize="11"
                                                  Foreground="#DC2626"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Queue Progress -->
                                <Border Background="#FEF3C7"
                                       BorderBrush="#F59E0B"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Padding="12"
                                       Margin="0,0,0,15"
                                       Visibility="{Binding StoryGeneratorQ.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StoryGeneratorQ.QueueProgressText, StringFormat={}Processing: {0}}"
                                                  FontWeight="SemiBold"
                                                  FontSize="11"
                                                  Foreground="#92400E"
                                                  Margin="0,0,0,6"/>
                                        <ProgressBar Value="{Binding StoryGeneratorQ.QueueProgress, Mode=OneWay}"
                                                  Maximum="{Binding StoryGeneratorQ.QueueTotal, Mode=OneWay}"
                                                  Height="6"
                                                  Foreground="#8B5CF6"
                                                  Background="#F3F4F6"
                                                  BorderThickness="0"/>
                                        <TextBlock Text="{Binding StoryGeneratorQ.CurrentQueueItem.Prompt, StringFormat={}Current: {0}}"
                                                  FontSize="10"
                                                  Foreground="#92400E"
                                                  TextTrimming="CharacterEllipsis"
                                                  Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Queue Items List (compact) -->
                                <Border Background="#F9FAFB"
                                       BorderBrush="#E5E7EB"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding StoryGeneratorQ.QueueItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E5E7EB"
                                                           BorderThickness="0,0,0,1"
                                                           Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                      Text="{Binding Index, StringFormat='#{0}'}"
                                                                      FontWeight="Bold"
                                                                      FontSize="12"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,10,0"
                                                                      Foreground="#8B5CF6"/>
                                                            <TextBlock Grid.Column="1"
                                                                      Text="{Binding Prompt}"
                                                                      FontSize="11"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#374151"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Foreground" Value="#059669"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                <Setter Property="Foreground" Value="#8B5CF6"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="2"
                                                                      Text="{Binding StatusDisplay}"
                                                                      FontSize="10"
                                                                      VerticalAlignment="Center"
                                                                      Margin="8,0,0,0"
                                                                      Foreground="#6B7280"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Storyboard View (visible once items are loaded) -->
                        <Border Background="White"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="16"
                               Padding="24"
                               Margin="0,20,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.HasAnyItems}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>

                                <!-- Storyboard header + Save Final controls -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="🎬 Storyboard"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Save to folder:"
                                                   FontSize="12"
                                                   Foreground="#6B7280"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding StoryGeneratorQ.FinalFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="180"
                                                 Height="36"
                                                 Padding="10,0"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="12"
                                                 Background="#F9FAFB"
                                                 BorderBrush="#D1D5DB"
                                                 Margin="0,0,10,0">
                                            <TextBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Button Content="💾 Save Final Storyboard"
                                                Command="{Binding StoryGeneratorQ.SaveFinalStoryboardCommand}"
                                                Height="36"
                                                Padding="16,0"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="12"
                                                FontWeight="SemiBold">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#059669"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="8"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#047857"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#CBD5E1"/>
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Hint text -->
                                <TextBlock Text="Click an image to open it. Edit the prompt below each image, then click Regenerate to redo that scene."
                                           FontSize="11"
                                           Foreground="#9CA3AF"
                                           Margin="0,0,0,16"/>

                                <!-- Storyboard cards grid -->
                                <ItemsControl ItemsSource="{Binding StoryGeneratorQ.QueueItems}"
                                              x:Name="StoryboardQItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="240"
                                                    Margin="6,6"
                                                    Background="#F9FAFB"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <StackPanel Margin="12">

                                                    <!-- Scene label + delete button + status badge -->
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Index, StringFormat='Scene #{0}'}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="#8B5CF6"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Delete X button -->
                                                        <Button HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,-6,-6,0"
                                                                Width="18" Height="18"
                                                                Padding="0"
                                                                Background="#E5E7EB"
                                                                BorderThickness="0"
                                                                FontSize="9"
                                                                FontWeight="Bold"
                                                                Foreground="#6B7280"
                                                                Content="✕"
                                                                ToolTip="Delete scene"
                                                                Command="{Binding DataContext.StoryGeneratorQ.DeleteItemCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        CornerRadius="9"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#EF4444"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Border HorizontalAlignment="Right"
                                                                CornerRadius="8"
                                                                Padding="7,2"
                                                                Margin="0,0,24,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                            <Setter Property="Background" Value="#EDE9FE"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding Status}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Foreground" Value="#059669"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                <Setter Property="Foreground" Value="#7C3AED"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Image thumbnail area (click to open) -->
                                                    <Border Height="195"
                                                            Background="#F3F4F6"
                                                            BorderBrush="#E5E7EB"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Margin="0,0,0,10"
                                                            Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding Command="{Binding OpenImageCommand}" MouseAction="LeftClick"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <!-- Placeholder when not yet completed -->
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock HorizontalAlignment="Center" FontSize="36">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="🖼️"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Text" Value="⚙️"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                    <Setter Property="Text" Value="❌"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Status}"
                                                                           FontSize="11"
                                                                           Foreground="#9CA3AF"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,4,0,0"/>
                                                                <!-- Progress bar while processing -->
                                                                <ProgressBar Value="{Binding Progress}"
                                                                             Maximum="100"
                                                                             Height="4"
                                                                             Width="120"
                                                                             Margin="0,6,0,0"
                                                                             Foreground="#8B5CF6"
                                                                             Background="#E5E7EB"
                                                                             BorderThickness="0">
                                                                    <ProgressBar.Style>
                                                                        <Style TargetType="ProgressBar">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ProgressBar.Style>
                                                                </ProgressBar>
                                                            </StackPanel>
                                                            <!-- Generated image -->
                                                            <Image Source="{Binding StoryboardThumbnailImage}"
                                                                   Stretch="Uniform"
                                                                   Margin="4">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Editable prompt -->
                                                    <TextBox Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="False"
                                                             Height="80"
                                                             Padding="8"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Background="White"
                                                             BorderBrush="#D1D5DB"
                                                             FontSize="11"
                                                             VerticalContentAlignment="Top"
                                                             Margin="0,0,0,8"
                                                             ToolTip="Edit this prompt and click Regenerate">
                                                        <TextBox.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </TextBox.Resources>
                                                    </TextBox>

                                                    <!-- Regenerate button -->
                                                    <Button Content="🔄 Regenerate"
                                                            Command="{Binding DataContext.StoryGeneratorQ.RegenerateItemCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            Height="32"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            FontSize="11"
                                                            FontWeight="SemiBold">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#6366F1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    CornerRadius="6"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#4F46E5"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Background" Value="#CBD5E1"/>
                                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>

                        <!-- Log Output (Collapsible) -->
                        <Expander Margin="0,20,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="📋 Activity Log"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="#6B7280"/>
                            </Expander.Header>
                            <Border Background="#1F2937"
                                   BorderBrush="#374151"
                                   BorderThickness="1"
                                   CornerRadius="8"
                                   Margin="0,8,0,0">
                                <ScrollViewer MaxHeight="150"
                                             VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding StoryGeneratorQ.LogOutput}"
                                           TextWrapping="Wrap"
                                           IsReadOnly="True"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Background="Transparent"
                                           Foreground="#D1D5DB"
                                           BorderThickness="0"
                                           Padding="12"/>
                                </ScrollViewer>
                            </Border>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Tab: Amateur Generator -->
            <TabItem Header="📷 Amateur" FontWeight="Bold" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">

                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="✨ Amateur Photo Generator"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#10B981"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Saved Prompts Section -->
                        <Border Background="#FFF8DC" BorderBrush="#DEB887" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="📝 Saved Prompts" FontWeight="Bold" FontSize="13" Foreground="#8B4513" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Select a saved prompt or save current:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="💾 Save" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AmateurGenerator.SavePromptCommand}" Padding="10,5" Margin="5,0,5,0"
                                            ToolTip="Save current prompt settings"
                                            Background="#4CAF50"/>
                                    <Button Grid.Column="2" Content="🗑️ Delete" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AmateurGenerator.DeletePromptCommand}" Padding="10,5" Margin="0,0,0,0"
                                            ToolTip="Delete selected saved prompt"
                                            Background="#F44336"/>
                                </Grid>

                                <ComboBox ItemsSource="{Binding AmateurGenerator.SavedPrompts}"
                                          SelectedItem="{Binding AmateurGenerator.SelectedSavedPrompt, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          Padding="10"
                                          Background="White"
                                          BorderBrush="#CED4DA"
                                          FontSize="12"
                                          Margin="0,5,0,10"
                                          Height="40">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding LastUsed, StringFormat='Last used: {0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="10" Foreground="#666"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="💡 Tip: Your saved prompts appear here. Click Save to store the current prompt settings."
                                           FontSize="11" Foreground="#666" FontStyle="Italic" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Image Analysis & Prompt Enhancement -->
                        <Border Background="#F0F4FF"
                               BorderBrush="#C7D2FE"
                               BorderThickness="1"
                               CornerRadius="8"
                               Padding="16"
                               Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="📷 Image Analysis &amp; Prompt Enhancement"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="#4F46E5" Margin="0,0,0,8"/>
                                <TextBlock Text="Upload an image — it will be analyzed by the remote LLaMA server and automatically generate an enhanced prompt."
                                           FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <!-- Browse row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                            Text="{Binding AmateurGenerator.SourceImagePath, Mode=OneWay}"
                                            IsReadOnly="True"
                                            Padding="8"
                                            Background="White"
                                            BorderBrush="#D1D5DB"
                                            VerticalContentAlignment="Center"
                                            FontSize="11"
                                            Height="30"
                                            Foreground="#374151"/>
                                    <Button Grid.Column="1"
                                           Content="Browse..."
                                           Command="{Binding AmateurGenerator.BrowseImageCommand}"
                                           Height="30"
                                           Width="80"
                                           Margin="6,0,0,0"
                                           Background="#6366F1"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4F46E5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Image preview -->
                                <Border BorderBrush="#D1D5DB" BorderThickness="1"
                                        Background="White" Height="160"
                                        CornerRadius="6" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="No image selected — click Browse to upload"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="#9CA3AF"
                                                  FontStyle="Italic"
                                                  FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AmateurGenerator.HasSourceImage}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding AmateurGenerator.SourceImageSource}"
                                               Stretch="Uniform"
                                               Margin="5"
                                               Visibility="{Binding AmateurGenerator.HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Analyze button + status -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                           Content="🔍 Analyze &amp; Enhance Prompt"
                                           Command="{Binding AmateurGenerator.AnalyzeImageCommand}"
                                           Height="38"
                                           Background="#F59E0B"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#D97706"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#CBD5E1"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Border Grid.Column="1"
                                           Visibility="{Binding AmateurGenerator.IsAnalyzingImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ProgressBar IsIndeterminate="True" Width="80" Height="10" Foreground="#F59E0B"/>
                                            <TextBlock Text="Analyzing..." FontSize="11" Foreground="#6B7280" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Main Controls Panel -->
                        <Border Background="#F9FAFB"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Additional Prompt -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Additional Prompt"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="📋 Paste"
                                               Command="{Binding AmateurGenerator.PasteFromClipboardCommand}"
                                               Width="80"
                                               Height="28"
                                               HorizontalAlignment="Right"
                                               FontSize="11"
                                               Padding="5,0"
                                               Background="#6B7280"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Cursor="Hand"/>
                                    </Grid>
                                    <TextBox Text="{Binding AmateurGenerator.AdditionalPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="80"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Padding="12"
                                             FontSize="13"
                                             BorderBrush="#D1D5DB"
                                             Background="White"/>
                                    <TextBlock Text="The photographer prefix will be added automatically"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Orientation Selection -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Image Orientation"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AmateurGenerator.Orientations}"
                                              SelectedIndex="{Binding AmateurGenerator.OrientationIndex}"
                                              FontSize="13"
                                              Padding="10"
                                              Background="White"
                                              BorderBrush="#D1D5DB"/>
                                </StackPanel>

                                <!-- Style Selection -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,0">
                                    <TextBlock Text="Style"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#374151"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AmateurGenerator.Styles}"
                                              SelectedIndex="{Binding AmateurGenerator.StyleIndex}"
                                              FontSize="13"
                                              Padding="10"
                                              Background="White"
                                              BorderBrush="#D1D5DB"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- Character LoRA -->
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,15">
                            <StackPanel>
                                <CheckBox Content="Character LoRA"
                                         IsChecked="{Binding AmateurGenerator.LoraEnabled, Mode=TwoWay}"
                                         FontWeight="SemiBold"
                                         FontSize="13"
                                         Foreground="#374151"
                                         Margin="0,0,0,8"/>
                                <Grid Visibility="{Binding AmateurGenerator.LoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                             ItemsSource="{Binding AmateurGenerator.AvailableLoras}"
                                             SelectedItem="{Binding AmateurGenerator.SelectedLora, Mode=TwoWay}"
                                             Padding="8"
                                             Background="White"
                                             BorderBrush="#D1D5DB"
                                             FontSize="12"/>
                                    <Button Grid.Column="1"
                                           Content="↻"
                                           Command="{Binding AmateurGenerator.RefreshLorasCommand}"
                                           Width="36"
                                           Margin="6,0,0,0"
                                           Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>
                                <StackPanel Visibility="{Binding AmateurGenerator.LoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Strength:" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider Grid.Column="1"
                                               Value="{Binding AmateurGenerator.LoraStrength, Mode=TwoWay}"
                                               Minimum="0" Maximum="1.5" TickFrequency="0.05"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                  Text="{Binding AmateurGenerator.LoraStrength, StringFormat='{}{0:F2}'}"
                                                  FontSize="11" Foreground="#374151" VerticalAlignment="Center"
                                                  Margin="8,0,0,0" Width="32"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Add to Queue Button -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                   Content="➕ Add to Queue"
                                   Command="{Binding AmateurGenerator.AddToQueueCommand}"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Height="45"
                                   FontSize="15"
                                   Background="#10B981"/>

                            <Button Grid.Column="1"
                                   Content="▶ Start Queue"
                                   Command="{Binding AmateurGenerator.ProcessQueueCommand}"
                                   Height="45"
                                   Width="130"
                                   Background="#059669"
                                   Foreground="White"
                                   BorderThickness="0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Cursor="Hand"
                                   Margin="10,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#047857"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCC"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="2"
                                   Content="⏹ Cancel"
                                   Command="{Binding AmateurGenerator.CancelQueueCommand}"
                                   Height="45"
                                   Width="90"
                                   Background="#EF4444"
                                   Foreground="White"
                                   BorderThickness="0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Cursor="Hand"
                                   Margin="8,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#DC2626"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCC"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Queue Panel -->
                        <Border Background="White"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="8"
                               Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Queue Header -->
                                <Grid Margin="15,12,15,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Queue"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="#10B981"
                                               CornerRadius="10"
                                               Padding="6,2"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AmateurGenerator.QueueCount}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="processing..."
                                                   FontSize="11"
                                                   Foreground="#10B981"
                                                   FontStyle="Italic"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding AmateurGenerator.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <Button Content="Clear All"
                                           Command="{Binding AmateurGenerator.ClearQueueCommand}"
                                           HorizontalAlignment="Right"
                                           Background="#6B7280"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Padding="10,4"
                                           FontSize="11"
                                           Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220" Padding="15,0,15,10">
                                    <ItemsControl ItemsSource="{Binding AmateurGenerator.Queue}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F3F4F6"
                                                       BorderThickness="0,0,0,1"
                                                       Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Item Info -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayPrompt}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding OrientationDisplay}"
                                                                           FontSize="10"
                                                                           Foreground="#6B7280"/>
                                                                <TextBlock Text=" · "
                                                                           FontSize="10"
                                                                           Foreground="#6B7280"/>
                                                                <TextBlock Text="{Binding StyleDisplay}"
                                                                           FontSize="10"
                                                                           Foreground="#6B7280"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Status / Progress -->
                                                        <StackPanel Grid.Column="1"
                                                                   Orientation="Horizontal"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0">
                                                            <TextBlock Text="{Binding StatusDisplay}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding StatusColor}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ProgressBar Value="{Binding Progress}"
                                                                        Width="50"
                                                                        Height="10"
                                                                        Margin="4,0">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                        </StackPanel>

                                                        <!-- Thumbnail when completed -->
                                                        <Button Grid.Column="2"
                                                               Command="{Binding OpenImageCommand}"
                                                               Background="Transparent"
                                                               BorderThickness="0"
                                                               Cursor="Hand"
                                                               ToolTip="Click to open image"
                                                               Padding="0"
                                                               Margin="4,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Image Source="{Binding ThumbnailImage}"
                                                                   Height="44"
                                                                   Stretch="Uniform"/>
                                                        </Button>

                                                        <!-- Remove Button -->
                                                        <Button Grid.Column="3"
                                                               Content="❌"
                                                               Command="{Binding DataContext.AmateurGenerator.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"
                                                               Background="Transparent"
                                                               BorderThickness="0"
                                                               Padding="4"
                                                               ToolTip="Remove from queue"
                                                               FontSize="11"
                                                               Cursor="Hand"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Progress Section -->
                        <Border Background="#F9FAFB"
                               BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20"
                               Visibility="{Binding AmateurGenerator.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Processing..."
                                              FontWeight="SemiBold"
                                              FontSize="13"
                                              Foreground="#374151"/>
                                    <TextBlock Text="{Binding AmateurGenerator.ProgressPercentage}"
                                              FontWeight="Bold"
                                              FontSize="13"
                                              Foreground="#10B981"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding AmateurGenerator.ProcessingProgress}"
                                           Maximum="100"
                                           Height="8"
                                           Margin="0,10,0,0"
                                           Background="#E5E7EB"
                                           Foreground="#10B981"/>
                                <TextBlock Text="{Binding AmateurGenerator.ProcessingStatus}"
                                          FontSize="12"
                                          Foreground="#6B7280"
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Result Section -->
                        <Border BorderBrush="#E5E7EB"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,20"
                               Visibility="{Binding AmateurGenerator.HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <TextBlock Text="Generated Image"
                                              FontWeight="SemiBold"
                                              FontSize="14"
                                              Foreground="#374151"/>
                                    <Button Content="Open Folder"
                                           Command="{Binding AmateurGenerator.OpenResultFolderCommand}"
                                           Width="100"
                                           Height="32"
                                           Background="#6B7280"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           Cursor="Hand"/>
                                </Grid>

                                <Border Grid.Row="1"
                                       BorderBrush="#E5E7EB"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Background="White"
                                       HorizontalAlignment="Center">
                                    <Button Command="{Binding AmateurGenerator.OpenResultImageCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Click to open in image viewer" Padding="0">
                                        <Image Source="{Binding AmateurGenerator.ResultImageSource}"
                                              MaxWidth="600"
                                              MaxHeight="400"
                                              Margin="10"/>
                                    </Button>
                                </Border>

                                <TextBlock Grid.Row="1"
                                          Text="{Binding AmateurGenerator.ImageInfo}"
                                          FontSize="12"
                                          Foreground="#6B7280"
                                          Margin="0,15,0,0"
                                          HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Log Output -->
                        <Border Background="#1F2937"
                               BorderBrush="#374151"
                               BorderThickness="1"
                               CornerRadius="8"
                               Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                          Text="Log Output"
                                          FontWeight="SemiBold"
                                          FontSize="12"
                                          Foreground="#9CA3AF"
                                          Margin="0,0,0,10"/>

                                <TextBox Grid.Row="1"
                                         Text="{Binding AmateurGenerator.LogOutput}"
                                         IsReadOnly="True"
                                         Height="150"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#111827"
                                         Foreground="#9CA3AF"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Padding="10"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Camera Angle Generator -->
            <TabItem Header="🎥 Camera Angle" FontWeight="Bold" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,20,20,20">
                        <!-- Header -->
                        <TextBlock Text="Camera Angle Generator" FontSize="22" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10"/>
                        <TextBlock Text="Generate multiple character angles from a single image using Flux2 models" FontSize="13" Foreground="#6B7280" Margin="0,0,0,25"/>

                        <!-- Input Section -->
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Input Image" FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,10"/>

                                <!-- File Selection Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="#F9FAFB" Padding="12,10">
                                        <TextBlock Text="{Binding CameraAngle.InputImagePath, FallbackValue='No image selected'}"
                                                   Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <Button Grid.Column="2" Content="Browse..." Command="{Binding CameraAngle.SelectInputImageCommand}"
                                            Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="15,8"
                                            FontSize="12" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Image Preview -->
                                <Border Margin="0,15,0,0" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Background="#F3F4F6"
                                        HorizontalAlignment="Left" Width="300" Height="200">
                                    <Grid>
                                        <Image Source="{Binding CameraAngle.InputImagePreview}" Stretch="Uniform" Margin="10"/>
                                        <TextBlock Text="No image loaded" FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CameraAngle.InputImagePreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->

                        <!-- Action Buttons -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Generate Camera Angles" Command="{Binding CameraAngle.GenerateCameraAnglesCommand}"
                                    Background="#10B981" Foreground="White" BorderThickness="0" Padding="15,10"
                                    FontSize="13" FontWeight="SemiBold"/>

                            <Button Grid.Column="2" Content="Cancel" Command="{Binding CameraAngle.CancelGenerationCommand}"
                                    Background="#EF4444" Foreground="White" BorderThickness="0" Padding="15,10"
                                    FontSize="13" FontWeight="SemiBold"
                                    Visibility="{Binding CameraAngle.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Button Grid.Column="4" Content="Open Output Folder" Command="{Binding CameraAngle.OpenOutputFolderCommand}"
                                    Background="#6366F1" Foreground="White" BorderThickness="0" Padding="15,10"
                                    FontSize="13" FontWeight="SemiBold"/>

                            <Button Grid.Column="6" Content="Clear Output" Command="{Binding CameraAngle.ClearOutputCommand}"
                                    Background="#8B5CF6" Foreground="White" BorderThickness="0" Padding="15,10"
                                    FontSize="13" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Progress Section -->
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20"
                                Visibility="{Binding CameraAngle.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Processing Status" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                                    <TextBlock Text="{Binding CameraAngle.ProgressPercentage}" FontSize="13" Foreground="#10B981" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <ProgressBar Value="{Binding CameraAngle.ProcessingProgress}" Maximum="100" Height="8" Margin="0,10,0,5"
                                            Foreground="#10B981" Background="#E5E7EB"/>

                                <TextBlock Text="{Binding CameraAngle.ProcessingStatus}" FontSize="12" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>

                        <!-- Output Section -->
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Generated Camera Angles" FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding CameraAngle.OutputItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,10">
                                                <StackPanel Width="180">
                                                    <!-- Thumbnail Image -->
                                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Width="160" Height="160"
                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                            <Setter Property="Source" Value="{x:Null}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Border>

                                                    <!-- Info and Button -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="5"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>

                                                        <Button Grid.Column="2" Content="Open" FontSize="11" Padding="8,4"
                                                                Background="#3B82F6" Foreground="White" BorderThickness="0"
                                                                Tag="{Binding FilePath}" Click="OpenOutputImage_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No camera angles generated yet" FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center" Padding="20">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CameraAngle.OutputItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Log Output -->
                        <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                            <TextBox Text="{Binding CameraAngle.LogOutput}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#111827"
                                     Foreground="#9CA3AF"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Padding="10"
                                     Height="150"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Tab: Inpaint Editor -->
            <TabItem Header="✏️ Editor" FontWeight="Bold" FontSize="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Source image + mask painting -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">

                            <!-- Upload section -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Source Image" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                                Background="White" Padding="8,6">
                                            <TextBlock Text="{Binding InpaintEditor.SourceImagePath, FallbackValue='No image selected'}"
                                                       Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Button Grid.Column="2" Content="📂 Browse"
                                                Command="{Binding InpaintEditor.BrowseImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#6366F1" Padding="14,8"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Canvas: source image + mask painting overlay -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Paint Mask" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1" Margin="0,0,0,6"/>
                                    <TextBlock Text="Paint over the area you want to edit. Red strokes = inpaint region."
                                               FontSize="11" Foreground="#6B7280" Margin="0,0,0,8"/>

                                    <!-- Brush controls -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Brush:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Slider x:Name="BrushSizeSlider"
                                                Minimum="5" Maximum="120"
                                                Value="{Binding InpaintEditor.BrushSize, Mode=TwoWay}"
                                                Width="140" VerticalAlignment="Center"
                                                ValueChanged="BrushSizeSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding InpaintEditor.BrushSize, StringFormat='  {0}px'}"
                                                   FontSize="12" VerticalAlignment="Center" Foreground="#495057"/>
                                        <Button Content="🗑️ Clear Mask" Click="ClearMask_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#DC3545" Padding="10,6" Margin="12,0,0,0" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Image + InkCanvas layered in a Grid -->
                                    <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                            Background="#1A1A2E" Height="420" ClipToBounds="True">
                                        <Grid>
                                            <!-- Source image -->
                                            <Image x:Name="EditorSourceImage"
                                                   Source="{Binding InpaintEditor.SourceImageSource}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <!-- Placeholder when no image loaded -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding InpaintEditor.NoSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Browse an image to start" FontSize="14"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <!-- InkCanvas mask painter (transparent bg, red strokes) -->
                                            <InkCanvas x:Name="MaskInkCanvas"
                                                       Background="Transparent"
                                                       Cursor="Cross"
                                                       IsEnabled="{Binding InpaintEditor.HasSourceImage}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Prompt section -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Edit Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>
                                    <TextBox Text="{Binding InpaintEditor.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="70" MaxHeight="120"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="13" Padding="8"
                                             BorderBrush="#CED4DA" BorderThickness="1"/>
                                </StackPanel>
                            </Border>

                            <!-- Generate button + progress -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <Button Content="⚡ Generate Inpaint"
                                            Click="RunInpaint_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            IsEnabled="{Binding InpaintEditor.CanGenerate}"
                                            Padding="20,12" FontSize="14" HorizontalAlignment="Stretch"/>

                                    <!-- Progress -->
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding InpaintEditor.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding InpaintEditor.StatusMessage}" FontSize="12" Foreground="#495057"/>
                                            <TextBlock Text="{Binding InpaintEditor.ProgressText}" FontSize="12"
                                                       Foreground="#6366F1" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding InpaintEditor.Progress}" Maximum="100" Height="8"
                                                     Foreground="#6366F1" Background="#E5E7EB"/>
                                    </StackPanel>

                                    <!-- Status message -->
                                    <TextBlock Text="{Binding InpaintEditor.StatusMessage}"
                                               FontSize="12" Foreground="#6B7280" Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- RIGHT: Result -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>

                                    <!-- Result image display -->
                                    <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                            Background="#1A1A2E" Height="420" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding InpaintEditor.ResultImageSource}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding InpaintEditor.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here" FontSize="14"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Result actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>
                                    <TextBlock Text="{Binding InpaintEditor.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding InpaintEditor.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#6366F1" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding InpaintEditor.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#10B981" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding InpaintEditor.LogOutput}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="#111827"
                                             Foreground="#9CA3AF"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Padding="4"
                                             Height="200"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== EDITOR 2: Klein Inpaint (Florence2 + SAM2 auto-detect) ===== -->
            <TabItem Header="✂️ Editor 2" FontWeight="Bold" FontSize="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Controls -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">

                            <!-- Source Image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Source Image" Style="{StaticResource HeaderTextStyle}" Foreground="#8B5CF6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                                Background="White" Padding="8,6">
                                            <TextBlock Text="{Binding KleinInpaintEditor.SourceImagePath, FallbackValue='No image selected'}"
                                                       Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Button Grid.Column="2" Content="📂 Browse"
                                                Command="{Binding KleinInpaintEditor.BrowseImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#8B5CF6" Padding="14,8"/>
                                    </Grid>

                                    <!-- Source preview thumbnail -->
                                    <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                            Background="#1A1A2E" Height="240" Margin="0,10,0,0" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding KleinInpaintEditor.SourceImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding KleinInpaintEditor.NoSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="📷" FontSize="40" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Upload an image to begin" FontSize="13"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Detect & Replace -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Detect &amp; Replace" Style="{StaticResource HeaderTextStyle}" Foreground="#8B5CF6"/>

                                    <!-- Detection Target -->
                                    <TextBlock Text="What to detect" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" Margin="0,4,0,4"/>
                                    <TextBlock Text="Florence2 + SAM2 will auto-segment this subject"
                                               FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KleinInpaintEditor.DetectionTarget, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" FontSize="13" Padding="8,6"
                                             BorderBrush="#CED4DA" BorderThickness="1"
                                             VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="e.g. face, person, cup, sky"
                                                                                   Foreground="#9CA3AF" FontSize="12" Margin="10,0,0,0"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- Prompt -->
                                    <TextBlock Text="Replace with" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" Margin="0,12,0,4"/>
                                    <TextBlock Text="Describe what should appear in the detected area"
                                               FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KleinInpaintEditor.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="80" MaxHeight="140"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="13" Padding="8"
                                             BorderBrush="#CED4DA" BorderThickness="1"/>
                                </StackPanel>
                            </Border>

                            <!-- Generation Settings -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Generation Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#8B5CF6"/>

                                    <!-- Steps -->
                                    <Grid Margin="0,6,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Steps" FontSize="12" VerticalAlignment="Center" Foreground="#374151"/>
                                        <Slider Grid.Column="1" Minimum="1" Maximum="30"
                                                Value="{Binding KleinInpaintEditor.Steps, Mode=TwoWay}"
                                                VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="2" Text="{Binding KleinInpaintEditor.Steps}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="#8B5CF6" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- CFG -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CFG" FontSize="12" VerticalAlignment="Center" Foreground="#374151"/>
                                        <Slider Grid.Column="1" Minimum="1" Maximum="10"
                                                Value="{Binding KleinInpaintEditor.Cfg, Mode=TwoWay}"
                                                VerticalAlignment="Center" TickFrequency="0.5" IsSnapToTickEnabled="False"/>
                                        <TextBlock Grid.Column="2" Text="{Binding KleinInpaintEditor.CfgText}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="#8B5CF6" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Denoise -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Denoise" FontSize="12" VerticalAlignment="Center" Foreground="#374151"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                Value="{Binding KleinInpaintEditor.Denoise, Mode=TwoWay}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding KleinInpaintEditor.DenoiseText}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="#8B5CF6" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- LoRA Strength -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="LoRA" FontSize="12" VerticalAlignment="Center" Foreground="#374151"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="4"
                                                Value="{Binding KleinInpaintEditor.LoraStrength, Mode=TwoWay}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding KleinInpaintEditor.LoraStrengthText}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="#8B5CF6" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Models (collapsible) -->
                                    <Expander Header="Models" Margin="0,10,0,0" FontSize="12"
                                              Foreground="#6B7280" IsExpanded="False">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="UNET" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding KleinInpaintEditor.UnetName, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30" FontSize="11" Padding="6,4"
                                                     BorderBrush="#CED4DA" BorderThickness="1" Margin="0,0,0,8"
                                                     FontFamily="Consolas"/>
                                            <TextBlock Text="LoRA" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding KleinInpaintEditor.LoraName, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30" FontSize="11" Padding="6,4"
                                                     BorderBrush="#CED4DA" BorderThickness="1"
                                                     FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Generate -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <Button Content="⚡ Generate"
                                            Command="{Binding KleinInpaintEditor.GenerateCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="#8B5CF6"
                                            IsEnabled="{Binding KleinInpaintEditor.CanGenerate}"
                                            Padding="20,12" FontSize="14" HorizontalAlignment="Stretch"/>

                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding KleinInpaintEditor.IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding KleinInpaintEditor.StatusMessage}"
                                                       FontSize="12" Foreground="#495057"/>
                                            <TextBlock Text="{Binding KleinInpaintEditor.ProgressText}"
                                                       FontSize="12" Foreground="#8B5CF6" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding KleinInpaintEditor.Progress}" Maximum="100" Height="8"
                                                     Foreground="#8B5CF6" Background="#E5E7EB"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding KleinInpaintEditor.StatusMessage}"
                                               FontSize="12" Foreground="#6B7280" Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- RIGHT: Result + Log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">

                            <!-- Pipeline info badge -->
                            <Border Background="#F3F0FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Klein Flux 2 — Auto Inpaint" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#7C3AED"/>
                                    <TextBlock FontSize="11" Foreground="#6D28D9" Margin="0,4,0,0" TextWrapping="Wrap">
                                        Florence2 detects the subject → SAM2 creates a precise mask → Klein model replaces it seamlessly
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}" Foreground="#8B5CF6"/>
                                    <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                            Background="#1A1A2E" Height="420" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding KleinInpaintEditor.ResultImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding KleinInpaintEditor.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here" FontSize="14"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}" Foreground="#8B5CF6"/>
                                    <TextBlock Text="{Binding KleinInpaintEditor.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding KleinInpaintEditor.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#8B5CF6" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding KleinInpaintEditor.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#10B981" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KleinInpaintEditor.LogOutput}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="#111827" Foreground="#9CA3AF"
                                             BorderThickness="0" FontFamily="Consolas"
                                             FontSize="11" Padding="4" Height="200"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>

            <!-- ===== CONTROL: Klein Flux 2 Control Net (reference + pose → analyze → generate) ===== -->
            <TabItem Header="🎛️ Control" FontWeight="Bold" FontSize="13">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,12,8,12">

                            <!-- Pipeline badge -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎛️ Klein Flux 2 — Control Net" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#1D4ED8"/>
                                    <TextBlock FontSize="11" Foreground="#3B82F6" Margin="0,4,0,0" TextWrapping="Wrap">
                                        Upload a reference image (subject) and a pose image. Click Analyze to let
                                        QwenVL generate a prompt, then edit it and click Generate.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Reference image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Reference Image (subject)" Style="{StaticResource HeaderTextStyle}" Foreground="#1D4ED8"/>
                                    <TextBlock Text="{Binding KleinControl.RefImagePath, FallbackValue='No image selected'}"
                                               FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Reference"
                                            Command="{Binding KleinControl.BrowseRefImageCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Background="#1D4ED8" Padding="12,8" FontSize="12" Margin="0,0,0,8"/>
                                    <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                            Background="#1A1A2E" Height="180" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding KleinControl.RefImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding KleinControl.NoRefImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Reference image" FontSize="12" Foreground="#9CA3AF"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Pose image / video picker -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Pose Image / Video (DWPose source + analysis)" Style="{StaticResource HeaderTextStyle}" Foreground="#7C3AED"/>

                                    <!-- Browse row: image OR video -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="📂 Browse Image"
                                                Command="{Binding KleinControl.BrowsePoseImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#7C3AED" Padding="10,7" FontSize="12" Margin="0,0,6,0"/>
                                        <Button Content="🎬 Browse Video"
                                                Command="{Binding KleinControl.BrowseVideoCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#4F46E5" Padding="10,7" FontSize="12"/>
                                    </StackPanel>

                                    <!-- IMAGE MODE: shown when no video loaded -->
                                    <StackPanel Visibility="{Binding KleinControl.NoVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding KleinControl.PoseImagePath, FallbackValue='No image selected'}"
                                                   FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                        <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                                Background="#1A1A2E" Height="180" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding KleinControl.PoseImageSource}"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding KleinControl.NoPoseImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="🕴️" FontSize="36" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Browse an image or video" FontSize="12" Foreground="#9CA3AF"
                                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- VIDEO MODE: shown when video is loaded -->
                                    <StackPanel Visibility="{Binding KleinControl.HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <!-- Video info -->
                                        <Border Background="#EDE9FE" BorderBrush="#C4B5FD" BorderThickness="1" CornerRadius="4"
                                                Padding="8,5" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding KleinControl.VideoInfoText}" FontSize="11" Foreground="#5B21B6"/>
                                        </Border>

                                        <!-- Frame preview -->
                                        <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                                Background="#1A1A2E" Height="200" ClipToBounds="True" Margin="0,0,0,8">
                                            <Grid>
                                                <Image Source="{Binding KleinControl.FramePreviewSource}"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding KleinControl.NoFramePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="🎞️" FontSize="36" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Loading frame..." FontSize="12" Foreground="#9CA3AF"
                                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <!-- Extracting spinner overlay -->
                                                <Border Background="#80000000" CornerRadius="4"
                                                        Visibility="{Binding KleinControl.IsExtractingFrame, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="⏳ Extracting..." FontSize="13" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Seek slider -->
                                        <Slider Value="{Binding KleinControl.FramePositionSeconds, Mode=TwoWay}"
                                                Minimum="0" Maximum="{Binding KleinControl.VideoDurationSeconds}"
                                                TickFrequency="1" IsSnapToTickEnabled="False"
                                                Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding KleinControl.FramePositionText}"
                                                   FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"/>

                                        <!-- Use This Frame button + set indicator -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📌 Use This Frame"
                                                    Command="{Binding KleinControl.UseFrameCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Background="#7C3AED" Padding="12,8" FontSize="12"/>
                                            <Border Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,4" Margin="8,0,0,0"
                                                    Visibility="{Binding KleinControl.HasPoseImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="✓ Frame set" FontSize="11" Foreground="#059669" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- Analyze button -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 1 — Analyze" Style="{StaticResource HeaderTextStyle}" Foreground="#059669"/>
                                    <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,8" TextWrapping="Wrap">
                                        Runs QwenVL inside ComfyUI to analyze the pose image and generate a prompt.
                                        Also produces a first generated image.
                                    </TextBlock>
                                    <Button Content="🔍 Analyze"
                                            Command="{Binding KleinControl.AnalyzeCommand}"
                                            IsEnabled="{Binding KleinControl.CanAnalyze}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="#059669" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding KleinControl.IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="⏳ " FontSize="13"/>
                                        <TextBlock Text="{Binding KleinControl.StatusMessage}" FontSize="12" Foreground="#374151"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Prompt editor -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 2 — Edit Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#D97706"/>
                                    <TextBox Text="{Binding KleinControl.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             MinLines="5" MaxLines="10"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="12" Padding="8"
                                             Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Generate button -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 3 — Generate" Style="{StaticResource HeaderTextStyle}" Foreground="#DC2626"/>
                                    <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,8" TextWrapping="Wrap">
                                        Sends the edited prompt to ComfyUI with your reference and pose images.
                                    </TextBlock>
                                    <Button Content="🚀 Generate"
                                            Command="{Binding KleinControl.GenerateCommand}"
                                            IsEnabled="{Binding KleinControl.CanGenerate}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="#DC2626" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding KleinControl.StatusMessage}"
                                                   FontSize="12" Foreground="#374151" TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding KleinControl.Progress}" Maximum="100" Height="6"
                                                     Margin="0,4,0,0" Background="#E5E7EB" Foreground="#DC2626"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#DEE2E6"/>

                    <!-- RIGHT: result + log -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12,15,12">

                            <!-- Info badge -->
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Klein Flux 2 — Control Net Pipeline" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#15803D"/>
                                    <TextBlock FontSize="11" Foreground="#166534" Margin="0,4,0,0" TextWrapping="Wrap">
                                        QwenVL analyzes the pose image → DWPose extracts skeleton → Klein Flux 2 generates
                                        with your reference subject in the target pose
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}" Foreground="#1D4ED8"/>
                                    <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                            Background="#1A1A2E" Height="420" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding KleinControl.ResultImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding KleinControl.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here" FontSize="14"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}" Foreground="#1D4ED8"/>
                                    <TextBlock Text="{Binding KleinControl.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding KleinControl.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#1D4ED8" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding KleinControl.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#10B981" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KleinControl.LogOutput}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="#111827" Foreground="#9CA3AF"
                                             BorderThickness="0" FontFamily="Consolas"
                                             FontSize="11" Padding="4" Height="200"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>

            <!-- ===== IDEOGRAM: Image → LLM prompt → Ideogram v4 generation ===== -->
            <TabItem Header="🔤 Ideogram" FontWeight="Bold" FontSize="13">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="12,12,12,12">
                        <StackPanel>

                            <!-- Input image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Input Image" Style="{StaticResource HeaderTextStyle}" Foreground="#E11D48"/>
                                    <TextBlock Text="{Binding Ideogram.InputImagePath, FallbackValue='No image selected'}"
                                               FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <Button Content="📂 Browse Image"
                                            Command="{Binding Ideogram.BrowseImageCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Background="#E11D48" Padding="12,8" FontSize="12" Margin="0,0,0,8"/>
                                    <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                            Background="#1A1A2E" Height="200" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Ideogram.InputImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding Ideogram.NoInputImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Upload an image to analyze" FontSize="12" Foreground="#9CA3AF"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- LLM Model -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="LLM Model" Style="{StaticResource HeaderTextStyle}" Foreground="#7C3AED"/>
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Ideogram.AvailableModels}"
                                                  SelectedItem="{Binding Ideogram.SelectedLlmModel}"
                                                  FontSize="12" Padding="6,4" Margin="0,0,6,0"/>
                                        <Button Grid.Column="1" Content="🔄"
                                                Command="{Binding Ideogram.LoadModelsCommand}"
                                                FontSize="14" Padding="8,4" ToolTip="Refresh models"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#7C3AED"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Analyze -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 1 — Analyze Image" Style="{StaticResource HeaderTextStyle}" Foreground="#059669"/>
                                    <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,8" TextWrapping="Wrap">
                                        Sends the image to the LLM with the Ideogram prompt optimizer. Returns an enhanced prompt.
                                    </TextBlock>
                                    <Button Content="🔍 Analyze"
                                            Command="{Binding Ideogram.AnalyzeCommand}"
                                            IsEnabled="{Binding Ideogram.CanAnalyze}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="#059669" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding Ideogram.IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="⏳ " FontSize="13"/>
                                        <TextBlock Text="{Binding Ideogram.StatusMessage}" FontSize="12" Foreground="#374151"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Prompt editor -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 2 — Edit Prompt" Style="{StaticResource HeaderTextStyle}" Foreground="#D97706"/>
                                    <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,4">
                                        <Run Text="Detected aspect ratio: "/><Run Text="{Binding Ideogram.DetectedAspectRatio, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                    <TextBox Text="{Binding Ideogram.IdeogramPrompt, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             MinLines="5" MaxLines="12"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="12" Padding="8"
                                             Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Generate -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Step 3 — Generate" Style="{StaticResource HeaderTextStyle}" Foreground="#DC2626"/>
                                    <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,8" TextWrapping="Wrap">
                                        Sends the prompt to ComfyUI with the Ideogram v4 workflow.
                                    </TextBlock>
                                    <Button Content="🚀 Generate"
                                            Command="{Binding Ideogram.GenerateCommand}"
                                            IsEnabled="{Binding Ideogram.CanGenerate}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="#DC2626" Padding="16,10" FontSize="13"
                                            HorizontalAlignment="Stretch"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Ideogram.StatusMessage}"
                                                   FontSize="12" Foreground="#374151" TextWrapping="Wrap"/>
                                        <ProgressBar Value="{Binding Ideogram.Progress}" Maximum="100" Height="6"
                                                     Margin="0,4,0,0" Background="#E5E7EB" Foreground="#DC2626"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Queue Section -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Queue" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>

                                    <!-- Queue buttons -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="➕ Add to Queue"
                                                Command="{Binding Ideogram.AddToQueueCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Background="#6366F1" Padding="10,8" FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="▶ Start"
                                                Command="{Binding Ideogram.ProcessQueueCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#059669" Padding="12,8" FontSize="12" Margin="6,0,0,0"/>
                                        <Button Grid.Column="2" Content="⏹ Stop"
                                                Command="{Binding Ideogram.CancelQueueCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#DC2626" Padding="10,8" FontSize="12" Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- Queue status -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#6366F1" CornerRadius="10" Padding="6,2">
                                            <TextBlock Text="{Binding Ideogram.QueueCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="waiting..."
                                                   FontSize="11" Foreground="#6366F1" FontStyle="Italic" Margin="8,0,0,0"
                                                   Visibility="{Binding Ideogram.IsWaitingForLease, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="processing..."
                                                   FontSize="11" Foreground="#059669" FontStyle="Italic" Margin="8,0,0,0"
                                                   Visibility="{Binding Ideogram.IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Queue items list -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <ItemsControl ItemsSource="{Binding Ideogram.Queue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Item info -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayPrompt}" FontSize="11" FontWeight="Medium"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding RatioDisplay}" FontSize="10" Foreground="#6B7280"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Status -->
                                                            <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="8,0"/>
                                                            <ProgressBar Grid.Column="1" Value="{Binding Progress}" Width="40" Height="8" Margin="8,0">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>

                                                            <!-- Actions -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="🖼️" Command="{Binding OpenImageCommand}" FontSize="12"
                                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2"
                                                                        ToolTip="Open image">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="✕" FontSize="11" Foreground="#EF4444" FontWeight="Bold"
                                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0"
                                                                        ToolTip="Remove">
                                                                    <Button.InputBindings>
                                                                        <MouseBinding Gesture="LeftClick"/>
                                                                    </Button.InputBindings>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Button Content="Clear All" Command="{Binding Ideogram.ClearQueueCommand}"
                                            HorizontalAlignment="Right" Background="#6B7280" Foreground="White"
                                            BorderThickness="0" Padding="8,3" FontSize="10" Cursor="Hand" Margin="0,4,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Column separator -->
                    <Border Grid.Column="1" Background="#E5E7EB" Margin="0,10,0,10"/>

                    <!-- RIGHT COLUMN: Result -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,12,12,12">
                        <StackPanel>

                            <!-- Result image -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Result" Style="{StaticResource HeaderTextStyle}" Foreground="#E11D48"/>
                                    <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                            Background="#1A1A2E" Height="420" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Ideogram.ResultImageSource}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding Ideogram.NoResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Result will appear here" FontSize="14"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource HeaderTextStyle}" Foreground="#E11D48"/>
                                    <TextBlock Text="{Binding Ideogram.ResultImagePath, FallbackValue='—'}"
                                               FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📁 Open Folder"
                                                Command="{Binding Ideogram.OpenResultFolderCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#E11D48" Padding="12,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="🖼️ Open Image"
                                                Command="{Binding Ideogram.OpenResultImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Background="#10B981" Padding="12,8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log -->
                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Ideogram.LogOutput}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="#111827" Foreground="#9CA3AF"
                                             BorderThickness="0" FontFamily="Consolas"
                                             FontSize="11" Padding="4" Height="200"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
