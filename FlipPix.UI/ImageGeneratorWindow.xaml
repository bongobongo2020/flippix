                                          Height="32"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          FontSize="12"/>
                                <!-- Settings gear -->
                                <Button Command="{Binding StoryGeneratorQ.ToggleSettingsVisibilityCommand}"
