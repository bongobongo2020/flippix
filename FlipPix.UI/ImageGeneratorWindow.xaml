                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StoryGeneratorQ.ShowLoRAOption}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <CheckBox Content="Use LoRA"
                                              IsChecked="{Binding StoryGeneratorQ.UseLoRA, Mode=TwoWay}"
                                              FontSize="12"
                                              FontWeight="SemiBold"
                                              Foreground="#374151"/>
                                </StackPanel>
                            </Grid>
                        </Border>

