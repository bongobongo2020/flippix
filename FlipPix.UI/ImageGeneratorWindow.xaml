                                           AcceptsReturn="True"
                                           Height="60"
                                           Padding="12"
                                           VerticalScrollBarVisibility="Auto"
                                           Background="White"
                                           BorderBrush="#D1D5DB"
                                           FontSize="12">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>

                                <!-- LoRA Toggle (FireRed only) -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Margin="0,12,0,0">
