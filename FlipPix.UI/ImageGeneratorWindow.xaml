                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryGeneratorQ.ShowKreaLoraOption}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="🔧 Krea2 LoRA" FontWeight="SemiBold" FontSize="13" Foreground="#6D28D9" Margin="0,0,0,8"/>
