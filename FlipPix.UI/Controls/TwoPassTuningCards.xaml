<UserControl x:Class="FlipPix.UI.Controls.TwoPassTuningCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:FlipPix.UI.Controls">
    <!--
        🌹 ErosMax Turbo 2-Pass · SAMPLING, ATTENTION, OUTPUT and REFMODS cards, shared by 🌀 MiniMax I2V and
        🎬 H3 Video Editor. Binds to the host's DataContext: TwoPass and the TwoPass*/RefMod* lists, summaries
        and commands both view models expose under the same names. TwoPassFrameGenAvailable shows the FrameGen
        rows. The host sets the cards' visibility.
    -->
    <StackPanel>
        <Border Style="{StaticResource SectionCardStyle}">
            <StackPanel>
                <ctrl:SectionHeader Title="🌹 2-PASS · SAMPLING" Note="" Margin="0,0,0,8"/>
                <TextBlock Text="Sampler (both passes)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding TwoPassSamplerOptions}" SelectedItem="{Binding TwoPass.Sampler}" Height="28" FontSize="11"
                          ToolTip="KSamplerSelect. er_sde as authored."/>
                <TextBlock Text="First pass" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding TwoPassSchedulerOptions}" SelectedItem="{Binding TwoPass.FirstPassScheduler}" Height="26" FontSize="11" Margin="0,0,6,0"
                              ToolTip="'Scheduler First Pass'. sgm_uniform as authored."/>
                    <Slider Grid.Column="1" Minimum="2" Maximum="16" Value="{Binding TwoPass.FirstPassSteps}" TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"
                            ToolTip="First-pass steps, 8 as authored. More can add detail and better audio; past 8 the returns diminish."/>
                    <TextBlock Grid.Column="2" Text="{Binding TwoPass.FirstPassSteps, StringFormat={}{0} steps}" FontFamily="Consolas" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                </Grid>
                <TextBlock Text="Latent upscaler" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding TwoPassUpscalerOptions}" SelectedItem="{Binding TwoPass.LatentUpscaler}" Height="26" FontSize="11"
                          ToolTip="MinimaxH3LatentUpscaler3D, 'megapixels' mode to the final target. The 3D fp16 upscaler as authored."/>
                <TextBlock Text="Second pass (refine)" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel IsEnabled="{Binding TwoPassUsesScheduler2}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding TwoPassSchedulerOptions}" SelectedItem="{Binding TwoPass.SecondPassScheduler}" Height="26" FontSize="11" Margin="0,0,6,0"
                                  ToolTip="'Scheduler Second Pass'. beta as authored."/>
                        <Slider Grid.Column="1" Minimum="1" Maximum="10" Value="{Binding TwoPass.SecondPassSteps}" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"
                                ToolTip="Refining steps, 3 as authored (fast). The author's quality recipe: 4–6 with sparse attention off."/>
                        <TextBlock Grid.Column="2" Text="{Binding TwoPass.SecondPassSteps, StringFormat={}{0} steps}" FontFamily="Consolas" FontSize="11" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="denoise" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Slider Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding TwoPass.SecondPassDenoise}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,0"
                                Foreground="{DynamicResource TabAccentBrush}" ToolTip="How much of the noise range the refinement re-runs. 0.40 as authored."/>
                        <TextBlock Grid.Column="2" Text="{Binding TwoPass.SecondPassDenoise, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                    </Grid>
                </StackPanel>
                <CheckBox Content="Manual second-pass sigmas instead" IsChecked="{Binding TwoPass.UseManualSigmas}" FontSize="11" Margin="0,6,0,2"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          ToolTip="'Manual Second Pass Sigmas': the refinement's noise range written out by hand. Use the scheduler or manual, not both. Off as authored."/>
                <TextBox Text="{Binding TwoPass.ManualSigmas, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding TwoPass.UseManualSigmas}"
                         Height="26" Padding="6,0" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="11"
                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                         ToolTip="Comma-separated, descending to 0. The workflow's: 0.9035, 0.6316, 0.3158, 0.000."/>
                <TextBlock Text="{Binding TwoPassSamplingSummary}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <CheckBox Content="Export the first pass's audio" IsChecked="{Binding TwoPass.UseFirstPassAudio}" FontSize="11" Margin="0,8,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          ToolTip="'Use first pass audio?' On as authored: the soundtrack comes from pass 1. Off exports pass 2's. A preview always uses pass 1's."/>
                <CheckBox Content="Live preview of the refining pass too" IsChecked="{Binding TwoPass.LivePreviewRefiningPass}" FontSize="11" Margin="0,4,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          ToolTip="The workflow previews the first pass only. On adds the same preview node to the second pass, so the clip on the right keeps sharpening through the refinement. Display only — the video is the same either way."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}">
            <StackPanel>
                <ctrl:SectionHeader Title="🌹 2-PASS · ATTENTION" Note="" Margin="0,0,0,8"/>
                <TextBlock Text="Attention backend" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding TwoPassAttentionOptions}" SelectedItem="{Binding TwoPass.AttentionBackend}" Height="28" FontSize="11"
                          ToolTip="ModelAttentionBackend. comfy kitchen attention (quantized INT8, Nvidia/AMD) as authored."/>
                <CheckBox Content="Block-sparse attention" IsChecked="{Binding TwoPass.UseSparseAttention}" FontSize="11" Margin="0,8,0,2"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          ToolTip="BlockSparseAttention — on as authored (VSA, keep 10%, blocks 0 and 1 dense). The author's quality recipe turns it off and raises the second-pass steps."/>
                <StackPanel Margin="18,2,0,0" Visibility="{Binding TwoPass.UseSparseAttention, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="method" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TwoPassSparseMethods}" SelectedItem="{Binding TwoPass.SparseMethod}" Height="26" FontSize="11"
                                  ToolTip="vsa (as authored) and sla keep a percentage of key blocks; sol-attn picks them per head with an adaptive threshold (tau)."/>
                    </Grid>
                    <Grid Margin="0,4,0,0" Visibility="{Binding TwoPassUsesKeepPercent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="keep %" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Slider Grid.Column="1" Minimum="0.5" Maximum="95" Value="{Binding TwoPass.SparseKeepPercent}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="8,0"
                                Foreground="{DynamicResource TabAccentBrush}" ToolTip="keep_percent. 10 as authored."/>
                        <TextBlock Grid.Column="2" Text="{Binding TwoPass.SparseKeepPercent, StringFormat={}{0:0.#}}" FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                    </Grid>
                    <Grid Margin="0,4,0,0" Visibility="{Binding TwoPassUsesTau, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="tau" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="4" Value="{Binding TwoPass.SparseTau}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,0"
                                Foreground="{DynamicResource TabAccentBrush}" ToolTip="sol-attn threshold. Higher is sparser."/>
                        <TextBlock Grid.Column="2" Text="{Binding TwoPass.SparseTau, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="start" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding TwoPass.SparseStart}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,0"
                                Foreground="{DynamicResource TabAccentBrush}" ToolTip="start_percent. 0 as authored."/>
                        <TextBlock Grid.Column="2" Text="{Binding TwoPass.SparseStart, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="end" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding TwoPass.SparseEnd}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,0"
                                Foreground="{DynamicResource TabAccentBrush}" ToolTip="end_percent. 1 as authored."/>
                        <TextBlock Grid.Column="2" Text="{Binding TwoPass.SparseEnd, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="dense blocks" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="1" Text="{Binding TwoPass.DenseBlocks, UpdateSourceTrigger=LostFocus}" Height="24" FontFamily="Consolas" FontSize="11" Padding="4,0"
                                 VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                 ToolTip="Transformer blocks that always run dense, e.g. '0, 1, 47-49'. '0,1' as authored."/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="sink" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TwoPassSinkOptions}" SelectedItem="{Binding TwoPass.SinkConditioning}" Height="24" FontSize="11"
                                  ToolTip="exact_kv_and_rows (as authored) keeps the generated audio rows dense; exact_kv attends the reference rows exactly at ~3% cost."/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}">
            <StackPanel>
                <ctrl:SectionHeader Title="🌹 2-PASS · OUTPUT" Note="" Margin="0,0,0,8"/>
                <CheckBox Content="RTX Video Super Resolution" IsChecked="{Binding TwoPass.UseRtxUpscale}" FontSize="11"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          ToolTip="Runs after decoding and raises the exported resolution. On at ×1.2, ULTRA as authored; off keeps the decoded size."/>
                <StackPanel Margin="18,2,0,0" Visibility="{Binding TwoPass.UseRtxUpscale, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="scale" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Slider Grid.Column="1" Minimum="1" Maximum="4" Value="{Binding TwoPass.RtxScale}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="8,0"
                                Foreground="{DynamicResource TabAccentBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding TwoPass.RtxScale, StringFormat=×{0:0.0}}" FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                    </Grid>
                    <ComboBox ItemsSource="{Binding TwoPassRtxQualityOptions}" SelectedItem="{Binding TwoPass.RtxQuality}" Height="24" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Visibility="{Binding TwoPassFrameGenAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="RTX FrameGen multiplier" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="1" Maximum="5" Value="{Binding TwoPass.FrameGenMultiplier}" TickFrequency="1" IsSnapToTickEnabled="True"
                                Foreground="{DynamicResource TabAccentBrush}"
                                ToolTip="Sets interpolation and export fps together: 1× skips FrameGen (24 fps), 2×/3×/4×/5× save 48/72/96/120 fps. Normal mode only. Compute and memory hungry."/>
                        <TextBlock Grid.Column="1" Text="{Binding TwoPass.FrameGenMultiplier, StringFormat=×{0}}" FontFamily="Consolas" FontSize="11" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                    </Grid>
                    <TextBlock Text="{Binding TwoPassFrameGenNote}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                    <ComboBox ItemsSource="{Binding TwoPassFrameGenModes}" SelectedItem="{Binding TwoPass.FrameGenMode}" Height="24" FontSize="11" Margin="0,4,0,0"
                              ToolTip="Frame-generation quality mode. HIGH as authored."/>
                </StackPanel>

                <TextBlock Text="Output grain (Lokken, 0 = off)" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="0.03" Value="{Binding TwoPass.GrainStrength}" TickFrequency="0.001" IsSnapToTickEnabled="True"
                            Foreground="{DynamicResource TabAccentBrush}"
                            ToolTip="Film grain added during encoding, after RTX. 0.005 as authored; 0.005–0.010 recommended. In Continue mode only the new segment gets grain. Needs Lokken VideoTools on the server."/>
                    <TextBlock Grid.Column="1" Text="{Binding TwoPass.GrainStrength, StringFormat={}{0:0.000}}" FontFamily="Consolas" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CRF" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="35" Value="{Binding TwoPass.Crf}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0"
                            Foreground="{DynamicResource TabAccentBrush}" ToolTip="H.264 quality. 18 as authored; lower is larger and cleaner."/>
                    <TextBlock Grid.Column="2" Text="{Binding TwoPass.Crf}" FontFamily="Consolas" FontSize="11"
                               VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                </Grid>
                <TextBlock Text="Encoder preset" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding TwoPassEncoderPresets}" SelectedItem="{Binding TwoPass.EncoderPreset}" Height="26" FontSize="11"
                          ToolTip="'Output saving quality — encoder preset'. medium as authored: faster presets give bigger files at lower quality, slower ones better H.264 at longer encodes."/>
                <TextBlock Text="{Binding TwoPassOutputSummary}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ctrl:SectionHeader Title="🌹 2-PASS · REFMODS" Note="  · optional" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="＋ Add" Height="22" Padding="8,0" FontSize="10"
                            Command="{Binding AddRefModCommand}" Style="{StaticResource AccentOutlineButtonStyle}"
                            ToolTip="Add a RefMod slot — a saved reference from models/refmods (ComfyUI-MiniMaxH3Mod). Up to eight."/>
                    <Button Grid.Column="2" Content="&#x27F3;" Width="24" Height="22" FontSize="11" Margin="4,0,0,0" Padding="0"
                            Command="{Binding RefreshRefModsCommand}"
                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            ToolTip="Re-read models/refmods from ComfyUI."/>
                </Grid>
                <TextBlock TextWrapping="Wrap" FontSize="10" Margin="0,0,0,6" Foreground="{StaticResource TextMutedBrush}"
                           Text="Applied once to the conditioning both passes read, in Normal and Continue mode. Describe the subject in the prompt — file names and &lt;Subject N&gt; do not bind to slots. Start with one copy."/>
                <ItemsControl ItemsSource="{Binding TwoPassRefMods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="6" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding DataContext.RefModOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding Mod, Mode=TwoWay}" Height="26" FontSize="11" Margin="0,0,4,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.RefModComponentOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding Components, Mode=TwoWay}" Height="26" FontSize="11"
                                                  ToolTip="Visual loads appearance references, Audio audio references, All both."/>
                                        <Button Grid.Column="2" Content="&#x2715;" Width="22" Height="26" FontSize="10" Margin="4,0,0,0" Padding="0"
                                                Command="{Binding DataContext.RemoveRefModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextMutedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="strength" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Strength}" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                Foreground="{DynamicResource TabAccentBrush}" ToolTip="1.0 = the full reference; lower blurs it toward a softened copy. 0 disables the slot."/>
                                        <TextBlock Grid.Column="2" Text="{Binding Strength, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="11" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="copies" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Slider Grid.Column="1" Minimum="1" Maximum="10" Value="{Binding Copies}" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Foreground="{DynamicResource TabAccentBrush}" ToolTip="The same reference injected N times — noticeably stronger, and more tokens."/>
                                        <TextBlock Grid.Column="2" Text="{Binding Copies, StringFormat=×{0}}" FontFamily="Consolas" FontSize="11" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="visual" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding VisualStrength}" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                Foreground="{DynamicResource TabAccentBrush}" ToolTip="Multiplies the slot strength for its visual half. 0 skips it."/>
                                        <TextBlock Grid.Column="2" Text="{Binding VisualStrength, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="11" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="audio" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AudioStrength}" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                Foreground="{DynamicResource TabAccentBrush}" ToolTip="Multiplies the slot strength for its audio half. Voice cloning is not established."/>
                                        <TextBlock Grid.Column="2" Text="{Binding AudioStrength, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="11" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander Header="Apply settings" IsExpanded="False" FontSize="11">
                    <StackPanel Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="retention" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding TwoPass.RefModRetention}" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    Foreground="{DynamicResource TabAccentBrush}"
                                    ToolTip="Master reference strength: 1.0 fully preserved, 0.7 partially, 0.4 attribute transfer, 0.15 weak."/>
                            <TextBlock Grid.Column="2" Text="{Binding TwoPass.RefModRetention, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="11" TextAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                        </Grid>
                        <TextBlock Text="curve direction / shape" FontSize="10" Margin="0,6,0,2" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding RefModCurveDirections}" SelectedItem="{Binding TwoPass.RefModCurveDirection}" Height="24" FontSize="11" Margin="0,0,4,0"
                                      ToolTip="Weighting across each mod's own reference frames — which reference content dominates, not where it appears in the video."/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RefModCurveShapes}" SelectedItem="{Binding TwoPass.RefModCurveShape}" Height="24" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="curve value" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding TwoPass.RefModCurveValue}" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    Foreground="{DynamicResource TabAccentBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding TwoPass.RefModCurveValue, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="11" TextAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TabAccentBrush}"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="scramble seed (-1 = off)" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding TwoPass.RefModScrambleSeed, UpdateSourceTrigger=LostFocus}" Height="24" FontFamily="Consolas" FontSize="11"
                                     VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}"
                                     ToolTip="With 2+ refs in a bundle, a seed ≥ 0 shuffles them so a different one leads each run."/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="max total tokens (0 = no limit)" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding TwoPass.RefModMaxTokens, UpdateSourceTrigger=LostFocus}" Height="24" FontFamily="Consolas" FontSize="11"
                                     VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
