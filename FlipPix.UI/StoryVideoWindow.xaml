<Window x:Class="FlipPix.UI.StoryVideoWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlipPix - Story Video Generator" Height="850" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="750" MinWidth="900"
        ResizeMode="CanResize">

    <Window.Resources>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#9C27B0" Offset="0"/>
                    <GradientStop Color="#E91E63" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="25,20">
                <TextBlock Text="Story Video Generator"
                          FontSize="28" FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Load prompts and generate a story video with multiple clips"
                          FontSize="13" Foreground="#FFFAF0"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,15,20,15">

                <!-- Step 1: Load Prompts -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Step 1: Load Story Prompts" Style="{StaticResource HeaderTextStyle}" Foreground="#9C27B0"/>
                        <TextBlock Text="Load a JSON file containing your story prompts or manually edit them below"
                                   FontSize="12"
                                   Foreground="#666"
                                   Margin="0,0,0,15"/>

                        <!-- Save/Load Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="Load Prompts"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Command="{Binding LoadPromptsCommand}"
                                   Width="120"
                                   Height="35"
                                   Margin="0,0,10,0"/>
                            <Button Content="Save Prompts"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding SavePromptsCommand}"
                                   Width="120"
                                   Height="35"/>
                        </StackPanel>

                        <!-- Prompts Display -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 1:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 2:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 3:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 4:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 5:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 6:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 7:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt7, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 8:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt8, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Prompt 9:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt9, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Prompt 10:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt10, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Step 2: Generate Video -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Step 2: Generate Story Video" Style="{StaticResource HeaderTextStyle}" Foreground="#9C27B0"/>

                        <!-- Workflow Selection -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="🎬 Video Workflow" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding WorkflowNames}"
                                      SelectedIndex="{Binding SelectedWorkflowIndex, Mode=TwoWay}"
                                      Padding="10"
                                      Background="White"
                                      BorderBrush="#CED4DA"
                                      FontSize="11"/>
                            <TextBlock Text="Select the workflow for video generation"
                                      FontSize="10"
                                      Foreground="#999"
                                      Margin="0,5,0,0"/>
                            <TextBlock>
                                <Run Text="Currently selected: " FontWeight="SemiBold"/>
                                <Run Text="{Binding SelectedWorkflowName}" Foreground="#4CAF50"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="This will generate video clips for each prompt using the selected workflow"
                                   FontSize="12"
                                   Foreground="#666"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="⚠ Note: Video generation can take 2-10 minutes per clip depending on your hardware"
                                   FontSize="11"
                                   Foreground="#E91E63"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <Button Content="Generate Story Video"
                               Style="{StaticResource PrimaryButtonStyle}"
                               Command="{Binding GenerateVideoCommand}"
                               Width="250"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,15"/>

                        <!-- Processing Status -->
                        <Border Background="#FFF9F0"
                                BorderBrush="#FFE0B0"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="15"
                                Margin="0,0,0,15"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ProcessingStatus}"
                                          FontWeight="SemiBold"
                                          FontSize="12"
                                          Margin="0,0,0,8"
                                          TextWrapping="Wrap"/>
                                <ProgressBar Value="{Binding ProcessingProgress}"
                                            Height="20"
                                            Foreground="#9C27B0"
                                            Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding ProgressPercentage}"
                                          HorizontalAlignment="Center"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          Foreground="#9C27B0"/>
                            </StackPanel>
                        </Border>

                        <!-- Result Video -->
                        <StackPanel Visibility="{Binding HasResultVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="✓ Videos Generated Successfully!"
                                      FontWeight="Bold"
                                      FontSize="14"
                                      Foreground="#4CAF50"
                                      Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding ResultVideoPath}"
                                      FontSize="11"
                                      Foreground="#666"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,10"/>

                            <Button Content="Open Output Folder"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding OpenResultFolderCommand}"
                                   Width="200"
                                   HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Log (Collapsible) -->
                <Expander Header="Processing Log"
                         IsExpanded="True"
                         Margin="0,0,0,0">
                    <Border Background="White"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="200"
                                     VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LogOutput}"
                                    TextWrapping="Wrap"
                                    IsReadOnly="True"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10"/>
                        </ScrollViewer>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
