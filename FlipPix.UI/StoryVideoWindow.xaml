<Window x:Class="FlipPix.UI.StoryVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlipPix - Story Video Generator" Height="850" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="750" MinWidth="900"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF6B35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8556"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66BB6A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#9C27B0" Offset="0"/>
                    <GradientStop Color="#E91E63" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="25,20">
                <TextBlock Text="Story Video Generator"
                          FontSize="28" FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Generate 4 video prompts from an image, then create a story video"
                          FontSize="13" Foreground="#FFFAF0"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,15,20,15">

                <!-- Step 1: Select Image -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Step 1: Select Image" Style="{StaticResource HeaderTextStyle}" Foreground="#9C27B0"/>
                            <TextBlock Text="Choose an image to generate story prompts from"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,15"/>

                            <Button Content="Select Image"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Command="{Binding SelectImageCommand}"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,15"/>

                            <TextBlock Text="{Binding SelectedImagePath}"
                                      FontSize="11"
                                      Foreground="#666"
                                      TextWrapping="Wrap"
                                      Visibility="{Binding HasSelectedImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                BorderBrush="#DEE2E6"
                                BorderThickness="2"
                                Background="White"
                                CornerRadius="5"
                                Height="200">
                            <Grid>
                                <TextBlock Text="No image selected"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="#999"
                                          FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedImage}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Image Source="{Binding SelectedImageSource}"
                                       Stretch="Uniform"
                                       Visibility="{Binding HasSelectedImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 2: Generate Prompts -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Step 2: Generate Story Prompts" Style="{StaticResource HeaderTextStyle}" Foreground="#9C27B0"/>

                        <TextBlock Text="Custom Prompt for AI" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CustomPrompt, Mode=TwoWay}"
                                TextWrapping="Wrap"
                                Height="60"
                                Padding="10"
                                Background="White"
                                BorderBrush="#CED4DA"
                                FontSize="12"
                                Margin="0,0,0,15"/>

                        <Button Content="Generate 10 Prompts from Image"
                               Style="{StaticResource PrimaryButtonStyle}"
                               Command="{Binding GeneratePromptsCommand}"
                               Width="280"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,15"/>

                        <!-- Save/Load Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="Save Prompts"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding SavePromptsCommand}"
                                   Width="120"
                                   Height="35"
                                   Margin="0,0,10,0"/>
                            <Button Content="Load Prompts"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding LoadPromptsCommand}"
                                   Width="120"
                                   Height="35"/>
                        </StackPanel>

                        <!-- Generated Prompts Display -->
                        <Grid Visibility="{Binding HasGeneratedPrompts, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 1:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt1, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 2:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt2, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 3:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt3, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 4:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt4, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 5:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt5, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 6:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt6, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Prompt 7:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt7, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Prompt 8:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt8, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Prompt 9:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt9, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Prompt 10:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding GeneratedPrompt10, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        Padding="8"
                                        FontSize="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Step 3: Generate Video -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Step 3: Generate Story Video" Style="{StaticResource HeaderTextStyle}" Foreground="#9C27B0"/>

                        <TextBlock Text="This will use the 4 prompts to create a multi-scene story video"
                                   FontSize="12"
                                   Foreground="#666"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="⚠ Note: Video generation can take 10-30 minutes depending on your hardware"
                                   FontSize="11"
                                   Foreground="#E91E63"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <Button Content="Generate Story Video"
                               Style="{StaticResource PrimaryButtonStyle}"
                               Command="{Binding GenerateVideoCommand}"
                               Width="250"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,15"/>

                        <!-- Processing Status -->
                        <Border Background="#FFF9F0"
                                BorderBrush="#FFE0B0"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="15"
                                Margin="0,0,0,15"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ProcessingStatus}"
                                          FontWeight="SemiBold"
                                          FontSize="12"
                                          Margin="0,0,0,8"
                                          TextWrapping="Wrap"/>
                                <ProgressBar Value="{Binding ProcessingProgress}"
                                            Height="20"
                                            Foreground="#9C27B0"
                                            Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding ProgressPercentage}"
                                          HorizontalAlignment="Center"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          Foreground="#9C27B0"/>
                            </StackPanel>
                        </Border>

                        <!-- Result Video -->
                        <StackPanel Visibility="{Binding HasResultVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="✓ Video Generated Successfully!"
                                      FontWeight="Bold"
                                      FontSize="14"
                                      Foreground="#4CAF50"
                                      Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding ResultVideoPath}"
                                      FontSize="11"
                                      Foreground="#666"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,10"/>

                            <Button Content="Open Output Folder"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding OpenResultFolderCommand}"
                                   Width="200"
                                   HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Log (Collapsible) -->
                <Expander Header="Processing Log"
                         IsExpanded="True"
                         Margin="0,0,0,0">
                    <Border Background="White"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="200"
                                     VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LogOutput}"
                                    TextWrapping="Wrap"
                                    IsReadOnly="True"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10"/>
                        </ScrollViewer>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
