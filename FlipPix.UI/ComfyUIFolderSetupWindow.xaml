<Window x:Class="FlipPix.UI.ComfyUIFolderSetupWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ComfyUI Setup"
        Height="700"
        MinHeight="530"
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#1E1E1E">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="ComfyUI Setup"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- Description -->
        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Foreground="#CCCCCC"
                   Margin="0,0,0,20">
            <Run Text="Please configure your ComfyUI installation by setting the folder path and server address."/>
            <LineBreak/>
            <Run Text="The application will test the connection to ensure ComfyUI is accessible."/>
        </TextBlock>

        <!-- Folder Path Input -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="FolderPathTextBox"
                     Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8"
                     FontSize="14"
                     Background="#2D2D30"
                     Foreground="White"
                     BorderBrush="#3F3F46"
                     BorderThickness="1"/>

            <Button Grid.Column="1"
                    Content="Browse..."
                    Command="{Binding BrowseFolderCommand}"
                    Margin="10,0,0,0"
                    Padding="20,8"
                    Background="#0E639C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>

        <!-- Server URL Section -->
        <TextBlock Grid.Row="3"
                   Text="ComfyUI Server Address:"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="4"
                   Text="Enter the IP address and port where ComfyUI is running (e.g., localhost:8188)"
                   FontSize="12"
                   Foreground="#AAAAAA"
                   Margin="0,0,0,8"/>

        <!-- Server URL Input -->
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="ServerUrlTextBox"
                     Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8"
                     FontSize="14"
                     Background="#2D2D30"
                     Foreground="White"
                     BorderBrush="#3F3F46"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Test Connection"
                    Command="{Binding TestConnectionCommand}"
                    Margin="10,0,0,0"
                    Padding="15,8"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>

        <!-- Server Connection Status -->
        <Border Grid.Row="6"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Connection Status Indicator -->
                <Ellipse Grid.Column="0"
                         Width="12"
                         Height="12"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#666666"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                                    <Setter Property="Fill" Value="#00FF00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTestingConnection}" Value="True">
                                    <Setter Property="Fill" Value="#FFA500"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Connection Status Text -->
                <TextBlock Grid.Column="1"
                           Text="{Binding ServerConnectionMessage}"
                           FontSize="12"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                                    <Setter Property="Foreground" Value="#00FF00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTestingConnection}" Value="True">
                                    <Setter Property="Foreground" Value="#FFA500"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Remote Output Folder Section -->
        <TextBlock Grid.Row="7"
                   Text="Remote ComfyUI Output Folder:"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="8"
                   Text="Enter the network path to the remote ComfyUI output folder (required for remote servers)"
                   FontSize="12"
                   Foreground="#AAAAAA"
                   Margin="0,0,0,8"/>

        <!-- Remote Output Folder Input -->
        <Grid Grid.Row="9" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="RemoteOutputFolderTextBox"
                     Text="{Binding RemoteOutputFolderPath, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8"
                     FontSize="14"
                     Background="#2D2D30"
                     Foreground="White"
                     BorderBrush="#3F3F46"
                     BorderThickness="1"/>

            <Button Grid.Column="1"
                    Content="Browse..."
                    Command="{Binding BrowseRemoteOutputFolderCommand}"
                    Margin="10,0,0,0"
                    Padding="20,8"
                    Background="#0E639C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>

        <!-- Remote LoRA Folder Section -->
        <TextBlock Grid.Row="10"
                   Text="Remote ComfyUI LoRA Folder:"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="11"
                   Text="Enter the network path to the remote ComfyUI LoRA folder (e.g., Y:\\ai-models\\loras\\zimage)"
                   FontSize="12"
                   Foreground="#AAAAAA"
                   Margin="0,0,0,8"/>

        <!-- Remote LoRA Folder Input -->
        <Grid Grid.Row="12" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="RemoteLoraFolderTextBox"
                     Text="{Binding RemoteLoraFolderPath, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8"
                     FontSize="14"
                     Background="#2D2D30"
                     Foreground="White"
                     BorderBrush="#3F3F46"
                     BorderThickness="1"/>

            <Button Grid.Column="1"
                    Content="Browse..."
                    Command="{Binding BrowseRemoteLoraFolderCommand}"
                    Margin="10,0,0,0"
                    Padding="20,8"
                    Background="#0E639C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>

        <!-- Validation Status -->
        <TextBlock Grid.Row="13"
                   x:Name="ValidationTextBlock"
                   Text="{Binding ValidationMessage}"
                   Foreground="{Binding ValidationMessageColor}"
                   FontSize="12"
                   Margin="0,5,0,10"
                   TextWrapping="Wrap"/>

        <!-- Output Folder Info -->
        <TextBlock Grid.Row="14"
                   x:Name="OutputFolderTextBlock"
                   Text="{Binding OutputFolderInfo}"
                   Foreground="#888888"
                   FontSize="11"
                   Margin="0,0,0,20"
                   TextWrapping="Wrap"
                   Visibility="{Binding OutputFolderInfoVisibility}"/>

        <!-- Spacer -->
        <Border Grid.Row="15"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="16"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="30,10"
                    Margin="0,0,10,0"
                    Background="#3F3F46"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"
                    Padding="30,10"
                    Background="#0E639C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
