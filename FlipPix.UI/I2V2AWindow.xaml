<Window x:Class="FlipPix.UI.I2V2AWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlipPix - Image to Video with Audio (I2V2A)" Height="950" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="850" MinWidth="1000"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF6B35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8556"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66BB6A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E85D75"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8A939A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navigation Bar -->
        <Border Grid.Row="0" Background="#343A40" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource NavButtonStyle}" Content="Home" Click="NavigateToHome"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="Image Gen" Click="NavigateToImageGen"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="Video Gen" Click="NavigateToVideoGen"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="I2V2A (Current)" Background="#495057"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="Settings" Click="NavigateToSettings"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="About" Click="NavigateToAbout"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">

                    <!-- Input Image Section -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Input Image" Style="{StaticResource HeaderTextStyle}"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Content="Select Input Image"
                                        Command="{Binding SelectInputImageCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,0,10"/>
                                <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="5"
                                        Background="#FFF" Padding="5">
                                    <Grid>
                                        <Image Source="{Binding InputImageSource}"
                                               Stretch="Uniform"
                                               Visibility="{Binding HasInputImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="No image selected"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#999"
                                                   Visibility="{Binding HasInputImage, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{Binding InputImagePath, TargetNullValue='No file selected'}"
                                           FontSize="12" Foreground="#666"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,5,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Video Generation Settings -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Video Generation Settings" Style="{StaticResource HeaderTextStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Width:" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VideoWidth}" Margin="0,0,0,10"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Height:" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VideoHeight}" Margin="0,0,0,10"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Total Frames:" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TotalFrames}" Margin="0,0,0,10"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="FPS:" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FPS}" Margin="0,0,0,10"/>
                            </Grid>

                            <TextBlock Text="Video Prompt:" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox Text="{Binding VideoPrompt}"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="Negative Prompt:" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox Text="{Binding NegativePrompt}"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,10"/>
                        </StackPanel>
                    </Border>

                    <!-- Audio Generation Settings -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Audio Generation Settings" Style="{StaticResource HeaderTextStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Duration (sec):" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AudioDuration}" Margin="0,0,0,10"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="CFG:" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AudioCfg}" Margin="0,0,0,10"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Steps:" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AudioSteps}" Margin="0,0,0,10"/>
                            </Grid>

                            <TextBlock Text="Audio Prompt:" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox Text="{Binding AudioPrompt}"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="Audio Negative Prompt:" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox Text="{Binding AudioNegativePrompt}"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">

                    <!-- Advanced Settings -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Advanced Settings" Style="{StaticResource HeaderTextStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Steps:" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Steps}" Margin="0,0,0,10"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Step to Swap:" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StepToSwap}" Margin="0,0,0,10"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="CFG:" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Cfg}" Margin="0,0,0,10"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="Seed (0=Random):" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Seed}" Margin="0,0,0,10"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="CRF:" Margin="0,0,10,5"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CRF}" Margin="0,0,0,10"/>
                            </Grid>

                            <!-- LoRA Selection -->
                            <TextBlock Text="LoRA Models:" FontWeight="Bold" Margin="0,20,0,10"/>
                            <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LoRAItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,5" CornerRadius="3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              Content="{Binding Name}"
                                                              IsChecked="{Binding Enabled}"
                                                              Margin="0,0,10,0"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="Strength:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="2"
                                                            Value="{Binding Strength}"
                                                            Minimum="0"
                                                            Maximum="2"
                                                            TickFrequency="0.1"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Generation Controls -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Generation Controls" Style="{StaticResource HeaderTextStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Generate Video"
                                        Command="{Binding GenerateVideoCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,5,0"/>
                                <Button Grid.Column="1"
                                        Content="Cancel"
                                        Command="{Binding CancelGenerationCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Margin="5,0,0,0"/>
                            </Grid>

                            <TextBlock Text="{Binding ProcessingStatus}"
                                       Margin="0,10,0,5"
                                       FontSize="12"
                                       Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ProgressBar Value="{Binding ProcessingProgress}"
                                         Maximum="100"
                                         Height="20"
                                         Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Play Video"
                                        Command="{Binding PlayResultVideoCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,2,0"/>
                                <Button Grid.Column="1"
                                        Content="Open Folder"
                                        Command="{Binding OpenResultFolderCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="2,0,2,0"/>
                                <Button Grid.Column="2"
                                        Content="Clear Logs"
                                        Command="{Binding ClearLogsCommand}"
                                        Style="{StaticResource NavButtonStyle}"
                                        Margin="2,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ComfyUI Connection -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="ComfyUI Connection" Style="{StaticResource HeaderTextStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="Server:"/>
                                        <TextBox Grid.Column="1" Text="{Binding ComfyUIServer}" Margin="0,0,10,0"/>
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="Port:"/>
                                        <TextBox Grid.Column="1" Text="{Binding ComfyUIPort}"/>
                                    </Grid>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Test"
                                        Command="{Binding RefreshConnectionCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="60"
                                        Height="50"
                                        VerticalAlignment="Top"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Logs -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Generation Logs" Style="{StaticResource HeaderTextStyle}"/>
                            <TextBox Text="{Binding LogOutput}"
                                     Height="150"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#F8F8F8"
                                     FontFamily="Consolas"
                                     FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#2C3E50" Padding="10,5">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" Foreground="White"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>