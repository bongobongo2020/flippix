<Window x:Class="FlipPix.UI.VideoEnhanceWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlipPix - Enhance Video" Height="800" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        MinHeight="650" MinWidth="800"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1565C0" Offset="0"/>
                    <GradientStop Color="#42A5F5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="25,20">
                <TextBlock Text="Enhance Video"
                           FontSize="28" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Interpolate frames for smooth slow-motion  •  Upscale with RTX Super Resolution or SeedVR2"
                           FontSize="13" Foreground="#E3F2FD"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,15,20,15">

                <TabControl>

                    <!-- ── Tab 1: Interpolate ── -->
                    <TabItem Header="🎞 Interpolate">
                        <StackPanel Margin="10,15,10,10">

                            <!-- Input Section -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Input Video"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource AccentIndigoBrush}" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding InterpolateVideoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 Padding="8,6"
                                                 FontSize="12"
                                                 Background="White"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 VerticalContentAlignment="Center"
                                                 Height="34"/>
                                        <Button Grid.Column="1"
                                                Content="Browse"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding SelectInterpolateVideoCommand}"
                                                Width="80" Height="34"
                                                Margin="8,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="{Binding InterpolateVideoInfo}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding HasInterpolateVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Button Content="Add to Queue"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding AddInterpolateToQueueCommand}"
                                            HorizontalAlignment="Left"
                                            Width="140" Height="36"
                                            Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Queue Section -->
                            <Border Style="{StaticResource SectionPanelStyle}"
                                    Visibility="{Binding HasInterpolateQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="Queue"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentIndigoBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding InterpolateQueueStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="🔄 Retry Failed"
                                                Command="{Binding ReprocessInterpolateFailedCommand}"
                                                IsEnabled="{Binding HasInterpolateFailedItems}"
                                                Height="28" Width="90" FontSize="11"
                                                Margin="4,0,4,0"
                                                Background="{StaticResource AccentAmberBrush}" Foreground="White"
                                                BorderThickness="0" FontWeight="SemiBold"/>
                                        <Button Grid.Column="2"
                                                Content="⏹ Stop"
                                                Command="{Binding StopInterpolateQueueCommand}"
                                                IsEnabled="{Binding IsProcessingInterpolateQueue}"
                                                Height="28" Width="65" FontSize="11"
                                                Margin="0,0,4,0"
                                                Background="{StaticResource AccentAmberBrush}" Foreground="White"
                                                BorderThickness="0" FontWeight="SemiBold"/>
                                        <Button Grid.Column="3"
                                                Content="🗑️ Clear"
                                                Command="{Binding ClearInterpolateQueueCommand}"
                                                Height="28" Width="65" FontSize="11"
                                                Background="{StaticResource DangerBrush}" Foreground="White"
                                                BorderThickness="0" FontWeight="SemiBold"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding InterpolateQueue}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding StatusDisplay}"
                                                                       FontSize="11"
                                                                       Foreground="{Binding StatusColor}"
                                                                       Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding ErrorMessage}"
                                                                       FontSize="10" Foreground="{StaticResource DangerBrush}"
                                                                       Margin="0,2,0,0"
                                                                       Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </StackPanel>

                                                        <ProgressBar Grid.Column="1"
                                                                     Value="{Binding Progress}"
                                                                     Minimum="0" Maximum="100"
                                                                     Width="80" Height="6"
                                                                     Margin="10,0,10,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource AccentIndigoBrush}"/>

                                                        <Button Grid.Column="2"
                                                                Content="✕"
                                                                Width="24" Height="24"
                                                                FontSize="10"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Cursor="Hand"
                                                                Command="{Binding DataContext.RemoveInterpolateQueueItemCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </TabItem>

                    <!-- ── Tab 2: Upscale ── -->
                    <TabItem Header="🔍 Upscale">
                        <StackPanel Margin="10,15,10,10">

                            <!-- Input Section -->
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Input Video"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource AccentIndigoBrush}" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding UpscaleVideoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 Padding="8,6"
                                                 FontSize="12"
                                                 Background="White"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 VerticalContentAlignment="Center"
                                                 Height="34"/>
                                        <Button Grid.Column="1"
                                                Content="Browse"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding SelectUpscaleVideoCommand}"
                                                Width="80" Height="34"
                                                Margin="8,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="{Binding UpscaleVideoInfo}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding HasUpscaleVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <!-- Upscaler engine. Snapshotted onto the queue item, so a mixed queue
                                         can hold both RTX and SeedVR2 jobs. -->
                                    <TextBlock Text="Upscaler"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,14,0,6"/>

                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="RTX Super Resolution"
                                                     GroupName="UpscaleEngine"
                                                     IsChecked="{Binding IsRtxSelected, Mode=TwoWay}"
                                                     FontSize="12" VerticalContentAlignment="Center"
                                                     Margin="0,0,18,0"
                                                     ToolTip="Fast hardware upscale (upscale nvidaAPI.json). No model load."/>
                                        <RadioButton Content="SeedVR2 7B INT8"
                                                     GroupName="UpscaleEngine"
                                                     IsChecked="{Binding IsSeedVr2Selected, Mode=TwoWay}"
                                                     FontSize="12" VerticalContentAlignment="Center"
                                                     Margin="0,0,14,0"
                                                     ToolTip="Diffusion restore (utility_seedvr2_7b_int8_upscale_video.json): the clip is pre-resized, chunked on the temporal axis and denoised in one step. Reconstructs detail, but loads a 7B model and is far slower."/>

                                        <TextBlock Text="Scale"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,6,0"
                                                   Visibility="{Binding IsSeedVr2Selected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <ComboBox ItemsSource="{Binding SeedVr2ScaleOptions}"
                                                  SelectedItem="{Binding SeedVr2Scale, Mode=TwoWay}"
                                                  Width="78" Height="30" FontSize="11"
                                                  VerticalContentAlignment="Center"
                                                  Visibility="{Binding IsSeedVr2Selected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  ToolTip="Pre-resize multiplier fed to the graph — this is what sets the output resolution.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}{0:0.##}×}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <TextBlock Text="{Binding UpscaleEngineDescription}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>

                                    <Button Content="Add to Queue"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding AddUpscaleToQueueCommand}"
                                            HorizontalAlignment="Left"
                                            Width="140" Height="36"
                                            Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Queue Section -->
                            <Border Style="{StaticResource SectionPanelStyle}"
                                    Visibility="{Binding HasUpscaleQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="Queue"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentIndigoBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UpscaleQueueStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="🔄 Retry Failed"
                                                Command="{Binding ReprocessUpscaleFailedCommand}"
                                                IsEnabled="{Binding HasUpscaleFailedItems}"
                                                Height="28" Width="90" FontSize="11"
                                                Margin="4,0,4,0"
                                                Background="{StaticResource AccentAmberBrush}" Foreground="White"
                                                BorderThickness="0" FontWeight="SemiBold"/>
                                        <Button Grid.Column="2"
                                                Content="⏹ Stop"
                                                Command="{Binding StopUpscaleQueueCommand}"
                                                IsEnabled="{Binding IsProcessingUpscaleQueue}"
                                                Height="28" Width="65" FontSize="11"
                                                Margin="0,0,4,0"
                                                Background="{StaticResource AccentAmberBrush}" Foreground="White"
                                                BorderThickness="0" FontWeight="SemiBold"/>
                                        <Button Grid.Column="3"
                                                Content="🗑️ Clear"
                                                Command="{Binding ClearUpscaleQueueCommand}"
                                                Height="28" Width="65" FontSize="11"
                                                Background="{StaticResource DangerBrush}" Foreground="White"
                                                BorderThickness="0" FontWeight="SemiBold"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding UpscaleQueue}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayText}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding EngineDisplay}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource AccentIndigoBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding StatusDisplay}"
                                                                       FontSize="11"
                                                                       Foreground="{Binding StatusColor}"
                                                                       Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding ErrorMessage}"
                                                                       FontSize="10" Foreground="{StaticResource DangerBrush}"
                                                                       Margin="0,2,0,0"
                                                                       Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </StackPanel>

                                                        <ProgressBar Grid.Column="1"
                                                                     Value="{Binding Progress}"
                                                                     Minimum="0" Maximum="100"
                                                                     Width="80" Height="6"
                                                                     Margin="10,0,10,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{StaticResource AccentIndigoBrush}"/>

                                                        <Button Grid.Column="2"
                                                                Content="✕"
                                                                Width="24" Height="24"
                                                                FontSize="10"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Cursor="Hand"
                                                                Command="{Binding DataContext.RemoveUpscaleQueueItemCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </TabItem>

                </TabControl>

                <!-- Progress Section -->
                <Border Style="{StaticResource SectionPanelStyle}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Processing"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentIndigoBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ProcessingStatus}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <ProgressBar Value="{Binding ProcessingProgress}"
                                     Minimum="0" Maximum="100"
                                     Height="10"
                                     Foreground="{StaticResource AccentIndigoBrush}"/>
                        <TextBlock Text="{Binding ProgressPercentage}"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Result Section -->
                <Border Style="{StaticResource SectionPanelStyle}"
                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Result"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8"/>

                        <MediaElement x:Name="VideoPlayer"
                                      Source="{Binding ResultVideoPath}"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      Stretch="Uniform"
                                      MaxHeight="300"
                                      Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding ResultVideoInfo}"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Play"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding PlayVideoCommand}"
                                    Width="80" Height="32"
                                    Margin="0,0,8,0"/>
                            <Button Content="Open Folder"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenResultFolderCommand}"
                                    Width="100" Height="32"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Log Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Log"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ScrollViewer Height="120"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      BorderThickness="1">
                            <TextBlock Text="{Binding LogOutput}"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Padding="8"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ProcessingStatus}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Interpolate: "
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Idle"/>
                                <Setter Property="Foreground" Value="#6C757D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessingInterpolateQueue}" Value="True">
                                        <Setter Property="Text" Value="Running"/>
                                        <Setter Property="Foreground" Value="#FF6B35"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Upscale: "
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Idle"/>
                                <Setter Property="Foreground" Value="#6C757D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessingUpscaleQueue}" Value="True">
                                        <Setter Property="Text" Value="Running"/>
                                        <Setter Property="Foreground" Value="#FF6B35"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
