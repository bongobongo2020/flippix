<Window x:Class="FlipPix.UI.ServerSetupWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComfyUI Server Setup"
        Height="760"
        Width="1080"
        MinHeight="560"
        MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SummaryNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Get this ComfyUI server ready for FlipPix"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Name="ServerLine" FontSize="13" Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="Connecting ..."/>
        </StackPanel>

        <!-- Summary -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Name="ReadyNumber" Style="{StaticResource SummaryNumber}" Text="–"/>
                    <TextBlock Name="ReadyLabel" Style="{StaticResource SummaryLabel}" Text="workflows ready"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Name="NodesNumber" Style="{StaticResource SummaryNumber}" Text="–"/>
                    <TextBlock Style="{StaticResource SummaryLabel}" Text="node packs missing"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Name="ModelsNumber" Style="{StaticResource SummaryNumber}" Text="–"/>
                    <TextBlock Style="{StaticResource SummaryLabel}" Text="models missing"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource SummaryCard}" Margin="0">
                <StackPanel>
                    <TextBlock Name="RemappedNumber" Style="{StaticResource SummaryNumber}" Text="–"/>
                    <TextBlock Style="{StaticResource SummaryLabel}"
                               Text="models found in another folder on the server (used automatically)"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Model folder line -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="FolderLine" Grid.Column="0" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Looking for the server's model folders ..."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Name="PickShareButton" Content="Set models folder…" Click="PickShare_Click"
                            Style="{StaticResource SmallButton}"
                            ToolTip="Point FlipPix at the folder (network share or mapped drive) that is the server's ComfyUI models folder."/>
                    <Button Name="ScanFolderButton" Content="Find models in a folder…" Click="ScanFolder_Click"
                            Style="{StaticResource SmallButton}" Margin="0"
                            ToolTip="Look through a folder you already have (an old ComfyUI install, a USB drive, a NAS) for the missing models, so they are copied instead of downloaded."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="3" Name="Tabs" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="Node packs" Name="NodesTab">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                        <Button Content="Select all" Click="SelectAllNodes_Click" Style="{StaticResource SmallButton}"/>
                        <Button Content="Select none" Click="SelectNoNodes_Click" Style="{StaticResource SmallButton}"/>
                    </StackPanel>
                    <ListView Name="NodesList" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanInstall}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Pack" Width="220" DisplayMemberBinding="{Binding PackName}"/>
                                <GridViewColumn Header="Nodes" Width="230">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nodes}" ToolTip="{Binding Nodes}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Used by" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UsedBy}" ToolTip="{Binding WorkflowList}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="How" Width="190" DisplayMemberBinding="{Binding Route}"/>
                                <GridViewColumn Header="Status" Width="230">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Models" Name="ModelsTab">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                        <Button Content="Select all" Click="SelectAllModels_Click" Style="{StaticResource SmallButton}"/>
                        <Button Content="Essentials" Click="SelectEssentialModels_Click" Style="{StaticResource SmallButton}"
                                ToolTip="Pick the models the core image generation and image editing workflows use."/>
                        <Button Content="Select none" Click="SelectNoModels_Click" Style="{StaticResource SmallButton}"/>
                        <CheckBox Name="ShowRemappedCheck" Content="Show models already on the server" VerticalAlignment="Center"
                                  Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                  Checked="ShowRemapped_Changed" Unchecked="ShowRemapped_Changed"/>
                        <TextBlock Name="SelectedSizeText" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <ListView Name="ModelsList" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanInstall}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Model" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Folder" Width="110" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Used by" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UsedBy}" ToolTip="{Binding WorkflowList}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}"/>
                                <GridViewColumn Header="Source" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Source}" ToolTip="{Binding SourceDetail}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Status" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Workflows" Name="WorkflowsTab">
                <ListView Name="WorkflowsList" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource TextPrimaryBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Workflow" Width="560" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Status" Width="380" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <TabItem Header="Log" Name="LogTab">
                <TextBox Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" BorderThickness="0"
                         Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"/>
            </TabItem>
        </TabControl>

        <!-- Progress -->
        <StackPanel Grid.Row="4" Margin="0,10,0,10">
            <ProgressBar Name="Progress" Height="6" IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="{StaticResource AccentIndigoBrush}"
                         Background="{StaticResource SurfaceAltBrush}" BorderThickness="0"/>
            <TextBlock Name="StatusText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Name="RescanButton" Content="Rescan" Click="Rescan_Click" Padding="18,10" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                <Button Name="ScriptButton" Content="Copy server commands" Click="CopyScript_Click" Padding="18,10"
                        Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"
                        ToolTip="Copies a script for whatever FlipPix can't install from here. Paste it into a terminal on the server."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="InstallButton" Content="Install selected" Click="Install_Click" Padding="22,10" Margin="0,0,10,0"
                        Style="{StaticResource PrimaryButtonStyle}" Cursor="Hand" IsEnabled="False"/>
                <Button Name="CloseButton" Content="Close" Click="Close_Click" Padding="22,10"
                        Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
