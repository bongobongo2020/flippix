<Window x:Class="FlipPix.UI.MissingNodesWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Missing Custom Nodes"
        Height="560"
        Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="440"
        MinWidth="600"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Some custom nodes aren't installed"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Name="IntroText"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,12"
                   Text="This workflow uses the custom node(s) below, which the connected ComfyUI doesn't have. Install the providing pack(s) automatically, then ComfyUI is restarted so they load."/>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="2">
            <ListView Name="NodesList"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Node" Width="230"
                                        DisplayMemberBinding="{Binding ClassType}"/>
                        <GridViewColumn Header="Pack" Width="220"
                                        DisplayMemberBinding="{Binding PackName}"/>
                        <GridViewColumn Header="Status" Width="240"
                                        DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <ProgressBar Grid.Row="3"
                     Name="Progress"
                     Height="6"
                     Margin="0,12,0,6"
                     IsIndeterminate="True"
                     Foreground="{StaticResource AccentIndigoBrush}"
                     Background="{StaticResource SurfaceAltBrush}"
                     BorderThickness="0"
                     Visibility="Collapsed"/>

        <TextBlock Grid.Row="4"
                   Name="StatusText"
                   FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Name="InstallButton"
                    Content="Install &amp; restart"
                    Click="InstallButton_Click"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Cursor="Hand"/>
            <Button Name="RetryButton"
                    Content="Retry"
                    Click="RetryButton_Click"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Style="{StaticResource SuccessButtonStyle}"
                    Cursor="Hand"
                    IsEnabled="False"/>
            <Button Name="CancelButton"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Padding="20,10"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
