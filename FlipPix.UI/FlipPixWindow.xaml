<Window x:Class="FlipPix.UI.FlipPixWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Camera Edit" Height="900" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="600" MinWidth="850"
        ResizeMode="CanResize">

    <Window.Resources>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource BrandColor}"/>
            </Border.Background>
            <StackPanel Margin="25,20">
                <TextBlock Text="📷 FlipPix"
                          FontSize="28" FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Transform images with intelligent camera angle and perspective controls"
                          FontSize="13" Foreground="#E6FFFFFF"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tools:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="🖼️ Image Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToImageGeneratorCommand}"/>
                <Button Content="🎬 Video Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToVideoGeneratorCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,15,20,15">

                <!-- Image Section - Side by Side -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Input Image -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="📤 Input Image" Style="{StaticResource HeaderTextStyle}" Foreground="{StaticResource TextPrimaryBrush}"/>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                    Background="White" Height="250"
                                    CornerRadius="5" Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock Text="No image selected"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="#999"
                                              FontStyle="Italic"
                                              Visibility="{Binding NoInputImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Image Source="{Binding ImagePreviewSource}"
                                           Stretch="Uniform"
                                           Visibility="{Binding HasInputImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                        Text="{Binding ImageFilePath, Mode=TwoWay}"
                                        IsReadOnly="True"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        FontSize="11"/>
                                <Button Grid.Column="1"
                                       Content="Browse"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       Margin="8,0,0,0"
                                       Command="{Binding SelectImageCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding ImageInfo}"
                                      FontStyle="Italic"
                                      Foreground="#666"
                                      FontSize="10"
                                      Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Result Image -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="✨ Result Image" Style="{StaticResource HeaderTextStyle}" Foreground="{StaticResource TextPrimaryBrush}"/>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                    Background="White" Height="250"
                                    CornerRadius="5" Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock Text="Result will appear here"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="#999"
                                              FontStyle="Italic"
                                              Visibility="{Binding NoResultImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Image Source="{Binding ResultPreviewSource}"
                                           Stretch="Uniform"
                                           Visibility="{Binding HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                       Content="📂 Open Folder"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       Command="{Binding OpenResultFolderCommand}"
                                       IsEnabled="{Binding HasResultImage}"
                                       Margin="0,0,4,0"/>

                                <Button Grid.Column="1"
                                       Content="🎬 To Video"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       Command="{Binding SendToVideoGeneratorCommand}"
                                       IsEnabled="{Binding HasResultImage}"
                                       Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Camera Control and Processing Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Camera Control -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="🎥 Camera Control" Style="{StaticResource HeaderTextStyle}" Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Text="Preset" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding CameraControlOptions}"
                                     SelectedValue="{Binding SelectedCameraControl, Mode=TwoWay}"
                                     SelectedValuePath="Name"
                                     Padding="10,8"
                                     FontSize="13"
                                     Margin="0,0,0,15">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Camera Instruction" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CustomPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    Height="85"
                                    Padding="10"
                                    VerticalScrollBarVisibility="Auto"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    FontSize="12"
                                    Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                       Content="💾 Save Prompt"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       Command="{Binding SaveCustomPromptCommand}"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,8,0"/>

                                <Button Grid.Column="1"
                                       Content="🗑️ Delete Saved"
                                       Command="{Binding DeleteSavedPromptCommand}"
                                       HorizontalAlignment="Right">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="Background" Value="#DC3545"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E55563"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#CCC"/>
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Process Image and Status -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="🚀 Process Image"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Command="{Binding ProcessImageCommand}"
                                   HorizontalAlignment="Stretch"
                                   Height="50"
                                   FontSize="14"
                                   Margin="0,0,0,15"/>

                            <!-- Processing Status -->
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="12"
                                    Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProcessingStatus}"
                                              FontWeight="SemiBold"
                                              FontSize="11"
                                              Margin="0,0,0,5"
                                              TextAlignment="Center"/>
                                    <ProgressBar Value="{Binding ProcessingProgress}"
                                                Height="16"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding ProgressPercentage}"
                                              HorizontalAlignment="Center"
                                              FontSize="11"
                                              FontWeight="Bold"
                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Queue Management Section -->
                <Border Style="{StaticResource SectionPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="📋 Queue Management" Style="{StaticResource HeaderTextStyle}" Foreground="{StaticResource TextPrimaryBrush}"/>

                        <!-- Queue Controls -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                   Content="➕ Add to Queue"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding AddToQueueCommand}"
                                   Margin="0,0,5,0"/>

                            <Button Grid.Column="1"
                                   Content="🚀 Process Queue"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Command="{Binding ProcessQueueCommand}"
                                   Margin="5,0,5,0"/>

                            <Button Grid.Column="2"
                                   Content="🗑️ Clear Queue"
                                   Command="{Binding ClearQueueCommand}"
                                   Margin="5,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Background" Value="#DC3545"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E55563"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCC"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Queue Status -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12"
                                Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                          Text="Queue Status"
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                          Text="{Binding QueuedCount, StringFormat={}Queued: {0}}"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          FontSize="11"/>

                                <TextBlock Grid.Column="2"
                                          Text="{Binding CompletedCount, StringFormat={}Completed: {0}}"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          FontSize="11"
                                          Foreground="{StaticResource SuccessBrush}"/>

                                <TextBlock Grid.Column="3"
                                          Text="{Binding FailedCount, StringFormat={}Failed: {0}}"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          FontSize="11"
                                          Foreground="{StaticResource DangerBrush}"/>
                            </Grid>
                        </Border>

                        <!-- Queue Progress -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12"
                                Margin="0,0,0,15"
                                Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding QueueProgressText, StringFormat={}Processing Queue: {0}}"
                                          FontWeight="SemiBold"
                                          FontSize="11"
                                          Margin="0,0,0,5"
                                          TextAlignment="Center"/>
                                <ProgressBar Value="{Binding QueueProgress, Mode=OneWay}"
                                            Maximum="{Binding QueueTotal, Mode=OneWay}"
                                            Height="16"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CurrentQueueItem.CameraControl, StringFormat={}Current: {0}}"
                                          HorizontalAlignment="Center"
                                          FontSize="11"
                                          FontWeight="Bold"
                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Queue Items List -->
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding QueueItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E9ECEF"
                                                   BorderThickness="0,0,0,1"
                                                   Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Item Info -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding CameraControl}"
                                                                  FontWeight="SemiBold"
                                                                  FontSize="12"/>
                                                        <TextBlock Text="{Binding Prompt}"
                                                                  FontSize="10"
                                                                  Foreground="#666"
                                                                  TextTrimming="CharacterEllipsis"
                                                                  MaxWidth="300"/>
                                                    </StackPanel>

                                                    <!-- Status -->
                                                    <StackPanel Grid.Column="1"
                                                               Orientation="Horizontal"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0">
                                                        <TextBlock Text="{Binding Status}"
                                                                  FontSize="11"
                                                                  FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#6C757D"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                            <Setter Property="Foreground" Value="#007BFF"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                            <Setter Property="Foreground" Value="#FF6B35"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Foreground" Value="#DC3545"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Progress bar for processing items -->
                                                        <ProgressBar Value="{Binding Progress}"
                                                                   Width="50"
                                                                   Height="12"
                                                                   Margin="5,0">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                    </StackPanel>

                                                    <!-- Remove Button -->
                                                    <Button Grid.Column="2"
                                                           Content="❌"
                                                           Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Background="Transparent"
                                                           BorderThickness="0"
                                                           Padding="5"
                                                           ToolTip="Remove from queue"
                                                           FontSize="12"
                                                           Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Advanced Settings (Collapsible) -->
                <Expander Header="⚙️ Advanced Settings"
                         Margin="0,0,0,15"
                         IsExpanded="False">
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Steps -->
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Steps, Mode=TwoWay}"
                                                Minimum="1" Maximum="20"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Steps}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- CFG -->
                                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                    <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Cfg, Mode=TwoWay}"
                                                Minimum="1" Maximum="10"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Cfg, StringFormat={}{0:F1}}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Denoise -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Denoise" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Denoise, Mode=TwoWay}"
                                                Minimum="0" Maximum="1"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Denoise, StringFormat={}{0:F2}}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Negative Prompt -->
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="Negative Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        Height="50"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Log (Collapsible) -->
                <Expander Header="📝 Processing Log"
                         IsExpanded="True"
                         Margin="0,0,0,0">
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="150"
                                     VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LogOutput}"
                                    TextWrapping="Wrap"
                                    IsReadOnly="True"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10"/>
                        </ScrollViewer>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
