<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:FlipPix.UI.Converters">

    <!-- Converters -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <converters:SubtractConverter x:Key="SubtractConverter"/>
    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

    <!-- ============================================================= -->
    <!--  DESIGN TOKENS                                                -->
    <!--  One accent + neutral ramp + semantic colors. Use these      -->
    <!--  brushes everywhere instead of ad-hoc hexes.                  -->
    <!-- ============================================================= -->

    <!-- Brand / primary accent -->
    <Color x:Key="BrandColor">#FF6B35</Color>
    <SolidColorBrush x:Key="BrandBrush" Color="#FF6B35"/>
    <SolidColorBrush x:Key="BrandHoverBrush" Color="#FF8556"/>
    <SolidColorBrush x:Key="BrandPressedBrush" Color="#E85620"/>

    <!-- Neutral ramp -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAFAFB"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D1D5DB"/>
    <Color x:Key="BorderColor">#E5E7EB</Color>

    <!-- Text ramp. Three clearly separated steps, all of which clear WCAG AA (4.5:1)
         on the light surfaces above — the previous muted grey sat at 2.5:1 on white,
         which made hints and placeholders hard to read. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937"/>   <!-- 12.6:1 on white -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563"/> <!--  7.5:1 on white -->
    <SolidColorBrush x:Key="TextMutedBrush" Color="#656C78"/>     <!--  5.2:1 on white, 4.7:1 on the page -->
    <!-- Non-text greys (icons, rules, decorative dots) may stay lighter. -->
    <SolidColorBrush x:Key="TextFaintBrush" Color="#9CA3AF"/>

    <!-- Secondary action / neutral controls -->
    <SolidColorBrush x:Key="NeutralBrush" Color="#475569"/>
    <SolidColorBrush x:Key="NeutralHoverBrush" Color="#334155"/>

    <!-- Video/image players sit on near-black so the frame edge reads cleanly. This is the
         one dark surface in the app; every player uses it rather than its own shade. -->
    <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#0C0A09"/>
    <!-- Busy/hover scrim drawn over a frame; white text sits on top of it. -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#CC0C0A09"/>
    <!-- Placeholder/caption text drawn ON PlayerSurfaceBrush. The normal text ramp is
         tuned for light surfaces and drops below AA against near-black, so on-dark text
         gets its own token (11:1 here) instead of reusing TextSecondary/TextMuted. -->
    <SolidColorBrush x:Key="PlayerTextBrush" Color="#D1D5DB"/>
    <!-- Chip/badge raised off the player surface (empty-state icons, overlay pills). -->
    <SolidColorBrush x:Key="PlayerSurfaceRaisedBrush" Color="#1F2937"/>

    <!-- Semantic -->
    <!-- Fill for success buttons; dark enough for the bold white label on top. -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#166534"/>
    <!-- Green as small TEXT on a light surface needs to go darker still (5.6:1). -->
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#166534"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#CBD5E1"/>
    <!-- Foreground for disabled controls: dark enough to read on DisabledBrush -->
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#475569"/>

    <!-- ============================================================= -->
    <!--  PER-TAB ACCENT                                               -->
    <!--                                                               -->
    <!--  Every tab shares the same neutral surfaces, cards, spacing   -->
    <!--  and type. A tab differs only by its accent, which appears in  -->
    <!--  small doses: the section dots, the intro banner and the       -->
    <!--  primary action button.                                        -->
    <!--                                                               -->
    <!--  A tab claims its identity by overriding TabAccentBrush once,  -->
    <!--  in its root element's Resources:                              -->
    <!--                                                               -->
    <!--      <Grid.Resources>                                          -->
    <!--          <SolidColorBrush x:Key="TabAccentBrush"               -->
    <!--                  Color="{StaticResource AccentRoseColor}"/>    -->
    <!--      </Grid.Resources>                                         -->
    <!--                                                               -->
    <!--  The styles below reference it with DynamicResource, not       -->
    <!--  StaticResource: StaticResource would bind once at the point   -->
    <!--  the style is DEFINED (here, always the brand orange), while   -->
    <!--  DynamicResource resolves from where the style is APPLIED and  -->
    <!--  so picks up each tab's override.                              -->
    <!--                                                               -->
    <!--  Every accent is dark enough to carry white text at AA.        -->
    <!-- ============================================================= -->
    <Color x:Key="AccentVioletColor">#7C3AED</Color>
    <Color x:Key="AccentIndigoColor">#4F46E5</Color>
    <Color x:Key="AccentCyanColor">#0E7490</Color>
    <Color x:Key="AccentEmeraldColor">#047857</Color>
    <Color x:Key="AccentAmberColor">#B45309</Color>
    <Color x:Key="AccentRoseColor">#E11D48</Color>

    <!-- Brush forms, for windows that are not tab-based and just need a named accent. -->
    <SolidColorBrush x:Key="AccentVioletBrush" Color="{StaticResource AccentVioletColor}"/>
    <SolidColorBrush x:Key="AccentIndigoBrush" Color="{StaticResource AccentIndigoColor}"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}"/>
    <SolidColorBrush x:Key="AccentEmeraldBrush" Color="{StaticResource AccentEmeraldColor}"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}"/>
    <SolidColorBrush x:Key="AccentRoseBrush" Color="{StaticResource AccentRoseColor}"/>

    <!-- Default accent, used by any tab that does not override it. -->
    <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource BrandColor}"/>

    <!-- ============================================================= -->
    <!--  TEXT STYLES                                                  -->
    <!--                                                               -->
    <!--  Two heading levels, used consistently:                        -->
    <!--    HeaderTextStyle  - page/panel heading in a full-width area   -->
    <!--    SectionHeader    - compact heading inside a side rail        -->
    <!--                      (the accent-dot + caps control)            -->
    <!-- ============================================================= -->
    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Label above an input -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- Explanatory note under an input -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- "none" / "not built yet" text inside an empty preview frame -->
    <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================================= -->
    <!--  CONTAINER STYLES                                             -->
    <!-- ============================================================= -->
    <Style x:Key="SectionPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Same card, tightened for the narrow side rail of a two-column tab. -->
    <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource SectionPanelStyle}">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Root of a tab page: the one page colour behind every tab. -->
    <Style x:Key="TabPageStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
    </Style>

    <!-- Left input rail of a two-column tab. -->
    <Style x:Key="TabSideRailStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <!-- Strip that separates a region of the results pane (tiles, toolbars). -->
    <Style x:Key="ToolStripStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- Frame around an image/video preview. -->
    <Style x:Key="PreviewFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Accent-filled explainer at the top of a tab's side rail. -->
    <Style x:Key="IntroBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TabAccentBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="IntroTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="IntroBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <!-- White at ~90%: legible on every accent without going muddy. -->
        <Setter Property="Foreground" Value="#E6FFFFFF"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- ============================================================= -->
    <!--  BUTTON STYLES (keyed)                                        -->
    <!-- ============================================================= -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource DisabledBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary = neutral/outline action (was a clashing green) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NeutralBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource NeutralHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource DisabledBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource DisabledBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Compact flat action button (small toolbar/result buttons that keep their own inline
         Background/Foreground/size). Adds a rounded flat template and — critically — a readable,
         on-theme disabled state (dark fill + light muted text) instead of the OS default light-gray
         disabled chrome that renders near-invisible text on a dark panel. -->
    <Style x:Key="CompactActionButtonStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#374151"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#CBD5E1"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action inside a tab: same shape as PrimaryButtonStyle but filled with
         the tab's own accent, so each tab's main verb reads as that tab's colour. -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource TabAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- Deliberately tight: these sit in rails on buttons with an explicit Height="28". -->
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBrush}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Terminal/confirming action ("Upscale selected", "Finish"). Green carries the meaning
         here, so it stays fixed rather than following the tab accent. -->
    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
    </Style>

    <!-- Quiet companion to AccentButtonStyle: outlined, accent text. For the secondary
         verb in a pair (Reroll next to Generate, Browse next to Analyze). -->
    <Style x:Key="AccentOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource TabAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DisabledBrush}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nav buttons: one consistent neutral pill, no per-button colors -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource BrandBrush}"/>
    </Style>

    <!-- Group pill: top-level nav selector (Create / Edit / Advanced).
         Quiet by default, solid brand fill when its group is active. -->
    <Style x:Key="GroupPillStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0F1F3"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================= -->
    <!--  IMPLICIT CONTROL STYLES (cascade app-wide, no x:Key)         -->
    <!--  Appearance-only setters; inline attributes still override,   -->
    <!--  so layout/behavior is preserved.                             -->
    <!-- ============================================================= -->

    <!-- TextBox: unify border + padding -->
    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrandBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BrandBrush}"/>
    </Style>

    <!-- ComboBox: unify border -->
    <Style TargetType="ComboBox">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- ProgressBar: brand accent, flat track -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Background" Value="#EDEFF2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="8"/>
    </Style>

    <!-- Expander: quieter, consistent header -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- TabControl: flat; header row scrolls horizontally instead of wrapping
         into multiple stacked rows (the app has 10-13 tabs per window). -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabItem: flat tab with accent underline on selection -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="14,9">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F0F1F3"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
