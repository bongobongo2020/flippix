<Window x:Class="FlipPix.UI.ImageAnalyzerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlipPix - Image Analyzer and Generator" Height="850" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        MinHeight="750" MinWidth="1000"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnalyzeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#6366F1" Offset="0"/>
                    <GradientStop Color="#8B5CF6" Offset="0.5"/>
                    <GradientStop Color="#EC4899" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="30,20">
                <TextBlock Text="Image Analyzer and Generator"
                          FontSize="32" FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Analyze images with QwenVL AI and generate new images with Z-Image"
                          FontSize="13" Foreground="#F3E8FF"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,15,20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">

                    <!-- Source Image Upload Section -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Source Image" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>

                            <TextBlock Text="Upload an image to analyze"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        Text="{Binding SourceImagePath, Mode=TwoWay}"
                                        IsReadOnly="True"
                                        Padding="10"
                                        Background="White"
                                        BorderBrush="#CED4DA"
                                        VerticalContentAlignment="Center"/>

                                <Button Grid.Column="1"
                                       Content="Browse"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       Command="{Binding BrowseImageCommand}"
                                       Margin="8,0,0,0"/>
                            </Grid>

                            <!-- Image Preview -->
                            <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                    Background="White" Height="300"
                                    CornerRadius="5">
                                <Grid>
                                    <TextBlock Text="No image selected"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="#999"
                                              FontStyle="Italic"
                                              FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSourceImage}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Image Source="{Binding SourceImageSource}"
                                           Stretch="Uniform"
                                           Margin="5"
                                           Visibility="{Binding HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- Analyze Button -->
                            <Button Content="Analyze Image with QwenVL"
                                   Style="{StaticResource AnalyzeButtonStyle}"
                                   Command="{Binding AnalyzeImageCommand}"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,15,0,0"
                                   Height="45"/>
                        </StackPanel>
                    </Border>

                    <!-- LM Studio Settings Section -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="LM Studio Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Server -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Server" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding LMStudioServer, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="10"
                                             Background="White"
                                             BorderBrush="#CED4DA"
                                             FontSize="12"/>
                                </StackPanel>

                                <!-- Port -->
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Port" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding LMStudioPort, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="10"
                                             Background="White"
                                             BorderBrush="#CED4DA"
                                             FontSize="12"/>
                                </StackPanel>

                                <!-- Test Connection Button -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="" Height="17" Margin="0,0,0,5"/>
                                    <Button Content="Test" Command="{Binding TestLMStudioConnectionCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="50"/>
                                </StackPanel>
                            </Grid>

                            <!-- Model Selection -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Model Dropdown -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="AI Model" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableModels}"
                                              SelectedValue="{Binding SelectedModel}"
                                              SelectedValuePath="Name"
                                              DisplayMemberPath="Name"
                                              Padding="10"
                                              Background="White"
                                              BorderBrush="#CED4DA"
                                              FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Refresh Models Button -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="" Height="17" Margin="0,0,0,5"/>
                                    <Button Content="Refresh" Command="{Binding RefreshModelsCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="70"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Image Settings Section -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Generation Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>

                            <!-- Aspect Ratio -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                <ComboBox SelectedIndex="{Binding AspectRatioIndex, Mode=TwoWay}"
                                         Padding="10"
                                         Background="White"
                                         BorderBrush="#CED4DA"
                                         FontSize="12">
                                    <ComboBoxItem Content="SDXL - 1:1 square 1024x1024"/>
                                    <ComboBoxItem Content="SDXL - 3:4 portrait 896x1152"/>
                                    <ComboBoxItem Content="SDXL - 9:16 portrait 768x1344"/>
                                    <ComboBoxItem Content="SDXL - 4:3 landscape 1152x896"/>
                                    <ComboBoxItem Content="SDXL - 16:9 landscape 1344x768"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Style Preset -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Style Preset" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                <ComboBox SelectedIndex="{Binding SelectedStyleIndex, Mode=TwoWay}"
                                         ItemsSource="{Binding StyleNames}"
                                         Padding="10"
                                         Background="White"
                                         BorderBrush="#CED4DA"
                                         FontSize="12"/>
                            </StackPanel>

                            <!-- LORA (Optional) -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="LoRA Model" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>

                                <!-- Lora Enable Toggle -->
                                <CheckBox Content="Enable LoRA"
                                         IsChecked="{Binding LoraEnabled, Mode=TwoWay}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Margin="0,0,0,8"/>

                                <!-- Lora Selection (only visible when enabled) -->
                                <Grid Visibility="{Binding LoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                             ItemsSource="{Binding AvailableLoras}"
                                             SelectedItem="{Binding SelectedLora, Mode=TwoWay}"
                                             Padding="10"
                                             Background="White"
                                             BorderBrush="#CED4DA"
                                             FontSize="12"
                                             Height="35"
                                             Margin="0,0,8,0"/>

                                    <Button Grid.Column="1"
                                           Content="Refresh"
                                           Command="{Binding RefreshLorasCommand}"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           Width="70"
                                           Height="35"/>
                                </Grid>
                            </StackPanel>

                            <!-- Steps -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Value="{Binding Steps, Mode=TwoWay}"
                                            Minimum="4" Maximum="20"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                              Text="{Binding Steps}"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              MinWidth="30"
                                              FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>

                            <!-- CFG -->
                            <StackPanel>
                                <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Value="{Binding Cfg, Mode=TwoWay}"
                                            Minimum="1" Maximum="3"
                                            TickFrequency="0.5"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                              Text="{Binding Cfg, StringFormat={}{0:F1}}"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              MinWidth="30"
                                              FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">

                    <!-- Analysis Result Section -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="AI Analysis Result" Style="{StaticResource HeaderTextStyle}" Foreground="#8B5CF6"/>

                            <TextBlock Text="Edit the analysis before generating the image"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,10"/>

                            <TextBox Text="{Binding AnalysisText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    Height="200"
                                    Padding="12"
                                    VerticalScrollBarVisibility="Auto"
                                    Background="White"
                                    BorderBrush="#CED4DA"
                                    FontSize="13"
                                    Margin="0,0,0,15"/>

                            <!-- Processing Status for Analysis -->
                            <Border Background="#FEF3C7"
                                    BorderBrush="#FCD34D"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,0,15"
                                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Analyzing image..."
                                              FontWeight="Bold"
                                              FontSize="12"
                                              Margin="0,0,0,8"
                                              TextAlignment="Center"
                                              Foreground="#92400E"/>
                                    <ProgressBar IsIndeterminate="True"
                                                Height="20"
                                                Foreground="#F59E0B"/>
                                </StackPanel>
                            </Border>

                            <!-- Generate Button -->
                            <Button Content="Process &amp; Generate Image"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Command="{Binding GenerateImageCommand}"
                                   HorizontalAlignment="Stretch"
                                   Height="50"
                                   FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <!-- Processing Status for Generation -->
                    <Border Style="{StaticResource SectionPanelStyle}"
                            Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Generation Progress" Style="{StaticResource HeaderTextStyle}" Foreground="#EC4899"/>

                            <Border Background="#FCE7F3"
                                    BorderBrush="#F9A8D4"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProcessingStatus}"
                                              FontWeight="SemiBold"
                                              FontSize="12"
                                              Margin="0,0,0,8"
                                              TextAlignment="Center"
                                              TextWrapping="Wrap"
                                              Foreground="#831843"/>
                                    <ProgressBar Value="{Binding ProcessingProgress}"
                                                Height="20"
                                                Foreground="#EC4899"
                                                Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding ProgressPercentage}"
                                              HorizontalAlignment="Center"
                                              FontSize="12"
                                              FontWeight="Bold"
                                              Foreground="#EC4899"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Result Image Section -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Generated Image" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                            <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                    Background="White" Height="350"
                                    CornerRadius="5" Margin="0,0,0,12">
                                <Grid>
                                    <TextBlock Text="Generated image will appear here"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="#999"
                                              FontStyle="Italic"
                                              FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasResultImage}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Image Source="{Binding ResultImageSource}"
                                           Stretch="Uniform"
                                           Margin="5"
                                           Visibility="{Binding HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <Button Content="Open Output Folder"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding OpenResultFolderCommand}"
                                   IsEnabled="{Binding HasResultImage}"
                                   HorizontalAlignment="Stretch"/>

                            <TextBlock Text="{Binding ImageInfo}"
                                      FontStyle="Italic"
                                      Foreground="#666"
                                      FontSize="11"
                                      Margin="0,10,0,0"
                                      TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="30">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=" | " FontSize="11"/>
                    <TextBlock Text="LM Studio: " FontSize="11" Foreground="#10B981"/>
                    <TextBlock Text="{Binding LMStudioServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding LMStudioPort}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=" (" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedModel}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock Text=")" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
