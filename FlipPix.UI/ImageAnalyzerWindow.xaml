<Window x:Class="FlipPix.UI.ImageAnalyzerWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlipPix - Image Analyzer and Generator" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        MinWidth="1100"
        MinHeight="700"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnalyzeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Radio Button Style for Input Mode -->
        <Style x:Key="ToggleRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DEE2E6"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#6366F1"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Queue Flash Animation -->
        <Storyboard x:Key="QueueFlashAnimation">
            <ColorAnimation Storyboard.TargetName="QueueBorder"
                          Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                          From="#28A745" To="#DEE2E6" Duration="0:0:1"/>
        </Storyboard>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#6366F1" Offset="0"/>
                    <GradientStop Color="#8B5CF6" Offset="0.5"/>
                    <GradientStop Color="#EC4899" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="25,15">
                <TextBlock Text="Image Analyzer and Generator"
                          FontSize="26" FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Create images from text prompts or analyze images with QwenVL AI"
                          FontSize="12" Foreground="#F3E8FF"
                          Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content - 2 Column Split -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="15,12,15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="55*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN - Input & Settings -->
                <StackPanel Grid.Column="0">

                    <!-- Section A: Input Mode -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Input Mode" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1"/>

                            <!-- Input Mode Toggle -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="Text Prompt"
                                           IsChecked="{Binding IsTextPromptMode, Mode=OneWay}"
                                           GroupName="InputMode"
                                           Style="{StaticResource ToggleRadioStyle}"
                                           Margin="0,0,5,0"/>
                                <RadioButton Content="Image Analysis"
                                           IsChecked="{Binding IsImageAnalysisMode}"
                                           GroupName="InputMode"
                                           Style="{StaticResource ToggleRadioStyle}"
                                           Margin="5,0,0,0"/>
                            </StackPanel>

                            <!-- Image Analysis Section (visible only in Image Analysis mode) -->
                            <StackPanel Visibility="{Binding IsImageAnalysisMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Upload an image to analyze"
                                           FontSize="11"
                                           Foreground="#666"
                                           Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                            Text="{Binding SourceImagePath, Mode=TwoWay}"
                                            IsReadOnly="True"
                                            Padding="8"
                                            Background="White"
                                            BorderBrush="#CED4DA"
                                            VerticalContentAlignment="Center"
                                            FontSize="11"
                                            Height="30"/>

                                    <Button Grid.Column="1"
                                           Content="Browse"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           Command="{Binding BrowseImageCommand}"
                                           Margin="6,0,0,0"
                                           Height="30"
                                           Padding="12,6"/>
                                </Grid>

                                <!-- Image Preview -->
                                <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                        Background="White" Height="180"
                                        CornerRadius="5" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="No image selected"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="#999"
                                                  FontStyle="Italic"
                                                  FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSourceImage}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Image Source="{Binding SourceImageSource}"
                                               Stretch="Uniform"
                                               Margin="5"
                                               Visibility="{Binding HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Analyze Button -->
                                <Button Content="Analyze Image with QwenVL"
                                       Style="{StaticResource AnalyzeButtonStyle}"
                                       Command="{Binding AnalyzeImageCommand}"
                                       HorizontalAlignment="Stretch"
                                       Height="38"/>

                                <!-- Processing Status for Analysis -->
                                <Border Background="#FEF3C7"
                                        BorderBrush="#FCD34D"
                                        BorderThickness="2"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Analyzing image..."
                                                  FontWeight="Bold"
                                                  FontSize="11"
                                                  Margin="0,0,0,6"
                                                  TextAlignment="Center"
                                                  Foreground="#92400E"/>
                                        <ProgressBar IsIndeterminate="True"
                                                    Height="18"
                                                    Foreground="#F59E0B"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Prompt TextBox (always visible) -->
                            <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AnalysisText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    Height="100"
                                    Padding="10"
                                    VerticalScrollBarVisibility="Auto"
                                    Background="White"
                                    BorderBrush="#CED4DA"
                                    FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Section B: Workflow Selection -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Workflow Selection" Style="{StaticResource HeaderTextStyle}" Foreground="#8B5CF6"/>

                            <TextBlock Text="Select the AI workflow to use for generation" FontSize="11" Foreground="#666" Margin="0,0,0,8"/>

                            <ComboBox SelectedIndex="{Binding SelectedWorkflowIndex, Mode=TwoWay}"
                                     Padding="8"
                                     Background="White"
                                     BorderBrush="#CED4DA"
                                     FontSize="11"
                                     Height="32">
                                <ComboBoxItem Content="Zimage (Style-based generation)"/>
                                <ComboBoxItem Content="Qwen2512 (Qwen 2.5 12B)"/>
                                <ComboBoxItem Content="Klien (Flux Klein)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Section C: Style Preset (extracted from Generation Settings Expander) -->
                    <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding ShowStyleOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Style Preset" Style="{StaticResource HeaderTextStyle}" Foreground="#8B5CF6"/>
                            <ComboBox SelectedIndex="{Binding SelectedStyleIndex, Mode=TwoWay}"
                                     ItemsSource="{Binding StyleNames}"
                                     Padding="8"
                                     Background="White"
                                     BorderBrush="#CED4DA"
                                     FontSize="11"
                                     Height="32"
                                     Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Section D: LoRA (extracted from Generation Settings Expander) -->
                    <Border Style="{StaticResource SectionPanelStyle}" Visibility="{Binding ShowLoraOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="LoRA Model" Style="{StaticResource HeaderTextStyle}" Foreground="#8B5CF6"/>
                            <CheckBox Content="Enable LoRA"
                                     IsChecked="{Binding LoraEnabled, Mode=TwoWay}"
                                     FontWeight="SemiBold"
                                     FontSize="11"
                                     Margin="0,4,0,6"/>
                            <Grid Visibility="{Binding LoraEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                         ItemsSource="{Binding AvailableLoras}"
                                         SelectedItem="{Binding SelectedLora, Mode=TwoWay}"
                                         Padding="8"
                                         Background="White"
                                         BorderBrush="#CED4DA"
                                         FontSize="11"
                                         Height="32"
                                         Margin="0,0,6,0"/>
                                <Button Grid.Column="1"
                                       Content="Refresh"
                                       Command="{Binding RefreshLorasCommand}"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       Width="60"
                                       Height="32"
                                       Padding="10,5"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section E: Queue Actions (moved up from bottom) -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Queue Actions" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                            <Button Content="Add to Queue"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Command="{Binding AddToQueueCommand}"
                                   HorizontalAlignment="Stretch"
                                   Height="42"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>

                            <Button Content="Add to Queue &amp; Start"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding AddToQueueAndStartCommand}"
                                   HorizontalAlignment="Stretch"
                                   Height="42"
                                   FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Section F: Advanced Settings (Collapsible, reduced content) -->
                    <Expander Header="⚙️ Advanced Settings" Margin="0,0,0,10" IsExpanded="True">
                        <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                            <StackPanel>
                                <!-- Aspect Ratio -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox SelectedIndex="{Binding AspectRatioIndex, Mode=TwoWay}"
                                             Padding="8"
                                             Background="White"
                                             BorderBrush="#CED4DA"
                                             FontSize="11"
                                             Height="30">
                                        <ComboBoxItem Content="Landscape"/>
                                        <ComboBoxItem Content="Portrait"/>
                                        <ComboBoxItem Content="Square"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Steps -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Steps" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Steps, Mode=TwoWay}"
                                                Minimum="4" Maximum="20"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                Height="20"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Steps}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"
                                                  FontSize="11"/>
                                    </Grid>
                                </StackPanel>

                                <!-- CFG -->
                                <StackPanel>
                                    <TextBlock Text="CFG Scale" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Value="{Binding Cfg, Mode=TwoWay}"
                                                Minimum="1" Maximum="3"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                Height="20"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Cfg, StringFormat={}{0:F1}}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="25"
                                                  FontWeight="Bold"
                                                  FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- LM Studio Settings (Collapsible) -->
                    <Expander Header="🔌 LM Studio Connection" Margin="0,0,0,10" IsExpanded="False">
                        <Border Style="{StaticResource SectionPanelStyle}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="LM Studio Settings" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Server" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding LMStudioServer, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="11"
                                                 Height="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Port" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding LMStudioPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8"
                                                 Background="White"
                                                 BorderBrush="#CED4DA"
                                                 FontSize="11"
                                                 Height="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="" Height="15" Margin="0,0,0,4"/>
                                        <Button Content="Test" Command="{Binding TestLMStudioConnectionCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="50"
                                                Height="30"
                                                Padding="10,5"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="AI Model" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                                  SelectedValue="{Binding SelectedModel}"
                                                  SelectedValuePath="Name"
                                                  Padding="8"
                                                  Background="White"
                                                  BorderBrush="#CED4DA"
                                                  FontSize="11"
                                                  Height="30">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="" Height="15" Margin="0,0,0,4"/>
                                        <Button Content="Refresh" Command="{Binding RefreshModelsCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="65"
                                                Height="30"
                                                Padding="10,5"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                </StackPanel>

                <!-- RIGHT COLUMN - Queue & Results -->
                <StackPanel Grid.Column="2">

                    <!-- Section E: Queue Status Bar -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Queue Status" Style="{StaticResource HeaderTextStyle}" Foreground="#EC4899"/>

                            <Border Background="#F8F9FA"
                                    BorderBrush="#DEE2E6"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                              Text="Queue:"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                              Text="{Binding QueuedCount, StringFormat={}Queued: {0}}"
                                              Margin="10,0"
                                              VerticalAlignment="Center"
                                              FontSize="11"/>

                                    <TextBlock Grid.Column="2"
                                              Text="{Binding CompletedCount, StringFormat={}Completed: {0}}"
                                              Margin="10,0"
                                              VerticalAlignment="Center"
                                              FontSize="11"
                                              Foreground="#28A745"/>

                                    <TextBlock Grid.Column="3"
                                              Text="{Binding FailedCount, StringFormat={}Failed: {0}}"
                                              Margin="10,0"
                                              VerticalAlignment="Center"
                                              FontSize="11"
                                              Foreground="#DC3545"/>
                                </Grid>
                            </Border>

                            <!-- Processing Progress -->
                            <Border Background="#FFF9F0"
                                    BorderBrush="#FFE0B0"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="12"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding QueueProgressText, StringFormat={}Processing: {0}}"
                                              FontWeight="SemiBold"
                                              FontSize="11"
                                              Margin="0,0,0,5"
                                              TextAlignment="Center"/>
                                    <ProgressBar Value="{Binding QueueProgress, Mode=OneWay}"
                                                Maximum="{Binding QueueTotal, Mode=OneWay}"
                                                Height="16"
                                                Foreground="#FF6B35"
                                                Margin="0,0,0,5"/>

                                    <!-- Pause/Resume/Cancel Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                               Content="⏸ Pause"
                                               Command="{Binding PauseQueueCommand}"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Width="70"
                                               Height="28"
                                               HorizontalAlignment="Center"
                                               Padding="8,4"
                                               FontSize="11"
                                               Margin="0,0,5,0"/>

                                        <Button Grid.Column="1"
                                               Content="▶ Resume"
                                               Command="{Binding ResumeQueueCommand}"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Width="70"
                                               Height="28"
                                               HorizontalAlignment="Center"
                                               Padding="8,4"
                                               FontSize="11"
                                               Margin="5,0"/>

                                        <Button Grid.Column="2"
                                               Content="✖ Cancel"
                                               Command="{Binding CancelProcessingCommand}"
                                               Width="70"
                                               Height="28"
                                               HorizontalAlignment="Center"
                                               Padding="8,4"
                                               FontSize="11"
                                               Background="#DC3545"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Margin="5,0,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="5"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E55563"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section F: Queue Items List -->
                    <Border x:Name="QueueBorder"
                            BorderBrush="#DEE2E6"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="White"
                            Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#DEE2E6"/>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Queue Items" Style="{StaticResource HeaderTextStyle}" Foreground="#6366F1" Padding="15,15,15,0"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350" Padding="15">
                                <ItemsControl ItemsSource="{Binding QueueItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E9ECEF"
                                                   BorderThickness="0,0,0,1"
                                                   Padding="12"
                                                   Background="White">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Workflow Badge -->
                                                    <Border Grid.Column="0"
                                                            Background="{Binding WorkflowBadgeColor}"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding WorkflowBadge}"
                                                                  FontWeight="Bold"
                                                                  FontSize="10"
                                                                  Foreground="White"/>
                                                    </Border>

                                                    <!-- Item Info -->
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayPrompt}"
                                                                  FontWeight="SemiBold"
                                                                  FontSize="12"
                                                                  TextTrimming="CharacterEllipsis"
                                                                  MaxWidth="350"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding StyleName}"
                                                                      FontSize="10"
                                                                      Foreground="#666"
                                                                      Visibility="{Binding StyleNameVisibility}"/>

                                                            <TextBlock Text="{Binding AspectRatioDisplay}"
                                                                      FontSize="10"
                                                                      Foreground="#666"
                                                                      Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Status -->
                                                    <StackPanel Grid.Column="2"
                                                               Orientation="Horizontal"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0">

                                                        <!-- Clickable thumbnail for completed items -->
                                                        <Button Command="{Binding OpenImageCommand}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="2"
                                                                Cursor="Hand"
                                                                ToolTip="Click to open full image">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="Transparent"
                                                                                        BorderBrush="#DEE2E6"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="4"
                                                                                        Padding="2"
                                                                                        Cursor="Hand">
                                                                                    <ContentPresenter/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Status}" Value="Completed"/>
                                                                                <Condition Binding="{Binding HasOutputImage}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Image Source="{Binding OutputImageThumbnail}"
                                                                   Stretch="Uniform"
                                                                   Width="50"
                                                                   Height="50"/>
                                                        </Button>

                                                        <!-- Text status for non-completed items (or completed without image) -->
                                                        <TextBlock Text="{Binding StatusDisplay}"
                                                                  FontSize="11"
                                                                  FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Status}" Value="Completed"/>
                                                                                <Condition Binding="{Binding HasOutputImage}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Progress bar for processing items -->
                                                        <ProgressBar Value="{Binding Progress}"
                                                                   Width="50"
                                                                   Height="12"
                                                                   Margin="5,0">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                    </StackPanel>

                                                    <!-- Remove Button -->
                                                    <Button Grid.Column="3"
                                                           Content="❌"
                                                           Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Background="Transparent"
                                                           BorderThickness="0"
                                                           Padding="5"
                                                           ToolTip="Remove from queue"
                                                           FontSize="12"
                                                           Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Section G: Queue Control Buttons -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Queue Controls" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                       Content="Process Queue"
                                       Style="{StaticResource PrimaryButtonStyle}"
                                       Command="{Binding GenerateImageCommand}"
                                       Margin="0,0,5,0"
                                       Height="38"/>

                                <Button Grid.Column="1"
                                       Content="Clear Queue"
                                       Command="{Binding ClearQueueCommand}"
                                       Margin="5,0,0,0"
                                       Height="38">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="Background" Value="#DC3545"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E55563"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <Button Content="Open Output Folder"
                                   Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding OpenResultFolderCommand}"
                                   IsEnabled="{Binding HasResultImage}"
                                   HorizontalAlignment="Stretch"
                                   Height="36"
                                   Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Section H: Result Preview -->
                    <Border Style="{StaticResource SectionPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Latest Result" Style="{StaticResource HeaderTextStyle}" Foreground="#10B981"/>

                            <Border BorderBrush="#DEE2E6" BorderThickness="2"
                                    Background="White" Height="180"
                                    CornerRadius="5" Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock Text="Result will appear here"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="#999"
                                              FontStyle="Italic"
                                              FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasResultImage}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Command="{Binding OpenResultImageCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Click to open in image viewer" Padding="0">
                                        <Image Source="{Binding ResultImageSource}"
                                               Stretch="Uniform" Margin="5"
                                               Visibility="{Binding HasResultImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding ImageInfo}"
                                      FontStyle="Italic"
                                      Foreground="#666"
                                      FontSize="10"
                                      Margin="0,8,0,0"
                                      TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Height="26">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="10" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="10" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="10"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text=" | " FontSize="10"/>
                    <TextBlock Text="LM Studio: " FontSize="10" Foreground="#10B981"/>
                    <TextBlock Text="{Binding LMStudioServer}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="10"/>
                    <TextBlock Text="{Binding LMStudioPort}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text=" (" FontSize="10"/>
                    <TextBlock Text="{Binding SelectedModel}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock Text=")" FontSize="10"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
