<Window x:Class="FlipPix.UI.ExpressJobWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:FlipPix.UI.Controls"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="800" Width="1000"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

    <!--
        ➕ A new ⚡ H3 Express job, composed beside a run that is already going.

        Everything here writes into one ExpressJobViewModel, which holds a *copy* of the job — so Cancel
        leaves the queue untouched, and the run next door never sees a half-made job. See
        ExpressJobViewModel for why a job cannot simply be "the rail, later".
    -->

    <Window.Resources>
        <!-- H3 Express's accent. -->
        <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentVioletColor}"/>

        <Style x:Key="JobFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="JobHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="JobCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="JobRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- One cast slot: the photo is the button, ✕ clears it, the sex sits under it. -->
        <DataTemplate x:Key="JobCastTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{Binding Heading}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Tag}" FontSize="9" FontFamily="Consolas"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
                <Grid>
                    <Button Command="{Binding BrowseCommand}" Height="132" Cursor="Hand"
                            ToolTip="The person who plays this part in every story of THIS job. Click to choose or change the photo.">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" ClipToBounds="True"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        Background="{StaticResource SurfaceAltBrush}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPhoto}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="＋" FontSize="22" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                <TextBlock Text="Add photo" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="empty: cast from the story" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                        </Grid>
                    </Button>
                    <Button Content="&#x2715;" Command="{Binding ClearCommand}"
                            Width="22" Height="22" Margin="0,5,5,0" FontSize="10" Cursor="Hand"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Visibility="{Binding HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Remove this photo — the part is cast from each story again.">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="11" Background="{StaticResource ScrimBrush}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{StaticResource PlayerTextBrush}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <ComboBox ItemsSource="{Binding SexOptions}" SelectedItem="{Binding Sex, Mode=TwoWay}"
                          Height="26" FontSize="11" Margin="0,6,0,0"
                          ToolTip="Who is in the photo. This job's stories call each character he or she by it."/>
            </StackPanel>
        </DataTemplate>

        <!-- What one photographed person wears, for the own-clothes mode. -->
        <DataTemplate x:Key="JobCastOutfitTemplate">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Heading, StringFormat={}{0} wears}" FontSize="10" Margin="0,0,0,3"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding Outfit, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                         AcceptsReturn="False" MinHeight="40" FontSize="11" Padding="6,4"
                         ToolTip="One sentence naming every garment with its colour and material. Leave it empty and it is read off the photo by the vision model when this job starts."/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="{Binding HeadingText}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Style="{StaticResource JobHint}" Margin="0,3,0,0"
                           Text="Its own folder, its own cast and its own render settings. It waits its turn behind whatever is already rendering and does not touch it."/>
            </StackPanel>
        </Border>

        <!-- ═══ Body ═════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
            <Grid Margin="16,14,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- ─── LEFT: what it renders, and who is in it ──────────────────── -->
                <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ctrl:SectionHeader Title="STORIES" Note="  · every .txt becomes a film" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Choose folder…" Command="{Binding PickFolderCommand}"
                                        Height="32" FontSize="12" Margin="0,0,6,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="The folder this job's stories come from. Every .txt, .md or .text in it becomes one film, in name order."/>
                                <Button Grid.Column="1" Content="&#x27F3;" Width="32" Height="32" FontSize="13"
                                        Command="{Binding RescanCommand}"
                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        ToolTip="Re-read the folder and add anything new."/>
                            </Grid>
                            <TextBlock Text="{Binding FolderText}" Style="{StaticResource JobHint}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                    Background="{StaticResource SurfaceAltBrush}" MinHeight="90" MaxHeight="220">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Stories}" Margin="6,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{StaticResource TextFaintBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Button Grid.Column="2" Content="&#x2715;" Width="20" Height="20" FontSize="10"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Command="{Binding DataContext.RemoveStoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Take this story out of the job. The file is not touched."/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{Binding StoriesSummary}" Style="{StaticResource JobHint}"
                                           Margin="0,0,80,0"/>
                                <Button Content="Clear" Command="{Binding ClearStoriesCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Height="22" Padding="10,0" FontSize="10"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Empty this job's story list and start again."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ctrl:SectionHeader Title="CAST" Note="  · optional · this job's own people" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" Content="{Binding Cast1}"
                                                ContentTemplate="{StaticResource JobCastTemplate}"/>
                                <ContentControl Grid.Column="2" Content="{Binding Cast2}"
                                                ContentTemplate="{StaticResource JobCastTemplate}"/>
                            </Grid>

                            <TextBlock Text="What they wear" Style="{StaticResource JobFieldLabel}"/>
                            <RadioButton Content="👗 The story's saved wardrobe" GroupName="JobCastClothes"
                                         IsChecked="{Binding CastStoryWardrobe, Mode=TwoWay}"
                                         Style="{StaticResource JobRadio}"
                                         ToolTip="Your people in each story's own outfits. The character sheets re-dress them; saved clips are used word for word."/>
                            <RadioButton Content="👕 Their own clothes" GroupName="JobCastClothes"
                                         IsChecked="{Binding CastOwnClothes, Mode=TwoWay}"
                                         Style="{StaticResource JobRadio}"
                                         ToolTip="Your people in what they wear in their photos. A saved story's clips get a clothing-only rewrite when the job runs."/>

                            <StackPanel Visibility="{Binding CastOwnClothes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ContentControl Content="{Binding Cast1}" ContentTemplate="{StaticResource JobCastOutfitTemplate}"
                                                Visibility="{Binding Cast1.HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <ContentControl Content="{Binding Cast2}" ContentTemplate="{StaticResource JobCastOutfitTemplate}"
                                                Visibility="{Binding Cast2.HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding CastSummary}" Style="{StaticResource JobHint}" Margin="0,8,0,10"/>

                            <TextBlock Text="Cast photos (for characters you give no photo)" Style="{StaticResource JobFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CastPhotoEngineOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding CastPhotoEngine}"
                                      Height="30" FontSize="11"
                                      ToolTip="The text-to-image workflow that photographs a character this job has no photo of yours for. The character sheet is then built from that photo as always."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ─── RIGHT: how it renders ────────────────────────────────────── -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ctrl:SectionHeader Title="RENDER" Note="  · applies to every story in this job" Margin="0,0,0,10"/>

                            <TextBlock Text="Sampling stack" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <RadioButton Content="✴️ Singularity" GroupName="JobStack"
                                         IsChecked="{Binding StackIsSingularity, Mode=TwoWay}"
                                         Style="{StaticResource JobRadio}"/>
                            <CheckBox Content="er__sde/beta sampler (keep the sigma shift)"
                                      IsChecked="{Binding SingularityErSde}"
                                      Visibility="{Binding StackIsSingularity, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Style="{StaticResource JobCheck}" Margin="20,2,0,2"/>
                            <RadioButton Content="🍥 TaoMate relay" GroupName="JobStack"
                                         IsChecked="{Binding StackIsTaoMate, Mode=TwoWay}"
                                         Style="{StaticResource JobRadio}"/>
                            <RadioButton Content="🐰 BUNNY (action)" GroupName="JobStack"
                                         IsChecked="{Binding StackIsBunny, Mode=TwoWay}"
                                         Style="{StaticResource JobRadio}"/>
                            <RadioButton Content="🌹 H3 Eros" GroupName="JobStack"
                                         IsChecked="{Binding StackIsEros, Mode=TwoWay}"
                                         Style="{StaticResource JobRadio}"/>
                            <TextBlock Text="{Binding StackSummary}" Style="{StaticResource JobHint}" Margin="20,2,0,10"/>

                            <!-- Chained clips: this job's own, because the rail's copy is frozen while a run
                                 is going and a job queued mid-run must still be able to choose. -->
                            <CheckBox Content="🔗 Chain clips into one continuous shot"
                                      IsChecked="{Binding ChainClips}"
                                      Style="{StaticResource JobCheck}" Margin="0,2,0,2"
                                      ToolTip="Render this job's stories as ONE shot instead of separate clips glued together. Clip 2 onward is generated continuing from the last second of the clip before it — the picture and the sound both, carried across as latents by the H3 Motion Context node pack — and the pinned head is trimmed off, so five 5-second clips play as one seamless 25 seconds.&#x0a;&#x0a;Needs ComfyUI-H3-Motion-Context (github.com/NikoDemon80/ComfyUI-H3-Motion-Context) installed on the ComfyUI server; without it the run says so and renders every clip on its own.&#x0a;&#x0a;New clip prompts are written to open on the previous clip's last moment. Prompts saved before this was on are not — untick Reuse saved prompts to have them rewritten."/>
                            <CheckBox Content="also pin the upscale pass"
                                      IsChecked="{Binding ChainPinFinish}"
                                      Visibility="{Binding ChainClips, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Style="{StaticResource JobCheck}" Margin="20,2,0,2"
                                      ToolTip="The finish re-samples the draft from a high noise level, so a join that is only pinned on the draft can be undone by it. With this on, the upscale pass is pinned to the previous clip's FINISHED tail as well (a second latent is saved per clip). Untick it if the finish misbehaves — the draft pass stays chained. 🍥 TaoMate has no upscale pass; both its legs are pinned regardless."/>
                            <TextBlock Text="{Binding ChainSummary}" Style="{StaticResource JobHint}" Margin="20,2,0,10"/>

                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sampling steps" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8,1">
                                    <TextBlock Text="{Binding Steps}" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                </Border>
                            </Grid>
                            <!-- Minimum and Maximum before Value, as on the rail: a slider still holding its
                                 0-10 defaults would coerce a 12-step count down to 10 on the way in. -->
                            <Slider Minimum="{Binding MinSteps}" Maximum="30" Value="{Binding Steps}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                                    Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,10"/>

                            <TextBlock Text="Aspect ratio" Style="{StaticResource JobFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding AspectRatioOptions}" SelectedItem="{Binding SelectedAspectRatio}"
                                      Height="30" FontSize="11" Margin="0,0,0,10"/>

                            <TextBlock Text="Quality" Style="{StaticResource JobFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Megapixels}"
                                      Height="30" FontSize="11" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Film length" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8,1">
                                    <TextBlock Text="{Binding StoryDurationSeconds, StringFormat={}{0:0} s}"
                                               FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                </Border>
                            </Grid>
                            <Slider Minimum="5" Maximum="{Binding MaxStoryDurationSeconds}" Value="{Binding StoryDurationSeconds}"
                                    TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="15"
                                    Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Clip length" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8,1">
                                    <TextBlock Text="{Binding ClipLengthSeconds, StringFormat={}{0:0} s}"
                                               FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TabAccentBrush}"/>
                                </Border>
                            </Grid>
                            <Slider Minimum="4" Maximum="15" Value="{Binding ClipLengthSeconds}"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ClipPlanSummary}" Style="{StaticResource JobHint}" Margin="0,0,0,12"/>

                            <CheckBox Content="📚 Researched prompts" IsChecked="{Binding ResearchPrompts}"
                                      Style="{StaticResource JobCheck}" FontWeight="SemiBold" Margin="0,0,0,6"
                                      ToolTip="Write this job's clips with the build taken from the MiniMax-H3 guides."/>
                            <CheckBox Content="📐 Singularity spec prompts" IsChecked="{Binding SpecPrompts}"
                                      Style="{StaticResource JobCheck}" FontWeight="SemiBold" Margin="0,0,0,6"
                                      ToolTip="Write this job's clips to the six-section Singularity prompt-writing spec. Replaces the 📚 build."/>
                            <CheckBox Content="♻️ Reuse saved prompts" IsChecked="{Binding ReuseSavedPrompts}"
                                      Style="{StaticResource JobCheck}" FontWeight="SemiBold"
                                      ToolTip="A story whose clip prompts were written on an earlier run renders from them, with no clip writer."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <ctrl:SectionHeader Title="MORE" Note="  · the dials you set once" Margin="0,0,0,10"/>

                            <TextBlock Text="Model" Style="{StaticResource JobFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding DiffusionModelOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedDiffusionModel}"
                                      Height="30" FontSize="11" Margin="0,0,0,10"
                                      ToolTip="The H3 checkpoint this job loads. Picking a stack above moves it to that stack's own; change it afterwards and the choice sticks to this job."/>

                            <TextBlock Text="LoRA" Style="{StaticResource JobFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LoraOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedLora}"
                                      Height="30" FontSize="11" Margin="0,0,0,4"
                                      ToolTip="An optional LoRA from loras/H3, applied on top of the model to every clip of this job."/>
                            <StackPanel Visibility="{Binding HasLora, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LoRA strength" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8,1">
                                        <TextBlock Text="{Binding LoraStrength, StringFormat={}{0:0.00}}"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider Minimum="0" Maximum="2" Value="{Binding LoraStrength}"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.25"
                                        Foreground="{DynamicResource TabAccentBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Visual style" Style="{StaticResource JobFieldLabel}" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding VisualStyleOptions}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding VisualStyle, Mode=TwoWay}"
                                      Height="30" FontSize="11" Margin="0,0,0,10"/>

                            <StackPanel Visibility="{Binding UsesDraftCanvas, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Composition canvas" Style="{StaticResource JobFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PreviewMegapixelOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding PreviewMegapixels}"
                                          Height="30" FontSize="11" Margin="0,0,0,10"/>

                                <TextBlock Text="Upscale steps" Style="{StaticResource JobFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding UpscaleStepOptions}" SelectedItem="{Binding UpscaleSteps}"
                                          Height="30" FontSize="11" Margin="0,0,0,10"/>
                            </StackPanel>

                            <CheckBox Content="RIFE interpolation (24 → 48 fps)" IsChecked="{Binding UseRife}"
                                      Style="{StaticResource JobCheck}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══ Footer ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
                           Style="{StaticResource JobHint}"
                           Text="{Binding JobFooterLine}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"
                            Height="36" Padding="18,0" FontSize="12" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"/>
                    <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}" Click="ConfirmButton_Click"
                            Height="36" Padding="20,0" FontSize="13" IsDefault="True"
                            IsEnabled="{Binding CanQueue}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="Put this job at the end of the queue. It starts when everything ahead of it has finished."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
