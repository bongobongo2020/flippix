<Project Sdk="Microsoft.NET.Sdk">
  <!-- Android head for FlipPix.Mobile. All UI and logic live in the shared project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.flippix.mobile</ApplicationId>
    <ApplicationTitle>FlipPix</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- The shared ComfyUI client serialises anonymous types by reflection; full trimming would
         strip what it reads. Partial keeps framework trimming without touching app assemblies. -->
    <TrimMode>partial</TrimMode>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.2.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlipPix.Mobile\FlipPix.Mobile.csproj" />
  </ItemGroup>
</Project>
