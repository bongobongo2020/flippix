{
  "unet": {
    "inputs": {
      "unet_name": "h3-minimax/minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "H3 Model"
    }
  },
  "lora": {
    "inputs": {
      "lora_name": "H3/minimax_h3_ref2v_lightx2v_turbo_4step_v0.1_resized_avg_rank_20_bf16.safetensors",
      "strength_model": 1.0,
      "model": [
        "unet",
        0
      ]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Turbo LoRA (removed when the preset has none)"
    }
  },
  "shift": {
    "inputs": {
      "shift_video": 12.0,
      "shift_audio": 3.0,
      "model": [
        "lora",
        0
      ]
    },
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {
      "title": "Sigma Shift"
    }
  },
  "clip": {
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "H3 Text Encoder"
    }
  },
  "vae": {
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "H3 Video VAE"
    }
  },
  "avae": {
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "H3 Audio VAE"
    }
  },
  "img1": {
    "inputs": {
      "image": "picture1.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Picture 1"
    }
  },
  "img2": {
    "inputs": {
      "image": "picture2.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Picture 2"
    }
  },
  "img3": {
    "inputs": {
      "image": "picture3.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Picture 3"
    }
  },
  "img4": {
    "inputs": {
      "image": "picture4.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Picture 4"
    }
  },
  "prompt": {
    "inputs": {
      "value": ""
    },
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "Prompt"
    }
  },
  "res": {
    "inputs": {
      "aspect_ratio": "16:9 (Widescreen)",
      "megapixels": 0.5,
      "multiple": 32
    },
    "class_type": "ResolutionSelector",
    "_meta": {
      "title": "Resolution (fixed for the whole chain)"
    }
  },
  "seconds": {
    "inputs": {
      "value": 10.0
    },
    "class_type": "PrimitiveFloat",
    "_meta": {
      "title": "Duration (requested, untrimmed)"
    }
  },
  "frames": {
    "inputs": {
      "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
      "values.a": [
        "seconds",
        0
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Frames on the 17k+5 grid"
    }
  },
  "ref": {
    "inputs": {
      "prompt": [
        "prompt",
        0
      ],
      "width": [
        "res",
        0
      ],
      "height": [
        "res",
        1
      ],
      "length": [
        "frames",
        1
      ],
      "ref_image_size": "match",
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "audio_vae": [
        "avae",
        0
      ],
      "ref_images.ref_image_0": [
        "img1",
        0
      ],
      "ref_images.ref_image_1": [
        "img2",
        0
      ],
      "ref_images.ref_image_2": [
        "img3",
        0
      ],
      "ref_images.ref_image_3": [
        "img4",
        0
      ]
    },
    "class_type": "MiniMaxH3ReferenceToVideo",
    "_meta": {
      "title": "Reference to Video"
    }
  },
  "ctx_load": {
    "inputs": {
      "latent_path": "h3_editor_ctx/project",
      "clip_index": 0
    },
    "class_type": "MiniMaxH3MotionContextLoadLatent",
    "_meta": {
      "title": "Motion Context - previous clip"
    }
  },
  "ctx": {
    "inputs": {
      "conditioning": [
        "ref",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "latent": [
        "ref",
        1
      ],
      "context_length": "22",
      "audio_context_length": 18,
      "context_latent": [
        "ctx_load",
        0
      ],
      "audio_vae": [
        "avae",
        0
      ]
    },
    "class_type": "MiniMaxH3MotionContext",
    "_meta": {
      "title": "Motion Context (pins the previous clip's tail)"
    }
  },
  "guider": {
    "inputs": {
      "model": [
        "shift",
        0
      ],
      "conditioning": [
        "ctx",
        0
      ]
    },
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Guider"
    }
  },
  "sched": {
    "inputs": {
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0,
      "model": [
        "shift",
        0
      ]
    },
    "class_type": "BasicScheduler",
    "_meta": {
      "title": "Scheduler"
    }
  },
  "sampler": {
    "inputs": {
      "sampler_name": "res_multistep"
    },
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "Sampler"
    }
  },
  "noise": {
    "inputs": {
      "noise_seed": 0
    },
    "class_type": "RandomNoise",
    "_meta": {
      "title": "Noise"
    }
  },
  "sample": {
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sched",
        0
      ],
      "latent_image": [
        "ref",
        1
      ]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "Sample"
    }
  },
  "ctx_save": {
    "inputs": {
      "latent": [
        "sample",
        0
      ],
      "filename_prefix": "h3_editor_ctx/project/clip",
      "clip_index": 1
    },
    "class_type": "MiniMaxH3MotionContextSaveLatent",
    "_meta": {
      "title": "Motion Context - save this clip"
    }
  },
  "decode": {
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode Video"
    }
  },
  "decode_audio": {
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "avae",
        0
      ]
    },
    "class_type": "VAEDecodeAudio",
    "_meta": {
      "title": "Decode Audio"
    }
  },
  "trim": {
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "trim_frames": [
        "ctx",
        1
      ],
      "audio": [
        "decode_audio",
        0
      ],
      "fps": 24.0,
      "match_tail": true
    },
    "class_type": "MiniMaxH3MotionContextTrim",
    "_meta": {
      "title": "Trim pinned head"
    }
  },
  "video": {
    "inputs": {
      "fps": 24,
      "bit_depth": 8,
      "images": [
        "trim",
        0
      ],
      "audio": [
        "trim",
        1
      ]
    },
    "class_type": "CreateVideo",
    "_meta": {
      "title": "Create Video"
    }
  },
  "save": {
    "inputs": {
      "filename_prefix": "video/project/clip",
      "format": "auto",
      "codec": "auto",
      "video": [
        "video",
        0
      ]
    },
    "class_type": "SaveVideo",
    "_meta": {
      "title": "Save Video"
    }
  }
}