<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The phone app's UI and logic, platform-neutral so it also renders headlessly for quick checks
    (see FlipPix.Mobile.Android for the Android head). It is a remote for the FlipPix desktop: every
    job runs there (FlipPix.Remote), so the phone carries no workflows, no ComfyUI client and no LLM
    client, only the wire format in FlipPix.Remote.Contracts.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Suppress ImageSharp vulnerability warnings until license is obtained for v4.x
         Apply for free Community License at: https://licensing.sixlabors.com/ -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlipPix.Remote.Contracts\FlipPix.Remote.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.7" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- Phone photos are rotated from EXIF and shrunk before upload; Skia ignores the rotation tag. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
</Project>
