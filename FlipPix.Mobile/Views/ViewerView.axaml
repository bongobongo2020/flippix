<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlipPix.Mobile.ViewModels"
             xmlns:c="using:FlipPix.Mobile.Controls"
             x:Class="FlipPix.Mobile.Views.ViewerView"
             x:DataType="vm:ViewerViewModel"
             Background="#101119">
  <!-- Three rows that never overlap: a video is a native surface drawn above everything, so the bars
       sit beside it, not on it. -->
  <Grid RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,6,4,6">
      <Button Classes="bare" Command="{Binding CloseCommand}" AutomationProperties.Name="Close">
        <PathIcon Data="{StaticResource IconClose}" Width="24" Height="24" />
      </Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0" Spacing="1">
        <TextBlock Text="{Binding Current.Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="hint" FontSize="12" Text="{Binding Current.Subtitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="2" Classes="bare" Command="{Binding PreviousCommand}" IsVisible="{Binding HasMany}"
              AutomationProperties.Name="Previous">
        <PathIcon Data="{StaticResource IconChevronLeft}" Width="26" Height="26" />
      </Button>
      <Button Grid.Column="3" Classes="bare" Command="{Binding NextCommand}" IsVisible="{Binding HasMany}"
              AutomationProperties.Name="Next">
        <PathIcon Data="{StaticResource IconChevronRight}" Width="26" Height="26" />
      </Button>
    </Grid>

    <Panel Grid.Row="1" x:Name="Stage" Background="Transparent">
      <Image Source="{Binding Picture}" Stretch="Uniform" IsVisible="{Binding IsImage}" />
      <Border Classes="breathing" Width="48" Height="48" CornerRadius="24" Background="{StaticResource RaisedBrush}"
              IsVisible="{Binding IsImage}" x:Name="PictureWait" />
      <c:VideoSurface Sources="{Binding VideoSources}" IsVisible="{Binding IsVideo}" x:Name="Player" />
      <TextBlock x:Name="NoPlayer" Text="Videos play in the phone app." HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{StaticResource MutedBrush}" />
    </Panel>

    <StackPanel Grid.Row="2" Margin="12,6,12,14" Spacing="10">
      <TextBlock Classes="hint" Text="{Binding Counter}" HorizontalAlignment="Center" FontSize="12" />

      <TextBlock Classes="hint" Text="{Binding Notice}" HorizontalAlignment="Center" TextAlignment="Center" Margin="8,0"
                 IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Waiting on the computer. -->
      <StackPanel IsVisible="{Binding IsWorking}" Spacing="8" Margin="16,4">
        <TextBlock Text="{Binding WorkingText}" HorizontalAlignment="Center" FontWeight="SemiBold" />
        <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" Foreground="{StaticResource GlowBrush}" Background="#22F2EEE6" />
      </StackPanel>

      <!-- What the writing assistant saw. -->
      <Border IsVisible="{Binding HasDescription}" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="16,14" Margin="4,0">
        <StackPanel Spacing="12">
          <ScrollViewer MaxHeight="180">
            <SelectableTextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource PaperBrush}" />
          </ScrollViewer>
          <Grid ColumnDefinitions="*,10,Auto">
            <Button Classes="quiet" Content="Make a picture from this" HorizontalAlignment="Stretch" Command="{Binding UseDescriptionCommand}" />
            <Button Grid.Column="2" Classes="quiet" Content="Done" Command="{Binding HideDescriptionCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- What can be done with it. -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2" IsVisible="{Binding ShowActions}">
        <Button Classes="action" Command="{Binding DescribeCommand}" IsVisible="{Binding CanRead}" ToolTip.Tip="Describe it">
          <StackPanel Spacing="5">
            <PathIcon Data="{StaticResource IconText}" Width="22" Height="22" />
            <TextBlock Text="Describe" />
          </StackPanel>
        </Button>
        <Button Classes="action" Command="{Binding MakeSimilarCommand}" IsVisible="{Binding CanRead}" ToolTip.Tip="Make pictures like this">
          <StackPanel Spacing="5">
            <PathIcon Data="{StaticResource IconSparkle}" Width="22" Height="22" Foreground="{StaticResource GlowBrush}" />
            <TextBlock Text="Similar" />
          </StackPanel>
        </Button>
        <Button Classes="action" Command="{Binding AnimateCommand}" IsVisible="{Binding CanAnimate}" ToolTip.Tip="Make a video from it">
          <StackPanel Spacing="5">
            <PathIcon Data="{StaticResource IconVideo}" Width="22" Height="22" />
            <TextBlock Text="Animate" />
          </StackPanel>
        </Button>
        <Button Classes="action" Command="{Binding UsePromptCommand}" IsVisible="{Binding HasKnownPrompt}" ToolTip.Tip="Use its prompt again">
          <StackPanel Spacing="5">
            <PathIcon Data="{StaticResource IconPencil}" Width="22" Height="22" />
            <TextBlock Text="Prompt" />
          </StackPanel>
        </Button>
        <Button Classes="action" Click="OnSave" IsVisible="{Binding CanSave}" ToolTip.Tip="Save a copy on this phone">
          <StackPanel Spacing="5">
            <PathIcon Data="{StaticResource IconDownload}" Width="22" Height="22" />
            <TextBlock Text="Save" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
