<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlipPix.Mobile.ViewModels"
             xmlns:c="using:FlipPix.Mobile.Controls"
             x:Class="FlipPix.Mobile.Views.VideoView"
             x:DataType="vm:VideoViewModel">
  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="20,6,20,24" Spacing="28">

        <StackPanel Spacing="2">
          <TextBlock Classes="title" Text="Bring it to life" />
          <TextBlock Classes="hint" Text="{Binding VideoCredit}" IsVisible="{Binding HasVideoCredit}" />
        </StackPanel>

        <!-- Photos: who and where. The first one sets the frame. -->
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Photos" Margin="0" />
          <TextBlock Classes="hint" Text="{Binding PictureHint}" />
          <WrapPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding Pictures}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PictureSlot">
                  <Button Classes="bare" Padding="0" CornerRadius="14" AutomationProperties.Name="Remove photo"
                          Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).RemovePictureCommand}"
                          CommandParameter="{Binding}">
                    <Panel Width="68" Height="68">
                      <Border CornerRadius="14" ClipToBounds="True" Background="{StaticResource RaisedBrush}">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                      <Border Width="22" Height="22" CornerRadius="11" Background="#CC1B1D2A"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                        <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                      </Border>
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="breathing" Width="68" Height="68" CornerRadius="14" Background="{StaticResource RaisedBrush}"
                    IsVisible="{Binding IsPreparing}" Margin="8,0,0,0" ToolTip.Tip="Preparing the photo">
              <TextBlock Classes="hint" Text="Preparing" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button Classes="cell" Width="68" Height="68" IsVisible="{Binding CanAddPicture}" Margin="8,0,0,0"
                    Click="OnAddPhoto" AutomationProperties.Name="Add photo"
                    BorderBrush="{StaticResource LineBrush}">
              <StackPanel Spacing="2">
                <TextBlock Text="+" FontSize="24" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                <TextBlock Text="Add" FontSize="12" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>

        <!-- What happens: the one sentence that matters. -->
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="What happens" Margin="0" />
          <TextBox Text="{Binding Idea}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="104" MaxHeight="220" VerticalContentAlignment="Top"
                   Watermark="She looks up from her book, smiles, and says: &quot;You're late.&quot;"
                   AutomationProperties.Name="What happens" />
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasPictures}">
            <Button Classes="bare" Command="{Binding SuggestCommand}" Padding="8,6" Margin="-8,0,0,0"
                    ToolTip.Tip="The computer looks at the first photo and suggests what could happen">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconSparkle}" Width="16" Height="16" Foreground="{StaticResource GlowBrush}" />
                <TextBlock Text="Suggest what happens" FontWeight="SemiBold" Foreground="{StaticResource GlowBrush}" />
              </StackPanel>
            </Button>
            <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="50" HorizontalAlignment="Right"
                         VerticalAlignment="Center" IsVisible="{Binding IsSuggesting}" />
          </Grid>
          <TextBlock Classes="hint" Text="Your computer's writing assistant turns this into a full scene with sound, looking at the photos." />
          <TextBlock Classes="hint danger" Text="{Binding Notice}"
                     IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="section" Text="Length" />
          <UniformGrid Columns="3" Height="52">
            <Button Classes="cell" Classes.on="{Binding IsFive}" Margin="0,0,6,0"
                    Command="{Binding PickSecondsCommand}" CommandParameter="5">
              <TextBlock Text="5 seconds" FontWeight="SemiBold" />
            </Button>
            <Button Classes="cell" Classes.on="{Binding IsTen}" Margin="3,0"
                    Command="{Binding PickSecondsCommand}" CommandParameter="10">
              <TextBlock Text="10 seconds" FontWeight="SemiBold" />
            </Button>
            <Button Classes="cell" Classes.on="{Binding IsFifteen}" Margin="6,0,0,0"
                    Command="{Binding PickSecondsCommand}" CommandParameter="15">
              <TextBlock Text="15 seconds" FontWeight="SemiBold" />
            </Button>
          </UniformGrid>
        </StackPanel>

        <!-- Takes, newest first. -->
        <StackPanel Spacing="14">
          <TextBlock Classes="section" Text="Videos" Margin="0" />
          <Border IsVisible="{Binding NoTakes}" CornerRadius="16" Padding="18,22"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
            <TextBlock Classes="hint" FontSize="14" TextAlignment="Center"
                       Text="Each video is filmed on your computer while you watch its progress here. A 10 second clip takes about a minute." />
          </Border>
          <ItemsControl ItemsSource="{Binding Takes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="22" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:JobVm">
                <StackPanel Spacing="10">
                  <Button Classes="bare" Padding="0" CornerRadius="16" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}">
                    <c:AspectPanel Ratio="{Binding Ratio}" MaxHeight="440">
                      <Border CornerRadius="16" ClipToBounds="True" Background="{StaticResource SurfaceBrush}">
                        <Grid>
                          <Image Source="{Binding Poster}" Stretch="UniformToFill" Opacity="0.45" />
                          <Border Classes="breathing" Background="#661B1D2A" IsVisible="{Binding IsActive}" />
                          <!-- Play mark on a finished take. -->
                          <Border IsVisible="{Binding IsDone}" Width="68" Height="68" CornerRadius="34"
                                  Background="{StaticResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M0,0 L22,13 L0,26 Z" Fill="{StaticResource BoothBrush}" Margin="6,0,0,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel VerticalAlignment="Bottom" Margin="14,12" Spacing="8" IsVisible="{Binding !IsDone}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3"
                                         Classes.danger="{Binding IsProblem}" />
                              <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Elapsed}" Margin="12,0,0,0" />
                            </Grid>
                            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="4" MinHeight="4"
                                         CornerRadius="2" Foreground="{StaticResource GlowBrush}" Background="#33F2EEE6"
                                         IsVisible="{Binding IsRunning}" />
                            <TextBlock Classes="hint" Text="Tap to try again" IsVisible="{Binding ShowRetry}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </c:AspectPanel>
                  </Button>

                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="hint" Text="{Binding LengthLabel}" />
                  </StackPanel>
                  <WrapPanel Orientation="Horizontal" Margin="0,0,0,-6">
                    <Button Classes="quiet" Content="Scene" Height="38" Margin="0,0,6,6" Padding="14,0"
                            IsVisible="{Binding Script, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).ToggleScriptCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="quiet" Content="New take" Height="38" Margin="0,0,6,6" Padding="14,0" IsVisible="{Binding IsDone}"
                            Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).RetakeCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="quiet" Content="Stop" Height="38" Margin="0,0,6,6" Padding="14,0" IsVisible="{Binding IsActive}"
                            Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).StopCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="quiet" Content="Remove" Height="38" Margin="0,0,6,6" Padding="14,0" IsVisible="{Binding CanRemove}"
                            Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).RemoveCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="Takes it off this page; the video stays in the Library" />
                  </WrapPanel>

                  <Border IsVisible="{Binding ShowScript}" Background="{StaticResource SurfaceBrush}"
                          CornerRadius="14" Padding="14,12">
                    <SelectableTextBlock Text="{Binding Script}" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                         Foreground="{StaticResource MutedBrush}" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Padding="20,10,20,14" Background="{StaticResource BoothBrush}">
      <Panel>
        <Button Classes="primary" Content="Make video" Command="{Binding MakeCommand}" IsVisible="{Binding !IsSending}" />
        <Button Classes="primary" Content="{Binding SendingText}" IsEnabled="False" IsVisible="{Binding IsSending}" />
      </Panel>
    </Border>
  </Grid>
</UserControl>
