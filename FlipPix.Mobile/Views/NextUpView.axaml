<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:FlipPix.Mobile.Views"
             x:Class="FlipPix.Mobile.Views.NextUpView"
             x:DataType="v:NextUpView">
  <!-- A page that isn't built yet says what it will do, plainly. -->
  <StackPanel Margin="24,40,24,0" Spacing="14" MaxWidth="520"
              DataContext="{Binding RelativeSource={RelativeSource AncestorType=v:NextUpView}}">
    <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Left">
      <PathIcon Data="{Binding Icon}" Width="30" Height="30" Foreground="{StaticResource GlowBrush}" />
    </Border>
    <TextBlock Classes="title" Text="{Binding Heading}" />
    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="23" FontSize="16" />
    <TextBlock Classes="hint" Text="Arrives in the next build of the app." />
  </StackPanel>
</UserControl>
