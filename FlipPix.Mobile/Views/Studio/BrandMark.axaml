<!-- The app icon, drawn: a warm print lifting off the stack. Scales to any size without a bitmap. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlipPix.Mobile.Views.Studio.BrandMark"
             Width="32" Height="32">
  <Viewbox Stretch="Uniform">
    <Canvas Width="48" Height="48">
      <Rectangle Canvas.Left="17" Canvas.Top="5" Width="25" Height="31" RadiusX="5" RadiusY="5"
                 Fill="{StaticResource GlowBrush}" />
      <Rectangle Canvas.Left="6" Canvas.Top="12" Width="27" Height="32" RadiusX="5" RadiusY="5"
                 Fill="{StaticResource BrandBrush}" />
      <Rectangle Canvas.Left="10" Canvas.Top="16" Width="19" Height="16" RadiusX="2.5" RadiusY="2.5"
                 Fill="{StaticResource BoothBrush}" />
      <Path Data="M11.5,30.5 L16.5,23.5 L19.5,27.5 L22.5,24.5 L27.5,30.5 Z" Fill="{StaticResource GlowBrush}" />
      <Ellipse Canvas.Left="22.5" Canvas.Top="18.5" Width="3.5" Height="3.5" Fill="{StaticResource GlowBrush}" />
    </Canvas>
  </Viewbox>
</UserControl>
