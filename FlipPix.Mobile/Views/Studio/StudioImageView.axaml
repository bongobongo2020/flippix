<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlipPix.Mobile.ViewModels"
             xmlns:c="using:FlipPix.Mobile.Controls"
             x:Class="FlipPix.Mobile.Views.Studio.StudioImageView"
             x:DataType="vm:ImageViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Meta+Enter" Command="{Binding MakeCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding MakeCommand}" />
  </UserControl.KeyBindings>

  <Grid ColumnDefinitions="Auto,*">

    <!-- The composer: everything that decides the picture, in one panel, with the action at its foot. -->
    <Border Classes="composer">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
          <StackPanel Margin="26,28,26,24" Spacing="26">
            <StackPanel Spacing="6">
              <TextBlock Classes="eyebrow" Text="PICTURE" Foreground="{StaticResource GlowBrush}" />
              <TextBlock Classes="display" Text="Make a picture" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBox Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="150" MaxHeight="300" VerticalContentAlignment="Top"
                       Watermark="A lighthouse keeper's cat asleep on the warm lamp, first light over a grey sea"
                       AutomationProperties.Name="Describe the picture" />
              <Grid ColumnDefinitions="Auto,Auto,*">
                <Button Classes="bare" Command="{Binding PolishCommand}" Padding="8,6" Margin="-8,0,4,0"
                        ToolTip.Tip="The computer's writing assistant turns a few words into a full prompt">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconSparkle}" Width="16" Height="16" Foreground="{StaticResource GlowBrush}" />
                    <TextBlock Text="Polish with AI" FontWeight="SemiBold" Foreground="{StaticResource GlowBrush}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="bare" Click="OnFromPhoto" Padding="8,6" IsEnabled="{Binding !IsHelping}"
                        ToolTip.Tip="Pick a photo; the computer writes a prompt for a picture like it">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconCamera}" Width="16" Height="16" Foreground="{StaticResource GlowBrush}" />
                    <TextBlock Text="From a photo" FontWeight="SemiBold" Foreground="{StaticResource GlowBrush}" />
                  </StackPanel>
                </Button>
                <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="44" MinWidth="0" HorizontalAlignment="Right"
                             VerticalAlignment="Center" IsVisible="{Binding IsHelping}" Foreground="{StaticResource GlowBrush}" />
              </Grid>
              <TextBlock Classes="hint danger" Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <!-- Look: stacked, so each blurb can be read in full. -->
            <StackPanel>
              <TextBlock Classes="section" Text="Look" />
              <ListBox Classes="look-list" ItemsSource="{Binding LookOptions}" SelectedItem="{Binding Look}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LookOption">
                    <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Classes="hint" Text="{Binding Blurb}" FontSize="13" LineHeight="18" />
                      </StackPanel>
                      <Ellipse Grid.Column="1" Classes="dot" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="section" Text="Shape" />
              <UniformGrid Columns="3" Height="84">
                <Button Classes="cell" Classes.on="{Binding IsPortrait}" Margin="0,0,6,0"
                        Command="{Binding PickShapeCommand}" CommandParameter="{x:Static vm:ImageShape.Portrait}"
                        AutomationProperties.Name="Portrait">
                  <StackPanel Spacing="8">
                    <Rectangle Width="22" Height="28" Stroke="{StaticResource PaperBrush}" StrokeThickness="1.5" RadiusX="3" RadiusY="3" />
                    <TextBlock Text="Tall" FontSize="13" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="cell" Classes.on="{Binding IsSquare}" Margin="3,0"
                        Command="{Binding PickShapeCommand}" CommandParameter="{x:Static vm:ImageShape.Square}"
                        AutomationProperties.Name="Square">
                  <StackPanel Spacing="8">
                    <Rectangle Width="26" Height="26" Stroke="{StaticResource PaperBrush}" StrokeThickness="1.5" RadiusX="3" RadiusY="3" Margin="0,1" />
                    <TextBlock Text="Square" FontSize="13" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="cell" Classes.on="{Binding IsLandscape}" Margin="6,0,0,0"
                        Command="{Binding PickShapeCommand}" CommandParameter="{x:Static vm:ImageShape.Landscape}"
                        AutomationProperties.Name="Landscape">
                  <StackPanel Spacing="8">
                    <Rectangle Width="32" Height="22" Stroke="{StaticResource PaperBrush}" StrokeThickness="1.5" RadiusX="3" RadiusY="3" Margin="0,3" />
                    <TextBlock Text="Wide" FontSize="13" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </UniformGrid>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="section" Text="How many" />
              <UniformGrid Columns="3" Height="50">
                <Button Classes="cell" Classes.on="{Binding IsOne}" Margin="0,0,6,0"
                        Command="{Binding PickCountCommand}" CommandParameter="1">
                  <TextBlock Text="1" FontSize="17" FontWeight="SemiBold" />
                </Button>
                <Button Classes="cell" Classes.on="{Binding IsTwo}" Margin="3,0"
                        Command="{Binding PickCountCommand}" CommandParameter="2">
                  <TextBlock Text="2" FontSize="17" FontWeight="SemiBold" />
                </Button>
                <Button Classes="cell" Classes.on="{Binding IsFour}" Margin="6,0,0,0"
                        Command="{Binding PickCountCommand}" CommandParameter="4">
                  <TextBlock Text="4" FontSize="17" FontWeight="SemiBold" />
                </Button>
              </UniformGrid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- The pinned action. More can be queued while the computer works; this line says where it's at. -->
        <Border Grid.Row="1" Padding="22,14,22,22" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasActive}">
              <TextBlock Text="{Binding ActiveText}" FontSize="13" Foreground="{StaticResource GlowBrush}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Classes="bare" Padding="10,4" Command="{Binding StopCommand}">
                <TextBlock Text="Stop" FontWeight="SemiBold" FontSize="14" />
              </Button>
            </Grid>
            <Button Classes="primary" Content="{Binding MakeLabel}" Command="{Binding MakeCommand}" Click="OnMakeClicked"
                    ToolTip.Tip="⌘ Return" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- The contact sheet: every picture asked for from this iPad, newest first, developing in place. -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto" Margin="36,34,32,0">
        <StackPanel Spacing="3">
          <TextBlock Classes="pane-title" Text="Pictures" />
          <TextBlock Classes="hint" FontSize="14" Text="Newest first. Everything also lands in the Library." />
        </StackPanel>
        <Button Grid.Column="1" Classes="quiet" VerticalAlignment="Center" IsVisible="{Binding HasTiles}"
                Command="{Binding ClearFinishedCommand}" ToolTip.Tip="They stay in the Library">
          <TextBlock Text="Clear finished" FontSize="14" />
        </Button>
      </Grid>

      <Panel Grid.Row="1">
        <ScrollViewer x:Name="Scroller">
          <ItemsControl ItemsSource="{Binding Tiles}" x:Name="Sheet" Margin="30,18,30,30">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:JobItemVm">
                <Button Classes="tile" Margin="6" VerticalAlignment="Top"
                        Command="{Binding $parent[ItemsControl].((vm:ImageViewModel)DataContext).OpenCommand}"
                        CommandParameter="{Binding}">
                  <c:AspectPanel Ratio="{Binding Job.Ratio}">
                    <Border Classes="frame" CornerRadius="16">
                      <Grid>
                        <Border Classes="breathing" Background="{StaticResource RaisedBrush}" IsVisible="{Binding IsPending}" />
                        <ProgressBar Classes="develop" Value="{Binding Progress}" IsVisible="{Binding IsWorking}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <Image Source="{Binding Picture}" Stretch="UniformToFill" IsVisible="{Binding IsDone}" />
                        <StackPanel VerticalAlignment="Bottom" Margin="14,12" Spacing="3" IsVisible="{Binding !IsDone}">
                          <TextBlock Text="{Binding Job.LookName}" FontWeight="SemiBold" FontSize="14" />
                          <TextBlock Classes="hint" Text="{Binding Status}" FontSize="12" MaxLines="3" />
                          <TextBlock Classes="hint" Text="Tap to try again" FontSize="12" IsVisible="{Binding IsFailed}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="edge" CornerRadius="16" />
                  </c:AspectPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Classes="empty" IsVisible="{Binding NoTiles}">
          <StackPanel Spacing="14">
            <!-- The ghosts shrink, never spill, on a narrow pane. -->
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Border Classes="ghost breathing" Width="54" Height="70" />
                <Border Classes="ghost" Width="64" Height="64" VerticalAlignment="Center" />
                <Border Classes="ghost" Width="84" Height="56" VerticalAlignment="Center" />
              </StackPanel>
            </Viewbox>
            <TextBlock Text="Your pictures develop here" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="hint" FontSize="14" LineHeight="21" TextAlignment="Center"
                       Text="Each one fills with warm light while your computer makes it. Queue as many as you like; you can put the iPad down and it carries on." />
          </StackPanel>
        </Border>
      </Panel>
    </Grid>
  </Grid>
</UserControl>
