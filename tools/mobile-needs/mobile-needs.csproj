<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dumps the graphs the phone remote submits, built by the real recipes, so the starter ComfyUI
       package (packaging/comfyui-starter) can be checked against exactly what the phone runs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FlipPix.Remote\FlipPix.Remote.csproj" />
  </ItemGroup>
</Project>
